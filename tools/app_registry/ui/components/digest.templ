package components

import "strings"

// digestTruncated shortens a "sha256:<64 hex chars>" digest to a dense,
// scannable prefix ("sha256:abcdef012345…") for table density (NFR-10),
// while DigestDisplay still carries the full value for copy/expand.
func digestTruncated(digest string) string {
	const prefix = "sha256:"
	if !strings.HasPrefix(digest, prefix) {
		if len(digest) <= 19 {
			return digest
		}
		return digest[:19] + "…"
	}
	hash := digest[len(prefix):]
	if len(hash) <= 12 {
		return digest
	}
	return prefix + hash[:12] + "…"
}

// copyDigest is a templ script template: a self-contained JS function templ
// generates and dedupes across every call site, so DigestDisplay needs no
// hand-written inline-script wiring (and no new client-side JS dependency —
// this stays within the CDN Tailwind/daisyUI-only toolchain, NFR-20).
script copyDigest(digest string) {
	navigator.clipboard.writeText(digest);
}

// DigestDisplay is the one place a digest renders anywhere "what's
// deployed" is shown, alongside its version (NFR-4). It shows a truncated
// digest for density but keeps the full value available on hover
// (title attribute, works everywhere with zero JS) and via a copy-to-
// clipboard button so an admin never has to fall back to view-source to
// get the real value.
templ DigestDisplay(version string, digest string) {
	<span class="inline-flex items-center gap-1 font-mono text-sm">
		if version != "" {
			<span>{ version }</span>
			<span class="opacity-50">{ "@" }</span>
		}
		<span title={ digest }>{ digestTruncated(digest) }</span>
		<button
			type="button"
			class="btn btn-ghost btn-xs px-1"
			title="Copy full digest"
			onclick={ copyDigest(digest) }
		>
			⧉
		</button>
	</span>
}

// versionDigestTitle is DigestDisplayCompact's hover text — the full
// "version@digest" (or just digest, with no version) so truncating the
// visible text never hides information the way DigestDisplay's per-span
// title (digest only) doesn't need to, since DigestDisplay never truncates
// the version.
func versionDigestTitle(version, digest string) string {
	if version == "" {
		return digest
	}
	return version + "@" + digest
}

// versionDigestCompactText is DigestDisplayCompact's visible text — version
// plus the already-truncated digest, built as one string (rather than
// adjacent templ expressions) so truncate/ellipsis has a single text node
// to clip, matching promote.templ's candidateOptionLabel pattern for
// combining version and digest.
func versionDigestCompactText(version, digest string) string {
	if version == "" {
		return digestTruncated(digest)
	}
	return version + "@" + digestTruncated(digest)
}

// DigestDisplayCompact is DigestDisplay's variant for the deployments
// matrix's fixed-width per-environment cells (#769): grid columns are
// minmax(170px,1fr), and DigestDisplay's untruncated version plus already-
// truncated digest plus copy button routinely overflowed that width,
// crowding the promote/rollback buttons sharing the cell. Renders the same
// version+digest as one single-line, ellipsis-truncated block (min-w-0 so
// the flex parent lets it actually shrink below content size) with the
// full value on hover, and keeps the copy button un-truncated and
// un-shrinkable alongside it.
templ DigestDisplayCompact(version string, digest string) {
	<span class="inline-flex items-center gap-1 min-w-0 max-w-full">
		<span
			class="font-mono text-xs truncate min-w-0 max-w-[100px]"
			title={ versionDigestTitle(version, digest) }
		>
			{ versionDigestCompactText(version, digest) }
		</span>
		<button
			type="button"
			class="btn btn-ghost btn-xs px-1 shrink-0"
			title="Copy full digest"
			onclick={ copyDigest(digest) }
		>
			⧉
		</button>
	</span>
}
