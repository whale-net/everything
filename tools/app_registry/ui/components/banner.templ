package components

import "github.com/whale-net/everything/libs/go/htmxauth"

// MisconfigBanner is the FR-59 persistent misconfiguration banner. Shell
// renders it on every screen (see layout.templ) so it is never opt-in per
// page. It renders only when RolesMisconfigured(user) is true — i.e. the
// realm_access.roles claim was entirely absent from the token, almost
// always a missing Keycloak "Add to ID token" realm-roles mapper on the
// client scope — never for a legitimate present-but-empty roles claim
// (read-only viewer) and never under AUTH_MODE=none (see RolesMisconfigured
// doc comment for why that exemption falls out for free here).
//
// This must never be mistaken for a reason to stop serving read screens:
// callers keep rendering the rest of the page underneath the banner so an
// admin can still diagnose the problem instead of being locked out.
templ MisconfigBanner(user *htmxauth.UserInfo) {
	if RolesMisconfigured(user) {
		<div role="alert" class="alert alert-error shadow-md">
			<span class="font-semibold">Roles claim missing from this session.</span>
			<span>
				The identity token has no realm_access.roles claim at all — this is
				almost always a Keycloak client scope missing the "Add to ID token"
				realm-roles mapper, not an intentional no-roles account. Read
				screens still work below, but every role-gated action is denied
				until this is fixed.
			</span>
		</div>
	}
}
