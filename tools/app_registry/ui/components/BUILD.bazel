load("@rules_go//go:def.bzl", "go_test")
load("//tools:templ.bzl", "templ_library")

templ_library(
    name = "components",
    srcs = glob(["*.templ"]),
    go_srcs = ["roles.go"],
    visibility = ["//tools/app_registry/ui:__subpackages__"],
    deps = [
        "//libs/go/htmxauth",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/appmeta/proto:appmetapb",
    ],
)

# Vocabulary (NFR-11, FR-33) and digest (NFR-4) read-surface tests (#654):
# each promotability/artifact-state/provenance value renders exactly one
# badge label+colour, and a digest stays fully recoverable despite being
# visually truncated.
go_test(
    name = "components_test",
    size = "small",
    srcs = ["read_screens_test.go"],
    embed = [":components"],
    deps = [
        "//tools/app_registry/protos:appregistrypb",
        "@com_github_a_h_templ//:templ",
    ],
)

# Source files exposed to //tools/app_registry/conformance's NFR-3
# static-analysis test (#656).
filegroup(
    name = "conformance_srcs",
    srcs = glob(["*.go", "*.templ"]),
    visibility = ["//tools/app_registry:__subpackages__"],
)
