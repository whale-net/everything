load("@rules_go//go:def.bzl", "go_test")
load("//tools:templ.bzl", "templ_library")

templ_library(
    name = "components",
    srcs = glob(["*.templ"]),
    go_srcs = ["roles.go"],
    visibility = ["//tools/app_registry/ui:__subpackages__"],
    deps = [
        "//libs/go/htmxauth",
        "//libs/go/htmxui",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/appmeta/proto:appmetapb",
    ],
)

# Role-gating unit tests (#652, NFR-17/FR-42-46/FR-59): HasRole literal
# membership (including the AllRoles sentinel and "no role implies
# another"), EnvironmentPromoterRole(s) derivation, Gate/GateCellAction, the
# RolesMisconfigured absent-vs-empty distinction, and MisconfigBanner's
# rendered output for each of those states.
go_test(
    name = "role_gating_test",
    size = "small",
    srcs = [
        "banner_test.go",
        "roles_test.go",
    ],
    embed = [":components"],
    deps = [
        "//libs/go/htmxauth",
        "//tools/app_registry/protos:appregistrypb",
    ],
)

# Vocabulary (NFR-11, FR-33) and digest (NFR-4) read-surface tests (#654):
# each promotability/artifact-state/provenance value renders exactly one
# badge label+colour, and a digest stays fully recoverable despite being
# visually truncated. shell_test.go (issue #1005, FR2/FR1a) is the direct
# wiring guard for Shell()'s adoption of htmxui.Shell: it renders through
# to nav-item/banner/user-label markup, proving the slot wiring didn't drop
# chrome during the migration.
go_test(
    name = "components_test",
    size = "small",
    srcs = [
        "badges_migration_test.go",
        "read_screens_test.go",
        "shell_test.go",
    ],
    embed = [":components"],
    deps = [
        "//libs/go/htmxauth",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/appmeta/proto:appmetapb",
        "@com_github_a_h_templ//:templ",
    ],
)

# Source files exposed to //tools/app_registry/conformance's NFR-3
# static-analysis test (#656).
filegroup(
    name = "conformance_srcs",
    srcs = glob(["*.go", "*.templ"]),
    visibility = ["//tools/app_registry:__subpackages__"],
)
