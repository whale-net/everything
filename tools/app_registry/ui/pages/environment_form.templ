package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxauth"
	"github.com/whale-net/everything/libs/go/htmxui"
	"github.com/whale-net/everything/tools/app_registry/ui/components"
)

// EnvironmentFormInput mirrors UpsertEnvironmentRequest's fields exactly
// (FR-35) — this is the only place that shape is duplicated for form
// binding, so a field added to the RPC must be added here too or the form
// silently stops offering it.
type EnvironmentFormInput struct {
	Key               string
	DisplayName       string
	Rank              int32
	RequiresApproval  bool
	GitopsPath        string
	AllowedPrincipals string // newline-separated, textarea-bound
}

// EnvironmentForm is screen 53-environment-form, in both its "new" and
// "edit" modes (the wireframe's own note: same form, Key editable and no
// danger zone for "new"). formErr renders the FR-45 distinguished
// PermissionDenied-vs-transport-failure message from a failed save/archive
// attempt, re-showing the user's submitted values rather than discarding
// them.
templ EnvironmentForm(user *htmxauth.UserInfo, mode string, input EnvironmentFormInput, archived bool, formErr string) {
	@components.Shell("Environment", user) {
		{{ decision := components.Gate(user, components.RoleAdmin) }}
		<div class="flex justify-between items-center mb-4">
			if mode == "new" {
				<h2 class="text-xl font-bold">Add environment</h2>
			} else {
				<h2 class="text-xl font-bold">Edit environment: { input.Key }</h2>
			}
			<a href="/environments" class="btn btn-sm btn-circle btn-ghost">✕</a>
		</div>
		if !decision.Allowed {
			<div role="alert" class="alert alert-warning shadow-md mb-4">
				<span>
					<strong>Read-only.</strong> Creating, editing, and archiving
					environments requires role { decision.MissingRole }, which this
					session does not hold.
				</span>
			</div>
		}
		if formErr != "" {
			<div role="alert" class="alert alert-error shadow-md mb-4">
				<span>{ formErr }</span>
			</div>
		}
		<form method="post" action="/environments/save">
			<div class="grid md:grid-cols-2 gap-4 mb-4">
				<div class="form-control">
					<label class="label"><span class="label-text">Key <span class="text-error">*</span> — immutable once other rows reference it</span></label>
					if mode == "new" {
						<input name="key" class="input input-bordered font-mono" value={ input.Key } required disabled?={ !decision.Allowed }/>
					} else {
						<input name="key" class="input input-bordered font-mono" value={ input.Key } disabled/>
					}
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">Display name</span></label>
					<input name="display_name" class="input input-bordered" value={ input.DisplayName } disabled?={ !decision.Allowed }/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">Rank — higher is closer to prod; orders promotion legality</span></label>
					<input type="number" name="rank" class="input input-bordered" value={ fmt.Sprint(input.Rank) } disabled?={ !decision.Allowed }/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">GitOps path — where this environment's rendered state writes to</span></label>
					<input name="gitops_path" class="input input-bordered font-mono" value={ input.GitopsPath } disabled?={ !decision.Allowed }/>
				</div>
			</div>

			<div role="alert" class="alert alert-info shadow-md mb-4">
				<span>
					Promoting to this environment checks the realm role
					<span class="font-mono font-semibold">{ components.EnvironmentPromoterRole(input.Key) }</span>.
					This UI cannot see or confirm Keycloak's realm role list — if that
					role does not exist yet, or is not assigned to a principal, every
					promotion attempt to this environment is denied for them until it
					is created and assigned in Keycloak. Creating this environment row
					does not create that role.
				</span>
			</div>

			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">
						Allowed principals — OIDC subjects listed here, one per line
					</span>
				</label>
				<div role="alert" class="alert alert-warning shadow-md mb-2">
					<span>
						<strong>Does not restrict who can promote.</strong> This field is
						stored and read by nothing outside the repository layer — the
						<span class="font-mono">{ components.EnvironmentPromoterRole(input.Key) }</span>
						realm role check above is the only access control in force for
						promotions to this environment.
					</span>
				</div>
				<textarea name="allowed_principals" class="textarea textarea-bordered font-mono text-sm" rows="3" disabled?={ !decision.Allowed }>{ input.AllowedPrincipals }</textarea>
			</div>

			<div class="alert alert-warning shadow-md mb-4">
				<span>
					<strong>Requires approval</strong> is stored but not yet enforced —
					<span class="font-mono">Promote</span> does not check it today.
					Toggling this on will not gate anything until the approval
					workflow ships.
				</span>
			</div>
			<div class="form-control mb-6">
				<label class="label cursor-pointer justify-start gap-3">
					<input type="checkbox" name="requires_approval" value="true" class="toggle" checked?={ input.RequiresApproval } disabled?={ !decision.Allowed }/>
					<span class="label-text">Requires approval <span class="opacity-60">(inert today)</span></span>
				</label>
			</div>

			<div class="flex gap-2 justify-end mb-8">
				<a href="/environments" class="btn btn-secondary">Cancel</a>
				if decision.Allowed {
					<button type="submit" class="btn btn-primary">Save environment</button>
				} else {
					<button type="submit" class="btn btn-primary btn-disabled" disabled title={ "Requires role: " + decision.MissingRole }>Save environment</button>
				}
			</div>
		</form>

		if mode == "edit" {
			if archived {
				<div class="card bg-base-100 border-2 border-error/40 shadow-md">
					<div class="bg-error/10 px-6 py-4 border-b-2 border-error/40 rounded-t-box">
						<h3 class="text-lg font-semibold text-error">⚠️ Danger Zone</h3>
					</div>
					<div class="card-body">
						<p class="text-sm opacity-70">
							This environment is already archived. Its promotion history is
							retained — nothing is hard-deleted.
						</p>
					</div>
				</div>
			} else {
				<form method="post" action="/environments/archive">
					<input type="hidden" name="key" value={ input.Key }/>
					@htmxui.Confirm(htmxui.ConfirmProps{
						Intent:         htmxui.ConfirmDestructive,
						ZoneTitle:      "⚠️ Danger Zone",
						Summary:        "Environments are never hard-deleted. Archiving stops it from appearing as a promotion target; its promotion history is retained.",
						SubmitLabel:    "Archive " + input.Key,
						Disabled:       !decision.Allowed,
						DisabledReason: "Requires role: " + decision.MissingRole,
					}, nil) {
						<h4 class="font-semibold">Archive this environment</h4>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Reason <span class="text-error">*</span></span></label>
							<textarea name="reason" class="textarea textarea-bordered textarea-sm" rows="2" placeholder="e.g. canary environment decommissioned, no traffic since 2026-06" required disabled?={ !decision.Allowed }></textarea>
							<span class="label-text-alt opacity-70 mt-1">Required — explains why, for anyone reading the archive history later.</span>
						</div>
					}
				</form>
			}
		}
	}
}
