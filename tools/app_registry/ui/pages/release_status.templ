package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxauth"
	"github.com/whale-net/everything/libs/go/htmxui"
	pb "github.com/whale-net/everything/tools/app_registry/protos"
	"github.com/whale-net/everything/tools/app_registry/ui/components"
)

// ReleaseStatusViewState is the release-status screen's render state
// (FR10). Release is GetRelease's full response (per-target state, the
// resolved plan, and workflow identity) -- wired for real in the Scaffold
// phase (see handlers_release.go's handleReleaseStatus doc comment);
// LoadErr is set instead when the RPC itself failed (unknown
// release_run_id, transport failure, etc).
type ReleaseStatusViewState struct {
	ReleaseRunID string
	Release      *pb.GetReleaseResponse
	LoadErr      string

	// BuildCommits maps a target's build_id (ReleaseRunTarget.GetBuildId())
	// to the commit that build resolved -- resolved via one GetBuild call
	// per distinct build_id (handlers_release.go's resolveTargetCommits), so
	// an operator can see (and click through to) the actual commit a
	// targeted build was cut from before releasing/promoting it, instead of
	// only a build_id. A build_id with no entry here (lookup failed, or the
	// target has no build yet) renders as "unknown" rather than blocking the
	// page.
	BuildCommits map[string]BuildCommitInfo
}

// BuildCommitInfo pairs a build's git_sha with a ready-made GitHub commit
// deep link (githubCommitURL, handlers_builds.go) -- built server-side, same
// NFR-15 "link only, never a live GitHub API call" precedent
// githubActionsRunURL already sets.
type BuildCommitInfo struct {
	GitSha string
	URL    string
}

// releaseRunIDShort truncates a release run id to a dense, scannable
// prefix for the header (issue #756) -- matching gitShaShort's (builds.templ)
// and digestTruncated's (components/digest.templ) truncate-for-density
// convention for identifiers, with the full value always still recoverable
// via the title attribute and the copy button next to it.
func releaseRunIDShort(id string) string {
	const n = 12
	if len(id) <= n {
		return id
	}
	return id[:n] + "…"
}

// releaseHeaderName resolves the app/artifact name to show prominently in
// the header (issue #756) -- GetReleaseResponse has no single "app name"
// field of its own (a release run is a batch: see ReleaseRunTarget in
// api_messages_release.proto), so this uses the single target's
// owner_full_name (the "<domain>-<name>" identity already shown per-row in
// the Targets table below) when the run resolved to exactly one target --
// the common case, a single app/chart release -- and falls back to the
// requested scope (already a domain/"all"/comma-list description, see
// TriggerReleaseRequest.requested_scope) alongside the target count for a
// batch release.
func releaseHeaderName(rel *pb.GetReleaseResponse) string {
	targets := rel.GetTargets()
	if len(targets) == 1 {
		return targets[0].GetOwnerFullName()
	}
	if rel.GetRequestedScope() != "" {
		return fmt.Sprintf("%s (%d targets)", rel.GetRequestedScope(), len(targets))
	}
	return "Release"
}

// copyReleaseRunID is a templ script template mirroring components/
// digest.templ's copyDigest -- same self-contained-JS-function pattern, so
// this header's copy affordance needs no hand-written inline-script wiring
// and stays within the CDN Tailwind/daisyUI-only toolchain (NFR-20).
script copyReleaseRunID(id string) {
	navigator.clipboard.writeText(id);
}

// ReleaseStatus is the release-status screen: durable, keyed by
// release_run_id, showing per-target state through to completion (FR10).
templ ReleaseStatus(user *htmxauth.UserInfo, s ReleaseStatusViewState) {
	@components.Shell("Release Status", user) {
		<div class="flex justify-between items-center mb-4">
			<div>
				<h2 class="text-xl font-bold">
					if s.Release != nil {
						{ releaseHeaderName(s.Release) }
					} else {
						Release
					}
				</h2>
				<div class="flex items-center gap-1 text-sm opacity-60">
					<span class="font-mono" title={ s.ReleaseRunID }>{ releaseRunIDShort(s.ReleaseRunID) }</span>
					<button
						type="button"
						class="btn btn-ghost btn-xs px-1"
						title="Copy full release run ID"
						onclick={ copyReleaseRunID(s.ReleaseRunID) }
					>
						⧉
					</button>
				</div>
			</div>
			<div class="flex gap-1">
				<a
					href={ templ.URL("/releases/" + s.ReleaseRunID) }
					class="btn btn-sm btn-ghost"
					title="No auto-refresh/polling precedent exists elsewhere in this UI (issue #890) -- this is a manual reload of this same page."
				>
					↻ Refresh
				</a>
				<a href="/releases/trigger" class="btn btn-sm btn-circle btn-ghost">✕</a>
			</div>
		</div>
		if s.LoadErr != "" {
			<div role="alert" class="alert alert-error shadow-md mb-4"><span>{ s.LoadErr }</span></div>
		} else if s.Release != nil {
			@releaseStatusDetail(s.Release, s.BuildCommits)
		}
	}
}

// releaseStatusDetail's three info cards migrate to htmxui.Card (FR2),
// each in the same `mb-4`-wrapping-div pattern promote.templ's
// commitOutcome/promoteCurrentStateBody doc comment explains: Card's own
// root <div> already carries a literal `class` attribute, so a caller
// cannot reliably layer an extra `mb-4` onto it via attrs (a second
// `class` value there would be a duplicate HTML attribute, silently
// discarded by the browser, not merged) -- a plain unstyled wrapping div
// carries the margin instead, with no effect on the Card's own rendered
// box.
templ releaseStatusDetail(rel *pb.GetReleaseResponse, commits map[string]BuildCommitInfo) {
	<div class="mb-4">
		@htmxui.Card(nil, releaseStatusRunBody(rel), nil, nil)
	</div>
	<div class="mb-4">
		@htmxui.Card(nil, releaseStatusTargetsBody(rel, commits), nil, nil)
	</div>
	if rel.GetResolvedPlanJson() != "" {
		<div class="mb-4">
			@htmxui.Card(nil, releaseStatusResolvedPlanBody(rel), nil, nil)
		</div>
	}
	<div class="flex gap-2 justify-end">
		<form method="post" action="/releases/trigger">
			<input type="hidden" name="scope" value={ rel.GetRequestedScope() }/>
			<input type="hidden" name="do" value="trigger"/>
			@htmxui.Button(htmxui.ButtonWarning, htmxui.ButtonSizeMD, false, templ.Attributes{
				"type":  "submit",
				"title": "Re-submits this run's original scope straight to TriggerRelease -- FR6/FR11: retry IS re-triggering, no separate resume/retry-from-step action.",
			}) {
				Retry
			}
		</form>
	</div>
}

templ releaseStatusRunBody(rel *pb.GetReleaseResponse) {
	<h3 class="card-title text-base">Run</h3>
	<dl class="grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-sm">
		<dt class="opacity-60">Triggered by</dt>
		<dd class="font-mono">{ rel.GetTriggeredBy() }</dd>
		<dt class="opacity-60">Requested scope</dt>
		<dd class="font-mono">{ rel.GetRequestedScope() }</dd>
		<dt class="opacity-60">Temporal workflow</dt>
		<dd class="font-mono">{ rel.GetTemporalWorkflowId() }</dd>
	</dl>
}

templ releaseStatusTargetsBody(rel *pb.GetReleaseResponse, commits map[string]BuildCommitInfo) {
	<h3 class="card-title text-base">Targets ({ fmt.Sprint(len(rel.GetTargets())) })</h3>
	<table class="table table-sm">
		<thead>
			<tr>
				<th>Target</th>
				<th>Kind</th>
				<th>State</th>
				<th>Build</th>
				<th>Commit</th>
				<th>Error</th>
			</tr>
		</thead>
		<tbody>
			for _, t := range rel.GetTargets() {
				<tr>
					<td class="font-mono">{ t.GetOwnerFullName() }</td>
					<td>{ releaseTargetKindLabel(t.GetKind()) }</td>
					<td>@components.ReleaseRunTargetStateBadge(t.GetState())</td>
					<td class="font-mono text-xs">{ t.GetBuildId() }</td>
					<td class="font-mono text-xs">
						if info, ok := commits[t.GetBuildId()]; ok {
							<a href={ templ.URL(info.URL) } target="_blank" rel="noopener" class="link link-hover" title={ info.GitSha }>
								{ gitShaShort(info.GitSha) }
							</a>
						} else if t.GetBuildId() != "" {
							<span class="opacity-50" title="Commit lookup unavailable for this build">unknown</span>
						}
					</td>
					<td class="text-error text-xs">{ t.GetErrorDetail() }</td>
				</tr>
			}
		</tbody>
	</table>
}

templ releaseStatusResolvedPlanBody(rel *pb.GetReleaseResponse) {
	<h3 class="card-title text-base">Resolved plan</h3>
	<pre class="text-xs overflow-x-auto bg-base-200 p-3 rounded">{ prettyJSON(rel.GetResolvedPlanJson()) }</pre>
}

// Retry (FR6/FR11) posts directly to /releases/trigger with "do=trigger",
// re-entering the exact same handleReleaseTriggerSubmit code path a fresh
// trigger uses -- not a separate retry-specific action or handler. It
// carries forward requested_scope (the one field GetReleaseResponse
// actually preserves from the original trigger); include_demo and any
// per-target digest are not recoverable from GetReleaseResponse today (the
// wire message has no field for either -- see api_messages_release.proto),
// so a retried "all" scope re-resolves with its default demo-exclusion and
// a retried digest-pinned single-target release re-resolves to "build
// fresh" rather than the original pinned digest. Documented limitation,
// not a silent gap: closing it would mean widening TriggerReleaseRequest/
// GetReleaseResponse, which is out of this issue's scope (protos are
// #888/#889's surface).
