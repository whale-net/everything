package pages

import (
	"fmt"
	"strings"

	"github.com/whale-net/everything/libs/go/htmxauth"
	"github.com/whale-net/everything/libs/go/htmxui"
	pb "github.com/whale-net/everything/tools/app_registry/protos"
	"github.com/whale-net/everything/tools/app_registry/ui/components"
)

// ReleaseStatusViewState is the release-status screen's render state
// (FR10). Release is GetRelease's full response (per-target state, the
// resolved plan, and workflow identity) -- wired for real in the Scaffold
// phase (see handlers_release.go's handleReleaseStatus doc comment);
// LoadErr is set instead when the RPC itself failed (unknown
// release_run_id, transport failure, etc).
type ReleaseStatusViewState struct {
	ReleaseRunID string
	Release      *pb.GetReleaseResponse
	LoadErr      string

	// HeartbeatIntervalMs is the SSE hub's advertised heartbeat interval
	// (FR14), same source and same data-heartbeat-ms wiring
	// PromotionDetailsViewState.HeartbeatIntervalMs uses -- the live/
	// not-live script below derives its debounce and timeout-threshold
	// windows from this value rather than a hardcoded constant, so a
	// deployment-tuned heartbeat interval never drifts out of sync with the
	// indicator's own timing.
	HeartbeatIntervalMs int

	// BuildCommits maps a target's build_id (ReleaseRunTarget.GetBuildId())
	// to the commit that build resolved -- resolved via one GetBuild call
	// per distinct build_id (handlers_release.go's resolveTargetCommits), so
	// an operator can see (and click through to) the actual commit a
	// targeted build was cut from before releasing/promoting it, instead of
	// only a build_id. A build_id with no entry here (lookup failed, or the
	// target has no build yet) renders as "unknown" rather than blocking the
	// page.
	BuildCommits map[string]BuildCommitInfo
}

// BuildCommitInfo pairs a build's git_sha with a ready-made GitHub commit
// deep link (githubCommitURL, handlers_builds.go) -- built server-side, same
// NFR-15 "link only, never a live GitHub API call" precedent
// githubActionsRunURL already sets.
type BuildCommitInfo struct {
	GitSha string
	URL    string
}

// releaseRunIDShort truncates a release run id to a dense, scannable
// prefix for the header (issue #756) -- matching gitShaShort's (builds.templ)
// and digestTruncated's (components/digest.templ) truncate-for-density
// convention for identifiers, with the full value always still recoverable
// via the title attribute and the copy button next to it.
func releaseRunIDShort(id string) string {
	const n = 12
	if len(id) <= n {
		return id
	}
	return id[:n] + "…"
}

// releaseHeaderName resolves the app/artifact name to show prominently in
// the header (issue #756) -- GetReleaseResponse has no single "app name"
// field of its own (a release run is a batch: see ReleaseRunTarget in
// api_messages_release.proto), so this uses the single target's
// owner_full_name (the "<domain>-<name>" identity already shown per-row in
// the Targets table below) when the run resolved to exactly one target --
// the common case, a single app/chart release -- and falls back to the
// requested scope (already a domain/"all"/comma-list description, see
// TriggerReleaseRequest.requested_scope) alongside the target count for a
// batch release.
func releaseHeaderName(rel *pb.GetReleaseResponse) string {
	targets := rel.GetTargets()
	if len(targets) == 1 {
		return targets[0].GetOwnerFullName()
	}
	if rel.GetRequestedScope() != "" {
		return fmt.Sprintf("%s (%d targets)", rel.GetRequestedScope(), len(targets))
	}
	return "Release"
}

// copyReleaseRunID is a templ script template mirroring components/
// digest.templ's copyDigest -- same self-contained-JS-function pattern, so
// this header's copy affordance needs no hand-written inline-script wiring
// and stays within the CDN Tailwind/daisyUI-only toolchain (NFR-20).
script copyReleaseRunID(id string) {
	navigator.clipboard.writeText(id);
}

// ReleaseStatus is the release-status screen: durable, keyed by
// release_run_id, showing per-target state through to completion (FR10),
// with a live-pushed Targets region (FR8, FR11) once the SSE route feeding
// it exists -- see this file's ReleaseStatusLiveBody doc comment. Modelled
// on PromotionDetails' own hx-ext/indicator/reload-affordance shape
// (promotion_details.templ), generalizing its FR29 pushed-region boundary
// and FR23/FR24 live-indicator behavior to this screen.
templ ReleaseStatus(user *htmxauth.UserInfo, s ReleaseStatusViewState) {
	@components.Shell("Release Status", user) {
		<div
			hx-ext="sse"
			sse-connect={ templ.URL("/releases/" + s.ReleaseRunID + "/status/sse") }
			data-heartbeat-ms={ fmt.Sprint(s.HeartbeatIntervalMs) }
		>
			<div class="flex justify-between items-center mb-4">
				<div>
					<h2 class="text-xl font-bold">
						if s.Release != nil {
							{ releaseHeaderName(s.Release) }
						} else {
							Release
						}
					</h2>
					<div class="flex items-center gap-1 text-sm opacity-60">
						<span class="font-mono" title={ s.ReleaseRunID }>{ releaseRunIDShort(s.ReleaseRunID) }</span>
						<button
							type="button"
							class="btn btn-ghost btn-xs px-1"
							title="Copy full release run ID"
							onclick={ copyReleaseRunID(s.ReleaseRunID) }
						>
							⧉
						</button>
					</div>
				</div>
				<div class="flex gap-1">
					<a
						href={ templ.URL("/releases/" + s.ReleaseRunID) }
						class="btn btn-sm btn-ghost"
						title="A plain GET reload of this same page -- distinct from the live indicator below (FR14), which already reflects whether the Targets region is receiving push updates."
					>
						↻ Refresh
					</a>
					<a href="/releases/trigger" class="btn btn-sm btn-circle btn-ghost">✕</a>
				</div>
			</div>

			<!-- FR14: Live/not-live indicator (outside the pushed region). -->
			<div id="release-live-indicator" class="flex items-center gap-2 mb-4">
				<div id="release-live-status" class="badge badge-success" title="SSE connection is healthy">Live</div>
			</div>

			<!-- FR15: Reload affordance (only shown when not-live, outside the pushed region). This is the only recovery path from an expired/revoked session on this route. -->
			<div id="release-reload-container" class="mb-4" style="display: none;">
				<a href={ templ.URL("/releases/" + s.ReleaseRunID) } class="btn btn-sm btn-warning">Reload</a>
			</div>

			if s.LoadErr != "" {
				<div role="alert" class="alert alert-error shadow-md mb-4"><span>{ s.LoadErr }</span></div>
			} else if s.Release != nil {
				@releaseStatusDetail(s.Release, s.BuildCommits, s.ReleaseRunID)
			}
		</div>

		<!-- FR14, FR15: SSE connection state management, ported from promotion_details.templ's identical script rather than reimplemented. -->
		<script type="module">
(function() {
  const container = document.querySelector('[hx-ext="sse"]');
  if (!container) return;

  const indicator = document.getElementById('release-live-status');
  const reloadContainer = document.getElementById('release-reload-container');
  if (!indicator || !reloadContainer) return;

  let isLive = true;
  let lastEventTime = Date.now();
  let heartbeatMs = parseInt(container.getAttribute('data-heartbeat-ms'), 10) || 30000;
  let debounceTimeoutId = null;

  container.addEventListener('htmx:sseOpen', () => {
    cancelDebounce();
    setLive(true);
    lastEventTime = Date.now();
  });

  container.addEventListener('htmx:sseError', () => {
    handleConnectionError();
  });

  const swapTarget = container.querySelector('[sse-swap]');
  if (swapTarget) {
    const observer = new MutationObserver(() => {
      lastEventTime = Date.now();
      cancelDebounce();
      setLive(true);
    });
    observer.observe(swapTarget, {
      childList: true,
      subtree: true,
      characterData: true,
      attributes: true
    });
  }

  const heartbeatCheckInterval = setInterval(() => {
    const timeSinceLastEvent = Date.now() - lastEventTime;
    const timeoutThreshold = heartbeatMs * 2;

    if (isLive && timeSinceLastEvent > timeoutThreshold) {
      handleTimeout();
    }
  }, 10000);

  function handleConnectionError() {
    if (debounceTimeoutId) return;
    debounceTimeoutId = setTimeout(() => {
      setLive(false);
      debounceTimeoutId = null;
    }, heartbeatMs);
  }

  function handleTimeout() {
    if (debounceTimeoutId) return;
    debounceTimeoutId = setTimeout(() => {
      setLive(false);
      debounceTimeoutId = null;
    }, heartbeatMs);
  }

  function cancelDebounce() {
    if (debounceTimeoutId) {
      clearTimeout(debounceTimeoutId);
      debounceTimeoutId = null;
    }
  }

  function setLive(live) {
    isLive = live;
    if (live) {
      indicator.textContent = 'Live';
      indicator.className = 'badge badge-success';
      indicator.title = 'SSE connection is healthy';
      reloadContainer.style.display = 'none';
    } else {
      indicator.textContent = 'Not Live';
      indicator.className = 'badge badge-warning';
      indicator.title = 'SSE connection is not live - page updates stopped';
      reloadContainer.style.display = 'block';
    }
  }
})();
		</script>
	}
}

// releaseStatusDetail's three info cards migrate to htmxui.Card (FR2),
// each in the same `mb-4`-wrapping-div pattern promote.templ's
// commitOutcome/promoteCurrentStateBody doc comment explains: Card's own
// root <div> already carries a literal `class` attribute, so a caller
// cannot reliably layer an extra `mb-4` onto it via attrs (a second
// `class` value there would be a duplicate HTML attribute, silently
// discarded by the browser, not merged) -- a plain unstyled wrapping div
// carries the margin instead, with no effect on the Card's own rendered
// box.
templ releaseStatusDetail(rel *pb.GetReleaseResponse, commits map[string]BuildCommitInfo, releaseRunID string) {
	<div class="mb-4">
		@htmxui.Card(nil, releaseStatusRunBody(rel), nil, nil)
	</div>
	<div class="mb-4">
		@htmxui.Card(nil, releaseStatusLiveSwap(rel, commits, releaseRunID), nil, nil)
	</div>
	if rel.GetResolvedPlanJson() != "" {
		<div class="mb-4">
			@htmxui.Card(nil, releaseStatusResolvedPlanBody(rel), nil, nil)
		</div>
	}
	<div class="flex gap-2 justify-end">
		<form method="post" action="/releases/trigger">
			<input type="hidden" name="scope" value={ rel.GetRequestedScope() }/>
			<input type="hidden" name="do" value="trigger"/>
			@htmxui.Button(htmxui.ButtonWarning, htmxui.ButtonSizeMD, false, templ.Attributes{
				"type":  "submit",
				"title": "Re-submits this run's original scope straight to TriggerRelease -- FR6/FR11: retry IS re-triggering, no separate resume/retry-from-step action.",
			}) {
				Retry
			}
		</form>
	</div>
}

// releaseStatusLiveSwap wraps ReleaseStatusLiveBody in FR11's swap target.
// The sse-swap key matches the routing key events.TopicForReleaseRun (a
// separate, not-yet-landed task) will produce -- the same
// "promotion."+id precedent promotion_details.templ's own sse-swap target
// sets for that screen. The SSE route/handler that actually pushes into
// this target does not exist yet (also a separate task); until it lands,
// this div renders once on GET and simply never receives a push -- the
// intended intermediate state.
templ releaseStatusLiveSwap(rel *pb.GetReleaseResponse, commits map[string]BuildCommitInfo, releaseRunID string) {
	<div sse-swap={ "release_run." + releaseRunID } id="release-status-body">
		@ReleaseStatusLiveBody(rel, commits)
	</div>
}

templ releaseStatusRunBody(rel *pb.GetReleaseResponse) {
	<h3 class="card-title text-base">Run</h3>
	<dl class="grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-sm">
		<dt class="opacity-60">Triggered by</dt>
		<dd class="font-mono">{ rel.GetTriggeredBy() }</dd>
		<dt class="opacity-60">Requested scope</dt>
		<dd class="font-mono">{ rel.GetRequestedScope() }</dd>
		<dt class="opacity-60">Temporal workflow</dt>
		<dd class="font-mono">{ rel.GetTemporalWorkflowId() }</dd>
	</dl>
}

// releaseRunTargetStateOrder is the queued -> building -> publishing ->
// recording -> succeeded/failed progression ReleaseRunTargetState's own
// doc comment (api_messages_release.proto) defines -- the aggregate
// summary below walks states in this order so the line always reads in
// lifecycle order regardless of which states a given run happens to have
// reached.
var releaseRunTargetStateOrder = []pb.ReleaseRunTargetState{
	pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_QUEUED,
	pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_BUILDING,
	pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_PUBLISHING,
	pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_RECORDING,
	pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_SUCCEEDED,
	pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_FAILED,
}

// releaseRunAggregateSummary folds rel.GetTargets() into per-state counts
// and renders one line, e.g. "3/5 succeeded · 1 building · 1 failed"
// (FR13). Computed here in Go at render time, from GetReleaseResponse.
// targets alone -- never in browser JS, and never a new proto field.
// Reuses components.ReleaseRunTargetStateLabel so this line never invents
// a second vocabulary for the same states ReleaseRunTargetStateBadge
// already names. A target somehow still in the UNSPECIFIED zero state
// (never actually produced by the release pipeline, see the enum's own
// doc comment) still counts toward the total, appended under its badge's
// "Unknown" label rather than silently dropped.
func releaseRunAggregateSummary(rel *pb.GetReleaseResponse) string {
	targets := rel.GetTargets()
	total := len(targets)
	if total == 0 {
		return "No targets"
	}

	counts := make(map[pb.ReleaseRunTargetState]int, len(releaseRunTargetStateOrder)+1)
	for _, t := range targets {
		counts[t.GetState()]++
	}

	order := releaseRunTargetStateOrder
	if counts[pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_UNSPECIFIED] > 0 {
		order = append(append([]pb.ReleaseRunTargetState{}, releaseRunTargetStateOrder...), pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_UNSPECIFIED)
	}

	var parts []string
	for _, state := range order {
		n := counts[state]
		if n == 0 {
			continue
		}
		label := strings.ToLower(components.ReleaseRunTargetStateLabel(state))
		if state == pb.ReleaseRunTargetState_RELEASE_RUN_TARGET_STATE_SUCCEEDED {
			parts = append(parts, fmt.Sprintf("%d/%d %s", n, total, label))
			continue
		}
		parts = append(parts, fmt.Sprintf("%d %s", n, label))
	}
	return strings.Join(parts, " · ")
}

templ releaseStatusAggregateSummary(rel *pb.GetReleaseResponse) {
	<p class="text-sm opacity-70 mb-2">{ releaseRunAggregateSummary(rel) }</p>
}

// ReleaseStatusLiveBody is the FR11 pushed region's single render path
// (NFR2): the run-level aggregate summary (FR13) followed by the Targets
// table. Both the initial GET (via releaseStatusLiveSwap) and the eventual
// SSE fragment handler (a separate, not-yet-landed task) render this exact
// same component -- never a second variant for the pushed case.
templ ReleaseStatusLiveBody(rel *pb.GetReleaseResponse, commits map[string]BuildCommitInfo) {
	@releaseStatusAggregateSummary(rel)
	@releaseStatusTargetsBody(rel, commits)
}

templ releaseStatusTargetsBody(rel *pb.GetReleaseResponse, commits map[string]BuildCommitInfo) {
	<h3 class="card-title text-base">Targets ({ fmt.Sprint(len(rel.GetTargets())) })</h3>
	<table class="table table-sm">
		<thead>
			<tr>
				<th>Target</th>
				<th>Kind</th>
				<th>State</th>
				<th>Build</th>
				<th>Commit</th>
				<th>Error</th>
			</tr>
		</thead>
		<tbody>
			for _, t := range rel.GetTargets() {
				<tr>
					<td class="font-mono">{ t.GetOwnerFullName() }</td>
					<td>{ releaseTargetKindLabel(t.GetKind()) }</td>
					<td>@components.ReleaseRunTargetStateBadge(t.GetState())</td>
					<td class="font-mono text-xs">{ t.GetBuildId() }</td>
					<td class="font-mono text-xs">
						if info, ok := commits[t.GetBuildId()]; ok {
							<a href={ templ.URL(info.URL) } target="_blank" rel="noopener" class="link link-hover" title={ info.GitSha }>
								{ gitShaShort(info.GitSha) }
							</a>
						} else if t.GetBuildId() != "" {
							<span class="opacity-50" title="Commit lookup unavailable for this build">unknown</span>
						}
					</td>
					<td class="text-error text-xs">{ t.GetErrorDetail() }</td>
				</tr>
			}
		</tbody>
	</table>
}

templ releaseStatusResolvedPlanBody(rel *pb.GetReleaseResponse) {
	<h3 class="card-title text-base">Resolved plan</h3>
	<pre class="text-xs overflow-x-auto bg-base-200 p-3 rounded">{ prettyJSON(rel.GetResolvedPlanJson()) }</pre>
}

// Retry (FR6/FR11) posts directly to /releases/trigger with "do=trigger",
// re-entering the exact same handleReleaseTriggerSubmit code path a fresh
// trigger uses -- not a separate retry-specific action or handler. It
// carries forward requested_scope (the one field GetReleaseResponse
// actually preserves from the original trigger); include_demo and any
// per-target digest are not recoverable from GetReleaseResponse today (the
// wire message has no field for either -- see api_messages_release.proto),
// so a retried "all" scope re-resolves with its default demo-exclusion and
// a retried digest-pinned single-target release re-resolves to "build
// fresh" rather than the original pinned digest. Documented limitation,
// not a silent gap: closing it would mean widening TriggerReleaseRequest/
// GetReleaseResponse, which is out of this issue's scope (protos are
// #888/#889's surface).
