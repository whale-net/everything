load("@rules_go//go:def.bzl", "go_test")
load("//tools:templ.bzl", "templ_library")

templ_library(
    name = "pages",
    srcs = glob(["*.templ"]),
    go_srcs = ["helpers.go"],
    visibility = ["//tools/app_registry/ui:__pkg__"],
    deps = [
        "//libs/go/htmxauth",
        "//libs/go/htmxui",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/app_registry/ui/components",
        "//tools/app_registry/ui/matrix",
        "//tools/app_registry/ui/viewdata",
        "//tools/appmeta/proto:appmetapb",
    ],
)

# #652 (NFR-17, FR-42-46, FR-59): role gating over representative role
# subsets (no roles / promoter-dev-only / admin-only / all roles), FR-43's
# per-environment derivation (including a non-dev/stage/prod environment
# key), and the FR-59 absent-vs-empty-vs-AUTH_MODE=none distinction,
# exercised directly against the two role-sensitive screens
# (pages.Deployments, pages.Environments, pages.EnvironmentForm) -- every
# other read screen never branches on Roles at all (see this file's header
# comment).
#
# confirm_migration_test.go (issue #1005, FR1b) shares this target for its
# renderComponent/noRolesUser/adminUser/promoterDevUser helpers: it guards
# promote.templ/rollback.templ/environment_form.templ's adoption of the
# shared htmxui.Confirm component -- the override-acknowledge checkbox, the
# destructive/neutral submit styling, the disabled+reason wiring, and the
# danger-zone card chrome each map onto ConfirmProps fields differently per
# call site, and no pre-existing handler test asserted the rendered Confirm
# markup itself.
#
# button_card_migration_test.go (issue #1005, FR2) shares this target too:
# it guards the remaining raw daisyUI btn/card call sites' migration onto
# htmxui.Button/Card across promote/rollback/release_status/release_trigger's
# mb-4-wrapped info cards and every plain (no-color-variant) and coloured
# Button call site in builds/deployments/drift_audit/environment_diff/
# apps_catalog/environment_form -- none of which any pre-existing test
# asserted the rendered class/structure of.
go_test(
    name = "role_gating_test",
    size = "small",
    srcs = [
        "button_card_migration_test.go",
        "confirm_migration_test.go",
        "role_gating_test.go",
    ],
    embed = [":pages"],
    deps = [
        "//libs/go/htmxauth",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/app_registry/ui/components",
        "//tools/app_registry/ui/matrix",
        "//tools/appmeta/proto:appmetapb",
        "@com_github_a_h_templ//:templ",
    ],
)

# Source files exposed to //tools/app_registry/conformance's NFR-3
# static-analysis test (#656).
filegroup(
    name = "conformance_srcs",
    srcs = glob(["*.go", "*.templ"]),
    visibility = ["//tools/app_registry:__subpackages__"],
)
