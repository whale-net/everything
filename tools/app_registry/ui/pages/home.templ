// Package pages holds screen-level templ components for the App Registry
// UI. Home is the one trivial authenticated screen this scaffold ships:
// it proves the full seam (login -> roles -> forwarded token -> a real
// gRPC read) that every later screen builds on.
package pages

import (
	"github.com/whale-net/everything/libs/go/htmxauth"
	pb "github.com/whale-net/everything/tools/app_registry/protos"
	"github.com/whale-net/everything/tools/app_registry/ui/components"
)

// Home renders the signed-in user's identity and realm roles, plus the
// live result of a ListEnvironments gRPC read made with the user's own
// forwarded access token.
templ Home(user *htmxauth.UserInfo, environments []*pb.Environment) {
	@components.Shell("App Registry", user) {
		<div class="card bg-base-100 shadow-md">
			<div class="card-body">
				<h1 class="card-title">Signed in</h1>
				if user == nil {
					<p class="text-error">No session user in context — this should be unreachable behind RequireAuth.</p>
				} else {
					<p><span class="font-semibold">User:</span> { user.PreferredUsername }</p>
					<p class="mt-2 font-semibold">Roles</p>
					if user.Roles == nil {
						<p class="text-warning">
							No realm_access.roles claim on this session — likely a
							Keycloak client-scope misconfiguration (FR-59).
						</p>
					} else if len(user.Roles) == 0 {
						<p class="text-base-content/70">No roles assigned (read-only viewer).</p>
					} else {
						<div class="flex flex-wrap gap-2">
							for _, role := range user.Roles {
								<span class="badge badge-outline">{ role }</span>
							}
						</div>
					}
				}
			</div>
		</div>
		<div class="card bg-base-100 shadow-md">
			<div class="card-body">
				<h2 class="card-title">Environments</h2>
				<p class="text-sm text-base-content/70">
					Live read via EnvironmentRegistry.ListEnvironments, forwarding
					this session's own access token.
				</p>
				if len(environments) == 0 {
					<p class="mt-2 text-base-content/70">No environments returned.</p>
				} else {
					<ul class="mt-2 list-inside list-disc">
						for _, env := range environments {
							<li>
								<span class="font-mono">{ env.GetKey() }</span>
								&nbsp;—&nbsp;{ env.GetDisplayName() }
							</li>
						}
					</ul>
				}
			</div>
		</div>
	}
}
