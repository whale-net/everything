package pages

import (
	"fmt"
	"github.com/whale-net/everything/libs/go/htmxauth"
	pb "github.com/whale-net/everything/tools/app_registry/protos"
	"github.com/whale-net/everything/tools/app_registry/ui/components"
)

// PromotionDetailsViewState is the Promotion Details screen's render state
// (FR7, FR7a, FR8, FR9, issue #1032). Details is GetPromotionDetails' full
// response -- wired for real in the Scaffold phase (this is a plain read
// keyed by promotion_id with no write/permission-gating complexity to
// defer, the same precedent handleReleaseStatus's doc comment
// (handlers_release.go) sets for release-status); LoadErr is set instead
// when the RPC itself failed (unknown promotion_id -> NotFound, transport
// failure, etc).
type PromotionDetailsViewState struct {
	PromotionID          string
	Details              *pb.GetPromotionDetailsResponse
	LoadErr              string
	HeartbeatIntervalMs  int
	// RetryErr is set when a POST to /promotions/{id}/retry (FR10-FR13,
	// issue #1033) itself failed -- rendered as its own inline banner near
	// the retry button, distinct from LoadErr (a failure to read the
	// promotion's details at all). "" on a normal GET, or after a
	// successful retry submit.
	RetryErr string
}

// argok8sCommitURL builds the writeback-commit link (FR7a): argok8s is the
// one gitops repo GitOpsActivities.Publish ever commits to (see
// worker/writeback/gitops.go's GitOpsConfig.Repo doc comment) -- not
// configurable per-environment, so this is safe to hardcode here exactly
// like it is in that Go package's own doc comments.
func argok8sCommitURL(sha string) string {
	return "https://github.com/whale-net/argok8s/commit/" + sha
}

// earliestRefreshTriggered returns the first (chronologically earliest --
// SyncEvents is oldest-first, see PromotionDetails.sync_events' doc
// comment) refresh_triggered event, or nil if none exists yet (Promote
// succeeded but ArgoCD sync hasn't been triggered/observed at all -- e.g.
// the worker hasn't run TriggerArgoRefresh yet, or ARGOCD_SERVER isn't
// configured in this deployment, see worker/writeback/argosync.go's
// NoopArgoSyncActivities).
func earliestRefreshTriggered(events []*pb.PromotionSyncEvent) *pb.PromotionSyncEvent {
	for _, e := range events {
		if e.GetSource() == "refresh_triggered" {
			return e
		}
	}
	return nil
}

// syncEventSourceLabel renders PromotionSyncEvent.source for the timeline --
// screen-local since no other screen (yet) needs this vocabulary. Mirrors
// repository.PromotionSyncEvent's Source constants
// (server/repository/models.go) as display text.
func syncEventSourceLabel(source string) string {
	switch source {
	case "refresh_triggered":
		return "Refresh triggered"
	case "poll_observed":
		return "Poll observed"
	case "retry_triggered":
		return "Retry triggered"
	case "retry_observed":
		return "Retry observed"
	default:
		return source
	}
}

// PromotionDetails is the Promotion Details screen (FR7-FR9, issue #1032):
// requester/request time, from/to version, writeback outcome (commit
// SHA/link, FR7a), the ArgoCD sync/health outcome (FR8, three visibly
// distinct states -- never conflating "version upgraded, sync failed" with
// plain success), and the full sync/health observation history (#1028).
// Its one mutating control is the FR10-FR13 "Retry refresh/sync" button
// (issue #1033) -- admin-gated, presentation-only here (the real
// enforcement is server/handlers/promotion.go's RetryArgoSync auth.Require
// check; see components.GatedAction's own doc comment on that split).
templ PromotionDetails(user *htmxauth.UserInfo, s PromotionDetailsViewState) {
	@components.Shell("Promotion Details", user) {
		<div
			hx-ext="sse"
			sse-connect={ templ.URL("/promotions/" + s.PromotionID + "/status/sse") }
			data-heartbeat-ms={ fmt.Sprint(s.HeartbeatIntervalMs) }
			class="promotion-details-container"
		>
			<div class="breadcrumbs text-sm mb-4">
				<ul>
					<li><a href="/deployments">Deployments</a></li>
					<li>Promotion { s.PromotionID }</li>
				</ul>
			</div>

			<!-- FR23: Live/not-live indicator (outside pushed region) -->
			<div id="promo-live-indicator" class="flex items-center gap-2 mb-4">
				<div id="live-status" class="badge badge-success" title="SSE connection is healthy">Live</div>
			</div>

			<!-- FR24: Reload affordance (only shown when not-live, outside pushed region) -->
			<div id="promo-reload-container" class="mb-4" style="display: none;">
				<a href={ templ.URL("/promotions/" + s.PromotionID) } class="btn btn-sm btn-warning">Reload</a>
			</div>

			if s.LoadErr != "" {
				<div role="alert" class="alert alert-error shadow-md mb-4"><span>{ s.LoadErr }</span></div>
			} else if s.Details != nil {
				if s.RetryErr != "" {
					<div role="alert" class="alert alert-error shadow-md mb-4"><span>Retry failed: { s.RetryErr }</span></div>
				}
				<div sse-swap={ "promotion." + s.PromotionID } class="promotion-details-body">
					@PromotionDetailsBody(user, s.Details.GetDetails())
				</div>
			}
		</div>

		<!-- FR23, FR24: SSE connection state management script -->
		<script type="module">
(function() {
  const container = document.querySelector('[hx-ext="sse"]');
  if (!container) return;

  const indicator = document.getElementById('live-status');
  const reloadContainer = document.getElementById('promo-reload-container');
  if (!indicator || !reloadContainer) return;

  let isLive = true;
  let lastEventTime = Date.now();
  let heartbeatMs = parseInt(container.getAttribute('data-heartbeat-ms'), 10) || 30000;
  let debounceTimeoutId = null;

  container.addEventListener('htmx:sseOpen', () => {
    console.log('SSE connected');
    cancelDebounce();
    setLive(true);
    lastEventTime = Date.now();
  });

  container.addEventListener('htmx:sseError', () => {
    console.log('SSE error');
    handleConnectionError();
  });

  const swapTarget = container.querySelector('[sse-swap]');
  if (swapTarget) {
    const observer = new MutationObserver((mutations) => {
      lastEventTime = Date.now();
      cancelDebounce();
      setLive(true);
    });
    observer.observe(swapTarget, {
      childList: true,
      subtree: true,
      characterData: true,
      attributes: true
    });
  }

  const heartbeatCheckInterval = setInterval(() => {
    const timeSinceLastEvent = Date.now() - lastEventTime;
    const timeoutThreshold = heartbeatMs * 2;

    if (isLive && timeSinceLastEvent > timeoutThreshold) {
      handleTimeout();
    }
  }, 10000);

  function handleConnectionError() {
    if (debounceTimeoutId) return;
    debounceTimeoutId = setTimeout(() => {
      setLive(false);
      debounceTimeoutId = null;
    }, heartbeatMs);
  }

  function handleTimeout() {
    if (debounceTimeoutId) return;
    debounceTimeoutId = setTimeout(() => {
      setLive(false);
      debounceTimeoutId = null;
    }, heartbeatMs);
  }

  function cancelDebounce() {
    if (debounceTimeoutId) {
      clearTimeout(debounceTimeoutId);
      debounceTimeoutId = null;
    }
  }

  function setLive(live) {
    isLive = live;
    if (live) {
      indicator.textContent = 'Live';
      indicator.className = 'badge badge-success';
      indicator.title = 'SSE connection is healthy';
      reloadContainer.style.display = 'none';
    } else {
      indicator.textContent = 'Not Live';
      indicator.className = 'badge badge-warning';
      indicator.title = 'SSE connection is not live - page updates stopped';
      reloadContainer.style.display = 'block';
    }
  }
})();
		</script>
	}
}

templ PromotionDetailsBody(user *htmxauth.UserInfo, d *pb.PromotionDetails) {
	<div class="flex justify-between items-center mb-4">
		<h2 class="text-xl font-bold">
			{ d.GetPromotion().GetEnvironmentKey() }: { d.GetFromVersion() }
			if d.GetFromVersion() != "" {
				→
			}
			{ d.GetToVersion() }
		</h2>
		<div class="flex items-center gap-2">
			@components.PromotionSyncOutcomeBadge(d.GetOutcome())
			@retryArgoSyncButton(user, d.GetPromotion().GetPromotionId())
		</div>
	</div>
	<div class="card bg-base-100 border border-base-300 shadow-sm mb-4">
		<div class="card-body">
			<h3 class="card-title text-base">Request</h3>
			<dl class="grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-sm">
				<dt class="opacity-60">Requested by</dt>
				<dd>{ actorDisplay(user, d.GetRequestEvent().GetActor()) }</dd>
				<dt class="opacity-60">Requested at</dt>
				<dd class="font-mono">{ unixToRFC3339(d.GetRequestEvent().GetOccurredAt()) }</dd>
				<dt class="opacity-60">Action</dt>
				<dd>{ promotionActionLabel(d.GetRequestEvent().GetAction()) }</dd>
				if d.GetRequestEvent().GetReason() != "" {
					<dt class="opacity-60">Reason</dt>
					<dd>{ d.GetRequestEvent().GetReason() }</dd>
				}
			</dl>
		</div>
	</div>
	<div class="card bg-base-100 border border-base-300 shadow-sm mb-4">
		<div class="card-body">
			<h3 class="card-title text-base">Writeback</h3>
			<dl class="grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-sm">
				<dt class="opacity-60">Committed</dt>
				<dd>
					if d.GetWritebackCommitSha() != "" {
						<a href={ templ.URL(argok8sCommitURL(d.GetWritebackCommitSha())) } class="link font-mono text-xs" target="_blank" rel="noopener noreferrer">
							{ d.GetWritebackCommitSha() }
						</a>
					} else if d.GetWritebackLocation() != "" {
						<span class="opacity-60">Not yet committed (dev-test stub path) — last written to { d.GetWritebackLocation() }</span>
					} else {
						<span class="opacity-60">Not yet committed</span>
					}
				</dd>
				{{ refresh := earliestRefreshTriggered(d.GetSyncEvents()) }}
				<dt class="opacity-60">Sync triggered at</dt>
				<dd class="font-mono">
					if refresh != nil {
						{ unixToRFC3339(refresh.GetOccurredAt()) }
					} else {
						<span class="opacity-60">Not yet triggered</span>
					}
				</dd>
				<dt class="opacity-60">Current sync status</dt>
				<dd>
					if d.GetCurrentSyncStatus() != "" {
						{ d.GetCurrentSyncStatus() }
					} else {
						<span class="opacity-60">—</span>
					}
				</dd>
				<dt class="opacity-60">Current health status</dt>
				<dd>
					if d.GetCurrentHealthStatus() != "" {
						{ d.GetCurrentHealthStatus() }
					} else {
						<span class="opacity-60">—</span>
					}
				</dd>
				<dt class="opacity-60">Current operation phase</dt>
				<dd>
					if d.GetCurrentOperationPhase() != "" {
						{ d.GetCurrentOperationPhase() }
					} else {
						<span class="opacity-60">—</span>
					}
				</dd>
			</dl>
			if d.GetOutcome() == pb.PromotionSyncOutcome_PROMOTION_SYNC_OUTCOME_SYNC_FAILED {
				<div role="alert" class="alert alert-error mt-2">
					<span>Sync failed: { d.GetCurrentSyncStatus() } / { d.GetCurrentHealthStatus() }</span>
				</div>
			}
		</div>
	</div>
	<div class="card bg-base-100 border border-base-300 shadow-sm mb-4">
		<div class="card-body">
			<h3 class="card-title text-base">Sync history</h3>
			if len(d.GetSyncEvents()) == 0 {
				<p class="text-sm opacity-60">No ArgoCD sync/health observations recorded yet.</p>
			} else {
				<ul class="timeline timeline-vertical timeline-compact">
					for i, e := range d.GetSyncEvents() {
						<li>
							if i > 0 {
								<hr/>
							}
							<div class="timeline-start text-xs opacity-60 font-mono">{ unixToRFC3339(e.GetOccurredAt()) }</div>
							<div class="timeline-middle"><span class="badge badge-soft badge-neutral badge-xs"></span></div>
							<div class="timeline-end timeline-box text-sm">
								{ syncEventSourceLabel(e.GetSource()) }
								if e.GetSyncStatus() != "" || e.GetHealthStatus() != "" || e.GetOperationPhase() != "" {
									— { e.GetSyncStatus() } / { e.GetHealthStatus() } / { e.GetOperationPhase() }
								}
							</div>
							if i < len(d.GetSyncEvents())-1 {
								<hr/>
							}
						</li>
					}
				</ul>
			}
		</div>
	</div>
	@components.PromotionReadinessBanner(d.GetOutcome(), d.GetCurrentSyncStatus(), d.GetCurrentHealthStatus(), d.GetCurrentOperationPhase())
}

// retryArgoSyncButton is FR10-FR13's manual-retry action (issue #1033):
// posts to /promotions/{id}/retry, gated by components.RoleAdmin --
// disabled with the missing role named when absent (FR11, matching
// components.GatedAction's own "never enabled-but-doomed-to-fail, never
// silently omitted" convention), never a live control for a non-admin/
// anonymous session. This is presentation-only: the real enforcement is
// server/handlers/promotion.go's RetryArgoSync, which applies the exact
// same auth.RoleAdmin check server-side regardless of what this button
// renders.
templ retryArgoSyncButton(user *htmxauth.UserInfo, promotionID string) {
	<form method="post" action={ templ.URL("/promotions/" + promotionID + "/retry") }>
		{{ decision := components.Gate(user, components.RoleAdmin) }}
		if decision.Allowed {
			<button type="submit" class="btn btn-sm btn-warning">Retry refresh/sync</button>
		} else {
			<button
				type="submit"
				class="btn btn-sm btn-warning btn-disabled"
				disabled
				title={ "Requires role: " + decision.MissingRole }
			>
				Retry refresh/sync
				<span class="badge badge-outline badge-sm ml-1">{ decision.MissingRole }</span>
			</button>
		}
	</form>
}
