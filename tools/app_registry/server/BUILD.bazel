load("@rules_go//go:def.bzl", "go_binary")
load("//tools/bazel:release.bzl", "release_app")

go_binary(
    name = "api",
    srcs = ["main.go"],
    deps = [
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/app_registry/server/handlers",
        "//tools/app_registry/server/repository/postgres",
        "@io_opentelemetry_go_contrib_instrumentation_google_golang_org_grpc_otelgrpc//:otelgrpc",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//reflection",
    ],
    visibility = ["//visibility:public"],
)

# Release metadata. domain "app-registry" + name "api" produces the
# "app-registry-api" image/app identity. internal-api: reachable in-cluster
# and by CI only.
release_app(
    name = "api",
    binary_name = ":api",
    language = "go",
    domain = "app-registry",
    description = "App Registry gRPC API",
    app_type = "internal-api",
    port = 50051,
)
