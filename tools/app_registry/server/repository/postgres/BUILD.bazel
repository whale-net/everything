load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "postgres",
    srcs = [
        "app.go",
        "app_build_log.go",
        "artifact.go",
        "domain_adoption.go",
        "environment.go",
        "errors.go",
        "idempotency.go",
        "keyset_cursor.go",
        "promotion.go",
        "promotion_sync_event.go",
        "release_run.go",
        "repository.go",
        "writeback.go",
    ],
    importpath = "github.com/whale-net/everything/tools/app_registry/server/repository/postgres",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/semver",
        "//tools/app_registry/server/repository",
        "//tools/appmeta/proto:appmetapb",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_test(
    name = "postgres_test",
    srcs = [
        "errors_test.go",
        "keyset_cursor_test.go",
    ],
    embed = [":postgres"],
    deps = [
        "//tools/app_registry/server/repository",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)

# Real-Postgres integration coverage for this package -- see
# postgres_integration_helpers_test.go's doc comment and ../../../TESTING.md.
#
# Gazelle does not generate this target: these postgres_integration_*_test.go
# files are gated behind `//go:build integration`, which gazelle skips when
# scanning for go_test srcs. This go_test is hand-written, with EXACTLY the
# tag set from //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required). `# keep` markers tell
# a later `bazel run //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //tools/app_registry/server/repository/postgres:postgres_integration_test --test_output=all
go_test(
    # keep
    name = "postgres_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "postgres_integration_adoption_test.go",
        "postgres_integration_app_build_log_test.go",
        "postgres_integration_app_test.go",
        "postgres_integration_artifact_test.go",
        "postgres_integration_environment_test.go",
        "postgres_integration_helpers_test.go",
        "postgres_integration_promotion_test.go",
        "postgres_integration_release_run_test.go",
    ],
    embed = [":postgres"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/grpcauth",
        "//libs/go/migrate",
        "//tools/app_registry/migrate/schema",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/app_registry/server/auth",
        "//tools/app_registry/server/handlers",
        "//tools/app_registry/server/repository",
        "//tools/appmeta/proto:appmetapb",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_jackc_pgx_v5//stdlib",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
