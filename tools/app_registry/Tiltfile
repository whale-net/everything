# App Registry Tiltfile
# Local development environment for the App Registry.
#
# migration job + gRPC API + writeback worker (AR-4b) — the worker drains
# writeback_outbox and runs WritebackWorkflow against the AR-4a Temporal dev
# server, publishing rendered state to a local path inside its container
# (WRITEBACK_OUTPUT_DIR) -- see ARCHITECTURE.md and PLAN.md.

load('ext://namespace', 'namespace_create')
load('ext://dotenv', 'dotenv')
load('../tilt/common.tilt',
     'build_images_from_apps', 'detect_platform', 'get_bazel_platform', 'get_watch_paths',
     'setup_dev_util', 'setup_postgres', 'setup_otelcollector', 'setup_temporal',
     'get_env_bool', 'get_custom_or_default',
     'print_startup_banner', 'print_footer_info')
load('../tilt/minio.tilt', 'deploy_minio')

# ===========================
# Configuration
# ===========================

namespace = 'app-registry-local-dev'
namespace_create(namespace)
dotenv()

platform = detect_platform()
bazel_platform = get_bazel_platform(platform)

print_startup_banner("App Registry", namespace, platform)

# ===========================
# Infrastructure Setup
# ===========================

setup_dev_util(namespace)

# PostgreSQL Database
db_info = setup_postgres(namespace, db_name='app_registry')
pg_database_url = get_custom_or_default(
    'BUILD_POSTGRES_ENV',
    'PG_DATABASE_URL',
    'postgres://{}:{}@{}:{}/{}?sslmode=disable'.format(
        db_info['user'], db_info['password'], db_info['host'], db_info['port'], db_info['database']
    )
)

# OpenTelemetry Collector
otel_endpoint = setup_otelcollector(namespace)

# Temporal dev server — AR-4a foundations only. Nothing consumes this yet
# (no outbox, no WritebackWorkflow — that's AR-4b); this just makes the
# server available so libs/go/temporal can be exercised locally.
if get_env_bool('ENABLE_TEMPORAL', default='true'):
    temporal_info = setup_temporal(namespace)
    temporal_host = temporal_info['grpc_target']
else:
    temporal_info = None
    temporal_host = ''

# MinIO (S3-compatible storage) for FR-58
minio_info = deploy_minio(namespace, bucket_name='app-registry-dev')
s3_endpoint = get_custom_or_default('BUILD_MINIO_ENV', 'RELEASE_TOOLS_S3_ENDPOINT', minio_info['endpoint'])
s3_public_endpoint = get_custom_or_default('BUILD_MINIO_ENV', 'RELEASE_TOOLS_S3_PUBLIC_ENDPOINT', minio_info['public_endpoint'])
s3_region = get_custom_or_default('BUILD_MINIO_ENV', 'RELEASE_TOOLS_S3_REGION', 'us-east-1')
s3_access_key = get_custom_or_default('BUILD_MINIO_ENV', 'RELEASE_TOOLS_S3_ACCESS_KEY', minio_info['access_key'])
s3_secret_key = get_custom_or_default('BUILD_MINIO_ENV', 'RELEASE_TOOLS_S3_SECRET_KEY', minio_info['secret_key'])
s3_bucket = get_custom_or_default('BUILD_MINIO_ENV', 'RELEASE_TOOLS_S3_BUCKET', 'app-registry-dev')

print("📊 Infrastructure configured:")
print("  Postgres:  {}".format("custom" if os.environ.get('BUILD_POSTGRES_ENV') == 'custom' else "local"))
print("  OTEL:      {}".format(otel_endpoint))
print("  Temporal:  {}".format(temporal_host if temporal_info else "disabled"))
print("  MinIO:     {}".format("custom" if os.environ.get("BUILD_MINIO_ENV") == "custom" else "local"))

# ===========================
# Application Configuration
# ===========================

watch_paths = get_watch_paths('app_registry')

APPS = {
    'migration': {
        'enabled_env': 'ENABLE_APP_REGISTRY_MIGRATION',
        'bazel_target': '//tools/app_registry/migrate:migration_image_load',
        'image_name': 'app-registry-migration',
    },
    'api': {
        'enabled_env': 'ENABLE_APP_REGISTRY_API',
        'bazel_target': '//tools/app_registry/server:api_image_load',
        'image_name': 'app-registry-api',
    },
    'worker': {
        'enabled_env': 'ENABLE_APP_REGISTRY_WORKER',
        'bazel_target': '//tools/app_registry/worker:worker_image_load',
        'image_name': 'app-registry-worker',
    },
    'ui': {
        'enabled_env': 'ENABLE_APP_REGISTRY_UI',
        'bazel_target': '//tools/app_registry/ui:ui_image_load',
        'image_name': 'app-registry-ui',
    },
}

# ===========================
# Bazel Image Building
# ===========================

build_images_from_apps(APPS, watch_paths, platform)

# ===========================
# Kubernetes Deployments
# ===========================

# Database Migration Job — runs ahead of the API, mirroring the ArgoCD
# pre-sync-wave ordering described in migrate/README.md.
if get_env_bool('ENABLE_APP_REGISTRY_MIGRATION', default='true'):
    k8s_yaml(blob("""
apiVersion: batch/v1
kind: Job
metadata:
  name: app-registry-migration
  namespace: {namespace}
spec:
  ttlSecondsAfterFinished: 30
  template:
    metadata:
      labels:
        app: app-registry-migration
    spec:
      restartPolicy: OnFailure
      containers:
      - name: migration
        image: app-registry-migration
        env:
        - name: PG_DATABASE_URL
          value: "{pg_database_url}"
""".format(namespace=namespace, pg_database_url=pg_database_url)))

    k8s_resource(
        'app-registry-migration',
        resource_deps=['postgres-dev'],
        labels=['app-registry-infrastructure'],
    )
    print("🔄 Migration job configured")

# gRPC API
if get_env_bool('ENABLE_APP_REGISTRY_API', default='true'):
    k8s_yaml(blob("""
apiVersion: v1
kind: Service
metadata:
  name: app-registry-api
  namespace: {namespace}
spec:
  selector:
    app: app-registry-api
  ports:
    - name: grpc
      port: 50051
      targetPort: 50051
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-registry-api
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: app-registry-api
  template:
    metadata:
      labels:
        app: app-registry-api
    spec:
      containers:
      - name: api
        image: app-registry-api
        ports:
        - containerPort: 50051
          name: grpc
        env:
        - name: PORT
          value: "50051"
        - name: PG_DATABASE_URL
          value: "{pg_database_url}"
        - name: GRPC_AUTH_MODE
          value: "none"
        - name: TEMPORAL_HOST
          value: "{temporal_host}"
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: "{otel_endpoint}"
        - name: RELEASE_TOOLS_S3_BUCKET
          value: "{s3_bucket}"
        - name: RELEASE_TOOLS_S3_ENDPOINT
          value: "{s3_endpoint}"
        - name: RELEASE_TOOLS_S3_PUBLIC_ENDPOINT
          value: "{s3_public_endpoint}"
        - name: RELEASE_TOOLS_S3_REGION
          value: "{s3_region}"
        - name: RELEASE_TOOLS_S3_ACCESS_KEY
          value: "{s3_access_key}"
        - name: RELEASE_TOOLS_S3_SECRET_KEY
          value: "{s3_secret_key}"
        - name: ARTIFACTS_S3_BUCKET
          value: "{s3_bucket}"
        - name: ARTIFACTS_S3_ENDPOINT
          value: "{s3_endpoint}"
        - name: ARTIFACTS_S3_PUBLIC_ENDPOINT
          value: "{s3_public_endpoint}"
        - name: ARTIFACTS_S3_REGION
          value: "{s3_region}"
        - name: ARTIFACTS_S3_ACCESS_KEY
          value: "{s3_access_key}"
        - name: ARTIFACTS_S3_SECRET_KEY
          value: "{s3_secret_key}"
""".format(
        namespace=namespace,
        pg_database_url=pg_database_url,
        temporal_host=temporal_host,
        otel_endpoint=otel_endpoint,
        s3_bucket=s3_bucket,
        s3_endpoint=s3_endpoint,
        s3_public_endpoint=s3_public_endpoint,
        s3_region=s3_region,
        s3_access_key=s3_access_key,
        s3_secret_key=s3_secret_key,
    )))

    api_deps = []
    if get_env_bool('ENABLE_APP_REGISTRY_MIGRATION', default='true'):
        api_deps.append('app-registry-migration')
    if temporal_info:
        # server/main.go unconditionally constructs a Temporal client at
        # startup (see #888/#889); without this dep Tilt can start the API
        # before temporal-dev is reachable, crash-looping the pod (#904/#905).
        api_deps.append('temporal-dev')

    k8s_resource(
        'app-registry-api',
        resource_deps=api_deps,
        port_forwards=['50061:50051'],
        labels=['app-registry'],
    )
    print("🔌 API forwarded to localhost:50061 (gRPC)")

# Writeback worker (AR-4b) — drains writeback_outbox and runs
# WritebackWorkflow against the Temporal dev server started above. Needs
# both the API (to read state back via GetEnvironmentState) and Temporal, so
# it's disabled outright when either is off rather than starting into a
# guaranteed-crash loop.
if get_env_bool('ENABLE_APP_REGISTRY_WORKER', default='true') and temporal_info:
    k8s_yaml(blob("""
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-registry-worker
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: app-registry-worker
  template:
    metadata:
      labels:
        app: app-registry-worker
    spec:
      containers:
      - name: worker
        image: app-registry-worker
        env:
        - name: PG_DATABASE_URL
          value: "{pg_database_url}"
        - name: APP_REGISTRY_ADDRESS
          value: "app-registry-api:50051"
        - name: GRPC_AUTH_MODE
          value: "none"
        - name: TEMPORAL_HOST
          value: "{temporal_host}"
        - name: WRITEBACK_OUTPUT_DIR
          value: "/tmp/app-registry-writeback"
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: "{otel_endpoint}"
        - name: RELEASE_TOOLS_S3_ENDPOINT
          value: "{s3_endpoint}"
        - name: RELEASE_TOOLS_S3_BUCKET
          value: "{s3_bucket}"
        - name: RELEASE_TOOLS_S3_REGION
          value: "{s3_region}"
        - name: RELEASE_TOOLS_S3_ACCESS_KEY
          value: "{s3_access_key}"
        - name: RELEASE_TOOLS_S3_SECRET_KEY
          value: "{s3_secret_key}"
""".format(
        namespace=namespace,
        pg_database_url=pg_database_url,
        temporal_host=temporal_host,
        otel_endpoint=otel_endpoint,
        s3_endpoint=s3_endpoint,
        s3_bucket=s3_bucket,
        s3_region=s3_region,
        s3_access_key=s3_access_key,
        s3_secret_key=s3_secret_key,
    )))

    worker_deps = []
    if get_env_bool('ENABLE_APP_REGISTRY_MIGRATION', default='true'):
        worker_deps.append('app-registry-migration')
    if get_env_bool('ENABLE_APP_REGISTRY_API', default='true'):
        worker_deps.append('app-registry-api')
    if temporal_info:
        # setup_temporal's default resource_name -- see common.tilt; the
        # dict it returns carries connection info, not the resource name
        # itself, and this Tiltfile never overrides it from the default.
        worker_deps.append('temporal-dev')

    k8s_resource(
        'app-registry-worker',
        resource_deps=worker_deps,
        labels=['app-registry'],
    )
    print("⚙️  Writeback worker configured (task queue: app-registry-writeback)")
elif get_env_bool('ENABLE_APP_REGISTRY_WORKER', default='true'):
    print("⚠️  ENABLE_APP_REGISTRY_WORKER is set but Temporal is disabled (ENABLE_TEMPORAL=false) -- worker skipped")

# HTMX admin UI (app-registry-ui). DATABASE_URL is deliberately built from
# the same pg_database_url as every other App Registry component above --
# the UI's only direct DB use is htmxauth session storage (ui_sessions),
# never registry domain tables (see ui/ENV.md and NFR-3), so it must live in
# the same app_registry database, not a second one. Local dev runs with
# AUTH_MODE=none / GRPC_AUTH_MODE=none, same as the API above.
if get_env_bool('ENABLE_APP_REGISTRY_UI', default='true'):
    k8s_yaml(blob("""
apiVersion: v1
kind: Service
metadata:
  name: app-registry-ui
  namespace: {namespace}
spec:
  selector:
    app: app-registry-ui
  ports:
    - name: http
      port: 8000
      targetPort: 8000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-registry-ui
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: app-registry-ui
  template:
    metadata:
      labels:
        app: app-registry-ui
    spec:
      containers:
      - name: ui
        image: app-registry-ui
        ports:
        - containerPort: 8000
          name: http
        env:
        - name: PORT
          value: "8000"
        - name: AUTH_MODE
          value: "none"
        - name: GRPC_AUTH_MODE
          value: "none"
        - name: SECRET_KEY
          value: "dev-secret-key-change-in-production"
        - name: REGISTRY_API_URL
          value: "app-registry-api:50051"
        - name: PG_DATABASE_URL
          value: "{pg_database_url}"
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: "{otel_endpoint}"
""".format(
        namespace=namespace,
        pg_database_url=pg_database_url,
        otel_endpoint=otel_endpoint,
    )))

    ui_deps = []
    if get_env_bool('ENABLE_APP_REGISTRY_MIGRATION', default='true'):
        ui_deps.append('app-registry-migration')
    if get_env_bool('ENABLE_APP_REGISTRY_API', default='true'):
        ui_deps.append('app-registry-api')

    k8s_resource(
        'app-registry-ui',
        resource_deps=ui_deps,
        port_forwards=['8090:8000'],
        labels=['app-registry'],
    )
    print("🖥️  UI forwarded to localhost:8090")

# ===========================
# Access Information
# ===========================

print("\n" + "="*60)
print("📡 Access Information")
print("="*60)
print("  PostgreSQL:  localhost:5432 (user: postgres, pass: password)")
print("  API (gRPC):  localhost:50061")
print("  UI (HTTP):   localhost:8090")
if temporal_info:
    print("  Temporal:    localhost:7233 (gRPC), {} (Web UI)".format(temporal_info['ui_service_info']))
print("="*60)

print_footer_info('app-registry')

print("\n🚀 Quick Start:")
print("  1. tilt up                       # Start migration + API + worker + UI (this)")
print("  2. grpcurl -plaintext localhost:50061 list   # Confirm reflection")
print("  3. Open http://localhost:8090    # UI reaches app-registry-api + the local database")
print("  4. app-registry promote ...      # Promote something, then check the")
print("     worker's logs and /tmp/app-registry-writeback/<env>.json inside its pod")
