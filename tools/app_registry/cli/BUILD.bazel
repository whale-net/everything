load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_binary(
    name = "app-registry",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/app_registry/cli/cmd",
    ],
)

# Release metadata for the CLI.
release_app(
    name = "app_registry_cli",
    app_name = "app-registry",
    app_type = "cli",
    binary_name = ":app-registry",
    description = "App Registry CLI",
    domain = "tools",
    language = "go",
)

go_library(
    name = "cli_lib",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/tools/app_registry/cli",
    visibility = ["//visibility:private"],
    deps = ["//tools/app_registry/cli/cmd"],
)
