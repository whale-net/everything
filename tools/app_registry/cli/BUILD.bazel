load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_binary(
    name = "app-registry",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/app_registry/cli/cmd",
    ],
)

# Release metadata for the CLI. domain "app-registry" + name "cli" produces
# the "app-registry-cli" image identity, published so it can be run as
# `docker run ghcr.io/whale-net/app-registry-cli:<version>` instead of
# requiring a local build. deploy_unit = "none": it is never deployed, only
# published for people and CI to pull.
release_app(
    name = "cli",
    app_type = "job",
    binary_name = ":app-registry",
    deploy_unit = "none",
    description = "App Registry CLI",
    domain = "app-registry",
    language = "go",
)

go_library(
    name = "cli_lib",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/tools/app_registry/cli",
    visibility = ["//visibility:private"],
    deps = ["//tools/app_registry/cli/cmd"],
)
