load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "worker_lib",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/tools/app_registry/worker",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/argocd",
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/grpcclient",
        "//libs/go/logging",
        "//libs/go/temporal",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/app_registry/server/repository/postgres",
        "//tools/app_registry/worker/outbox",
        "//tools/app_registry/worker/reaper",
        "//tools/app_registry/worker/release",
        "//tools/app_registry/worker/writeback",
        "@io_temporal_go_sdk//activity",
        "@io_temporal_go_sdk//worker",
    ],
)

go_binary(
    name = "worker",
    embed = [":worker_lib"],
    visibility = ["//visibility:public"],
)

# Release metadata. domain "app-registry" + name "worker" produces the
# "app-registry-worker" image/app identity -- see ARCHITECTURE.md
# "Writeback: outbox -> Temporal" and ./README.md. app_type "worker": a
# long-running background process, not an API (no port) and not a
# run-to-completion job like migrate/cli.
release_app(
    name = "worker",
    app_type = "worker",
    # release_helper_go's own binary + a real helm CLI, bundled so
    # ResolvePlan/FinalizePublish's release_helper_go shell-outs (see
    # worker/release/plan.go and worker/release/finalize.go's package doc
    # comments) resolve both via PATH with no separate binary-mount
    # operational requirement. See //tools/release_helper_go's
    # release_helper_go_tar and //tools/helm_cli's helm_cli_tar doc
    # comments for how each is built/selected per platform.
    additional_tars = [
        "//tools/release_helper_go:release_helper_go_tar",
        "//tools/helm_cli:helm_cli_tar",
    ],
    # The real (non-stub) Writeback implementation shells out to `git` --
    # see worker/writeback/gitops.go. FinalizePublish's own git clone (see
    # finalize.go) also needs `git` on PATH. The default base image doesn't
    # carry it, so use the git-enabled base instead (see MODULE.bazel's
    # "git_base" oci.pull for why).
    base = "@git_base",
    binary_name = ":worker",
    description = "App Registry writeback worker (Temporal)",
    domain = "app-registry",
    language = "go",
)
