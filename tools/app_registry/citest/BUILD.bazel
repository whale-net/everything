load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "citest",
    srcs = ["workflow.go"],
    importpath = "github.com/whale-net/everything/tools/app_registry/citest",
    visibility = ["//visibility:public"],
)

go_test(
    name = "citest_test",
    srcs = [
        "action_contract_test.go",
        "brokered_upload_test.go",
        "contract_test.go",
        "isolation_test.go",
    ],
    # The real workflow/action YAML, not a copy -- the whole point is to
    # test what CI actually runs. See //.github:ci_config.
    data = ["//.github:ci_config"],
    embed = [":citest"],
    deps = [
        "//tools/app_registry/cli/cmd",
        "//tools/release_helper_go:cmd",
        "@com_github_spf13_cobra//:cobra",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "rehearsal_test",
    srcs = [
        "rehearsal_test.go",
    ],
    # FR-58: Integration test for the full upload/confirm/publish/resolve flow.
    # Can run against a live app-registry server (e.g., tilt up).
    tags = ["integration"],
    deps = [
        "//tools/app_registry/protos:appregistrypb",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "firmware_fixture_test",
    srcs = [
        "firmware_fixture_test.go",
    ],
    # FR-37: Integration test for firmware fixture genericity.
    # Tests the full upload/confirm/publish/resolve flow for a firmware-declared
    # variant that is neither OS nor architecture.
    # Can run against a live app-registry server (e.g., tilt up).
    tags = ["integration"],
    deps = [
        "//tools/app_registry/protos:appregistrypb",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)
