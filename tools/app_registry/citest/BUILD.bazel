load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "citest",
    srcs = ["workflow.go"],
    importpath = "github.com/whale-net/everything/tools/app_registry/citest",
    visibility = ["//visibility:public"],
)

go_test(
    name = "citest_test",
    srcs = [
        "contract_test.go",
    ],
    # The real workflow/action YAML, not a copy -- the whole point is to
    # test what CI actually runs. See //.github:ci_config.
    data = ["//.github:ci_config"],
    embed = [":citest"],
    deps = [
        "//tools/app_registry/cli/cmd",
        "//tools/release_helper_go:cmd",
        "@com_github_spf13_cobra//:cobra",
    ],
)
