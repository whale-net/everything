# Full-coverage fixture for //tools/appmeta:manifest_contract_test's
# proto -> rule direction: sets every app_metadata attribute, so the
# resulting AppManifest should have no field left unset. If a new field is
# added to appmeta.proto but the rule never populates it, extending this
# fixture is what catches it (see //tools/appmeta/README.md).
#
# This calls the low-level `app_metadata` rule directly instead of the
# `release_app` macro, for two reasons:
#   1. `release_app` also creates a multiplatform_image target, so going
#      through it would give this fixture a real image target CI could try
#      to build and push to GHCR.
#   2. `testonly = True` marks the metadata target itself as test-only, so
#      release discovery (`ListAllApps` in
#      //tools/release_helper_go/cmd/metadata.go) can query it out with
#      `except attr(testonly, 1, //...)` — covering this fixture and any
#      future one without hardcoding a domain name. `release_app` has no
#      testonly passthrough, so this couldn't be expressed by adding a kwarg
#      to it; calling app_metadata directly sidesteps that entirely.
#
# binary_target / image_target / openapi_spec_target / descriptor_set_target
# only need to be valid labels — app_metadata stores them as strings
# (str(label)) and never builds or dereferences them — so a single
# placeholder filegroup stands in for all four rather than a real binary or
# image.

load("//tools/bazel:release.bzl", "app_metadata", "helm_chart_metadata")

filegroup(
    name = "placeholder-target",
    srcs = [],
)

app_metadata(
    name = "fixture-app_metadata",
    testonly = True,
    app_name = "fixture-app",
    app_type = "external-api",
    args = [
        "-m",
        "tools.appmeta.testdata.main",
    ],
    binary_target = ":placeholder-target",
    command = ["python3"],
    deploy_unit = "image",
    description = "Full-coverage fixture for the appmeta manifest contract test.",
    descriptor_set_target = ":placeholder-target",
    domain = "appmeta",
    health_check_enabled = True,
    health_check_path = "/healthz",
    image_target = ":placeholder-target",
    ingress_host = "fixture.example.local",
    ingress_tls_secret = "fixture-tls",
    language = "python",
    openapi_spec_target = ":placeholder-target",
    organization = "whale-net",
    port = 8080,
    registry = "ghcr.io",
    replicas = 3,
    repo_name = "appmeta-fixture-app",
    resources_limits_cpu = "200m",
    resources_limits_memory = "256Mi",
    resources_requests_cpu = "100m",
    resources_requests_memory = "128Mi",
    tags = ["release-metadata"],
    version = "v1.2.3",
    visibility = ["//visibility:public"],
)

# Full-coverage fixture for the same test's ChartManifest coverage
# (TestChartFixtureLeavesNoFieldUnset, added in AR-7a alongside app_refs) --
# calls the low-level `helm_chart_metadata` rule directly, same rationale as
# fixture-app_metadata above: no real helm_chart/image target, and
# testonly = True keeps it out of release discovery. Composes
# fixture-app_metadata itself so app_refs is non-empty (a repeated field
# with zero elements reads as "unset" to assertNoFieldUnset, same as any
# other proto3 field) and, since fixture-app_metadata's domain is "appmeta",
# proves app_refs is domain-qualified rather than copied bare.
helm_chart_metadata(
    name = "fixture-helm_chart_metadata",
    testonly = True,
    apps = [":fixture-app_metadata"],
    chart_name = "fixture-chart",
    chart_target = ":placeholder-target",
    chart_version = "0.1.0",
    domain = "appmeta",
    environment = "production",
    namespace = "appmeta",
    tags = ["helm-release-metadata"],
    visibility = ["//visibility:public"],
)
