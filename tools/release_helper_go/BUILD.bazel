load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//tools/bazel:release.bzl", "release_app")

package(default_visibility = ["//visibility:public"])

release_app(
    name = "release_helper_go",
    app_name = "release_helper_go",
    app_type = "cli",
    binary_name = ":release_helper_go",
    deploy_unit = "image",
    description = "Release helper CLI for Everything monorepo",
    domain = "tools",
    language = "go",
)

go_library(
    name = "cmd",
    srcs = glob(
        ["cmd/*.go"],
        exclude = ["cmd/*_test.go"],
    ),
    importpath = "github.com/whale-net/everything/tools/release_helper_go/cmd",
    deps = [
        "//libs/go/grpcauth",
        "//libs/go/grpcclient",
        "//libs/go/semver",
        "//tools/app_registry/protos:appregistrypb",
        "//tools/appmeta/proto:appmetapb",
        "//tools/helm:helm_lib",
        "@com_github_google_go_containerregistry//pkg/authn",
        "@com_github_google_go_containerregistry//pkg/crane",
        "@com_github_spf13_cobra//:cobra",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_binary(
    name = "release_helper_go",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/tools/release_helper_go",
    deps = [":cmd"],
)

# Bundles this binary into another release_app image's `additional_tars`
# (mirrors //tools/steamcmd's pkg_tar pattern) -- used by
# //tools/app_registry/worker so app-registry-worker's own image carries
# `release_helper_go` at /usr/local/bin/release_helper_go, letting
# ResolvePlan/FinalizePublish's release_helper_go shell-outs (see
# tools/app_registry/worker/release/plan.go's package doc comment) resolve
# it via PATH with no separate binary-mount operational requirement.
# go_binary's cross-compiled output is picked up transitively through
# rules_oci's platform transition (same mechanism the worker's own
# binary_name gets built for each target platform), so this needs no
# separate per-arch handling the way an externally-fetched binary would.
pkg_tar(
    name = "release_helper_go_tar",
    srcs = [":release_helper_go"],
    mode = "0755",
    package_dir = "/usr/local/bin",
    visibility = ["//visibility:public"],
)

go_test(
    name = "cmd_test",
    size = "small",
    srcs = glob(["cmd/*_test.go"]),
    embed = [":cmd"],
    deps = [
        "//tools/helm:helm_lib",
        "@com_github_spf13_cobra//:cobra",
    ],
)

# CLI integration tests for the Go rewrite — delegates to the shared
# test_cli_integration.sh with the Go binary substituted in.
sh_test(
    name = "test_cli_integration_go",
    size = "small",
    srcs = ["test_cli_integration_go.sh"],
    data = [
        ":release_helper_go",
        ":test_cli_integration.sh",
    ],
    tags = ["integration"],
)
