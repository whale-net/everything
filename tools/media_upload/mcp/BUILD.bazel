load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "mcp_lib",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/tools/media_upload/mcp",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/auth",
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//libs/go/mcpobs",
        "//libs/go/s3",
        "//tools/media_upload/uploads",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

go_test(
    name = "mcp_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":mcp_lib"],
    deps = [
        "//libs/go/grpcauth",
        "//tools/media_upload/uploads",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

go_binary(
    name = "mcp",
    embed = [":mcp_lib"],
    visibility = ["//visibility:public"],
)

release_app(
    name = "mcp",
    binary_name = ":mcp",
    language = "go",
    domain = "media-upload",
    description = "Media upload MCP server: OAuth-protected presigned S3 upload URLs and public URLs for embeddable media",
    app_type = "external-api",
    port = 8081,
)
