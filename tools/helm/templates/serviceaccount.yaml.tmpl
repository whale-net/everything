{{- range $appName, $app := .Values.apps }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ $appName }}
  namespace: {{ $.Values.global.namespace }}
  labels:
    app: {{ $appName }}-{{ $.Values.global.environment }}
    component: {{ $app.type }}
  annotations:
    # Reserved earlier than job.yaml.tmpl's PreSync hook (sync-wave -1,
    # hook-weight -5), so the ServiceAccount that hook's Job references as
    # serviceAccountName always exists before the Job runs.
    "argocd.argoproj.io/sync-wave": "-5"
    "helm.sh/hook": pre-install,pre-upgrade
    "helm.sh/hook-weight": "-10"
{{- end }}
