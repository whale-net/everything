SLACK_BOT_TOKEN=<BOT token from slack>
SLACK_APP_TOKEN=<APP token from slack>
POSTGRES_URL=postgresql+psycopg2://username:password@host:port/database
GOOGLE_API_KEY=https://aistudio.google.com/app/apikey
APP_ENV=dev
TEMPORAL_HOST=localhost:7233

# whagent-net @mention integration (required by `fcm bot` and `fcm workflow run`)
WHAGENT_API_URL=localhost:50054
WHAGENT_UI_PUBLIC_URL=https://whagent.example.com
WHAGENT_KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/whagent/protocol/openid-connect/token
WHAGENT_CLIENT_ID=<fcm's service-account client id>
WHAGENT_CLIENT_SECRET=<fcm's service-account client secret>

# OIDC identity-link web app (`fcm web run`)
FCM_WEB_PUBLIC_URL=http://localhost:8000
FCM_OIDC_ISSUER_URL=https://keycloak.example.com/realms/whagent
FCM_OIDC_CLIENT_ID=<confidential browser-login client id>
FCM_OIDC_CLIENT_SECRET=<confidential browser-login client secret>
FCM_WEB_SESSION_SECRET=<a long random signing key>

# ENV.md is the complete reference -- every variable the code reads, with defaults.
