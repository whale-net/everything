load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "identitylink",
    srcs = ["store.go"],
    importpath = "github.com/whale-net/everything/manmanv2/identitylink",
    visibility = ["//manmanv2:__subpackages__"],
    deps = ["@com_github_jackc_pgx_v5//pgconn"],
)

# Postgres-backed store and migration coverage; needs Docker.
#   bazel test //manmanv2/identitylink:store_integration_test --test_output=all
go_test(
    # keep
    name = "store_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["store_integration_test.go"],
    embed = [":identitylink"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "//manmanv2/migrate/schema",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
