# FR8 live-at-execution guarantee (tasks #2093/#2141, plan #2080):
# ExecuteAction must read the definition (and fields) fresh from the
# repository at execution time. Real Postgres + real RabbitMQ via
# testcontainers; hand-written, build-tagged integration target per the
# pending_restart precedent. Restored to trunk by #2141 after #2103's
# squash-merge dropped the file.
#
# Run it explicitly (requires working Docker):
#   bazel test //manmanv2/api/handlers:action_execution_integration_test --test_output=all
go_test(
    # keep
    name = "action_execution_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["action_execution_integration_test.go"],
    embed = [":handlers"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/rmq",
        "//manmanv2/api/repository/postgres",
        "//manmanv2/protos:manmanpb",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//wait",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

# Real-Postgres coverage for FR12/FR13/FR15 (task #2811, plan #2777):
# BackupConfigHandler.ListBackupConfigActions must resolve each attached
# Action's name/command_template through the action repository while
# keeping the legacy parallel arrays consistent with `items`, an
# AddBackupConfigAction at an explicit display_order lands there, and
# ReorderBackupConfigActions returns NotFound/InvalidArgument for an
# unknown config or a mismatched action_ids set. Real Postgres via
# //libs/go/dbtest, same precedent as action_execution_integration_test --
# no RabbitMQ needed since none of the exercised paths publish a command.
#
# Run it explicitly (requires working Docker):
#   bazel test //manmanv2/api/handlers:backup_config_actions_integration_test --test_output=all
go_test(
