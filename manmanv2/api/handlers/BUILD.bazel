    name = "backup_config_actions_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["backup_config_actions_integration_test.go"],
    embed = [":handlers"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//manmanv2/api/repository/postgres",
        "//manmanv2/protos:manmanpb",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

# Real-Postgres coverage for FR1/FR4/NFR4 (task #2809, plan #2777):
