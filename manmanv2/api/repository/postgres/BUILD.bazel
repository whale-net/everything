        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//manmanv2/models",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

# Real-Postgres coverage for PendingRestartRepository (#1729): the unique
