load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workshop",
    srcs = [
        "batch.go",
        "cachekey.go",
        "entry_parser.go",
        "manager.go",
    ],
    importpath = "github.com/whale-net/everything/manmanv2/api/workshop",
    visibility = ["//visibility:public"],
    deps = [
        "//manmanv2/api/repository",
        "//manmanv2/api/steam",
        "//manmanv2/models",
    ],
)

