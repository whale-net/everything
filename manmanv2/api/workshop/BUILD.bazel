# fixed (workshopID, contentVersion) signature that leaves no parameter slot
# for host/SGC/deployment identity, and numeric-vs-string content-version
# normalisation.
go_test(
    name = "workshop_test",
    srcs = [
        "batch_test.go",
        "cachekey_test.go",
        "entry_parser_test.go",
        "manager_test.go",
    ],
    embed = [":workshop"],
    deps = [
        "//manmanv2/api/repository",
        "//manmanv2/api/steam",
        "//manmanv2/models",
    ],
)
