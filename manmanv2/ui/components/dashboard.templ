package components

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
)

// DashboardSummaryData holds dashboard statistics
type DashboardSummaryData struct {
	TotalServers   int
	OnlineServers  int
	TotalGames     int
	ActiveSessions int
}

templ DashboardSummary(data DashboardSummaryData) {
	<div class="card bg-base-100 border border-base-300 shadow-sm">
		<div class="card-body items-center text-center py-6">
			<div class="text-4xl font-bold text-info mb-2">{ fmt.Sprintf("%d", data.TotalServers) }</div>
			<div class="text-sm text-base-content/60">Total Servers</div>
		</div>
	</div>
	<div class="card bg-base-100 border border-base-300 shadow-sm">
		<div class="card-body items-center text-center py-6">
			<div class="text-4xl font-bold text-success mb-2">{ fmt.Sprintf("%d", data.OnlineServers) }</div>
			<div class="text-sm text-base-content/60">Online Servers</div>
		</div>
	</div>
	<div class="card bg-base-100 border border-base-300 shadow-sm">
		<div class="card-body items-center text-center py-6">
			<div class="text-4xl font-bold text-secondary mb-2">{ fmt.Sprintf("%d", data.TotalGames) }</div>
			<div class="text-sm text-base-content/60">Total Games</div>
		</div>
	</div>
	<div class="card bg-base-100 border border-base-300 shadow-sm">
		<div class="card-body items-center text-center py-6">
			<div class="text-4xl font-bold text-warning mb-2">{ fmt.Sprintf("%d", data.ActiveSessions) }</div>
			<div class="text-sm text-base-content/60">Active Sessions</div>
		</div>
	</div>
}

// PortInfo holds port binding data
type PortInfo struct {
	HostPort int32
	Protocol string
}

// ActiveSessionInfo holds enriched session data
type ActiveSessionInfo struct {
	SessionID  int64
	SGCID      int64
	Status     string
	Uptime     string
	ServerName string
	GameName   string
	ConfigName string
	Ports      []PortInfo
}

templ DashboardSessions(sessions []ActiveSessionInfo) {
	if len(sessions) > 0 {
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			for _, s := range sessions {
				<a href={ templ.URL(fmt.Sprintf("/sgc/%d", s.SGCID)) } class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-lg transition-shadow">
					<div class="card-body p-4">
						<div class="flex items-center justify-between mb-3">
							@htmxui.Badge(s.Status, StatusBadgeVariant(statusVariant(s.Status)), htmxui.BadgeSizeSM, true, nil)
							<span class="text-sm text-base-content/60">{ s.Uptime }</span>
						</div>
						<div class="text-lg font-semibold text-base-content mb-1">{ s.GameName }</div>
						<div class="text-sm text-base-content/60 mb-2">{ s.ConfigName }</div>
						<div class="text-sm text-base-content/50 mb-3">{ s.ServerName }</div>
						if len(s.Ports) > 0 {
							<div class="flex flex-wrap gap-2">
								for _, p := range s.Ports {
									<span class="badge badge-neutral badge-soft badge-sm">
										{ fmt.Sprintf("%d/%s", p.HostPort, p.Protocol) }
									</span>
								}
							</div>
						}
					</div>
				</a>
			}
		</div>
	} else {
		@EmptyState("No active sessions", "", "", "")
	}
}

func statusVariant(status string) string {
	switch status {
	case "running":
		return "success"
	case "starting":
		return "warning"
	case "stopping":
		return "warning"
	case "stopped":
		return "secondary"
	case "error":
		return "danger"
	default:
		return "secondary"
	}
}
