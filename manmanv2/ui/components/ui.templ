package components

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
)

// StatusBadgeVariant maps manmanv2's pre-migration status-key vocabulary
// (the raw enum-ish strings/semantic keys "online"/"success"/"danger"/etc.
// pages and dashboard.templ's statusVariant already normalize state into)
// onto htmxui.BadgeVariant, preserving the same colour/state meaning the
// old badgeClasses(status) switch in this file encoded (FR7 -- see #1008's
// "do not silently re-map a danger state to a neutral badge" rule). "info"
// is the one addition: the old switch had no case for it and silently fell
// through to the neutral default even though workshop_installations'
// "downloading" state was already named "info" by its own
// installStatusVariant -- mapping it onto BadgeInfo here restores that
// stated intent rather than changing it.
func StatusBadgeVariant(status string) htmxui.BadgeVariant {
	switch status {
	case "online", "active", "running", "completed", "success":
		return htmxui.BadgeSuccess
	case "offline", "inactive", "stopped", "secondary":
		return htmxui.BadgeNeutral
	case "starting", "stopping", "pending", "warning":
		return htmxui.BadgeWarning
	case "crashed", "error", "failed", "danger":
		return htmxui.BadgeError
	case "deployed", "primary":
		return htmxui.BadgePrimary
	case "info":
		return htmxui.BadgeInfo
	default:
		return htmxui.BadgeNeutral
	}
}

// Button/ButtonLink/Badge/Card/CardSimple used to live here as
// manmanv2-local re-implementations of daisyUI button/badge/card chrome.
// Per #1008 (FR4), that intermediate component layer is retired: page
// templates now call libs/go/htmxui's Button/Badge/Card/Confirm directly
// (or, for anchor-styled buttons -- which htmxui.Button, a <button>-only
// primitive, doesn't cover -- use the same raw `btn btn-<variant>
// btn-<size>` daisyUI classes htmxui.Button itself emits, matching the
// tools/app_registry/ui/pages precedent from #1005). What remains below is
// generic page-composition chrome (hero banners, form fields, empty
// states, alerts, definition-list items, tables) that htmxui has no
// primitive for; each is restyled onto daisyUI semantic tokens
// (bg-base-100/text-base-content/etc.) so it themes correctly under the
// data-theme switch #1007 introduced, instead of the old Tailwind
// `dark:`-variant pairs.

templ HeroHeader(title, subtitle string) {
	<div class="bg-gradient-to-br from-primary to-secondary text-primary-content rounded-box p-6 md:p-8 mb-6 shadow-lg">
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
			<div>
				<h1 class="text-2xl md:text-3xl font-bold mb-2">{ title }</h1>
				if subtitle != "" {
					<p class="text-primary-content/80 text-sm">{ subtitle }</p>
				}
			</div>
			<div class="flex gap-2">
				{ children... }
			</div>
		</div>
	</div>
}

templ FormInput(label, name, inputType, value string) {
	<div class="form-control w-full mb-4">
		<label class="label" for={ name }>
			<span class="label-text">{ label }</span>
		</label>
		<input
			type={ inputType }
			id={ name }
			name={ name }
			value={ value }
			class="input input-bordered w-full"
		/>
	</div>
}

templ FormSelect(label, name string, options []SelectOption, selected string) {
	<div class="form-control w-full mb-4">
		<label class="label" for={ name }>
			<span class="label-text">{ label }</span>
		</label>
		<select
			id={ name }
			name={ name }
			class="select select-bordered w-full"
		>
			for _, opt := range options {
				if opt.Value == selected {
					<option value={ opt.Value } selected>{ opt.Label }</option>
				} else {
					<option value={ opt.Value }>{ opt.Label }</option>
				}
			}
		</select>
	</div>
}

templ FormTextarea(label, name, value string, rows int) {
	<div class="form-control w-full mb-4">
		<label class="label" for={ name }>
			<span class="label-text">{ label }</span>
		</label>
		<textarea
			id={ name }
			name={ name }
			rows={ fmt.Sprintf("%d", rows) }
			class="textarea textarea-bordered w-full"
		>{ value }</textarea>
	</div>
}

type SelectOption struct {
	Value string
	Label string
}

templ EmptyState(title, description, actionText, actionHref string) {
	<div class="card bg-base-100 border border-base-300 shadow-sm">
		<div class="card-body items-center text-center py-12">
			<svg class="mx-auto h-12 w-12 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
			</svg>
			<h3 class="mt-2 text-sm font-medium text-base-content">{ title }</h3>
			<p class="mt-1 text-sm text-base-content/60">{ description }</p>
			if actionText != "" && actionHref != "" {
				<div class="mt-6">
					<a href={ templ.URL(actionHref) } class="btn btn-primary">
						{ actionText }
					</a>
				</div>
			}
		</div>
	</div>
}

templ Alert(alertType, message string) {
	if alertType == "warning" {
		<div role="alert" class="alert alert-warning mb-4">
			<span class="text-sm">{ message }</span>
		</div>
	} else if alertType == "error" {
		<div role="alert" class="alert alert-error mb-4">
			<span class="text-sm">{ message }</span>
		</div>
	} else {
		<div role="alert" class="alert alert-info mb-4">
			<span class="text-sm">{ message }</span>
		</div>
	}
}

templ DLItem(label, value string) {
	<div>
		<dt class="text-sm font-medium text-base-content/60">{ label }</dt>
		<dd class="mt-1 text-sm text-base-content">{ value }</dd>
	</div>
}

templ DLItemMono(label, value string) {
	<div>
		<dt class="text-sm font-medium text-base-content/60">{ label }</dt>
		<dd class="mt-1 text-sm text-base-content font-mono">{ value }</dd>
	</div>
}

templ DLItemCode(label, value string) {
	<div class="md:col-span-2">
		<dt class="text-sm font-medium text-base-content/60">{ label }</dt>
		<dd class="mt-1">
			if value != "" {
				<pre class="text-sm font-mono text-base-content bg-base-200 p-3 rounded border border-base-300 overflow-x-auto">{ value }</pre>
			} else {
				<span class="text-sm text-base-content">-</span>
			}
		</dd>
	</div>
}

templ Table() {
	<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden">
		<div class="overflow-x-auto">
			<table class="table">
				{ children... }
			</table>
		</div>
	</div>
}

templ TableInline() {
	<div class="overflow-x-auto">
		<table class="table">
			{ children... }
		</table>
	</div>
}
