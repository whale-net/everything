package components

import "github.com/whale-net/everything/libs/go/htmxsse/liveindicator"

// LiveRegionOptions parameterises LiveRegion for each caller.
//
// ReloadHref exists because the markup this was lifted from
// (pages/sessions.templ's DeploymentsLiveRegion) hard-coded
// <a href="/sessions">; Activity (FR15) needs the same indicator pointing
// at its own path, so the reload target is now a parameter rather than a
// literal.
type LiveRegionOptions struct {
	// SSEPath is the hx-sse:connect container's target, e.g.
	// "/api/live/deployments".
	SSEPath string
	// HeartbeatIntervalMs is the resolved server heartbeat interval, in
	// milliseconds, used for the Not-Live debounce: the client waits one
	// heartbeat interval after htmx:sse:error (or a missed heartbeat)
	// before flipping the indicator, so a single dropped beat doesn't
	// flap it.
	HeartbeatIntervalMs int
	// ReloadHref is the page to reload when the connection goes stale;
	// "/sessions" for the existing sessions-page caller.
	ReloadHref string
}

// LiveRegion is the not-live indicator lifted out of
// pages/sessions.templ's DeploymentsLiveRegion (#1726): hx-sse:connect on
// the outer container (an ancestor of every per-row data-sse-topic target
// the caller renders via { children... }, never itself a swap target -- see
// libs/go/htmxsse/README.md's "Critical for adopters" note: an
// hx-sse:connect element that gets swapped re-opens its connection before
// the reconnect can carry Last-Event-ID, breaking the reconnect-baseline
// suppression callers rely on).
//
// Liveness detection is delegated to liveindicator.LiveIndicator (see its
// package doc comment): this component used to run its own
// MutationObserver over the caller's content, which is blind to a
// heartbeat that emits a keepalive rather than a swap -- any page whose
// content stayed unchanged for longer than 2x the heartbeat interval read
// "Not Live" even though the connection was healthy the whole time.
// liveindicator fixes this the same way for every caller, static topic
// list or per-row, so LiveRegion is now a thin wrapper: it still owns the
// hx-sse:connect container (the piece every caller needs regardless of
// topic shape) and hands the rest to liveindicator.
templ LiveRegion(opts LiveRegionOptions) {
	<div hx-sse:connect={ opts.SSEPath }>
		@liveindicator.LiveIndicator(liveindicator.Options{
			HeartbeatIntervalMs: opts.HeartbeatIntervalMs,
			ReloadHref:          opts.ReloadHref,
		})
		{ children... }
	</div>
}
