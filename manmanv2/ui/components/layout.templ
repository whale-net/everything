package components

import (
	"fmt"
	"github.com/whale-net/everything/libs/go/htmxauth"
	"github.com/whale-net/everything/libs/go/htmxui"
	"github.com/whale-net/everything/manmanv2/protos"
)

type LayoutData struct {
	Title          string
	Active         string
	User           *htmxauth.UserInfo
	Servers        []*manmanpb.Server
	SelectedServer *manmanpb.Server
	Breadcrumbs    []Breadcrumb
}

type Breadcrumb struct {
	Label string
	URL   string
	Icon  string
}

// manmanThemes is the FR6 theme list manmanv2 offers through the shared
// htmxui.ThemeSwitcher (mounted by Layout, below): light, night, and
// oled, keyed to the [data-theme="..."] rules in the shared
// libs/go/htmxui/themes.css. OLED is reachable here where it never was
// under the old Tailwind darkMode:'class' + manual `dark` class toggle
// (FR6 defect) — see themes.css for the actual pure-black palette this
// now renders.
var manmanThemes = []htmxui.Theme{
	{Value: "light", Label: "☀️ Light"},
	{Value: "night", Label: "🌙 Night"},
	{Value: "oled", Label: "⚫ OLED Night"},
}

// navLink renders one nav entry, marking it active by exact label match
// (mirrors the pre-migration NavItem's active-comparison semantics).
templ navLink(href, label, active string) {
	if active == label {
		<li><a href={ templ.URL(href) } class="menu-active">{ label }</a></li>
	} else {
		<li><a href={ templ.URL(href) }>{ label }</a></li>
	}
}

// navItems is manmanv2's app-owned nav item list (FR1a — Shell hardcodes
// no nav of its own, see htmxui.ShellData's doc comment). It renders
// twice: once as a horizontal menu for wide viewports, once folded into a
// dropdown menu (reusing the same tabindex/focus-driven daisyUI dropdown
// pattern htmxui.ThemeSwitcher uses, see theme_switcher.templ) for narrow
// ones, so collapsing the old hamburger menu needs no JS of its own —
// the previous themeManagement() script's manual mobile-menu-button
// toggle is retired along with the rest of that script.
templ navItems(data LayoutData) {
	<ul class="menu menu-horizontal hidden lg:flex px-1">
		@navLink("/", "Dashboard", data.Active)
		@navLink("/servers", "Servers", data.Active)
		@navLink("/games", "Games", data.Active)
		@navLink("/sessions", "Sessions", data.Active)
		@navLink("/workshop/library", "Workshop", data.Active)
	</ul>
	<div class="dropdown lg:hidden">
		<div tabindex="0" role="button" class="btn btn-ghost btn-sm" aria-label="Open menu">
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</div>
		<ul tabindex="0" class="dropdown-content menu bg-base-100 text-base-content rounded-box z-10 w-64 p-2 shadow">
			@navLink("/", "Dashboard", data.Active)
			@navLink("/servers", "Servers", data.Active)
			@navLink("/games", "Games", data.Active)
			@navLink("/sessions", "Sessions", data.Active)
			@navLink("/workshop/library", "Workshop", data.Active)
			<li class="menu-title">Server</li>
			@MobileServerSelector(data.Servers, data.SelectedServer)
			if data.User != nil {
				<li><a href="/auth/logout">Logout ({ data.User.Name })</a></li>
			}
		</ul>
	</div>
}

// headerRight is manmanv2's HeaderRight composition slot content (FR1a):
// the desktop-visible ServerSelector plus the existing logout link.
// Unifying this top-right user area on a shared FR8 component is Phase
// 3, not this issue — this keeps the existing logout link working via
// the slot, per #1007's scope.
templ headerRight(data LayoutData) {
	<div class="hidden lg:flex items-center gap-2">
		@ServerSelector(data.Servers, data.SelectedServer)
		if data.User != nil {
			<a href="/auth/logout" class="btn btn-ghost btn-sm">
				Logout ({ data.User.Name })
			</a>
		}
	</div>
}

templ ServerSelector(servers []*manmanpb.Server, selectedServer *manmanpb.Server) {
	if len(servers) > 0 {
		<form method="POST" action="/select-server" class="flex items-center">
			<select name="server_id" onchange="this.form.submit()" class="select select-sm">
				<option value="">Select Server</option>
				for _, server := range servers {
					if selectedServer != nil && selectedServer.ServerId == server.ServerId {
						<option value={ templ.EscapeString(fmt.Sprintf("%d", server.ServerId)) } selected>
							{ server.Name }
							if server.IsDefault {
								(default)
							}
						</option>
					} else {
						<option value={ templ.EscapeString(fmt.Sprintf("%d", server.ServerId)) }>
							{ server.Name }
							if server.IsDefault {
								(default)
							}
						</option>
					}
				}
			</select>
		</form>
	}
}

templ MobileServerSelector(servers []*manmanpb.Server, selectedServer *manmanpb.Server) {
	if len(servers) > 0 {
		<li>
			<form method="POST" action="/select-server" class="w-full">
				<select name="server_id" onchange="this.form.submit()" class="select select-sm w-full">
					<option value="">Select Server</option>
					for _, server := range servers {
						if selectedServer != nil && selectedServer.ServerId == server.ServerId {
							<option value={ templ.EscapeString(fmt.Sprintf("%d", server.ServerId)) } selected>
								{ server.Name }
								if server.IsDefault {
									(default)
								}
							</option>
						} else {
							<option value={ templ.EscapeString(fmt.Sprintf("%d", server.ServerId)) }>
								{ server.Name }
								if server.IsDefault {
									(default)
								}
							</option>
						}
					}
				</select>
			</form>
		</li>
	}
}

templ Breadcrumbs(items []Breadcrumb) {
	if len(items) > 0 {
		<nav class="breadcrumbs text-sm mb-4" aria-label="Breadcrumb">
			<ul>
				for _, item := range items {
					<li>
						if item.URL != "" {
							<a href={ templ.URL(item.URL) }>{ item.Label }</a>
						} else {
							<span>{ item.Label }</span>
						}
					</li>
				}
			</ul>
		</nav>
	}
}

// toastScript keeps the pre-migration showToast custom-event contract
// (evt.detail.type / evt.detail.message) unchanged (FR7 — no behavior
// changes, only markup/styling), but builds daisyUI's own toast recipe
// for the appended item now that #toast (below) is a real daisyUI `.toast`
// positioning container: `.toast` on the item itself, as the pre-daisyUI
// version used, would collide with that container class, so items use
// `.alert.alert-{type}` instead — daisyUI's toast-item vocabulary.
script toastScript() {
	document.body.addEventListener('showToast', function(evt) {
		const toast = document.createElement('div');
		toast.className = 'alert alert-' + evt.detail.type;
		toast.textContent = evt.detail.message;
		document.getElementById('toast').appendChild(toast);
		setTimeout(() => toast.remove(), 5000);
	});
}

// Layout is manmanv2's chrome, rebuilt on htmxui.Shell (FR4): the shared
// navbar frame and ThemeSwitcher mount now come from htmxui, with
// manmanv2's own nav (navItems), server selector + logout (headerRight),
// and breadcrumbs (as Shell's app-specific Banner slot) composed in via
// Shell's app-owned slots (FR1a). The local ThemeSwitcher/
// MobileThemeSwitcher and their themeManagement()/themeScript() JS
// (FR5's location.reload() defect lived there) are deleted outright, not
// migrated — htmxui.ThemeSwitcher replaces them.
templ Layout(data LayoutData) {
	@htmxui.Shell(htmxui.ShellData{
		Title:       data.Title,
		BrandLabel:  "ManManV2",
		BrandHref:   "/",
		Nav:         navItems(data),
		Banner:      Breadcrumbs(data.Breadcrumbs),
		HeaderRight: headerRight(data),
		Themes:      manmanThemes,
	}) {
		{ children... }
	}
	<div id="toast" class="toast toast-end"></div>
	@toastScript()
}
