package pages

import (
	components "github.com/whale-net/everything/manmanv2/ui/components"
)

templ Home(layoutData components.LayoutData) {
	@components.Layout(layoutData) {
		<h1 class="text-3xl font-bold text-base-content mb-6">Dashboard</h1>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8" hx-get="/api/dashboard-summary" hx-trigger="load, every 30s" hx-swap="innerHTML">
			<div class="card bg-base-100 border border-base-300 shadow-sm">
				<div class="card-body items-center text-center py-6">
					<div class="text-4xl font-bold text-info mb-2">-</div>
					<div class="text-sm text-base-content/60">Total Servers</div>
				</div>
			</div>
			<div class="card bg-base-100 border border-base-300 shadow-sm">
				<div class="card-body items-center text-center py-6">
					<div class="text-4xl font-bold text-success mb-2">-</div>
					<div class="text-sm text-base-content/60">Online Servers</div>
				</div>
			</div>
			<div class="card bg-base-100 border border-base-300 shadow-sm">
				<div class="card-body items-center text-center py-6">
					<div class="text-4xl font-bold text-secondary mb-2">-</div>
					<div class="text-sm text-base-content/60">Total Games</div>
				</div>
			</div>
			<div class="card bg-base-100 border border-base-300 shadow-sm">
				<div class="card-body items-center text-center py-6">
					<div class="text-4xl font-bold text-warning mb-2">-</div>
					<div class="text-sm text-base-content/60">Active Sessions</div>
				</div>
			</div>
		</div>
		<h2 class="text-2xl font-bold text-base-content mb-4">Active Sessions</h2>
		<div
			id="active-sessions"
			hx-get="/api/dashboard-sessions"
			hx-trigger="load, every 10s"
			hx-swap="innerHTML"
		>
			<div class="text-center py-12">
				<div class="text-base-content/60">Loading...</div>
			</div>
		</div>
	}
}
