package pages

import (
	"fmt"
	"github.com/whale-net/everything/manmanv2/ui/components"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
)

type WorkshopSearchPageData struct {
	Layout        components.LayoutData
	Query         string
	GameID        int64
	TypeFilter    string
	Games         []*manmanpb.Game
	Libraries     []*manmanpb.WorkshopLibrary
	Addons        []*manmanpb.WorkshopAddon
}

templ WorkshopSearch(data WorkshopSearchPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		<div 
			id="workshop-search-data"
			data-query={ data.Query }
			data-type-filter={ data.TypeFilter }
			data-libraries={ templ.JSONString(data.Libraries) }
			data-addons={ templ.JSONString(data.Addons) }
			data-games={ templ.JSONString(data.Games) }
			x-data="{
				query: '',
				typeFilter: 'all',
				libraries: [],
				addons: [],
				games: [],
				init() {
					this.query = this.$el.dataset.query || '';
					this.typeFilter = this.$el.dataset.typeFilter || 'all';
					this.libraries = JSON.parse(this.$el.dataset.libraries || '[]');
					this.addons = JSON.parse(this.$el.dataset.addons || '[]');
					this.games = JSON.parse(this.$el.dataset.games || '[]');
				},
				get filteredLibraries() {
					if (!this.query) return this.libraries;
					const q = this.query.toLowerCase();
					return this.libraries.filter(lib => 
						lib.name.toLowerCase().includes(q) || 
						(lib.description && lib.description.toLowerCase().includes(q))
					);
				},
				get filteredAddons() {
					if (!this.query) return this.addons;
					const q = this.query.toLowerCase();
					return this.addons.filter(addon => 
						addon.name.toLowerCase().includes(q) || 
						addon.workshop_id.toLowerCase().includes(q)
					);
				},
				get showLibraries() { return this.typeFilter === 'all' || this.typeFilter === 'library'; },
				get showAddons() { return this.typeFilter === 'all' || this.typeFilter === 'addon' || this.typeFilter === 'collection'; }
			}"
		>
			<div class="bg-gradient-to-br from-primary to-secondary rounded-box p-6 md:p-8 mb-6 shadow-lg">
				<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
					<div class="text-primary-content">
						<h1 class="text-2xl md:text-3xl font-bold mb-2">Workshop Search</h1>
						<p class="text-primary-content/80 text-sm">Search and discover workshop content and addon libraries</p>
					</div>
					<a href="/workshop/library" class="btn bg-primary-content/20 hover:bg-primary-content/30 text-primary-content border-primary-content/30">← Workshop Home</a>
				</div>
			</div>
			<!-- Filter Bar -->
			<div class="bg-base-100 rounded-box border border-base-300 p-4 mb-6">
				<form method="GET" action="/workshop/search" class="space-y-4">
					<div class="flex flex-col md:flex-row gap-4">
						<div class="flex-1">
							<label class="block text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-2">Search Query</label>
							<input type="text" name="q" x-model="query" placeholder="Search by name or ID..." class="input input-bordered w-full"/>
						</div>
						<div class="w-full md:w-48">
							<label class="block text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-2">Game</label>
							<select name="game_id" class="select select-bordered w-full">
								<option value="">All Games</option>
								for _, game := range data.Games {
									if game.GameId == data.GameID {
										<option value={ fmt.Sprintf("%d", game.GameId) } selected>{ game.Name }</option>
									} else {
										<option value={ fmt.Sprintf("%d", game.GameId) }>{ game.Name }</option>
									}
								}
							</select>
						</div>
						<div class="flex items-end">
							<button type="submit" class="w-full md:w-auto btn btn-primary">Search</button>
						</div>
					</div>
					<div class="pt-4 border-t border-base-300">
						<label class="block text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-2">Type Filter</label>
						<div class="flex flex-wrap gap-2">
							<button type="button" @click="typeFilter = 'all'" :class="typeFilter === 'all' ? 'btn-primary' : 'btn-outline'" class="btn btn-sm rounded-full">All</button>
							<button type="button" @click="typeFilter = 'library'" :class="typeFilter === 'library' ? 'btn-primary' : 'btn-outline'" class="btn btn-sm rounded-full">Libraries</button>
							<button type="button" @click="typeFilter = 'addon'" :class="typeFilter === 'addon' ? 'btn-primary' : 'btn-outline'" class="btn btn-sm rounded-full">Addons</button>
							<button type="button" @click="typeFilter = 'collection'" :class="typeFilter === 'collection' ? 'btn-primary' : 'btn-outline'" class="btn btn-sm rounded-full">Collections</button>
						</div>
					</div>
				</form>
			</div>
			<!-- Libraries Results -->
			<div x-show="showLibraries" x-cloak class="mb-8">
				<div class="flex justify-between items-center mb-4 pb-3 border-b-2 border-base-300">
					<h2 class="text-lg font-bold text-base-content">Libraries</h2>
					<span class="text-sm text-base-content/60" x-text="`${filteredLibraries.length} results`"></span>
				</div>
				<div x-show="filteredLibraries.length === 0" class="text-center py-12 text-base-content/60">No libraries found</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					<template x-for="(lib, index) in filteredLibraries">
						<a :href="`/workshop/library-detail?library_id=${lib.library_id}`" class="block bg-base-100 rounded-box border border-base-300 p-5 hover:shadow-lg hover:-translate-y-0.5 transition-all">
							<div class="flex justify-between items-start mb-2 gap-2">
								<span class="font-semibold text-base-content" x-text="lib.name"></span>
								<template x-for="(game, gindex) in games">
									<span x-show="game.game_id === lib.game_id" class="badge badge-primary badge-soft whitespace-nowrap" x-text="game.name"></span>
								</template>
							</div>
							<div class="text-sm text-base-content/60 mb-3 line-clamp-2">
								<span x-show="lib.description" x-text="lib.description"></span>
								<em x-show="!lib.description" class="text-base-content/40">No description</em>
							</div>
						</a>
					</template>
				</div>
			</div>
			<!-- Addons Results -->
			<div x-show="showAddons" x-cloak>
				<div class="flex justify-between items-center mb-4 pb-3 border-b-2 border-base-300">
					<h2 class="text-lg font-bold text-base-content">Addons</h2>
					<span class="text-sm text-base-content/60" x-text="`${filteredAddons.length} results`"></span>
				</div>
				<div x-show="filteredAddons.length === 0" class="text-center py-12 text-base-content/60">No addons found</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
					<template x-for="(addon, index) in filteredAddons">
						<a :href="`/workshop/addon?addon_id=${addon.addon_id}`" class="block bg-base-100 rounded-box border border-base-300 p-4 hover:shadow-md transition-shadow">
							<div class="font-semibold text-base-content text-sm mb-2" x-text="addon.name"></div>
							<div class="badge badge-neutral badge-soft font-mono mb-3" x-text="addon.workshop_id"></div>
							<div class="flex justify-between items-center text-xs text-base-content/60">
								<span x-show="addon.file_size_bytes > 0" x-text="`${(addon.file_size_bytes / 1048576).toFixed(1)} MB`"></span>
								<template x-for="(game, gindex) in games">
									<span x-show="game.game_id === addon.game_id" x-text="game.name"></span>
								</template>
							</div>
						</a>
					</template>
				</div>
			</div>
		</div>
	}
}

