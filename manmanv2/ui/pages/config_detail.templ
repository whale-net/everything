package pages

import (
	"fmt"
	"strings"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

type ConfigDetailPageData struct {
	Layout        components.LayoutData
	Game          *manmanpb.Game
	Config        *manmanpb.GameConfig
	Servers       []*manmanpb.Server
	Deployments   []ServerGameConfigView
	DeployError   string
	Volumes       []*manmanpb.GameConfigVolume
	BackupConfigs []ConfigBackupGroup
}

type ServerGameConfigView struct {
	Server *manmanpb.Server
	Config *manmanpb.ServerGameConfig
}

type ConfigBackupGroup struct {
	Volume  *manmanpb.GameConfigVolume
	Configs []*manmanpb.BackupConfig
}

templ ConfigDetail(data ConfigDetailPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		<div x-data="{ showEdit: false }">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
				<div>
					<div class="flex items-center gap-2 mb-2">
						<span class="badge badge-success badge-soft">
							⚙️ GAME CONFIG
						</span>
					</div>
					<h1 class="text-3xl font-bold text-base-content">{ data.Config.Name }</h1>
					<p class="text-sm text-base-content/60 mt-1">{ fmt.Sprintf("for %s", data.Game.Name) }</p>
				</div>
				<div class="flex flex-wrap gap-2">
					<a href={ templ.URL(fmt.Sprintf("/games/%d", data.Game.GameId)) } class="btn btn-secondary btn-sm">Back to Game</a>
					<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d/actions", data.Game.GameId, data.Config.ConfigId)) } class="btn btn-primary btn-sm">⚡ Manage Actions</a>
					<button @click="showEdit = !showEdit" class="btn btn-secondary btn-sm">
						<span x-text="showEdit ? 'Cancel Edit' : 'Edit'">Edit</span>
					</button>
				</div>
			</div>
			<div class="card bg-base-100 border border-base-300 shadow-sm p-6 mb-6">
				<h2 class="text-lg font-semibold text-base-content mb-4">Configuration Details</h2>
				<dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
					@components.DLItemMono("Config ID", fmt.Sprintf("%d", data.Config.ConfigId))
					<div>
						<dt class="text-sm font-medium text-base-content/60">Game</dt>
						<dd class="mt-1 text-sm">
							<a href={ templ.URL(fmt.Sprintf("/games/%d", data.Game.GameId)) } class="link link-primary">{ data.Game.Name }</a>
						</dd>
					</div>
					@components.DLItem("Name", data.Config.Name)
					@components.DLItemMono("Docker Image", data.Config.Image)
					<div>
						<dt class="text-sm font-medium text-base-content/60">Entrypoint</dt>
						<dd class="mt-1 text-sm font-mono text-base-content">
							if len(data.Config.Entrypoint) > 0 {
								{ strings.Join(data.Config.Entrypoint, " ") }
							} else {
								-
							}
						</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-base-content/60">Command</dt>
						<dd class="mt-1 text-sm font-mono text-base-content">
							if len(data.Config.Command) > 0 {
								{ strings.Join(data.Config.Command, " ") }
							} else {
								-
							}
						</dd>
					</div>
					if data.Config.ArgsTemplate != "" {
						<div class="md:col-span-2">
							<dt class="text-sm font-medium text-base-content/60">Args Template</dt>
							<dd class="mt-1">
								<pre class="text-sm font-mono text-base-content bg-base-200 p-3 rounded border border-base-300 overflow-x-auto">{ data.Config.ArgsTemplate }</pre>
							</dd>
						</div>
					}
				</dl>
			</div>
			<!-- Deployments -->
			<div class="card bg-base-100 border-2 border-info/40 shadow-md overflow-hidden mb-6">
				<div class="bg-info/10 px-6 py-4 border-b border-info/40">
					<h2 class="text-lg font-semibold text-info">🚀 Deployments</h2>
				</div>
				<div class="p-6">
					if data.DeployError != "" {
						<div role="alert" class="alert alert-warning mb-4">
							<span class="text-sm">{ data.DeployError }</span>
						</div>
					}
					if len(data.Deployments) > 0 {
						<div class="mb-6">
							<h3 class="text-base font-semibold text-base-content mb-3">Active Deployments ({ fmt.Sprintf("%d", len(data.Deployments)) })</h3>
							<div class="overflow-x-auto">
								<table class="table">
									<thead class="bg-base-200">
										<tr>
											<th scope="col">Server</th>
											<th scope="col">SGC ID</th>
											<th scope="col">Status</th>
											<th scope="col" class="text-right">Actions</th>
										</tr>
									</thead>
									<tbody>
										for _, dep := range data.Deployments {
											<tr class="hover">
												<td>
													<a href={ templ.URL(fmt.Sprintf("/servers/%d", dep.Server.ServerId)) } class="text-sm font-medium link link-primary">{ dep.Server.Name }</a>
												</td>
												<td class="text-sm font-mono text-base-content">{ fmt.Sprintf("%d", dep.Config.ServerGameConfigId) }</td>
												<td class="text-sm text-base-content">{ dep.Config.Status }</td>
												<td class="text-right text-sm space-x-2">
													<a class="btn btn-primary btn-sm" href={ templ.URL(fmt.Sprintf("/sgc/%d", dep.Config.ServerGameConfigId)) }>Manage</a>
													<a class="btn btn-secondary btn-sm" href={ templ.URL(fmt.Sprintf("/sessions?server_game_config_id=%d", dep.Config.ServerGameConfigId)) }>Sessions</a>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					} else {
						<div class="bg-base-200 rounded-box p-8 text-center mb-6">
							<h3 class="text-sm font-medium text-base-content mb-1">No deployments yet</h3>
							<p class="text-sm text-base-content/60">Deploy this config to a server to create a Server Game Config</p>
						</div>
					}
					<div class="border-t border-base-300 pt-6">
						<h3 class="text-base font-semibold text-base-content mb-3">Deploy to Server</h3>
						<div
							x-data="{
								ports: [],
								addPort() { this.ports.push({ container_port: '', host_port: '', protocol: 'TCP' }) },
								removePort(i) { this.ports.splice(i, 1) }
							}"
						>
							<form
								method="POST"
								action={ templ.URL(fmt.Sprintf("/games/%d/configs/%d/deploy", data.Game.GameId, data.Config.ConfigId)) }
								x-on:submit="$event.target.port_bindings_json.value = JSON.stringify(ports.filter(p => p.container_port && p.host_port).map(p => ({ container_port: parseInt(p.container_port), host_port: parseInt(p.host_port), protocol: p.protocol })))"
							>
								<input type="hidden" name="port_bindings_json" value=""/>
								<div class="flex gap-3 mb-4">
									<select name="server_id" required class="select select-bordered flex-1">
										<option value="">Select a server...</option>
										for _, server := range data.Servers {
											<option value={ fmt.Sprintf("%d", server.ServerId) }>{ server.Name }</option>
										}
									</select>
									<button type="submit" class="btn btn-success">Deploy</button>
								</div>
								<div>
									<label class="block text-sm font-medium text-base-content/70 mb-2">Port Bindings (optional)</label>
									<template x-for="(pb, idx) in ports" :key="idx">
										<div class="flex gap-2 items-center mb-2">
											<input type="number" x-model="pb.container_port" min="1" max="65535" placeholder="Container Port" class="input input-bordered input-sm w-36 font-mono"/>
											<span class="text-base-content/60">→</span>
											<input type="number" x-model="pb.host_port" min="1" max="65535" placeholder="Host Port" class="input input-bordered input-sm w-36 font-mono"/>
											<select x-model="pb.protocol" class="select select-bordered select-sm">
												<option value="TCP">TCP</option>
												<option value="UDP">UDP</option>
											</select>
											<button type="button" x-on:click="removePort(idx)" class="btn btn-error btn-sm btn-square">×</button>
										</div>
									</template>
									<button type="button" x-on:click="addPort()" class="btn btn-neutral btn-sm">+ Add Port Binding</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
			// Advanced Configuration (Collapsible)
			<div x-data="{ showAdvanced: false }" class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
				<button @click="showAdvanced = !showAdvanced" class="w-full px-6 py-4 flex justify-between items-center hover:bg-base-200 transition-colors">
					<h2 class="text-lg font-semibold text-base-content">⚙️ Advanced Configuration</h2>
					<svg class="w-5 h-5 text-base-content/60 transition-transform" :class="{ 'rotate-180': showAdvanced }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
				<div x-show="showAdvanced" x-collapse class="border-t border-base-300">
					// Volumes
					<div class="p-6 border-b border-base-300">
						<div class="flex justify-between items-center mb-4">
							<h3 class="text-base font-semibold text-base-content">Volume Mounts</h3>
						</div>
						<p class="text-sm text-base-content/60 mb-4">
							Persistent volumes defined at the game level. These are automatically mapped to subdirectories in the game server's data directory.
						</p>
						if len(data.Volumes) > 0 {
							<div class="overflow-x-auto mb-4">
								<table class="table">
									<thead class="bg-base-200">
										<tr>
											<th scope="col">Name</th>
											<th scope="col">Container Path</th>
											<th scope="col">Host Subpath</th>
											<th scope="col">Read-Only</th>
											<th scope="col" class="text-right">Actions</th>
										</tr>
									</thead>
									<tbody>
										for _, vol := range data.Volumes {
											<tr class="hover">
												<td>
													<div class="text-sm font-medium text-base-content">{ vol.Name }</div>
													if vol.Description != "" {
														<div class="text-xs text-base-content/60">{ vol.Description }</div>
													}
												</td>
												<td class="text-sm font-mono text-base-content">{ vol.ContainerPath }</td>
												<td class="text-sm font-mono text-base-content">
													if vol.HostSubpath != "" {
														{ vol.HostSubpath }
													} else {
														<em class="text-base-content/50">(auto)</em>
													}
												</td>
												<td class="text-sm text-base-content">
													if vol.ReadOnly {
														Yes
													} else {
														No
													}
												</td>
												<td class="text-right">
													<button
														hx-delete={ fmt.Sprintf("/games/%d/configs/%d/volumes/%d", data.Game.GameId, data.Config.ConfigId, vol.VolumeId) }
														hx-confirm="Delete this volume?"
														hx-target="body"
														class="btn btn-error btn-sm"
													>
														Delete
													</button>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						} else {
							<div class="bg-base-200 rounded-box p-6 text-center mb-4">
								<p class="text-sm text-base-content/60">No volumes configured for this GameConfig.</p>
							</div>
						}
						<div x-data="{ showAddVolume: false }">
							<button @click="showAddVolume = !showAddVolume" class="btn btn-primary btn-sm">
								+ Add Volume
							</button>
							<div x-show="showAddVolume" x-collapse class="mt-4 p-4 bg-base-200 rounded-box border border-base-300">
								<form 
									method="POST" 
									action={ templ.URL(fmt.Sprintf("/games/%d/configs/%d/volumes", data.Game.GameId, data.Config.ConfigId)) }
									hx-post={ fmt.Sprintf("/games/%d/configs/%d/volumes", data.Game.GameId, data.Config.ConfigId) }
									hx-target="body"
								>
									<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
										<div>
											<label class="block text-sm font-medium text-base-content mb-2">Name</label>
											<input type="text" name="name" required class="input input-bordered w-full"/>
										</div>
										<div>
											<label class="block text-sm font-medium text-base-content mb-2">Container Path</label>
											<input type="text" name="container_path" required placeholder="/path/in/container" class="input input-bordered w-full font-mono"/>
										</div>
										<div>
											<label class="block text-sm font-medium text-base-content mb-2">Host Subpath (optional)</label>
											<input type="text" name="host_subpath" placeholder="auto-generated if empty" class="input input-bordered w-full font-mono"/>
										</div>
										<div>
											<label class="block text-sm font-medium text-base-content mb-2">Volume Type</label>
											<select name="volume_type" class="input input-bordered w-full">
												<option value="bind">Bind (host path)</option>
												<option value="named">Named (Docker volume)</option>
											</select>
										</div>
									</div>
									<div class="mb-4">
										<label class="block text-sm font-medium text-base-content mb-2">Description (optional)</label>
										<input type="text" name="description" class="input input-bordered w-full"/>
									</div>
									<div class="mb-4">
										<label class="flex items-center gap-2">
											<input type="checkbox" name="read_only" value="true" class="checkbox checkbox-sm"/>
											<span class="text-sm text-base-content">Read-only</span>
										</label>
									</div>
									<div class="flex gap-2">
										<button type="submit" class="btn btn-success">Add Volume</button>
										<button type="button" @click="showAddVolume = false" class="btn btn-secondary">Cancel</button>
									</div>
								</form>
							</div>
						</div>
					</div>
					// Environment Variables
					<div 
						id="env-vars-section" 
						data-env-template={ templ.JSONString(data.Config.EnvTemplate) }
						x-data="{ 
							editEnv: false, 
							envVars: {},
							init() {
								const dataStr = this.$el.dataset.envTemplate;
								this.envVars = dataStr ? JSON.parse(dataStr) : {};
							}
						}" 
						class="p-6 border-b border-base-300"
					>
						<div class="flex justify-between items-center mb-4">
							<h3 class="text-base font-semibold text-base-content">Environment Variables</h3>
							<button @click="editEnv = !editEnv" class="btn btn-sm" :class="editEnv ? 'btn-secondary' : 'btn-primary'">
								<span x-text="editEnv ? 'Cancel' : 'Edit'">Edit</span>
							</button>
						</div>
						// View Mode
						<div x-show="!editEnv">
							if len(data.Config.EnvTemplate) > 0 {
								<div class="overflow-x-auto">
									<table class="table">
										<thead class="bg-base-200">
											<tr>
												<th scope="col">Key</th>
												<th scope="col">Value</th>
											</tr>
										</thead>
										<tbody>
											for key, value := range data.Config.EnvTemplate {
												<tr>
													<td class="text-sm font-mono text-base-content">{ key }</td>
													<td class="text-sm font-mono text-base-content">{ value }</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							} else {
								<p class="text-sm text-base-content/60">No environment variables set.</p>
							}
						</div>
						// Edit Mode
						<div x-show="editEnv" x-cloak>
							<form 
								method="POST" 
								action={ templ.URL(fmt.Sprintf("/games/%d/configs/%d/update-env", data.Game.GameId, data.Config.ConfigId)) } 
								hx-post={ fmt.Sprintf("/games/%d/configs/%d/update-env", data.Game.GameId, data.Config.ConfigId) }
								hx-target="body"
								x-on:submit="$event.target.env_template_json.value = JSON.stringify(envVars)"
							>
								<input type="hidden" name="env_template_json" value=""/>
								<div class="space-y-2 mb-4">
									<template x-for="(value, key) in envVars" :key="key">
										<div class="flex gap-2">
											<input type="text" x-model="key" disabled class="input input-bordered flex-1 bg-base-200 font-mono text-sm"/>
											<input type="text" x-bind:value="envVars[key]" x-on:input="envVars[key] = $event.target.value" class="select select-bordered flex-1 font-mono text-sm"/>
											<button type="button" x-on:click="delete envVars[key]" class="btn btn-error btn-sm">×</button>
										</div>
									</template>
								</div>
								<div x-data="{ newKey: '', newValue: '' }" class="flex gap-2 mb-4">
									<input type="text" x-model="newKey" placeholder="KEY" class="select select-bordered flex-1 font-mono text-sm"/>
									<input type="text" x-model="newValue" placeholder="value" class="select select-bordered flex-1 font-mono text-sm"/>
									<button type="button" x-on:click="if(newKey) { envVars[newKey] = newValue; newKey = ''; newValue = ''; }" class="btn btn-secondary">+ Add</button>
								</div>
								<button type="submit" class="btn btn-success">Save</button>
							</form>
						</div>
					</div>
					// Backup Configs
					<div class="p-6">
						<h3 class="text-base font-semibold text-base-content mb-4">Backup Configurations</h3>
						if len(data.BackupConfigs) > 0 {
							for _, group := range data.BackupConfigs {
								<div class="mb-6 last:mb-0 border border-base-300 rounded-lg overflow-hidden">
									<div class="bg-base-200">
										<h4 class="text-sm font-semibold text-base-content">Volume: { group.Volume.Name }</h4>
									</div>
									<div class="p-4">
										if len(group.Configs) > 0 {
											<div class="overflow-x-auto mb-4">
												<table class="table">
													<thead class="bg-base-200">
														<tr>
															<th scope="col">Backup ID</th>
															<th scope="col">Cadence</th>
															<th scope="col">Path</th>
															<th scope="col">Enabled</th>
															<th scope="col" class="text-right">Actions</th>
														</tr>
													</thead>
													<tbody>
														for _, cfg := range group.Configs {
															<tr>
																<td class="text-sm font-mono text-base-content">{ fmt.Sprintf("%d", cfg.BackupConfigId) }</td>
																<td class="text-sm text-base-content">{ fmt.Sprintf("%d min", cfg.CadenceMinutes) }</td>
																<td class="text-sm font-mono text-base-content">{ cfg.BackupPath }</td>
																<td class="text-sm">
																	if cfg.Enabled {
																		@htmxui.Badge("Enabled", htmxui.BadgeSuccess, htmxui.BadgeSizeSM, true, nil)
																	} else {
																		@htmxui.Badge("Disabled", htmxui.BadgeNeutral, htmxui.BadgeSizeSM, true, nil)
																	}
																</td>
																<td class="text-right">
																	<form method="POST" action={ templ.URL(fmt.Sprintf("/backup-configs/%d/delete", cfg.BackupConfigId)) } class="inline">
																		<button type="submit" onclick="return confirm('Delete this backup config?')" class="btn btn-error btn-xs">Delete</button>
																	</form>
																</td>
															</tr>
														}
													</tbody>
												</table>
											</div>
										} else {
											<p class="text-sm text-base-content/60 mb-4">No backup configs for this volume.</p>
										}
										<form method="POST" action="/backup-configs/create" class="flex flex-wrap gap-2 items-end">
											<input type="hidden" name="volume_id" value={ fmt.Sprintf("%d", group.Volume.VolumeId) }/>
											<div>
												<label class="block text-xs font-medium text-base-content mb-1">Path</label>
												<input type="text" name="backup_path" value="." placeholder="." class="input input-bordered input-sm w-32"/>
											</div>
											<div>
												<label class="block text-xs font-medium text-base-content mb-1">Cadence (min)</label>
												<input type="number" name="cadence_minutes" value="1440" min="1" class="input input-bordered input-sm w-24"/>
											</div>
											<div>
												<label class="block text-xs font-medium text-base-content mb-1">Enabled</label>
												<select name="enabled" class="select select-bordered select-sm w-20">
													<option value="true">Yes</option>
													<option value="false">No</option>
												</select>
											</div>
											<button type="submit" class="btn btn-primary btn-sm">Add</button>
										</form>
									</div>
								</div>
							}
						} else {
							<p class="text-sm text-base-content/60">No volumes configured. Add volumes first to enable backups.</p>
						}
					</div>
				</div>
			</div>
		</div>
	}
}
