package pages

import (
	"fmt"

	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

templ Games(layout components.LayoutData, games []*manmanpb.Game) {
	@components.Layout(layout) {
		@components.HeroHeader("Games", "Manage game configurations and deployments") {
			<a href="/games/new" class="btn bg-base-100 text-primary hover:bg-base-200 border-none shadow-md">
				+ Create New Game
			</a>
		}
		if len(games) > 0 {
			@components.Table() {
				<thead>
					<tr>
						<th>Name</th>
						<th>Steam App ID</th>
						<th>Genre</th>
						<th>Publisher</th>
						<th>Tags</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, game := range games {
						<tr class="hover">
							<td>
								<a href={ templ.URL(fmt.Sprintf("/games/%d", game.GameId)) } class="link link-primary text-sm font-medium">
									{ game.Name }
								</a>
							</td>
							<td class="text-sm">{ game.SteamAppId }</td>
							<td class="text-sm">
								if game.Metadata != nil {
									{ game.Metadata.Genre }
								}
							</td>
							<td class="text-sm">
								if game.Metadata != nil {
									{ game.Metadata.Publisher }
								}
							</td>
							<td>
								<div class="flex flex-wrap gap-1">
									if game.Metadata != nil {
										for _, tag := range game.Metadata.Tags {
											<span class="badge badge-neutral badge-soft badge-sm">
												{ tag }
											</span>
										}
									}
								</div>
							</td>
							<td class="text-right text-sm font-medium">
								<a href={ templ.URL(fmt.Sprintf("/games/%d", game.GameId)) } class="btn btn-primary btn-sm">View</a>
							</td>
						</tr>
					}
				</tbody>
			}
		} else {
			@components.EmptyState("No games found", "Get started by creating your first game!", "Create Game", "/games/new")
		}
	}
}
