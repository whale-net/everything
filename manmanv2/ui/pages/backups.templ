package pages

import (
	"fmt"
	"net/url"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

// BackupsPageData drives the fleet-wide /backups surface (root plan #2777,
// task #2812 -- FR1, FR3, FR4). This page owns the shell (nav entry, tab
// strip, gRPC client wrappers) so #2813/#2814/#2815/#2816 can each add one
// capability without re-litigating layout -- see this file's package
// doc comment on BackupRunsFragmentData for the "Backup runs" tab this
// task fills in; "Backup configs" (backupConfigsPlaceholder below) is
// filled in by #2816.
type BackupsPageData struct {
	Layout components.LayoutData
	Runs   BackupRunsFragmentData
	// FilterOptions backs the filter bar's name-based pickers (SGC, volume,
	// BackupConfig) -- resolved once per full "/backups" page render, not
	// per "/backups/runs" fragment swap, since the filter bar itself lives
	// outside "#backup-runs-panel" and is never re-rendered by a swap.
	FilterOptions BackupRunsFilterOptions
}

// BackupRunsFilterOptions holds the fleet-wide name-based picker options
// for the filter bar's SGC (deployment), volume and BackupConfig fields
// (handlers_backups_fleet.go's backupRunsFilterOptions) -- each entry's
// Value is the underlying int64 ID as a string, Label the display name a
// Server Manager recognizes, matching components.SelectOption's shape.
type BackupRunsFilterOptions struct {
	ServerGameConfigs []components.SelectOption
	Volumes           []components.SelectOption
	BackupConfigs     []components.SelectOption
}

// BackupRunsFragmentData backs both the initial "/backups" page render and
// every subsequent "/backups/runs" htmx fragment swap (filter submit or
// "Load more") -- handlers_backups_fleet.go builds one of these from
// ControlClient.ListBackups's response for either route, so the table and
// pagination control render identically regardless of which route
// produced them.
type BackupRunsFragmentData struct {
	// Items is BackupListItem, not the bare Backup slice -- each row's
	// deployment/volume display names come from here, no per-row lookup
	// (#2809).
	Items         []*manmanpb.BackupListItem
	NextPageToken string
	Filter        BackupRunsFilterValues
	// Err, when non-empty, renders an inline alert in place of the table
	// (and suppresses the "Load more" control) instead of a bare 500 --
	// the ListBackups call itself failed, not "zero rows matched".
	Err string
	// DeleteNotice, when non-empty, renders an inline alert above the table
	// after a delete attempt (handleBackupRunDelete, task #2815 -- FR7,
	// FR8) -- unlike Err, it never suppresses the table: the list call
	// itself succeeded, this just reports what the delete attempt on one
	// row did (or, for a FailedPrecondition/NotFound response, didn't do).
	// DeleteNoticeVariant is components.Alert's alertType ("warning" for an
	// expected precondition, "error" for an unexpected failure).
	DeleteNotice        string
	DeleteNoticeVariant string
}

// BackupRunsFilterValues holds the filter bar's current values as strings
// (empty string means unset, matching each <input>/<select>'s own empty
// state) so the fragment can redisplay what a Server Manager just
// submitted and so nextPageQuery can carry the same filters into a
// "Load more" request.
type BackupRunsFilterValues struct {
	ServerGameConfigID string
	VolumeID           string
	BackupConfigID     string
	Status             string
}

// backupRunStatuses is the fixed status filter option set (FR4), matching
// ListBackupsRequest.status's documented values
// (api_messages_backup.proto: "pending|running|completed|failed").
var backupRunStatuses = []string{"pending", "running", "completed", "failed"}

// BackupsPage is the fleet-wide backup management surface (FR1), registered
// at "/backups" (handlers_backups_fleet.go). Two tabs from the start,
// switched client-side (no navigation, matching game_detail.templ's
// activeTab pattern): "Backup runs" (this task, FR3/FR4) and "Backup
// configs" (placeholder, filled by #2816) -- both tabs' content is already
// rendered on page load, so switching costs no request.
templ BackupsPage(data BackupsPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		@backupTriggerBladeOpenerScript()
		@components.HeroHeader("Backups", "Fleet-wide backup runs and schedules -- every deployment, no per-deployment page required") {
		}
		<div x-data="{ activeTab: 'runs' }">
			<div role="tablist" class="tabs tabs-bordered mb-6" data-backups-tabs>
				<button
					type="button"
					role="tab"
					id="tab-btn-backup-runs"
					class="tab tab-lg"
					:class="{ 'tab-active font-semibold': activeTab === 'runs' }"
					@click="activeTab = 'runs'"
				>
					Backup runs
				</button>
				<button
					type="button"
					role="tab"
					id="tab-btn-backup-configs"
					class="tab tab-lg"
					:class="{ 'tab-active font-semibold': activeTab === 'configs' }"
					@click="activeTab = 'configs'"
				>
					Backup configs
				</button>
			</div>
			<div id="tab-panel-backup-runs" x-show="activeTab === 'runs'">
				<div class="flex justify-end mb-4">
					<button type="button" data-open-blade-template="backup-trigger-blade-template" class="btn btn-primary btn-sm">
						+ Trigger backup
					</button>
				</div>
				@backupRunsFilterBar(data.Runs.Filter, data.FilterOptions)
				<div id="backup-runs-panel">
					@BackupRunsFragment(data.Runs)
				</div>
			</div>
			<div id="tab-panel-backup-configs" x-show="activeTab === 'configs'" x-cloak>
				@backupConfigsPlaceholder()
			</div>
		</div>
		<!-- Trigger-backup Blade (task #2813, FR5). See BackupTriggerFormPlaceholder's doc comment for why its body is a lazy hx-get rather than pre-rendered data. -->
		<template id="backup-trigger-blade-template">
			@components.Blade(components.BladeData{
				ID:       "backup-trigger-blade",
				Title:    "Trigger backup",
				Subtitle: "Start a backup run for any deployment and BackupConfig pair (FR5)",
			}) {
				@BackupTriggerFormPlaceholder()
			}
		</template>
	}
}

// backupTriggerBladeOpenerScript is games.templ's data-open-blade-template
// click delegate, duplicated here rather than shared -- see
// workshopBladeOpenerScript's doc comment (workshop.templ) for why each page
// using this pattern owns its own copy today.
script backupTriggerBladeOpenerScript() {
	document.addEventListener('click', function(event) {
		var trigger = event.target.closest('[data-open-blade-template]');
		if (!trigger) return;
		var tpl = document.getElementById(trigger.getAttribute('data-open-blade-template'));
		if (!tpl) return;
		var fragment = tpl.content.cloneNode(true);
		var bladeRoot = fragment.querySelector('[data-blade]');
		document.body.appendChild(fragment);
		if (bladeRoot && window.htmx) {
			window.htmx.process(bladeRoot);
		}
	});
}

// backupRunsFilterBar is the FR4 filter bar: SGC (deployment), volume and
// BackupConfig each render as a name-based <select> (backupRunsSelect)
// rather than a raw ID input -- Scaffold shipped these as plain number
// inputs and left resolving them to name-based pickers as this
// Implementation phase's job; options come from
// handlers_backups_fleet.go's backupRunsFilterOptions. Status stays a
// fixed select (FR4), its option set never varying with fleet data.
// Submits via htmx GET to "/backups/runs", swapping "#backup-runs-panel"
// in place; hx-push-url keeps the current filters in the address bar so a
// filtered view is linkable (NFR4's pagination sibling requirement).
templ backupRunsFilterBar(filter BackupRunsFilterValues, options BackupRunsFilterOptions) {
	<form
		hx-get="/backups/runs"
		hx-target="#backup-runs-panel"
		hx-swap="innerHTML"
		hx-push-url="true"
		class="flex flex-wrap gap-4 items-end mb-4 bg-base-100 border border-base-300 rounded-box p-4"
	>
		@backupRunsSelect("backup-runs-filter-sgc", "server_game_config_id", "Deployment", "All deployments", filter.ServerGameConfigID, options.ServerGameConfigs)
		@backupRunsSelect("backup-runs-filter-volume", "volume_id", "Volume", "All volumes", filter.VolumeID, options.Volumes)
		@backupRunsSelect("backup-runs-filter-config", "backup_config_id", "Backup Config", "All backup configs", filter.BackupConfigID, options.BackupConfigs)
		<div>
			<label class="block text-sm font-medium text-base-content mb-1" for="backup-runs-filter-status">Status</label>
			<select id="backup-runs-filter-status" name="status" class="select select-bordered select-sm w-40">
				<option value="" selected?={ filter.Status == "" }>All</option>
				for _, status := range backupRunStatuses {
					<option value={ status } selected?={ filter.Status == status }>{ status }</option>
				}
			</select>
		</div>
		<button type="submit" class="btn btn-primary btn-sm">Filter</button>
	</form>
}

// backupRunsSelect renders one name-based filter picker: an "all" option
// (value "", matching BackupRunsFilterValues' unset convention) plus one
// option per fleet-wide entity, selected against the filter's current
// string ID. Shared by the SGC, volume and BackupConfig pickers so the
// three can't drift on markup or the unset-value convention.
templ backupRunsSelect(id, name, label, allLabel, selected string, opts []components.SelectOption) {
	<div>
		<label class="block text-sm font-medium text-base-content mb-1" for={ id }>{ label }</label>
		<select id={ id } name={ name } class="select select-bordered select-sm w-56">
			<option value="" selected?={ selected == "" }>{ allLabel }</option>
			for _, opt := range opts {
				<option value={ opt.Value } selected?={ selected == opt.Value }>{ opt.Label }</option>
			}
		</select>
	</div>
}

// BackupRunsFragment renders the backup-run table plus its "Load more"
// pagination control (NFR4) -- exported because handlers_backups_fleet.go
// renders it directly for "/backups/runs" htmx requests, in addition to
// BackupsPage using it for the initial unfiltered render.
templ BackupRunsFragment(data BackupRunsFragmentData) {
	if data.Err != "" {
		@components.Alert("error", data.Err)
	} else if len(data.Items) == 0 {
		if data.DeleteNotice != "" {
			@components.Alert(data.DeleteNoticeVariant, data.DeleteNotice)
		}
		@components.EmptyState("No backup runs", "No backup runs match the current filters.", "", "")
	} else {
		if data.DeleteNotice != "" {
			@components.Alert(data.DeleteNoticeVariant, data.DeleteNotice)
		}
		<div class="bg-base-100 rounded-box border border-base-300 overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>Deployment</th>
						<th>Volume</th>
						<th>Status</th>
						<th>Created</th>
						<th>Size</th>
						<th>Origin</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, item := range data.Items {
						@backupRunRow(item)
					}
				</tbody>
			</table>
		</div>
		if data.NextPageToken != "" {
			<div class="flex justify-center mt-4">
				<button
					type="button"
					class="btn btn-sm"
					hx-get={ fmt.Sprintf("/backups/runs?%s", nextPageQuery(data.Filter, data.NextPageToken)) }
					hx-target="#backup-runs-panel"
					hx-swap="innerHTML"
				>
					Load more
				</button>
			</div>
		}
	}
}

// backupRunRow is one BackupListItem's row (FR3): deployment/volume names
// come from the item's own display-context fields (#2809), not a per-row
// lookup. Each row links to "/backups/runs/{backup_id}" (task #2814, FR6)
// so a Server Manager can drill into a single run -- e.g. a failed one --
// without a database query. The trailing delete button (FR7, FR8, task
// #2815) posts to handleBackupRunDelete, which always re-renders this same
// fragment: a successful delete drops the row, a FailedPrecondition/
// NotFound response leaves it in place with an inline notice above the
// table.
templ backupRunRow(item *manmanpb.BackupListItem) {
	<tr>
		<td>
			<a href={ templ.URL(fmt.Sprintf("/backups/runs/%d", item.Backup.BackupId)) } class="link link-primary">{ item.ServerGameConfigName }</a>
		</td>
		<td>{ item.VolumeName }</td>
		<td>
			@htmxui.Badge(item.Backup.Status, statusBadgeVariant(item.Backup.Status), htmxui.BadgeSizeSM, true, nil)
		</td>
		<td>{ timeAgo(item.Backup.CreatedAt) }</td>
		<td>{ backupRunSize(item.Backup) }</td>
		<td>{ backupRunOrigin(item.Backup) }</td>
		<td class="text-right">
			<button
				type="button"
				class="btn btn-error btn-xs"
				hx-post={ fmt.Sprintf("/backups/runs/%d/delete", item.Backup.BackupId) }
				hx-confirm="Delete this backup run? This also removes its stored archive."
				hx-target="#backup-runs-panel"
				hx-swap="innerHTML"
			>
				Delete
			</button>
		</td>
	</tr>
}

// backupTriggerFormID is the one stable container id the Blade's lazy-load
// placeholder, every "/backups/trigger-form" response (initial load and the
// BackupConfig picker's own onchange re-fetch), and every "/backups/trigger"
// submit response share -- each response replaces this same element
// (hx-swap="outerHTML"), matching DeploymentSettingsEnvSectionID's
// placeholder/section id-sharing convention (deployment_settings.templ).
const backupTriggerFormID = "backup-trigger-form"

// BackupTriggerFormPlaceholder is the Blade body BackupsPage embeds inside
// the "Trigger backup" button's cloned <template> (task #2813, FR5):
// cloning that template costs no request (BackupsPage's own
// data-open-blade-template click handler only ever does a DOM clone), but
// the fleet-wide BackupConfig list this picker needs is fetched fresh every
// time the blade opens via this placeholder's own hx-get, so an operator
// never sees a BackupConfig created elsewhere go missing from a stale page
// load.
templ BackupTriggerFormPlaceholder() {
	<div
		id={ backupTriggerFormID }
		hx-get="/backups/trigger-form"
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<p class="text-sm text-base-content/60">Loading backup configs…</p>
	</div>
}

// BackupTriggerFormData drives the trigger picker/submit form
// (handlers_backups_fleet.go's handleBackupTriggerForm/handleBackupTrigger):
// BackupConfigs is always the full fleet-wide list (#2810's
// ListBackupConfigItems); ServerGameConfigs is scoped to whichever
// BackupConfig is currently selected -- empty until one is chosen, or after
// choosing one with no eligible deployment.
type BackupTriggerFormData struct {
	BackupConfigs          []components.SelectOption
	SelectedBackupConfigID string
	ServerGameConfigs      []components.SelectOption
	// SuccessBackupID, when > 0, renders a "queued" confirmation for the
	// most recently submitted trigger (the id TriggerBackup returned).
	SuccessBackupID int64
	// Err, when non-empty, renders the resubmitted form with an inline
	// error instead of a bare 500 -- FailedPrecondition's "no running
	// session" is the common case and must read as actionable
	// (backupTriggerErrorMessage in handlers_backups_fleet.go), not raw
	// gRPC status text.
	Err string
}

// BackupTriggerForm renders both the picker (GET "/backups/trigger-form",
// with or without a chosen BackupConfig) and the post-submit outcome (POST
// "/backups/trigger") -- one templ so the two can never render
// inconsistent markup for the same data. Selecting a BackupConfig re-fetches
// this whole fragment via the select's own hx-get (with backup_config_id in
// its request, htmx's default "include the closest form's values"
// behavior) so ServerGameConfigs reflects the newly chosen config's
// eligible deployments; submitting POSTs the same two fields.
templ BackupTriggerForm(data BackupTriggerFormData) {
	<form
		id={ backupTriggerFormID }
		hx-post="/backups/trigger"
		hx-target={ "#" + backupTriggerFormID }
		hx-swap="outerHTML"
		class="space-y-4"
	>
		if data.SuccessBackupID > 0 {
			<div class="alert alert-success mb-4">
				<span class="text-sm">Backup #{ fmt.Sprintf("%d", data.SuccessBackupID) } queued.</span>
			</div>
		}
		if data.Err != "" {
			@components.Alert("error", data.Err)
		}
		<div>
			<label class="block text-sm font-medium text-base-content mb-1" for="backup-trigger-config">Backup Config *</label>
			<select
				id="backup-trigger-config"
				name="backup_config_id"
				required
				hx-get="/backups/trigger-form"
				hx-trigger="change"
				hx-target={ "#" + backupTriggerFormID }
				hx-swap="outerHTML"
				class="select select-bordered w-full"
			>
				<option value="">-- select a backup config --</option>
				for _, opt := range data.BackupConfigs {
					<option value={ opt.Value } selected?={ data.SelectedBackupConfigID == opt.Value }>{ opt.Label }</option>
				}
			</select>
		</div>
		<div>
			<label class="block text-sm font-medium text-base-content mb-1" for="backup-trigger-sgc">Deployment *</label>
			if data.SelectedBackupConfigID == "" {
				<select id="backup-trigger-sgc" name="server_game_config_id" required disabled class="select select-bordered w-full">
					<option value="">-- select a backup config first --</option>
				</select>
			} else if len(data.ServerGameConfigs) == 0 {
				<select id="backup-trigger-sgc" name="server_game_config_id" required disabled class="select select-bordered w-full">
					<option value="">No deployments use this backup config's game config</option>
				</select>
			} else {
				<select id="backup-trigger-sgc" name="server_game_config_id" required class="select select-bordered w-full">
					<option value="">-- select a deployment --</option>
					for _, opt := range data.ServerGameConfigs {
						<option value={ opt.Value }>{ opt.Label }</option>
					}
				</select>
			}
		</div>
		<button type="submit" class="btn btn-primary" disabled?={ data.SelectedBackupConfigID == "" || len(data.ServerGameConfigs) == 0 }>
			Trigger backup
		</button>
	</form>
}

// BackupRunsPanelOOB re-renders "/backups"' fleet-wide run list
// out-of-band, targeting BackupRunsFragment's own "#backup-runs-panel"
// wrapper (BackupsPage) wherever it exists in the document. A successful
// "/backups/trigger" submit includes this alongside BackupTriggerForm's own
// primary (in-Blade) response so the new "pending" row appears on the
// underlying page without ever re-fetching or otherwise disturbing it
// (Blade's own FR10 "opening/closing never re-renders the surface
// underneath" contract, extended here to "neither does submitting inside
// it" -- this is the one deliberate, explicit exception, and it only ever
// touches the run list panel, nothing else on the page). This always
// renders the unfiltered first page rather than trying to recreate
// whatever filter the operator had applied before opening the Blade (the
// Blade's own form carries no record of the filter bar's state) -- FR5's
// acceptance criterion is "the new run appears in the fleet list", which an
// active status/deployment/volume filter could exclude the new row from
// regardless.
templ BackupRunsPanelOOB(data BackupRunsFragmentData) {
	<div id="backup-runs-panel" hx-swap-oob="true">
		@BackupRunsFragment(data)
	</div>
}

// backupConfigsPlaceholder is the "Backup configs" tab's scaffold content
// (#2816 fills this in with the fleet-wide BackupConfig list, #2822).
templ backupConfigsPlaceholder() {
	<div class="bg-base-100 rounded-box border border-base-300 p-12 text-center">
		<p class="text-base-content/60">Backup configs land here in a follow-up task.</p>
	</div>
}

// backupRunSize renders Backup.SizeBytes only once the run has completed
// (FR3: "size once completed") -- pending/running/failed rows show a dash
// rather than a stale or zero size, matching cacheEntrySize's
// (workshop_cache.templ) "%.1f MB" convention for a byte count elsewhere
// in this UI.
func backupRunSize(backup *manmanpb.Backup) string {
	if backup.Status != "completed" || backup.SizeBytes <= 0 {
		return "-"
	}
	return fmt.Sprintf("%.1f MB", float64(backup.SizeBytes)/1048576)
}

// backupRunOrigin renders Backup.TriggerSource verbatim (FR2/FR3's core
// rule): the API already normalizes this to exactly "scheduled", "manual",
// or "unknown" for historical rows with no recorded origin -- this must
// never guess or default an "unknown" (or empty, pre-#2809 data) row to
// "manual"/"scheduled".
func backupRunOrigin(backup *manmanpb.Backup) string {
	if backup.TriggerSource == "" {
		return "unknown"
	}
	return backup.TriggerSource
}

// nextPageQuery carries the current filter values plus the next page token
// into "Load more"'s hx-get target, so paging never drops an active filter
// (NFR4's server-side-pagination requirement implies paging composes with
// filtering, not resets it).
func nextPageQuery(filter BackupRunsFilterValues, pageToken string) string {
	v := url.Values{}
	if filter.ServerGameConfigID != "" {
		v.Set("server_game_config_id", filter.ServerGameConfigID)
	}
	if filter.VolumeID != "" {
		v.Set("volume_id", filter.VolumeID)
	}
	if filter.BackupConfigID != "" {
		v.Set("backup_config_id", filter.BackupConfigID)
	}
	if filter.Status != "" {
		v.Set("status", filter.Status)
	}
	v.Set("page_token", pageToken)
	return v.Encode()
}
