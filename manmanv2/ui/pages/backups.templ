package pages

import (
	"encoding/json"
	"fmt"
	"net/url"
	"strconv"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

// BackupsPageData drives the fleet-wide /backups surface (root plan #2777,
// task #2812 -- FR1, FR3, FR4). This page owns the shell (nav entry, tab
// strip, gRPC client wrappers) so #2813/#2814/#2815/#2816 can each add one
// capability without re-litigating layout -- see this file's doc comment on
// BackupRunsFragmentData for the "Backup runs" tab #2812 fills in, and on
// BackupConfigsFragmentData for the "Backup configs" tab #2816 fills in.
type BackupsPageData struct {
	Layout components.LayoutData
	Runs   BackupRunsFragmentData
	// FilterOptions backs the filter bar's name-based pickers (SGC, volume,
	// BackupConfig) -- resolved once per full "/backups" page render, not
	// per "/backups/runs" fragment swap, since the filter bar itself lives
	// outside "#backup-runs-panel" and is never re-rendered by a swap.
	FilterOptions BackupRunsFilterOptions
	// Configs backs the "Backup configs" tab's initial (unfiltered,
	// first-page) render -- handlers_backups_fleet.go builds this the same
	// way it builds Runs, from a ListBackupConfigsFleet call, so the
	// initial page load and every subsequent "/backups/configs" htmx
	// fragment swap render identically.
	Configs BackupConfigsFragmentData
	// ConfigFilterOptions backs the "Backup configs" tab's filter bar
	// name-based pickers (Volume, GameConfig), mirroring FilterOptions --
	// resolved once per full "/backups" page render since that filter bar
	// also lives outside "#backup-configs-panel".
	ConfigFilterOptions BackupConfigsFilterOptions
}

// BackupConfigsFilterOptions holds the fleet-wide name-based picker options
// for the "Backup configs" tab's filter bar (handlers_backups_fleet.go's
// backupConfigsFilterOptions), mirroring BackupRunsFilterOptions' shape.
type BackupConfigsFilterOptions struct {
	Volumes     []components.SelectOption
	GameConfigs []components.SelectOption
}

// BackupRunsFilterOptions holds the fleet-wide name-based picker options
// for the filter bar's SGC (deployment), volume and BackupConfig fields
// (handlers_backups_fleet.go's backupRunsFilterOptions) -- each entry's
// Value is the underlying int64 ID as a string, Label the display name a
// Server Manager recognizes, matching components.SelectOption's shape.
type BackupRunsFilterOptions struct {
	ServerGameConfigs []components.SelectOption
	Volumes           []components.SelectOption
	BackupConfigs     []components.SelectOption
}

// BackupRunsFragmentData backs both the initial "/backups" page render and
// every subsequent "/backups/runs" htmx fragment swap (filter submit or
// "Load more") -- handlers_backups_fleet.go builds one of these from
// ControlClient.ListBackups's response for either route, so the table and
// pagination control render identically regardless of which route
// produced them.
type BackupRunsFragmentData struct {
	// Items is BackupListItem, not the bare Backup slice -- each row's
	// deployment/volume display names come from here, no per-row lookup
	// (#2809).
	Items         []*manmanpb.BackupListItem
	NextPageToken string
	Filter        BackupRunsFilterValues
	// Err, when non-empty, renders an inline alert in place of the table
	// (and suppresses the "Load more" control) instead of a bare 500 --
	// the ListBackups call itself failed, not "zero rows matched".
	Err string
	// DeleteNotice, when non-empty, renders an inline alert above the table
	// after a delete attempt (handleBackupRunDelete, task #2815 -- FR7,
	// FR8) -- unlike Err, it never suppresses the table: the list call
	// itself succeeded, this just reports what the delete attempt on one
	// row did (or, for a FailedPrecondition/NotFound response, didn't do).
	// DeleteNoticeVariant is components.Alert's alertType ("warning" for an
	// expected precondition, "error" for an unexpected failure).
	DeleteNotice        string
	DeleteNoticeVariant string
}

// BackupRunsFilterValues holds the filter bar's current values as strings
// (empty string means unset, matching each <input>/<select>'s own empty
// state) so the fragment can redisplay what a Server Manager just
// submitted and so nextPageQuery can carry the same filters into a
// "Load more" request.
type BackupRunsFilterValues struct {
	ServerGameConfigID string
	VolumeID           string
	BackupConfigID     string
	Status             string
}

// backupRunStatuses is the fixed status filter option set (FR4), matching
// ListBackupsRequest.status's documented values
// (api_messages_backup.proto: "pending|running|completed|failed").
var backupRunStatuses = []string{"pending", "running", "completed", "failed"}

// BackupsPage is the fleet-wide backup management surface (FR1), registered
// at "/backups" (handlers_backups_fleet.go). Two tabs from the start,
// switched client-side (no navigation, matching game_detail.templ's
// activeTab pattern): "Backup runs" (#2812, FR3/FR4) and "Backup configs"
// (#2816, FR9-FR11) -- both tabs' content is already rendered on page load,
// so switching costs no request.
templ BackupsPage(data BackupsPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		@backupTriggerBladeOpenerScript()
		@components.HeroHeader("Backups", "Fleet-wide backup runs and schedules -- every deployment, no per-deployment page required") {
		}
		<div x-data="{ activeTab: 'runs' }">
			<div role="tablist" class="tabs tabs-bordered mb-6" data-backups-tabs>
				<button
					type="button"
					role="tab"
					id="tab-btn-backup-runs"
					class="tab tab-lg"
					:class="{ 'tab-active font-semibold': activeTab === 'runs' }"
					@click="activeTab = 'runs'"
				>
					Backup runs
				</button>
				<button
					type="button"
					role="tab"
					id="tab-btn-backup-configs"
					class="tab tab-lg"
					:class="{ 'tab-active font-semibold': activeTab === 'configs' }"
					@click="activeTab = 'configs'"
				>
					Backup configs
				</button>
			</div>
			<div id="tab-panel-backup-runs" x-show="activeTab === 'runs'">
				<div class="flex justify-end mb-4">
					<button type="button" data-open-blade-template="backup-trigger-blade-template" class="btn btn-primary btn-sm">
						+ Trigger backup
					</button>
				</div>
				@backupRunsFilterBar(data.Runs.Filter, data.FilterOptions)
				<div id="backup-runs-panel">
					@BackupRunsFragment(data.Runs)
				</div>
			</div>
			<div id="tab-panel-backup-configs" x-show="activeTab === 'configs'" x-cloak>
				@backupConfigsFilterBar(data.Configs.Filter, data.ConfigFilterOptions)
				<div id="backup-configs-panel">
					@BackupConfigsFragment(data.Configs)
				</div>
			</div>
		</div>
		<!-- Trigger-backup Blade (task #2813, FR5). See BackupTriggerFormPlaceholder's doc comment for why its body is a lazy hx-get rather than pre-rendered data. -->
		<template id="backup-trigger-blade-template">
			@components.Blade(components.BladeData{
				ID:       "backup-trigger-blade",
				Title:    "Trigger backup",
				Subtitle: "Start a backup run for any deployment and BackupConfig pair (FR5)",
			}) {
				@BackupTriggerFormPlaceholder()
			}
		</template>
	}
}

// backupTriggerBladeOpenerScript is games.templ's data-open-blade-template
// click delegate, duplicated here rather than shared -- see
// workshopBladeOpenerScript's doc comment (workshop.templ) for why each page
// using this pattern owns its own copy today.
script backupTriggerBladeOpenerScript() {
	document.addEventListener('click', function(event) {
		var trigger = event.target.closest('[data-open-blade-template]');
		if (!trigger) return;
		var tpl = document.getElementById(trigger.getAttribute('data-open-blade-template'));
		if (!tpl) return;
		var fragment = tpl.content.cloneNode(true);
		var bladeRoot = fragment.querySelector('[data-blade]');
		document.body.appendChild(fragment);
		if (bladeRoot && window.htmx) {
			window.htmx.process(bladeRoot);
		}
	});
}

// backupRunsFilterBar is the FR4 filter bar: SGC (deployment), volume and
// BackupConfig each render as a name-based <select> (backupRunsSelect)
// rather than a raw ID input -- Scaffold shipped these as plain number
// inputs and left resolving them to name-based pickers as this
// Implementation phase's job; options come from
// handlers_backups_fleet.go's backupRunsFilterOptions. Status stays a
// fixed select (FR4), its option set never varying with fleet data.
// Submits via htmx GET to "/backups/runs", swapping "#backup-runs-panel"
// in place; hx-push-url keeps the current filters in the address bar so a
// filtered view is linkable (NFR4's pagination sibling requirement).
templ backupRunsFilterBar(filter BackupRunsFilterValues, options BackupRunsFilterOptions) {
	<form
		hx-get="/backups/runs"
		hx-target="#backup-runs-panel"
		hx-swap="innerHTML"
		hx-push-url="true"
		class="flex flex-wrap gap-4 items-end mb-4 bg-base-100 border border-base-300 rounded-box p-4"
	>
		@backupRunsSelect("backup-runs-filter-sgc", "server_game_config_id", "Deployment", "All deployments", filter.ServerGameConfigID, options.ServerGameConfigs)
		@backupRunsSelect("backup-runs-filter-volume", "volume_id", "Volume", "All volumes", filter.VolumeID, options.Volumes)
		@backupRunsSelect("backup-runs-filter-config", "backup_config_id", "Backup Config", "All backup configs", filter.BackupConfigID, options.BackupConfigs)
		<div>
			<label class="block text-sm font-medium text-base-content mb-1" for="backup-runs-filter-status">Status</label>
			<select id="backup-runs-filter-status" name="status" class="select select-bordered select-sm w-40">
				<option value="" selected?={ filter.Status == "" }>All</option>
				for _, status := range backupRunStatuses {
					<option value={ status } selected?={ filter.Status == status }>{ status }</option>
				}
			</select>
		</div>
		<button type="submit" class="btn btn-primary btn-sm">Filter</button>
	</form>
}

// backupRunsSelect renders one name-based filter picker: an "all" option
// (value "", matching BackupRunsFilterValues' unset convention) plus one
// option per fleet-wide entity, selected against the filter's current
// string ID. Shared by the SGC, volume and BackupConfig pickers so the
// three can't drift on markup or the unset-value convention.
templ backupRunsSelect(id, name, label, allLabel, selected string, opts []components.SelectOption) {
	<div>
		<label class="block text-sm font-medium text-base-content mb-1" for={ id }>{ label }</label>
		<select id={ id } name={ name } class="select select-bordered select-sm w-56">
			<option value="" selected?={ selected == "" }>{ allLabel }</option>
			for _, opt := range opts {
				<option value={ opt.Value } selected?={ selected == opt.Value }>{ opt.Label }</option>
			}
		</select>
	</div>
}

// BackupRunsFragment renders the backup-run table plus its "Load more"
// pagination control (NFR4) -- exported because handlers_backups_fleet.go
// renders it directly for "/backups/runs" htmx requests, in addition to
// BackupsPage using it for the initial unfiltered render.
templ BackupRunsFragment(data BackupRunsFragmentData) {
	if data.Err != "" {
		@components.Alert("error", data.Err)
	} else if len(data.Items) == 0 {
		if data.DeleteNotice != "" {
			@components.Alert(data.DeleteNoticeVariant, data.DeleteNotice)
		}
		@components.EmptyState("No backup runs", "No backup runs match the current filters.", "", "")
	} else {
		if data.DeleteNotice != "" {
			@components.Alert(data.DeleteNoticeVariant, data.DeleteNotice)
		}
		<div class="bg-base-100 rounded-box border border-base-300 overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>Deployment</th>
						<th>Volume</th>
						<th>Status</th>
						<th>Created</th>
						<th>Size</th>
						<th>Origin</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, item := range data.Items {
						@backupRunRow(item)
					}
				</tbody>
			</table>
		</div>
		if data.NextPageToken != "" {
			<div class="flex justify-center mt-4">
				<button
					type="button"
					class="btn btn-sm"
					hx-get={ fmt.Sprintf("/backups/runs?%s", nextPageQuery(data.Filter, data.NextPageToken)) }
					hx-target="#backup-runs-panel"
					hx-swap="innerHTML"
				>
					Load more
				</button>
			</div>
		}
	}
}

// backupRunRow is one BackupListItem's row (FR3): deployment/volume names
// come from the item's own display-context fields (#2809), not a per-row
// lookup. Each row links to "/backups/runs/{backup_id}" (task #2814, FR6)
// so a Server Manager can drill into a single run -- e.g. a failed one --
// without a database query. The trailing delete button (FR7, FR8, task
// #2815) posts to handleBackupRunDelete, which always re-renders this same
// fragment: a successful delete drops the row, a FailedPrecondition/
// NotFound response leaves it in place with an inline notice above the
// table.
templ backupRunRow(item *manmanpb.BackupListItem) {
	<tr>
		<td>
			<a href={ templ.URL(fmt.Sprintf("/backups/runs/%d", item.Backup.BackupId)) } class="link link-primary">{ item.ServerGameConfigName }</a>
		</td>
		<td>{ item.VolumeName }</td>
		<td>
			@htmxui.Badge(item.Backup.Status, statusBadgeVariant(item.Backup.Status), htmxui.BadgeSizeSM, true, nil)
		</td>
		<td>{ timeAgo(item.Backup.CreatedAt) }</td>
		<td>{ backupRunSize(item.Backup) }</td>
		<td>{ backupRunOrigin(item.Backup) }</td>
		<td class="text-right">
			<button
				type="button"
				class="btn btn-error btn-xs"
				hx-post={ fmt.Sprintf("/backups/runs/%d/delete", item.Backup.BackupId) }
				hx-confirm="Delete this backup run? This also removes its stored archive."
				hx-target="#backup-runs-panel"
				hx-swap="innerHTML"
			>
				Delete
			</button>
		</td>
	</tr>
}

// backupTriggerFormID is the one stable container id the Blade's lazy-load
// placeholder, every "/backups/trigger-form" response (initial load and the
// BackupConfig picker's own onchange re-fetch), and every "/backups/trigger"
// submit response share -- each response replaces this same element
// (hx-swap="outerHTML"), matching DeploymentSettingsEnvSectionID's
// placeholder/section id-sharing convention (deployment_settings.templ).
const backupTriggerFormID = "backup-trigger-form"

// BackupTriggerFormPlaceholder is the Blade body BackupsPage embeds inside
// the "Trigger backup" button's cloned <template> (task #2813, FR5):
// cloning that template costs no request (BackupsPage's own
// data-open-blade-template click handler only ever does a DOM clone), but
// the fleet-wide BackupConfig list this picker needs is fetched fresh every
// time the blade opens via this placeholder's own hx-get, so an operator
// never sees a BackupConfig created elsewhere go missing from a stale page
// load.
templ BackupTriggerFormPlaceholder() {
	<div
		id={ backupTriggerFormID }
		hx-get="/backups/trigger-form"
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<p class="text-sm text-base-content/60">Loading backup configs…</p>
	</div>
}

// BackupTriggerFormData drives the trigger picker/submit form
// (handlers_backups_fleet.go's handleBackupTriggerForm/handleBackupTrigger):
// BackupConfigs is always the full fleet-wide list (#2810's
// ListBackupConfigItems); ServerGameConfigs is scoped to whichever
// BackupConfig is currently selected -- empty until one is chosen, or after
// choosing one with no eligible deployment.
type BackupTriggerFormData struct {
	BackupConfigs          []components.SelectOption
	SelectedBackupConfigID string
	ServerGameConfigs      []components.SelectOption
	// SuccessBackupID, when > 0, renders a "queued" confirmation for the
	// most recently submitted trigger (the id TriggerBackup returned).
	SuccessBackupID int64
	// Err, when non-empty, renders the resubmitted form with an inline
	// error instead of a bare 500 -- FailedPrecondition's "no running
	// session" is the common case and must read as actionable
	// (backupTriggerErrorMessage in handlers_backups_fleet.go), not raw
	// gRPC status text.
	Err string
}

// BackupTriggerForm renders both the picker (GET "/backups/trigger-form",
// with or without a chosen BackupConfig) and the post-submit outcome (POST
// "/backups/trigger") -- one templ so the two can never render
// inconsistent markup for the same data. Selecting a BackupConfig re-fetches
// this whole fragment via the select's own hx-get (with backup_config_id in
// its request, htmx's default "include the closest form's values"
// behavior) so ServerGameConfigs reflects the newly chosen config's
// eligible deployments; submitting POSTs the same two fields.
templ BackupTriggerForm(data BackupTriggerFormData) {
	<form
		id={ backupTriggerFormID }
		hx-post="/backups/trigger"
		hx-target={ "#" + backupTriggerFormID }
		hx-swap="outerHTML"
		class="space-y-4"
	>
		if data.SuccessBackupID > 0 {
			<div class="alert alert-success mb-4">
				<span class="text-sm">Backup #{ fmt.Sprintf("%d", data.SuccessBackupID) } queued.</span>
			</div>
		}
		if data.Err != "" {
			@components.Alert("error", data.Err)
		}
		<div>
			<label class="block text-sm font-medium text-base-content mb-1" for="backup-trigger-config">Backup Config *</label>
			<select
				id="backup-trigger-config"
				name="backup_config_id"
				required
				hx-get="/backups/trigger-form"
				hx-trigger="change"
				hx-target={ "#" + backupTriggerFormID }
				hx-swap="outerHTML"
				class="select select-bordered w-full"
			>
				<option value="">-- select a backup config --</option>
				for _, opt := range data.BackupConfigs {
					<option value={ opt.Value } selected?={ data.SelectedBackupConfigID == opt.Value }>{ opt.Label }</option>
				}
			</select>
		</div>
		<div>
			<label class="block text-sm font-medium text-base-content mb-1" for="backup-trigger-sgc">Deployment *</label>
			if data.SelectedBackupConfigID == "" {
				<select id="backup-trigger-sgc" name="server_game_config_id" required disabled class="select select-bordered w-full">
					<option value="">-- select a backup config first --</option>
				</select>
			} else if len(data.ServerGameConfigs) == 0 {
				<select id="backup-trigger-sgc" name="server_game_config_id" required disabled class="select select-bordered w-full">
					<option value="">No deployments use this backup config's game config</option>
				</select>
			} else {
				<select id="backup-trigger-sgc" name="server_game_config_id" required class="select select-bordered w-full">
					<option value="">-- select a deployment --</option>
					for _, opt := range data.ServerGameConfigs {
						<option value={ opt.Value }>{ opt.Label }</option>
					}
				</select>
			}
		</div>
		<button type="submit" class="btn btn-primary" disabled?={ data.SelectedBackupConfigID == "" || len(data.ServerGameConfigs) == 0 }>
			Trigger backup
		</button>
	</form>
}

// BackupRunsPanelOOB re-renders "/backups"' fleet-wide run list
// out-of-band, targeting BackupRunsFragment's own "#backup-runs-panel"
// wrapper (BackupsPage) wherever it exists in the document. A successful
// "/backups/trigger" submit includes this alongside BackupTriggerForm's own
// primary (in-Blade) response so the new "pending" row appears on the
// underlying page without ever re-fetching or otherwise disturbing it
// (Blade's own FR10 "opening/closing never re-renders the surface
// underneath" contract, extended here to "neither does submitting inside
// it" -- this is the one deliberate, explicit exception, and it only ever
// touches the run list panel, nothing else on the page). This always
// renders the unfiltered first page rather than trying to recreate
// whatever filter the operator had applied before opening the Blade (the
// Blade's own form carries no record of the filter bar's state) -- FR5's
// acceptance criterion is "the new run appears in the fleet list", which an
// active status/deployment/volume filter could exclude the new row from
// regardless.
templ BackupRunsPanelOOB(data BackupRunsFragmentData) {
	<div id="backup-runs-panel" hx-swap-oob="true">
		@BackupRunsFragment(data)
	</div>
}

// BackupConfigsFragmentData backs both the initial "/backups" page render's
// "Backup configs" tab and every subsequent "/backups/configs" htmx
// fragment swap (filter submit or "Load more") -- handlers_backups_fleet.go
// builds one of these from ControlClient.ListBackupConfigsFleet's response
// for either route, mirroring BackupRunsFragmentData's own shape.
type BackupConfigsFragmentData struct {
	// Items is BackupConfigListItem, not the bare BackupConfig slice --
	// each row's volume/GameConfig/game display names come from here, no
	// per-row lookup (FR9).
	Items         []*manmanpb.BackupConfigListItem
	NextPageToken string
	Filter        BackupConfigsFilterValues
	// Err, when non-empty, renders an inline alert in place of the table
	// (and suppresses the "Load more" control) instead of a bare 500 --
	// the ListBackupConfigsFleet call itself failed, not "zero rows
	// matched".
	Err string
}

// BackupConfigsFilterValues holds the "Backup configs" tab's current filter
// values as strings (empty string means unset, matching each <input>/
// <select>'s own empty state), mirroring BackupRunsFilterValues.
// EnabledFilter distinguishes "false" (only disabled configs) from "" (no
// filter) so it can round-trip through BackupConfigListFilter's *bool
// (FR10, NFR4's pagination-composes-with-filtering requirement).
type BackupConfigsFilterValues struct {
	VolumeID     string
	GameConfigID string
	Enabled      string
}

// BackupConfigsFragment renders the "Backup configs" tab's table plus its
// "Load more" pagination control (NFR4) -- exported because
// handlers_backups_fleet.go renders it directly for "/backups/configs" htmx
// requests, in addition to BackupsPage using it for the initial unfiltered
// render.
//
// Every column FR9 asks for renders (volume, owning GameConfig/game,
// cadence, backup path, enabled state, last-run time via timeAgo's existing
// "Never" zero-state), the filter bar's Volume/GameConfig fields are
// name-based selects (FR10, backupConfigsFilterBar), and each row links out
// to the Config Editor via backupConfigEditorURL (FR11) -- see that
// function's doc comment for why the link targets Game Detail/Config
// Detail rather than the blade route directly.
templ BackupConfigsFragment(data BackupConfigsFragmentData) {
	if data.Err != "" {
		@components.Alert("error", data.Err)
	} else if len(data.Items) == 0 {
		@components.EmptyState("No backup configs", "No backup configs match the current filters.", "", "")
	} else {
		<div class="bg-base-100 rounded-box border border-base-300 overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>Volume</th>
						<th>Game / Config</th>
						<th>Cadence</th>
						<th>Backup Path</th>
						<th>Enabled</th>
						<th>Last Run</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, item := range data.Items {
						@backupConfigRow(item)
					}
				</tbody>
			</table>
		</div>
		if data.NextPageToken != "" {
			<div class="flex justify-center mt-4">
				<button
					type="button"
					class="btn btn-sm"
					hx-get={ fmt.Sprintf("/backups/configs?%s", nextConfigPageQuery(data.Filter, data.NextPageToken)) }
					hx-target="#backup-configs-panel"
					hx-swap="innerHTML"
				>
					Load more
				</button>
			</div>
		}
	}
}

// backupConfigsFilterBar is the FR10 filter bar: volume and GameConfig each
// render as a name-based <select> (backupRunsSelect, shared with
// backupRunsFilterBar) rather than the raw ID inputs Scaffold shipped --
// options come from handlers_backups_fleet.go's backupConfigsFilterOptions.
// Enabled is a fixed three-way select (All/Enabled/Disabled) since its
// option set never varies with fleet data, matching backupRunsFilterBar's
// Status select. Submits via htmx GET to "/backups/configs", swapping
// "#backup-configs-panel" in place; hx-push-url keeps the current filters
// in the address bar so a filtered view is linkable.
templ backupConfigsFilterBar(filter BackupConfigsFilterValues, options BackupConfigsFilterOptions) {
	<form
		hx-get="/backups/configs"
		hx-target="#backup-configs-panel"
		hx-swap="innerHTML"
		hx-push-url="true"
		class="flex flex-wrap gap-4 items-end mb-4 bg-base-100 border border-base-300 rounded-box p-4"
	>
		@backupRunsSelect("backup-configs-filter-volume", "volume_id", "Volume", "All volumes", filter.VolumeID, options.Volumes)
		@backupRunsSelect("backup-configs-filter-game-config", "game_config_id", "Game Config", "All game configs", filter.GameConfigID, options.GameConfigs)
		<div>
			<label class="block text-sm font-medium text-base-content mb-1" for="backup-configs-filter-enabled">Enabled</label>
			<select id="backup-configs-filter-enabled" name="enabled" class="select select-bordered select-sm w-40">
				<option value="" selected?={ filter.Enabled == "" }>All</option>
				<option value="true" selected?={ filter.Enabled == "true" }>Enabled</option>
				<option value="false" selected?={ filter.Enabled == "false" }>Disabled</option>
			</select>
		</div>
		<button type="submit" class="btn btn-primary btn-sm">Filter</button>
	</form>
}

// backupConfigRow is one BackupConfigListItem's row (FR9): volume/game/
// GameConfig display names come from the item's own display-context fields,
// not a per-row lookup. No BackupConfig or Action-definition create/edit/
// delete control renders here or anywhere else in this tab (FR11, C30) --
// that control lives exclusively in the Config Editor's Volumes tab; this
// row's interactive elements are the "Manage" link-out
// (backupConfigEditorURL) and the "Actions" button, which opens this row's
// own pre-backup Actions Blade (task #2817, FR12-FR15) -- attachments and
// ordering only, same C30 boundary.
templ backupConfigRow(item *manmanpb.BackupConfigListItem) {
	<tr>
		<td>{ item.VolumeName }</td>
		<td>{ fmt.Sprintf("%s / %s", item.GameName, item.GameConfigName) }</td>
		<td>{ fmt.Sprintf("%d min", item.Config.CadenceMinutes) }</td>
		<td>{ item.Config.BackupPath }</td>
		<td>
			if item.Config.Enabled {
				@htmxui.Badge("Enabled", htmxui.BadgeSuccess, htmxui.BadgeSizeSM, true, nil)
			} else {
				@htmxui.Badge("Disabled", htmxui.BadgeNeutral, htmxui.BadgeSizeSM, true, nil)
			}
		</td>
		<td>{ timeAgo(item.Config.LastBackupAt) }</td>
		<td class="text-right whitespace-nowrap">
			<a href={ templ.URL(backupConfigEditorURL(item)) } class="link link-primary text-sm mr-3">Manage in Config Editor</a>
			<button type="button" data-open-blade-template={ backupConfigActionsBladeTemplateID(item.Config.BackupConfigId) } class="btn btn-outline btn-xs">
				Actions
			</button>
			<template id={ backupConfigActionsBladeTemplateID(item.Config.BackupConfigId) }>
				@components.Blade(components.BladeData{
					ID:       backupConfigActionsBladeID(item.Config.BackupConfigId),
					Title:    "Pre-backup Actions",
					Subtitle: fmt.Sprintf("%s / %s", item.GameConfigName, item.VolumeName),
				}) {
					@BackupConfigActionsPlaceholder(item.Config.BackupConfigId)
				}
			</template>
		</td>
	</tr>
}

// backupConfigActionsBladeTemplateID and backupConfigActionsBladeID are the
// per-row <template>/Blade id pair backupConfigRow's "Actions" button opens
// (backupTriggerBladeOpenerScript's data-open-blade-template click
// delegate, already registered once by BackupsPage, handles the clone --
// this file needs no second copy of that script), mirroring
// game_detail.templ's "deployment-settings-blade-template-%d" /
// "deployment-settings-blade-%d" per-deployment pair.
func backupConfigActionsBladeTemplateID(backupConfigID int64) string {
	return fmt.Sprintf("backup-config-actions-blade-template-%d", backupConfigID)
}

func backupConfigActionsBladeID(backupConfigID int64) string {
	return fmt.Sprintf("backup-config-actions-blade-%d", backupConfigID)
}

// backupConfigEditorURL is the FR11 link-out target: the Config Editor's
// Volumes tab lives behind an htmx-triggered blade opened from within Game
// Detail (data-config-editor-trigger, game_detail.templ), not a plain
// navigable route, so this instead points at the Game Detail/Config Detail
// page for the row's owning GameConfig -- the same
// "/games/{game_id}/configs/{game_config_id}" shape
// handlers_config_editor.go's own BackupLinkURL already uses for its
// "Manage backups" link the other direction, so the two surfaces link to
// each other consistently without either needing blade auto-open support.
func backupConfigEditorURL(item *manmanpb.BackupConfigListItem) string {
	return fmt.Sprintf("/games/%d/configs/%d", item.GameId, item.GameConfigId)
}

// nextConfigPageQuery carries the current filter values plus the next page
// token into "Load more"'s hx-get target, mirroring nextPageQuery so paging
// never drops an active filter (NFR4).
func nextConfigPageQuery(filter BackupConfigsFilterValues, pageToken string) string {
	v := url.Values{}
	if filter.VolumeID != "" {
		v.Set("volume_id", filter.VolumeID)
	}
	if filter.GameConfigID != "" {
		v.Set("game_config_id", filter.GameConfigID)
	}
	if filter.Enabled != "" {
		v.Set("enabled", filter.Enabled)
	}
	v.Set("page_token", pageToken)
	return v.Encode()
}

// backupRunSize renders Backup.SizeBytes only once the run has completed
// (FR3: "size once completed") -- pending/running/failed rows show a dash
// rather than a stale or zero size, matching cacheEntrySize's
// (workshop_cache.templ) "%.1f MB" convention for a byte count elsewhere
// in this UI.
func backupRunSize(backup *manmanpb.Backup) string {
	if backup.Status != "completed" || backup.SizeBytes <= 0 {
		return "-"
	}
	return fmt.Sprintf("%.1f MB", float64(backup.SizeBytes)/1048576)
}

// backupRunOrigin renders Backup.TriggerSource verbatim (FR2/FR3's core
// rule): the API already normalizes this to exactly "scheduled", "manual",
// or "unknown" for historical rows with no recorded origin -- this must
// never guess or default an "unknown" (or empty, pre-#2809 data) row to
// "manual"/"scheduled".
func backupRunOrigin(backup *manmanpb.Backup) string {
	if backup.TriggerSource == "" {
		return "unknown"
	}
	return backup.TriggerSource
}

// nextPageQuery carries the current filter values plus the next page token
// into "Load more"'s hx-get target, so paging never drops an active filter
// (NFR4's server-side-pagination requirement implies paging composes with
// filtering, not resets it).
func nextPageQuery(filter BackupRunsFilterValues, pageToken string) string {
	v := url.Values{}
	if filter.ServerGameConfigID != "" {
		v.Set("server_game_config_id", filter.ServerGameConfigID)
	}
	if filter.VolumeID != "" {
		v.Set("volume_id", filter.VolumeID)
	}
	if filter.BackupConfigID != "" {
		v.Set("backup_config_id", filter.BackupConfigID)
	}
	if filter.Status != "" {
		v.Set("status", filter.Status)
	}
	v.Set("page_token", pageToken)
	return v.Encode()
}

// BackupConfigActionsData drives the pre-backup Actions panel opened from a
// BackupConfig row (task #2817, FR12-FR15) --
// handlers_backups_fleet.go's buildBackupConfigActionsData assembles one of
// these fresh for the panel's initial lazy load and after every add/remove/
// reorder mutation, so the displayed order always comes from a real
// ListBackupConfigActions call, never optimistic local state.
type BackupConfigActionsData struct {
	BackupConfigID int64
	// Items is already in execution order (display_order ascending) --
	// api/handlers/backup_config.go's ListBackupConfigActions orders them,
	// this panel never re-sorts.
	Items []*manmanpb.BackupConfigActionItem
	// AvailableActions is every Action usable at this BackupConfig's owning
	// GameConfig (local + inherited from its Game) that is not already
	// attached -- the "add" picker's option set.
	AvailableActions []components.SelectOption
	// Err, when non-empty, renders an inline alert above the list -- an
	// add/remove/reorder call's own failure (e.g. InvalidArgument from a
	// stale reorder set), not a bare 500. The list itself still renders:
	// the ListBackupConfigActions call this panel's Items come from is
	// separate and already succeeded by the time Err is ever set.
	Err string
}

// backupConfigActionsPanelID is the one stable container id the Blade's
// lazy-load placeholder and every add/remove/reorder response share
// (hx-swap="outerHTML"), mirroring DeploymentSettingsEnvSectionID's
// placeholder/section id-sharing convention.
func backupConfigActionsPanelID(backupConfigID int64) string {
	return fmt.Sprintf("backup-config-actions-panel-%d", backupConfigID)
}

// BackupConfigActionsPlaceholder is the Blade body backupConfigRow embeds
// inside the "Actions" button's cloned <template> -- cloning that template
// costs no request, but the BackupConfig's current Action list and
// available-Actions picker options need a fresh fetch every time the blade
// opens, mirroring BackupTriggerFormPlaceholder's lazy-load posture.
templ BackupConfigActionsPlaceholder(backupConfigID int64) {
	<div
		id={ backupConfigActionsPanelID(backupConfigID) }
		hx-get={ fmt.Sprintf("/backups/configs/%d/actions", backupConfigID) }
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<p class="text-sm text-base-content/60">Loading pre-backup actions…</p>
	</div>
}

// BackupConfigActionsPanel renders the real, data-backed panel: the ordered
// attachment list (FR12) with per-row remove (FR14) and move-up/move-down
// reorder controls (FR15), plus the "add an existing Action at a chosen
// position" form (FR13). Every control here only ever manages attachments/
// ordering -- there is no create/edit/delete control for the Action
// definitions themselves or for the BackupConfig (FR11, C30).
templ BackupConfigActionsPanel(data BackupConfigActionsData) {
	<div id={ backupConfigActionsPanelID(data.BackupConfigID) }>
		if data.Err != "" {
			@components.Alert("error", data.Err)
		}
		if len(data.Items) == 0 {
			<p class="text-sm text-base-content/60 mb-4">No pre-backup actions attached yet.</p>
		} else {
			<ol class="mb-4 space-y-2">
				for i, item := range data.Items {
					@backupConfigActionRow(data.BackupConfigID, data.Items, i, item)
				}
			</ol>
		}
		@backupConfigActionAddForm(data)
	</div>
}

// backupConfigActionRow is one attached Action's row: its execution
// position and name (BackupConfigActionItem carries the name directly,
// #2811 -- no per-row lookup), a remove control (FR14), and move-up/
// move-down controls (FR15) -- deliberately explicit buttons rather than a
// drag-only interaction, so reordering has a keyboard-accessible path. Each
// move control POSTs the *entire* resulting order (swapActionOrder), never
// a partial "swap these two" instruction the server would have to
// interpret, matching ReorderBackupConfigActionsRequest's "full desired
// order" contract (api_messages_backup.proto).
templ backupConfigActionRow(backupConfigID int64, items []*manmanpb.BackupConfigActionItem, index int, item *manmanpb.BackupConfigActionItem) {
	<li class="flex items-center justify-between gap-3 bg-base-100 border border-base-300 rounded px-3 py-2">
		<div>
			<span class="font-mono text-xs text-base-content/50 mr-2">{ fmt.Sprintf("%d.", index+1) }</span>
			<span class="font-medium text-sm">{ item.Name }</span>
		</div>
		<div class="flex items-center gap-1">
			if index > 0 {
				<button
					type="button"
					class="btn btn-ghost btn-xs"
					aria-label="Move up"
					hx-post={ fmt.Sprintf("/backups/configs/%d/actions/reorder", backupConfigID) }
					hx-vals={ reorderActionIDsJSON(swapActionOrder(items, index, index-1)) }
					hx-target={ "#" + backupConfigActionsPanelID(backupConfigID) }
					hx-swap="outerHTML"
				>
					↑
				</button>
			}
			if index < len(items)-1 {
				<button
					type="button"
					class="btn btn-ghost btn-xs"
					aria-label="Move down"
					hx-post={ fmt.Sprintf("/backups/configs/%d/actions/reorder", backupConfigID) }
					hx-vals={ reorderActionIDsJSON(swapActionOrder(items, index, index+1)) }
					hx-target={ "#" + backupConfigActionsPanelID(backupConfigID) }
					hx-swap="outerHTML"
				>
					↓
				</button>
			}
			<button
				type="button"
				class="btn btn-error btn-xs"
				hx-post={ fmt.Sprintf("/backups/configs/%d/actions/remove", backupConfigID) }
				hx-vals={ fmt.Sprintf(`{"action_id": %d}`, item.ActionId) }
				hx-confirm="Remove this action from the pre-backup list?"
				hx-target={ "#" + backupConfigActionsPanelID(backupConfigID) }
				hx-swap="outerHTML"
			>
				Remove
			</button>
		</div>
	</li>
}

// backupConfigActionAddForm is the FR13 "add an existing Action at a chosen
// position" control: the Action picker reuses the same fleet of Actions
// usable at this BackupConfig's owning GameConfig
// (handlers_actions.go's categorizeActions posture, minus anything already
// attached) that handlers_backups_fleet.go's buildBackupConfigActionsData
// resolves -- never a create-a-new-Action form (FR11, C30). Position is a
// 1-based select for readability; its value is already the 0-based
// display_order handleBackupConfigActionAdd forwards as-is. Disabled
// (rather than hidden) when there is nothing left to add, so an operator
// sees why the control is inert instead of it silently disappearing.
templ backupConfigActionAddForm(data BackupConfigActionsData) {
	<form
		hx-post={ fmt.Sprintf("/backups/configs/%d/actions/add", data.BackupConfigID) }
		hx-target={ "#" + backupConfigActionsPanelID(data.BackupConfigID) }
		hx-swap="outerHTML"
		class="flex flex-wrap items-end gap-2 border-t border-base-300 pt-3"
	>
		<div>
			<label class="block text-xs font-medium text-base-content mb-1" for="backup-config-action-add-select">Action</label>
			if len(data.AvailableActions) == 0 {
				<select id="backup-config-action-add-select" disabled class="select select-bordered select-sm">
					<option>No available actions to add</option>
				</select>
			} else {
				<select id="backup-config-action-add-select" name="action_id" required class="select select-bordered select-sm">
					<option value="">-- select an action --</option>
					for _, opt := range data.AvailableActions {
						<option value={ opt.Value }>{ opt.Label }</option>
					}
				</select>
			}
		</div>
		<div>
			<label class="block text-xs font-medium text-base-content mb-1" for="backup-config-action-add-position">Position</label>
			<select id="backup-config-action-add-position" name="display_order" disabled?={ len(data.AvailableActions) == 0 } class="select select-bordered select-sm">
				for i := 0; i <= len(data.Items); i++ {
					<option value={ strconv.Itoa(i) } selected?={ i == len(data.Items) }>{ strconv.Itoa(i + 1) }</option>
				}
			</select>
		</div>
		<button type="submit" class="btn btn-primary btn-sm" disabled?={ len(data.AvailableActions) == 0 }>Add</button>
	</form>
}

// swapActionOrder returns the full attached-action id order with the
// entries at i and j swapped -- the move-up/move-down controls' way of
// computing the *entire* resulting order server-side at render time
// (backupConfigActionRow), so the button's own hx-vals never needs
// client-side JS to compute it.
func swapActionOrder(items []*manmanpb.BackupConfigActionItem, i, j int) []int64 {
	ids := make([]int64, len(items))
	for k, item := range items {
		ids[k] = item.ActionId
	}
	ids[i], ids[j] = ids[j], ids[i]
	return ids
}

// reorderActionIDsJSON renders an action id order as the JSON object
// literal htmx's hx-vals attribute expects
// (https://htmx.org/attributes/hx-vals/): htmx expands an array-valued
// entry into one repeated form field per element when it builds the
// request body, so handleBackupConfigActionsReorder's r.Form["action_ids"]
// receives the full ordered sequence, not a single JSON blob to parse.
func reorderActionIDsJSON(actionIDs []int64) string {
	b, err := json.Marshal(map[string][]int64{"action_ids": actionIDs})
	if err != nil {
		return "{}"
	}
	return string(b)
}
