package pages

import (
	"github.com/whale-net/everything/manmanv2/ui/components"
)

templ ConfigStrategiesDocs(layout components.LayoutData) {
	@components.Layout(layout) {
		<div class="card bg-base-100 shadow-sm border border-base-300 max-w-none p-6">
			<h1 class="text-2xl font-bold text-base-content mb-4">Configuration Strategy System</h1>
			<h2 class="text-xl font-semibold text-base-content mt-6 mb-3">Overview</h2>
			<p class="text-base-content">The configuration strategy system provides a flexible, database-driven approach to generating game server configurations. It allows you to define how configuration files are created, what parameters can be customized, and how those parameters map to actual configuration values.</p>
			<div class="bg-base-200 p-4 rounded-md my-4">
				<strong class="text-base-content">Current Status:</strong>
				<ul class="mt-2 ml-6 text-base-content">
					<li>✅ Database schema and CRUD operations</li>
					<li>✅ Volume mounting (volume strategy type)</li>
					<li>🚧 File rendering system (in development)</li>
					<li>⏳ Parameter resolution and binding</li>
					<li>⏳ Configuration patches</li>
				</ul>
			</div>
			<p class="text-sm text-base-content/60 italic">Note: This is a documentation page. Full implementation details are available in the source code and database schema.</p>
		</div>
	}
}
