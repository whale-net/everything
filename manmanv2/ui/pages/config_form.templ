package pages

import (
	"fmt"
	"github.com/whale-net/everything/manmanv2/ui/components"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
)

templ ConfigForm(layout components.LayoutData, game *manmanpb.Game, config *manmanpb.GameConfig, edit bool) {
	@components.Layout(layout) {
		<div class="card bg-base-100 shadow-sm border border-base-300">
			<div class="flex justify-between items-center mb-4 pb-4 border-b border-base-300">
				<div class="text-xl font-semibold text-base-content">
					if edit {
						Edit Configuration
					} else {
						Create New Configuration
					}
				</div>
			</div>
			<form hx-post={ fmt.Sprintf("/games/%d/configs/create", game.GameId) } hx-swap="none">
				<div class="mb-4">
					<label class="block text-sm font-medium text-base-content mb-2">Game</label>
					<input type="text" value={ game.Name } disabled class="input input-bordered w-full bg-base-200"/>
				</div>
				<div class="mb-4">
					<label for="name" class="block text-sm font-medium text-base-content mb-2">Configuration Name *</label>
					<input
						type="text"
						id="name"
						name="name"
						value={ configValue(config, "name") }
						required
						placeholder="e.g., Vanilla Server, Modded Setup"
						class="input input-bordered w-full"
					/>
				</div>
				<div class="mb-4">
					<label for="image" class="block text-sm font-medium text-base-content mb-2">Docker Image *</label>
					<input
						type="text"
						id="image"
						name="image"
						value={ configValue(config, "image") }
						required
						placeholder="e.g., itzg/minecraft-server:latest"
						class="input input-bordered w-full"
					/>
					<p class="mt-1 text-xs text-base-content/60">The Docker image to use for this game server</p>
				</div>
				<div class="mb-4">
					<label for="args_template" class="block text-sm font-medium text-base-content mb-2">Args Template</label>
					<textarea
						id="args_template"
						name="args_template"
						placeholder="Optional command line arguments template"
						class="textarea textarea-bordered w-full min-h-[88px]"
					>{ configValue(config, "args_template") }</textarea>
					<p class="mt-1 text-xs text-base-content/60">Use template variables like { "{{.PARAM_NAME}}" } to reference parameters</p>
				</div>
				<p class="mb-4 text-sm text-base-content/60 italic">Note: After creating the configuration, you can add parameters, environment variables, and file templates on the detail page.</p>
				<div class="flex gap-2">
					<button type="submit" class="btn btn-success">
						if edit {
							Update Configuration
						} else {
							Create Configuration
						}
					</button>
					<a href={ templ.URL(fmt.Sprintf("/games/%d", game.GameId)) } class="btn btn-secondary">
						Cancel
					</a>
				</div>
			</form>
		</div>
	}
}

func configValue(config *manmanpb.GameConfig, field string) string {
	if config == nil {
		return ""
	}
	switch field {
	case "name":
		return config.Name
	case "image":
		return config.Image
	case "args_template":
		return config.ArgsTemplate
	}
	return ""
}
