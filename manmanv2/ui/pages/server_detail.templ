package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

templ ServerDetail(layout components.LayoutData, server *manmanpb.Server, configs []*manmanpb.ServerGameConfig) {
	@components.Layout(layout) {
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold text-base-content">{ server.Name }</h1>
			<div class="flex gap-2 items-center">
				<a href="/servers" class="btn btn-secondary btn-sm">Back to Servers</a>
				@htmxui.Badge(server.Status, statusBadgeVariant(serverStatusVariant(server.Status)), htmxui.BadgeSizeSM, true, nil)
			</div>
		</div>
		<div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
			<div class="card-body">
				<h2 class="text-lg font-semibold text-base-content mb-4">Server Information</h2>
				<dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
					@components.DLItem("Server ID", fmt.Sprintf("%d", server.ServerId))
					@components.DLItem("Name", server.Name)
					<div>
						<dt class="text-sm font-medium text-base-content/60">Status</dt>
						<dd class="mt-1">
							@htmxui.Badge(server.Status, statusBadgeVariant(serverStatusVariant(server.Status)), htmxui.BadgeSizeSM, true, nil)
						</dd>
					</div>
					@components.DLItem("Environment", orDash(server.Environment))
					@components.DLItem("Last Seen", fmt.Sprintf("%s (%s)", timeAgo(server.LastSeen), formatTime(server.LastSeen)))
					<div>
						<dt class="text-sm font-medium text-base-content/60">Public Address</dt>
						<dd class="mt-1 text-sm text-base-content">
							if server.HostPublicAddress == "" {
								Not set
							} else {
								{ server.HostPublicAddress }
							}
						</dd>
					</div>
				</dl>
				<form method="POST" action={ templ.URL(fmt.Sprintf("/servers/%d/update-address", server.ServerId)) } class="mt-4 flex flex-col gap-2 max-w-md">
					<label for="host_public_address" class="block text-sm font-medium text-base-content">Edit Public Address</label>
					<input
						type="text"
						id="host_public_address"
						name="host_public_address"
						value={ server.HostPublicAddress }
						placeholder="e.g., game.example.com:27015"
						class="input input-bordered w-full"
					/>
					<p class="text-xs text-base-content/60">Leave blank to clear.</p>
					<div>
						<button type="submit" class="btn btn-success btn-sm">Save Public Address</button>
					</div>
				</form>
			</div>
		</div>
		<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
			<div class="flex justify-between items-center p-4 border-b border-base-300 bg-base-200">
				<h2 class="text-lg font-semibold text-base-content">Deployments</h2>
				<a href="/games" class="btn btn-primary btn-sm">Deploy New Config</a>
			</div>
			if len(configs) > 0 {
				<div class="overflow-x-auto">
					<table class="table">
						<thead>
							<tr>
								<th>ID</th>
								<th>Game Config</th>
								<th>Status</th>
								<th>Port Bindings</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, sgc := range configs {
								<tr class="hover">
									<td class="text-sm">{ fmt.Sprintf("%d", sgc.ServerGameConfigId) }</td>
									<td class="text-sm">Config #{ fmt.Sprintf("%d", sgc.GameConfigId) }</td>
									<td>
										@htmxui.Badge(sgc.Status, statusBadgeVariant(serverStatusVariant(sgc.Status)), htmxui.BadgeSizeSM, true, nil)
									</td>
									<td class="text-sm">
										if len(sgc.PortBindings) > 0 {
											<div class="flex flex-wrap gap-1">
												for _, pb := range sgc.PortBindings {
													<code class="text-xs bg-base-200 text-base-content px-2 py-1 rounded">
														{ fmt.Sprintf("%d:%d/%s", pb.ContainerPort, pb.HostPort, pb.Protocol) }
													</code>
												}
											</div>
										} else {
											-
										}
									</td>
									<td class="text-right text-sm font-medium">
										<div class="flex justify-end gap-2">
											<a href={ templ.URL(fmt.Sprintf("/sgc/%d", sgc.ServerGameConfigId)) } class="btn btn-secondary btn-sm">Manage SGC</a>
											<a href={ templ.URL(fmt.Sprintf("/sessions?server_game_config_id=%d", sgc.ServerGameConfigId)) } class="btn btn-secondary btn-sm">View Sessions</a>
											<form method="POST" action="/sessions/start" class="inline-flex items-center gap-2">
												<input type="hidden" name="server_game_config_id" value={ fmt.Sprintf("%d", sgc.ServerGameConfigId) }/>
												<label class="label cursor-pointer gap-1 text-xs text-base-content">
													<input type="checkbox" name="force" value="true" class="checkbox checkbox-xs"/>
													Force
												</label>
												@htmxui.Button(htmxui.ButtonSuccess, htmxui.ButtonSizeSM, false, templ.Attributes{
													"type":       "submit",
													"hx-get":     fmt.Sprintf("/api/sessions/check-active?server_game_config_id=%d", sgc.ServerGameConfigId),
													"hx-trigger": "mouseenter once",
													"hx-target":  fmt.Sprintf("#sgc-warning-%d", sgc.ServerGameConfigId),
													"hx-swap":    "innerHTML",
												}) {
													Start Session
												}
											</form>
											<div id={ fmt.Sprintf("sgc-warning-%d", sgc.ServerGameConfigId) } class="absolute mt-1 min-w-[300px] z-10"></div>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<div class="p-12 text-center">
					<p class="text-base-content/60 mb-4">No deployments on this server yet.</p>
					<a href="/games" class="btn btn-primary">Browse Games to Deploy</a>
				</div>
			}
		</div>
	}
}

func orDash(s string) string {
	if s == "" {
		return "-"
	}
	return s
}

func formatTime(timestamp int64) string {
	if timestamp == 0 {
		return "-"
	}
	return fmt.Sprintf("%d", timestamp)
}
