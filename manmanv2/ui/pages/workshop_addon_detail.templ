package pages

import (
	"fmt"
	"github.com/whale-net/everything/manmanv2/ui/components"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
)

type WorkshopAddonDetailPageData struct {
	Layout              components.LayoutData
	Addon               *manmanpb.WorkshopAddon
	Game                *manmanpb.Game
	ContainingLibraries []*manmanpb.WorkshopLibrary
	AvailableLibraries  []*manmanpb.WorkshopLibrary
	// CollectionChildren holds this addon's own children, populated when Addon.IsCollection.
	CollectionChildren []*manmanpb.WorkshopAddon
	// ParentCollection is the collection this addon was created from, populated when Addon.CollectionId != 0.
	ParentCollection *manmanpb.WorkshopAddon
}

templ WorkshopAddonDetail(data WorkshopAddonDetailPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		<div x-data="{ confirmDelete: false, filterLibs: '' }">
			<!-- Header with Breadcrumbs -->
			<div class="flex flex-col md:flex-row justify-between items-start gap-4 mb-6">
				<div>
					<div class="flex items-center gap-2 mb-2 text-sm">
						<a href="/workshop/library" class="text-base-content/60 hover:text-primary">Workshop</a>
						<span class="text-base-content/40">›</span>
						<a href="/workshop/search?type=addon" class="text-base-content/60 hover:text-primary">Addons</a>
					</div>
					<div class="flex items-center gap-3">
						<h1 class="text-3xl font-bold text-base-content">{ data.Addon.Name }</h1>
						if data.Addon.IsCollection {
							<span class="badge badge-primary badge-soft">Collection</span>
						} else {
							<span class="badge badge-info badge-soft">Addon</span>
						}
					</div>
				</div>
			</div>
			<!-- Info Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
				<div class="bg-base-100 rounded-box border border-base-300 p-4">
					<div class="text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-1">Workshop ID</div>
					<div class="text-sm font-mono text-base-content break-all">{ data.Addon.WorkshopId }</div>
				</div>
				<div class="bg-base-100 rounded-box border border-base-300 p-4">
					<div class="text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-1">Game</div>
					<div class="text-sm font-medium text-base-content">
						if data.Game != nil {
							{ data.Game.Name }
						} else {
							Unknown
						}
					</div>
				</div>
				<div class="bg-base-100 rounded-box border border-base-300 p-4">
					<div class="text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-1">Platform</div>
					<div class="text-sm font-medium text-base-content">{ data.Addon.PlatformType }</div>
				</div>
				<div class="bg-base-100 rounded-box border border-base-300 p-4">
					<div class="text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-1">File Size</div>
					<div class="text-sm font-medium text-base-content">
						if data.Addon.FileSizeBytes > 0 {
							{ fmt.Sprintf("%.1f MB", float64(data.Addon.FileSizeBytes)/1048576) }
						} else {
							Unknown
						}
					</div>
				</div>
			</div>
			<!-- Collection Relationships -->
			if data.ParentCollection != nil {
				<div class="bg-indigo-50 dark:bg-indigo-900/20 rounded-lg border border-indigo-200 dark:border-indigo-900 p-4 mb-6 text-sm">
					<span class="text-indigo-900 dark:text-indigo-200">Part of collection: </span>
					<a href={ templ.URL(fmt.Sprintf("/workshop/addon?addon_id=%d", data.ParentCollection.AddonId)) } class="font-semibold text-indigo-700 dark:text-indigo-300 hover:underline">{ data.ParentCollection.Name }</a>
				</div>
			}
			if data.Addon.IsCollection {
				<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-6 mb-6">
					<div class="flex justify-between items-center mb-4">
						<h2 class="text-lg font-bold text-gray-900 dark:text-white">Collection Items</h2>
						<span class="text-sm text-gray-500 dark:text-gray-400">{ fmt.Sprintf("%d items", len(data.CollectionChildren)) }</span>
					</div>
					if len(data.CollectionChildren) > 0 {
						<div class="space-y-2">
							for _, child := range data.CollectionChildren {
								<div class="flex justify-between items-center p-3 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-200 dark:border-slate-700">
									<a href={ templ.URL(fmt.Sprintf("/workshop/addon?addon_id=%d", child.AddonId)) } class="font-semibold text-sm text-gray-900 dark:text-white hover:text-blue-600">{ child.Name }</a>
									<span class="text-xs text-gray-500 dark:text-gray-400">
										if child.FileSizeBytes > 0 {
											{ fmt.Sprintf("%.1f MB", float64(child.FileSizeBytes)/1048576) }
										} else {
											Unknown size
										}
									</span>
								</div>
							}
						</div>
					} else {
						<div class="text-center py-8 text-gray-500 dark:text-gray-400 text-sm">No items found for this collection</div>
					}
				</div>
			}
			<!-- Description -->
			if data.Addon.Description != "" {
				<div class="bg-base-100 rounded-box border border-base-300 p-5 mb-6">
					<div class="text-sm text-base-content leading-relaxed">{ data.Addon.Description }</div>
				</div>
			}
			<!-- Associated Libraries -->
			<div class="bg-base-100 rounded-box border border-base-300 p-6 mb-6">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-lg font-bold text-base-content">Associated Libraries</h2>
					<span class="text-sm text-base-content/60">{ fmt.Sprintf("%d libraries", len(data.ContainingLibraries)) }</span>
				</div>
				if len(data.ContainingLibraries) > 0 {
					<div class="space-y-2">
						for _, lib := range data.ContainingLibraries {
							<div class="flex justify-between items-center p-3 bg-base-200 rounded-box border border-base-300">
								<div>
									<a href={ templ.URL(fmt.Sprintf("/workshop/library-detail?library_id=%d", lib.LibraryId)) } class="font-semibold text-sm text-base-content hover:text-primary">{ lib.Name }</a>
								</div>
								<form method="POST" action="/workshop/remove-addon-from-library">
									<input type="hidden" name="library_id" value={ fmt.Sprintf("%d", lib.LibraryId) }/>
									<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", data.Addon.AddonId) }/>
									<button type="submit" class="btn btn-error btn-sm">Remove</button>
								</form>
							</div>
						}
					</div>
				} else {
					<div class="text-center py-8 text-base-content/60 text-sm">Not associated with any libraries</div>
				}
			</div>
			<!-- Add to Library -->
			<div class="bg-base-100 rounded-box border border-base-300 p-6">
				<h2 class="text-lg font-bold text-base-content mb-4">Add to Library</h2>
				<input type="text" x-model="filterLibs" placeholder="Filter libraries..." class="input input-bordered w-full mb-3"/>
				if len(data.AvailableLibraries) > 0 {
					<div class="space-y-2 max-h-80 overflow-y-auto">
						for _, lib := range data.AvailableLibraries {
							<div x-show={ fmt.Sprintf("filterLibs === '' || '%s'.toLowerCase().includes(filterLibs.toLowerCase())", lib.Name) } class="flex justify-between items-center p-3 bg-base-200 rounded-box border border-transparent hover:border-base-300 transition-colors">
								<span class="text-sm text-base-content font-medium">{ lib.Name }</span>
								<form method="POST" action="/workshop/add-addon-to-library">
									<input type="hidden" name="library_id" value={ fmt.Sprintf("%d", lib.LibraryId) }/>
									<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", data.Addon.AddonId) }/>
									<button type="submit" class="btn btn-primary btn-sm">Add</button>
								</form>
							</div>
						}
					</div>
				} else {
					<div class="text-center py-8 text-base-content/60 text-sm">No available libraries</div>
				}
			</div>
			<!-- Danger Zone: chrome restyled onto htmxui.Confirm's ZoneTitle visual
				language; existing Alpine click-to-reveal gate kept as-is (FR7), see
				sgc_detail.templ's Danger Zone comment for the full rationale. -->
			<div class="card bg-base-100 border-2 border-error/40 shadow-md overflow-hidden mt-6">
				<div class="bg-error/10 px-6 py-4 border-b-2 border-error/40">
					<h2 class="text-lg font-semibold text-error">⚠️ Danger Zone</h2>
				</div>
				<div class="card-body">
					<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
						<div>
							<h3 class="text-sm font-semibold text-base-content mb-1">Delete this addon</h3>
							<p class="text-sm text-base-content/60">Permanently delete this addon from the system. It will be removed from all libraries. This action cannot be undone.</p>
						</div>
						<div class="flex-shrink-0">
							<button x-show="!confirmDelete" @click="confirmDelete = true" class="btn btn-error">Delete Addon</button>
							<div x-show="confirmDelete" x-cloak class="flex gap-2 items-center">
								<span class="text-sm text-error font-medium">Are you sure?</span>
								<form method="POST" action="/workshop/delete-addon" class="inline">
									<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", data.Addon.AddonId) }/>
									<button type="submit" class="btn btn-error">Yes, Delete</button>
								</form>
								<button @click="confirmDelete = false" class="btn btn-secondary">Cancel</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
