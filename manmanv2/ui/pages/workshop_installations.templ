package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

templ WorkshopInstallations(layout components.LayoutData, config *manmanpb.GameConfig, installations []*manmanpb.WorkshopInstallation, libraries []*manmanpb.WorkshopLibrary) {
	@components.Layout(layout) {
		<style>
			[x-cloak] { "{ display: none !important; }" }
		</style>
		<div x-data="{ showModal: false }">
			<div class="flex justify-between items-center mb-6">
				<div class="flex items-center gap-4">
					<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", config.GameId, config.ConfigId)) } class="btn btn-secondary">
						← Back
					</a>
					<h1 class="text-3xl font-bold text-base-content">Workshop Addons { "for" } { config.Name }</h1>
				</div>
				<button @click="showModal = true" class="btn btn-primary">
					Install Addon
				</button>
			</div>
			<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden">
				if len(installations) > 0 {
					<table class="table">
						<thead class="bg-base-200">
							<tr>
								<th class="px-6 py-3 text-left text-xs font-semibold text-base-content uppercase tracking-wider">Addon</th>
								<th class="px-6 py-3 text-left text-xs font-semibold text-base-content uppercase tracking-wider">Status</th>
								<th class="px-6 py-3 text-left text-xs font-semibold text-base-content uppercase tracking-wider">Progress</th>
								<th class="px-6 py-3 text-left text-xs font-semibold text-base-content uppercase tracking-wider">Path</th>
								<th class="px-6 py-3 text-left text-xs font-semibold text-base-content uppercase tracking-wider">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, inst := range installations {
								<tr class="hover">
									<td>
										<div class="text-sm font-medium text-base-content">Addon #{ fmt.Sprintf("%d", inst.AddonId) }</div>
									</td>
									<td>
										@htmxui.Badge(inst.Status, statusBadgeVariant(installStatusVariant(inst.Status)), htmxui.BadgeSizeSM, true, nil)
									</td>
									<td>
										if inst.Status == "downloading" || inst.Status == "pending" {
											<div class="w-full bg-base-300 rounded-full h-2.5 mb-1">
												<div class="bg-info h-2.5 rounded-full" style={ fmt.Sprintf("width: %d%%", inst.ProgressPercent) }></div>
											</div>
											<span class="text-xs text-base-content/60">{ fmt.Sprintf("%d%%", inst.ProgressPercent) }</span>
										} else {
											<span class="text-sm text-base-content/60">-</span>
										}
									</td>
									<td class="text-sm text-base-content/60 max-w-xs truncate">
										if inst.InstallationPath != "" {
											{ inst.InstallationPath }
										} else {
											-
										}
									</td>
									<td class="text-sm">
										<form method="POST" action="/workshop/uninstall-addon" class="inline">
											<input type="hidden" name="installation_id" value={ fmt.Sprintf("%d", inst.InstallationId) }/>
											<button type="submit" class="btn btn-error btn-sm">
												Uninstall
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				} else {
					<div class="text-center py-12 text-base-content/60">No workshop addons installed</div>
				}
			</div>
			<div x-show="showModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto" @click.self="showModal = false">
				<div class="flex items-center justify-center min-h-screen px-4">
					<div class="fixed inset-0 bg-black opacity-50"></div>
					<div class="relative card bg-base-100 shadow-xl max-w-2xl w-full p-6">
						<div class="flex justify-between items-center mb-4">
							<h2 class="text-xl font-bold text-base-content">Install Workshop Addon</h2>
							<button @click="showModal = false" class="text-base-content/50 hover:text-base-content">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
						<form method="POST" action="/workshop/install-addon" class="space-y-4">
							<input type="hidden" name="config_id" value={ fmt.Sprintf("%d", config.ConfigId) }/>
							<div>
								<label class="label"><span class="label-text">Select Library</span></label>
								<select name="library_id" required class="select select-bordered w-full">
									<option value="">Choose a library...</option>
									for _, lib := range libraries {
										<option value={ fmt.Sprintf("%d", lib.LibraryId) }>
											{ lib.Name }
										</option>
									}
								</select>
							</div>
							<div>
								<label class="label"><span class="label-text">Installation Path</span></label>
								<input type="text" name="installation_path" placeholder="/path/to/install" required class="input input-bordered w-full"/>
							</div>
							<div class="flex gap-2 justify-end pt-4">
								<button type="button" @click="showModal = false" class="btn btn-secondary">
									Cancel
								</button>
								<button type="submit" class="btn btn-primary">
									Install
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	}
}

func installStatusVariant(status string) string {
	switch status {
	case "installed":
		return "success"
	case "downloading":
		return "info"
	case "pending":
		return "warning"
	case "failed":
		return "danger"
	default:
		return "secondary"
	}
}
