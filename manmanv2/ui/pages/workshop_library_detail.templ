package pages

import (
	"fmt"
	"github.com/whale-net/everything/manmanv2/ui/components"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
)

type WorkshopLibraryDetailPageData struct {
	Layout          components.LayoutData
	Library         *manmanpb.WorkshopLibrary
	Game            *manmanpb.Game
	Games           []*manmanpb.Game
	Addons          []*manmanpb.WorkshopAddon
	AvailableAddons []*manmanpb.WorkshopAddon
}

templ WorkshopLibraryDetail(data WorkshopLibraryDetailPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		<div x-data="{ confirmDelete: false, editLib: false, filterAddons: '' }">
			<!-- Header with Breadcrumbs -->
			<div class="flex flex-col md:flex-row justify-between items-start gap-4 mb-6">
				<div>
					<div class="flex items-center gap-2 mb-2 text-sm">
						<a href="/workshop/library" class="text-base-content/60 hover:text-primary">Workshop</a>
						<span class="text-base-content/40">›</span>
						<span class="text-base-content">{ data.Library.Name }</span>
					</div>
					<h1 class="text-3xl font-bold text-base-content mb-2">{ data.Library.Name }</h1>
					<div class="flex items-center gap-2 flex-wrap">
						<span class="badge badge-warning badge-soft">Library</span>
						if data.Game != nil {
							<span class="badge badge-neutral badge-soft">{ data.Game.Name }</span>
						}
						<span class="text-sm text-base-content/60">{ fmt.Sprintf("%d addons", len(data.Addons)) }</span>
					</div>
				</div>
				<div class="flex gap-2">
					<button @click="editLib = !editLib" class="btn btn-primary">Edit</button>
				</div>
			</div>
			<!-- Description -->
			if data.Library.Description != "" {
				<div class="bg-base-100 rounded-box border border-base-300 p-5 mb-6">
					<div class="text-sm text-base-content leading-relaxed">{ data.Library.Description }</div>
				</div>
			}
			<!-- Edit Form -->
			<div x-show="editLib" x-cloak class="bg-base-100 rounded-box border border-base-300 p-6 mb-6">
				<h2 class="text-lg font-bold text-base-content mb-4">Edit Library</h2>
				<form method="POST" action="/workshop/update-library" class="space-y-4">
					<input type="hidden" name="library_id" value={ fmt.Sprintf("%d", data.Library.LibraryId) }/>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-base-content mb-2">Name</label>
							<input type="text" name="name" value={ data.Library.Name } required class="input input-bordered w-full"/>
						</div>
						<div>
							<label class="block text-sm font-medium text-base-content mb-2">Game</label>
							<select name="game_id" required class="select select-bordered w-full">
								for _, game := range data.Games {
									<option value={ fmt.Sprintf("%d", game.GameId) } selected?={ data.Library.GameId == game.GameId }>{ game.Name }</option>
								}
							</select>
						</div>
					</div>
					<div>
						<label class="block text-sm font-medium text-base-content mb-2">Description</label>
						<textarea name="description" rows="3" class="textarea textarea-bordered w-full">{ data.Library.Description }</textarea>
					</div>
					<div class="flex gap-2">
						<button type="submit" class="btn btn-success">Save Changes</button>
						<button type="button" @click="editLib = false" class="btn btn-secondary">Cancel</button>
					</div>
				</form>
			</div>
			<!-- Addons in Library -->
			<div class="bg-base-100 rounded-box border border-base-300 p-6 mb-6">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-lg font-bold text-base-content">Addons in Library</h2>
					<span class="text-sm text-base-content/60">{ fmt.Sprintf("%d addons", len(data.Addons)) }</span>
				</div>
				if len(data.Addons) > 0 {
					<div class="divide-y divide-base-300">
						for _, addon := range data.Addons {
							<div class="flex justify-between items-center py-3 hover:bg-base-200 px-3 -mx-3 rounded">
								<div class="flex-1 min-w-0">
									<a href={ templ.URL(fmt.Sprintf("/workshop/addon?addon_id=%d", addon.AddonId)) } class="font-semibold text-sm text-base-content hover:text-primary block truncate">{ addon.Name }</a>
									<div class="flex gap-2 mt-1 text-xs flex-wrap">
										if addon.IsCollection {
											<span class="badge badge-primary badge-soft">Collection</span>
										} else {
											<span class="badge badge-info badge-soft">Addon</span>
										}
										<span class="text-base-content/60 font-mono">{ addon.WorkshopId }</span>
									</div>
								</div>
								<form method="POST" action="/workshop/remove-addon-from-library">
									<input type="hidden" name="library_id" value={ fmt.Sprintf("%d", data.Library.LibraryId) }/>
									<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", addon.AddonId) }/>
									<button type="submit" class="btn btn-error btn-sm ml-3">Remove</button>
								</form>
							</div>
						}
					</div>
				} else {
					<div class="text-center py-8 text-base-content/60 text-sm">No addons in this library</div>
				}
			</div>
			<!-- Add Addons -->
			<div class="bg-base-100 rounded-box border border-base-300 p-6">
				<h2 class="text-lg font-bold text-base-content mb-4">Add Addons</h2>
				<input type="text" x-model="filterAddons" placeholder="Filter addons..." class="input input-bordered w-full mb-3"/>
				if len(data.AvailableAddons) > 0 {
					<div class="space-y-2 max-h-80 overflow-y-auto">
						for _, addon := range data.AvailableAddons {
							<div x-show={ fmt.Sprintf("filterAddons === '' || '%s'.toLowerCase().includes(filterAddons.toLowerCase())", addon.Name) } class="flex justify-between items-center p-3 bg-base-200 rounded-box border border-transparent hover:border-base-300 transition-colors">
								<div class="flex-1 min-w-0">
									<div class="text-sm text-base-content font-medium truncate">{ addon.Name }</div>
									<div class="text-xs text-base-content/60 font-mono mt-1">{ addon.WorkshopId }</div>
								</div>
								<form method="POST" action="/workshop/add-addon-to-library">
									<input type="hidden" name="library_id" value={ fmt.Sprintf("%d", data.Library.LibraryId) }/>
									<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", addon.AddonId) }/>
									<button type="submit" class="btn btn-primary btn-sm ml-3">Add</button>
								</form>
							</div>
						}
					</div>
				} else {
					<div class="text-center py-8 text-base-content/60 text-sm">No available addons</div>
				}
			</div>
			<!-- Danger Zone: chrome restyled onto htmxui.Confirm's ZoneTitle visual
			language; existing Alpine click-to-reveal gate kept as-is (FR7), see
			sgc_detail.templ's Danger Zone comment for the full rationale. -->
			<div class="card bg-base-100 border-2 border-error/40 shadow-md overflow-hidden mt-6">
				<div class="bg-error/10 px-6 py-4 border-b-2 border-error/40">
					<h2 class="text-lg font-semibold text-error">⚠️ Danger Zone</h2>
				</div>
				<div class="card-body">
					<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
						<div>
							<h3 class="text-sm font-semibold text-base-content mb-1">Delete this library</h3>
							<p class="text-sm text-base-content/60">Permanently delete this library. Addons will not be deleted, only the library grouping. This action cannot be undone.</p>
						</div>
						<div class="flex-shrink-0">
							<button x-show="!confirmDelete" @click="confirmDelete = true" class="btn btn-error">Delete Library</button>
							<div x-show="confirmDelete" x-cloak class="flex gap-2 items-center">
								<span class="text-sm text-error font-medium">Are you sure?</span>
								<form method="POST" action="/workshop/delete-library" class="inline">
									<input type="hidden" name="library_id" value={ fmt.Sprintf("%d", data.Library.LibraryId) }/>
									<button type="submit" class="btn btn-error">Yes, Delete</button>
								</form>
								<button @click="confirmDelete = false" class="btn btn-secondary">Cancel</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
