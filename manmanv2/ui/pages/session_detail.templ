package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

type SessionDetailPageData struct {
	Layout        components.LayoutData
	Session       *manmanpb.Session
	SGC           *manmanpb.ServerGameConfig
	GameConfig    *manmanpb.GameConfig
	Game          *manmanpb.Game
	Actions       []*manmanpb.ActionDefinition
	Libraries     []*manmanpb.WorkshopLibrary
	Installations []*manmanpb.WorkshopInstallation
}

// actionButtonVariant maps an ActionDefinition's ButtonStyle (a manmanv2
// domain field driven by action config, not a fixed enum) onto
// htmxui.ButtonVariant, preserving the same primary/success/danger/warning
// colour semantics the old buttonStyleClass switch encoded (FR7).
func actionButtonVariant(style string) htmxui.ButtonVariant {
	switch style {
	case "primary":
		return htmxui.ButtonPrimary
	case "success":
		return htmxui.ButtonSuccess
	case "danger":
		return htmxui.ButtonError
	case "warning":
		return htmxui.ButtonWarning
	default:
		return htmxui.ButtonSecondary
	}
}

// actionExecuteAttrs carries the no-input action button's hx-* wiring
// (FR7: hx-post/hx-vals/hx-target/hx-swap/hx-confirm exactly as before)
// through htmxui.Button's attrs escape hatch.
func actionExecuteAttrs(sessionID int64, action *manmanpb.ActionDefinition) templ.Attributes {
	attrs := templ.Attributes{
		"hx-post":   fmt.Sprintf("/sessions/%d/actions/execute", sessionID),
		"hx-vals":   fmt.Sprintf("{\"action_id\": \"%d\"}", action.ActionId),
		"hx-target": "#action-status",
		"hx-swap":   "innerHTML",
	}
	if action.RequiresConfirmation {
		attrs["hx-confirm"] = action.ConfirmationMessage
	}
	return attrs
}

// actionSubmitAttrs carries the parameterized action form's submit button
// attributes (type=submit plus the same optional hx-confirm, FR7).
func actionSubmitAttrs(action *manmanpb.ActionDefinition) templ.Attributes {
	attrs := templ.Attributes{"type": "submit"}
	if action.RequiresConfirmation {
		attrs["hx-confirm"] = action.ConfirmationMessage
	}
	return attrs
}

templ SessionDetail(data SessionDetailPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
			.log-viewer-container {
				background: #1e1e1e;
				max-height: 600px;
				overflow: hidden;
			}
			[data-theme="oled"] .log-viewer-container {
				background: #000000;
			}
			.log-viewer-output {
				margin: 0;
				padding: 1rem;
				color: #d4d4d4;
				font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
				font-size: 0.875rem;
				line-height: 1.5;
				overflow-y: auto;
				overflow-x: auto;
				max-height: 600px;
				white-space: pre-wrap;
				word-wrap: break-word;
			}
			.log-viewer-container.collapsed .log-viewer-output {
				display: none;
			}
			.log-line { display: block; }
			.log-stdout { color: #d4d4d4; }
			.log-stderr { color: #f48771; }
			.log-host { color: #4fc1ff; }
			.log-info { color: #4fc1ff; }
			.log-warning { color: #f9c74f; }
			.log-error { color: #f48771; }
			.log-timestamp { color: #858585; margin-right: 0.5rem; }
			#log-histogram {
				border: 1px solid var(--color-base-300);
				border-radius: 4px;
			}
		</style>
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
			<div>
				<div class="flex items-center gap-2 mb-2">
					<span class="badge badge-info badge-soft">
						🎮 SESSION
					</span>
					@htmxui.Badge(data.Session.Status, statusBadgeVariant(data.Session.Status), htmxui.BadgeSizeMD, true, nil)
				</div>
				<h1 class="text-3xl font-bold text-base-content">Session { fmt.Sprintf("%d", data.Session.SessionId) }</h1>
				if data.Game != nil {
					<p class="text-sm text-base-content/60 mt-1">{ data.Game.Name }</p>
				}
			</div>
			<div class="flex flex-wrap gap-2">
				if data.Session.Status == "running" {
					<form method="POST" action={ templ.URL(fmt.Sprintf("/sessions/%d/stop", data.Session.SessionId)) } class="inline">
						<button type="submit" class="btn btn-error">Stop Session</button>
					</form>
				}
				if data.SGC != nil {
					<a href={ templ.URL(fmt.Sprintf("/sgc/%d", data.SGC.ServerGameConfigId)) } class="btn btn-secondary btn-sm">View SGC</a>
				}
			</div>
		</div>
		<!-- Session Info -->
		<div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
			<div class="card-body">
				<h2 class="text-lg font-semibold text-base-content mb-4">Session Details</h2>
				<dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
					@components.DLItemMono("Session ID", fmt.Sprintf("%d", data.Session.SessionId))
					<div>
						<dt class="text-sm font-medium text-base-content/60">Status</dt>
						<dd class="mt-1">
							@htmxui.Badge(data.Session.Status, statusBadgeVariant(data.Session.Status), htmxui.BadgeSizeMD, true, nil)
						</dd>
					</div>
					<div class="md:col-span-2">
						<dt class="text-sm font-medium text-base-content/60">Available</dt>
						<dd class="mt-1">
							if data.Session.Status == "running" {
								<span class="badge badge-success badge-soft">Yes (Ready for connections)</span>
							} else if data.Session.Status == "starting" || data.Session.Status == "pending" {
								<span class="badge badge-warning badge-soft">Starting (Wait for it to be ready)</span>
							} else {
								<span class="badge badge-error badge-soft">No (Server is not running)</span>
							}
						</dd>
					</div>
					if data.Game != nil {
						<div>
							<dt class="text-sm font-medium text-base-content/60">Game</dt>
							<dd class="mt-1 text-sm">
								<a href={ templ.URL(fmt.Sprintf("/games/%d", data.Game.GameId)) } class="link link-primary">{ data.Game.Name }</a>
							</dd>
						</div>
					}
					if data.GameConfig != nil {
						<div>
							<dt class="text-sm font-medium text-base-content/60">GameConfig</dt>
							<dd class="mt-1 text-sm">
								<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", data.GameConfig.GameId, data.GameConfig.ConfigId)) } class="link link-primary">{ data.GameConfig.Name }</a>
								<small class="text-base-content/60 ml-1">({ data.GameConfig.Image })</small>
							</dd>
						</div>
					}
					if data.SGC != nil {
						<div>
							<dt class="text-sm font-medium text-base-content/60">Server Game Config</dt>
							<dd class="mt-1 text-sm">
								<a href={ templ.URL(fmt.Sprintf("/sgc/%d", data.SGC.ServerGameConfigId)) } class="link link-primary">SGC #{ fmt.Sprintf("%d", data.SGC.ServerGameConfigId) }</a>
								<small class="text-base-content/60 ml-1">(Server #{ fmt.Sprintf("%d", data.SGC.ServerId) })</small>
							</dd>
						</div>
					}
					@components.DLItem("Started", fmt.Sprintf("%s (%s)", timeAgo(data.Session.StartedAt), formatTime(data.Session.StartedAt)))
					if data.Session.EndedAt > 0 {
						@components.DLItem("Ended", fmt.Sprintf("%s (%s)", timeAgo(data.Session.EndedAt), formatTime(data.Session.EndedAt)))
					}
					@components.DLItem("Exit Code", fmt.Sprintf("%d", data.Session.ExitCode))
				</dl>
			</div>
		</div>
		// Live/Historical Logs
		if data.Session.Status == "running" {
			// Live Logs
			<div class="card bg-base-100 border border-base-300 shadow-sm mb-6 overflow-hidden">
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 border-b border-base-300 bg-base-200">
					<h2 class="text-lg font-semibold text-base-content">Live Logs</h2>
					<div class="flex flex-wrap items-center gap-2">
						<button id="toggle-logs" class="btn btn-neutral btn-sm">Hide</button>
						<button id="clear-logs" class="btn btn-neutral btn-sm">Clear</button>
						<span id="log-status" class="text-sm text-base-content/60">Connecting...</span>
					</div>
				</div>
				<div id="log-viewer" class="log-viewer-container">
					<pre id="log-output" class="log-viewer-output"></pre>
				</div>
				<div class="border-t border-base-300">
					<form id="stdin-form" class="flex gap-2 p-3 bg-neutral">
						<input type="text" id="stdin-input" placeholder="Send command to server..." class="input input-bordered flex-1 bg-neutral text-neutral-content font-mono text-sm"/>
						<button type="submit" id="stdin-submit" class="btn btn-primary min-w-[80px]">Send</button>
					</form>
					<div id="stdin-status" class="px-3 pb-2 text-xs text-neutral-content/60 min-h-[1.5rem] bg-neutral"></div>
				</div>
			</div>
			<div id="live-logs-script" data-session-id={ fmt.Sprintf("%d", data.Session.SessionId) }></div>
			<script type="text/javascript">
				(function() {
					const sessionId = parseInt(document.getElementById('live-logs-script').dataset.sessionId);
					const logOutput = document.getElementById('log-output');
					const logStatus = document.getElementById('log-status');
					const logViewer = document.getElementById('log-viewer');
					const toggleBtn = document.getElementById('toggle-logs');
					const clearBtn = document.getElementById('clear-logs');
					let autoScroll = true;
					let evtSource = null;
					let lastSequenceNumber = 0;

					function appendLogLine(container, timestamp, source, message) {
						const line = document.createElement('span');
						line.className = 'log-line log-' + source;
						line.textContent = '[' + timestamp + '] [' + source + '] ' + message;
						container.appendChild(line);
						container.appendChild(document.createTextNode('\n'));
					}

					function connect() {
						const url = lastSequenceNumber > 0
							? '/sessions/' + sessionId + '/logs/stream?after_sequence_number=' + lastSequenceNumber
							: '/sessions/' + sessionId + '/logs/stream';
						evtSource = new EventSource(url);
						evtSource.onopen = () => {
							logStatus.textContent = '● Connected';
							logStatus.style.color = '#4fc1ff';
						};
						evtSource.onmessage = (event) => {
							const d = JSON.parse(event.data);
							if (d.type === 'connected') return;
							if (d.sequence_number) lastSequenceNumber = d.sequence_number;
							const date = new Date(d.timestamp);
							const time = date.toLocaleTimeString('en-US', { hour12: false });
							appendLogLine(logOutput, time, d.source, d.message);
							if (autoScroll) {
								logOutput.scrollTop = logOutput.scrollHeight;
							}
							const lines = logOutput.children;
							if (lines.length > 1000) {
								logOutput.removeChild(lines[0]);
							}
						};
						evtSource.onerror = () => {
							logStatus.textContent = '● Disconnected';
							logStatus.style.color = '#f48771';
							evtSource.close();
							setTimeout(connect, 2000);
						};
					}

					toggleBtn.onclick = () => {
						logViewer.classList.toggle('collapsed');
						toggleBtn.textContent = logViewer.classList.contains('collapsed') ? 'Show' : 'Hide';
					};
					clearBtn.onclick = () => { logOutput.textContent = ''; };
					logOutput.onscroll = () => {
						const atBottom = logOutput.scrollHeight - logOutput.clientHeight <= logOutput.scrollTop + 50;
						autoScroll = atBottom;
					};
					connect();
					window.addEventListener('beforeunload', () => { if (evtSource) evtSource.close(); });

					const stdinForm = document.getElementById('stdin-form');
					const stdinInput = document.getElementById('stdin-input');
					const stdinSubmit = document.getElementById('stdin-submit');
					const stdinStatus = document.getElementById('stdin-status');
					stdinForm.onsubmit = async (e) => {
						e.preventDefault();
						const input = stdinInput.value;
						if (!input.trim()) return;
						stdinInput.disabled = true;
						stdinSubmit.disabled = true;
						stdinStatus.textContent = 'Sending...';
						stdinStatus.style.color = '#4fc1ff';
						try {
							const response = await fetch('/api/sessions/' + sessionId + '/stdin', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ input: input }),
								signal: AbortSignal.timeout(10000)
							});
							if (!response.ok) throw new Error('HTTP ' + response.status + ': ' + await response.text());
							stdinInput.value = '';
							stdinStatus.textContent = '✓ Sent';
							stdinStatus.style.color = '#4fc1ff';
							setTimeout(() => { stdinStatus.textContent = ''; }, 2000);
						} catch (err) {
							stdinStatus.textContent = '✗ Error: ' + err.message;
							stdinStatus.style.color = '#f48771';
						} finally {
							stdinInput.disabled = false;
							stdinSubmit.disabled = false;
							stdinInput.focus();
						}
					};
				})();
			</script>
		} else {
			// Historical Logs
			@components.LogHistogram(components.LogHistogramData{SessionID: data.Session.SessionId})
		}
		<!-- Actions -->
		if len(data.Actions) > 0 {
			<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
				<div class="flex justify-between items-center p-4 border-b border-base-300">
					<h2 class="text-lg font-semibold text-base-content">Available Actions</h2>
				</div>
				<div class="card-body">
					<div id="action-status" class="mb-4"></div>
					for _, action := range data.Actions {
						<div class="mb-6 pb-6 border-b border-base-300 last:border-0">
							if action.GroupName != "" {
								<h4 class="text-sm font-semibold text-base-content/60 uppercase mb-2">{ action.GroupName }</h4>
							}
							if action.Description != "" {
								<p class="text-sm text-base-content/60 mb-3">{ action.Description }</p>
							}
							if len(action.InputFields) == 0 {
								<!-- Simple button (no inputs) -->
								@htmxui.Button(actionButtonVariant(action.ButtonStyle), htmxui.ButtonSizeMD, false, actionExecuteAttrs(data.Session.SessionId, action)) {
									{ action.Label }
								}
							} else {
								<!-- Parameterized button (with inputs) -->
								<form
									hx-post={ fmt.Sprintf("/sessions/%d/actions/execute", data.Session.SessionId) }
									hx-target="#action-status"
									hx-swap="innerHTML"
									class="flex flex-col gap-3 max-w-lg"
								>
									<input type="hidden" name="action_id" value={ fmt.Sprintf("%d", action.ActionId) }/>
									for _, field := range action.InputFields {
										<div class="form-control">
											<label class="label">
												<span class="label-text">
													{ field.Label }
													if field.Required {
														<span class="text-error">*</span>
													}
												</span>
											</label>
											if field.FieldType == "select" {
												<select
													name={ field.Name }
													required?={ field.Required }
													class="select select-bordered w-full"
												>
													for _, opt := range field.Options {
														<option value={ opt.Value } selected?={ opt.IsDefault }>{ opt.Label }</option>
													}
												</select>
											} else if field.FieldType == "textarea" {
												<textarea
													name={ field.Name }
													placeholder={ field.Placeholder }
													required?={ field.Required }
													class="textarea textarea-bordered w-full min-h-[80px]"
												></textarea>
											} else if field.FieldType == "number" {
												<input
													type="number"
													name={ field.Name }
													placeholder={ field.Placeholder }
													required?={ field.Required }
													if field.MinValue != 0 {
														min={ fmt.Sprintf("%f", field.MinValue) }
													}
													if field.MaxValue != 0 {
														max={ fmt.Sprintf("%f", field.MaxValue) }
													}
													class="input input-bordered w-full"
												/>
											} else {
												<input
													type={ field.FieldType }
													name={ field.Name }
													placeholder={ field.Placeholder }
													required?={ field.Required }
													if field.Pattern != "" {
														pattern={ field.Pattern }
													}
													if field.MinLength != 0 {
														minlength={ fmt.Sprintf("%d", field.MinLength) }
													}
													if field.MaxLength != 0 {
														maxlength={ fmt.Sprintf("%d", field.MaxLength) }
													}
													class="input input-bordered w-full"
												/>
											}
											if field.HelpText != "" {
												<small class="block mt-1 text-sm text-base-content/60">{ field.HelpText }</small>
											}
										</div>
									}
									@htmxui.Button(actionButtonVariant(action.ButtonStyle), htmxui.ButtonSizeMD, false, actionSubmitAttrs(action)) {
										{ action.Label }
									}
								</form>
							}
						</div>
					}
				</div>
			</div>
		}
		<!-- Workshop Installations -->
		if len(data.Installations) > 0 {
			<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
				<div class="flex justify-between items-center p-4 border-b border-base-300">
					<h2 class="text-lg font-semibold text-base-content">Workshop Addons</h2>
				</div>
				if data.Session.Status == "pending" || data.Session.Status == "starting" {
					<div role="alert" class="alert alert-warning m-4">
						<span class="text-sm">Installing addons before launch...</span>
					</div>
				}
				<div class="overflow-x-auto">
					<table class="table">
						<thead>
							<tr>
								<th>Addon ID</th>
								<th>Status</th>
								<th>Progress</th>
								<th>Path</th>
							</tr>
						</thead>
						<tbody>
							for _, inst := range data.Installations {
								<tr class="hover">
									<td class="text-sm">
										<a href={ templ.URL(fmt.Sprintf("/workshop/addon?addon_id=%d", inst.AddonId)) } class="link link-primary">{ fmt.Sprintf("%d", inst.AddonId) }</a>
									</td>
									<td>
										@htmxui.Badge(inst.Status, statusBadgeVariant(inst.Status), htmxui.BadgeSizeSM, true, nil)
									</td>
									<td class="text-sm">
										if inst.Status == "downloading" {
											{ fmt.Sprintf("%d%%", inst.ProgressPercent) }
										} else {
											—
										}
									</td>
									<td class="text-xs font-mono">{ inst.InstallationPath }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		} else if len(data.Libraries) > 0 {
			<div class="card bg-base-100 border border-base-300 shadow-sm p-12 text-center mb-6">
				<p class="text-base-content/60">Libraries attached but no addons installed yet.</p>
			</div>
		}
	}
}
