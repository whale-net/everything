package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

templ Servers(layout components.LayoutData, servers []*manmanpb.Server) {
	@components.Layout(layout) {
		@components.HeroHeader("Servers", "Servers self-register via the host manager and appear here automatically when online")
		<div role="alert" class="alert alert-info mb-6">
			<p class="text-sm">
				<a href="/games" class="link link-primary font-medium">Configure game deployments</a>
				<span> to run on these servers.</span>
			</p>
		</div>
		if len(servers) > 0 {
			@components.Table() {
				<thead>
					<tr>
						<th>Name</th>
						<th>Status</th>
						<th>Environment</th>
						<th>Last Seen</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, server := range servers {
						<tr class="hover">
							<td>
								<a href={ templ.URL(fmt.Sprintf("/servers/%d", server.ServerId)) } class="link link-primary text-sm font-medium">
									{ server.Name }
								</a>
							</td>
							<td>
								@htmxui.Badge(server.Status, statusBadgeVariant(serverStatusVariant(server.Status)), htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">
								if server.Environment != "" {
									{ server.Environment }
								} else {
									-
								}
							</td>
							<td class="text-sm">{ timeAgo(server.LastSeen) }</td>
							<td class="text-right text-sm font-medium">
								<a href={ templ.URL(fmt.Sprintf("/servers/%d", server.ServerId)) } class="btn btn-primary btn-sm">View</a>
							</td>
						</tr>
					}
				</tbody>
			}
		} else {
			@components.EmptyState(
				"No servers found",
				"Servers will appear here when they register with the control plane. To add a server, run the host manager on your server hardware with the control API URL configured.",
				"",
				"",
			)
		}
	}
}

func serverStatusVariant(status string) string {
	switch status {
	case "online":
		return "success"
	case "offline":
		return "secondary"
	default:
		return "secondary"
	}
}
