package pages

import (
	"fmt"
	"strings"
	"github.com/whale-net/everything/manmanv2/ui/components"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
)

type GameDetailPageData struct {
	Layout      components.LayoutData
	Game        *manmanpb.Game
	PathPresets []*manmanpb.GameAddonPathPreset
	Volumes     []*manmanpb.GameConfigVolume
	Configs     []*manmanpb.GameConfig
	SgcCounts   map[int64]int
}

func metadataValue(game *manmanpb.Game, field string) string {
	if game.Metadata == nil {
		return ""
	}
	switch field {
	case "genre":
		return game.Metadata.Genre
	case "publisher":
		return game.Metadata.Publisher
	}
	return ""
}

func metadataTags(game *manmanpb.Game) string {
	if game.Metadata == nil || len(game.Metadata.Tags) == 0 {
		return ""
	}
	return strings.Join(game.Metadata.Tags, ", ")
}

templ GameDetail(data GameDetailPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
			<div>
				<div class="flex items-center gap-2 mb-2">
					<span class="badge badge-primary badge-soft">
						🎮 GAME
					</span>
				</div>
				<h1 class="text-3xl font-bold text-base-content">{ data.Game.Name }</h1>
			</div>
			<div class="flex flex-wrap gap-2">
				<a href={ templ.URL(fmt.Sprintf("/games/%d/actions", data.Game.GameId)) } class="btn btn-primary btn-sm">
					⚡ Manage Actions
				</a>
				<button onclick="document.getElementById('edit-form').classList.remove('hidden')" class="btn btn-secondary btn-sm">
					Edit
				</button>
			</div>
		</div>
		<div class="card bg-base-100 border border-base-300 shadow-sm p-6 mb-6">
			<h2 class="text-lg font-semibold text-base-content mb-4">Game Information</h2>
			<dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
				@components.DLItem("Game ID", fmt.Sprintf("%d", data.Game.GameId))
				@components.DLItem("Name", data.Game.Name)
				@components.DLItem("Steam App ID", func() string {
					if data.Game.SteamAppId != "" {
						return data.Game.SteamAppId
					}
					return "-"
				}())
				if data.Game.Metadata != nil {
					@components.DLItem("Genre", func() string {
						if data.Game.Metadata.Genre != "" {
							return data.Game.Metadata.Genre
						}
						return "-"
					}())
					@components.DLItem("Publisher", func() string {
						if data.Game.Metadata.Publisher != "" {
							return data.Game.Metadata.Publisher
						}
						return "-"
					}())
					<div>
						<dt class="text-sm font-medium text-base-content/60">Tags</dt>
						<dd class="mt-1 flex flex-wrap gap-1">
							if len(data.Game.Metadata.Tags) > 0 {
								for _, tag := range data.Game.Metadata.Tags {
									<span class="badge badge-neutral badge-soft badge-sm">{ tag }</span>
								}
							} else {
								<span class="text-sm text-base-content">-</span>
							}
						</dd>
					</div>
				}
			</dl>
		</div>
		<!-- Edit form -->
		<div id="edit-form" class="hidden mb-6">
			<div class="card bg-base-100 border border-base-300 shadow-sm p-6">
				<h2 class="text-lg font-semibold text-base-content mb-4">Edit Game</h2>
				<form hx-post={ fmt.Sprintf("/games/%d/edit", data.Game.GameId) } hx-swap="none" class="space-y-4">
					<div>
						<label for="name" class="block text-sm font-medium text-base-content mb-2">Name *</label>
						<input type="text" id="name" name="name" value={ data.Game.Name } required class="input input-bordered w-full"/>
					</div>
					<div>
						<label for="steam_app_id" class="block text-sm font-medium text-base-content mb-2">Steam App ID</label>
						<input type="text" id="steam_app_id" name="steam_app_id" value={ data.Game.SteamAppId } class="input input-bordered w-full"/>
					</div>
					<div>
						<label for="genre" class="block text-sm font-medium text-base-content mb-2">Genre</label>
						<input type="text" id="genre" name="genre" value={ metadataValue(data.Game, "genre") } class="input input-bordered w-full"/>
					</div>
					<div>
						<label for="publisher" class="block text-sm font-medium text-base-content mb-2">Publisher</label>
						<input type="text" id="publisher" name="publisher" value={ metadataValue(data.Game, "publisher") } class="input input-bordered w-full"/>
					</div>
					<div>
						<label for="tags" class="block text-sm font-medium text-base-content mb-2">Tags (comma-separated)</label>
						<input type="text" id="tags" name="tags" value={ metadataTags(data.Game) } class="input input-bordered w-full"/>
					</div>
					<div class="flex gap-3 pt-2">
						<button type="submit" class="btn btn-success">Save Changes</button>
						<button type="button" onclick="document.getElementById('edit-form').classList.add('hidden')" class="btn btn-secondary">Cancel</button>
					</div>
				</form>
			</div>
		</div>
		<!-- Path Presets -->
		<div x-data="{ expanded: false }" class="card bg-base-100 border border-base-300 shadow-sm mb-6 overflow-hidden">
			<button @click="expanded = !expanded" class="w-full flex justify-between items-center p-4 border-b border-base-300 hover:bg-base-200 transition-colors">
				<div class="flex items-center gap-3">
					<h2 class="text-lg font-semibold text-base-content">Addon Path Presets</h2>
					<span class="text-sm text-base-content/60">({ fmt.Sprintf("%d presets", len(data.PathPresets)) })</span>
				</div>
				<svg :class="expanded ? 'rotate-180' : ''" class="w-5 h-5 text-base-content/60 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
				</svg>
			</button>
			<div x-show="expanded" x-cloak x-collapse>
				if len(data.PathPresets) > 0 {
					<div class="overflow-x-auto">
						<table class="table">
							<thead class="bg-base-200">
								<tr>
									<th scope="col">Name</th>
									<th scope="col">Volume</th>
									<th scope="col">Installation Path</th>
									<th scope="col" class="text-right">Actions</th>
								</tr>
							</thead>
							<tbody>
								for _, preset := range data.PathPresets {
									<tr class="hover">
										<td>
											<div class="text-sm font-medium text-base-content">{ preset.Name }</div>
											if preset.Description != "" {
												<div class="text-xs text-base-content/60 mt-1">{ preset.Description }</div>
											}
										</td>
										<td class="text-sm text-base-content"><em>(relative path)</em></td>
										<td class="text-sm font-mono text-base-content">{ preset.InstallationPath }</td>
										<td class="text-right">
											<form method="POST" action={ templ.URL(fmt.Sprintf("/games/%d/presets/%d/delete", data.Game.GameId, preset.PresetId)) } class="inline">
												<button type="submit" onclick="return confirm('Delete this preset?')" class="btn btn-error btn-sm">Delete</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					<div class="p-12 text-center">
						<p class="text-base-content/60">No path presets defined. Add a preset to make addon installation easier.</p>
					</div>
				}
				<div class="p-4 border-t border-base-300">
					<button onclick="document.getElementById('add-preset-form').classList.remove('hidden')" class="btn btn-primary btn-sm">+ Add Preset</button>
				</div>
			</div>
		</div>
		<!-- Add Preset Form -->
		<div id="add-preset-form" class="hidden mb-6">
			<div class="card bg-base-100 border border-base-300 shadow-sm p-6">
				<h2 class="text-lg font-semibold text-base-content mb-4">Add Path Preset</h2>
				<form method="POST" action={ templ.URL(fmt.Sprintf("/games/%d/presets/create", data.Game.GameId)) } class="space-y-4">
					<input type="hidden" name="game_id" value={ fmt.Sprintf("%d", data.Game.GameId) }/>
					<div>
						<label for="preset_name" class="block text-sm font-medium text-base-content mb-2">Name *</label>
						<input type="text" id="preset_name" name="name" required placeholder="e.g., Maps, Plugins, Skins" class="input input-bordered w-full"/>
						<p class="text-xs text-base-content/60 mt-1">Short label for this preset</p>
					</div>
					<div>
						<label for="preset_description" class="block text-sm font-medium text-base-content mb-2">Description</label>
						<textarea id="preset_description" name="description" rows="2" placeholder="Optional description" class="textarea textarea-bordered w-full"></textarea>
					</div>
					<div>
						<label for="preset_volume_id" class="block text-sm font-medium text-base-content mb-2">Volume (Optional)</label>
						<select id="preset_volume_id" name="volume_id" class="select select-bordered w-full">
							<option value="">-- Use first volume (default) --</option>
							for _, vol := range data.Volumes {
								<option value={ fmt.Sprintf("%d", vol.VolumeId) }>{ vol.Name } ({ vol.ContainerPath })</option>
							}
						</select>
						<p class="text-xs text-base-content/60 mt-1">Select which volume addons using this preset should install to</p>
					</div>
					<div>
						<label for="preset_installation_path" class="block text-sm font-medium text-base-content mb-2">Installation Path *</label>
						<input type="text" id="preset_installation_path" name="installation_path" required placeholder="e.g., left4dead2/maps/" class="input input-bordered w-full"/>
						<p class="text-xs text-base-content/60 mt-1">Relative path within the volume</p>
					</div>
					<div class="flex gap-3 pt-2">
						<button type="submit" class="btn btn-success">Add Preset</button>
						<button type="button" onclick="document.getElementById('add-preset-form').classList.add('hidden')" class="btn btn-secondary">Cancel</button>
					</div>
				</form>
			</div>
		</div>
		<!-- Configs -->
		<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 border-b border-base-300">
				<h2 class="text-lg font-semibold text-base-content">Game Configurations</h2>
				<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/new", data.Game.GameId)) } class="btn btn-primary btn-sm">Create Config</a>
			</div>
			if len(data.Configs) > 0 {
				<div class="overflow-x-auto">
					<table class="table">
						<thead class="bg-base-200">
							<tr>
								<th scope="col">Name</th>
								<th scope="col">Docker Image</th>
								<th scope="col">SGCs</th>
								<th scope="col" class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, config := range data.Configs {
								<tr class="hover">
									<td>
										<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", data.Game.GameId, config.ConfigId)) } class="text-sm font-medium link link-primary">{ config.Name }</a>
									</td>
									<td class="text-sm font-mono text-base-content">{ config.Image }</td>
									<td class="text-sm text-base-content">{ fmt.Sprintf("%d", data.SgcCounts[config.ConfigId]) }</td>
									<td class="text-right">
										<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", data.Game.GameId, config.ConfigId)) } class="btn btn-primary btn-sm">View</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<div class="p-12 text-center">
					<p class="text-base-content/60">No configurations yet. Create a configuration to deploy this game.</p>
				</div>
			}
		</div>
		<!-- Danger Zone: chrome only restyled onto htmxui.Confirm's ZoneTitle visual
			language; the existing Alpine click-to-reveal gate is kept as-is (FR7),
			see sgc_detail.templ's Danger Zone comment for the full rationale. -->
		<div x-data="{ confirmDelete: false }" class="card bg-base-100 border-2 border-error/40 shadow-md overflow-hidden mt-6">
			<div class="bg-error/10 px-6 py-4 border-b-2 border-error/40">
				<h2 class="text-lg font-semibold text-error">⚠️ Danger Zone</h2>
			</div>
			<div class="card-body">
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
					<div>
						<h3 class="text-sm font-semibold text-base-content mb-1">Delete this game</h3>
						<p class="text-sm text-base-content/60">Once deleted, all configurations and deployments will be removed. This action cannot be undone.</p>
					</div>
					<div class="flex-shrink-0">
						<button x-show="!confirmDelete" @click="confirmDelete = true" class="btn btn-error">Delete Game</button>
						<div x-show="confirmDelete" x-cloak class="flex gap-2 items-center">
							<span class="text-sm text-error font-medium">Are you sure?</span>
							<form method="POST" action={ templ.URL(fmt.Sprintf("/games/%d/delete", data.Game.GameId)) } class="inline">
								<button type="submit" class="btn btn-error">Yes, Delete</button>
							</form>
							<button @click="confirmDelete = false" class="btn btn-secondary">Cancel</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
