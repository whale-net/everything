package pages

import (
	"fmt"
	"strings"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

type GameOverviewData struct {
	GameID      int64
	Deployments []GameDeploymentOverview
	ActionError string
}

type GameDeploymentOverview struct {
	SGCID         int64
	ServerID      int64
	ServerName    string
	ConfigID      int64
	ConfigName    string
	DisplayName   string
	Status        string
	StatusVariant string
	Uptime        string
	Connect       components.ConnectAddressView
	CanStart      bool
	CanStop       bool
	CanRestart    bool
	IsTransient   bool
	LogsURL       string
	// ActionsURL links out to the config-level Actions management page
	// (console commands), same URL shape buildGameDeploymentRow computes --
	// also backs this deployment's Customize control (deployment settings
	// blade), folded in here so both /games (list) and /games/{id}
	// (detail) get them for free from this one shared component.
	ActionsURL string
}

type GameDetailPageData struct {
	Layout        components.LayoutData
	Game          *manmanpb.Game
	IsAdmin       bool
	ActiveTab     string
	RunState      components.DeploymentStatus
	Connect       components.ConnectAddressView
	Deployments   []GameDeploymentRow
	LatestSession *manmanpb.Session
	LiveSession   *manmanpb.Session
	Sessions      []*manmanpb.Session
	Actions       []*manmanpb.ActionDefinition
	PathPresets   []*manmanpb.GameAddonPathPreset
	Volumes       []*manmanpb.GameConfigVolume
	Configs       []*manmanpb.GameConfig
	SgcCounts     map[int64]int
	Overview      GameOverviewData
}

func metadataValue(game *manmanpb.Game, field string) string {
	if game.Metadata == nil {
		return ""
	}
	switch field {
	case "genre":
		return game.Metadata.Genre
	case "publisher":
		return game.Metadata.Publisher
	}
	return ""
}

func metadataTags(game *manmanpb.Game) string {
	if game.Metadata == nil || len(game.Metadata.Tags) == 0 {
		return ""
	}
	return strings.Join(game.Metadata.Tags, ", ")
}

// dailyOpsOverviewID is the ops panel's DOM id, scoped per game so the
// panel can render safely either once (the detail page) or many times on
// one page (the games list, one collapsed row per game): "#daily-ops-
// overview" alone would collide across rows.
func dailyOpsOverviewID(gameID int64) string {
	return fmt.Sprintf("daily-ops-overview-%d", gameID)
}

func overviewPollAttrs(data GameOverviewData) templ.Attributes {
	for _, dep := range data.Deployments {
		if dep.IsTransient {
			return templ.Attributes{
				"hx-get":     fmt.Sprintf("/games/%d/overview", data.GameID),
				"hx-trigger": "every 3s",
				"hx-target":  "#" + dailyOpsOverviewID(data.GameID),
				"hx-swap":    "outerHTML",
			}
		}
	}
	return templ.Attributes{}
}

templ overviewStatusBadge(status string) {
	switch status {
	case "Online":
		<span class="badge badge-success badge-lg font-bold gap-2 px-3 py-3 text-success-content shadow-sm">
			<span class="w-2.5 h-2.5 rounded-full bg-current animate-pulse"></span> ONLINE
		</span>
	case "Restarting":
		<span class="badge badge-info badge-lg font-bold gap-2 px-3 py-3 text-info-content shadow-sm">
			<span class="loading loading-spinner loading-xs"></span> RESTARTING
		</span>
	case "Error":
		<span class="badge badge-error badge-lg font-bold gap-2 px-3 py-3 text-error-content shadow-sm">
			<span class="w-2.5 h-2.5 rounded-full bg-current"></span> ERROR
		</span>
	default:
		<span class="badge badge-neutral badge-lg font-bold gap-2 px-3 py-3 text-neutral-content">
			<span class="w-2.5 h-2.5 rounded-full bg-base-content/40"></span> OFFLINE
		</span>
	}
}

templ overviewEmptyState(gameID int64) {
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
		<div class="bg-base-200/40 rounded-box p-4 border border-base-300">
			<div class="text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-1">Runtime / Uptime</div>
			<div class="text-3xl font-bold font-mono text-base-content">—</div>
			<div class="text-xs text-base-content/50 mt-2">Server is not deployed yet</div>
		</div>
		<div class="bg-base-200/40 rounded-box p-4 border border-base-300">
			<div class="text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-1">Connection Info</div>
			<div class="mt-2 text-sm text-base-content/60">Connect address unavailable — no active deployment for this game.</div>
		</div>
	</div>
	<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-4 border-t border-base-300">
		<div class="flex flex-wrap items-center gap-3">
			<button type="button" disabled class="btn btn-disabled btn-md opacity-50 cursor-not-allowed">Start</button>
			<button type="button" disabled class="btn btn-disabled btn-md opacity-50 cursor-not-allowed">Stop</button>
			<button type="button" disabled class="btn btn-disabled btn-md opacity-50 cursor-not-allowed">Restart</button>
		</div>
		<div>
			<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/new", gameID)) } class="btn btn-primary btn-md gap-2 font-semibold">
				+ Create Config to Deploy
			</a>
		</div>
	</div>
}

templ overviewDeploymentContent(gameID int64, dep GameDeploymentOverview) {
	<!-- Stats: Runtime & Connection Info -->
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
		<div class="bg-base-200/40 rounded-box p-4 border border-base-300 flex flex-col justify-between">
			<div>
				<div class="text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-1">Runtime / Uptime</div>
				<div class="text-3xl font-bold font-mono text-base-content">{ dep.Uptime }</div>
			</div>
			<div class="text-xs text-base-content/50 mt-2">
				if dep.Status == "Online" {
					Server is active and accepting connections
				} else if dep.Status == "Restarting" {
					Server is transitioning state
				} else if dep.Status == "Error" {
					Server encountered an error or crashed
				} else {
					Server is currently offline
				}
			</div>
		</div>

		<div class="bg-base-200/40 rounded-box p-4 border border-base-300 flex flex-col justify-between">
			<div>
				<div class="text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-1">Connection Info</div>
				<!--
					AC4: this id is the stable target a successful ports
					Save (handleDeploymentSettingsPortsSave) swaps out of
					band via DeploymentConnectAddressOOB, so the recomputed
					connect address shows up here without re-fetching
					anything else on the page (FR10).
				-->
				<div id={ DeploymentConnectAddressID(dep.SGCID) } class="mt-2">
					@components.ConnectAddressDisplay(dep.Connect)
				</div>
			</div>
			<div class="text-xs text-base-content/50 mt-2">Formatted host and port for players to join</div>
		</div>
	</div>

	<!-- Primary Action Bar and One-Click Diagnostics -->
	<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-4 border-t border-base-300">
		<div class="flex flex-wrap items-center gap-3" x-data="{ confirmStop: false, confirmRestart: false }">
			<!-- Start button -->
			if dep.CanStart {
				<form
					method="POST"
					action={ templ.URL(fmt.Sprintf("/games/%d/overview/action", gameID)) }
					hx-post={ fmt.Sprintf("/games/%d/overview/action", gameID) }
					hx-target={ "#" + dailyOpsOverviewID(gameID) }
					hx-swap="outerHTML"
					class="inline"
				>
					<input type="hidden" name="sgc_id" value={ fmt.Sprintf("%d", dep.SGCID) }/>
					<input type="hidden" name="action" value="start"/>
					<button type="submit" class="btn btn-success btn-md font-semibold gap-2">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
						</svg>
						Start
					</button>
				</form>
			} else {
				<button type="button" disabled class="btn btn-disabled btn-md opacity-50 cursor-not-allowed gap-2">
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
					</svg>
					Start
				</button>
			}

			<!-- Stop button -->
			if dep.CanStop {
				<div class="inline-flex">
					<button
						type="button"
						x-show="!confirmStop"
						@click="confirmStop = true"
						class="btn btn-error btn-md font-semibold gap-2"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8 7a1 1 0 00-1 1v4a1 1 0 001 1h4a1 1 0 001-1V8a1 1 0 00-1-1H8z" clip-rule="evenodd"></path>
						</svg>
						Stop
					</button>
					<div x-show="confirmStop" x-cloak class="flex gap-2 items-center">
						<span class="text-sm font-semibold text-error">Stop now?</span>
						<form
							method="POST"
							action={ templ.URL(fmt.Sprintf("/games/%d/overview/action", gameID)) }
							hx-post={ fmt.Sprintf("/games/%d/overview/action", gameID) }
							hx-target={ "#" + dailyOpsOverviewID(gameID) }
							hx-swap="outerHTML"
							class="inline"
						>
							<input type="hidden" name="sgc_id" value={ fmt.Sprintf("%d", dep.SGCID) }/>
							<input type="hidden" name="action" value="stop"/>
							<button type="submit" class="btn btn-error btn-md font-semibold">Yes, Stop</button>
						</form>
						<button type="button" @click="confirmStop = false" class="btn btn-ghost btn-md">Cancel</button>
					</div>
				</div>
			} else {
				<button type="button" disabled class="btn btn-disabled btn-md opacity-50 cursor-not-allowed gap-2">
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8 7a1 1 0 00-1 1v4a1 1 0 001 1h4a1 1 0 001-1V8a1 1 0 00-1-1H8z" clip-rule="evenodd"></path>
					</svg>
					Stop
				</button>
			}

			<!-- Restart button -->
			if dep.CanRestart {
				<div class="inline-flex">
					<button
						type="button"
						x-show="!confirmRestart"
						@click="confirmRestart = true"
						class="btn btn-info btn-md font-semibold gap-2"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
						Restart
					</button>
					<div x-show="confirmRestart" x-cloak class="flex gap-2 items-center">
						<span class="text-sm font-semibold text-info">Restart now?</span>
						<form
							method="POST"
							action={ templ.URL(fmt.Sprintf("/games/%d/overview/action", gameID)) }
							hx-post={ fmt.Sprintf("/games/%d/overview/action", gameID) }
							hx-target={ "#" + dailyOpsOverviewID(gameID) }
							hx-swap="outerHTML"
							class="inline"
						>
							<input type="hidden" name="sgc_id" value={ fmt.Sprintf("%d", dep.SGCID) }/>
							<input type="hidden" name="action" value="restart"/>
							<button type="submit" class="btn btn-info btn-md font-semibold">Yes, Restart</button>
						</form>
						<button type="button" @click="confirmRestart = false" class="btn btn-ghost btn-md">Cancel</button>
					</div>
				</div>
			} else {
				<button type="button" disabled class="btn btn-disabled btn-md opacity-50 cursor-not-allowed gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
					Restart
				</button>
			}
		</div>

		<!-- One-Click Diagnostics -->
		<div>
			if dep.LogsURL != "" {
				<a
					href={ templ.URL(dep.LogsURL) }
					class="btn btn-outline btn-primary btn-md gap-2 font-semibold w-full sm:w-auto"
					title="Open live session console and log stream"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					View Live Output / Logs
				</a>
			} else {
				<button
					type="button"
					disabled
					class="btn btn-disabled btn-md opacity-50 cursor-not-allowed gap-2 w-full sm:w-auto"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					No Logs Available
				</button>
			}
		</div>

		<!--
			Console Commands + Customize (folded in from the Games list
			row's former Deployments section, games.templ's retired
			gameDeploymentRow): this component is shared by /games (one
			panel per row) and /games/{id} (one panel total), so both
			surfaces keep these controls reachable for free.
		-->
		<div class="flex flex-wrap items-center gap-3">
			if dep.ActionsURL != "" {
				<a href={ templ.URL(dep.ActionsURL) } class="link link-primary text-sm" title="Configure custom console commands">Console Commands</a>
			}
			<button
				type="button"
				data-open-blade-template={ fmt.Sprintf("deployment-settings-blade-template-%d", dep.SGCID) }
				class="btn btn-outline btn-sm"
			>
				Customize
			</button>
		</div>
	</div>

	<template id={ fmt.Sprintf("deployment-settings-blade-template-%d", dep.SGCID) }>
		@components.Blade(components.BladeData{
			ID:       fmt.Sprintf("deployment-settings-blade-%d", dep.SGCID),
			Title:    "Deployment Settings",
			Subtitle: dep.DisplayName,
		}) {
			@DeploymentSettingsEnvPlaceholder(dep.SGCID)
			@DeploymentSettingsPortsPlaceholder(dep.SGCID)
		}
	</template>
}

templ GameOverview(data GameOverviewData) {
	<div
		id={ dailyOpsOverviewID(data.GameID) }
		class="card bg-base-100 border border-base-300 shadow-sm p-6 mb-6"
		{ overviewPollAttrs(data)... }
	>
		<div class="flex flex-col gap-6">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-base-300 pb-4">
				<div>
					<div class="flex items-center gap-2">
						<span class="text-xl">⚡</span>
						<h2 class="text-xl font-bold text-base-content">Daily Ops Overview</h2>
					</div>
					<p class="text-xs text-base-content/60 mt-1">Core server status, runtime, and one-click operational controls</p>
				</div>
				if len(data.Deployments) == 0 {
					<div>
						<span class="badge badge-neutral badge-lg font-bold gap-2 px-3 py-3 text-neutral-content">
							<span class="w-2.5 h-2.5 rounded-full bg-base-content/40"></span> OFFLINE
						</span>
					</div>
				} else if len(data.Deployments) == 1 {
					<div>
						@overviewStatusBadge(data.Deployments[0].Status)
					</div>
				}
			</div>

			if data.ActionError != "" {
				<div role="alert" class="alert alert-error alert-sm">
					<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
					</svg>
					<span class="text-sm font-medium">{ data.ActionError }</span>
				</div>
			}

			if len(data.Deployments) == 0 {
				@overviewEmptyState(data.GameID)
			} else if len(data.Deployments) == 1 {
				@overviewDeploymentContent(data.GameID, data.Deployments[0])
			} else {
				<div class="flex flex-col gap-6">
					for _, dep := range data.Deployments {
						<div class="border border-base-300 rounded-box p-4 bg-base-200/20">
							<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4 pb-2 border-b border-base-300">
								<div class="font-semibold text-base-content">
									{ dep.DisplayName }
								</div>
								@overviewStatusBadge(dep.Status)
							</div>
							@overviewDeploymentContent(data.GameID, dep)
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ GameDetail(data GameDetailPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
			.log-viewer-container {
				background: #1e1e1e;
				max-height: 500px;
				overflow: hidden;
			}
			[data-theme="oled"] .log-viewer-container {
				background: #000000;
			}
			.log-viewer-output {
				margin: 0;
				padding: 1rem;
				color: #d4d4d4;
				font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
				font-size: 0.875rem;
				line-height: 1.5;
				overflow-y: auto;
				overflow-x: auto;
				max-height: 500px;
				white-space: pre-wrap;
				word-wrap: break-word;
			}
			.log-viewer-container.collapsed .log-viewer-output {
				display: none;
			}
			.log-line { display: block; }
			.log-stdout { color: #d4d4d4; }
			.log-stderr { color: #f48771; }
			.log-host { color: #4fc1ff; }
			.log-info { color: #4fc1ff; }
			.log-warning { color: #f9c74f; }
			.log-error { color: #f48771; }
		</style>
		<script>
			document.addEventListener('click', function(event) {
				var trigger = event.target.closest('[data-open-blade-template]');
				if (!trigger) return;
				var tpl = document.getElementById(trigger.getAttribute('data-open-blade-template'));
				if (!tpl) return;
				var fragment = tpl.content.cloneNode(true);
				var bladeRoot = fragment.querySelector('[data-blade]');
				document.body.appendChild(fragment);
				if (bladeRoot && window.htmx) {
					window.htmx.process(bladeRoot);
				}
			});
		</script>
		<div
			id="game-detail-tabs"
			x-data={ fmt.Sprintf(`{
				activeTab: (function() {
					const urlParams = new URLSearchParams(window.location.search);
					const tabParam = urlParams.get('tab');
					// 'configuration' is no longer a real tab (folded into the
					// Overview tab's collapsed View More section): an old
					// ?tab=configuration bookmark resolves to Overview rather
					// than a blank panel.
					if (tabParam === 'configuration') return 'overview';
					if (tabParam) return tabParam;
					const hash = window.location.hash.replace('#', '');
					if (hash === 'settings-presets' || hash === 'configuration') return 'overview';
					if (hash === 'danger-zone' || hash === 'advanced') return 'advanced';
					if (hash === 'logs' || hash === 'console') return 'logs';
					return '%s';
				})(),
				switchTab(tab) {
					this.activeTab = tab;
					const url = new URL(window.location);
					url.searchParams.set('tab', tab);
					window.history.replaceState({}, '', url);
				}
			}`, data.ActiveTab) }
		>
			<!-- Page Header -->
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
				<div>
					<div class="flex items-center gap-2 mb-2">
						<span class="badge badge-primary badge-soft">
							🎮 GAME
						</span>
						@htmxui.Badge(deploymentStatusLabel(data.RunState), statusBadgeVariant(string(data.RunState)), htmxui.BadgeSizeMD, true, nil)
					</div>
					<h1 class="text-3xl font-bold text-base-content">{ data.Game.Name }</h1>
					<div class="mt-2">
						@components.ConnectAddressDisplay(data.Connect)
					</div>
				</div>
				<div class="flex flex-wrap gap-2">
					<a href={ templ.URL(fmt.Sprintf("/games/%d/actions", data.Game.GameId)) } class="btn btn-primary btn-sm">
						⚡ Manage Actions
					</a>
					if data.IsAdmin {
						<button type="button" @click="switchTab('advanced')" class="btn btn-secondary btn-sm">
							Edit Game
						</button>
					}
				</div>
			</div>

			<!-- Tab Sub-Navigation (FR: Progressive disclosure) -->
			<div role="tablist" class="tabs tabs-bordered mb-6" data-game-tabs>
				<button
					type="button"
					role="tab"
					id="tab-btn-overview"
					class="tab tab-lg"
					:class="{ 'tab-active font-semibold': activeTab === 'overview' }"
					@click="switchTab('overview')"
				>
					Overview
				</button>
				<button
					type="button"
					role="tab"
					id="tab-btn-logs"
					class="tab tab-lg"
					:class="{ 'tab-active font-semibold': activeTab === 'logs' }"
					@click="switchTab('logs')"
				>
					Console &amp; Logs
				</button>
				if data.IsAdmin {
					<button
						type="button"
						role="tab"
						id="tab-btn-advanced"
						class="tab tab-lg"
						:class="{ 'tab-active font-semibold': activeTab === 'advanced' }"
						@click="switchTab('advanced')"
					>
						Advanced
					</button>
				}
			</div>

			<!-- TAB 1: OVERVIEW (Default: status, runtime, start/stop/restart) -->
			<div id="tab-panel-overview" x-show="activeTab === 'overview'">
				@GameOverview(data.Overview)

				if len(data.Deployments) == 0 {
					<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
						<div class="p-8 text-center">
							<p class="text-base-content/60">No deployments found for this game.</p>
							if data.IsAdmin {
								<button type="button" @click="switchTab('advanced')" class="btn btn-primary btn-sm mt-3">
									Go to Advanced to Deploy
								</button>
							}
						</div>
					</div>
				}

				<div class="card bg-base-100 border border-base-300 shadow-sm p-6 mb-6">
					<h2 class="text-lg font-semibold text-base-content mb-4">Game Information</h2>
					<dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
						@components.DLItem("Game ID", fmt.Sprintf("%d", data.Game.GameId))
						@components.DLItem("Name", data.Game.Name)
						@components.DLItem("Steam App ID", func() string {
							if data.Game.SteamAppId != "" {
								return data.Game.SteamAppId
							}
							return "-"
						}())
						if data.Game.Metadata != nil {
							@components.DLItem("Genre", func() string {
								if data.Game.Metadata.Genre != "" {
									return data.Game.Metadata.Genre
								}
								return "-"
							}())
							@components.DLItem("Publisher", func() string {
								if data.Game.Metadata.Publisher != "" {
									return data.Game.Metadata.Publisher
								}
								return "-"
							}())
							<div>
								<dt class="text-sm font-medium text-base-content/60">Tags</dt>
								<dd class="mt-1 flex flex-wrap gap-1">
									if len(data.Game.Metadata.Tags) > 0 {
										for _, tag := range data.Game.Metadata.Tags {
											<span class="badge badge-neutral badge-soft badge-sm">{ tag }</span>
										}
									} else {
										<span class="text-sm text-base-content">-</span>
									}
								</dd>
							</div>
						}
					</dl>
				</div>

				<!--
					View More (Game Configurations, Environment & Ports, Addon
					Path Presets, Workshop Libraries): collapsed by default,
					since these are configuration/library concerns an operator
					checking status doesn't need on every visit. Not deleted,
					just one click away instead of a separate "Configuration"
					tab. Scoped inside tab-panel-overview (x-show="activeTab
					=== 'overview'" above) so it doesn't also render on the
					Console & Logs / Advanced tabs.
				-->
				if data.IsAdmin {
				<div id="game-detail-view-more" x-data="{ expanded: false }" class="card bg-base-100 border border-base-300 shadow-sm mb-6 overflow-hidden">
					<button type="button" @click="expanded = !expanded" class="w-full flex justify-between items-center p-4 border-b border-base-300 hover:bg-base-200 transition-colors">
						<h2 class="text-lg font-semibold text-base-content">
							<span x-show="!expanded">View More: Configurations &amp; Library</span>
							<span x-show="expanded" x-cloak>Hide Configurations &amp; Library</span>
						</h2>
						<svg :class="expanded ? 'rotate-180' : ''" class="w-5 h-5 text-base-content/60 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
						</svg>
					</button>
					<div x-show="expanded" x-cloak x-collapse class="p-4">
						<!-- Game Configurations -->
						<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
							<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 border-b border-base-300 bg-base-200">
								<div>
									<h2 class="text-lg font-semibold text-base-content">Game Configurations</h2>
									<p class="text-xs text-base-content/60 mt-1">Docker image, entrypoints, and base parameters.</p>
								</div>
								<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/new", data.Game.GameId)) } class="btn btn-primary btn-sm">
									+ Create Config
								</a>
							</div>
							if len(data.Configs) > 0 {
								<div class="overflow-x-auto">
									<table class="table">
										<thead>
											<tr>
												<th>Name</th>
												<th>Docker Image</th>
												<th>Deployments</th>
												<th class="text-right">Actions</th>
											</tr>
										</thead>
										<tbody>
											for _, config := range data.Configs {
												<tr class="hover">
													<td>
														<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", data.Game.GameId, config.ConfigId)) } class="text-sm font-medium link link-primary">
															{ config.Name }
														</a>
													</td>
													<td class="text-sm font-mono text-base-content">{ config.Image }</td>
													<td class="text-sm text-base-content">{ fmt.Sprintf("%d", data.SgcCounts[config.ConfigId]) }</td>
													<td class="text-right space-x-2">
														<!--
															Opens the Config Editor blade (root plan #2266,
															task #2276, FR13): Basics/Environment/Volumes,
															editable. This is View More's only entry point
															to it now that the Games list row's own
															Configurations section (data-config-editor-
															trigger, #2273) is gone. The list stays a
															quick-glance view; genuine editing lives here,
															behind this already admin-gated section. See
															handleGameConfigEditor's doc comment.
														-->
														<button
															type="button"
															class="btn btn-secondary btn-sm"
															data-config-editor-trigger
															data-config-id={ fmt.Sprintf("%d", config.ConfigId) }
															hx-get={ fmt.Sprintf("/games/%d/configs/%d/editor", data.Game.GameId, config.ConfigId) }
															hx-target="body"
															hx-swap="beforeend"
														>
															Edit
														</button>
														<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", data.Game.GameId, config.ConfigId)) } class="btn btn-primary btn-sm">
															View
														</a>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							} else {
								<div class="p-8 text-center">
									<p class="text-base-content/60">No configurations yet. Create a configuration to deploy this game.</p>
								</div>
							}
						</div>

						<!-- Environment Variables & Ports info -->
						<div class="card bg-base-100 border border-base-300 shadow-sm p-6 mb-6">
							<h2 class="text-lg font-semibold text-base-content mb-2">Environment &amp; Ports Management</h2>
							<p class="text-sm text-base-content/70 mb-4">
								Base environment variables and arguments templates are managed on each Game Configuration.
								Port bindings and host-level environment overrides can be customized per deployment.
							</p>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
								<div class="bg-base-200/50 p-4 rounded-box border border-base-300">
									<h3 class="font-semibold text-base-content mb-1">🔧 Configuration Defaults</h3>
									<p class="text-xs text-base-content/60">
										Select a configuration above and click "Edit Configuration" to modify environment templates, entrypoints, and mounted volumes.
									</p>
								</div>
								<div class="bg-base-200/50 p-4 rounded-box border border-base-300">
									<h3 class="font-semibold text-base-content mb-1">🌐 Ports &amp; Host Placement</h3>
									<p class="text-xs text-base-content/60">
										Ports are mapped dynamically or statically when deploying to a bare-metal host. Manage deployments in the Advanced tab.
									</p>
								</div>
							</div>
						</div>

						<!-- Path Presets -->
						<div id="settings-presets" x-data="{ expanded: false }" class="card bg-base-100 border border-base-300 shadow-sm mb-6 overflow-hidden">
							<button @click="expanded = !expanded" class="w-full flex justify-between items-center p-4 border-b border-base-300 hover:bg-base-200 transition-colors">
								<div class="flex items-center gap-3">
									<h2 class="text-lg font-semibold text-base-content">Addon Path Presets</h2>
									<span class="text-sm text-base-content/60">({ fmt.Sprintf("%d presets", len(data.PathPresets)) })</span>
								</div>
								<svg :class="expanded ? 'rotate-180' : ''" class="w-5 h-5 text-base-content/60 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</button>
							<div x-show="expanded" x-cloak x-collapse>
								if len(data.PathPresets) > 0 {
									<div class="overflow-x-auto">
										<table class="table">
											<thead class="bg-base-200">
												<tr>
													<th scope="col">Name</th>
													<th scope="col">Volume</th>
													<th scope="col">Installation Path</th>
													<th scope="col" class="text-right">Actions</th>
												</tr>
											</thead>
											<tbody>
												for _, preset := range data.PathPresets {
													<tr class="hover">
														<td>
															<div class="text-sm font-medium text-base-content">{ preset.Name }</div>
															if preset.Description != "" {
																<div class="text-xs text-base-content/60 mt-1">{ preset.Description }</div>
															}
														</td>
														<td class="text-sm text-base-content"><em>(relative path)</em></td>
														<td class="text-sm font-mono text-base-content">{ preset.InstallationPath }</td>
														<td class="text-right">
															<form method="POST" action={ templ.URL(fmt.Sprintf("/games/%d/presets/%d/delete", data.Game.GameId, preset.PresetId)) } class="inline">
																<button type="submit" onclick="return confirm('Delete this preset?')" class="btn btn-error btn-sm">Delete</button>
															</form>
														</td>
													</tr>
												}
											</tbody>
										</table>
									</div>
								} else {
									<div class="p-8 text-center">
										<p class="text-base-content/60">No path presets defined. Add a preset to make addon installation easier.</p>
									</div>
								}
								<div class="p-4 border-t border-base-300">
									<button onclick="document.getElementById('add-preset-form').classList.remove('hidden')" class="btn btn-primary btn-sm">+ Add Preset</button>
								</div>
							</div>
						</div>

						<!-- Add Preset Form -->
						<div id="add-preset-form" class="hidden mb-6">
							<div class="card bg-base-100 border border-base-300 shadow-sm p-6">
								<h2 class="text-lg font-semibold text-base-content mb-4">Add Path Preset</h2>
								<form method="POST" action={ templ.URL(fmt.Sprintf("/games/%d/presets/create", data.Game.GameId)) } class="space-y-4">
									<input type="hidden" name="game_id" value={ fmt.Sprintf("%d", data.Game.GameId) }/>
									<div>
										<label for="preset_name" class="block text-sm font-medium text-base-content mb-2">Name *</label>
										<input type="text" id="preset_name" name="name" required placeholder="e.g., Maps, Plugins, Skins" class="input input-bordered w-full"/>
										<p class="text-xs text-base-content/60 mt-1">Short label for this preset</p>
									</div>
									<div>
										<label for="preset_description" class="block text-sm font-medium text-base-content mb-2">Description</label>
										<textarea id="preset_description" name="description" rows="2" placeholder="Optional description" class="textarea textarea-bordered w-full"></textarea>
									</div>
									<div>
										<label for="preset_volume_id" class="block text-sm font-medium text-base-content mb-2">Volume (Optional)</label>
										<select id="preset_volume_id" name="volume_id" class="select select-bordered w-full">
											<option value="">-- Use first volume (default) --</option>
											for _, vol := range data.Volumes {
												<option value={ fmt.Sprintf("%d", vol.VolumeId) }>{ vol.Name } ({ vol.ContainerPath })</option>
											}
										</select>
										<p class="text-xs text-base-content/60 mt-1">Select which volume addons using this preset should install to</p>
									</div>
									<div>
										<label for="preset_installation_path" class="block text-sm font-medium text-base-content mb-2">Installation Path *</label>
										<input type="text" id="preset_installation_path" name="installation_path" required placeholder="e.g., left4dead2/maps/" class="input input-bordered w-full"/>
										<p class="text-xs text-base-content/60 mt-1">Relative path within the volume</p>
									</div>
									<div class="flex gap-3 pt-2">
										<button type="submit" class="btn btn-success">Add Preset</button>
										<button type="button" onclick="document.getElementById('add-preset-form').classList.add('hidden')" class="btn btn-secondary">Cancel</button>
									</div>
								</form>
							</div>
						</div>

						<!-- Workshop Libraries -->
						<div
							id={ fmt.Sprintf("game-workshop-%d", data.Game.GameId) }
							hx-get={ fmt.Sprintf("/games/%d/workshop-panel", data.Game.GameId) }
							hx-trigger="load"
							hx-swap="innerHTML"
							class="mb-6"
						>
							@gameWorkshopPlaceholder()
						</div>
					</div>
				</div>
			}
			</div>

			<!-- TAB 2: CONSOLE & LOGS (Live stream + log history) -->
			<div id="tab-panel-logs" x-show="activeTab === 'logs'" x-cloak>
				if data.LiveSession != nil && len(data.Deployments) <= 1 {
					<!-- Live Logs viewer -->
					<div class="card bg-base-100 border border-base-300 shadow-sm mb-6 overflow-hidden">
						<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 border-b border-base-300 bg-base-200">
							<div class="flex items-center gap-2">
								<h2 class="text-lg font-semibold text-base-content">Live Console &amp; Stream</h2>
								<span class="badge badge-info badge-sm">{ fmt.Sprintf("Session #%d", data.LiveSession.SessionId) }</span>
							</div>
							<div class="flex flex-wrap items-center gap-2">
								<button id="toggle-logs" class="btn btn-neutral btn-sm">Hide</button>
								<button id="clear-logs" class="btn btn-neutral btn-sm">Clear</button>
								<span id="log-status" class="text-sm text-base-content/60">Connecting...</span>
							</div>
						</div>
						<div id="log-viewer" class="log-viewer-container">
							<pre id="log-output" class="log-viewer-output"></pre>
						</div>
						<div class="border-t border-base-300">
							<form id="stdin-form" class="flex gap-2 p-3 bg-neutral">
								<input type="text" id="stdin-input" placeholder="Send command to server..." class="input input-bordered flex-1 bg-neutral text-neutral-content font-mono text-sm"/>
								<button type="submit" id="stdin-submit" class="btn btn-primary min-w-[80px]">Send</button>
							</form>
							<div id="stdin-status" class="px-3 pb-2 text-xs text-neutral-content/60 min-h-[1.5rem] bg-neutral"></div>
						</div>
					</div>
					<div id="live-logs-data" data-session-id={ fmt.Sprintf("%d", data.LiveSession.SessionId) }></div>
					<script type="text/javascript">
						(function() {
							const dataEl = document.getElementById('live-logs-data');
							if (!dataEl) return;
							const sessionId = parseInt(dataEl.dataset.sessionId);
							const logOutput = document.getElementById('log-output');
							const logStatus = document.getElementById('log-status');
							const logViewer = document.getElementById('log-viewer');
							const toggleBtn = document.getElementById('toggle-logs');
							const clearBtn = document.getElementById('clear-logs');
							let autoScroll = true;
							let evtSource = null;
							let lastSequenceNumber = 0;

							function appendLogLine(container, timestamp, source, message) {
								const line = document.createElement('span');
								line.className = 'log-line log-' + source;
								line.textContent = '[' + timestamp + '] [' + source + '] ' + message;
								container.appendChild(line);
								container.appendChild(document.createTextNode('\n'));
							}

							function connect() {
								const url = lastSequenceNumber > 0
									? '/sessions/' + sessionId + '/logs/stream?after_sequence_number=' + lastSequenceNumber
									: '/sessions/' + sessionId + '/logs/stream';
								evtSource = new EventSource(url);
								evtSource.onopen = () => {
									if (logStatus) {
										logStatus.textContent = '● Connected';
										logStatus.style.color = '#4fc1ff';
									}
								};
								evtSource.onmessage = (event) => {
									const d = JSON.parse(event.data);
									if (d.type === 'connected') return;
									if (d.sequence_number) lastSequenceNumber = d.sequence_number;
									const date = new Date(d.timestamp);
									const time = date.toLocaleTimeString('en-US', { hour12: false });
									if (logOutput) {
										appendLogLine(logOutput, time, d.source, d.message);
										if (autoScroll) {
											logOutput.scrollTop = logOutput.scrollHeight;
										}
										const lines = logOutput.children;
										if (lines.length > 1000) {
											logOutput.removeChild(lines[0]);
										}
									}
								};
								evtSource.onerror = () => {
									if (logStatus) {
										logStatus.textContent = '● Disconnected';
										logStatus.style.color = '#f48771';
									}
									if (evtSource) {
										evtSource.close();
										evtSource = null;
									}
									setTimeout(connect, 3000);
								};
							}

							if (toggleBtn && logViewer) {
								toggleBtn.addEventListener('click', () => {
									logViewer.classList.toggle('collapsed');
									toggleBtn.textContent = logViewer.classList.contains('collapsed') ? 'Show' : 'Hide';
								});
							}

							if (clearBtn && logOutput) {
								clearBtn.addEventListener('click', () => {
									logOutput.textContent = '';
								});
							}

							if (logOutput) {
								logOutput.addEventListener('scroll', () => {
									autoScroll = (logOutput.scrollHeight - logOutput.scrollTop - logOutput.clientHeight) < 20;
								});
							}

							connect();

							const stdinForm = document.getElementById('stdin-form');
							const stdinInput = document.getElementById('stdin-input');
							const stdinStatus = document.getElementById('stdin-status');
							if (stdinForm && stdinInput) {
								stdinForm.addEventListener('submit', async (e) => {
									e.preventDefault();
									const text = stdinInput.value.trim();
									if (!text) return;
									stdinInput.disabled = true;
									try {
										const resp = await fetch('/sessions/' + sessionId + '/stdin', {
											method: 'POST',
											headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
											body: 'input=' + encodeURIComponent(text)
										});
										if (resp.ok) {
											stdinInput.value = '';
											if (stdinStatus) {
												stdinStatus.textContent = 'Command sent: ' + text;
												setTimeout(() => { if (stdinStatus) stdinStatus.textContent = ''; }, 3000);
											}
										} else {
											const err = await resp.text();
											if (stdinStatus) stdinStatus.textContent = 'Error: ' + err;
										}
									} catch (err) {
										if (stdinStatus) stdinStatus.textContent = 'Error: ' + err.message;
									} finally {
										stdinInput.disabled = false;
										stdinInput.focus();
									}
								});
							}
						})();
					</script>
					if len(data.Actions) > 0 {
						<div class="card bg-base-100 border border-base-300 shadow-sm p-4 mb-6">
							<h3 class="text-sm font-semibold text-base-content mb-2">Quick Console Actions</h3>
							<div class="flex flex-wrap gap-2">
								for _, act := range data.Actions {
									<form
										method="POST"
										action={ templ.URL(fmt.Sprintf("/sessions/%d/actions/execute", data.LiveSession.SessionId)) }
										hx-post={ fmt.Sprintf("/sessions/%d/actions/execute", data.LiveSession.SessionId) }
										hx-vals={ fmt.Sprintf("{\"action_id\": \"%d\"}", act.ActionId) }
										hx-target="#action-quick-status"
										hx-swap="innerHTML"
										class="inline"
									>
										<button type="submit" class="btn btn-sm btn-outline">
											{ act.Name }
										</button>
									</form>
								}
							</div>
							<div id="action-quick-status" class="text-xs text-base-content/70 mt-2"></div>
						</div>
					}
				} else if len(data.Deployments) > 1 {
					<div class="alert alert-info shadow-sm mb-6">
						<span>This game has multiple deployments. Open a deployment's live console from its "View Live Output / Logs" link on the Overview tab.</span>
					</div>
				} else if len(data.Sessions) > 0 {
					<div class="alert alert-info shadow-sm mb-6">
						<span>Game server is currently offline. Start a deployment from the Overview tab to view live streaming logs and console.</span>
					</div>
				}

				<!-- Log History (Past Sessions) -->
				<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
					<div class="p-4 border-b border-base-300 bg-base-200">
						<h2 class="text-lg font-semibold text-base-content">Session Log History</h2>
					</div>
					if len(data.Sessions) > 0 {
						<div class="overflow-x-auto">
							<table class="table">
								<thead>
									<tr>
										<th>Session ID</th>
										<th>Status</th>
										<th>Started</th>
										<th>Ended</th>
										<th>Exit Code</th>
										<th class="text-right">Actions</th>
									</tr>
								</thead>
								<tbody>
									for _, s := range data.Sessions {
										<tr class="hover">
											<td class="font-mono text-sm">{ fmt.Sprintf("#%d", s.SessionId) }</td>
											<td>
												@htmxui.Badge(s.Status, statusBadgeVariant(sessionStatusVariant(s.Status)), htmxui.BadgeSizeSM, true, nil)
											</td>
											<td class="text-sm">{ timeAgo(s.StartedAt) }</td>
											<td class="text-sm">
												if s.EndedAt > 0 {
													{ timeAgo(s.EndedAt) }
												} else {
													<span class="text-base-content/40">-</span>
												}
											</td>
											<td class="text-sm font-mono">{ fmt.Sprintf("%d", s.ExitCode) }</td>
											<td class="text-right">
												<a href={ templ.URL(fmt.Sprintf("/sessions/%d", s.SessionId)) } class="btn btn-primary btn-sm">
													View Logs
												</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					} else {
						<div class="p-8 text-center">
							<p class="text-base-content/60">No sessions recorded yet for this game.</p>
						</div>
					}
				</div>
			</div>

			if data.IsAdmin {
				<!-- TAB 4: ADVANCED / DANGER ZONE (Deployments, container rebuilds, teardown) -->
				<div id="tab-panel-advanced" x-show="activeTab === 'advanced'" x-cloak>
					<!-- Deployments & Rebuilds -->
					<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
						<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 border-b border-base-300 bg-base-200">
							<div>
								<h2 class="text-lg font-semibold text-base-content">Deployments &amp; Host Placement</h2>
								<p class="text-xs text-base-content/60 mt-1">Deploy game configurations onto infrastructure servers.</p>
							</div>
							if len(data.Configs) > 0 {
								<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", data.Game.GameId, data.Configs[0].ConfigId)) } class="btn btn-success btn-sm">
									+ Deploy to Server
								</a>
							} else {
								<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/new", data.Game.GameId)) } class="btn btn-primary btn-sm">
									Create Config to Deploy
								</a>
							}
						</div>
						if len(data.Deployments) > 0 {
							<div class="overflow-x-auto">
								<table class="table">
									<thead>
										<tr>
											<th>Deployment ID</th>
											<th>Instance</th>
											<th>Status</th>
											<th>Connect Address</th>
											<th class="text-right">Actions</th>
										</tr>
									</thead>
									<tbody>
										for _, dep := range data.Deployments {
											<tr class="hover">
												<td class="font-mono text-sm">{ fmt.Sprintf("#%d", dep.Row.ServerGameConfigID) }</td>
												<td class="font-medium text-sm">{ dep.Row.DisplayName }</td>
												<td>
													@htmxui.Badge(dep.Row.SGCStatus, statusBadgeVariant(dep.Row.SGCStatus), htmxui.BadgeSizeSM, true, nil)
												</td>
												<td>
													@components.ConnectAddressDisplay(dep.Connect)
												</td>
												<td class="text-right">
													<a href={ templ.URL(dep.ActionsURL) } class="btn btn-sm btn-outline">
														Actions
													</a>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						} else {
							<div class="p-8 text-center">
								<p class="text-base-content/60">No deployments currently placed on any server.</p>
							</div>
						}
					</div>

					<!-- Edit Game Form (Administrative) -->
					<div class="card bg-base-100 border border-base-300 shadow-sm p-6 mb-6">
						<h2 class="text-lg font-semibold text-base-content mb-4">Edit Game Details</h2>
						<form hx-post={ fmt.Sprintf("/games/%d/edit", data.Game.GameId) } hx-swap="none" class="space-y-4">
							<div>
								<label for="name" class="block text-sm font-medium text-base-content mb-2">Name *</label>
								<input type="text" id="name" name="name" value={ data.Game.Name } required class="input input-bordered w-full"/>
							</div>
							<div>
								<label for="steam_app_id" class="block text-sm font-medium text-base-content mb-2">Steam App ID</label>
								<input type="text" id="steam_app_id" name="steam_app_id" value={ data.Game.SteamAppId } class="input input-bordered w-full"/>
							</div>
							<div>
								<label for="genre" class="block text-sm font-medium text-base-content mb-2">Genre</label>
								<input type="text" id="genre" name="genre" value={ metadataValue(data.Game, "genre") } class="input input-bordered w-full"/>
							</div>
							<div>
								<label for="publisher" class="block text-sm font-medium text-base-content mb-2">Publisher</label>
								<input type="text" id="publisher" name="publisher" value={ metadataValue(data.Game, "publisher") } class="input input-bordered w-full"/>
							</div>
							<div>
								<label for="tags" class="block text-sm font-medium text-base-content mb-2">Tags (comma-separated)</label>
								<input type="text" id="tags" name="tags" value={ metadataTags(data.Game) } class="input input-bordered w-full"/>
							</div>
							<div class="pt-2">
								<button type="submit" class="btn btn-success">Save Game Details</button>
							</div>
						</form>
					</div>

					<!-- Danger Zone -->
					<div id="danger-zone" x-data="{ confirmDelete: false }" class="card bg-base-100 border-2 border-error/40 shadow-md overflow-hidden mb-6">
						<div class="bg-error/10 px-6 py-4 border-b-2 border-error/40">
							<h2 class="text-lg font-semibold text-error">⚠️ Danger Zone</h2>
						</div>
						<div class="card-body">
							<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
								<div>
									<h3 class="text-sm font-semibold text-base-content mb-1">Delete this game</h3>
									<p class="text-sm text-base-content/60">Once deleted, all configurations and deployments will be removed. This action cannot be undone.</p>
								</div>
								<div class="flex-shrink-0">
									<button x-show="!confirmDelete" @click="confirmDelete = true" class="btn btn-error">Delete Game</button>
									<div x-show="confirmDelete" x-cloak class="flex gap-2 items-center">
										<span class="text-sm text-error font-medium">Are you sure?</span>
										<form method="POST" action={ templ.URL(fmt.Sprintf("/games/%d/delete", data.Game.GameId)) } class="inline">
											<button type="submit" class="btn btn-error">Yes, Delete</button>
										</form>
										<button @click="confirmDelete = false" class="btn btn-secondary">Cancel</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
}

// gameWorkshopPlaceholder renders the Workshop Libraries section shell
// before its data has loaded (task #2367, FR8/FR9/FR10 -- editable
// GC-level attach/detach, replacing M5's read-only SGC-scoped panel and
// its "coming soon: shared across configs" note). Lives here rather than
// on the Games list row (games.templ): the list was trimmed to a
// quick-glance Deployments-only view, and this admin-gated Configuration
// tab is now Workshop Libraries' only home.
//
// GetGameConfigLibraryAttachments and ListGameConfigLibraries both require
// a single config_id (no sgc_id==0-style "all" filter exists for either),
// so this stays a lazily-fetched fragment (the enclosing div's hx-get)
// rather than data GameDetailPageData carries directly.
templ gameWorkshopPlaceholder() {
	<div class="border border-base-300 rounded-box overflow-hidden">
		<div class="p-3 border-b border-base-300 bg-base-200">
			<h3 class="font-semibold text-base-content">Workshop Libraries</h3>
		</div>
		<p class="p-4 text-sm text-base-content/60">Loading workshop libraries…</p>
	</div>
}
