package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

type SGCDetailPageData struct {
	Layout             components.LayoutData
	SGC                *manmanpb.ServerGameConfig
	Server             *manmanpb.Server
	GameConfig         *manmanpb.GameConfig
	Game               *manmanpb.Game
	LibraryAttachments []LibraryAttachment
	Sessions           []*manmanpb.Session
	PendingCount       int
	BackupConfigs      []BackupConfigGroup
	RecentBackups      []*manmanpb.Backup
	// DeploymentStatus is the gamer-facing running/stopped rollup (FR2),
	// computed by handleSGCDetail via components.ComputeDeploymentStatus
	// -- never derived here from the raw Session.status string.
	DeploymentStatus components.DeploymentStatus
	// ConnectAddresses is the set of host:port addresses for the current
	// deployment (FR5/FR6), computed via components.ComputeConnectAddresses.
	// Empty means "no address to show" -- see ConnectAddressUnavailable.
	ConnectAddresses []components.ConnectAddress
	// ConnectAddressUnavailable is true when ComputeConnectAddresses
	// returned no addresses (FR7), e.g. no host_public_address configured.
	ConnectAddressUnavailable bool
}

type LibraryAttachment struct {
	Library      *manmanpb.WorkshopLibrary
	PresetName   string
	ComputedPath string
	PathOverride bool
	VolumeName   string
}

type BackupConfigGroup struct {
	Volume  *manmanpb.GameConfigVolume
	Configs []*manmanpb.BackupConfig
}

templ SGCDetail(data SGCDetailPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
			<div>
				<div class="flex items-center gap-2 mb-2">
					<span class="badge badge-secondary badge-soft">
						🚀 SERVER DEPLOYMENT
					</span>
					@htmxui.Badge(data.SGC.Status, statusBadgeVariant(data.SGC.Status), htmxui.BadgeSizeMD, true, nil)
				</div>
				<h1 class="text-3xl font-bold text-base-content">SGC-{ fmt.Sprintf("%d", data.SGC.ServerGameConfigId) }</h1>
				if data.Server != nil {
					<p class="text-sm text-base-content/60 mt-1">Deployed on { data.Server.Name }</p>
				}
			</div>
			<div class="flex gap-2">
				<form method="post" action="/sessions/start">
					<input type="hidden" name="server_game_config_id" value={ fmt.Sprintf("%d", data.SGC.ServerGameConfigId) }/>
					<button type="submit" class="btn btn-success">
						Start Session
					</button>
				</form>
			</div>
		</div>
		<!--
			Status & Connect: the gamer-facing landing block (FR2, FR5, FR6,
			FR7, FR12). Status and addresses are computed once by
			handleSGCDetail via the components.ComputeDeploymentStatus /
			components.ComputeConnectAddresses helpers (NFR1); this
			template does no status-string comparison or "%s:%d" address
			building of its own.
		-->
		<div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
			<div class="card-body">
				<div class="flex items-center gap-3 mb-4">
					<h2 class="text-lg font-semibold text-base-content">Status &amp; Connect</h2>
					@htmxui.Badge(deploymentStatusLabel(data.DeploymentStatus), statusBadgeVariant(string(data.DeploymentStatus)), htmxui.BadgeSizeMD, true, nil)
				</div>
				if data.ConnectAddressUnavailable {
					<p class="text-sm text-base-content/60">Connect address unavailable — no public address configured for this host.</p>
				} else if data.DeploymentStatus == components.DeploymentRunning {
					<ul class="space-y-1">
						for _, addr := range data.ConnectAddresses {
							<li class="flex items-center gap-2">
								<code class="text-sm font-mono bg-base-200 text-base-content px-2 py-1 rounded">{ addr.Address }</code>
								<span class="text-xs text-base-content/60">{ addr.Protocol }</span>
							</li>
						}
					</ul>
				} else {
					<div x-data="{ showConnectAddress: false }">
						<button type="button" @click="showConnectAddress = !showConnectAddress" class="btn btn-secondary btn-sm">
							<span x-text="showConnectAddress ? 'Hide last-known connect address' : 'Show last-known connect address'">Show last-known connect address</span>
						</button>
						<ul x-show="showConnectAddress" x-cloak class="space-y-1 mt-2">
							for _, addr := range data.ConnectAddresses {
								<li class="flex items-center gap-2">
									<code class="text-sm font-mono bg-base-200 text-base-content px-2 py-1 rounded">{ addr.Address }</code>
									<span class="text-xs text-base-content/60">{ addr.Protocol }</span>
								</li>
							}
						</ul>
					</div>
				}
			</div>
		</div>
		<!-- SGC Info -->
		<div x-data="{ editPorts: false }" class="card bg-base-100 border border-base-300 shadow-sm mb-6">
			<div class="card-body">
				<h2 class="text-lg font-semibold text-base-content mb-4">Deployment Info</h2>
				<dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
					@components.DLItemMono("SGC ID", fmt.Sprintf("%d", data.SGC.ServerGameConfigId))
					<div>
						<dt class="text-sm font-medium text-base-content/60">Server</dt>
						<dd class="mt-1 text-sm">
							if data.Server != nil {
								<a href={ templ.URL(fmt.Sprintf("/servers/%d", data.Server.ServerId)) } class="link link-primary">{ data.Server.Name }</a>
							} else {
								<span class="text-base-content">Server { fmt.Sprintf("%d", data.SGC.ServerId) }</span>
							}
						</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-base-content/60">Game Config</dt>
						<dd class="mt-1 text-sm">
							if data.GameConfig != nil {
								<a href={ templ.URL(fmt.Sprintf("/games/%d/configs/%d", data.GameConfig.GameId, data.GameConfig.ConfigId)) } class="link link-primary">{ data.GameConfig.Name }</a>
							} else {
								<span class="text-base-content">Config { fmt.Sprintf("%d", data.SGC.GameConfigId) }</span>
							}
						</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-base-content/60">Status</dt>
						<dd class="mt-1">
							@htmxui.Badge(data.SGC.Status, statusBadgeVariant(data.SGC.Status), htmxui.BadgeSizeMD, true, nil)
						</dd>
					</div>
					<div class="md:col-span-2">
						<div class="flex justify-between items-center mb-2">
							<dt class="text-sm font-medium text-base-content/60">Port Bindings</dt>
							<button type="button" @click="editPorts = !editPorts" class="btn btn-primary btn-xs">
								<span x-text="editPorts ? 'Cancel' : 'Edit'">Edit</span>
							</button>
						</div>
						<dd x-show="!editPorts" class="mt-1">
							if len(data.SGC.PortBindings) > 0 {
								<div class="flex flex-wrap gap-1">
									for _, pb := range data.SGC.PortBindings {
										<code class="text-xs bg-base-200 text-base-content px-2 py-1 rounded">
											{ fmt.Sprintf("%d:%d/%s", pb.ContainerPort, pb.HostPort, pb.Protocol) }
										</code>
									}
								</div>
							} else {
								<span class="text-sm text-base-content/60">No port bindings configured.</span>
							}
						</dd>
						<div
							x-show="editPorts"
							x-cloak
							x-data="{
								ports: [],
								addPort() { this.ports.push({ container_port: '', host_port: '', protocol: 'TCP' }) },
								removePort(i) { this.ports.splice(i, 1) },
								init() {
									const dataStr = this.$el.dataset.portBindings;
									const initial = dataStr ? JSON.parse(dataStr) : [];
									this.ports = initial.map(pb => ({ container_port: pb.container_port, host_port: pb.host_port, protocol: pb.protocol }));
								}
							}"
							data-port-bindings={ templ.JSONString(data.SGC.PortBindings) }
							class="mt-2"
						>
							<form
								method="POST"
								action={ templ.URL(fmt.Sprintf("/sgc/%d/update-ports", data.SGC.ServerGameConfigId)) }
								x-on:submit="$event.target.port_bindings_json.value = JSON.stringify(ports.filter(p => p.container_port && p.host_port).map(p => ({ container_port: parseInt(p.container_port), host_port: parseInt(p.host_port), protocol: p.protocol })))"
							>
								<input type="hidden" name="port_bindings_json" value=""/>
								<template x-for="(pb, idx) in ports" :key="idx">
									<div class="flex gap-2 items-center mb-2">
										<input type="number" x-model="pb.container_port" min="1" max="65535" placeholder="Container Port" class="input input-bordered input-sm w-36 font-mono"/>
										<span class="text-base-content/60">→</span>
										<input type="number" x-model="pb.host_port" min="1" max="65535" placeholder="Host Port" class="input input-bordered input-sm w-36 font-mono"/>
										<select x-model="pb.protocol" class="select select-bordered select-sm">
											<option value="TCP">TCP</option>
											<option value="UDP">UDP</option>
										</select>
										<button type="button" x-on:click="removePort(idx)" class="btn btn-error btn-sm btn-square">×</button>
									</div>
								</template>
								<div class="flex gap-2 mt-2">
									<button type="button" x-on:click="addPort()" class="btn btn-neutral btn-sm">+ Add Port Binding</button>
									<button type="submit" class="btn btn-success btn-sm">Save</button>
								</div>
							</form>
						</div>
					</div>
				</dl>
			</div>
		</div>
		<!-- Libraries -->
		<div class="card bg-base-100 border border-base-300 shadow-sm mb-6 overflow-hidden">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 border-b border-base-300">
				<h2 class="text-lg font-semibold text-base-content">Workshop Libraries</h2>
				<button onclick="document.getElementById('add-library-panel').style.display='block'" class="btn btn-primary btn-sm">
					Add Library
				</button>
			</div>
			if data.PendingCount > 0 {
				<div role="alert" class="alert alert-warning m-4">
					<span class="text-sm">
						{ fmt.Sprintf("%d addon(s) pending installation — will be installed before the next session starts.", data.PendingCount) }
					</span>
				</div>
			}
			if len(data.LibraryAttachments) > 0 {
				<div class="overflow-x-auto">
					<table class="table">
						<thead>
							<tr>
								<th>Library</th>
								<th>Install Path</th>
								<th>Volume</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, att := range data.LibraryAttachments {
								<tr class="hover">
									<td>
										<a href={ templ.URL(fmt.Sprintf("/workshop/library-detail?library_id=%d", att.Library.LibraryId)) } class="link link-primary text-sm font-medium">{ att.Library.Name }</a>
										if att.PresetName != "" {
											<br/>
											<small class="text-base-content/60">Preset: { att.PresetName }</small>
										}
									</td>
									<td>
										<code class="text-xs text-base-content">{ att.ComputedPath }</code>
										if att.PathOverride {
											<br/>
											<small class="text-warning">⚠ Override</small>
										}
									</td>
									<td class="text-sm">
										if att.VolumeName != "" {
											{ att.VolumeName }
										} else {
											<small class="text-base-content/60">First available</small>
										}
									</td>
									<td class="text-right">
										<form method="POST" action="/sgc/remove-library" class="inline">
											<input type="hidden" name="sgc_id" value={ fmt.Sprintf("%d", data.SGC.ServerGameConfigId) }/>
											<input type="hidden" name="library_id" value={ fmt.Sprintf("%d", att.Library.LibraryId) }/>
											<button type="submit" onclick="return confirm('Remove this library?')" class="btn btn-error btn-sm">Remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<div class="p-12 text-center">
					<p class="text-base-content/60">No libraries attached. Add a library to automatically install its addons before sessions start.</p>
				</div>
			}
			<div id="add-library-panel" style="display: none;" class="p-4 border-t border-base-300">
				<h3 class="text-sm font-semibold text-base-content mb-3">Add Library</h3>
				<input
					type="text"
					placeholder="Search libraries..."
					class="input input-bordered w-full mb-3"
					hx-get={ fmt.Sprintf("/sgc/api/available-libraries?sgc_id=%d", data.SGC.ServerGameConfigId) }
					hx-trigger="keyup changed delay:300ms"
					hx-target="#sgc-available-libraries"
					name="q"
				/>
				<div
					id="sgc-available-libraries"
					hx-get={ fmt.Sprintf("/sgc/api/available-libraries?sgc_id=%d", data.SGC.ServerGameConfigId) }
					hx-trigger="load"
				></div>
			</div>
		</div>
		<!-- Sessions -->
		<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 border-b border-base-300">
				<h2 class="text-lg font-semibold text-base-content">Sessions</h2>
				<a href={ templ.URL(fmt.Sprintf("/sessions?server_game_config_id=%d", data.SGC.ServerGameConfigId)) } class="btn btn-secondary btn-sm">View All</a>
			</div>
			if len(data.Sessions) > 0 {
				<div class="overflow-x-auto">
					<table class="table">
						<thead>
							<tr>
								<th>Session ID</th>
								<th>Status</th>
								<th>Started</th>
								<th>Ended</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, session := range data.Sessions {
								<tr class="hover">
									<td class="text-sm font-mono">{ fmt.Sprintf("%d", session.SessionId) }</td>
									<td>
										@htmxui.Badge(session.Status, statusBadgeVariant(session.Status), htmxui.BadgeSizeSM, true, nil)
									</td>
									<td class="text-sm">{ timeAgo(session.StartedAt) }</td>
									<td class="text-sm">{ timeAgo(session.EndedAt) }</td>
									<td class="text-right">
										<a href={ templ.URL(fmt.Sprintf("/sessions/%d", session.SessionId)) } class="btn btn-secondary btn-sm">View</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<div class="p-12 text-center">
					<p class="text-base-content/60">No sessions yet for this SGC.</p>
				</div>
			}
		</div>
		<!--
			Danger Zone: intentionally kept on its existing Alpine.js
			x-show / click-handler reveal-then-confirm interaction. FR7:
			this is pre-existing client behavior, not styling, and changing
			"click once to reveal, click again to confirm" to htmxui.Confirm's
			always-visible single-submit shape would be an observable
			behavior change for a destructive action, which FR7 rules out.
			Only the chrome is restyled here, onto the same card/border-error
			visual language htmxui.Confirm's ZoneTitle option renders, so it
			reads as the same "danger zone" pattern even though the
			per-row click-to-reveal gate keeps its own markup instead of
			calling the shared component directly.
		-->
		<div x-data="{ confirmDelete: false, confirmStop: false }" class="card bg-base-100 border-2 border-error/40 shadow-md overflow-hidden mt-6">
			<div class="bg-error/10 px-6 py-4 border-b-2 border-error/40">
				<h2 class="text-lg font-semibold text-error">⚠️ Danger Zone</h2>
			</div>
			<div class="card-body space-y-4">
				for _, session := range data.Sessions {
					if session.Status == "running" {
						<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-base-300">
							<div>
								<h3 class="text-sm font-semibold text-base-content mb-1">Stop deployment</h3>
								<p class="text-sm text-base-content/60">Stop the running server. Players will be disconnected. You can redeploy later.</p>
							</div>
							<div class="flex-shrink-0">
								<button x-show="!confirmStop" @click="confirmStop = true" class="btn btn-warning">Stop Server</button>
								<div x-show="confirmStop" x-cloak class="flex gap-2 items-center">
									<span class="text-sm text-warning font-medium">Stop now?</span>
									<form method="POST" action={ templ.URL(fmt.Sprintf("/sessions/%d/stop", session.SessionId)) } class="inline">
										<button type="submit" class="btn btn-warning">Yes, Stop</button>
									</form>
									<button @click="confirmStop = false" class="btn btn-secondary">Cancel</button>
								</div>
							</div>
						</div>
					}
				}
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
					<div>
						<h3 class="text-sm font-semibold text-base-content mb-1">Delete this server config</h3>
						<p class="text-sm text-base-content/60">Permanently delete this server game config. Active deployments will be stopped. This action cannot be undone.</p>
					</div>
					<div class="flex-shrink-0">
						<button x-show="!confirmDelete" @click="confirmDelete = true" class="btn btn-error">Delete SGC</button>
						<div x-show="confirmDelete" x-cloak class="flex gap-2 items-center">
							<span class="text-sm text-error font-medium">Are you sure?</span>
							<form method="POST" action={ templ.URL(fmt.Sprintf("/sgc/%d/delete", data.SGC.ServerGameConfigId)) } class="inline">
								<button type="submit" class="btn btn-error">Yes, Delete</button>
							</form>
							<button @click="confirmDelete = false" class="btn btn-secondary">Cancel</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
