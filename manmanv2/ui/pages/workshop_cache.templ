package pages

import (
	"fmt"
	"github.com/whale-net/everything/manmanv2/ui/components"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
)

// WorkshopCachePageData backs the Admin fleet-wide cache visibility view
// (FR10, plan #2175): for a given addon, every content-addressed cache
// entry, which hosts hold a copy, and how stale each entry's verification
// is -- without querying hosts one at a time. Entries is populated by
// handleWorkshopCache (manmanv2/ui/handlers_workshop.go) from the
// ListAddonCacheEntries RPC, already newest-first with each entry's host
// presence attached; this page does no further sorting or fetching.
type WorkshopCachePageData struct {
	Layout  components.LayoutData
	AddonID int64
	Entries []*manmanpb.WorkshopCacheEntry
	// VerifyState/VerifyServerID carry the outcome of a just-dispatched on-demand verify
	// (#2186, FR11) back from handleWorkshopCacheVerify's redirect: "" (no verify was just
	// dispatched), "dispatched" (VerifyServerID names the chosen host), "no_host_available"
	// (a real, reportable state -- rendered as a plain message, not an error), or "error"
	// (the RPC itself failed). The up-to-date/changed outcome is never here: it only shows
	// up in Entries on the next manual reload.
	VerifyState    string
	VerifyServerID int64
}

// cacheEntrySize renders SizeBytes the same way the addon detail/library
// pages render FileSizeBytes (fmt.Sprintf("%.1f MB", ...)), so a size looks
// the same wherever it appears in the Workshop UI.
func cacheEntrySize(sizeBytes int64) string {
	if sizeBytes <= 0 {
		return "Unknown"
	}
	return fmt.Sprintf("%.1f MB", float64(sizeBytes)/1048576)
}

// cacheEntryVerifiedLabel is the thing an Admin is actually reading this
// page for (issue #2185): a rendered staleness, not a raw timestamp.
// LastVerifiedAt == 0 means the entry has never been verified (see
// WorkshopCacheEntry proto doc), which is a distinct, worth-calling-out
// state from "verified a very long time ago" -- so it gets its own label
// rather than falling through to timeAgo's "Never".
func cacheEntryVerifiedLabel(lastVerifiedAt int64) string {
	if lastVerifiedAt == 0 {
		return "never verified"
	}
	return "verified " + timeAgo(lastVerifiedAt)
}

// WorkshopCacheBladeData backs the Cache Blade rendered over the Workshop
// top-level page (root plan #2359, task #2362 -- FR7, C35): the same
// fleet-wide cache visibility as WorkshopCachePageData above, but as a
// components.Blade fragment opened via hx-get from "/workshop" rather than
// a full-page navigation to "/workshop/cache" (acceptance criterion 2 --
// cache-backed install must be executable from "/workshop" with no
// navigation away). AddonName is resolved by the handler the same
// best-effort way handleWorkshopCache resolves it for the breadcrumb.
type WorkshopCacheBladeData struct {
	AddonID        int64
	AddonName      string
	Entries        []*manmanpb.WorkshopCacheEntry
	VerifyState    string
	VerifyServerID int64
	// EvictError carries a just-failed evict's message back into the blade
	// body (handleWorkshopCacheEvict's HX-Request branch) -- distinct from
	// VerifyState/VerifyServerID, which only ever describe a verify
	// dispatch outcome.
	EvictError string
}

// workshopCacheBladeBodyID is the DOM id both the initial WorkshopCacheBlade
// open and every subsequent verify/evict hx-post response target: verify
// and evict swap only this inner div (hx-swap="outerHTML"), never the
// surrounding components.Blade shell/script, so the Blade's scrim/Escape/
// focus-trap mount (see blade.templ's doc comment) never re-runs on a
// verify/evict round trip.
const workshopCacheBladeBodyID = "workshop-cache-blade-body"

// WorkshopCacheBlade is the Cache Blade shell, opened via hx-get to
// "/workshop/cache-blade?addon_id=..." (hx-target="body"
// hx-swap="beforeend", the same zero-pre-render pattern the Config Editor
// blade uses -- see handleGameConfigEditorGet's doc comment) from the
// Workshop top-level page's Cache section.
templ WorkshopCacheBlade(data WorkshopCacheBladeData) {
	@components.Blade(components.BladeData{
		ID:    "workshop-cache-blade",
		Title: "Cache: " + data.AddonName,
	}) {
		@WorkshopCacheBladeBody(data)
	}
}

// WorkshopCacheBladeBody is the Blade's swappable inner content: the same
// verify-outcome banners and cache-entries table as the full-page
// WorkshopCache view, but with hx-post verify/evict forms that swap this
// div in place (see workshopCacheBladeBodyID's doc comment) instead of the
// plain-POST full-page-redirect forms WorkshopCache above uses -- exported
// so handleWorkshopCacheVerify/handleWorkshopCacheEvict can render it
// directly as an HX-Request response, without going through WorkshopCache's
// full-page Layout wrapper.
templ WorkshopCacheBladeBody(data WorkshopCacheBladeData) {
	<div id={ workshopCacheBladeBodyID }>
		if data.VerifyState == "dispatched" {
			<div class="alert alert-success mb-4">
				<span>Verify dispatched to server { fmt.Sprintf("%d", data.VerifyServerID) }. The up-to-date/changed outcome will appear here after the next reload.</span>
			</div>
		}
		if data.VerifyState == "no_host_available" {
			<div class="alert alert-info mb-4">
				<span>No host currently holds a copy of this entry, so the verify could not be dispatched.</span>
			</div>
		}
		if data.VerifyState == "error" {
			<div class="alert alert-warning mb-4">
				<span>Could not dispatch the verify request. Please try again.</span>
			</div>
		}
		if data.EvictError != "" {
			<div class="alert alert-warning mb-4">
				<span>{ data.EvictError }</span>
			</div>
		}
		<div class="bg-base-100 rounded-box border border-base-300 overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>Content Address</th>
						<th>Size</th>
						<th>Created</th>
						<th>Last Verified</th>
						<th>Hosts</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range data.Entries {
						<tr>
							<td class="font-mono text-xs">{ entry.ContentVersion }</td>
							<td>{ cacheEntrySize(entry.SizeBytes) }</td>
							<td class="text-sm">{ timeAgo(entry.CreatedAt) } <span class="text-base-content/60">({ formatTime(entry.CreatedAt) })</span></td>
							<td class="text-sm">{ cacheEntryVerifiedLabel(entry.LastVerifiedAt) }</td>
							<td>
								if len(entry.Hosts) == 0 {
									<span class="text-xs text-base-content/60">No hosts reported</span>
								}
								for _, host := range entry.Hosts {
									<div class="text-xs">
										<span class="font-medium">{ host.ServerName }</span>
										<span class="text-base-content/60">— last seen { timeAgo(host.LastSeenAt) }</span>
									</div>
								}
							</td>
							<td>
								<div class="flex gap-2 items-center justify-end">
									<form hx-post="/workshop/cache/verify" hx-target={ "#" + workshopCacheBladeBodyID } hx-swap="outerHTML">
										<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", data.AddonID) }/>
										<input type="hidden" name="cache_entry_id" value={ fmt.Sprintf("%d", entry.CacheEntryId) }/>
										<button type="submit" class="btn btn-xs btn-outline">Verify now</button>
									</form>
									<div x-data="{ confirmEvict: false }" class="flex gap-2 items-center justify-end">
										<button x-show="!confirmEvict" @click="confirmEvict = true" class="btn btn-error btn-xs">Evict</button>
										<div x-show="confirmEvict" x-cloak class="flex gap-2 items-center">
											<span class="text-xs text-error font-medium">Evict { entry.ContentVersion }?</span>
											<form hx-post="/workshop/cache/evict" hx-target={ "#" + workshopCacheBladeBodyID } hx-swap="outerHTML" class="inline">
												<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", data.AddonID) }/>
												<input type="hidden" name="cache_entry_id" value={ fmt.Sprintf("%d", entry.CacheEntryId) }/>
												<button type="submit" class="btn btn-error btn-xs">Yes, Evict</button>
											</form>
											<button @click="confirmEvict = false" class="btn btn-secondary btn-xs">Cancel</button>
										</div>
									</div>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(data.Entries) == 0 {
				<div class="text-center py-12 text-base-content/60">No cache entries for this addon</div>
			}
		</div>
	</div>
}

templ WorkshopCache(data WorkshopCachePageData) {
	@components.Layout(data.Layout) {
		<div class="rounded-box p-6 md:p-8 mb-6 shadow-lg" style="background: linear-gradient(to bottom right, var(--color-primary), var(--color-secondary));">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
				<div class="text-primary-content">
					<h1 class="text-2xl md:text-3xl font-bold mb-2">Workshop Cache</h1>
					<p class="text-primary-content/80 text-sm">Fleet-wide cache entries, hosts, and staleness for this addon</p>
				</div>
				<div class="flex flex-wrap gap-2">
					<a href={ templ.URL(fmt.Sprintf("/workshop/addon?addon_id=%d", data.AddonID)) } class="btn bg-primary-content/20 hover:bg-primary-content/30 text-primary-content border-primary-content/30">← Addon</a>
					<!-- Same M4 boundary as the batch-status view: manual reload only, no SSE/polling/hx-trigger. -->
					<a
						href="#"
						onclick="window.location.reload(); return false;"
						class="btn bg-base-100 hover:bg-base-200 text-primary border-none"
					>Refresh</a>
				</div>
			</div>
		</div>
		if data.VerifyState == "dispatched" {
			<div class="alert alert-success mb-4">
				<span>Verify dispatched to server { fmt.Sprintf("%d", data.VerifyServerID) }. The up-to-date/changed outcome will appear here after the next reload.</span>
			</div>
		}
		if data.VerifyState == "no_host_available" {
			<div class="alert alert-info mb-4">
				<span>No host currently holds a copy of this entry, so the verify could not be dispatched.</span>
			</div>
		}
		if data.VerifyState == "error" {
			<div class="alert alert-warning mb-4">
				<span>Could not dispatch the verify request. Please try again.</span>
			</div>
		}
		<div class="bg-base-100 rounded-box border border-base-300 overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>Content Address</th>
						<th>Size</th>
						<th>Created</th>
						<th>Last Verified</th>
						<th>Hosts</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range data.Entries {
						<tr>
							<td class="font-mono text-xs">{ entry.ContentVersion }</td>
							<td>{ cacheEntrySize(entry.SizeBytes) }</td>
							<td class="text-sm">{ timeAgo(entry.CreatedAt) } <span class="text-base-content/60">({ formatTime(entry.CreatedAt) })</span></td>
							<td class="text-sm">{ cacheEntryVerifiedLabel(entry.LastVerifiedAt) }</td>
							<td>
								if len(entry.Hosts) == 0 {
									<span class="text-xs text-base-content/60">No hosts reported</span>
								}
								for _, host := range entry.Hosts {
									<div class="text-xs">
										<span class="font-medium">{ host.ServerName }</span>
										<span class="text-base-content/60">— last seen { timeAgo(host.LastSeenAt) }</span>
									</div>
								}
							</td>
							<td>
								<div class="flex gap-2 items-center justify-end">
									<form method="post" action="/workshop/cache/verify">
										<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", data.AddonID) }/>
										<input type="hidden" name="cache_entry_id" value={ fmt.Sprintf("%d", entry.CacheEntryId) }/>
										<button type="submit" class="btn btn-xs btn-outline">Verify now</button>
									</form>
									<div x-data="{ confirmEvict: false }" class="flex gap-2 items-center justify-end">
										<button x-show="!confirmEvict" @click="confirmEvict = true" class="btn btn-error btn-xs">Evict</button>
										<div x-show="confirmEvict" x-cloak class="flex gap-2 items-center">
											<span class="text-xs text-error font-medium">Evict { entry.ContentVersion }?</span>
											<form method="POST" action="/workshop/cache/evict" class="inline">
												<input type="hidden" name="addon_id" value={ fmt.Sprintf("%d", data.AddonID) }/>
												<input type="hidden" name="cache_entry_id" value={ fmt.Sprintf("%d", entry.CacheEntryId) }/>
												<button type="submit" class="btn btn-error btn-xs">Yes, Evict</button>
											</form>
											<button @click="confirmEvict = false" class="btn btn-secondary btn-xs">Cancel</button>
										</div>
									</div>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(data.Entries) == 0 {
				<div class="text-center py-12 text-base-content/60">No cache entries for this addon</div>
			}
		</div>
	}
}
