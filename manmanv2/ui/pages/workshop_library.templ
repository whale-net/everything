package pages

import (
	"fmt"
	"github.com/whale-net/everything/manmanv2/ui/components"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
)

type WorkshopLibraryPageData struct {
	Layout       components.LayoutData
	Games        []*manmanpb.Game
	Libraries    []*manmanpb.WorkshopLibrary
	RecentAddons []*manmanpb.WorkshopAddon
	Addons       []*manmanpb.WorkshopAddon
}

templ WorkshopLibrary(data WorkshopLibraryPageData) {
	@components.Layout(data.Layout) {
		<style>
			[x-cloak] { display: none !important; }
		</style>
		<div x-data="{ showAddAddon: false, showCreateLibrary: false }">
			<!-- Hero Header -->
			<div class="rounded-box p-6 md:p-8 mb-6 shadow-lg" style="background: linear-gradient(to bottom right, var(--color-primary), var(--color-secondary));">
				<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
					<div class="text-primary-content">
						<h1 class="text-2xl md:text-3xl font-bold mb-2">Workshop Library</h1>
						<p class="text-primary-content/80 text-sm">Manage addon libraries and workshop content for your game servers</p>
					</div>
					<div class="flex flex-wrap gap-2">
						<a href="/workshop/search" class="btn bg-primary-content/20 hover:bg-primary-content/30 text-primary-content border-primary-content/30">Search</a>
						<button @click="showAddAddon = !showAddAddon; showCreateLibrary = false" class="btn bg-primary-content/20 hover:bg-primary-content/30 text-primary-content border-primary-content/30">
							<span x-text="showAddAddon ? '✕ Cancel' : '+ Add Addon'">+ Add Addon</span>
						</button>
						<button @click="showCreateLibrary = !showCreateLibrary; showAddAddon = false" class="btn bg-base-100 hover:bg-base-200 text-primary border-none">
							<span x-text="showCreateLibrary ? '✕ Cancel' : '+ New Library'">+ New Library</span>
						</button>
					</div>
				</div>
			</div>
			<!-- Add Addon Form -->
			<div x-show="showAddAddon" x-cloak x-transition class="card bg-base-100 shadow-md border-2 border-primary/40 p-6 mb-6">
				<div class="flex justify-between items-center mb-4 pb-4 border-b border-base-300">
					<h3 class="text-lg font-semibold text-base-content">Fetch Addon from Steam Workshop</h3>
					<button @click="showAddAddon = false" class="btn btn-secondary btn-sm">Cancel</button>
				</div>
				<form hx-post="/workshop/fetch-metadata" hx-target="#addAddonResult" hx-swap="innerHTML" class="grid grid-cols-1 md:grid-cols-4 gap-4">
					<div>
						<label class="block text-sm font-medium text-base-content mb-2">Game</label>
						<select name="game_id" required class="select select-bordered w-full">
							for _, game := range data.Games {
								<option value={ fmt.Sprintf("%d", game.GameId) }>{ game.Name }</option>
							}
						</select>
					</div>
					<div>
						<label class="block text-sm font-medium text-base-content mb-2">Workshop ID</label>
						<input type="text" name="workshop_id" required placeholder="e.g., 2938285337" class="input input-bordered w-full"/>
					</div>
					<div>
						<label class="block text-sm font-medium text-base-content mb-2">Platform</label>
						<select name="platform_type" required class="select select-bordered w-full">
							<option value="steam_workshop">Steam Workshop</option>
						</select>
					</div>
					<div class="flex items-end">
						<button type="submit" class="w-full btn btn-primary">Fetch</button>
					</div>
				</form>
				<div id="addAddonResult" class="mt-4"></div>
			</div>
			<!-- Create Library Form -->
			<div x-show="showCreateLibrary" x-cloak x-transition class="card bg-base-100 shadow-md border-2 border-primary/40 p-6 mb-6">
				<div class="flex justify-between items-center mb-4 pb-4 border-b border-base-300">
					<h3 class="text-lg font-semibold text-base-content">Create New Library</h3>
					<button @click="showCreateLibrary = false" class="btn btn-secondary btn-sm">Cancel</button>
				</div>
				<form method="POST" action="/workshop/create-library" class="space-y-4">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-base-content mb-2">Game *</label>
							<select name="game_id" required class="select select-bordered w-full">
								for _, game := range data.Games {
									<option value={ fmt.Sprintf("%d", game.GameId) }>{ game.Name }</option>
								}
							</select>
						</div>
						<div>
							<label class="block text-sm font-medium text-base-content mb-2">Name *</label>
							<input type="text" name="name" required placeholder="e.g., Essential Maps" class="input input-bordered w-full"/>
						</div>
					</div>
					<div>
						<label class="block text-sm font-medium text-base-content mb-2">Description</label>
						<input type="text" name="description" placeholder="Optional" class="input input-bordered w-full"/>
					</div>
					<button type="submit" class="btn btn-primary">Create Library</button>
				</form>
			</div>
			<!-- Libraries Section -->
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-xl font-bold text-base-content">Libraries <span class="text-sm font-normal text-base-content/60">({ fmt.Sprintf("%d", len(data.Libraries)) })</span></h2>
				<a href="/workshop/search?type=library" class="text-sm link link-primary">Browse all →</a>
			</div>
			if len(data.Libraries) > 0 {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
					for _, lib := range data.Libraries {
						<a href={ templ.URL(fmt.Sprintf("/workshop/library-detail?library_id=%d", lib.LibraryId)) } class="block bg-base-100 rounded-box border border-base-300 p-5 hover:shadow-lg hover:-translate-y-0.5 transition-all">
							<div class="flex justify-between items-start mb-2 gap-2">
								<span class="font-semibold text-base-content">{ lib.Name }</span>
								for _, game := range data.Games {
									if game.GameId == lib.GameId {
										<span class="badge badge-primary badge-soft whitespace-nowrap">{ game.Name }</span>
									}
								}
							</div>
							<div class="text-sm text-base-content/60 mb-3 line-clamp-2">
								if lib.Description != "" {
									{ lib.Description }
								} else {
									<em class="text-base-content/40">No description</em>
								}
							</div>
							<div class="flex justify-between items-center text-xs text-base-content/60">
								<span>{ timeAgo(lib.UpdatedAt) }</span>
							</div>
						</a>
					}
				</div>
			} else {
				<div class="bg-base-100 rounded-box border border-base-300 p-12 text-center mb-8">
					<div class="text-6xl mb-4">📚</div>
					<h3 class="text-lg font-semibold text-base-content mb-2">No libraries yet</h3>
					<p class="text-base-content/60 mb-4">Create a library to organize your addons into reusable collections.</p>
					<button @click="showCreateLibrary = true" class="btn btn-primary">Create Library</button>
				</div>
			}
			<!-- Recent Addons Section -->
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-xl font-bold text-base-content">Recent Addons <span class="text-sm font-normal text-base-content/60">({ fmt.Sprintf("%d total", len(data.Addons)) })</span></h2>
				<a href="/workshop/search?type=addon" class="text-sm link link-primary">Browse all →</a>
			</div>
			if len(data.RecentAddons) > 0 {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
					for _, addon := range data.RecentAddons {
						<a href={ templ.URL(fmt.Sprintf("/workshop/addon?addon_id=%d", addon.AddonId)) } class="block bg-base-100 rounded-box border border-base-300 p-4 hover:shadow-md transition-shadow">
							<div class="font-semibold text-base-content text-sm mb-2">{ addon.Name }</div>
							<div class="badge badge-neutral badge-soft font-mono mb-3">{ addon.WorkshopId }</div>
							<div class="flex justify-between items-center text-xs text-base-content/60">
								<span>
									for _, game := range data.Games {
										if game.GameId == addon.GameId {
											{ game.Name }
										}
									}
								</span>
								<div class="flex items-center gap-2">
									if addon.FileSizeBytes > 0 {
										<span>{ fmt.Sprintf("%.1f MB", float64(addon.FileSizeBytes)/1048576) }</span>
									}
									if addon.IsCollection {
										<span class="badge badge-primary badge-soft">Collection</span>
									} else {
										<span class="badge badge-info badge-soft">Addon</span>
									}
								</div>
							</div>
						</a>
					}
				</div>
			} else {
				<div class="bg-base-100 rounded-box border border-base-300 p-12 text-center">
					<div class="text-6xl mb-4">🧩</div>
					<h3 class="text-lg font-semibold text-base-content mb-2">No addons yet</h3>
					<p class="text-base-content/60 mb-4">Fetch addon metadata from Steam Workshop to get started.</p>
					<button @click="showAddAddon = true" class="btn btn-primary">Add Addon</button>
				</div>
			}
		</div>
	}
}
