package pages

import (
	"fmt"

	"github.com/whale-net/everything/manmanv2/ui/components"
)

// WorkshopLibraryConflictsPageData backs the SGC->GameConfig library
// migration conflict resolution page (FR12, US6, task #2368), registered
// at "/workshop/conflicts". Every unresolved conflict from
// ListLibraryMigrationConflicts (#2365) is rendered here so a Server
// Manager can choose union or override -- see #2359's Out of scope note
// for why those are the only two resolutions and there is no third,
// per-item manual merge option.
type WorkshopLibraryConflictsPageData struct {
	Layout    components.LayoutData
	Conflicts []ConflictViewData
	// ResolutionError surfaces a rejected /workshop/conflicts/resolve
	// submission inline (a stale/already-resolved conflict's
	// FailedPrecondition, or a client that bypassed the override radio
	// group's required attribute) -- issue #2368's Logging note: this is
	// expected control flow, not a 500, so it renders as a normal alert
	// rather than an error page. Empty means the page loaded cleanly.
	ResolutionError string
}

// ConflictViewData is one WorkshopLibraryMigrationConflict rendered for
// resolution: which GameConfig it belongs to, and per candidate, which
// library and which deployment attached it -- a Server Manager cannot
// choose sensibly from library names alone (issue #2368's Implementation
// note).
type ConflictViewData struct {
	ConflictID int64
	ConfigID   int64
	ConfigName string
	GameName   string
	Candidates []ConflictCandidateViewData
}

// ConflictCandidateViewData is one (library, deployment) pair contributing
// to a conflict -- resolved from WorkshopLibraryMigrationConflictCandidate's
// (library_id, sgc_id) pair by handleWorkshopLibraryConflicts
// (handlers_workshop_conflicts.go) so this page never renders a bare id.
type ConflictCandidateViewData struct {
	LibraryID      int64
	LibraryName    string
	SGCID          int64
	DeploymentName string // "<config> on <server>", matching games.templ's naming (FR2)
}

// WorkshopLibraryConflictsPage is the FR12/US6 resolution surface: for
// each unresolved conflict, which candidate libraries came from which
// deployments, and the union/override controls to resolve it
// (conflictCard).
templ WorkshopLibraryConflictsPage(data WorkshopLibraryConflictsPageData) {
	@components.Layout(data.Layout) {
		@components.HeroHeader("Library Migration Conflicts", "SGC-level Workshop library attachments that disagreed when migrated to GameConfig level -- choose union or override for each") {
		}
		if data.ResolutionError != "" {
			<div role="alert" class="alert alert-warning mb-4">{ data.ResolutionError }</div>
		}
		if len(data.Conflicts) == 0 {
			<div class="bg-base-100 rounded-box border border-base-300 p-12 text-center">
				<div class="text-6xl mb-4">✅</div>
				<h3 class="text-lg font-semibold text-base-content mb-2">No unresolved conflicts</h3>
				<p class="text-base-content/60">Every GameConfig's migrated Workshop library set is settled.</p>
			</div>
		} else {
			<div class="flex flex-col gap-4">
				for _, conflict := range data.Conflicts {
					@conflictCard(conflict)
				}
			</div>
		}
	}
}

// conflictCard renders one conflict: its GameConfig, one row per candidate
// naming the library and the deployment it came from (FR12's acceptance
// criterion 1 -- nothing is silently dropped or guessed), and the
// union/override resolution controls (acceptance criterion 2). Exactly
// two forms are rendered -- no third option, matching #2359's Out of
// scope note.
//
// Union posts resolution="union" with no keep_library_id: every candidate
// library becomes the GameConfig's attached set, so it discards nothing
// and needs no confirmation.
//
// Override requires picking exactly one candidate via a native radio
// group (name="keep_library_id", each option `required`) -- submitting
// with nothing selected is rejected client-side by the browser before any
// request is sent (issue #2368's Testing section: "override with no
// selection ... never silently submitted"). The submit button's
// `onclick="return confirm(...)"` states plainly that every other
// candidate is discarded, matching the plain-`<form>` confirm precedent
// used elsewhere for destructive actions (e.g. config_detail.templ's
// "Delete this volume?"), since this page's forms are plain POSTs rather
// than htmx (no hx-confirm available).
templ conflictCard(conflict ConflictViewData) {
	<div class="card bg-base-100 border border-base-300 shadow-sm p-4">
		<div class="flex justify-between items-center mb-3">
			<div>
				<h3 class="font-semibold text-base-content">{ conflict.ConfigName }</h3>
				<p class="text-sm text-base-content/60">{ conflict.GameName }</p>
			</div>
		</div>
		<table class="table table-sm mb-4">
			<thead>
				<tr>
					<th></th>
					<th>Library</th>
					<th>Source deployment</th>
				</tr>
			</thead>
			<tbody>
				for _, candidate := range conflict.Candidates {
					<tr>
						<td>
							<input
								type="radio"
								form={ fmt.Sprintf("override-form-%d", conflict.ConflictID) }
								name="keep_library_id"
								value={ fmt.Sprintf("%d", candidate.LibraryID) }
								id={ fmt.Sprintf("keep-%d-%d", conflict.ConflictID, candidate.LibraryID) }
								required
								class="radio radio-sm"
							/>
						</td>
						<td>
							<label for={ fmt.Sprintf("keep-%d-%d", conflict.ConflictID, candidate.LibraryID) }>{ candidate.LibraryName }</label>
						</td>
						<td>{ candidate.DeploymentName }</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="flex flex-wrap items-center gap-3">
			<form method="POST" action="/workshop/conflicts/resolve">
				<input type="hidden" name="conflict_id" value={ fmt.Sprintf("%d", conflict.ConflictID) }/>
				<input type="hidden" name="resolution" value="union"/>
				<button type="submit" class="btn btn-primary btn-sm">
					Union -- attach all { fmt.Sprintf("%d", len(conflict.Candidates)) } candidates
				</button>
			</form>
			<form id={ fmt.Sprintf("override-form-%d", conflict.ConflictID) } method="POST" action="/workshop/conflicts/resolve">
				<input type="hidden" name="conflict_id" value={ fmt.Sprintf("%d", conflict.ConflictID) }/>
				<input type="hidden" name="resolution" value="override"/>
				<button
					type="submit"
					onclick="return confirm('This keeps only the selected library and discards every other candidate library for this GameConfig. Continue?')"
					class="btn btn-outline btn-error btn-sm"
				>
					Override -- keep only the selected library
				</button>
			</form>
		</div>
		<p class="text-xs text-base-content/60 mt-2">
			Union attaches every candidate library above. Override keeps only the library you select and discards the rest for this GameConfig.
		</p>
	</div>
}
