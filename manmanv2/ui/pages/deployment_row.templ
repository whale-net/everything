package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	"github.com/whale-net/everything/manmanv2/events"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

// DeploymentRowData is everything one deployment row needs to render itself,
// standalone (HTMX fragment) or inside a table (the Games page's
// per-deployment row, pages/games.templ's gameDeploymentRow). Originally
// pages/sessions.templ's shared piece; moved to its own file by task #2372
// (M6 navigation/disposition) when the /sessions list page itself retired
// (FR17) -- DeploymentRow/DeploymentRowInner are not list-page-specific and
// are still reached from Games and the #1628/#1627 action/refresh
// endpoints (handlers_deployment_actions.go), so they survive the page's
// removal unchanged.
type DeploymentRowData struct {
	ServerGameConfigID int64
	DisplayName        string
	SGCStatus          string            // ServerGameConfig.Status (deploy state)
	LatestSession      *manmanpb.Session // nil when never started
	LiveSession        *manmanpb.Session // nil when not live
	Actions            components.DeploymentActions
	ActionError        string // FR8 inline error; "" when none
	// RestartState is the latest pending_restarts record for this SGC
	// within the visibility window (FR12, #1735), or nil when there is no
	// restart in flight/recently resolved to surface. Populated by the
	// caller from one batched ListPendingRestarts RPC per page render, not
	// a per-row call.
	RestartState *manmanpb.PendingRestartState
}

// deploymentRowPollAttrs returns the row's self-terminating poll wiring
// (FR7, #1628): hx-get/hx-trigger/hx-target/hx-swap are present only when
// the row's latest session is in a components.IsTransientStatus state
// (pending/starting/stopping). Because the endpoint's response is itself a
// DeploymentRow (#1628's GET /api/deployments/{sgcID}/row), a settled
// row's next render comes back without these attributes and the polling
// loop stops on its own -- no client-side timer bookkeeping, and this is
// independent of ActionError: a row with an inline action error still
// polls (and the error clears) as long as the underlying status is still
// transient.
//
// #1726 decision (kept unchanged, see that issue's Implementation section
// point 4): this poll stays as the live-updates fallback and costs nothing
// once SSE is live. Two consequences of the SSE inner-swap only ever
// touching DeploymentRowInner's <td>s (never the <tr> itself, see
// DeploymentRowInner's doc comment):
//   - An SSE delivery cannot add or remove these hx-* attributes on the
//     <tr>. A row that settles via a pushed SSE update keeps polling until
//     its *next* poll tick returns a settled row and drops the attrs --
//     self-healing within one 3s interval, not instantaneous. Acceptable
//     and intentional; do not "fix" by trying to have the SSE fragment
//     also carry hx-* attributes.
//   - Conversely a polled whole-row replacement (outerHTML) *does* replace
//     the <tr>, including its sse-swap attribute -- DeploymentRow must keep
//     emitting sse-swap unconditionally (below) so a polled row stays a
//     valid SSE swap target under the page's hx-ext="sse" ancestor.
func deploymentRowPollAttrs(data DeploymentRowData) templ.Attributes {
	if !components.IsTransientStatus(data.LatestSession.GetStatus()) {
		return templ.Attributes{}
	}
	return templ.Attributes{
		"hx-get":     fmt.Sprintf("/api/deployments/%d/row", data.ServerGameConfigID),
		"hx-trigger": "every 3s",
		"hx-target":  "this",
		"hx-swap":    "outerHTML",
	}
}

// DeploymentRow renders a single deployment's <tr>, keyed by the stable
// "deployment-row-<sgcID>" id that the action endpoints (#1627) and the
// refresh endpoint (#1628) target as their HTMX swap target. Cell content
// lives in DeploymentRowInner so both whole-row swaps (this component) and
// future inner-swap responses can reuse it.
//
// sse-swap is set unconditionally to events.TopicForDeployment (#1726,
// FR2) -- via the shared manmanv2/events helper, never a locally formatted
// literal, so the producer (handlers_sessions_live.go), this consumer
// attribute, and the DOM id can't drift independently. Emitting it here
// (not just in the page's initial rendering) matters because this same
// component also renders the #1628 poll's outerHTML replacement
// (handleDeploymentRowFragment) and the action endpoints' post-action
// replacement (handlers_deployment_actions.go) -- both must keep the row a
// valid SSE swap target, or a polled/acted-on row would go silently dead to
// further live pushes until the next full page load.
templ DeploymentRow(data DeploymentRowData) {
	<tr
		id={ fmt.Sprintf("deployment-row-%d", data.ServerGameConfigID) }
		class="hover"
		sse-swap={ events.TopicForDeployment(data.ServerGameConfigID) }
		{ deploymentRowPollAttrs(data)... }
	>
		@DeploymentRowInner(data)
	</tr>
}

// DeploymentRowInner renders just the <td>s for a deployment row: display
// name, status (with a session-status badge, or "Never started" when the
// deployment has no session yet), live session link, and the Start/Stop/
// Restart actions cell. Availability of each action control comes entirely
// from data.Actions (components.ComputeDeploymentActions, #1625) -- no
// status-string comparisons here decide which button shows.
//
// The RestartBadge rendered below (components.RestartBadge, lifted out in
// M5's #2268) is FR17's "restart-state badge" retained-capability
// requirement: this same component renders inside the Games page's row
// (pages/games.templ's gameDeploymentRow -> @DeploymentRow(dep.Row)), so
// the badge survives the /sessions list page's retirement automatically --
// verified present on Games rather than assumed, per task #2372's issue
// body.
templ DeploymentRowInner(data DeploymentRowData) {
	<td class="text-sm">
		if data.DisplayName != "" {
			{ data.DisplayName }
		} else {
			{ fmt.Sprintf("SGC %d", data.ServerGameConfigID) }
		}
	</td>
	<td class="text-sm">
		{ data.SGCStatus }
		if data.LatestSession != nil {
			@htmxui.Badge(data.LatestSession.Status, statusBadgeVariant(sessionStatusVariant(data.LatestSession.Status)), htmxui.BadgeSizeSM, true, nil)
		} else {
			@htmxui.Badge("Never started", htmxui.BadgeNeutral, htmxui.BadgeSizeSM, true, nil)
		}
		if label, variant, title, show := components.RestartBadge(data.RestartState); show {
			if title != "" {
				@htmxui.Badge(label, variant, htmxui.BadgeSizeSM, true, templ.Attributes{"title": title})
			} else {
				@htmxui.Badge(label, variant, htmxui.BadgeSizeSM, true, nil)
			}
		}
	</td>
	<td class="text-sm">
		if data.LiveSession != nil {
			<a href={ templ.URL(fmt.Sprintf("/sessions/%d", data.LiveSession.SessionId)) } class="btn btn-primary btn-sm">View Live Session</a>
		} else {
			@htmxui.Badge("None", htmxui.BadgeNeutral, htmxui.BadgeSizeSM, true, nil)
		}
	</td>
	// Actions cell: intentionally kept on the same Alpine.js x-show /
	// click-handler reveal-then-confirm interaction as sgc_detail.templ's
	// Danger Zone (see that file's comment). Stop and Restart both
	// interrupt a live game process, so both are confirm-gated; Start is
	// not. Do not adopt htmxui.Confirm here: its always-visible
	// single-submit shape is a different interaction than this
	// click-to-reveal gate, and daisyui_migration_test.go already guards
	// that distinction elsewhere on this page family.
	<td class="text-sm" x-data="{ confirmStop: false, confirmRestart: false }">
		<div class="flex flex-col gap-2 items-start">
			if data.Actions.CanStart {
				<form
					method="POST"
					action={ templ.URL(fmt.Sprintf("/sessions/deployments/%d/start", data.ServerGameConfigID)) }
					hx-post={ fmt.Sprintf("/sessions/deployments/%d/start", data.ServerGameConfigID) }
					hx-target={ fmt.Sprintf("#deployment-row-%d", data.ServerGameConfigID) }
					hx-swap="outerHTML"
					class="inline"
				>
					<button type="submit" class="btn btn-success btn-sm">Start</button>
				</form>
			}
			if data.Actions.CanStop {
				<div>
					<button type="button" x-show="!confirmStop" @click="confirmStop = true" class="btn btn-warning btn-sm">Stop</button>
					<div x-show="confirmStop" x-cloak class="flex gap-2 items-center">
						<span class="text-sm text-warning font-medium">Stop now?</span>
						<form
							method="POST"
							action={ templ.URL(fmt.Sprintf("/sessions/deployments/%d/stop", data.ServerGameConfigID)) }
							hx-post={ fmt.Sprintf("/sessions/deployments/%d/stop", data.ServerGameConfigID) }
							hx-target={ fmt.Sprintf("#deployment-row-%d", data.ServerGameConfigID) }
							hx-swap="outerHTML"
							class="inline"
						>
							<button type="submit" class="btn btn-warning btn-sm">Yes, Stop</button>
						</form>
						<button type="button" @click="confirmStop = false" class="btn btn-secondary btn-sm">Cancel</button>
					</div>
				</div>
			}
			if data.Actions.CanRestart {
				<div>
					<button type="button" x-show="!confirmRestart" @click="confirmRestart = true" class="btn btn-info btn-sm">Restart</button>
					<div x-show="confirmRestart" x-cloak class="flex gap-2 items-center">
						<span class="text-sm text-info font-medium">Restart now?</span>
						<form
							method="POST"
							action={ templ.URL(fmt.Sprintf("/sessions/deployments/%d/restart", data.ServerGameConfigID)) }
							hx-post={ fmt.Sprintf("/sessions/deployments/%d/restart", data.ServerGameConfigID) }
							hx-target={ fmt.Sprintf("#deployment-row-%d", data.ServerGameConfigID) }
							hx-swap="outerHTML"
							class="inline"
						>
							<button type="submit" class="btn btn-info btn-sm">Yes, Restart</button>
						</form>
						<button type="button" @click="confirmRestart = false" class="btn btn-secondary btn-sm">Cancel</button>
					</div>
				</div>
			}
			if !data.Actions.CanStart && !data.Actions.CanStop && !data.Actions.CanRestart {
				<span class="text-base-content/40">&mdash;</span>
			}
		</div>
		if data.ActionError != "" {
			<div role="alert" class="alert alert-error alert-sm mt-2">
				<span class="text-xs">{ data.ActionError }</span>
			</div>
		}
	</td>
}

func sessionStatusVariant(status string) string {
	switch status {
	case "running":
		return "success"
	case "starting":
		return "warning"
	case "stopping":
		return "warning"
	case "stopped":
		return "secondary"
	case "error", "crashed":
		return "danger"
	default:
		return "secondary"
	}
}
