package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	"github.com/whale-net/everything/manmanv2/events"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

type SessionsPageData struct {
	Sessions            []*manmanpb.Session
	SGCDisplayNames     map[int64]string
	SelectedServerID    string
	LiveOnly            bool
	StatusFilter        string
	ServerGameConfigID  string
	SGCOptions          []SGCDisplayInfo
	StartWarning        string
	StartError          string
	ShowForce           bool
	ForceSGCID          string
	ServerConfigs       []*manmanpb.ServerGameConfig
	LiveSessionByConfig map[int64]*manmanpb.Session
	DeploymentRows      []DeploymentRowData

	// HeartbeatIntervalMs is the resolved MANMANV2_SSE_HEARTBEAT_INTERVAL
	// (main.go's Config.SSEHeartbeatInterval), in milliseconds, for the
	// #1726 Not-Live debounce: the client waits one heartbeat interval
	// after htmx:sseError/htmx:sseClose (or a missed heartbeat) before
	// flipping the indicator, so a single dropped beat doesn't flap it.
	HeartbeatIntervalMs int
	// LiveUpdatesEnabled is false when app.sseHub is nil (RABBITMQ_URL
	// unset or the broker was unreachable at startup -- see main.go's
	// initializeSSEHub doc comment, NFR3/NFR8). The live-connection
	// markup (hx-ext="sse", sse-connect, sse-swap, the Live/Not-Live
	// indicator) is omitted entirely in that case rather than rendered
	// pointing at a route that will only ever 503: the page still renders
	// its server-side snapshot and falls back to the #1628 per-row poll.
	LiveUpdatesEnabled bool
}

type SGCDisplayInfo struct {
	ServerGameConfigId int64
	DisplayName        string
}

// DeploymentRowData is everything one deployment row needs to render itself,
// standalone (HTMX fragment) or inside GSCStatusTable.
type DeploymentRowData struct {
	ServerGameConfigID int64
	DisplayName        string
	SGCStatus          string            // ServerGameConfig.Status (deploy state)
	LatestSession      *manmanpb.Session // nil when never started
	LiveSession        *manmanpb.Session // nil when not live
	Actions            components.DeploymentActions
	ActionError        string // FR8 inline error; "" when none
}

templ Sessions(layout components.LayoutData, data SessionsPageData) {
	@components.Layout(layout) {
		@components.HeroHeader("Sessions", "Manage game server sessions and deployments")
		if data.SelectedServerID != "" {
			<div role="alert" class="alert alert-info mb-4">
				<span><strong>Server scope:</strong> Viewing sessions for the server selected in the top navigation bar.</span>
			</div>
		}
		@SessionFilters(data.StatusFilter, data.ServerGameConfigID, data.LiveOnly, data.SGCOptions)
		@StartSessionPanel(data.SelectedServerID, data.SGCOptions, data.StartWarning, data.StartError, data.ShowForce, data.ForceSGCID)
		if len(data.DeploymentRows) > 0 {
			if data.LiveUpdatesEnabled {
				@DeploymentsLiveRegion(data.HeartbeatIntervalMs) {
					@GSCStatusTable(data.DeploymentRows)
				}
			} else {
				@GSCStatusTable(data.DeploymentRows)
			}
		}
		if len(data.Sessions) > 0 {
			@SessionsTable(data.Sessions, data.SGCDisplayNames)
		} else {
			@components.EmptyState("No sessions found", "No sessions found for the selected filters.", "", "")
		}
	}
}

templ SessionFilters(statusFilter, serverGameConfigID string, liveOnly bool, sgcOptions []SGCDisplayInfo) {
	<div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
		<div class="card-body">
			<form method="GET" action="/sessions">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
					<div class="form-control">
						<label class="label" for="status">
							<span class="label-text">Status Filter</span>
						</label>
						<input type="text" id="status" name="status" value={ statusFilter } placeholder="running, stopped, crashed" class="input input-bordered w-full"/>
					</div>
					<div class="form-control">
						<label class="label" for="server_game_config_id">
							<span class="label-text">Server Game Config</span>
						</label>
						<select id="server_game_config_id" name="server_game_config_id" class="select select-bordered w-full">
							<option value="">All configs</option>
							for _, opt := range sgcOptions {
								if fmt.Sprintf("%d", opt.ServerGameConfigId) == serverGameConfigID {
									<option value={ fmt.Sprintf("%d", opt.ServerGameConfigId) } selected>{ opt.DisplayName }</option>
								} else {
									<option value={ fmt.Sprintf("%d", opt.ServerGameConfigId) }>{ opt.DisplayName }</option>
								}
							}
						</select>
					</div>
					<div class="flex items-end">
						<label class="label cursor-pointer gap-2 justify-start">
							if liveOnly {
								<input type="checkbox" name="live_only" value="1" checked class="checkbox checkbox-sm"/>
							} else {
								<input type="checkbox" name="live_only" value="1" class="checkbox checkbox-sm"/>
							}
							<span class="label-text">Live only</span>
						</label>
					</div>
					<div class="flex items-end">
						<button type="submit" class="btn btn-primary w-full">Apply Filters</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}

templ StartSessionPanel(selectedServerID string, sgcOptions []SGCDisplayInfo, startWarning, startError string, showForce bool, forceSGCID string) {
	<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
		<div class="flex justify-between items-center p-4 border-b border-base-300 bg-base-200">
			<h2 class="text-lg font-semibold text-base-content">Start Session</h2>
		</div>
		<div class="card-body">
			if selectedServerID == "" {
				<div role="alert" class="alert alert-warning">
					<span class="text-sm"><strong>Select a server first</strong> using the dropdown in the top navigation bar.</span>
				</div>
			} else {
				if startWarning != "" {
					<div role="alert" class="alert alert-warning mb-4">
						<span class="text-sm"><strong>Warning:</strong> { startWarning }</span>
					</div>
				}
				if startError != "" {
					<div role="alert" class="alert alert-error mb-4 flex-col items-start">
						<p class="text-sm"><strong>Start failed:</strong> { startError }</p>
						if showForce {
							<form method="POST" action="/sessions/start">
								<input type="hidden" name="server_game_config_id" value={ forceSGCID }/>
								<input type="hidden" name="server_id" value={ selectedServerID }/>
								<input type="hidden" name="force" value="true"/>
								<button type="submit" class="btn btn-error">Force Start New Session</button>
								<p class="mt-2 text-xs text-base-content/60">
									This will attempt to gracefully stop the existing container, then force stop and remove it before starting a new one.
								</p>
							</form>
						}
					</div>
				}
				<form method="POST" action="/sessions/start">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
						<div class="form-control">
							<label class="label" for="start_server_game_config_id">
								<span class="label-text">Server Game Config</span>
							</label>
							<select
								id="start_server_game_config_id"
								name="server_game_config_id"
								required
								hx-get="/api/sessions/check-active"
								hx-trigger="change"
								hx-target="#session-start-warning"
								hx-include="[name='server_id']"
								class="select select-bordered w-full"
							>
								<option value="">Select a config</option>
								for _, opt := range sgcOptions {
									<option value={ fmt.Sprintf("%d", opt.ServerGameConfigId) }>{ opt.DisplayName }</option>
								}
							</select>
							<p class="mt-1 text-xs text-base-content/60">Only configs for the selected server</p>
							<p class="mt-1 text-xs text-base-content/60">
								Need a Server Game Config first? Deploy a GameConfig to a server from the GameConfig detail page.
							</p>
							<div id="session-start-warning"></div>
						</div>
					</div>
					<input type="hidden" name="server_id" value={ selectedServerID }/>
					<div class="flex items-center gap-4">
						<label class="label cursor-pointer gap-2 justify-start">
							<input type="checkbox" name="force" value="true" class="checkbox checkbox-sm"/>
							<span class="label-text">Force start (stop existing container if needed)</span>
						</label>
						<button type="submit" class="btn btn-success">Start Session</button>
					</div>
				</form>
			}
		</div>
	</div>
}

// deploymentRowPollAttrs returns the row's self-terminating poll wiring
// (FR7, #1628): hx-get/hx-trigger/hx-target/hx-swap are present only when
// the row's latest session is in a components.IsTransientStatus state
// (pending/starting/stopping). Because the endpoint's response is itself a
// DeploymentRow (#1628's GET /api/deployments/{sgcID}/row), a settled
// row's next render comes back without these attributes and the polling
// loop stops on its own -- no client-side timer bookkeeping, and this is
// independent of ActionError: a row with an inline action error still
// polls (and the error clears) as long as the underlying status is still
// transient.
//
// #1726 decision (kept unchanged, see that issue's Implementation section
// point 4): this poll stays as the live-updates fallback and costs nothing
// once SSE is live. Two consequences of the SSE inner-swap only ever
// touching DeploymentRowInner's <td>s (never the <tr> itself, see
// DeploymentRowInner's doc comment):
//   - An SSE delivery cannot add or remove these hx-* attributes on the
//     <tr>. A row that settles via a pushed SSE update keeps polling until
//     its *next* poll tick returns a settled row and drops the attrs --
//     self-healing within one 3s interval, not instantaneous. Acceptable
//     and intentional; do not "fix" by trying to have the SSE fragment
//     also carry hx-* attributes.
//   - Conversely a polled whole-row replacement (outerHTML) *does* replace
//     the <tr>, including its sse-swap attribute -- DeploymentRow must keep
//     emitting sse-swap unconditionally (below) so a polled row stays a
//     valid SSE swap target under the page's hx-ext="sse" ancestor.
func deploymentRowPollAttrs(data DeploymentRowData) templ.Attributes {
	if !components.IsTransientStatus(data.LatestSession.GetStatus()) {
		return templ.Attributes{}
	}
	return templ.Attributes{
		"hx-get":     fmt.Sprintf("/api/deployments/%d/row", data.ServerGameConfigID),
		"hx-trigger": "every 3s",
		"hx-target":  "this",
		"hx-swap":    "outerHTML",
	}
}

// DeploymentRow renders a single deployment's <tr>, keyed by the stable
// "deployment-row-<sgcID>" id that the action endpoints (#1627) and the
// refresh endpoint (#1628) target as their HTMX swap target. Cell content
// lives in DeploymentRowInner so both whole-row swaps (this component) and
// future inner-swap responses can reuse it.
//
// sse-swap is set unconditionally to events.TopicForDeployment (#1726,
// FR2) -- via the shared manmanv2/events helper, never a locally formatted
// literal, so the producer (handlers_sessions_live.go), this consumer
// attribute, and the DOM id can't drift independently. Emitting it here
// (not just in the page's initial GSCStatusTable render) matters because
// this same component also renders the #1628 poll's outerHTML replacement
// (handleDeploymentRowFragment) and the action endpoints' post-action
// replacement (handlers_deployment_actions.go) -- both must keep the row a
// valid SSE swap target, or a polled/acted-on row would go silently dead to
// further live pushes until the next full page load.
templ DeploymentRow(data DeploymentRowData) {
	<tr
		id={ fmt.Sprintf("deployment-row-%d", data.ServerGameConfigID) }
		class="hover"
		sse-swap={ events.TopicForDeployment(data.ServerGameConfigID) }
		{ deploymentRowPollAttrs(data)... }
	>
		@DeploymentRowInner(data)
	</tr>
}

// DeploymentRowInner renders just the <td>s for a deployment row: display
// name, status (with a session-status badge, or "Never started" when the
// deployment has no session yet), live session link, and the Start/Stop/
// Restart actions cell. Availability of each action control comes entirely
// from data.Actions (components.ComputeDeploymentActions, #1625) -- no
// status-string comparisons here decide which button shows.
templ DeploymentRowInner(data DeploymentRowData) {
	<td class="text-sm">
		if data.DisplayName != "" {
			{ data.DisplayName }
		} else {
			{ fmt.Sprintf("SGC %d", data.ServerGameConfigID) }
		}
	</td>
	<td class="text-sm">
		{ data.SGCStatus }
		if data.LatestSession != nil {
			@htmxui.Badge(data.LatestSession.Status, statusBadgeVariant(sessionStatusVariant(data.LatestSession.Status)), htmxui.BadgeSizeSM, true, nil)
		} else {
			@htmxui.Badge("Never started", htmxui.BadgeNeutral, htmxui.BadgeSizeSM, true, nil)
		}
	</td>
	<td class="text-sm">
		if data.LiveSession != nil {
			<a href={ templ.URL(fmt.Sprintf("/sessions/%d", data.LiveSession.SessionId)) } class="btn btn-primary btn-sm">View Live Session</a>
		} else {
			@htmxui.Badge("None", htmxui.BadgeNeutral, htmxui.BadgeSizeSM, true, nil)
		}
	</td>
	// Actions cell: intentionally kept on the same Alpine.js x-show /
	// click-handler reveal-then-confirm interaction as sgc_detail.templ's
	// Danger Zone (see that file's comment). Stop and Restart both
	// interrupt a live game process, so both are confirm-gated; Start is
	// not. Do not adopt htmxui.Confirm here: its always-visible
	// single-submit shape is a different interaction than this
	// click-to-reveal gate, and daisyui_migration_test.go already guards
	// that distinction elsewhere on this page family.
	<td class="text-sm" x-data="{ confirmStop: false, confirmRestart: false }">
		<div class="flex flex-col gap-2 items-start">
			if data.Actions.CanStart {
				<form
					method="POST"
					action={ templ.URL(fmt.Sprintf("/sessions/deployments/%d/start", data.ServerGameConfigID)) }
					hx-post={ fmt.Sprintf("/sessions/deployments/%d/start", data.ServerGameConfigID) }
					hx-target={ fmt.Sprintf("#deployment-row-%d", data.ServerGameConfigID) }
					hx-swap="outerHTML"
					class="inline"
				>
					<button type="submit" class="btn btn-success btn-sm">Start</button>
				</form>
			}
			if data.Actions.CanStop {
				<div>
					<button type="button" x-show="!confirmStop" @click="confirmStop = true" class="btn btn-warning btn-sm">Stop</button>
					<div x-show="confirmStop" x-cloak class="flex gap-2 items-center">
						<span class="text-sm text-warning font-medium">Stop now?</span>
						<form
							method="POST"
							action={ templ.URL(fmt.Sprintf("/sessions/deployments/%d/stop", data.ServerGameConfigID)) }
							hx-post={ fmt.Sprintf("/sessions/deployments/%d/stop", data.ServerGameConfigID) }
							hx-target={ fmt.Sprintf("#deployment-row-%d", data.ServerGameConfigID) }
							hx-swap="outerHTML"
							class="inline"
						>
							<button type="submit" class="btn btn-warning btn-sm">Yes, Stop</button>
						</form>
						<button type="button" @click="confirmStop = false" class="btn btn-secondary btn-sm">Cancel</button>
					</div>
				</div>
			}
			if data.Actions.CanRestart {
				<div>
					<button type="button" x-show="!confirmRestart" @click="confirmRestart = true" class="btn btn-info btn-sm">Restart</button>
					<div x-show="confirmRestart" x-cloak class="flex gap-2 items-center">
						<span class="text-sm text-info font-medium">Restart now?</span>
						<form
							method="POST"
							action={ templ.URL(fmt.Sprintf("/sessions/deployments/%d/restart", data.ServerGameConfigID)) }
							hx-post={ fmt.Sprintf("/sessions/deployments/%d/restart", data.ServerGameConfigID) }
							hx-target={ fmt.Sprintf("#deployment-row-%d", data.ServerGameConfigID) }
							hx-swap="outerHTML"
							class="inline"
						>
							<button type="submit" class="btn btn-info btn-sm">Yes, Restart</button>
						</form>
						<button type="button" @click="confirmRestart = false" class="btn btn-secondary btn-sm">Cancel</button>
					</div>
				</div>
			}
			if !data.Actions.CanStart && !data.Actions.CanStop && !data.Actions.CanRestart {
				<span class="text-base-content/40">&mdash;</span>
			}
		</div>
		if data.ActionError != "" {
			<div role="alert" class="alert alert-error alert-sm mt-2">
				<span class="text-xs">{ data.ActionError }</span>
			</div>
		}
	</td>
}

// DeploymentsLiveRegion wraps the deployment table region with the #1726
// SSE plumbing: hx-ext="sse" + sse-connect on the outer container (an
// ancestor of every per-row sse-swap target, never itself a swap target --
// see libs/go/htmxsse/README.md's "Critical for adopters" note: an
// sse-connect element that gets swapped re-attaches its EventSource
// listener before the reconnect can carry Last-Event-ID, breaking NFR2's
// reconnect-baseline suppression), plus the Live/Not-Live indicator and
// Reload affordance (NFR3), both siblings of -- not descendants of -- any
// sse-swap element. Mirrors tools/app_registry/ui/pages/
// promotion_details.templ's container/indicator/script shape; adapted here
// for N per-row swap targets (one <tr> each) instead of that page's single
// sse-swap div, so the inline script's "did content change" detector
// observes the rendered <table> (every row lives under it) rather than one
// specific swap element, while still excluding the indicator/reload
// markup (rendered as siblings before the table) from what it observes.
templ DeploymentsLiveRegion(heartbeatIntervalMs int) {
	<div
		id="deployments-live-region"
		hx-ext="sse"
		sse-connect="/api/live/deployments"
		data-heartbeat-ms={ fmt.Sprint(heartbeatIntervalMs) }
	>
		<div id="deployments-live-indicator" class="flex items-center gap-2 mb-2">
			<div id="deployments-live-status" class="badge badge-success" title="SSE connection is healthy">Live</div>
		</div>
		<div id="deployments-reload-container" class="mb-2" style="display: none;">
			<a href="/sessions" class="btn btn-sm btn-warning">Reload</a>
		</div>
		{ children... }
	</div>
	<script type="module">
(function() {
  const container = document.getElementById('deployments-live-region');
  if (!container) return;

  const indicator = document.getElementById('deployments-live-status');
  const reloadContainer = document.getElementById('deployments-reload-container');
  if (!indicator || !reloadContainer) return;

  let isLive = true;
  let lastEventTime = Date.now();
  const heartbeatMs = parseInt(container.getAttribute('data-heartbeat-ms'), 10) || 30000;
  let debounceTimeoutId = null;

  container.addEventListener('htmx:sseOpen', () => {
    cancelDebounce();
    setLive(true);
    lastEventTime = Date.now();
  });

  container.addEventListener('htmx:sseError', () => {
    handleDisconnect();
  });

  container.addEventListener('htmx:sseClose', () => {
    handleDisconnect();
  });

  // Any row swap (all rows live under this <table>, never the
  // indicator/reload markup rendered above it) counts as a live signal --
  // mirrors promotion_details.templ's single-swap-target MutationObserver,
  // generalized to N per-row sse-swap targets under one table.
  const table = container.querySelector('table');
  if (table) {
    const observer = new MutationObserver(() => {
      lastEventTime = Date.now();
      cancelDebounce();
      setLive(true);
    });
    observer.observe(table, {
      childList: true,
      subtree: true,
      characterData: true,
      attributes: true
    });
  }

  const heartbeatCheckInterval = setInterval(() => {
    const timeSinceLastEvent = Date.now() - lastEventTime;
    const timeoutThreshold = heartbeatMs * 2;
    if (isLive && timeSinceLastEvent > timeoutThreshold) {
      handleDisconnect();
    }
  }, 10000);

  function handleDisconnect() {
    if (debounceTimeoutId) return;
    debounceTimeoutId = setTimeout(() => {
      setLive(false);
      debounceTimeoutId = null;
    }, heartbeatMs);
  }

  function cancelDebounce() {
    if (debounceTimeoutId) {
      clearTimeout(debounceTimeoutId);
      debounceTimeoutId = null;
    }
  }

  function setLive(live) {
    isLive = live;
    if (live) {
      indicator.textContent = 'Live';
      indicator.className = 'badge badge-success';
      indicator.title = 'SSE connection is healthy';
      reloadContainer.style.display = 'none';
    } else {
      indicator.textContent = 'Not Live';
      indicator.className = 'badge badge-warning';
      indicator.title = 'SSE connection is not live - reload to resume updates';
      reloadContainer.style.display = 'block';
    }
  }
})();
	</script>
}

templ GSCStatusTable(rows []DeploymentRowData) {
	<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
		<div class="flex justify-between items-center p-4 border-b border-base-300 bg-base-200">
			<h2 class="text-lg font-semibold text-base-content">Game Server Containers (GSCs) Status</h2>
		</div>
		<div class="overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>GSC (Server Game Config)</th>
						<th>Status</th>
						<th>Live Session</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						@DeploymentRow(row)
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ SessionsTable(sessions []*manmanpb.Session, sgcDisplayNames map[int64]string) {
	@components.Table() {
		<thead>
			<tr>
				<th>ID</th>
				<th>Status</th>
				<th>Config</th>
				<th>Started</th>
				<th>Ended</th>
			</tr>
		</thead>
		<tbody>
			for _, session := range sessions {
				<tr class="hover">
					<td>
						<a href={ templ.URL(fmt.Sprintf("/sessions/%d", session.SessionId)) } class="link link-primary text-sm font-medium">
							{ fmt.Sprintf("%d", session.SessionId) }
						</a>
					</td>
					<td>
						@htmxui.Badge(session.Status, statusBadgeVariant(sessionStatusVariant(session.Status)), htmxui.BadgeSizeSM, true, nil)
					</td>
					<td class="text-sm">
						if name, ok := sgcDisplayNames[session.ServerGameConfigId]; ok {
							{ name }
						} else {
							{ fmt.Sprintf("SGC %d", session.ServerGameConfigId) }
						}
					</td>
					<td class="text-sm">{ timeAgo(session.StartedAt) }</td>
					<td class="text-sm">{ timeAgo(session.EndedAt) }</td>
				</tr>
			}
		</tbody>
	}
}

func sessionStatusVariant(status string) string {
	switch status {
	case "running":
		return "success"
	case "starting":
		return "warning"
	case "stopping":
		return "warning"
	case "stopped":
		return "secondary"
	case "error", "crashed":
		return "danger"
	default:
		return "secondary"
	}
}
