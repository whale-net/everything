package pages

import (
	"fmt"

	"github.com/whale-net/everything/libs/go/htmxui"
	manmanpb "github.com/whale-net/everything/manmanv2/protos"
	"github.com/whale-net/everything/manmanv2/ui/components"
)

type SessionsPageData struct {
	Sessions            []*manmanpb.Session
	SGCDisplayNames     map[int64]string
	SelectedServerID    string
	LiveOnly            bool
	StatusFilter        string
	ServerGameConfigID  string
	SGCOptions          []SGCDisplayInfo
	StartWarning        string
	StartError          string
	ShowForce           bool
	ForceSGCID          string
	ServerConfigs       []*manmanpb.ServerGameConfig
	LiveSessionByConfig map[int64]*manmanpb.Session
}

type SGCDisplayInfo struct {
	ServerGameConfigId int64
	DisplayName        string
}

templ Sessions(layout components.LayoutData, data SessionsPageData) {
	@components.Layout(layout) {
		@components.HeroHeader("Sessions", "Manage game server sessions and deployments")
		if data.SelectedServerID != "" {
			<div role="alert" class="alert alert-info mb-4">
				<span><strong>Server scope:</strong> Viewing sessions for the server selected in the top navigation bar.</span>
			</div>
		}
		@SessionFilters(data.StatusFilter, data.ServerGameConfigID, data.LiveOnly, data.SGCOptions)
		@StartSessionPanel(data.SelectedServerID, data.SGCOptions, data.StartWarning, data.StartError, data.ShowForce, data.ForceSGCID)
		if len(data.ServerConfigs) > 0 {
			@GSCStatusTable(data.ServerConfigs, data.SGCDisplayNames, data.LiveSessionByConfig)
		}
		if len(data.Sessions) > 0 {
			@SessionsTable(data.Sessions, data.SGCDisplayNames)
		} else {
			@components.EmptyState("No sessions found", "No sessions found for the selected filters.", "", "")
		}
	}
}

templ SessionFilters(statusFilter, serverGameConfigID string, liveOnly bool, sgcOptions []SGCDisplayInfo) {
	<div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
		<div class="card-body">
			<form method="GET" action="/sessions">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
					<div class="form-control">
						<label class="label" for="status">
							<span class="label-text">Status Filter</span>
						</label>
						<input type="text" id="status" name="status" value={ statusFilter } placeholder="running, stopped, crashed" class="input input-bordered w-full"/>
					</div>
					<div class="form-control">
						<label class="label" for="server_game_config_id">
							<span class="label-text">Server Game Config</span>
						</label>
						<select id="server_game_config_id" name="server_game_config_id" class="select select-bordered w-full">
							<option value="">All configs</option>
							for _, opt := range sgcOptions {
								if fmt.Sprintf("%d", opt.ServerGameConfigId) == serverGameConfigID {
									<option value={ fmt.Sprintf("%d", opt.ServerGameConfigId) } selected>{ opt.DisplayName }</option>
								} else {
									<option value={ fmt.Sprintf("%d", opt.ServerGameConfigId) }>{ opt.DisplayName }</option>
								}
							}
						</select>
					</div>
					<div class="flex items-end">
						<label class="label cursor-pointer gap-2 justify-start">
							if liveOnly {
								<input type="checkbox" name="live_only" value="1" checked class="checkbox checkbox-sm"/>
							} else {
								<input type="checkbox" name="live_only" value="1" class="checkbox checkbox-sm"/>
							}
							<span class="label-text">Live only</span>
						</label>
					</div>
					<div class="flex items-end">
						<button type="submit" class="btn btn-primary w-full">Apply Filters</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}

templ StartSessionPanel(selectedServerID string, sgcOptions []SGCDisplayInfo, startWarning, startError string, showForce bool, forceSGCID string) {
	<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
		<div class="flex justify-between items-center p-4 border-b border-base-300 bg-base-200">
			<h2 class="text-lg font-semibold text-base-content">Start Session</h2>
		</div>
		<div class="card-body">
			if selectedServerID == "" {
				<div role="alert" class="alert alert-warning">
					<span class="text-sm"><strong>Select a server first</strong> using the dropdown in the top navigation bar.</span>
				</div>
			} else {
				if startWarning != "" {
					<div role="alert" class="alert alert-warning mb-4">
						<span class="text-sm"><strong>Warning:</strong> { startWarning }</span>
					</div>
				}
				if startError != "" {
					<div role="alert" class="alert alert-error mb-4 flex-col items-start">
						<p class="text-sm"><strong>Start failed:</strong> { startError }</p>
						if showForce {
							<form method="POST" action="/sessions/start">
								<input type="hidden" name="server_game_config_id" value={ forceSGCID }/>
								<input type="hidden" name="server_id" value={ selectedServerID }/>
								<input type="hidden" name="force" value="true"/>
								<button type="submit" class="btn btn-error">Force Start New Session</button>
								<p class="mt-2 text-xs text-base-content/60">
									This will attempt to gracefully stop the existing container, then force stop and remove it before starting a new one.
								</p>
							</form>
						}
					</div>
				}
				<form method="POST" action="/sessions/start">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
						<div class="form-control">
							<label class="label" for="start_server_game_config_id">
								<span class="label-text">Server Game Config</span>
							</label>
							<select
								id="start_server_game_config_id"
								name="server_game_config_id"
								required
								hx-get="/api/sessions/check-active"
								hx-trigger="change"
								hx-target="#session-start-warning"
								hx-include="[name='server_id']"
								class="select select-bordered w-full"
							>
								<option value="">Select a config</option>
								for _, opt := range sgcOptions {
									<option value={ fmt.Sprintf("%d", opt.ServerGameConfigId) }>{ opt.DisplayName }</option>
								}
							</select>
							<p class="mt-1 text-xs text-base-content/60">Only configs for the selected server</p>
							<p class="mt-1 text-xs text-base-content/60">
								Need a Server Game Config first? Deploy a GameConfig to a server from the GameConfig detail page.
							</p>
							<div id="session-start-warning"></div>
						</div>
					</div>
					<input type="hidden" name="server_id" value={ selectedServerID }/>
					<div class="flex items-center gap-4">
						<label class="label cursor-pointer gap-2 justify-start">
							<input type="checkbox" name="force" value="true" class="checkbox checkbox-sm"/>
							<span class="label-text">Force start (stop existing container if needed)</span>
						</label>
						<button type="submit" class="btn btn-success">Start Session</button>
					</div>
				</form>
			}
		</div>
	</div>
}

templ GSCStatusTable(serverConfigs []*manmanpb.ServerGameConfig, sgcDisplayNames map[int64]string, liveSessionByConfig map[int64]*manmanpb.Session) {
	<div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden mb-6">
		<div class="flex justify-between items-center p-4 border-b border-base-300 bg-base-200">
			<h2 class="text-lg font-semibold text-base-content">Game Server Containers (GSCs) Status</h2>
		</div>
		<div class="overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>GSC (Server Game Config)</th>
						<th>Status</th>
						<th>Live Session</th>
					</tr>
				</thead>
				<tbody>
					for _, sgc := range serverConfigs {
						<tr class="hover">
							<td class="text-sm">
								if name, ok := sgcDisplayNames[sgc.ServerGameConfigId]; ok {
									{ name }
								} else {
									{ fmt.Sprintf("SGC %d", sgc.ServerGameConfigId) }
								}
							</td>
							<td class="text-sm">{ sgc.Status }</td>
							<td class="text-sm">
								if session, ok := liveSessionByConfig[sgc.ServerGameConfigId]; ok {
									<a href={ templ.URL(fmt.Sprintf("/sessions/%d", session.SessionId)) } class="btn btn-primary btn-sm">View Live Session</a>
								} else {
									@htmxui.Badge("None", htmxui.BadgeNeutral, htmxui.BadgeSizeSM, true, nil)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ SessionsTable(sessions []*manmanpb.Session, sgcDisplayNames map[int64]string) {
	@components.Table() {
		<thead>
			<tr>
				<th>ID</th>
				<th>Status</th>
				<th>Config</th>
				<th>Started</th>
				<th>Ended</th>
			</tr>
		</thead>
		<tbody>
			for _, session := range sessions {
				<tr class="hover">
					<td>
						<a href={ templ.URL(fmt.Sprintf("/sessions/%d", session.SessionId)) } class="link link-primary text-sm font-medium">
							{ fmt.Sprintf("%d", session.SessionId) }
						</a>
					</td>
					<td>
						@htmxui.Badge(session.Status, statusBadgeVariant(sessionStatusVariant(session.Status)), htmxui.BadgeSizeSM, true, nil)
					</td>
					<td class="text-sm">
						if name, ok := sgcDisplayNames[session.ServerGameConfigId]; ok {
							{ name }
						} else {
							{ fmt.Sprintf("SGC %d", session.ServerGameConfigId) }
						}
					</td>
					<td class="text-sm">{ timeAgo(session.StartedAt) }</td>
					<td class="text-sm">{ timeAgo(session.EndedAt) }</td>
				</tr>
			}
		</tbody>
	}
}

func sessionStatusVariant(status string) string {
	switch status {
	case "running":
		return "success"
	case "starting":
		return "warning"
	case "stopping":
		return "warning"
	case "stopped":
		return "secondary"
	case "error", "crashed":
		return "danger"
	default:
		return "secondary"
	}
}
