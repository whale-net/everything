# Copy to .env and fill in. The resolver rewrites HOST_MANAGER_VERSION in
# place after every successful auto-deploy -- the value below only matters
# for the very first `docker compose up -d`.

# --- host-manager ---
SERVER_NAME=my-server
RABBITMQ_URL=amqp://user:pass@rabbitmq.example.com:5672/manmanv2-prod
API_ADDRESS=api.manmanv2.example.com:443
ENVIRONMENT=production
HOST_DATA_DIR=./data
HOST_MANAGER_REPOSITORY=ghcr.io/whale-net/manmanv2-host-manager
HOST_MANAGER_CONTAINER_NAME=manmanv2-host-manager
HOST_MANAGER_VERSION=v1.0.0

# --- host-manager-resolver ---
APP_REGISTRY_ADDRESS=app-registry.example.com:443
APP_REGISTRY_ENVIRONMENT=prod
RESOLVER_REPOSITORY=ghcr.io/whale-net/manmanv2-host-resolver
RESOLVER_VERSION=latest
RESOLVER_POLL_INTERVAL=60s

# Service-account credentials for a Keycloak client that can read
# PromotionRegistry.GetEnvironmentState. No dedicated read-only client id
# is provisioned in this repo yet -- see RESOLVER.md "Auth" before adopting.
GRPC_AUTH_MODE=oidc
GRPC_AUTH_TOKEN_URL=https://auth.example.com/realms/whale/protocol/openid-connect/token
GRPC_AUTH_CLIENT_ID=app-registry-resolver-prod
GRPC_AUTH_CLIENT_SECRET=changeme
