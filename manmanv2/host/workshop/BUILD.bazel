load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workshop",
    srcs = [
        "cache_client.go",
        "orchestrator.go",
        "verify.go",
    ],
    importpath = "github.com/whale-net/everything/manmanv2/host/workshop",
    visibility = ["//manmanv2/host:__subpackages__"],
    deps = [
        "//libs/go/docker",
        "//manmanv2/host/rmq",
        "//manmanv2/protos:manmanpb",
        "@com_github_docker_docker//pkg/stdcopy",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "workshop_test",
    srcs = [
        "cache_client_test.go",
        "fake_docker_test.go",
        "nfr7_dependency_guard_test.go",
        "orchestrator_test.go",
        "verify_test.go",
    ],
    # cache_client.go and orchestrator.go are listed here (in addition to being
    # compiled into the embedded :workshop library) so TestNFR7_NoAWSSDKImport
    # can locate and parse their import declarations via the Bazel runfiles
    # manifest -- `bazel test`'s sandbox working directory does not contain the
    # source tree, so a plain relative path doesn't work.
    data = [
        "cache_client.go",
        "orchestrator.go",
    ],
    embed = [":workshop"],
    deps = [
        "//libs/go/docker",
        "//manmanv2/host/rmq",
        "//manmanv2/protos:manmanpb",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@rules_go//go/runfiles",
    ],
)
