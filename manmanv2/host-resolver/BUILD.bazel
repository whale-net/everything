load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "host-resolver_lib",
    srcs = [
        "envfile.go",
        "main.go",
        "resolve.go",
        "swap.go",
    ],
    importpath = "github.com/whale-net/everything/manmanv2/host-resolver",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/docker",
        "//libs/go/grpcauth",
        "//libs/go/grpcclient",
        "//libs/go/logging",
        "//tools/app_registry/protos:appregistrypb",
        "@com_github_docker_docker//api/types/network",
    ],
)

go_binary(
    name = "host-resolver",
    embed = [":host-resolver_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "host-resolver_test",
    size = "small",
    srcs = [
        "envfile_test.go",
        "resolve_test.go",
        "swap_test.go",
    ],
    embed = [":host-resolver_lib"],
    deps = [
        "//tools/app_registry/protos:appregistrypb",
    ],
)

# Release metadata for the host-manager resolver sidecar.
# Not deployed via Helm: it runs alongside host-manager on the same
# docker-compose host, with Docker socket access, the same way
# host-manager itself is deployed (see manmanv2/host/BUILD.bazel).
release_app(
    name = "host-resolver",
    binary_name = ":host-resolver",
    language = "go",
    domain = "manmanv2",
    description = "Resolver sidecar: polls app-registry and self-mutates the host-manager docker-compose deployment to the promoted version",
    app_type = "worker",
    replicas = 1,
    deploy_unit = "image",
)
