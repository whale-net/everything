load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "mcp_lib",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/manmanv2/mcp",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//manmanv2/mcp/server",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
    ],
)

go_binary(
    name = "mcp",
    embed = [":mcp_lib"],
    visibility = ["//visibility:public"],
)

release_app(
    name = "mcp",
    binary_name = ":mcp",
    language = "go",
    domain = "manmanv2",
    description = "ManMan MCP server: persona-authorized tools over the control API",
    app_type = "external-api",
    port = 8081,
)
