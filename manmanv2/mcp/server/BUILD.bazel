load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "audit.go",
        "auth.go",
        "caller.go",
        "idempotency.go",
        "idempotency_store.go",
        "confirm.go",
        "confirm_store.go",
        "connect_address.go",
        "lifecycle_tools.go",
        "middleware.go",
        "persona.go",
        "read_tools.go",
        "whoami.go",
    ],
    importpath = "github.com/whale-net/everything/manmanv2/mcp/server",
    visibility = ["//manmanv2/mcp:__subpackages__"],
    deps = [
        "//libs/go/grpcauth",
        "//manmanv2/connectaddr",
        "//manmanv2/protos:manmanpb",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
