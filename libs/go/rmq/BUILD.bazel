load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "rmq",
    srcs = [
        "connection.go",
        "consumer.go",
        "errors.go",
        "publisher.go",
        "tracing.go",
    ],
    importpath = "github.com/whale-net/everything/libs/go/rmq",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_rabbitmq_amqp091_go//:amqp091-go",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel//propagation",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "rmq_test",
    size = "small",
    srcs = [
        "connection_internal_test.go",
        "connection_test.go",
        "consumer_dispatch_internal_test.go",
        "consumer_internal_test.go",
        "consumer_test.go",
        "publisher_constructor_test.go",
        "publisher_internal_test.go",
        "publisher_test.go",
        "tracing_internal_test.go",
    ],
    embed = [":rmq"],
    deps = [
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk//trace/tracetest",
    ],
)
