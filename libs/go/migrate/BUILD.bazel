load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "migrate",
    srcs = [
        "cli.go",
        "history.go",
        "history_repo.go",
        "migrate.go",
        "seeder.go",
        "source.go",
    ],
    importpath = "github.com/whale-net/everything/libs/go/migrate",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_golang_migrate_migrate_v4//:migrate",
        "@com_github_golang_migrate_migrate_v4//database/postgres",
        "@com_github_golang_migrate_migrate_v4//source/iofs",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)

# Real Postgres integration test for Runner, exercising Up/Down/Steps and
# history tracking against an actual database (unique constraints, dirty
# state, etc. that no fake DB driver can verify). Deliberately NOT part of
# //... -- see //libs/go/dbtest's README for the full rationale behind each
# tag and how to run tests like this one.
#
# Run it explicitly:
#   bazel test //libs/go/migrate:migrate_integration_test \
#     --test_tag_filters=-manual \
#     --test_output=all
go_test(
    name = "migrate_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "migrate_integration_test.go",
        "source_integration_test.go",
    ],
    embedsrcs = glob([
        "testdata/migrations/*.sql",
        "testdata/migrations_extra/*.sql",
    ]),
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":migrate",
        "//libs/go/dbtest",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)
