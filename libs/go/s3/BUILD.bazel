load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "s3",
    srcs = ["s3.go"],
    importpath = "github.com/whale-net/everything/libs/go/s3",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_feature_s3_manager//:manager",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_aws_sdk_go_v2_service_s3//types",
        "@io_opentelemetry_go_contrib_instrumentation_github_com_aws_aws_sdk_go_v2_otelaws//:otelaws",
    ],
)

go_test(
    name = "s3_test",
    size = "small",
    srcs = ["s3_test.go"],
    embed = [":s3"],
)

# Finding #2225: nobody had exercised an actual PUT/GET against a presigned
# URL -- the RPC-level fix (#2213) was verified, but the resulting URL was
# never used to move real bytes. Real MinIO via testcontainers-go, same
# build-tagged/manual pattern as
# manmanv2/api/handlers:action_execution_integration_test.
#
# Runs in CI via the "Test Database Integration" job's explicit union (see
# .github/workflows/ci.yml) -- it has no //libs/go/dbtest dependency for that
# job's discovery query to key on. Run it locally (requires working Docker):
#   bazel test //libs/go/s3:s3_integration_test --test_output=all
go_test(
    # keep
    name = "s3_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["s3_integration_test.go"],
    embed = [":s3"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//wait",
    ],
)
