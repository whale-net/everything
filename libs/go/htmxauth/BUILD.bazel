load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "htmxauth",
    srcs = [
        "auth.go",
        "db_session.go",
    ],
    importpath = "github.com/whale-net/everything/libs/go/htmxauth",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/grpcauth",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_gorilla_sessions//:sessions",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "htmxauth_test",
    srcs = ["auth_test.go"],
    embed = [":htmxauth"],
    deps = [
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

# FR-54/FR-58 tests that need a real Postgres (preflight search_path
# resolution, real JSONB persist -> reload). Gated behind `//go:build
# integration`, gazelle skips it when scanning for go_test srcs; this go_test
# is hand-written with EXACTLY the tag set from
# //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required). `# keep` markers tell
# a later `bazel run //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //libs/go/htmxauth:htmxauth_integration_test --test_output=all
go_test(
    # keep
    name = "htmxauth_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["db_session_integration_test.go"],
    embed = [":htmxauth"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
