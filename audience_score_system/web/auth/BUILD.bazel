load("@rules_go//go:def.bzl", "go_library")

# Google OAuth2 sign-in/sign-up (C1: FR1, FR2) -- see auth.go's package doc
# comment for why this copies libs/go/htmxauth's mechanics instead of
# depending on it.
go_library(
    name = "auth",
    srcs = [
        "auth.go",
        "session.go",
    ],
    importpath = "github.com/whale-net/everything/audience_score_system/web/auth",
    visibility = ["//audience_score_system/web:__subpackages__"],
    deps = [
        "//audience_score_system/store",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_google_uuid//:uuid",
        "@com_github_gorilla_sessions//:sessions",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_x_oauth2//:oauth2",
    ],
)
