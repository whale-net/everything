load("//tools:templ.bzl", "templ_library")

# Milestone M4.3's Channel-scoped pending-matches browse page (FR7/FR8,
# capability C9, issue #1926): handlers (matches.go) and templ views
# (views.templ) in one package -- see matches.go's package doc comment for
# why they are not split across a components/pages sibling pair like
# web/pages (mirrors web/research's own rationale, which in turn mirrors
# web/schedule's). Postgres-backed handler coverage (Testing phase) lands
# as matches_integration_test.go, mirroring
# //audience_score_system/web/research:research_integration_test.
templ_library(
    name = "matches",
    srcs = glob(["*.templ"]),
    go_srcs = ["matches.go"],
    visibility = [
        "//audience_score_system/citest:__pkg__",
        "//audience_score_system/web:__pkg__",
    ],
    deps = [
        "//audience_score_system/store",
        "//audience_score_system/web/auth",
        "//audience_score_system/web/components",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
    ],
)
