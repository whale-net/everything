package schedule

import (
	"strconv"

	"github.com/whale-net/everything/audience_score_system/store"
	"github.com/whale-net/everything/audience_score_system/web/components"
)

// statusLabel renders a human-readable label for store.VideoScriptStatus,
// mirroring pages.connectionStateLabel's convention.
func statusLabel(s store.VideoScriptStatus) string {
	switch s {
	case store.VideoScriptStatusGreenlit:
		return "Greenlit"
	case store.VideoScriptStatusDenied:
		return "Denied"
	case store.VideoScriptStatusArchived:
		return "Archived"
	default:
		return "Proposed"
	}
}

// statusBadgeClass picks a daisyUI badge color matching statusLabel.
func statusBadgeClass(s store.VideoScriptStatus) string {
	switch s {
	case store.VideoScriptStatusGreenlit:
		return "badge badge-success"
	case store.VideoScriptStatusDenied:
		return "badge badge-error"
	case store.VideoScriptStatusArchived:
		return "badge badge-neutral"
	default:
		return "badge badge-ghost"
	}
}

// List is the Channel schedule page (FR48/FR49): every
// store.VideoScriptDetail for ch, in created_at order. canApprove
// (store.CanApprove -- Creator-tier, i.e. Founder or Co-Creator
// symmetrically per FR32, NFR5) gates whether entryActions renders at
// all; an Analyst (canApprove == false) sees a read-only list with no
// greenlight/deny/archive forms anywhere in the markup.
templ List(data components.LayoutData, ch store.Channel, scripts []store.VideoScriptDetail, canApprove bool, canWrite bool) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<div class="flex justify-between items-center">
					<h1 class="card-title">{ ch.Title } scripts</h1>
					if canWrite {
						<a class="btn btn-primary btn-sm" href={ templ.URL("/channels/" + ch.ID.String() + "/scripts/new") }>+ New video script</a>
					}
				</div>
				if len(scripts) == 0 {
					<p class="text-base-content/70">No video scripts yet.</p>
				}
				for _, s := range scripts {
					@scriptCard(ch, s, canApprove)
				}
			</div>
		</div>
	}
}

// scriptCard renders one VideoScriptDetail: title, its bound verdict
// version/value/reasoning (LB3's load-bearing link, never just the idea's
// latest verdict), target publish date (or an explicit "no target date"
// -- an undated script is normal per FR36), status badge, decider (when
// set), the published video link (when s.Published), and -- for a
// Founder or Co-Creator -- entryActions.
templ scriptCard(ch store.Channel, s store.VideoScriptDetail, canApprove bool) {
	<div class="border border-base-300 rounded p-4 mb-2">
		<div class="flex justify-between items-start gap-4">
			<div>
				<h2 class="font-semibold">
					<a class="link" href={ templ.URL("/channels/" + ch.ID.String() + "/scripts/" + s.Script.ID.String()) }>{ s.Script.Title }</a>
				</h2>
				<p class="text-sm text-base-content/70">
					Verdict v{ strconv.Itoa(s.VerdictVersion) }: { string(s.Verdict) }
				</p>
				<p class="text-sm text-base-content/70">Idea: { s.IdeaTitle } -- Strategy: { s.StrategyTitle }</p>
				if s.Script.TargetPublishDate != nil {
					<p class="text-sm">
						Target: { s.Script.TargetPublishDate.UTC().Format("2006-01-02") }
					</p>
				} else {
					<p class="text-sm text-base-content/70">No target date</p>
				}
			</div>
			<span class={ statusBadgeClass(s.Script.Status) }>{ statusLabel(s.Script.Status) }</span>
		</div>
		if canApprove {
			@entryActions(s)
		}
	</div>
}

// entryActions renders the Creator-tier (Founder or Co-Creator)
// greenlight/deny/archive affordances for one script, honoring FR39's
// published freeze (s.Published): once true, no archive affordance is
// rendered at all -- only an explanation -- since the server (schedule.
// go's mutate, via store.ErrVideoScriptPublished) would 409 the request
// anyway. This is presentation only; the server-side check is what
// actually enforces the freeze (see schedule.go's package doc comment).
// A proposed script shows greenlight/deny; a greenlit one shows archive
// (unless frozen); denied and archived scripts show no affordances at
// all (FR40: both are terminal).
templ entryActions(s store.VideoScriptDetail) {
	<div class="card-actions justify-end mt-2 items-center gap-2">
		if s.Script.Status == store.VideoScriptStatusProposed {
			<form method="post" action={ templ.URL("/scripts/" + s.Script.ID.String() + "/approve") }>
				<button type="submit" class="btn btn-primary btn-sm">Greenlight</button>
			</form>
			<form method="post" action={ templ.URL("/scripts/" + s.Script.ID.String() + "/deny") }>
				<button type="submit" class="btn btn-secondary btn-sm">Deny</button>
			</form>
		} else if s.Script.Status == store.VideoScriptStatusGreenlit {
			if s.Published {
				<p class="text-xs text-base-content/50">
					This script is frozen -- its video has already published, so it
					can no longer be archived.
				</p>
			} else {
				<form method="post" action={ templ.URL("/scripts/" + s.Script.ID.String() + "/archive") }>
					<button type="submit" class="btn btn-secondary btn-sm">Archive</button>
				</form>
			}
		}
	</div>
}

// NewScript is GET /channels/{id}/scripts/new's page (#2036, FR13, FR14,
// FR21): a link back to the scripts list, then either newScriptForm
// (canWrite) or a plain "no permission" notice (a CanRead-but-not-
// CanWrite persona -- not reachable given store/authz.go's current
// definitions, but rendered correctly regardless, mirroring List's
// canApprove-gates-affordances pattern one tier down).
templ NewScript(data components.LayoutData, ch store.Channel, verdicts []viableVerdictOption, strategies []store.StrategyDetail, canWrite bool, form scriptFormData) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<p>
					<a class="link" href={ templ.URL("/channels/" + ch.ID.String() + "/scripts") }>&larr; Back to scripts</a>
				</p>
				<h1 class="card-title">{ ch.Title } -- new video script</h1>
				if !canWrite {
					<p class="text-base-content/70 mt-2">You do not have permission to create a video script on this Channel.</p>
				} else {
					@newScriptForm(ch, verdicts, strategies, form)
				}
			</div>
		</div>
	}
}

// newScriptForm is the create form itself (#2036, FR13, FR14, FR18/NFR2).
//
// FR13: when strategies is empty AND there is no error to show (a plain
// GET, or a re-render for the preview/edit toggle -- never itself the
// thing that failed), this renders zeroActiveStrategyMessage and NO form
// at all, rather than an empty Strategy picker that could only ever fail
// at submit. NFR3-style: when form.Error is non-empty, the form (with its
// error and preserved values) always renders even if strategies is now
// empty -- e.g. the submitted strategy_id's row was deactivated between
// render and submit -- so the rejection reason and the user's other field
// values are never silently dropped.
//
// FR14: the verdict_id/strategy_id/title fields are always visible;
// script_text toggles between a plain editable textarea (form.Preview
// false) and a sanitized rendered-HTML block (form.Preview true, injected
// via templ.Raw -- form.PreviewHTML is markdown.go's renderScriptMarkdown
// output, computed server-side by renderNewScript, never client-supplied)
// with the raw text preserved in a hidden input so a later "Edit" or
// "Create script" submit still carries it. Both the "Preview"/"Edit"
// toggle buttons and "Create script" submit the SAME form to the SAME
// action -- HandleCreateScript's submit_action field is what
// distinguishes a mode toggle (no store call) from a real create attempt.
templ newScriptForm(ch store.Channel, verdicts []viableVerdictOption, strategies []store.StrategyDetail, form scriptFormData) {
	if len(strategies) == 0 && form.Error == "" {
		<p class="text-base-content/70 mt-2">{ zeroActiveStrategyMessage }</p>
	} else {
		<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/scripts") } class="mt-2 space-y-2">
			if form.Error != "" {
				<p class="text-error text-sm">{ form.Error }</p>
			}
			<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Verdict</span>
				</label>
				<select name="verdict_id" class="select select-bordered w-full" required>
					<option value="" disabled selected?={ form.VerdictID == "" }>Choose a viable verdict...</option>
					for _, v := range verdicts {
						<option value={ v.VerdictID.String() } selected?={ form.VerdictID == v.VerdictID.String() }>
							{ v.IdeaTitle } (v{ strconv.Itoa(v.Version) }, viable)
						</option>
					}
				</select>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Strategy</span>
				</label>
				<select name="strategy_id" class="select select-bordered w-full" required>
					<option value="" disabled selected?={ form.StrategyID == "" }>Choose a strategy...</option>
					for _, s := range strategies {
						<option value={ s.ID.String() } selected?={ form.StrategyID == s.ID.String() }>{ s.Title }</option>
					}
				</select>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Title</span>
				</label>
				<input type="text" name="title" class="input input-bordered w-full" value={ form.Title } required/>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Script</span>
				</label>
				if form.Preview {
					<input type="hidden" name="script_text" value={ form.ScriptText }/>
					<div class="border border-base-300 rounded p-4 prose max-w-none">
						@templ.Raw(form.PreviewHTML)
					</div>
					<button type="submit" name="submit_action" value="edit" class="btn btn-ghost btn-sm mt-2">Edit</button>
				} else {
					<textarea name="script_text" class="textarea textarea-bordered w-full font-mono" rows="12" required>{ form.ScriptText }</textarea>
					<button type="submit" name="submit_action" value="preview" class="btn btn-ghost btn-sm mt-2">Preview</button>
				}
			</div>
			<button type="submit" name="submit_action" value="create" class="btn btn-primary btn-sm mt-2">Create script</button>
		</form>
	}
}

// scriptDetailView bundles GET /channels/{id}/scripts/{scriptID}'s render
// inputs: the script/idea/verdict triple #2036 already rendered, plus
// #2037's edit-mode and freeze-state additions -- a single struct instead
// of a growing positional-argument list, since create.go's
// renderScriptDetail is now the one place that assembles all of it.
type scriptDetailView struct {
	Ch      store.Channel
	Script  store.VideoScript
	Idea    store.Idea
	Verdict store.Verdict

	Preview     bool   // FR14's read-only rendered-markdown toggle (?preview=1).
	PreviewHTML string // set only when Preview is true.

	CanWrite     bool           // store.CanWrite (FR19): gates whether an Edit affordance can ever appear -- never whether editing is currently allowed.
	Editable     bool           // FR16/FR17: status == proposed && not published -- the actual freeze gate, orthogonal to CanWrite.
	FreezeReason string         // FR17's status-specific indicator text; "" when Editable.
	EditMode     bool           // true only when CanWrite && Editable && the caller requested edit mode (see renderScriptDetail).
	Form         scriptFormData // edit form's live values; only rendered when EditMode, except Form.Error which also surfaces in the read-only view (see below).
}

// ScriptDetail is GET /channels/{id}/scripts/{scriptID}'s page (#2036,
// FR14, FR15; #2037, FR16, FR17): the script's body in one of three
// mutually exclusive modes -- v.EditMode's scriptEditForm, v.Preview's
// read-only rendered-markdown block (?preview=1 -- the content is static
// in this mode, so there is no unsaved-text concern to protect, unlike
// scriptEditForm's), or the plain raw-text block -- plus FR15's link back
// to the bound verdict (idea's detail page, showing that verdict's
// SPECIFIC bound version/value, per v.Verdict.Version/v.Verdict.Verdict,
// never idea's possibly-since-changed current verdict).
//
// FR17: once !v.Editable, an Edit affordance is never rendered (v.EditMode
// is already forced false by renderScriptDetail in that case) and
// v.FreezeReason is shown instead, distinguishing WHY the script is frozen
// rather than one generic read-only state. v.Form.Error additionally
// surfaces there when set -- HandleUpdateScript's ErrVideoScriptDecided
// path renders this exact combination (409): the up-to-date freeze reason
// plus the rejected-edit message, never a resurrected edit form for a
// script that just proved itself no longer editable.
templ ScriptDetail(data components.LayoutData, v scriptDetailView) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<p>
					<a class="link" href={ templ.URL("/channels/" + v.Ch.ID.String() + "/scripts") }>&larr; Back to scripts</a>
				</p>
				<div class="flex justify-between items-start gap-4">
					<h1 class="card-title">{ v.Script.Title }</h1>
					if v.CanWrite && v.Editable && !v.EditMode {
						<a class="btn btn-ghost btn-sm" href={ templ.URL("/channels/" + v.Ch.ID.String() + "/scripts/" + v.Script.ID.String() + "?edit=1") }>Edit</a>
					}
				</div>
				<span class={ statusBadgeClass(v.Script.Status) }>{ statusLabel(v.Script.Status) }</span>
				if !v.Editable {
					<p class="text-sm text-warning mt-2">{ v.FreezeReason }</p>
					if v.Form.Error != "" {
						<p class="text-error text-sm mt-1">{ v.Form.Error }</p>
					}
				}
				<p class="text-sm text-base-content/70 mt-2">
					Proposed from verdict:
					<a class="link" href={ templ.URL("/channels/" + v.Ch.ID.String() + "/research/ideas/" + v.Idea.ID.String()) }>
						{ v.Idea.Title } -- v{ strconv.Itoa(v.Verdict.Version) }: { string(v.Verdict.Verdict) }
					</a>
				</p>
				<div class="form-control mt-4">
					<label class="label">
						<span class="label-text">Script</span>
					</label>
					if v.EditMode {
						@scriptEditForm(v.Ch, v.Script, v.Form)
					} else if v.Preview {
						<div class="border border-base-300 rounded p-4 prose max-w-none">
							@templ.Raw(v.PreviewHTML)
						</div>
						<a class="btn btn-ghost btn-sm mt-2" href={ templ.URL("/channels/" + v.Ch.ID.String() + "/scripts/" + v.Script.ID.String()) }>Show source</a>
					} else {
						<pre class="border border-base-300 rounded p-4 whitespace-pre-wrap font-mono text-sm">{ v.Script.ScriptText }</pre>
						<a class="btn btn-ghost btn-sm mt-2" href={ templ.URL("/channels/" + v.Ch.ID.String() + "/scripts/" + v.Script.ID.String() + "?preview=1") }>Preview</a>
					}
				</div>
			</div>
		</div>
	}
}

// scriptEditForm is FR16/FR17's edit-mode form, rendered in place on
// ScriptDetail's own page rather than a separate route -- reuses
// scriptFormData (Title/ScriptText/IdempotencyKey/Preview/PreviewHTML/
// Error; VerdictID/StrategyID are unused here, an edit never changes which
// verdict/strategy a script is bound to) and the SAME preview/edit toggle
// mechanic as newScriptForm's (submit_action="preview"/"edit" re-renders
// this SAME form via HandleUpdateScript with no store call; anything else
// is the actual "Save changes" attempt). idempotency_key is a hidden field
// minted once per edit-mode GET (newEditFormData) and carried through
// every re-render exactly like newScriptForm's, so a corrected resubmit
// after a validation/freeze error is still one logical write (FR18/NFR2).
templ scriptEditForm(ch store.Channel, script store.VideoScript, form scriptFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/scripts/" + script.ID.String()) } class="space-y-2">
		if form.Error != "" {
			<p class="text-error text-sm">{ form.Error }</p>
		}
		<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
		<div class="form-control">
			<label class="label">
				<span class="label-text">Title</span>
			</label>
			<input type="text" name="title" class="input input-bordered w-full" value={ form.Title } required/>
		</div>
		<div class="form-control mt-2">
			if form.Preview {
				<input type="hidden" name="script_text" value={ form.ScriptText }/>
				<div class="border border-base-300 rounded p-4 prose max-w-none">
					@templ.Raw(form.PreviewHTML)
				</div>
				<button type="submit" name="submit_action" value="edit" class="btn btn-ghost btn-sm mt-2">Edit</button>
			} else {
				<textarea name="script_text" class="textarea textarea-bordered w-full font-mono" rows="12" required>{ form.ScriptText }</textarea>
				<button type="submit" name="submit_action" value="preview" class="btn btn-ghost btn-sm mt-2">Preview</button>
			}
		</div>
		<button type="submit" name="submit_action" value="save" class="btn btn-primary btn-sm mt-2">Save changes</button>
		<a class="btn btn-ghost btn-sm mt-2" href={ templ.URL("/channels/" + ch.ID.String() + "/scripts/" + script.ID.String()) }>Cancel</a>
	</form>
}
