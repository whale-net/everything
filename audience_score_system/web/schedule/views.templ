package schedule

import (
	"strconv"

	"github.com/whale-net/everything/audience_score_system/store"
	"github.com/whale-net/everything/audience_score_system/web/components"
)

// statusLabel renders a human-readable label for store.VideoScriptStatus,
// mirroring pages.connectionStateLabel's convention.
func statusLabel(s store.VideoScriptStatus) string {
	switch s {
	case store.VideoScriptStatusGreenlit:
		return "Greenlit"
	case store.VideoScriptStatusDenied:
		return "Denied"
	case store.VideoScriptStatusArchived:
		return "Archived"
	default:
		return "Proposed"
	}
}

// statusBadgeClass picks a daisyUI badge color matching statusLabel.
func statusBadgeClass(s store.VideoScriptStatus) string {
	switch s {
	case store.VideoScriptStatusGreenlit:
		return "badge badge-success"
	case store.VideoScriptStatusDenied:
		return "badge badge-error"
	case store.VideoScriptStatusArchived:
		return "badge badge-neutral"
	default:
		return "badge badge-ghost"
	}
}

// List is the Channel schedule page (FR48/FR49): every
// store.VideoScriptDetail for ch, in created_at order. canApprove
// (store.CanApprove -- Creator-tier, i.e. Founder or Co-Creator
// symmetrically per FR32, NFR5) gates whether entryActions renders at
// all; an Analyst (canApprove == false) sees a read-only list with no
// greenlight/deny/archive forms anywhere in the markup.
templ List(data components.LayoutData, ch store.Channel, scripts []store.VideoScriptDetail, canApprove bool) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<h1 class="card-title">{ ch.Title } schedule</h1>
				if len(scripts) == 0 {
					<p class="text-base-content/70">No video scripts yet.</p>
				}
				for _, s := range scripts {
					@scriptCard(s, canApprove)
				}
			</div>
		</div>
	}
}

// scriptCard renders one VideoScriptDetail: title, its bound verdict
// version/value/reasoning (LB3's load-bearing link, never just the idea's
// latest verdict), target publish date (or an explicit "no target date"
// -- an undated script is normal per FR36), status badge, decider (when
// set), the published video link (when s.Published), and -- for a
// Founder or Co-Creator -- entryActions.
templ scriptCard(s store.VideoScriptDetail, canApprove bool) {
	<div class="border border-base-300 rounded p-4 mb-2">
		<div class="flex justify-between items-start gap-4">
			<div>
				<h2 class="font-semibold">{ s.Script.Title }</h2>
				<p class="text-sm text-base-content/70">
					Verdict v{ strconv.Itoa(s.VerdictVersion) }: { string(s.Verdict) }
				</p>
				<p class="text-sm text-base-content/70">Idea: { s.IdeaTitle } -- Strategy: { s.StrategyTitle }</p>
				if s.Script.TargetPublishDate != nil {
					<p class="text-sm">
						Target: { s.Script.TargetPublishDate.UTC().Format("2006-01-02") }
					</p>
				} else {
					<p class="text-sm text-base-content/70">No target date</p>
				}
			</div>
			<span class={ statusBadgeClass(s.Script.Status) }>{ statusLabel(s.Script.Status) }</span>
		</div>
		if canApprove {
			@entryActions(s)
		}
	</div>
}

// entryActions renders the Creator-tier (Founder or Co-Creator)
// greenlight/deny/archive affordances for one script, honoring FR39's
// published freeze (s.Published): once true, no archive affordance is
// rendered at all -- only an explanation -- since the server (schedule.
// go's mutate, via store.ErrVideoScriptPublished) would 409 the request
// anyway. This is presentation only; the server-side check is what
// actually enforces the freeze (see schedule.go's package doc comment).
// A proposed script shows greenlight/deny; a greenlit one shows archive
// (unless frozen); denied and archived scripts show no affordances at
// all (FR40: both are terminal).
templ entryActions(s store.VideoScriptDetail) {
	<div class="card-actions justify-end mt-2 items-center gap-2">
		if s.Script.Status == store.VideoScriptStatusProposed {
			<form method="post" action={ templ.URL("/schedule/" + s.Script.ID.String() + "/approve") }>
				<button type="submit" class="btn btn-primary btn-sm">Greenlight</button>
			</form>
			<form method="post" action={ templ.URL("/schedule/" + s.Script.ID.String() + "/deny") }>
				<button type="submit" class="btn btn-secondary btn-sm">Deny</button>
			</form>
		} else if s.Script.Status == store.VideoScriptStatusGreenlit {
			if s.Published {
				<p class="text-xs text-base-content/50">
					This script is frozen -- its video has already published, so it
					can no longer be archived.
				</p>
			} else {
				<form method="post" action={ templ.URL("/schedule/" + s.Script.ID.String() + "/archive") }>
					<button type="submit" class="btn btn-secondary btn-sm">Archive</button>
				</form>
			}
		}
	</div>
}
