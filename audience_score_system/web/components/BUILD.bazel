load("@rules_go//go:def.bzl", "go_test")
load("//tools:templ.bzl", "templ_library")

templ_library(
    name = "components",
    srcs = glob(["*.templ"]),
    go_srcs = [
        "render.go",
        "verdict.go",
    ],
    visibility = [
        "//audience_score_system/citest:__pkg__",
        "//audience_score_system/web:__subpackages__",
    ],
    deps = [
        "//audience_score_system/store",
        "//libs/go/htmxbase",
        "//libs/go/htmxui",
    ],
)

go_test(
    name = "components_test",
    srcs = ["verdict_test.go"],
    embed = [":components"],
    deps = [
        "//audience_score_system/store",
        "@com_github_stretchr_testify//assert",
    ],
)
