load("@rules_go//go:def.bzl", "go_library", "go_test")

# Link-assertion verification package (issue #2598, FR3's verification
# half, NFR5) -- see assertion.go's package doc comment for why this is
# deliberately not whagent.Verifier and not a second generic claim/
# verifier pair added to libs/go/whagent. NewVerifier and Verify are
# Scaffold-phase stubs; issue #2598's Implementation phase fills them in
# (remote JWKS key set with `kid` lookup + caching, signature-then-shape
# verification) and adds the ENV.md entries for ASS_WHAGENT_UI_JWKS_URL /
# ASS_WHAGENT_UI_ISSUER.
go_library(
    name = "link",
    srcs = [
        "assertion.go",
        "errors.go",
        "verifier.go",
    ],
    importpath = "github.com/whale-net/everything/audience_score_system/web/link",
    visibility = ["//audience_score_system/web:__subpackages__"],
    deps = [
        "@com_github_coreos_go_oidc_v3//oidc",
    ],
)

# Scaffold-phase placeholder asserting the "not implemented" stub contract
# (see verifier.go). Issue #2598's Testing phase replaces this file
# entirely with the full suite its Testing section describes: happy path,
# signature tampering, unknown-key rejection, expiry, unknown issuer,
# missing fields, the signature-before-expiry ordering proof, rejection of
# a whagent.Claim-shaped token, and kid rotation.
go_test(
    name = "link_test",
    srcs = ["link_test.go"],
    embed = [":link"],
)
