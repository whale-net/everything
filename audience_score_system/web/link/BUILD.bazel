load("@rules_go//go:def.bzl", "go_library", "go_test")

# Link-assertion verification package (issue #2598, FR3's verification
# half, NFR5) -- see assertion.go's package doc comment for why this is
# deliberately not whagent.Verifier and not a second generic claim/
# verifier pair added to libs/go/whagent. NewVerifier constructs a remote
# JWKS key set (kid lookup + caching, oidc.NewRemoteKeySet); Verify checks
# the signature first, then the claim shape, per verifier.go.
go_library(
    name = "link",
    srcs = [
        "assertion.go",
        "errors.go",
        "verifier.go",
    ],
    importpath = "github.com/whale-net/everything/audience_score_system/web/link",
    visibility = ["//audience_score_system/web:__subpackages__"],
    deps = [
        "@com_github_coreos_go_oidc_v3//oidc",
    ],
)

# Full red/green suite (issue #2598's Testing phase): happy path,
# signature tampering, unknown-key rejection, expiry, unknown issuer,
# missing fields, the signature-before-expiry ordering proof, rejection of
# a whagent.Claim-shaped token, and kid rotation. Tests mint their own
# tokens with a locally generated key pair and serve their own JWKS from
# an httptest.Server -- no dependency on a running ui. The whagent
# dependency below is test-only (constructing a genuine persona
# credential for the rejection case); the link_library itself never
# imports it.
go_test(
    name = "link_test",
    srcs = ["link_test.go"],
    embed = [":link"],
    deps = [
        "//libs/go/whagent",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
    ],
)
