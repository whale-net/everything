package outcomes

import (
	"fmt"
	"strconv"

	"github.com/whale-net/everything/audience_score_system/store"
	"github.com/whale-net/everything/audience_score_system/web/components"
)

// scriptStatusLabel renders a human-readable label for
// store.VideoScriptStatus, mirroring web/matches's/web/schedule's
// identically-named/documented convention (each `web` package that
// renders a VideoScriptStatus keeps its own copy -- see outcomes.go's
// package doc comment on why HandleList's read isn't shared either).
func scriptStatusLabel(s store.VideoScriptStatus) string {
	switch s {
	case store.VideoScriptStatusGreenlit:
		return "Greenlit"
	case store.VideoScriptStatusDenied:
		return "Denied"
	case store.VideoScriptStatusArchived:
		return "Archived"
	default:
		return "Proposed"
	}
}

// matchStateLabel renders a human-readable provenance label for
// store.MatchState (FR22/FR23). PredictionVsOutcome's qualifying-row rule
// guarantees every row's MatchState is MatchStateAuto or
// MatchStateConfirmed -- pending/rejected matches never reach this view --
// so the default case here is unreachable in practice, not a silently
// swallowed third state.
func matchStateLabel(s store.MatchState) string {
	switch s {
	case store.MatchStateAuto:
		return "Auto-matched"
	case store.MatchStateConfirmed:
		return "Confirmed"
	default:
		return string(s)
	}
}

// List is the Channel-scoped prediction-vs-outcome browse page (FR1, FR2)
// PLUS this task's (#1929) calibration-trend section (FR3, FR4) and
// inline set-outcome-bar form (FR5, FR6), rendered below the
// prediction-vs-outcome cards on this SAME page. Prediction-vs-outcome
// rows are every store.PredictionOutcome row HandleList loaded,
// most-recently-published first (as PredictionVsOutcome returns them --
// no re-sorting here or in HandleList). truncated (NFR2) renders as a
// static note when true -- never a paging control, since this package
// exposes no since/before/limit parameter anywhere (see outcomes.go's
// defaultOutcomesLimit doc comment). An empty rows renders FR2's
// message-plus-pointer empty state instead of a bare "no data". canWrite
// (store.CanWrite, outcomes.go's renderList) gates whether the
// set-outcome-bar form renders at all -- presentation only, see
// renderList's doc comment.
templ List(data components.LayoutData, ch store.Channel, rows []store.PredictionOutcome, truncated bool, calib calibrationView, canWrite bool, form outcomeBarFormData) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<h1 class="card-title">{ ch.Title } outcomes</h1>
				if len(rows) == 0 {
					<p class="text-base-content/70">
						No prediction-vs-outcome rows yet. A row appears here once a
						greenlit or archived video script is linked to a published
						video, either auto-matched when the sync worker links it above
						its confidence threshold, or manually confirmed on the
						<a href={ templ.URL("/channels/" + ch.ID.String() + "/matches") } class="link link-primary">
							pending-matches page
						</a>.
					</p>
				} else {
					for _, row := range rows {
						@outcomeCard(row)
					}
					if truncated {
						<p class="text-sm text-base-content/50 mt-2">
							Older outcomes exist beyond the newest { strconv.Itoa(defaultOutcomesLimit) }.
						</p>
					}
				}
			</div>
		</div>
		<div class="card bg-base-100 border border-base-300 shadow-sm mt-4">
			<div class="card-body">
				<h2 class="card-title">Calibration trend</h2>
				@calibrationSection(ch, calib)
				if canWrite {
					@setOutcomeBarForm(ch, calib, form)
				}
			</div>
		</div>
	}
}

// calibrationSection renders the FR3 chart or the FR4 not-configured
// pointer, based on calib.Configured. Never renders a bare
// "not configured" (FR4) -- the pointer always names the inline
// set-outcome-bar form below it on this same page.
templ calibrationSection(ch store.Channel, calib calibrationView) {
	if !calib.Configured {
		<p class="text-base-content/70">
			No outcome bar is configured for this Channel yet, so no calibration
			trend can be computed. Set one below to define what "calibrated"
			means for this Channel.
		</p>
	} else if calib.Unsupported != "" {
		<p class="text-warning text-sm">{ calib.Unsupported }</p>
	} else if len(calib.Points) == 0 {
		<p class="text-base-content/70">
			No calibration candidates yet for the current outcome bar
			({ calib.MetricName } &gt;= { strconv.FormatFloat(calib.Threshold, 'f', -1, 64) }).
		</p>
	} else {
		<p class="text-sm text-base-content/70">
			Classified against the current outcome bar: { calib.MetricName } &gt;= { strconv.FormatFloat(calib.Threshold, 'f', -1, 64) }.
		</p>
		@calibrationChart(calib)
		<div class="overflow-x-auto mt-2">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Month</th>
						<th>Candidates</th>
						<th>Calibrated</th>
						<th>Miscalibrated</th>
						<th>Rate</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range calib.Points {
						<tr>
							<td>{ p.Label }</td>
							<td>{ strconv.Itoa(p.Candidates) }</td>
							<td>{ strconv.Itoa(p.Calibrated) }</td>
							<td>{ strconv.Itoa(p.Miscalibrated) }</td>
							<td>{ strconv.FormatFloat(p.Rate*100, 'f', 0, 64) }%</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if calib.Truncated {
			<p class="text-sm text-base-content/50 mt-2">
				Older months exist beyond the last { strconv.Itoa(defaultCalibrationTrendLimit) }.
			</p>
		}
	}
}

// calibrationChart renders calib's calendar-month buckets as an inline
// SVG line chart (FR3): a single polyline over calib.Points' Rate values,
// plus one circle marker per point, in calib.Points' EXACT order (NFR4 --
// this templ performs no re-sorting, no re-bucketing, and no rate
// arithmetic; every coordinate below was precomputed by outcomes.go). See
// outcomes.go's package doc comment for why this is hand-rolled SVG
// rather than a JS charting library or a new libs/go/htmxui component.
templ calibrationChart(calib calibrationView) {
	<svg
		viewBox={ fmt.Sprintf("0 0 %d %d", calib.ChartWidth, calib.ChartHeight) }
		class="w-full h-48 border border-base-300 rounded bg-base-200/30"
		role="img"
		aria-label="Calibration rate by month"
	>
		<polyline points={ calib.Polyline } fill="none" stroke="currentColor" stroke-width="2" class="text-primary"></polyline>
		for _, p := range calib.Points {
			<circle cx={ fmt.Sprintf("%.1f", p.X) } cy={ fmt.Sprintf("%.1f", p.Y) } r="3" class="fill-primary">
				<title>{ p.Label }: { strconv.FormatFloat(p.Rate*100, 'f', 0, 64) }% ({ strconv.Itoa(p.Calibrated) }/{ strconv.Itoa(p.Candidates) })</title>
			</circle>
		}
	</svg>
}

// setOutcomeBarForm renders the inline set-outcome-bar form (FR5): a
// fixed/disabled metric_name control (only store.OutcomeBarMetricViews is
// accepted this milestone, but the value still POSTs so
// HandleSetOutcomeBar's server-side validation is exercised on every
// submit, forged or not) and a numeric threshold_value field prefilled
// with the current bar's threshold when one is configured (form,
// assembled by outcomes.go's newOutcomeBarFormData/HandleSetOutcomeBar).
// Deliberately no hidden idempotency_key input anywhere in this form
// (FR6) -- see HandleSetOutcomeBar's doc comment for why none is needed.
// Rendered by List only when canWrite is true (presentation only, see
// List's doc comment); the actual rejection of a forged POST happens
// server-side in HandleSetOutcomeBar's authorizeWrite.
templ setOutcomeBarForm(ch store.Channel, calib calibrationView, form outcomeBarFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/outcome-bar") } class="mt-4 space-y-2 max-w-sm">
		<h3 class="font-semibold text-sm">
			if calib.Configured {
				Update outcome bar
			} else {
				Set outcome bar
			}
		</h3>
		if form.Error != "" {
			<p class="text-error text-sm">{ form.Error }</p>
		}
		<div class="form-control">
			<label class="label">
				<span class="label-text">Metric</span>
			</label>
			<select name="metric_name" class="select select-bordered w-full" disabled>
				<option value={ store.OutcomeBarMetricViews } selected>Views</option>
			</select>
			<input type="hidden" name="metric_name" value={ store.OutcomeBarMetricViews }/>
		</div>
		<div class="form-control mt-2">
			<label class="label">
				<span class="label-text">Threshold (views)</span>
			</label>
			<input type="number" step="any" min="0" name="threshold_value" class="input input-bordered w-full" value={ form.ThresholdValue } required/>
		</div>
		<button type="submit" class="btn btn-primary btn-sm mt-2">Save outcome bar</button>
	</form>
}

// outcomeCard renders one store.PredictionOutcome row: the Idea title, the
// SPECIFIC bound verdict version (LB3 -- labeled explicitly so it is never
// mistaken for the Idea's current verdict), the greenlit-or-archived
// script (FR40: archived scripts render exactly like greenlit ones, never
// filtered out), the published video, its latest metrics snapshot
// (nullables render as "--", never 0), and the match's provenance/
// confidence (FR22/FR23).
templ outcomeCard(row store.PredictionOutcome) {
	<div class="border border-base-300 rounded p-4 mb-2">
		<h2 class="font-semibold">{ row.IdeaTitle }</h2>
		<div class="mt-2 pl-3 border-l-2 border-base-300">
			<p class="text-sm font-medium">
				Bound verdict (v{ strconv.Itoa(row.VerdictVersion) }, not necessarily the Idea's current verdict): { string(row.Verdict) }
			</p>
			<p class="text-sm text-base-content/70">{ row.VerdictReasoning }</p>
			<p class="text-sm text-base-content/50">
				-- { row.VerdictAuthorDisplayName }, { row.VerdictCreatedAt.UTC().Format("2006-01-02") }
			</p>
		</div>
		<div class="mt-2 pl-3 border-l-2 border-base-300">
			<p class="text-sm font-medium">
				Script: { row.ScriptTitle }
				<span class="badge badge-ghost ml-1">{ scriptStatusLabel(row.ScriptStatus) }</span>
			</p>
			if row.TargetPublishDate != nil {
				<p class="text-sm text-base-content/70">
					Target: { row.TargetPublishDate.UTC().Format("2006-01-02") }
				</p>
			} else {
				<p class="text-sm text-base-content/70">Undated</p>
			}
			if row.DecidedAt != nil {
				<p class="text-sm text-base-content/70">
					Decided: { row.DecidedAt.UTC().Format("2006-01-02") }
				</p>
			}
		</div>
		<div class="mt-2 pl-3 border-l-2 border-base-300">
			<p class="text-sm font-medium">
				Video: { row.VideoTitle } ({ row.YouTubeVideoID })
			</p>
			if row.PublishedAt != nil {
				<p class="text-sm text-base-content/70">
					Published: { row.PublishedAt.UTC().Format("2006-01-02") }
				</p>
			}
			@outcomeMetrics(row)
		</div>
		<p class="text-sm mt-2">
			{ matchStateLabel(row.MatchState) } -- confidence { strconv.FormatFloat(row.MatchConfidence, 'f', 2, 64) }
		</p>
	</div>
}

// outcomeMetrics renders row's latest metrics snapshot. Per this issue's
// body, every nullable field renders as "--", never a bare 0 -- MetricsMeasuredAt
// itself is never nil (PredictionVsOutcome's inner LATERAL join excludes any
// video with no metrics row at all), but the individual measurement columns
// still may be.
templ outcomeMetrics(row store.PredictionOutcome) {
	<p class="text-sm text-base-content/70">
		if row.Views != nil {
			{ strconv.FormatInt(*row.Views, 10) } views
		} else {
			-- views
		}
		if row.AverageViewDurationSeconds != nil {
			-- avg duration { strconv.FormatFloat(*row.AverageViewDurationSeconds, 'f', 1, 64) }s
		} else {
			-- avg duration --
		}
		if row.AverageViewPercentage != nil {
			-- avg { strconv.FormatFloat(*row.AverageViewPercentage, 'f', 1, 64) }%
		} else {
			-- avg --
		}
		if row.Impressions != nil {
			-- { strconv.FormatInt(*row.Impressions, 10) } impressions
		} else {
			-- impressions --
		}
		if row.ImpressionCTR != nil {
			-- CTR { strconv.FormatFloat(*row.ImpressionCTR, 'f', 2, 64) }
		} else {
			-- CTR --
		}
		(measured { row.MetricsMeasuredAt.UTC().Format("2006-01-02") })
	</p>
}
