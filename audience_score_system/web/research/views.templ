package research

import (
	"strconv"

	"github.com/google/uuid"

	"github.com/whale-net/everything/audience_score_system/mcp/tools"
	"github.com/whale-net/everything/audience_score_system/store"
	"github.com/whale-net/everything/audience_score_system/web/components"
)

// verdictLabel renders a human-readable label for store.VerdictValue,
// mirroring web/schedule's statusLabel and web/pages's
// connectionStateLabel convention.
func verdictLabel(v store.VerdictValue) string {
	switch v {
	case store.VerdictViable:
		return "Viable"
	case store.VerdictNotViable:
		return "Not viable"
	case store.VerdictNeedsMoreResearch:
		return "Needs more research"
	default:
		return string(v)
	}
}

// verdictSourceLabel renders store.VerdictSource (FR5) -- "Agent" for a
// verdict written via MCP's save_viability_verdict, "Human" for one
// written via this milestone's web save-verdict form (a future task).
func verdictSourceLabel(s store.VerdictSource) string {
	switch s {
	case store.VerdictSourceHuman:
		return "Human"
	case store.VerdictSourceAgent:
		return "Agent"
	default:
		return string(s)
	}
}

// authorName looks up personID in names, returning "unknown" rather than
// a blank string if it is somehow missing -- mirrors web/access's
// auditActorLabel convention. This should not happen in practice: the
// handler resolves every AuthorPersonID it renders before calling this
// view.
func authorName(names map[uuid.UUID]string, personID uuid.UUID) string {
	if name, ok := names[personID]; ok && name != "" {
		return name
	}
	return "unknown"
}

// ChannelIndex is the Channel-scoped research index (FR1): every Idea on
// ch with its note count and verdict presence, linking to IdeaDetail, plus
// a separate section for research notes that predate any Idea (M1 FR9).
// ideasTruncated/notesTruncated (NFR2) each render a plain static note
// when the corresponding list hit its 50-row default page -- no "load
// more" control, no pagination widget anywhere on this page.
//
// relationsByNote (FR11, issue #1942) maps unattachedNotes' ids to their
// own research_note_relation edges, resolved by research.go's
// renderChannelIndex in ONE batched ResearchStore.ListRelationsForNotes
// call for the whole unattached-notes list -- never one call per note.
// noteBody renders each note's entry via relatedNotesSection.
//
// canWrite (store.CanWrite, research.go's renderChannelIndex) gates the
// save-note form (FR3, FR6, FR7): omitted entirely when false. This is
// PRESENTATION ONLY -- exactly like web/schedule's entryActions omission
// for an Analyst -- the actual authorization boundary is
// research.go's authorizeWrite, re-derived fresh from Postgres on every
// POST /channels/{id}/research/notes; hiding this form is never the only
// line of defense against a forged submit.
//
// priorNotes (FR15, issue #1945) is the SAME Channel-wide 50-row page
// research.go's renderChannelIndex already loads (before it filters down
// to unattachedNotes) -- the save-note form's relation-picker candidate
// universe, grouped by thread in saveNoteFormChannelIndex/
// relationPickerFields below. No extra store call for this.
//
// The unattached-notes section below (FR36, FR37, issue #2033) renders
// via a no-JS <details>/<summary> disclosure, collapsed by default (no
// "open" attribute) behind a toggle labeled with unattachedNotes' count.
// This is PRESENTATION ONLY: research.go's renderChannelIndex still loads
// and passes the full unattachedNotes/relationsByNote data unconditionally
// -- the collapse never gates the query, never adds an htmx round trip,
// and the save-note form nested below remains fully functional once
// expanded. Per-navigation default-collapsed only -- no cookie,
// localStorage, or server-side preference persists the expanded state
// (root plan #1963, Out of scope).
//
// ideaForm (#2032, FR33-FR35) carries the add-idea inline row's current
// values, rendered by addIdeaRow below inside the Idea table only when
// canWrite is true (same gate as the save-note form's, PRESENTATION ONLY --
// the actual authorization boundary is research.go's authorizeWrite,
// re-derived fresh from Postgres on every POST
// /channels/{id}/research/ideas). addIdeaRow's no-JS <details> disclosure
// toggles between the inert "+ Add idea" affordance and the expanded
// title-only row (FR33); HandleCreateIdea's authorizeWrite + title
// validation + IdeaStore.FindOrCreate call, and the re-render-on-success
// (via a 303 redirect back here) / re-render-on-error paths, are
// research.go's HandleCreateIdea (FR34, FR35).
templ ChannelIndex(data components.LayoutData, ch store.Channel, ideas []store.IdeaSummary, unattachedNotes []store.ResearchNoteWithAuthor, relationsByNote map[uuid.UUID][]store.NoteRelation, noteRefTargets map[uuid.UUID]*uuid.UUID, threads []store.ThreadSummary, priorNotes []store.ResearchNoteWithAuthor, ideasTruncated bool, notesTruncated bool, canWrite bool, form noteFormData, ideaForm ideaFormData) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<h1 class="card-title">{ ch.Title } research</h1>
				if len(ideas) == 0 && !canWrite {
					<p class="text-base-content/70">No ideas recorded yet.</p>
				} else {
					<div class="overflow-x-auto">
						<table class="table">
							<thead>
								<tr>
									<th>Idea</th>
									<th>Notes</th>
									<th>Verdict</th>
								</tr>
							</thead>
							<tbody>
								for _, idea := range ideas {
									@ideaRow(ch, idea)
								}
								if canWrite {
									@addIdeaRow(ch, ideaForm)
								}
							</tbody>
						</table>
					</div>
				}
				if ideasTruncated {
					<p class="text-base-content/50 text-xs mt-2">
						Showing the first { strconv.Itoa(defaultPageLimit) } ideas; older ones are not shown.
					</p>
				}

				<div class="mt-6">
					<h2 class="text-lg font-semibold">Research threads</h2>
					<p class="text-sm text-base-content/70">
						Every thread on this Channel (FR3), including ones that predate an Idea.
					</p>
					@threadList(threads)
				</div>

				<div class="mt-6">
					<details class="collapse collapse-arrow border border-base-300 bg-base-100">
						<summary class="collapse-title text-lg font-semibold">
							Unattached notes ({ strconv.Itoa(len(unattachedNotes)) })
						</summary>
						<div class="collapse-content">
							<p class="text-sm text-base-content/70">
								These research notes predate any Idea and so do not fit the
								Channel-to-Idea hierarchy above.
							</p>
							if len(unattachedNotes) == 0 {
								<p class="text-base-content/70 mt-2">No unattached notes.</p>
							} else {
								<ul class="mt-2 space-y-2">
									for _, note := range unattachedNotes {
										<li class="border border-base-300 rounded p-2">
											@noteBody(ch, note, relationsByNote[note.ID], noteRefTargets)
										</li>
									}
								</ul>
							}
							if notesTruncated {
								<p class="text-base-content/50 text-xs mt-2">
									Showing the Channel's { strconv.Itoa(defaultPageLimit) } most recent
									research notes overall; older ones (attached or not) are not shown.
								</p>
							}
						</div>
					</details>
				</div>

				if canWrite {
					<div class="mt-6">
						<h2 class="text-lg font-semibold">Save a research note</h2>
						@saveNoteFormChannelIndex(ch, ideas, threads, priorNotes, form)
					</div>
				}

				<div class="card-actions justify-end mt-2">
					<a href={ templ.URL("/channels/" + ch.ID.String()) } class="btn btn-secondary btn-sm">
						Back to channel
					</a>
				</div>
			</div>
		</div>
		@noteIDCopyScript()
	}
}

// saveNoteFields renders the save-note form fields shared by both
// saveNoteFormChannelIndex and saveNoteFormIdeaDetail (FR3): the
// validation error (if any, form.Error), the hidden idempotency_key set
// ONCE at render time (FR6 -- see research.go's newIdempotencyKey doc
// comment; never client-generated, never derived from the form's own
// content), the note text, and the optional source_url passed through
// raw (FR12 -- validated by store.ResearchStore.SaveNote itself, not
// here).
templ saveNoteFields(form noteFormData) {
	if form.Error != "" {
		<p class="text-error text-sm">{ form.Error }</p>
	}
	<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
	<div class="form-control">
		<label class="label">
			<span class="label-text">Note text</span>
		</label>
		<textarea name="text" class="textarea textarea-bordered w-full" rows="3" required>{ form.Text }</textarea>
	</div>
	<div class="form-control mt-2">
		<label class="label">
			<span class="label-text">Source URL (optional)</span>
		</label>
		<input type="url" name="source_url" class="input input-bordered w-full" value={ form.SourceURL }/>
	</div>
}

// saveNoteFormChannelIndex renders the Channel research index's save-note
// form (FR3, FR14, FR15): an Idea picker populated from ch's own Idea
// list, plus an explicit "No Idea (unattached note)" choice that submits
// an empty idea_id. Since #1945, this picker is thread-RESOLUTION input,
// not the note's attachment control -- HandleSaveNote/SaveNote use the
// submitted idea_id only to cross-check against (or, for a brand-new
// thread, seed) the resolved thread's own Idea; the note's actual Idea is
// always its thread's Idea (issue #1939, FR2 Stage 2a). Submitting "No
// Idea" still produces an unattached note (M1 FR9) whenever the resolved
// thread itself has no Idea. threadPickerFields' thread select/new-title
// picker, scoped to threads (every thread on the Channel here -- see
// ChannelIndex's doc comment); and relationPickerFields' per-thread prior-
// note relation picker, scoped to priorNotes (the Channel-wide candidate
// universe, also ChannelIndex's doc comment). Rendered by ChannelIndex
// only when canWrite is true.
templ saveNoteFormChannelIndex(ch store.Channel, ideas []store.IdeaSummary, threads []store.ThreadSummary, priorNotes []store.ResearchNoteWithAuthor, form noteFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/notes") } class="mt-2 space-y-2">
		@saveNoteFields(form)
		<div class="form-control mt-2">
			<label class="label">
				<span class="label-text">Idea</span>
			</label>
			<select name="idea_id" class="select select-bordered w-full">
				<option value="" selected?={ form.IdeaID == "" }>No Idea (unattached note)</option>
				for _, idea := range ideas {
					<option value={ idea.ID.String() } selected?={ form.IdeaID == idea.ID.String() }>{ idea.Title }</option>
				}
			</select>
		</div>
		@threadPickerFields(threads, form)
		@relationPickerFields(threads, priorNotes, form)
		<button type="submit" class="btn btn-primary btn-sm mt-2">Save note</button>
	</form>
}

// saveNoteFormIdeaDetail renders the Idea detail page's save-note form
// (FR3, FR14, FR15): idea_id is pre-selected via a hidden input, no
// picker. Since #1945/#1939 this idea_id is thread-RESOLUTION input, not
// a direct attachment -- SaveNote cross-checks it against the resolved
// thread's own Idea (rejecting a disagreement) or seeds a brand-new
// thread's Idea with it; every note saved from this page still ends up
// attached to idea in practice, because every thread reachable from this
// page's picker already belongs to idea (see IdeaDetail's doc comment) --
// threadPickerFields' thread select/new-title picker, scoped to threads
// (that Idea's threads only -- see IdeaDetail's doc comment); and
// relationPickerFields' per-thread prior-note relation picker, scoped to
// priorNotes (that Idea's own notes, also IdeaDetail's doc comment).
// Rendered by IdeaDetail only when canWrite is true.
templ saveNoteFormIdeaDetail(ch store.Channel, idea store.Idea, threads []store.ThreadSummary, priorNotes []store.ResearchNoteWithAuthor, form noteFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/notes") } class="mt-2 space-y-2">
		@saveNoteFields(form)
		<input type="hidden" name="idea_id" value={ idea.ID.String() }/>
		@threadPickerFields(threads, form)
		@relationPickerFields(threads, priorNotes, form)
		<button type="submit" class="btn btn-primary btn-sm mt-2">Save note</button>
	</form>
}

// threadPickerFields renders FR14's thread select -- every thread in
// threads plus a "-- New thread --" default option (value "") -- paired
// with a free-text thread_title input used only when that default is
// selected. Shared by saveNoteFormChannelIndex (threads = every thread on
// the Channel) and saveNoteFormIdeaDetail (threads = that Idea's threads
// only) -- the same split those two callers already apply to threadList
// (research.go's renderChannelIndex/renderIdeaDetail, NFR2). The select
// carries data-thread-select so threadRelationScript below can find it and
// keep relationPickerFields' groups in sync with whichever thread (or
// "-- New thread --") is currently chosen.
templ threadPickerFields(threads []store.ThreadSummary, form noteFormData) {
	<div class="form-control mt-2">
		<label class="label">
			<span class="label-text">Thread</span>
		</label>
		<select name="thread_id" data-thread-select class="select select-bordered w-full">
			<option value="" selected?={ form.ThreadID == "" }>-- New thread --</option>
			for _, t := range threads {
				<option value={ t.ID.String() } selected?={ form.ThreadID == t.ID.String() }>{ t.Title }</option>
			}
		</select>
	</div>
	<div class="form-control mt-2">
		<label class="label">
			<span class="label-text">New thread title (only used when "-- New thread --" is selected above)</span>
		</label>
		<input type="text" name="thread_title" class="input input-bordered w-full" value={ form.ThreadTitle }/>
	</div>
}

// noteRelationOptions is the closed set of relation types
// relationPickerFields' per-note <select> offers, read from
// store.RelationType's own constants (FR16/NFR2's explicit requirement for
// this form) -- never a hardcoded string list in this template.
var noteRelationOptions = []store.RelationType{
	store.RelationSupersedes,
	store.RelationExcludes,
	store.RelationCaveats,
	store.RelationFollowsUp,
	store.RelationSummarizes,
}

// notesInThread filters notes to just those whose ThreadID equals
// threadID -- relationPickerFields' per-thread grouping of priorNotes.
// ThreadID is non-optional (uuid.UUID, not *uuid.UUID) as of migration
// 018/#1947 -- every research_note row now has a resolving thread.
func notesInThread(notes []store.ResearchNoteWithAuthor, threadID uuid.UUID) []store.ResearchNoteWithAuthor {
	var out []store.ResearchNoteWithAuthor
	for _, n := range notes {
		if n.ThreadID == threadID {
			out = append(out, n)
		}
	}
	return out
}

// relationPicked reports whether noteID's relation_type_<noteID> pick
// (form.Relations, issue #1945) was submitted with value relationType --
// used to re-select the right option on a validation-failure re-render.
func relationPicked(relations []relationFormEntry, noteID uuid.UUID, relationType store.RelationType) bool {
	target := noteID.String()
	for _, r := range relations {
		if r.RelatedNoteID == target {
			return r.RelationType == string(relationType)
		}
	}
	return false
}

// relationPickedAny reports whether noteID has ANY submitted relation
// pick at all -- used to select relationPickerFields' "No relation"
// placeholder option exactly when no store.RelationType matched above.
func relationPickedAny(relations []relationFormEntry, noteID uuid.UUID) bool {
	target := noteID.String()
	for _, r := range relations {
		if r.RelatedNoteID == target {
			return true
		}
	}
	return false
}

// relationPickerFields renders FR15's per-thread prior-note relation
// picker: one data-thread-group="<threadID>" container per thread in
// threads, each holding one row per candidate note notesInThread finds in
// priorNotes -- an excerpt (tools.Excerpt, the SAME truncation
// citedNoteBody uses) plus shortNoteID (the SAME compact identifier
// relatedNotesSection uses, issue #1942) alongside a
// relation_type_<noteID> select offering noteRelationOptions or "No
// relation". Every group except the one matching form.ThreadID starts
// hidden with its controls disabled (threadRelationScript below keeps
// this in sync as the thread select changes) -- so only prior notes in
// the CURRENTLY selected thread are ever an active, submittable pick,
// never a cross-thread one (FR15's "offering them would be a broken
// affordance" rule; SaveNote itself is still what actually enforces this,
// see HandleSaveNote's doc comment). A thread with no notes in priorNotes
// yet renders a plain "No prior notes" line instead of an empty picker.
// Renders nothing at all when threads is empty (a brand-new thread is the
// only option, and a brand-new thread has no prior notes by definition).
templ relationPickerFields(threads []store.ThreadSummary, priorNotes []store.ResearchNoteWithAuthor, form noteFormData) {
	if len(threads) > 0 {
		<div class="form-control mt-2">
			<label class="label">
				<span class="label-text">Relate to prior notes in this thread (optional)</span>
			</label>
			for _, t := range threads {
				{{ inThread := notesInThread(priorNotes, t.ID) }}
				<div data-thread-group={ t.ID.String() } hidden?={ form.ThreadID != t.ID.String() } class="border border-base-300 rounded p-2 mt-1 space-y-1">
					if len(inThread) == 0 {
						<p class="text-xs text-base-content/50">No prior notes in this thread yet.</p>
					} else {
						for _, note := range inThread {
							<div class="flex items-center gap-2">
								<span class="text-xs flex-1">{ tools.Excerpt(note.Text) } ({ shortNoteID(note.ID) })</span>
								<select name={ "relation_type_" + note.ID.String() } class="select select-bordered select-xs" disabled?={ form.ThreadID != t.ID.String() }>
									<option value="" selected?={ !relationPickedAny(form.Relations, note.ID) }>No relation</option>
									for _, rt := range noteRelationOptions {
										<option value={ string(rt) } selected?={ relationPicked(form.Relations, note.ID, rt) }>{ string(rt) }</option>
									}
								</select>
							</div>
						}
					}
				</div>
			}
		</div>
	}
	@threadRelationScript()
}

// threadRelationScript is FR14/FR15's small vanilla-JS progressive
// enhancement, rendered once per save-note form: it finds that form's own
// [data-thread-select] and keeps exactly the matching [data-thread-group]
// visible with its controls enabled, hiding and disabling every other
// group -- so switching the thread select can never leave a stale,
// now-cross-thread relation pick both visible and submittable. This is
// PRESENTATION ONLY (mirrors canWrite's identical rationale elsewhere in
// this package): store.ResearchStore.SaveNote is the sole enforcement of
// "a relation's target must be in the resolved thread" (FR15/NFR4), never
// this script alone -- see HandleSaveNote's doc comment. Plain vanilla
// JS, not htmx/Alpine (both already loaded by libs/go/htmxbase.Layout,
// which every page in this app renders through -- see
// web/components.Render): this toggle is pure client-side DOM state with
// no server round trip, so reaching for either library here would add a
// dependency this one small handler does not need.
templ threadRelationScript() {
	<script>
		(function () {
			document.querySelectorAll("[data-thread-select]").forEach(function (select) {
				var form = select.closest("form");
				if (!form) { return; }
				function sync() {
					var chosen = select.value;
					form.querySelectorAll("[data-thread-group]").forEach(function (group) {
						var match = group.getAttribute("data-thread-group") === chosen;
						group.hidden = !match;
						group.querySelectorAll("select").forEach(function (el) { el.disabled = !match; });
					});
				}
				select.addEventListener("change", sync);
				sync();
			});
		})();
	</script>
}

// ideaRow renders one store.IdeaSummary: title (linking to its
// IdeaDetail page), note count, and "verdict recorded" / "none yet".
templ ideaRow(ch store.Channel, idea store.IdeaSummary) {
	<tr>
		<td>
			<a href={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String()) } class="link link-primary">
				{ idea.Title }
			</a>
		</td>
		<td>{ strconv.Itoa(idea.NoteCount) }</td>
		<td>
			if idea.HasVerdict {
				<span title="Verdict recorded" aria-label="Verdict recorded">🔖</span>
			} else {
				<span title="No verdict yet" aria-label="No verdict yet">{ components.NoVerdictGlyph }</span>
			}
		</td>
	</tr>
}

// addIdeaRow renders the add-idea inline row (#2032, FR33-FR35): the last
// row of ChannelIndex's Idea table, rendered only when canWrite is true
// (ChannelIndex's doc comment -- presentation only, the actual
// authorization boundary is research.go's authorizeWrite). A native
// <details>/<summary> disclosure (no JS, same idiom as the "Unattached
// notes" collapse above) toggles between the inert "+ Add idea" affordance
// (FR33) and the expanded title-only form -- never a modal, never a
// separate page. form.Open (false on a plain GET/after a successful
// create, true on a validation-failure re-render from HandleCreateIdea)
// drives whether the disclosure starts open, so a rejected submission's
// Title/Error stay visible rather than collapsing away (mirrors
// noteFormData's/verdictFormData's identical re-render contract).
templ addIdeaRow(ch store.Channel, form ideaFormData) {
	<tr>
		<td colspan="3">
			<details class="collapse collapse-arrow bg-base-100" open?={ form.Open }>
				<summary class="collapse-title min-h-0 py-1 text-sm font-medium text-primary cursor-pointer">
					+ Add idea
				</summary>
				<div class="collapse-content">
					<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas") } class="flex items-center gap-2">
						if form.Error != "" {
							<p class="text-error text-sm">{ form.Error }</p>
						}
						<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
						<input type="text" name="title" class="input input-bordered input-sm w-full max-w-xs" placeholder="New idea title" value={ form.Title }/>
						<button type="submit" class="btn btn-primary btn-sm">Add idea</button>
					</form>
				</div>
			</details>
		</td>
	</tr>
}

// threadList renders FR3's discovery list: title, note count, and
// last-activity timestamp for each thread, in ideaRow's visual idiom
// (a table -- not a card list like noteBody's, since a thread carries no
// body text of its own to display). Rendered by both ChannelIndex (every
// thread on the Channel) and IdeaDetail (that Idea's threads only) from
// the identical store.ThreadStore.ListByChannel call (NFR2) -- this view
// itself does not know or care which scope produced threads.
templ threadList(threads []store.ThreadSummary) {
	if len(threads) == 0 {
		<p class="text-base-content/70 mt-2">No research threads yet.</p>
	} else {
		<div class="overflow-x-auto mt-2">
			<table class="table">
				<thead>
					<tr>
						<th>Thread</th>
						<th>Notes</th>
						<th>Last activity</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range threads {
						@threadRow(t)
					}
				</tbody>
			</table>
		</div>
	}
}

// threadRow renders one store.ThreadSummary: title, note count, and its
// most-recent note's created_at -- "No notes yet" (not a blank cell) when
// LatestNoteAt is nil, mirroring ideaRow's "None yet" verdict badge
// convention for an absent value.
templ threadRow(t store.ThreadSummary) {
	<tr>
		<td>{ t.Title }</td>
		<td>{ strconv.Itoa(t.NoteCount) }</td>
		<td>
			if t.LatestNoteAt != nil {
				{ t.LatestNoteAt.UTC().Format("2006-01-02 15:04 UTC") }
			} else {
				<span class="text-base-content/50">No notes yet</span>
			}
		</td>
	</tr>
}

// relationVerbPhrase renders one store.NoteRelation's verb, direction-
// aware: an outgoing edge reads as this note's own declaration
// ("supersedes"), an incoming edge as what the OTHER note declared about
// this one ("superseded by") -- mirroring FR11's rule that supersedes/
// excludes as an incoming relation means THIS note is the one retired.
func relationVerbPhrase(relationType store.RelationType, direction store.RelationDirection) string {
	outgoing := direction != store.RelationIncoming
	switch relationType {
	case store.RelationSupersedes:
		if outgoing {
			return "supersedes"
		}
		return "superseded by"
	case store.RelationExcludes:
		if outgoing {
			return "excludes"
		}
		return "excluded by"
	case store.RelationCaveats:
		if outgoing {
			return "caveats"
		}
		return "caveated by"
	case store.RelationFollowsUp:
		if outgoing {
			return "follows up"
		}
		return "followed up by"
	case store.RelationSummarizes:
		if outgoing {
			return "summarizes"
		}
		return "summarized by"
	default:
		return string(relationType)
	}
}

// shortNoteID renders id as an 8-hex-character-plus-ellipsis identifier --
// the same short-id idiom a git short SHA uses -- so relatedNotesSection's
// "Related" line stays a compact one-liner rather than spelling out a
// full 36-character UUID per relation.
func shortNoteID(id uuid.UUID) string {
	s := id.String()
	return s[:8] + "…"
}

// relatedNotesSection renders FR11's per-note "Related" line: a note's own
// research_note_relation edges (store.NoteRelation), inline alongside its
// body on an ordinary browse -- not only inferable from #1941's
// current_only exclusion or #1944's narrow verdict-citation warning.
// Renders nothing at all when relations is empty (never an empty
// wrapper), mirroring citedNotesSection's convention below. Each line
// reads e.g. "supersedes note ab12cd34…" (outgoing) or "superseded by
// note ab12cd34…" (incoming) -- relationVerbPhrase above picks the verb,
// shortNoteID above the compact identifier, echoing citedNoteBody's own
// truncated-excerpt idiom for keeping a per-note annotation compact.
templ relatedNotesSection(relations []store.NoteRelation) {
	if len(relations) > 0 {
		<div class="mt-1 space-y-0.5">
			for _, rel := range relations {
				<p class="text-xs text-base-content/70">
					{ relationVerbPhrase(rel.RelationType, rel.Direction) } note { shortNoteID(rel.RelatedNoteID) }
				</p>
			}
		</div>
	}
}

// citedBadge renders FR10's explicit cited/uncited indicator, read from
// note.Cited() -- never a local nil-check on the note's source URL field
// in this template (that derivation lives in exactly one place,
// store.ResearchNote.Cited). Takes the bare store.ResearchNote (not
// ResearchNoteWithAuthor) so citedNoteBody below -- which has no author to
// join -- can share it too; noteBody passes note.ResearchNote, its
// embedded field.
templ citedBadge(note store.ResearchNote) {
	if note.Cited() {
		<span class="badge badge-success">Cited</span>
	} else {
		<span class="badge badge-ghost">Uncited</span>
	}
}

// noteBody renders one store.ResearchNoteWithAuthor: its text, author
// display name, created_at, the cited/uncited indicator (FR10), its
// source_url as a link when cited, and -- FR11, issue #1942 -- its own
// relations via relatedNotesSection (renders nothing when relations is
// empty). relations is note.ID's entry from the page's single batched
// ResearchStore.ListRelationsForNotes call (research.go), never a
// per-note store read.
//
// The outer div carries id="note-<uuid>" (issue #2029, FR1/NFR6) -- the
// stable anchor scheme a same-Channel note:<uuid> reference's rendered
// link (FR1, notelink.go's linkifyNoteRefs) targets to scroll the
// referenced note into view, on both the Channel index's unattached-notes
// section and the Idea-detail note list -- noteBody is the single call
// site both of those render through, so emitting the id here covers both
// without duplicating it onto each <li> wrapper. This is presentation
// only, not a citedNoteBody concern: a cited-note excerpt is a reference,
// not the note rendered as itself, so it carries no anchor id (NFR6's
// scope).
//
// NFR6 -- the note's own UUID renders as visible, selectable text (a
// small monospace "#<uuid>" label, never only inside an attribute value)
// with a copy-to-clipboard button (noteIDCopyScript, called once per
// page by ChannelIndex/IdeaDetail); this is what makes FR2's note:<uuid>
// syntax something a human can hand-author, not only something an
// MCP-capable agent can generate.
//
// noteRefs is research.go's resolveNoteRefTargets result for the page
// (id -> IdeaID, nil meaning unattached) for every note:<uuid> reference
// this Channel could resolve -- notelink.go's noteRefSegments builds
// linkifyNoteRefs' notesOnChannel/anchorFor from it and channelID, so
// note.Text renders through templ text nodes segment by segment (FR1),
// never by string-concatenating HTML: each segment either becomes a
// plain escaped text node (FR3's every safe-fallback case, and ordinary
// non-reference text) or an <a href> anchor into the resolved target,
// with the SAME automatic HTML-escaping either way.
templ noteBody(ch store.Channel, note store.ResearchNoteWithAuthor, relations []store.NoteRelation, noteRefs map[uuid.UUID]*uuid.UUID) {
	<div id={ "note-" + note.ID.String() } class="flex justify-between items-start gap-4">
		<div>
			<p>
				for _, seg := range noteRefSegments(note.Text, ch.ID, noteRefs) {
					if seg.HRef != "" {
						<a href={ templ.URL(seg.HRef) } class="link">{ seg.Text }</a>
					} else {
						{ seg.Text }
					}
				}
			</p>
			<p class="text-xs font-mono text-base-content/50 flex items-center gap-1 mt-1">
				<span data-note-id>#{ note.ID.String() }</span>
				<button type="button" class="btn btn-ghost btn-xs" data-copy-note-id title="Copy note ID">Copy</button>
			</p>
			<p class="text-xs text-base-content/70">
				{ note.AuthorDisplayName } — { note.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }
			</p>
			if note.Cited() {
				<p class="text-xs">
					Source: <a href={ templ.URL(*note.SourceURL) } class="link" target="_blank" rel="noopener noreferrer">{ *note.SourceURL }</a>
				</p>
			}
			@relatedNotesSection(relations)
		</div>
		@citedBadge(note.ResearchNote)
	</div>
}

// noteIDCopyScript is NFR6's copy-to-clipboard affordance for noteBody's
// visible "#<uuid>" label: plain vanilla JS (mirrors
// threadRelationScript's identical rationale above -- this is pure
// client-side DOM behavior with no server round trip, so htmx/Alpine add
// nothing a handler this small needs), event-delegated on document so it
// covers every noteBody on the page from ONE script tag regardless of how
// many notes are rendered -- ChannelIndex and IdeaDetail each call this
// once, never once per note. Clicking a [data-copy-note-id] button copies
// its own note's id (read from the immediately preceding [data-note-id]
// span's text, minus the leading "#") via navigator.clipboard; browsers
// without Clipboard API support simply see no-op (the id is already
// visible, selectable text either way -- NFR6's baseline requirement
// never depends on this script running).
templ noteIDCopyScript() {
	<script>
		document.addEventListener("click", function (event) {
			var button = event.target.closest("[data-copy-note-id]");
			if (!button) { return; }
			var span = button.previousElementSibling;
			if (!span || !span.hasAttribute("data-note-id")) { return; }
			var id = span.textContent.replace(/^#/, "");
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(id);
			}
		});
	</script>
}

// retiredWarningLabel renders FR10's staleness warning text for retiredBy
// (store.ResearchStore.RetiredNoteIDs' per-note relation-type slice),
// distinguishing "superseded" from "excluded" as FR10 requires -- both
// together when a note is a target of both relation types. This is the
// single label-composition point citedNoteBody's warning uses, so the
// wording can never drift between a superseded-only, excluded-only, and
// both case.
func retiredWarningLabel(retiredBy []store.RelationType) string {
	superseded, excluded := false, false
	for _, t := range retiredBy {
		switch t {
		case store.RelationSupersedes:
			superseded = true
		case store.RelationExcludes:
			excluded = true
		}
	}
	switch {
	case superseded && excluded:
		return "Superseded and excluded"
	case superseded:
		return "Superseded"
	case excluded:
		return "Excluded"
	default:
		return ""
	}
}

// citedNoteBody renders one verdict citation (FR9, FR16/NFR2): the cited
// store.ResearchNote's text excerpt -- truncated by mcp/tools.Excerpt, the
// SAME bound get_viability_verdict truncates at, never a second
// truncation -- its source_url if any, citedBadge (shared with noteBody,
// never reimplemented), and -- FR10, #1944 -- a superseded/excluded
// warning when retiredBy is non-empty (store.ResearchStore.RetiredNoteIDs,
// resolved once per page by research.go's retiredCitedResearchNotes).
// This warning is purely informational: the citation still names this
// EXACT note -- verdict_citation is never re-resolved to whatever
// superseded or excluded it (root plan #1934, Out of scope). ok is false
// when id did not resolve (citedNotes map, from research.go's
// citedResearchNotes) -- a defensive path (verdict_citation FKs
// research_note and nothing in this package deletes one), rendered as a
// benign "note unavailable" marker rather than panicking or silently
// dropping the row.
templ citedNoteBody(note store.ResearchNote, ok bool, retiredBy []store.RelationType) {
	if !ok {
		<li class="text-xs text-base-content/50 italic">Cited note unavailable</li>
	} else {
		<li class="border border-base-300 rounded p-2">
			<div class="flex justify-between items-start gap-4">
				<div>
					<p class="text-sm">{ tools.Excerpt(note.Text) }</p>
					if note.Cited() {
						<p class="text-xs">
							Source: <a href={ templ.URL(*note.SourceURL) } class="link" target="_blank" rel="noopener noreferrer">{ *note.SourceURL }</a>
						</p>
					}
					if label := retiredWarningLabel(retiredBy); label != "" {
						<p class="text-xs text-warning font-semibold mt-1">
							⚠ { label } -- this citation still points at the note text above as originally cited.
						</p>
					}
				</div>
				@citedBadge(note)
			</div>
		</li>
	}
}

// citedNotesSection renders a verdict's cited-notes list (FR9): nothing at
// all when citedIDs is empty (never an empty heading), otherwise a small
// heading plus one citedNoteBody per id, resolved from notes (research.go's
// citedResearchNotes map, keyed by research_note id) and retired
// (research.go's retiredCitedResearchNotes map, FR10, #1944 -- absent id
// means a live note, no warning).
templ citedNotesSection(citedIDs []uuid.UUID, notes map[uuid.UUID]store.ResearchNote, retired map[uuid.UUID][]store.RelationType) {
	if len(citedIDs) > 0 {
		<div class="mt-2">
			<p class="text-xs font-semibold text-base-content/70">Cited notes</p>
			<ul class="mt-1 space-y-1">
				for _, id := range citedIDs {
					{{ note, ok := notes[id] }}
					@citedNoteBody(note, ok, retired[id])
				}
			</ul>
		</div>
	}
}

// IdeaDetail is one Idea's research-note list (FR2, FR10) and its
// CURRENT viability verdict only (FR4, #2034) -- value (as
// components.VerdictGlyph), reasoning, author display name, source (FR5),
// and created_at. Before #2034 this also rendered the full version-history
// list; that moved to the verdict-details page
// (research.go's HandleVerdictDetail/renderVerdictDetail, VerdictDetail
// below), which this page links to (FR5) whenever current is non-nil --
// current is non-nil iff at least one verdict exists, since
// store.VerdictStore.Current always succeeds when any version does.
// authorNames maps a Verdict's AuthorPersonID (as a UUID string) to its
// display name -- resolved once per distinct author by the handler
// (Verdict carries no AuthorDisplayName field of its own, unlike
// ResearchNoteWithAuthor). citedNotes (FR9, FR16/NFR2, #1943) maps a cited
// research_note id to its resolved store.ResearchNote -- research.go's
// citedResearchNotes resolves current's CitedResearchNoteIDs (history
// passed as nil since this page no longer renders history, #2034) in ONE
// batched call, never one query per citation. retiredNotes (FR10, FR16/
// NFR2, #1944) maps that SAME id set to which relation type(s) currently
// retire it (research.go's retiredCitedResearchNotes,
// store.ResearchStore.RetiredNoteIDs) -- an id absent from this map is a
// live note, so citedNoteBody renders no warning for it.
//
// relationsByNote (FR11, issue #1942) maps notes' ids to their own
// research_note_relation edges, resolved by research.go's renderIdeaDetail
// in ONE batched ResearchStore.ListRelationsForNotes call for this page's
// whole note list -- never one call per note. noteBody renders each
// note's entry via relatedNotesSection.
//
// canWrite (store.CanWrite, research.go's renderIdeaDetail) gates BOTH
// the save-note form (FR3, FR6, FR7) and the save-verdict form (FR4, FR6,
// FR7, #1901): omitted entirely when false -- PRESENTATION ONLY,
// mirroring ChannelIndex's identical rationale (see that doc comment);
// the actual authorization boundary is research.go's authorizeWrite,
// re-derived fresh from Postgres on every POST
// /channels/{id}/research/notes or .../verdicts.
//
// The save-verdict form's citation multi-select (FR4) is populated from
// notes -- the SAME slice this page's own note list already loaded, no
// extra store call, so no notes from any other Idea can ever appear as
// options.
//
// strategies (#1915, FR2) is the Channel's active-Strategy list, loaded by
// research.go's renderIdeaDetail, backing the propose-video-script form's
// picker. proposeForm (#1915) carries that form's current values --
// mirroring form/verdictForm's identical contract. The propose section is
// rendered when canWrite AND EITHER (current is non-nil and
// current.Verdict is store.VerdictViable, FR1) OR proposeForm.Error is
// non-empty -- the Error branch is NFR3's stale-at-submit case: current/
// strategies are re-fetched fresh on every render (including this error
// re-render), so if the verdict or Strategy state changed between GET and
// a rejected POST, the FR1/FR2 presentation gate alone would hide the
// very error message and preserved field values that POST's 400 needs to
// show. Gating on the live state is PRESENTATION ONLY, mirroring the
// note/verdict forms' identical rationale above: the actual boundary is
// HandleProposeVideoScript's own server-side re-resolution of the Idea's
// current verdict (FR4), never this render-time check alone -- but that
// presentation gate must never suppress an error the server already
// decided to show.
templ IdeaDetail(data components.LayoutData, ch store.Channel, idea store.Idea, notes []store.ResearchNoteWithAuthor, relationsByNote map[uuid.UUID][]store.NoteRelation, noteRefTargets map[uuid.UUID]*uuid.UUID, notesTruncated bool, threads []store.ThreadSummary, current *store.Verdict, authorNames map[uuid.UUID]string, citedNotes map[uuid.UUID]store.ResearchNote, retiredNotes map[uuid.UUID][]store.RelationType, canWrite bool, form noteFormData, verdictForm verdictFormData, strategies []store.StrategyDetail, proposeForm proposeFormData) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<h1 class="card-title">{ idea.Title }</h1>

				<div class="mt-2">
					<h2 class="text-lg font-semibold">Research notes</h2>
					if len(notes) == 0 {
						<p class="text-base-content/70">No research notes yet.</p>
					} else {
						<ul class="mt-2 space-y-2">
							for _, note := range notes {
								<li class="border border-base-300 rounded p-2">
									@noteBody(ch, note, relationsByNote[note.ID], noteRefTargets)
								</li>
							}
						</ul>
					}
					if notesTruncated {
						<p class="text-base-content/50 text-xs mt-2">
							Showing the { strconv.Itoa(defaultPageLimit) } most recent notes;
							older ones are not shown.
						</p>
					}
					if canWrite {
						<div class="mt-4">
							<h3 class="text-sm font-semibold">Save a research note</h3>
							@saveNoteFormIdeaDetail(ch, idea, threads, notes, form)
						</div>
					}
				</div>

				<div class="mt-6">
					<h2 class="text-lg font-semibold">Research threads</h2>
					<p class="text-sm text-base-content/70">
						This Idea's threads only (FR3).
					</p>
					@threadList(threads)
				</div>

				<div class="mt-6">
					<h2 class="text-lg font-semibold">Viability verdict</h2>
					if current == nil {
						<p class="text-base-content/70 mt-2">No verdict recorded yet.</p>
					} else {
						<div class="border border-base-300 rounded p-2 mt-2">
							<p class="text-sm font-semibold">Current</p>
							@verdictBody(*current, authorNames, citedNotes, retiredNotes)
						</div>
						<p class="mt-2">
							<a href={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String() + "/verdicts") } class="link link-primary text-sm">
								View verdict history
							</a>
						</p>
					}

					if canWrite {
						<div class="mt-4">
							<h3 class="text-sm font-semibold">Save a viability verdict</h3>
							@saveVerdictForm(ch, idea, notes, verdictForm)
						</div>
					}
				</div>

				if canWrite && (proposeForm.Error != "" || (current != nil && current.Verdict == store.VerdictViable)) {
					<div class="mt-6">
						<h2 class="text-lg font-semibold">Propose a video script</h2>
						@proposeVideoScriptForm(ch, idea, strategies, proposeForm)
					</div>
				}

				<div class="card-actions justify-end mt-2">
					<a href={ templ.URL("/channels/" + ch.ID.String() + "/research") } class="btn btn-secondary btn-sm">
						Back to research
					</a>
				</div>
			</div>
		</div>
		@noteIDCopyScript()
	}
}

// VerdictDetail is the verdict-details page (#2034, FR6-FR9) --
// research.go's HandleVerdictDetail/renderVerdictDetail serve it at
// GET /channels/{id}/research/ideas/{ideaID}/verdicts. history is EVERY
// version for this Idea, oldest to newest (nil for FR9's empty state,
// when the Idea has no verdicts at all); selected is the store.Verdict
// resolveSelectedVerdict picked (FR7 -- current unless a valid "version"
// query param names an older one, nil for the empty state); current is
// the Idea's actual current verdict, used only to label selected's card
// "Current" vs "Version N" and to mark the version-select's default
// option -- selected itself is what renders (FR6/FR7 are the same render
// path, they differ only in which version selected names). authorNames/
// citedNotes/retiredNotes are research.go's identical helpers IdeaDetail
// uses, resolved for history (authorNames, bounded to ONE call regardless
// of version count) and selected only (citedNotes/retiredNotes, FR8 -- the
// selected version's citations, never every version's).
//
// No diff/comparison view exists here or anywhere else in this package --
// #1953's explicit exclusion (root plan #2027, Out of scope).
templ VerdictDetail(data components.LayoutData, ch store.Channel, idea store.Idea, history []store.Verdict, selected *store.Verdict, current *store.Verdict, authorNames map[uuid.UUID]string, citedNotes map[uuid.UUID]store.ResearchNote, retiredNotes map[uuid.UUID][]store.RelationType) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<h1 class="card-title">{ idea.Title } verdict history</h1>
				if selected == nil {
					<p class="text-base-content/70 mt-2">No verdict recorded yet.</p>
				} else {
					if len(history) > 1 {
						<form method="get" class="mt-2 flex items-end gap-2">
							<div>
								<label class="label" for="verdict-version-select">
									<span class="label-text text-xs">Version</span>
								</label>
								<select id="verdict-version-select" name="version" class="select select-bordered select-sm" onchange="this.form.submit()">
									for _, v := range history {
										<option value={ strconv.Itoa(v.Version) } selected?={ v.Version == selected.Version }>
											Version { strconv.Itoa(v.Version) } — { v.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }
										</option>
									}
								</select>
							</div>
							<button type="submit" class="btn btn-secondary btn-sm">View</button>
						</form>
					}
					<div class="border border-base-300 rounded p-2 mt-4">
						<p class="text-sm font-semibold">
							if current != nil && selected.Version == current.Version {
								Current
							} else {
								Version { strconv.Itoa(selected.Version) }
							}
						</p>
						@verdictBody(*selected, authorNames, citedNotes, retiredNotes)
					</div>
				}
				<div class="card-actions justify-end mt-4">
					<a href={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String()) } class="btn btn-secondary btn-sm">
						Back to idea
					</a>
				</div>
			</div>
		</div>
	}
}

// verdictBody renders one store.Verdict: version, value badge, reasoning,
// author display name (from authorNames, keyed by AuthorPersonID as a
// UUID string), source (FR5), created_at, and -- FR9, #1943 -- its cited
// notes (citedNotesSection above; renders nothing when v.CitedResearchNoteIDs
// is empty). notes is the citedNotes map IdeaDetail resolved once for the
// whole page, keyed by research_note id. retired (FR10, #1944) is the
// SAME page-wide retiredCitedResearchNotes map, threaded through to
// citedNotesSection so both the current verdict and every history entry
// show the identical superseded/excluded warning.
templ verdictBody(v store.Verdict, authorNames map[uuid.UUID]string, notes map[uuid.UUID]store.ResearchNote, retired map[uuid.UUID][]store.RelationType) {
	<div class="flex justify-between items-start gap-4">
		<div>
			<p class="text-sm text-base-content/70">Version { strconv.Itoa(v.Version) }</p>
			<p>{ v.Reasoning }</p>
			<p class="text-xs text-base-content/70">
				{ authorName(authorNames, v.AuthorPersonID) } ({ verdictSourceLabel(v.Source) }) — { v.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }
			</p>
			@citedNotesSection(v.CitedResearchNoteIDs, notes, retired)
		</div>
		<span title={ components.VerdictGlyphTitle(v.Verdict) } aria-label={ components.VerdictGlyphTitle(v.Verdict) }>{ components.VerdictGlyph(v.Verdict) }</span>
	</div>
}

// noteIDSelected reports whether noteID is among the submitted
// cited_note_ids (verdictForm.CitedNoteIDs) -- used to re-select the
// citation multi-select's options on a validation-failure re-render.
func noteIDSelected(citedNoteIDs []string, noteID uuid.UUID) bool {
	target := noteID.String()
	for _, id := range citedNoteIDs {
		if id == target {
			return true
		}
	}
	return false
}

// saveVerdictForm renders the Idea detail page's save-verdict form (FR4,
// FR7, #1901): a verdict select carrying exactly store.VerdictValue's
// three values, a required reasoning textarea, a multi-select of THIS
// Idea's own research notes (notes -- the same slice IdeaDetail's note
// list already loaded, no extra store call, so no other Idea's notes can
// ever appear here), and the hidden idempotency_key set once at render
// time (FR6). Submitting always records a NEW verdict version -- never an
// edit of the current one (M1 FR12) -- which the copy below makes
// explicit. Rendered by IdeaDetail only when canWrite is true.
templ saveVerdictForm(ch store.Channel, idea store.Idea, notes []store.ResearchNoteWithAuthor, form verdictFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String() + "/verdicts") } class="mt-2 space-y-2">
		if form.Error != "" {
			<p class="text-error text-sm">{ form.Error }</p>
		}
		<p class="text-xs text-base-content/70">
			Submitting records a new verdict version -- it never edits the current one.
		</p>
		<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
		<div class="form-control">
			<label class="label">
				<span class="label-text">Verdict</span>
			</label>
			<select name="verdict" class="select select-bordered w-full" required>
				<option value="" disabled selected?={ form.Verdict == "" }>Choose a verdict...</option>
				<option value={ string(store.VerdictViable) } selected?={ form.Verdict == string(store.VerdictViable) }>{ verdictLabel(store.VerdictViable) }</option>
				<option value={ string(store.VerdictNotViable) } selected?={ form.Verdict == string(store.VerdictNotViable) }>{ verdictLabel(store.VerdictNotViable) }</option>
				<option value={ string(store.VerdictNeedsMoreResearch) } selected?={ form.Verdict == string(store.VerdictNeedsMoreResearch) }>{ verdictLabel(store.VerdictNeedsMoreResearch) }</option>
			</select>
		</div>
		<div class="form-control mt-2">
			<label class="label">
				<span class="label-text">Reasoning</span>
			</label>
			<textarea name="reasoning" class="textarea textarea-bordered w-full" rows="3" required>{ form.Reasoning }</textarea>
		</div>
		if len(notes) > 0 {
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Cite research notes (optional)</span>
				</label>
				<select name="cited_note_ids" class="select select-bordered w-full h-auto" multiple size="4">
					for _, note := range notes {
						<option value={ note.ID.String() } selected?={ noteIDSelected(form.CitedNoteIDs, note.ID) }>{ note.Text }</option>
					}
				</select>
			</div>
		}
		<button type="submit" class="btn btn-primary btn-sm mt-2">Save verdict</button>
	</form>
}

// proposeVideoScriptForm renders the Idea detail page's propose-video-
// script form (#1915, FR1-FR5): a Strategy picker (strategies -- the
// Channel's active Strategies only, loaded by research.go's
// renderIdeaDetail, FR2), required title and script_text fields, an
// optional target_publish_date, and the hidden idempotency_key set once at
// render time (FR5). verdict_id is deliberately NEVER a field here -- the
// Idea's current verdict is always resolved server-side at submit time
// (LB3), exactly like saveVerdictForm never accepts an idea_id.
//
// FR2: when strategies is empty AND there is no error to show (a plain
// GET, or a re-render for a DIFFERENT form entirely), this renders an
// explanatory line and NO submit control at all, rather than an empty
// picker that could only ever fail at submit -- a Strategy is required to
// propose a video script. NFR3: when form.Error is non-empty, the form
// (with its error and preserved values) always renders even if strategies
// is now empty -- e.g. the submitted strategy_id's row was deleted between
// render and submit -- so the picker may show no options besides the
// placeholder, but the rejection reason and the user's other field values
// are never silently dropped.
templ proposeVideoScriptForm(ch store.Channel, idea store.Idea, strategies []store.StrategyDetail, form proposeFormData) {
	if len(strategies) == 0 && form.Error == "" {
		<p class="text-base-content/70 mt-2">
			No active Strategy on this Channel -- a Strategy is required to propose a video script.
		</p>
	} else {
		<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String() + "/video-scripts") } class="mt-2 space-y-2">
			if form.Error != "" {
				<p class="text-error text-sm">{ form.Error }</p>
			}
			<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Strategy</span>
				</label>
				<select name="strategy_id" class="select select-bordered w-full" required>
					<option value="" disabled selected?={ form.StrategyID == "" }>Choose a strategy...</option>
					for _, s := range strategies {
						<option value={ s.ID.String() } selected?={ form.StrategyID == s.ID.String() }>{ s.Title }</option>
					}
				</select>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Title</span>
				</label>
				<input type="text" name="title" class="input input-bordered w-full" value={ form.Title } required/>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Script</span>
				</label>
				<textarea name="script_text" class="textarea textarea-bordered w-full" rows="6" required>{ form.ScriptText }</textarea>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Target publish date (optional)</span>
				</label>
				<input type="date" name="target_publish_date" class="input input-bordered w-full" value={ form.TargetPublishDate }/>
			</div>
			<button type="submit" class="btn btn-primary btn-sm mt-2">Propose video script</button>
		</form>
	}
}
