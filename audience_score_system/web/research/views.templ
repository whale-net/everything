package research

import (
	"strconv"

	"github.com/google/uuid"

	"github.com/whale-net/everything/audience_score_system/mcp/tools"
	"github.com/whale-net/everything/audience_score_system/store"
	"github.com/whale-net/everything/audience_score_system/web/components"
)

// verdictLabel renders a human-readable label for store.VerdictValue,
// mirroring web/schedule's statusLabel and web/pages's
// connectionStateLabel convention.
func verdictLabel(v store.VerdictValue) string {
	switch v {
	case store.VerdictViable:
		return "Viable"
	case store.VerdictNotViable:
		return "Not viable"
	case store.VerdictNeedsMoreResearch:
		return "Needs more research"
	default:
		return string(v)
	}
}

// verdictBadgeClass picks a daisyUI badge color matching verdictLabel.
func verdictBadgeClass(v store.VerdictValue) string {
	switch v {
	case store.VerdictViable:
		return "badge badge-success"
	case store.VerdictNotViable:
		return "badge badge-error"
	case store.VerdictNeedsMoreResearch:
		return "badge badge-warning"
	default:
		return "badge badge-ghost"
	}
}

// verdictSourceLabel renders store.VerdictSource (FR5) -- "Agent" for a
// verdict written via MCP's save_viability_verdict, "Human" for one
// written via this milestone's web save-verdict form (a future task).
func verdictSourceLabel(s store.VerdictSource) string {
	switch s {
	case store.VerdictSourceHuman:
		return "Human"
	case store.VerdictSourceAgent:
		return "Agent"
	default:
		return string(s)
	}
}

// authorName looks up personID in names, returning "unknown" rather than
// a blank string if it is somehow missing -- mirrors web/access's
// auditActorLabel convention. This should not happen in practice: the
// handler resolves every AuthorPersonID it renders before calling this
// view.
func authorName(names map[uuid.UUID]string, personID uuid.UUID) string {
	if name, ok := names[personID]; ok && name != "" {
		return name
	}
	return "unknown"
}

// ChannelIndex is the Channel-scoped research index (FR1): every Idea on
// ch with its note count and verdict presence, linking to IdeaDetail, plus
// a separate section for research notes that predate any Idea (M1 FR9).
// ideasTruncated/notesTruncated (NFR2) each render a plain static note
// when the corresponding list hit its 50-row default page -- no "load
// more" control, no pagination widget anywhere on this page.
//
// canWrite (store.CanWrite, research.go's renderChannelIndex) gates the
// save-note form (FR3, FR6, FR7): omitted entirely when false. This is
// PRESENTATION ONLY -- exactly like web/schedule's entryActions omission
// for an Analyst -- the actual authorization boundary is
// research.go's authorizeWrite, re-derived fresh from Postgres on every
// POST /channels/{id}/research/notes; hiding this form is never the only
// line of defense against a forged submit.
templ ChannelIndex(data components.LayoutData, ch store.Channel, ideas []store.IdeaSummary, unattachedNotes []store.ResearchNoteWithAuthor, ideasTruncated bool, notesTruncated bool, canWrite bool, form noteFormData) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<h1 class="card-title">{ ch.Title } research</h1>
				if len(ideas) == 0 {
					<p class="text-base-content/70">No ideas recorded yet.</p>
				} else {
					<div class="overflow-x-auto">
						<table class="table">
							<thead>
								<tr>
									<th>Idea</th>
									<th>Notes</th>
									<th>Verdict</th>
								</tr>
							</thead>
							<tbody>
								for _, idea := range ideas {
									@ideaRow(ch, idea)
								}
							</tbody>
						</table>
					</div>
				}
				if ideasTruncated {
					<p class="text-base-content/50 text-xs mt-2">
						Showing the first { strconv.Itoa(defaultPageLimit) } ideas; older ones are not shown.
					</p>
				}

				<div class="mt-6">
					<h2 class="text-lg font-semibold">Unattached notes</h2>
					<p class="text-sm text-base-content/70">
						These research notes predate any Idea and so do not fit the
						Channel-to-Idea hierarchy above.
					</p>
					if len(unattachedNotes) == 0 {
						<p class="text-base-content/70 mt-2">No unattached notes.</p>
					} else {
						<ul class="mt-2 space-y-2">
							for _, note := range unattachedNotes {
								<li class="border border-base-300 rounded p-2">
									@noteBody(note)
								</li>
							}
						</ul>
					}
					if notesTruncated {
						<p class="text-base-content/50 text-xs mt-2">
							Showing the Channel's { strconv.Itoa(defaultPageLimit) } most recent
							research notes overall; older ones (attached or not) are not shown.
						</p>
					}
				</div>

				if canWrite {
					<div class="mt-6">
						<h2 class="text-lg font-semibold">Save a research note</h2>
						@saveNoteFormChannelIndex(ch, ideas, form)
					</div>
				}

				<div class="card-actions justify-end mt-2">
					<a href={ templ.URL("/channels/" + ch.ID.String()) } class="btn btn-secondary btn-sm">
						Back to channel
					</a>
				</div>
			</div>
		</div>
	}
}

// saveNoteFields renders the save-note form fields shared by both
// saveNoteFormChannelIndex and saveNoteFormIdeaDetail (FR3): the
// validation error (if any, form.Error), the hidden idempotency_key set
// ONCE at render time (FR6 -- see research.go's newIdempotencyKey doc
// comment; never client-generated, never derived from the form's own
// content), the note text, and the optional source_url passed through
// raw (FR12 -- validated by store.ResearchStore.SaveNote itself, not
// here).
templ saveNoteFields(form noteFormData) {
	if form.Error != "" {
		<p class="text-error text-sm">{ form.Error }</p>
	}
	<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
	<div class="form-control">
		<label class="label">
			<span class="label-text">Note text</span>
		</label>
		<textarea name="text" class="textarea textarea-bordered w-full" rows="3" required>{ form.Text }</textarea>
	</div>
	<div class="form-control mt-2">
		<label class="label">
			<span class="label-text">Source URL (optional)</span>
		</label>
		<input type="url" name="source_url" class="input input-bordered w-full" value={ form.SourceURL }/>
	</div>
}

// saveNoteFormChannelIndex renders the Channel research index's save-note
// form (FR3): an Idea picker populated from ch's own Idea list, plus an
// explicit "No Idea (unattached note)" choice that submits an empty
// idea_id (M1 FR9). Rendered by ChannelIndex only when canWrite is true.
templ saveNoteFormChannelIndex(ch store.Channel, ideas []store.IdeaSummary, form noteFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/notes") } class="mt-2 space-y-2">
		@saveNoteFields(form)
		<div class="form-control mt-2">
			<label class="label">
				<span class="label-text">Idea</span>
			</label>
			<select name="idea_id" class="select select-bordered w-full">
				<option value="" selected?={ form.IdeaID == "" }>No Idea (unattached note)</option>
				for _, idea := range ideas {
					<option value={ idea.ID.String() } selected?={ form.IdeaID == idea.ID.String() }>{ idea.Title }</option>
				}
			</select>
		</div>
		<button type="submit" class="btn btn-primary btn-sm mt-2">Save note</button>
	</form>
}

// saveNoteFormIdeaDetail renders the Idea detail page's save-note form
// (FR3): idea_id is pre-selected via a hidden input, no picker -- every
// note saved from this page attaches to idea. Rendered by IdeaDetail only
// when canWrite is true.
templ saveNoteFormIdeaDetail(ch store.Channel, idea store.Idea, form noteFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/notes") } class="mt-2 space-y-2">
		@saveNoteFields(form)
		<input type="hidden" name="idea_id" value={ idea.ID.String() }/>
		<button type="submit" class="btn btn-primary btn-sm mt-2">Save note</button>
	</form>
}

// ideaRow renders one store.IdeaSummary: title (linking to its
// IdeaDetail page), note count, and "verdict recorded" / "none yet".
templ ideaRow(ch store.Channel, idea store.IdeaSummary) {
	<tr>
		<td>
			<a href={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String()) } class="link link-primary">
				{ idea.Title }
			</a>
		</td>
		<td>{ strconv.Itoa(idea.NoteCount) }</td>
		<td>
			if idea.HasVerdict {
				<span class="badge badge-success">Verdict recorded</span>
			} else {
				<span class="badge badge-ghost">None yet</span>
			}
		</td>
	</tr>
}

// citedBadge renders FR10's explicit cited/uncited indicator, read from
// note.Cited() -- never a local nil-check on the note's source URL field
// in this template (that derivation lives in exactly one place,
// store.ResearchNote.Cited). Takes the bare store.ResearchNote (not
// ResearchNoteWithAuthor) so citedNoteBody below -- which has no author to
// join -- can share it too; noteBody passes note.ResearchNote, its
// embedded field.
templ citedBadge(note store.ResearchNote) {
	if note.Cited() {
		<span class="badge badge-success">Cited</span>
	} else {
		<span class="badge badge-ghost">Uncited</span>
	}
}

// noteBody renders one store.ResearchNoteWithAuthor: its text, author
// display name, created_at, the cited/uncited indicator (FR10), and --
// when cited -- its source_url as a link.
templ noteBody(note store.ResearchNoteWithAuthor) {
	<div class="flex justify-between items-start gap-4">
		<div>
			<p>{ note.Text }</p>
			<p class="text-xs text-base-content/70">
				{ note.AuthorDisplayName } — { note.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }
			</p>
			if note.Cited() {
				<p class="text-xs">
					Source: <a href={ templ.URL(*note.SourceURL) } class="link" target="_blank" rel="noopener noreferrer">{ *note.SourceURL }</a>
				</p>
			}
		</div>
		@citedBadge(note.ResearchNote)
	</div>
}

// citedNoteBody renders one verdict citation (FR9, FR16/NFR2): the cited
// store.ResearchNote's text excerpt -- truncated by mcp/tools.Excerpt, the
// SAME bound get_viability_verdict truncates at, never a second
// truncation -- its source_url if any, and citedBadge (shared with
// noteBody, never reimplemented). ok is false when id did not resolve
// (citedNotes map, from research.go's citedResearchNotes) -- a defensive
// path (verdict_citation FKs research_note and nothing in this package
// deletes one), rendered as a benign "note unavailable" marker rather than
// panicking or silently dropping the row.
templ citedNoteBody(note store.ResearchNote, ok bool) {
	if !ok {
		<li class="text-xs text-base-content/50 italic">Cited note unavailable</li>
	} else {
		<li class="border border-base-300 rounded p-2">
			<div class="flex justify-between items-start gap-4">
				<div>
					<p class="text-sm">{ tools.Excerpt(note.Text) }</p>
					if note.Cited() {
						<p class="text-xs">
							Source: <a href={ templ.URL(*note.SourceURL) } class="link" target="_blank" rel="noopener noreferrer">{ *note.SourceURL }</a>
						</p>
					}
				</div>
				@citedBadge(note)
			</div>
		</li>
	}
}

// citedNotesSection renders a verdict's cited-notes list (FR9): nothing at
// all when citedIDs is empty (never an empty heading), otherwise a small
// heading plus one citedNoteBody per id, resolved from notes (research.go's
// citedResearchNotes map, keyed by research_note id).
templ citedNotesSection(citedIDs []uuid.UUID, notes map[uuid.UUID]store.ResearchNote) {
	if len(citedIDs) > 0 {
		<div class="mt-2">
			<p class="text-xs font-semibold text-base-content/70">Cited notes</p>
			<ul class="mt-1 space-y-1">
				for _, id := range citedIDs {
					{{ note, ok := notes[id] }}
					@citedNoteBody(note, ok)
				}
			</ul>
		</div>
	}
}

// IdeaDetail is one Idea's research-note list (FR2, FR10) and full
// viability-verdict version history (FR9): current, then every version
// oldest-to-newest, each showing value, reasoning, author display name,
// source (FR5), and created_at -- content-identical to
// get_viability_verdict's current + history fields. authorNames maps a
// Verdict's AuthorPersonID (as a UUID string) to its display name --
// resolved once per distinct author by the handler (Verdict carries no
// AuthorDisplayName field of its own, unlike ResearchNoteWithAuthor).
// citedNotes (FR9, FR16/NFR2, #1943) maps a cited research_note id to its
// resolved store.ResearchNote -- research.go's citedResearchNotes resolves
// the union of every verdict's CitedResearchNoteIDs (current + every
// history entry) in ONE batched call, never one query per citation.
//
// canWrite (store.CanWrite, research.go's renderIdeaDetail) gates BOTH
// the save-note form (FR3, FR6, FR7) and the save-verdict form (FR4, FR6,
// FR7, #1901): omitted entirely when false -- PRESENTATION ONLY,
// mirroring ChannelIndex's identical rationale (see that doc comment);
// the actual authorization boundary is research.go's authorizeWrite,
// re-derived fresh from Postgres on every POST
// /channels/{id}/research/notes or .../verdicts.
//
// The save-verdict form's citation multi-select (FR4) is populated from
// notes -- the SAME slice this page's own note list already loaded, no
// extra store call, so no notes from any other Idea can ever appear as
// options.
//
// strategies (#1915, FR2) is the Channel's active-Strategy list, loaded by
// research.go's renderIdeaDetail, backing the propose-video-script form's
// picker. proposeForm (#1915) carries that form's current values --
// mirroring form/verdictForm's identical contract. The propose section is
// rendered when canWrite AND EITHER (current is non-nil and
// current.Verdict is store.VerdictViable, FR1) OR proposeForm.Error is
// non-empty -- the Error branch is NFR3's stale-at-submit case: current/
// strategies are re-fetched fresh on every render (including this error
// re-render), so if the verdict or Strategy state changed between GET and
// a rejected POST, the FR1/FR2 presentation gate alone would hide the
// very error message and preserved field values that POST's 400 needs to
// show. Gating on the live state is PRESENTATION ONLY, mirroring the
// note/verdict forms' identical rationale above: the actual boundary is
// HandleProposeVideoScript's own server-side re-resolution of the Idea's
// current verdict (FR4), never this render-time check alone -- but that
// presentation gate must never suppress an error the server already
// decided to show.
templ IdeaDetail(data components.LayoutData, ch store.Channel, idea store.Idea, notes []store.ResearchNoteWithAuthor, notesTruncated bool, current *store.Verdict, history []store.Verdict, authorNames map[uuid.UUID]string, citedNotes map[uuid.UUID]store.ResearchNote, canWrite bool, form noteFormData, verdictForm verdictFormData, strategies []store.StrategyDetail, proposeForm proposeFormData) {
	@components.Layout(data) {
		<div class="card bg-base-100 border border-base-300 shadow-sm">
			<div class="card-body">
				<h1 class="card-title">{ idea.Title }</h1>

				<div class="mt-2">
					<h2 class="text-lg font-semibold">Research notes</h2>
					if len(notes) == 0 {
						<p class="text-base-content/70">No research notes yet.</p>
					} else {
						<ul class="mt-2 space-y-2">
							for _, note := range notes {
								<li class="border border-base-300 rounded p-2">
									@noteBody(note)
								</li>
							}
						</ul>
					}
					if notesTruncated {
						<p class="text-base-content/50 text-xs mt-2">
							Showing the { strconv.Itoa(defaultPageLimit) } most recent notes;
							older ones are not shown.
						</p>
					}
					if canWrite {
						<div class="mt-4">
							<h3 class="text-sm font-semibold">Save a research note</h3>
							@saveNoteFormIdeaDetail(ch, idea, form)
						</div>
					}
				</div>

				<div class="mt-6">
					<h2 class="text-lg font-semibold">Viability verdict</h2>
					if current == nil {
						<p class="text-base-content/70 mt-2">No verdict recorded yet.</p>
					} else {
						<div class="border border-base-300 rounded p-2 mt-2">
							<p class="text-sm font-semibold">Current</p>
							@verdictBody(*current, authorNames, citedNotes)
						</div>
					}

					if len(history) > 0 {
						<h3 class="text-sm font-semibold mt-4">History (oldest to newest)</h3>
						<ul class="mt-2 space-y-2">
							for _, v := range history {
								<li class="border border-base-300 rounded p-2">
									@verdictBody(v, authorNames, citedNotes)
								</li>
							}
						</ul>
					}

					if canWrite {
						<div class="mt-4">
							<h3 class="text-sm font-semibold">Save a viability verdict</h3>
							@saveVerdictForm(ch, idea, notes, verdictForm)
						</div>
					}
				</div>

				if canWrite && (proposeForm.Error != "" || (current != nil && current.Verdict == store.VerdictViable)) {
					<div class="mt-6">
						<h2 class="text-lg font-semibold">Propose a video script</h2>
						@proposeVideoScriptForm(ch, idea, strategies, proposeForm)
					</div>
				}

				<div class="card-actions justify-end mt-2">
					<a href={ templ.URL("/channels/" + ch.ID.String() + "/research") } class="btn btn-secondary btn-sm">
						Back to research
					</a>
				</div>
			</div>
		</div>
	}
}

// verdictBody renders one store.Verdict: version, value badge, reasoning,
// author display name (from authorNames, keyed by AuthorPersonID as a
// UUID string), source (FR5), created_at, and -- FR9, #1943 -- its cited
// notes (citedNotesSection above; renders nothing when v.CitedResearchNoteIDs
// is empty). notes is the citedNotes map IdeaDetail resolved once for the
// whole page, keyed by research_note id.
templ verdictBody(v store.Verdict, authorNames map[uuid.UUID]string, notes map[uuid.UUID]store.ResearchNote) {
	<div class="flex justify-between items-start gap-4">
		<div>
			<p class="text-sm text-base-content/70">Version { strconv.Itoa(v.Version) }</p>
			<p>{ v.Reasoning }</p>
			<p class="text-xs text-base-content/70">
				{ authorName(authorNames, v.AuthorPersonID) } ({ verdictSourceLabel(v.Source) }) — { v.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }
			</p>
			@citedNotesSection(v.CitedResearchNoteIDs, notes)
		</div>
		<span class={ verdictBadgeClass(v.Verdict) }>{ verdictLabel(v.Verdict) }</span>
	</div>
}

// noteIDSelected reports whether noteID is among the submitted
// cited_note_ids (verdictForm.CitedNoteIDs) -- used to re-select the
// citation multi-select's options on a validation-failure re-render.
func noteIDSelected(citedNoteIDs []string, noteID uuid.UUID) bool {
	target := noteID.String()
	for _, id := range citedNoteIDs {
		if id == target {
			return true
		}
	}
	return false
}

// saveVerdictForm renders the Idea detail page's save-verdict form (FR4,
// FR7, #1901): a verdict select carrying exactly store.VerdictValue's
// three values, a required reasoning textarea, a multi-select of THIS
// Idea's own research notes (notes -- the same slice IdeaDetail's note
// list already loaded, no extra store call, so no other Idea's notes can
// ever appear here), and the hidden idempotency_key set once at render
// time (FR6). Submitting always records a NEW verdict version -- never an
// edit of the current one (M1 FR12) -- which the copy below makes
// explicit. Rendered by IdeaDetail only when canWrite is true.
templ saveVerdictForm(ch store.Channel, idea store.Idea, notes []store.ResearchNoteWithAuthor, form verdictFormData) {
	<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String() + "/verdicts") } class="mt-2 space-y-2">
		if form.Error != "" {
			<p class="text-error text-sm">{ form.Error }</p>
		}
		<p class="text-xs text-base-content/70">
			Submitting records a new verdict version -- it never edits the current one.
		</p>
		<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
		<div class="form-control">
			<label class="label">
				<span class="label-text">Verdict</span>
			</label>
			<select name="verdict" class="select select-bordered w-full" required>
				<option value="" disabled selected?={ form.Verdict == "" }>Choose a verdict...</option>
				<option value={ string(store.VerdictViable) } selected?={ form.Verdict == string(store.VerdictViable) }>{ verdictLabel(store.VerdictViable) }</option>
				<option value={ string(store.VerdictNotViable) } selected?={ form.Verdict == string(store.VerdictNotViable) }>{ verdictLabel(store.VerdictNotViable) }</option>
				<option value={ string(store.VerdictNeedsMoreResearch) } selected?={ form.Verdict == string(store.VerdictNeedsMoreResearch) }>{ verdictLabel(store.VerdictNeedsMoreResearch) }</option>
			</select>
		</div>
		<div class="form-control mt-2">
			<label class="label">
				<span class="label-text">Reasoning</span>
			</label>
			<textarea name="reasoning" class="textarea textarea-bordered w-full" rows="3" required>{ form.Reasoning }</textarea>
		</div>
		if len(notes) > 0 {
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Cite research notes (optional)</span>
				</label>
				<select name="cited_note_ids" class="select select-bordered w-full h-auto" multiple size="4">
					for _, note := range notes {
						<option value={ note.ID.String() } selected?={ noteIDSelected(form.CitedNoteIDs, note.ID) }>{ note.Text }</option>
					}
				</select>
			</div>
		}
		<button type="submit" class="btn btn-primary btn-sm mt-2">Save verdict</button>
	</form>
}

// proposeVideoScriptForm renders the Idea detail page's propose-video-
// script form (#1915, FR1-FR5): a Strategy picker (strategies -- the
// Channel's active Strategies only, loaded by research.go's
// renderIdeaDetail, FR2), required title and script_text fields, an
// optional target_publish_date, and the hidden idempotency_key set once at
// render time (FR5). verdict_id is deliberately NEVER a field here -- the
// Idea's current verdict is always resolved server-side at submit time
// (LB3), exactly like saveVerdictForm never accepts an idea_id.
//
// FR2: when strategies is empty AND there is no error to show (a plain
// GET, or a re-render for a DIFFERENT form entirely), this renders an
// explanatory line and NO submit control at all, rather than an empty
// picker that could only ever fail at submit -- a Strategy is required to
// propose a video script. NFR3: when form.Error is non-empty, the form
// (with its error and preserved values) always renders even if strategies
// is now empty -- e.g. the submitted strategy_id's row was deleted between
// render and submit -- so the picker may show no options besides the
// placeholder, but the rejection reason and the user's other field values
// are never silently dropped.
templ proposeVideoScriptForm(ch store.Channel, idea store.Idea, strategies []store.StrategyDetail, form proposeFormData) {
	if len(strategies) == 0 && form.Error == "" {
		<p class="text-base-content/70 mt-2">
			No active Strategy on this Channel -- a Strategy is required to propose a video script.
		</p>
	} else {
		<form method="post" action={ templ.URL("/channels/" + ch.ID.String() + "/research/ideas/" + idea.ID.String() + "/video-scripts") } class="mt-2 space-y-2">
			if form.Error != "" {
				<p class="text-error text-sm">{ form.Error }</p>
			}
			<input type="hidden" name="idempotency_key" value={ form.IdempotencyKey }/>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Strategy</span>
				</label>
				<select name="strategy_id" class="select select-bordered w-full" required>
					<option value="" disabled selected?={ form.StrategyID == "" }>Choose a strategy...</option>
					for _, s := range strategies {
						<option value={ s.ID.String() } selected?={ form.StrategyID == s.ID.String() }>{ s.Title }</option>
					}
				</select>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Title</span>
				</label>
				<input type="text" name="title" class="input input-bordered w-full" value={ form.Title } required/>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Script</span>
				</label>
				<textarea name="script_text" class="textarea textarea-bordered w-full" rows="6" required>{ form.ScriptText }</textarea>
			</div>
			<div class="form-control mt-2">
				<label class="label">
					<span class="label-text">Target publish date (optional)</span>
				</label>
				<input type="date" name="target_publish_date" class="input input-bordered w-full" value={ form.TargetPublishDate }/>
			</div>
			<button type="submit" class="btn btn-primary btn-sm mt-2">Propose video script</button>
		</form>
	}
}
