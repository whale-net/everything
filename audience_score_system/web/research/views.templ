package research

// views.templ is an empty shell for Scaffold (issue #1899): ChannelIndex
// and IdeaDetail land here in the Implementation phase, once
// HandleChannelIndex/HandleIdeaDetail have real data to render. shell
// exists only so this file contains at least one templ component --
// templ's codegen otherwise emits an unused "github.com/a-h/templ"
// import for an empty file -- and is never called from research.go.
templ shell() {
	<div></div>
}
