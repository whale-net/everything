load("@rules_go//go:def.bzl", "go_test")
load("//tools:templ.bzl", "templ_library")

# Capability C21's Channel-scoped published-videos listing page (issue
# #2031, milestone re-anchor of #1960's FR27-FR30): handlers (videos.go) and
# templ views (views.templ) in one package -- see videos.go's package doc
# comment for why they are not split across a components/pages sibling pair
# like web/pages (mirrors web/outcomes's own rationale, which in turn
# mirrors web/research's/web/schedule's). Postgres-backed handler coverage
# (Testing phase) lands as videos_integration_test.go plus a hand-written
# go_test rule, mirroring
# //audience_score_system/web/outcomes:outcomes_integration_test.
templ_library(
    name = "videos",
    srcs = glob(["*.templ"]),
    go_srcs = ["videos.go"],
    visibility = [
        "//audience_score_system/citest:__pkg__",
        "//audience_score_system/web:__pkg__",
    ],
    deps = [
        "//audience_score_system/store",
        "//audience_score_system/web/auth",
        "//audience_score_system/web/components",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
    ],
)

# Postgres-backed handler coverage (Testing phase, issue #2031, capability
# C21, milestone re-anchor of #1960's FR27-FR30): HandleList's Founder/
# Co-Creator/Analyst read (same rows for all three), negatives in the same
# load-bearing order the sibling web packages use (non-member 403, unknown
# Channel 404 BEFORE the 403 path, malformed {id} 400, signed-out 401),
# FR27's published-only listing with latest-metrics-wins and an explicit
# no-metrics placeholder, FR28's title/date-range filters (case-insensitive
# substring, inclusive boundary-equal timestamps), FR29's load-bearing
# binary sync-status bucket across all six video_schedule_match shapes,
# FR30's combined filters and empty-state 200, NFR3's bounded query count,
# and a cross-Channel guard. Gated behind `//go:build integration`, gazelle
# skips it when scanning for go_test srcs; this go_test is hand-written
# with EXACTLY the tag set from
# //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required), mirroring
# //audience_score_system/web/outcomes:outcomes_integration_test. `# keep`
# markers tell a later `bazel run //:gazelle` not to touch or remove this
# rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //audience_score_system/web/videos:videos_integration_test --test_output=all
go_test(
    # keep
    name = "videos_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["videos_integration_test.go"],
    embed = [":videos"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//audience_score_system/migrate/schema",
        "//audience_score_system/store",
        "//audience_score_system/web/auth",
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
