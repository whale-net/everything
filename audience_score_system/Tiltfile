# Audience Score System Tiltfile
# Local development environment for `audience_score_system` -- currently
# scoped to exactly what whagent-net's M1 close-out (issue #2121) needs:
# `migrate` + `mcp`, wired with the whagent-net trust configuration
# (ASS_WHAGENT_JWKS_URL/ASS_WHAGENT_ISSUER, issue #2116) so the
# cross-domain tool-dispatch path (whagent_net/worker -> this `mcp`) is
# exercisable end to end. `web` (Google OAuth sign-in, the FR3-FR10
# whagent-ui link-acceptance flow) is also wired, with dev-only dummy
# OAuth/session secrets -- see its block below. `worker` (YouTube sync)
# is NOT wired here -- out of scope for whagent-net's M1 milestone; add it
# in a follow-up if this domain gets its own full local-dev story.
#
# Run alongside whagent_net's own Tiltfile:
#   cd whagent_net && tilt up                    # in one terminal
#   cd audience_score_system && tilt up           # in another
#
# The namespace below ('audience-score-system-local-dev') and the `mcp`
# Service name ('audience-score-system-mcp') are exactly what
# whagent_net/config/agents.yaml's seeded tool_set server_url names --
# keep them in sync if either changes.

load('ext://namespace', 'namespace_create')
load('ext://dotenv', 'dotenv')
load('../tools/tilt/common.tilt',
     'build_images_from_apps', 'detect_platform', 'get_bazel_platform', 'get_watch_paths',
     'setup_dev_util', 'setup_postgres', 'setup_temporal', 'setup_otelcollector',
     'get_env_bool', 'get_custom_or_default',
     'print_startup_banner', 'print_footer_info')

# ===========================
# Configuration
# ===========================

namespace = 'audience-score-system-local-dev'
namespace_create(namespace)
dotenv()

platform = detect_platform()
bazel_platform = get_bazel_platform(platform)

print_startup_banner("Audience Score System", namespace, platform)

# ===========================
# Infrastructure Setup
# ===========================

setup_dev_util(namespace)

db_info = setup_postgres(namespace, db_name='audience_score_system', resource_name='postgres-dev-ass')
pg_database_url = get_custom_or_default(
    'BUILD_POSTGRES_ENV',
    'PG_DATABASE_URL',
    'postgres://{}:{}@{}:{}/{}?sslmode=disable'.format(
        db_info['user'], db_info['password'], db_info['host'], db_info['port'], db_info['database']
    )
)

# mcp hard-depends on Temporal at startup (main.go: constructs a Temporal
# client unconditionally for trigger_channel_sync's ScheduleManager),
# same as web/worker.
temporal_info = setup_temporal(namespace)
temporal_host = temporal_info['grpc_target']

otel_endpoint = setup_otelcollector(namespace, resource_name='otelcollector-dev-ass')

print("📊 Infrastructure configured:")
print("  Postgres:  {}".format("custom" if os.environ.get('BUILD_POSTGRES_ENV') == 'custom' else "local"))
print("  Temporal:  {}".format(temporal_host))
print("  OTEL:      {}".format(otel_endpoint))

# ===========================
# whagent-net trust configuration (issue #2116/#2121)
# ===========================
#
# Points this mcp's whagent verifier at whagent_net/api's JWKS endpoint
# and issuer -- see whagent_net/Tiltfile for that side (namespace
# 'whagent-net-local-dev', WHAGENT_ISSUER "whagent-net"). Both unset (the
# ASS_WHAGENT_JWKS_URL/ASS_WHAGENT_ISSUER default) would fall back to
# mcp_credential-only auth (main.go) -- setting them here mounts the
# whagent-net path ALONGSIDE it, never in place of it.
whagent_jwks_url = get_custom_or_default(
    'BUILD_WHAGENT_ENV', 'ASS_WHAGENT_JWKS_URL',
    'http://whagent-net-api.whagent-net-local-dev.svc.cluster.local:8090/.well-known/jwks.json',
)
whagent_issuer = get_custom_or_default('BUILD_WHAGENT_ENV', 'ASS_WHAGENT_ISSUER', 'whagent-net')

# ASS_MCP_PUBLIC_URL doubles as the whagent-net Claim's `aud` (audience)
# this mcp's verifier checks (ENV.md, "ASS_MCP_PUBLIC_URL"; issue #2151)
# -- it must exactly match whagent_net/config/agents.yaml's tool_set
# server_url for this service, INCLUDING the trailing slash (the `aud`
# check is an exact/Contains match, libs/go/whagent/verify.go). Default
# to the in-cluster address (not a host-facing localhost URL, which the
# worker -> mcp call never traverses) -- keep in sync with agents.yaml's
# server_url if either changes, same as this file's namespace/service-
# name comment above.
ass_mcp_public_url = get_custom_or_default(
    'BUILD_WHAGENT_ENV', 'ASS_MCP_PUBLIC_URL',
    'http://audience-score-system-mcp.{}.svc.cluster.local:8081/'.format(namespace),
)

# ===========================
# whagent-net UI trust configuration (issue #2600/#2638)
# ===========================
#
# Points `web`'s link.NewVerifier (FR3, issue #2598) at whagent_net's `ui`
# JWKS endpoint and issuer -- a DISTINCT pair from whagent_jwks_url/
# whagent_issuer above (that pair verifies api-minted persona Claims on
# `mcp`; this pair verifies ui-minted link assertions on `web`). `web`
# fails fast at startup if either is unset -- see ENV.md
# "ASS_WHAGENT_UI_JWKS_URL"/"ASS_WHAGENT_UI_ISSUER".
whagent_ui_jwks_url = get_custom_or_default(
    'BUILD_WHAGENT_ENV', 'ASS_WHAGENT_UI_JWKS_URL',
    'http://whagent-net-ui.whagent-net-local-dev.svc.cluster.local:8080/.well-known/jwks.json',
)
# Must equal whagent_net/Tiltfile's `ui` block's WHAGENT_UI_PUBLIC_URL
# exactly (a string-equality check against the assertion's `iss` claim,
# not a network address -- stays the browser-facing value even though
# whagent_ui_jwks_url above is the in-cluster one).
whagent_ui_issuer = get_custom_or_default(
    'BUILD_WHAGENT_ENV', 'ASS_WHAGENT_UI_ISSUER', 'http://localhost:8081',
)

# ===========================
# web: dev-only dummy secrets (issue #2635b/#2638)
# ===========================
#
# None of these authenticate against real infrastructure locally -- they
# exist only so auth.NewAuthenticator/mcpauth construction doesn't fail.
# Override via a local .env for a real Google OAuth client, same
# override-friendly os.environ.get(..., '<dummy>') pattern as
# whagent_net/Tiltfile's whagent_signing_key.
ass_google_client_id = os.environ.get('ASS_GOOGLE_CLIENT_ID', 'dummy-google-client-id.apps.googleusercontent.com')
ass_google_client_secret = os.environ.get('ASS_GOOGLE_CLIENT_SECRET', 'dummy-google-client-secret')
ass_session_secret = os.environ.get('ASS_SESSION_SECRET', 'dev-secret-key')
ass_token_encryption_key = os.environ.get('ASS_TOKEN_ENCRYPTION_KEY', 'dev-secret-key')

# ===========================
# Application Configuration
# ===========================

watch_paths = get_watch_paths('audience_score_system')

APPS = {
    'migration': {
        'enabled_env': 'ENABLE_ASS_MIGRATION',
        'bazel_target': '//audience_score_system/migrate:migration_image_load',
        'image_name': 'audience-score-system-migration',
    },
    'mcp': {
        'enabled_env': 'ENABLE_ASS_MCP',
        'bazel_target': '//audience_score_system/mcp:mcp_image_load',
        'image_name': 'audience-score-system-mcp',
    },
    'web': {
        'enabled_env': 'ENABLE_ASS_WEB',
        'bazel_target': '//audience_score_system/web:web_image_load',
        'image_name': 'audience-score-system-web',
    },
}

# ===========================
# Bazel Image Building
# ===========================

build_images_from_apps(APPS, watch_paths, platform)

# ===========================
# Kubernetes Deployments
# ===========================

if get_env_bool('ENABLE_ASS_MIGRATION', default='true'):
    k8s_yaml(blob("""
apiVersion: batch/v1
kind: Job
metadata:
  name: audience-score-system-migration
  namespace: {namespace}
spec:
  ttlSecondsAfterFinished: 30
  template:
    metadata:
      labels:
        app: audience-score-system-migration
    spec:
      restartPolicy: OnFailure
      containers:
      - name: migration
        image: audience-score-system-migration
        env:
        - name: PG_DATABASE_URL
          value: "{pg_database_url}"
""".format(namespace=namespace, pg_database_url=pg_database_url)))

    k8s_resource(
        'audience-score-system-migration',
        resource_deps=['postgres-dev-ass'],
        labels=['audience-score-system-infrastructure'],
    )
    print("🔄 Migration job configured")

# mcp: the only interface for C4-C7/C9/C10 (../ARCHITECTURE.md "NFR3
# interface allocation"). Deployed as Service name
# 'audience-score-system-mcp' -- whagent_net/config/agents.yaml's seeded
# tool_set server_url names exactly this Service, in this namespace, on
# port 8081.
if get_env_bool('ENABLE_ASS_MCP', default='true'):
    k8s_yaml(blob("""
apiVersion: v1
kind: Service
metadata:
  name: audience-score-system-mcp
  namespace: {namespace}
spec:
  selector:
    app: audience-score-system-mcp
  ports:
    - name: http
      port: 8081
      targetPort: 8081
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: audience-score-system-mcp
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: audience-score-system-mcp
  template:
    metadata:
      labels:
        app: audience-score-system-mcp
    spec:
      containers:
      - name: mcp
        image: audience-score-system-mcp
        ports:
        - containerPort: 8081
          name: http
        env:
        - name: PG_DATABASE_URL
          value: "{pg_database_url}"
        - name: ASS_MCP_ADDR
          value: ":8081"
        - name: ASS_MCP_PUBLIC_URL
          value: "{ass_mcp_public_url}"
        - name: ASS_OAUTH_REDIRECT_BASE_URL
          value: "http://localhost:8081"
        - name: TEMPORAL_HOST
          value: "{temporal_host}"
        - name: ASS_WHAGENT_JWKS_URL
          value: "{whagent_jwks_url}"
        - name: ASS_WHAGENT_ISSUER
          value: "{whagent_issuer}"
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: "{otel_endpoint}"
""".format(
        namespace=namespace,
        pg_database_url=pg_database_url,
        temporal_host=temporal_host,
        ass_mcp_public_url=ass_mcp_public_url,
        whagent_jwks_url=whagent_jwks_url,
        whagent_issuer=whagent_issuer,
        otel_endpoint=otel_endpoint,
    )))

    mcp_deps = ['temporal-dev']
    if get_env_bool('ENABLE_ASS_MIGRATION', default='true'):
        mcp_deps.append('audience-score-system-migration')

    k8s_resource(
        'audience-score-system-mcp',
        resource_deps=mcp_deps,
        port_forwards=['8081:8081'],
        labels=['audience-score-system'],
    )
    print("🔌 mcp forwarded to http://localhost:8081/ (whagent-net trust: {})".format(whagent_jwks_url))

# web: the only UI surface (NFR3) -- Google OAuth sign-in and the FR3-FR10
# whagent-ui link-acceptance flow (/link/whagent, /link/whagent/confirm).
# Deployed as Service name 'audience-score-system-web' on port 8080
# (release_app's port in audience_score_system/web/BUILD.bazel). The
# Google OAuth client id/secret and session/token secrets above are
# dev-only dummies -- they never authenticate against real Google
# infrastructure and exist only so auth.NewAuthenticator/mcpauth
# construction doesn't fail locally.
web_port_forward = 8083
web_public_url = 'http://localhost:{}'.format(web_port_forward)
if get_env_bool('ENABLE_ASS_WEB', default='true'):
    k8s_yaml(blob("""
apiVersion: v1
kind: Service
metadata:
  name: audience-score-system-web
  namespace: {namespace}
spec:
  selector:
    app: audience-score-system-web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: audience-score-system-web
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: audience-score-system-web
  template:
    metadata:
      labels:
        app: audience-score-system-web
    spec:
      containers:
      - name: web
        image: audience-score-system-web
        ports:
        - containerPort: 8080
          name: http
        env:
        - name: PG_DATABASE_URL
          value: "{pg_database_url}"
        - name: ASS_HTTP_ADDR
          value: ":8080"
        - name: ASS_GOOGLE_CLIENT_ID
          value: "{ass_google_client_id}"
        - name: ASS_GOOGLE_CLIENT_SECRET
          value: "{ass_google_client_secret}"
        - name: ASS_OAUTH_REDIRECT_BASE_URL
          value: "{web_public_url}"
        - name: ASS_SESSION_SECRET
          value: "{ass_session_secret}"
        - name: ASS_TOKEN_ENCRYPTION_KEY
          value: "{ass_token_encryption_key}"
        - name: ASS_MCP_PUBLIC_URL
          value: "{ass_mcp_public_url}"
        - name: ASS_WHAGENT_UI_JWKS_URL
          value: "{whagent_ui_jwks_url}"
        - name: ASS_WHAGENT_UI_ISSUER
          value: "{whagent_ui_issuer}"
        - name: TEMPORAL_HOST
          value: "{temporal_host}"
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: "{otel_endpoint}"
""".format(
        namespace=namespace,
        pg_database_url=pg_database_url,
        ass_google_client_id=ass_google_client_id,
        ass_google_client_secret=ass_google_client_secret,
        web_public_url=web_public_url,
        ass_session_secret=ass_session_secret,
        ass_token_encryption_key=ass_token_encryption_key,
        ass_mcp_public_url=ass_mcp_public_url,
        whagent_ui_jwks_url=whagent_ui_jwks_url,
        whagent_ui_issuer=whagent_ui_issuer,
        temporal_host=temporal_host,
        otel_endpoint=otel_endpoint,
    )))

    web_deps = ['temporal-dev', 'postgres-dev-ass']
    if get_env_bool('ENABLE_ASS_MIGRATION', default='true'):
        web_deps.append('audience-score-system-migration')

    k8s_resource(
        'audience-score-system-web',
        resource_deps=web_deps,
        port_forwards=['{}:8080'.format(web_port_forward)],
        labels=['audience-score-system'],
    )
    print("🌐 web forwarded to {} (whagent-ui trust: {})".format(web_public_url, whagent_ui_jwks_url))

# ===========================
# Access Information
# ===========================

print("\n" + "="*60)
print("📡 Access Information")
print("="*60)
print("  PostgreSQL:  localhost:5432 (user: postgres, pass: password)")
print("  Temporal:    localhost:7233 (gRPC), {} (Web UI)".format(temporal_info['ui_service_info']))
print("  mcp (HTTP):  http://localhost:8081/")
print("  web (HTTP):  {}/".format(web_public_url))
print("="*60)

print_footer_info('audience-score-system')

print("\n🚀 Quick Start:")
print("  1. tilt up                         # Start migration + mcp + web (this)")
print("  2. cd whagent_net && tilt up        # The whagent-net side of the cross-domain trust wiring")
