load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

# `worker` -- Audience Score System's Temporal worker: the per-Channel
# scheduled sync machinery (issue #1574, FR14/FR21, NFR4). See
# ../ARCHITECTURE.md and audience_score_system/worker/sync's package doc
# comment.
go_library(
    name = "worker_lib",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/audience_score_system/worker",
    visibility = ["//visibility:private"],
    deps = [
        "//audience_score_system/store",
        "//audience_score_system/worker/sync",
        "//libs/go/db",
        "//libs/go/logging",
        "//libs/go/temporal",
        "@io_temporal_go_sdk//activity",
        "@io_temporal_go_sdk//worker",
    ],
)

go_binary(
    name = "worker",
    embed = [":worker_lib"],
    visibility = ["//visibility:public"],
)

# Release metadata. domain "audience-score-system" + name "worker" produces
# the "audience-score-system-worker" image/app identity (see #1566).
# app_type "worker": a long-running background process, not an API (no
# port) and not a run-to-completion job like migrate.
release_app(
    name = "worker",
    binary_name = ":worker",
    language = "go",
    domain = "audience-score-system",
    description = "Audience Score System Temporal worker: per-Channel scheduled schedule/outcome sync (C6/C9, FR14/FR21, NFR4)",
    app_type = "worker",
)
