load("@rules_go//go:def.bzl", "go_library")

# Per-Channel Temporal scheduled-sync machinery (issue #1574, FR14/FR21,
# NFR4): ChannelSyncWorkflow (workflow.go), the SyncActivities interface
# both C6 schedule sync (#1576) and C9 outcome sync (#1581) plug their real
# activities into (activities.go), and ScheduleManager (schedule.go), the
# Go wiring on top of the Temporal SDK's client.ScheduleClient -- see
# workflow.go's package doc comment for Scaffold status.
go_library(
    name = "sync",
    srcs = [
        "activities.go",
        "schedule.go",
        "workflow.go",
    ],
    importpath = "github.com/whale-net/everything/audience_score_system/worker/sync",
    visibility = ["//visibility:public"],
    deps = [
        "//audience_score_system/store",
        "@com_github_google_uuid//:uuid",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//temporal",
        "@io_temporal_go_sdk//workflow",
    ],
)
