load("@rules_go//go:def.bzl", "go_library", "go_test")

# Per-Channel Temporal scheduled-sync machinery (issue #1574, FR14/FR21,
# NFR4): ChannelSyncWorkflow (workflow.go), the SyncActivities interface
# both C6 schedule sync (#1576) and C9 outcome sync (#1581) plug their real
# activities into (activities.go), and ScheduleManager (schedule.go), the
# Go wiring on top of the Temporal SDK's client.ScheduleClient -- see
# workflow.go's package doc comment for Scaffold status.
go_library(
    name = "sync",
    srcs = [
        "activities.go",
        "schedule.go",
        "video_sync.go",
        "workflow.go",
    ],
    importpath = "github.com/whale-net/everything/audience_score_system/worker/sync",
    visibility = ["//visibility:public"],
    deps = [
        "//audience_score_system/store",
        "//audience_score_system/tokens",
        "//audience_score_system/youtube",
        "//libs/go/logging",
        "@com_github_google_uuid//:uuid",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//temporal",
        "@io_temporal_go_sdk//workflow",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "sync_test",
    srcs = [
        "activities_test.go",
        "schedule_test.go",
        "video_sync_unit_test.go",
        "workflow_test.go",
    ],
    embed = [":sync"],
    deps = [
        "//audience_score_system/store",
        "//audience_score_system/tokens",
        "//audience_score_system/youtube",
        "//audience_score_system/youtube/fake",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//mock",
        "@com_github_stretchr_testify//require",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_sdk//activity",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//temporal",
        "@io_temporal_go_sdk//testsuite",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

# Real Postgres integration test for SyncSchedule (video_sync.go, issue
# #1576): the mixed-fixture upsert mapping, double-run idempotency (no row
# churn beyond last_synced_at), a changed-title update-in-place, a
# disappeared video's row retention, and the ErrRevoked -> MarkNeedsReauth
# + non-retryable RevokedErrorType / ErrQuotaExceeded+ErrTransient ->
# retryable classifications -- all against the real embedded schema
# through 002_research_schedule_outcome
# (//audience_score_system/migrate/schema), driven by a youtube/fake.Client
# so no test here ever makes a live YouTube API call. Deliberately NOT
# part of `bazel test //...` -- see //libs/go/dbtest's README for the full
# rationale, mirrored by
# //audience_score_system/tokens:tokens_integration_test. `# keep` tells a
# later `bazel run //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //audience_score_system/worker/sync:sync_integration_test --test_output=all
go_test(
    # keep
    name = "sync_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["video_sync_test.go"],
    embed = [":sync"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//audience_score_system/migrate/schema",
        "//audience_score_system/store",
        "//audience_score_system/tokens",
        "//audience_score_system/youtube",
        "//audience_score_system/youtube/fake",
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_temporal_go_sdk//temporal",
        "@org_golang_x_oauth2//:oauth2",
    ],
)
