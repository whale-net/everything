load("@rules_go//go:def.bzl", "go_library", "go_test")

# Audience Score System's MCP tool groups, one file per group. whoami.go
# (#1575) is the registry wiring proof; research.go (#1577) lands the
# first real product tools: C4's save_research_note/list_research_notes
# plus create_idea/list_ideas. get_channel_schedule (C6 read) was retired
# outright by FR46 (issue #1831, milestone video-script-model) -- see
# browse.go's get_channel_overview, which now presents C10's browsing
# surface over video_script instead (FR42). See
# ../server/registry.go's RegisterRead/RegisterWrite.
go_library(
    name = "tools",
    srcs = [
        "access.go",
        "access_audit.go",
        "browse.go",
        "list_channels.go",
        "matches.go",
        "my_work.go",
        "outcome_bar.go",
        "research.go",
        "strategy.go",
        "strategy_time.go",
        "sync_trigger.go",
        "verdict.go",
        "video_script.go",
        "whoami.go",
    ],
    importpath = "github.com/whale-net/everything/audience_score_system/mcp/tools",
    visibility = ["//visibility:public"],
    deps = [
        "//audience_score_system/mcp/server",
        "//audience_score_system/store",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

# Pure-Go coverage of validateSourceURL (FR10's rejection/NULL-coercion
