load("@rules_go//go:def.bzl", "go_library", "go_test")

# Embeds the real golang-migrate SQL so both the migration binary
# (//audience_score_system/migrate) and Postgres integration tests (e.g.
# //audience_score_system/store) apply the exact same schema instead of
# maintaining separate copies. See schema.go for why the embed directive
# uses "all:migrations" instead of a "*.sql" glob.
go_library(
    name = "schema",
    srcs = ["schema.go"],
    embedsrcs = glob(
        ["migrations/*"],
        allow_empty = True,
    ),
    importpath = "github.com/whale-net/everything/audience_score_system/migrate/schema",
    visibility = ["//visibility:public"],
)

# Trivial test asserting the embed FS resolves Dir without error, per the
# M1 Testing task for this scaffold (#1566). Passes both before and after
# real migrations exist since it only checks that ReadDir(Dir) succeeds.
go_test(
    name = "schema_test",
    srcs = ["schema_test.go"],
    embed = [":schema"],
)

# Real Postgres integration test proving individual migrations actually
# apply -- specifically migration 012's up/down (v_prediction_vs_outcome's
# re-anchor onto video_script, FR44/#1830), whose original CREATE OR
# REPLACE VIEW form was rejected by Postgres outright (SQLSTATE 42P16,
# #1849) in a way schema_test.go's ReadDir-only check could never catch.
# Deliberately NOT part of `bazel test //...` -- see //libs/go/dbtest's
# README for the full rationale behind each tag and how to run tests like
# this one.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //audience_score_system/migrate/schema:schema_integration_test --test_output=all
go_test(
    name = "schema_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["schema_integration_test.go"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":schema",
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
