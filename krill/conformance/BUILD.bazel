load("@rules_go//go:def.bzl", "go_test")

# krill's self-hosting round-trip proof (issue #2497, FR18/FR19): import
# krill's own committed brief through //krill/importer, render the imported
# Product back through //krill/render, and prove every FR16-reported
# entity is present in the rendered output -- keyed by entity id, never by
# diffing rendered text against the original document. Only krill's own
# brief is imported here; whagent_net's adoption is C27/M2 and stays out of
# scope (see roundtrip_integration_test.go's package doc). Deliberately NOT
# part of `bazel test //...` -- see //libs/go/dbtest's README for the
# rationale behind each tag below.
#
# design_milestone_query_integration_test.go (issue #2500, FR21) shares
# this target and its testEnv/krillDocsRoot helpers: it proves the
# live-consumer half of M1's self-hosting proof -- that
# slice.Querier.GetProductSlice (FR8), the call the design skill's
# krill-domain branch makes, surfaces the same capability content a
# milestone's committed Delivers line names, and fails loud and named
# rather than silently empty when the Product it's asked for does not
# exist. See krill/ARCHITECTURE.md "The design skill's live milestone read
# (FR21)".
#
# whagent_net_import_integration_test.go (issue #2549, FR11) shares this
# target too: it imports whagent_net's real, committed brief (data deps
# //whagent_net:docs, //whagent_net/product:docs, located via runfiles the
# same way krillDocsRoot locates krill's own) -- the first product krill
# holds that krill did not author -- and proves the FR11 entity-id report
# accounts for every source item, with no content lost across the import.
# Its own expected counts are derived from whagent_net's real files at
# test run time, not hardcoded (issue #2629), but the target itself stays
# `manual` for the same real-Postgres reason as the rest of this file --
# //krill/importer:whagent_net_parse_smoke_test is the non-manual,
# database-free smoke check that runs under default `bazel test //...`
# and would still catch a Parse regression in the interim.
#
# delivery_axis_integration_test.go (issue #2690, krill M3's own
# end-to-end proof) shares this target too: one connected walk through
# every M3 delivery-axis FR (#2683-#2689) against a real Postgres --
# milestone authoring, milepebbles and mid-milestone discovery, status
# history, per-item shipment, re-cut, the backlog bucket, and abandon --
# re-asserting every captured entity/container id across the whole walk
# (NFR1) and re-rendering PRODUCT.md/product/*.md at the end to prove a
# milepebble or the backlog bucket never leaks into product/03-roadmap.md.
# Unlike the other three files here, it never goes through
# //krill/importer -- the delivery axis has no markdown-import path of its
# own, so its fixture is built directly against //krill/store.
#
# work_axis_integration_test.go (issue #2728, krill M4's own end-to-end
# proof) shares this target too: one connected walk through the whole work
# axis (#2719-#2727) against a real Postgres -- task create, dependency
# gating, claim, heartbeat, lease-expiry reclaim, abandon, complete with
# verdict lane advance/revert, and FR10's cross-host resume via fetch-by-id
# -- plus a mechanical audit of every NFR the root plan (#2717) states for
# this milestone (NFR1-NFR7). Like delivery_axis_integration_test.go, it
# never goes through //krill/importer -- built directly against
# //krill/store, and, for NFR6's HTTP write-gate audit, //krill/api/handlers
# and //krill/work. NFR5's grep assertion reads the work axis's own
# committed source files through Bazel runfiles -- see the work_axis_srcs
# filegroup data deps below and //krill/store, //krill/api/handlers, and
# //krill/work's own BUILD.bazel comments on that filegroup.
#
# escalation_console_integration_test.go (issue #2877, krill M5's own
# end-to-end proof) shares this target too: one connected walk through
# the whole escalation/intervention/console axis (#2867-#2876) against a
# real Postgres -- claimed-console view, thrash-cap escalation,
# attempt-cap escalation, manual escalation (including FR9's
# single-event-at-cap exception), the escalated-console view, release,
# requeue, cancel and the cancelled-console view, note lifecycle and the
# open-notes console view, and paging with cross-scope token rejection --
# plus an NFR1-NFR6 and claimability-index audit. Like
# delivery_axis_integration_test.go/work_axis_integration_test.go, it
# never goes through //krill/importer -- built directly against
# //krill/store. NFR2's grep assertion reuses //krill/store's own
# work_axis_srcs filegroup below ("task*.go" already covers every M5
# store file with no glob change needed) rather than defining a second
# filegroup for the same directory.
#
# Run the round-trip tests explicitly (requires a working Docker daemon):
#   bazel test //krill/conformance:roundtrip_integration_test --test_output=all
#
# Regenerate the checked-in FR16 report artifact (testdata/fr16_report.txt)
# with `bazel run`, not `bazel test` -- see
# TestGenerateFR16ReportArtifact's doc comment for why:
#   bazel run //krill/conformance:roundtrip_integration_test \
#     --test_env=KRILL_CAPTURE_REPORT=1 --test_filter=TestGenerateFR16ReportArtifact
go_test(
    name = "roundtrip_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "delivery_axis_integration_test.go",
        "design_milestone_query_integration_test.go",
        "escalation_console_integration_test.go",
        "roundtrip_integration_test.go",
        "whagent_net_import_integration_test.go",
        "work_axis_integration_test.go",
    ],
    data = [
        "//krill:docs",
        "//krill/api/handlers:work_axis_srcs",
        "//krill/product:docs",
        "//krill/store:work_axis_srcs",
        "//krill/work:work_axis_srcs",
        "//whagent_net:docs",
        "//whagent_net/product:docs",
    ] + glob(["testdata/**"]),
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//krill/api/handlers",
        "//krill/importer",
        "//krill/migrate/schema",
        "//krill/render",
        "//krill/slice",
        "//krill/store",
        "//krill/work",
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/runfiles",
    ],
)
