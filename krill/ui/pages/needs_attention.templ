package pages

import (
	"strconv"

	"github.com/whale-net/everything/libs/go/htmxui"
)

// The filter bar's query parameters. They live here rather than in
// //krill/ui because this file is what writes them: the selects below
// submit these names, and //krill/ui aliases them for the parse -- one
// spelling, so a filtered link and the request it re-issues agree.
//
// The names are the ones krill api's console views read
// (api/handlers/console.go's milestoneIDQueryParam / reasonQueryParam), so
// a filter set has one spelling whether the operator's browser or an MCP
// client follows it.
const (
	// NeedsAttentionTabQueryParam names the selected tab.
	NeedsAttentionTabQueryParam = "tab"
	// NeedsAttentionMilestoneQueryParam names the milestone or milepebble
	// filter: a milestone_ref id of either kind, which the store's
	// ConsoleFilter narrows on.
	NeedsAttentionMilestoneQueryParam = "milestone_id"
	// NeedsAttentionReasonQueryParam names the escalation-reason filter,
	// offered on the Escalated tab alone.
	NeedsAttentionReasonQueryParam = "reason"
)

// The Needs attention page (FR 5fd47f4d): the tab strip and the one
// results region every tab swaps.
//
// It is to the four ops console queues what SpecTabs is to the four spec
// pages: the strip lives INSIDE the swap region rather than beside it, so
// a tab click's response is one root element carrying the re-marked strip
// and the new table together. A strip that were its own target would need
// the fragment to carry two top-level nodes, and htmx's outerHTML inserts
// every top-level node into the target -- so each click would splice a
// duplicate strip into the page (see pages/spec_tabs.templ, which applies
// the same rule).
//
// The results inside the region are the console's own: ClaimedResults,
// EscalatedResults, CancelledResults and NotesResults from ops.templ,
// carrying the ops-results id every row swap and the claimed tab's poll
// already target. This file adds only the strip around them.

// NeedsAttentionAnchor is the DOM id of the swap region: the hx-target
// every tab names, and the id the served fragment's ROOT must carry.
// Without it on the root, htmx deletes the element it was asked to replace
// and every later tab click is a no-op that never reaches the server.
const NeedsAttentionAnchor = "krill-needs-attention-panel"

// NeedsAttentionTab is one tab: the address it navigates to, whether it is
// the one being shown, and its count.
//
// HasCount is separate from Count because a count that could not be read
// is not a zero: the badge is rendered only when a figure was actually
// read, so an unreadable queue shows nothing rather than a confident 0.
type NeedsAttentionTab struct {
	Key    string
	Label  string
	Href   string
	Active bool

	// Count is the tab's queue size under this tab's filters, meaningful
	// only when HasCount.
	Count    int
	HasCount bool
}

// NeedsAttentionData is the page's view model: the strip, the tab the
// request resolved to, the freshness stamp, the way back to the view's own
// address, and the results region itself.
type NeedsAttentionData struct {
	Tabs []NeedsAttentionTab

	// Tab is the resolved tab key, and the page's own statement of which
	// one is showing -- so a test (and a reader) never has to infer it
	// from which link carries the active class.
	Tab string

	// UpdatedAt is the exact UTC instant the page's data was read, and
	// UpdatedRelative its age at render time. The exact instant is the
	// element's title and datetime, so hovering answers "exactly when"
	// with or without the head script; the relative form is what renders
	// server-side, so the page says something readable either way.
	UpdatedAt       string
	UpdatedRelative string

	// RefreshHref is the view's own request URI. The manual refresh's
	// hx-get re-requests the tab the operator is on, page and filters
	// included, rather than a fixed route.
	RefreshHref string

	// Filter is the page's filter bar: the milestone select every tab
	// shares, the reason select the Escalated tab adds, and the sentence
	// the Open notes tab carries while a milestone narrows it.
	Filter NeedsAttentionFilterBar

	// Results is the selected tab's table, or its inline refusal.
	Results templ.Component
}

// NeedsAttentionFilterBar is the filter bar's view model: the two selects'
// options, each marking the value this request resolved to, and the
// Open-notes-only notice a milestone filter turns on.
type NeedsAttentionFilterBar struct {
	// Path is the page's own URL: the form's action and its hx-get, so the
	// no-JavaScript submit and the in-place swap ask for the same query.
	Path string

	// Milestones are the milestone select's options, "All milestones"
	// first. Each value is a milestone_ref id -- a milestone or one of its
	// milepebbles -- which is exactly what store.ConsoleFilter narrows on.
	Milestones []NeedsAttentionFilterOption

	// Reasons are the reason select's options, "Any reason" first. Empty
	// when ShowReason is off.
	Reasons []NeedsAttentionFilterOption

	// ShowReason reveals the reason select. It is offered on the Escalated
	// tab alone: it is the one queue whose rows carry a reason.
	ShowReason bool

	// Notice is the Open notes tab's sentence when a milestone filter is
	// in force. A note attached to a spec-axis entity has no delivery
	// container, so a milestone filter excludes it outright
	// (store.ListOpenNotesParams' own rule) and the tab has to say so
	// rather than let the operator read the shortfall as all there is.
	Notice string
}

// NeedsAttentionFilterOption is one option of the filter bar's selects.
// Value is the wire value the URL carries (empty for a select's "all"
// default), Label what the operator reads.
type NeedsAttentionFilterOption struct {
	Value    string
	Label    string
	Selected bool
}

// NeedsAttention renders the strip and the active tab's results, both
// inside the one region every tab swaps. The rest of the page -- shell,
// nav, product switcher -- sits outside it and is never re-derived by a
// tab click.
templ NeedsAttention(d NeedsAttentionData) {
	<div id={ NeedsAttentionAnchor } data-krill="needs-attention" data-krill-tab={ d.Tab }>
		<div class="flex flex-wrap items-center justify-between gap-4">
			@needsAttentionTabStrip(d.Tabs)
			<div class="flex items-center gap-2">
				@needsAttentionFreshness(d)
				if d.RefreshHref != "" {
					<button
						type="button"
						class="btn btn-ghost btn-sm"
						hx-get={ d.RefreshHref }
						hx-target={ "#" + opsResultsID }
						hx-swap="outerHTML"
					>Refresh</button>
				}
			</div>
		</div>
		@needsAttentionFilterBar(d)
		if d.Filter.Notice != "" {
			<p class="mt-2 text-sm text-base-content/70" data-krill="needs-attention-notes-notice">{ d.Filter.Notice }</p>
		}
		<div class="mt-4" data-krill="needs-attention-results">
			@d.Results
		</div>
	</div>
}

// needsAttentionFilterBar is the page's filter bar: a plain GET form whose
// submits are the whole of the state, so a reload, a shared link and a
// no-JavaScript submit all land on the same filters. htmx is layered on top
// -- hx-get onto the same path, targeting the panel's own anchor -- so a
// selection changes the table in place without the working case depending
// on JavaScript.
//
// The tab rides as a hidden field because the form's query is what the URL
// becomes: without it, changing a filter would silently drop the operator
// onto the default tab. page_token deliberately does not ride: a filter
// change is a different read, whose token the store would refuse.
templ needsAttentionFilterBar(d NeedsAttentionData) {
	<form method="get" action={ templ.URL(d.Filter.Path) } class="mt-3 flex flex-wrap items-end gap-3"
		data-krill="needs-attention-filters"
		hx-get={ templ.URL(d.Filter.Path) }
		hx-target={ "#" + NeedsAttentionAnchor }
		hx-swap="outerHTML"
		hx-trigger="change, submit"
		hx-push-url="true">
		<input type="hidden" name={ NeedsAttentionTabQueryParam } value={ d.Tab } />
		<label class="fieldset">
			<span class="fieldset-legend">Milestone</span>
			<select name={ NeedsAttentionMilestoneQueryParam } class="select select-sm"
				aria-label="Milestone" data-krill="needs-attention-milestone-select">
				for _, o := range d.Filter.Milestones {
					<option value={ o.Value } selected?={ o.Selected } data-krill-milestone-option={ o.Value }>
						{ o.Label }
					</option>
				}
			</select>
		</label>
		if d.Filter.ShowReason {
			<label class="fieldset">
				<span class="fieldset-legend">Reason</span>
				<select name={ NeedsAttentionReasonQueryParam } class="select select-sm"
					aria-label="Reason" data-krill="needs-attention-reason-select">
					for _, o := range d.Filter.Reasons {
						<option value={ o.Value } selected?={ o.Selected } data-krill-reason-option={ o.Value }>
							{ o.Label }
						</option>
					}
				</select>
			</label>
		}
		<button type="submit" class="btn btn-primary btn-sm" data-krill="needs-attention-apply">Apply</button>
	</form>
}

// NeedsAttentionFilteredEmpty is the tab's empty state when a filter
// excluded every row: it names the filters in force, so "no rows" reads as
// "nothing matched these filters" rather than as a scope with no work.
//
// It is a DIFFERENT shape from the read-failed state (ops.templ's
// OpsInlineError): that one reports a read that could not be answered,
// this one reports a read that was answered with nothing. Rendering the
// two the same way would tell an operator a filter excluded everything
// when in fact nothing could be read.
//
// It carries opsResultsID because it is what the results block swaps to:
// without the id the region's own target would be deleted and the next
// Refresh would no-op.
templ NeedsAttentionFilteredEmpty(d NeedsAttentionEmptyData) {
	<div id={ opsResultsID } data-krill="needs-attention-empty">
		@htmxui.EmptyState(d.Headline, d.Detail, "", "", nil)
	</div>
}

// NeedsAttentionEmptyData is that empty state's two sentences.
type NeedsAttentionEmptyData struct {
	// Headline names the queue and the filters in force.
	Headline string
	// Detail is the one sentence telling the operator which control to
	// change.
	Detail string
}

// needsAttentionFreshness is the header's "Updated N ago" stamp: the
// relative age as the visible text, with the exact instant carried in the
// datetime, the title and the data-krill-updated-at hook, so hovering
// answers "exactly when".
//
// The server renders the relative form (relativeTime, in package main) so
// the page reads correctly with JavaScript off, and the head's
// relativeAgeScript re-derives "Updated N ago" from the attribute so the
// stamp ages between swaps instead of freezing at the read.
templ needsAttentionFreshness(d NeedsAttentionData) {
	<time class="text-sm text-base-content/70" data-krill="needs-attention-updated-at"
		data-krill-updated-at={ d.UpdatedAt } datetime={ d.UpdatedAt } title={ d.UpdatedAt }>
		Updated { d.UpdatedRelative }
	</time>
}

// needsAttentionTabStrip is the tablist: four real links, each carrying
// the htmx attributes that swap the region in place and push the tab's own
// URL, and each labelled with its count. Without JavaScript a tab click
// still navigates to the same address, so the tab is never reachable only
// through a script.
//
// aria-selected is emitted on every tab rather than only the active one,
// because an omitted aria-selected on a role="tab" leaves its state
// undefined rather than false.
templ needsAttentionTabStrip(tabs []NeedsAttentionTab) {
	<div role="tablist" class="tabs tabs-border" data-krill="needs-attention-tabs">
		for _, t := range tabs {
			<a role="tab" href={ templ.URL(t.Href) }
				class={ needsAttentionTabClasses(t.Active) }
				aria-selected={ needsAttentionTabSelected(t.Active) }
				hx-get={ templ.URL(t.Href) }
				hx-target={ "#" + NeedsAttentionAnchor }
				hx-swap="outerHTML"
				hx-push-url="true"
				data-krill="needs-attention-tab" data-krill-tab={ t.Key }>
				{ t.Label }
				if t.HasCount {
					<span class="badge badge-sm" data-krill="needs-attention-count" data-krill-tab={ t.Key }>{ strconv.Itoa(t.Count) }</span>
				}
			</a>
		}
	</div>
}

// needsAttentionTabClasses is one tab's daisyUI class, so the strip carries
// exactly one active marking whichever tab the URL resolved to.
func needsAttentionTabClasses(active bool) string {
	if active {
		return "tab tab-active"
	}
	return "tab"
}

func needsAttentionTabSelected(active bool) string {
	if active {
		return "true"
	}
	return "false"
}

// ---------------------------------------------------------------------------
// cancelled tab (FR b22e1d60)
// ---------------------------------------------------------------------------

// NeedsAttentionCancelledResults renders the Cancelled tab's rows inside
// the shared results block, so the manual Refresh target, the paging link
// and the inline-refusal slot are the ones every tab already uses.
templ NeedsAttentionCancelledResults(d CancelledData) {
	@opsResults(OpsResultsData{
		Table:      needsAttentionCancelledTable(d.Rows),
		NextHref:   d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

// needsAttentionCancelledTable is the Cancelled tab's table: Task (the
// title, linking to the product-scoped detail), Milestone, Lane badge,
// who cancelled it and when, and the reason when one was given.
templ needsAttentionCancelledTable(rows []CancelledRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No cancelled tasks.", "Nothing has been cancelled in this product.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Task</th>
						<th>Milestone</th>
						<th>Lane</th>
						<th>Cancelled by</th>
						<th>On behalf of</th>
						<th>Cancelled at</th>
						<th>Reason</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover" data-krill="needs-attention-cancelled-row">
							<td class="text-sm">
								if row.TaskHref != "" {
									<a href={ templ.URL(row.TaskHref) } class="link font-medium" data-krill="needs-attention-task-link">{ row.Title }</a>
								} else {
									{ row.Title }
								}
							</td>
							<td class="text-sm">{ row.Delivery }</td>
							<td class="text-sm">@TaskLaneBadge(row.Lane)</td>
							<td class="text-sm">{ row.By }</td>
							<td class="text-sm">{ row.OnBehalfOf }</td>
							<td class="text-sm">{ row.At }</td>
							<td class="text-sm">{ row.Reason }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ---------------------------------------------------------------------------
// open-notes tab (FR b22e1d60)
// ---------------------------------------------------------------------------

// NeedsAttentionNotesResults renders the Open notes tab's rows inside the
// shared results block, exactly as the Cancelled tab does.
templ NeedsAttentionNotesResults(d NotesData) {
	@opsResults(OpsResultsData{
		Table:      needsAttentionNotesTable(d.Rows),
		NextHref:   d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

// needsAttentionNotesTable is the Open notes tab's table: the note's
// target (a link when the target is a task, and never a link when it is a
// spec-axis entity, which has no task page), a kind badge, a lifecycle
// status badge, the body as markdown, and the created time.
templ needsAttentionNotesTable(rows []NoteRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No open notes.", "No note in this product is still awaiting a decision.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Target</th>
						<th>Kind</th>
						<th>Status</th>
						<th>Created</th>
						<th>Body</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover" data-krill="needs-attention-note-row">
							<td class="text-sm">
								if row.TaskHref != "" {
									<a href={ templ.URL(row.TaskHref) } class="link font-medium" data-krill="needs-attention-task-link">{ row.Target }</a>
								} else {
									{ row.Target }
								}
							</td>
							<td class="text-sm">
								@htmxui.Badge(row.Kind, htmxui.BadgeInfo, htmxui.BadgeSizeSM, true, templ.Attributes{"data-krill": "needs-attention-note-kind"})
							</td>
							<td class="text-sm">
								@htmxui.Badge(row.Status, htmxui.BadgeGhost, htmxui.BadgeSizeSM, true, templ.Attributes{"data-krill": "needs-attention-note-status"})
							</td>
							<td class="text-sm">{ row.CreatedAt }</td>
							<td class="text-sm krill-md">@templ.Raw(renderMarkdown(row.Body))</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
