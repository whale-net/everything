package pages

import (
	"strconv"

"github.com/whale-net/everything/krill/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// Filter bar query parameters, written by the selects below and shared with
// //krill/ui and krill api's console views so a filter has one spelling.
const (
	NeedsAttentionTabQueryParam = "tab"
	// NeedsAttentionMilestoneQueryParam filters by a milestone_ref id (milestone
	// or milepebble).
	NeedsAttentionMilestoneQueryParam = "milestone_id"
	// NeedsAttentionReasonQueryParam filters by escalation reason (Escalated tab only).
	NeedsAttentionReasonQueryParam = "reason"
)

// Needs attention page: the tab strip and the one results region every tab
// swaps. The strip lives inside the swap region because htmx outerHTML inserts
// every top-level node, so a separate strip would be duplicated on each click.

// NeedsAttentionAnchor is the swap region's DOM id and must be the served
// fragment's root id, or htmx deletes the target and later tab clicks no-op.
const NeedsAttentionAnchor = "krill-needs-attention-panel"

// NeedsAttentionTab is one tab. HasCount separates an unreadable count from
// zero, so an unreadable queue shows no badge.
type NeedsAttentionTab struct {
	Key    string
	Label  string
	Href   string
	Active bool

	// Count is the queue size under this tab's filters, valid only when HasCount.
	Count    int
	HasCount bool
}

// NeedsAttentionData is the page's view model.
type NeedsAttentionData struct {
	Tabs []NeedsAttentionTab

	// Tab is the resolved tab key.
	Tab string

	// UpdatedAt is the exact UTC read instant (title and datetime);
	// UpdatedRelative is its server-rendered age.
	UpdatedAt       string
	UpdatedRelative string

	// RefreshHref is the view's own request URI, so Refresh keeps the tab, page,
	// and filters.
	RefreshHref string

	Filter NeedsAttentionFilterBar

	// Results is the selected tab's table, or its inline refusal.
	Results templ.Component

	// Paging is the active tab's table footer. Nil when there is no table to foot
	// (filtered empty or failed read), so a footer never guesses a total.
	Paging *NeedsAttentionPaging
}

// NeedsAttentionFilterBar is the filter bar's view model.
type NeedsAttentionFilterBar struct {
	// Path is the page URL, used as both form action and hx-get.
	Path string

	// Milestones are the milestone select's options, "All milestones" first;
	// values are milestone_ref ids.
	Milestones []NeedsAttentionFilterOption

	// Reasons are the reason select's options, "Any reason" first.
	Reasons []NeedsAttentionFilterOption

	// ShowReason reveals the reason select; only escalated rows carry a reason.
	ShowReason bool

	// Notice explains, on Open notes, that a milestone filter excludes notes on
	// spec-axis entities, which have no delivery container.
	Notice string
}

// NeedsAttentionFilterOption is one select option; Value is empty for "all".
type NeedsAttentionFilterOption struct {
	Value    string
	Label    string
	Selected bool
}

// NeedsAttention renders the strip and active tab's results inside the one
// swap region; shell chrome stays outside it.
templ NeedsAttention(d NeedsAttentionData) {
	<div id={ NeedsAttentionAnchor } data-krill="needs-attention" data-krill-tab={ d.Tab }>
		<div class="mb-3 flex flex-wrap items-center justify-between gap-4">
			<h1 class="text-2xl font-semibold" data-krill="page-title">Needs attention</h1>
			<div class="flex items-center gap-2">
				@needsAttentionFreshness(d)
				if d.RefreshHref != "" {
					<button
						type="button"
						class="btn btn-ghost btn-sm"
						hx-get={ d.RefreshHref }
						hx-target={ "#" + OpsResultsAnchor }
						hx-swap="outerHTML"
					>Refresh</button>
				}
			</div>
		</div>
		@needsAttentionTabStrip(d.Tabs)
		@needsAttentionFilterBar(d)
		if d.Filter.Notice != "" {
			<p class="mt-2 text-sm text-base-content/70" data-krill="needs-attention-notes-notice">{ d.Filter.Notice }</p>
		}
		<div class="mt-4" data-krill="needs-attention-results">
			@d.Results
		</div>
		if d.Paging != nil {
			@NeedsAttentionPagingFooter(*d.Paging)
		}
	</div>
}

// needsAttentionFilterBar is a plain GET form, so reloads, links, and no-JS
// submits agree; htmx swaps in place on top. The tab rides as a hidden field;
// page_token does not, since a new filter invalidates it.
templ needsAttentionFilterBar(d NeedsAttentionData) {
	<form method="get" action={ templ.URL(d.Filter.Path) } class="mt-3 flex flex-wrap items-end gap-3"
		data-krill="needs-attention-filters"
		hx-get={ templ.URL(d.Filter.Path) }
		hx-target={ "#" + NeedsAttentionAnchor }
		hx-swap="outerHTML"
		hx-trigger="change, submit"
		hx-push-url="true">
		<input type="hidden" name={ NeedsAttentionTabQueryParam } value={ d.Tab } />
		<label class="fieldset">
			<span class="fieldset-legend">Milestone</span>
			<select name={ NeedsAttentionMilestoneQueryParam } class="select select-sm"
				aria-label="Milestone" data-krill="needs-attention-milestone-select">
				for _, o := range d.Filter.Milestones {
					<option value={ o.Value } selected?={ o.Selected } data-krill-milestone-option={ o.Value }>
						{ o.Label }
					</option>
				}
			</select>
		</label>
		if d.Filter.ShowReason {
			<label class="fieldset">
				<span class="fieldset-legend">Reason</span>
				<select name={ NeedsAttentionReasonQueryParam } class="select select-sm"
					aria-label="Reason" data-krill="needs-attention-reason-select">
					for _, o := range d.Filter.Reasons {
						<option value={ o.Value } selected?={ o.Selected } data-krill-reason-option={ o.Value }>
							{ o.Label }
						</option>
					}
				</select>
			</label>
		}
		<button type="submit" class="btn btn-primary btn-sm" data-krill="needs-attention-apply">Apply</button>
	</form>
}

// NeedsAttentionFilteredEmpty is the empty state when filters excluded every
// row, distinct from a failed read. It carries OpsResultsAnchor so the next
// Refresh still has a target.
templ NeedsAttentionFilteredEmpty(d NeedsAttentionEmptyData) {
	<div id={ OpsResultsAnchor } data-krill="needs-attention-empty">
		@htmxui.EmptyState(d.Headline, d.Detail, "", "", nil)
	</div>
}

type NeedsAttentionEmptyData struct {
	Headline string
	Detail string
}

// needsAttentionFreshness is the "Updated N ago" stamp: server-rendered for
// no-JS, re-aged client-side by relativeAgeScript from the exact instant.
templ needsAttentionFreshness(d NeedsAttentionData) {
	<time class="text-sm text-base-content/70" data-krill="needs-attention-updated-at"
		data-krill-updated-at={ d.UpdatedAt } datetime={ d.UpdatedAt } title={ d.UpdatedAt }>
		Updated { d.UpdatedRelative }
	</time>
}

// needsAttentionTabStrip renders tabs as real links with htmx swap and push,
// so they work without JavaScript. aria-selected is always emitted because an
// omitted value is undefined, not false.
templ needsAttentionTabStrip(tabs []NeedsAttentionTab) {
	<div role="tablist" class="tabs tabs-border" data-krill="needs-attention-tabs">
		for _, t := range tabs {
			<a role="tab" href={ templ.URL(t.Href) }
				class={ needsAttentionTabClasses(t.Active) }
				aria-selected={ needsAttentionTabSelected(t.Active) }
				hx-get={ templ.URL(t.Href) }
				hx-target={ "#" + NeedsAttentionAnchor }
				hx-swap="outerHTML"
				hx-push-url="true"
				data-krill="needs-attention-tab" data-krill-tab={ t.Key }>
				{ t.Label }
				if t.HasCount {
					<span class="badge badge-sm" data-krill="needs-attention-count" data-krill-tab={ t.Key }>{ strconv.Itoa(t.Count) }</span>
				}
			</a>
		}
	</div>
}

func needsAttentionTabClasses(active bool) string {
	if active {
		return "tab tab-active"
	}
	return "tab"
}

func needsAttentionTabSelected(active bool) string {
	if active {
		return "true"
	}
	return "false"
}

// ---------------------------------------------------------------------------
// Claimed tab
// ---------------------------------------------------------------------------

// ClaimedRow is one Claimed tab row, pre-formatted in package main. Times are
// absolute RFC3339 so polled fragments stay byte-stable; the browser derives
// relative forms. ClaimID is the observed claim every action posts as a guard.
type ClaimedRow struct {
	TaskID string
	Title  string
	// TaskHref is empty when the read was not product-narrowed; the title then
	// renders unlinked.
	TaskHref string
	Milestone      string
	Lane           string
	Claimant       string
	ClaimedSince   string
	LeaseExpiresAt string
	ClaimID        string
	Actions        templ.Component
	// Popovers render after the table so no row contains a text input; each
	// submits the form Actions rendered in this row.
	Popovers templ.Component
}

// claimedTable renders the Claimed rows, soonest lease first.
templ claimedTable(rows []ClaimedRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No claimed tasks.", "Nothing holds a claim in this scope right now.", "", "", nil)
	} else {
		<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
			<table class="table table-sm" data-krill="claimed-table">
				<thead>
					<tr>
						<th>Task</th>
						<th>Milestone</th>
						<th>Lane</th>
						<th>Claimant</th>
						<th>Claimed since</th>
						<th>Lease expires</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						// data-krill-claim-id is the observed claim the row's actions post.
						<tr class="hover" data-krill="claimed-row"
							data-krill-task-id={ row.TaskID } data-krill-claim-id={ row.ClaimID }>
							<td class="text-sm">
								if row.TaskHref != "" {
									<a href={ templ.URL(row.TaskHref) } class="link font-medium" data-krill="task-title">{ row.Title }</a>
								} else {
									<span data-krill="task-title">{ row.Title }</span>
								}
							</td>
							<td class="text-sm" data-krill="task-milestone">{ row.Milestone }</td>
							<td class="text-sm">@TaskLaneBadge(row.Lane)</td>
							<td class="text-sm" data-krill="task-claimant">{ row.Claimant }</td>
							<td class="text-sm">
								<time datetime={ row.ClaimedSince } title={ row.ClaimedSince }>{ row.ClaimedSince }</time>
							</td>
							<td class="text-sm">
								<time data-krill="task-lease" datetime={ row.LeaseExpiresAt } title={ row.LeaseExpiresAt }>{ row.LeaseExpiresAt }</time>
							</td>
							<td class="text-sm">
								<div class="flex flex-wrap items-center gap-1">
									if row.Actions != nil {
										@row.Actions
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		for _, row := range rows {
			if row.Popovers != nil {
				@row.Popovers
			}
		}
	}
}

// ---------------------------------------------------------------------------
// Escalated tab
// ---------------------------------------------------------------------------

// NeedsAttentionEscalatedRow is one Escalated tab row, pre-formatted in
// package main.
type NeedsAttentionEscalatedRow struct {
	TaskID string

	// DetailHref is the product-scoped task detail; the table spans milestones.
	Title      string
	DetailHref string

	// ByLine is "by <acting> for <on behalf of>" from the escalation's subjects.
	ByLine string

	Milestone string

	Lane string

	// Reason is the store's wire value; the badge renders its label.
	Reason string

	// Attempts is the count against the cap, e.g. "2 of 3".
	Attempts string

	// EscalatedAt is the exact UTC instant; EscalatedAtRelative its coarse age.
	EscalatedAt         string
	EscalatedAtRelative string

	// EscalationID is the observed escalation the row's actions are guarded by;
	// empty means no guard.
	EscalationID string

	Actions templ.Component

	// Popovers render after the table so no row contains a text input.
	Popovers templ.Component
}

type NeedsAttentionEscalatedData struct {
	Rows       []NeedsAttentionEscalatedRow
	NextHref   string
	Error      string
	Href       string
	ReadFailed bool
}

// EscalatedQueueResults is the Escalated tab's results block, sharing
// opsResults' swap target and refusal/next-page furniture.
templ EscalatedQueueResults(d NeedsAttentionEscalatedData) {
	@opsResults(OpsResultsData{
		Table:      escalatedQueueTable(d.Rows),
		NextHref:   d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

// escalatedQueueTable renders escalated rows, or the empty state.
templ escalatedQueueTable(rows []NeedsAttentionEscalatedRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No escalated tasks.", "No task in this scope carries an active escalation.", "", "", nil)
	} else {
		<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
			<table class="table table-sm" data-krill="escalated-table">
				<thead>
					<tr>
						<th>Task</th>
						<th>Milestone</th>
						<th>Lane</th>
						<th>Reason</th>
						<th class="text-right">Attempts</th>
						<th>Escalated</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover" data-krill="escalated-row" data-krill-task-id={ row.TaskID } data-krill-escalation-id={ row.EscalationID }>
							<td class="text-sm">
								<a href={ templ.URL(row.DetailHref) } class="link font-medium" data-krill="escalated-task-title">{ row.Title }</a>
								<div class="text-sm text-base-content/70" data-krill="escalated-by">{ row.ByLine }</div>
							</td>
							<td class="text-sm" data-krill="escalated-milestone">{ row.Milestone }</td>
							<td class="text-sm">
								@TaskLaneBadge(row.Lane)
							</td>
							<td class="text-sm">
								@escalatedReasonBadge(row.Reason)
							</td>
							<td class="text-sm text-right" data-krill="escalated-attempts">{ row.Attempts }</td>
							<td class="text-sm">
								<time data-krill="escalated-at" datetime={ row.EscalatedAt } title={ row.EscalatedAt }>{ row.EscalatedAtRelative }</time>
							</td>
							<td class="text-sm text-right">
								<div class="flex flex-wrap items-center justify-end gap-1">
									if row.Actions != nil {
										@row.Actions
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		for _, row := range rows {
			if row.Popovers != nil {
				@row.Popovers
			}
		}
	}
}

// escalatedReasonBadge renders a reason via the shared vocabulary, so an
// unknown reason never renders blank.
templ escalatedReasonBadge(reason string) {
	{{ s := components.EscalationReasonStyle(reason) }}
	@htmxui.Badge(components.EscalationReasonLabel(reason), s.Variant, s.Size, s.Soft,
		templ.Attributes{"data-krill": "escalated-reason"})
}

// ---------------------------------------------------------------------------
// Tab paging footer
// ---------------------------------------------------------------------------

// NeedsAttentionPaging is the active tab's table footer. Total is counted with
// the same params as the rows; HasTotal keeps an unreadable count from
// rendering as "of 0".
type NeedsAttentionPaging struct {
	Shown int

	// Total is the whole filtered set's count, valid only when HasTotal.
	Total    int
	HasTotal bool

	// Summary is built in Go so templ does not split "Showing 25 of 100" around
	// injected comments.
	Summary string

	// PrevHref is the preceding page. Keyset tokens only page forward, so it is
	// usually empty and Previous renders disabled.
	PrevHref string

	// NextHref is the following page; a store token exists exactly when more rows
	// remain.
	NextHref string

	// PrevNote and NextNote title a disabled control with why it is inert.
	PrevNote string
	NextNote string
}

// NeedsAttentionPagingFooter renders "Showing X of Y" and Previous/Next. An
// inert control renders disabled rather than vanishing; a live one is a real
// link, since a page position is a URL.
templ NeedsAttentionPagingFooter(p NeedsAttentionPaging) {
	<div class="mt-3 flex flex-wrap items-center justify-between gap-2" data-krill="needs-attention-paging">
		<span class="text-sm text-base-content/70" data-krill="paging-summary">{ p.Summary }</span>
		<div class="flex items-center gap-2">
			if p.PrevHref != "" {
				<a href={ templ.URL(p.PrevHref) } class="btn btn-ghost btn-sm" data-krill="paging-previous">Previous</a>
			} else {
				<button type="button" class="btn btn-ghost btn-sm" disabled data-krill="paging-previous"
					title={ p.PrevNote }>Previous</button>
			}
			if p.NextHref != "" {
				<a href={ templ.URL(p.NextHref) } class="btn btn-ghost btn-sm" data-krill="paging-next">Next</a>
			} else {
				<button type="button" class="btn btn-ghost btn-sm" disabled data-krill="paging-next"
					title={ p.NextNote }>Next</button>
			}
		</div>
	</div>
}

// ---------------------------------------------------------------------------
// Cancelled tab
// ---------------------------------------------------------------------------

// NeedsAttentionCancelledResults renders the Cancelled rows inside the shared
// results block.
templ NeedsAttentionCancelledResults(d CancelledData) {
	@opsResults(OpsResultsData{
		Table:      needsAttentionCancelledTable(d.Rows),
		NextHref:   d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

templ needsAttentionCancelledTable(rows []CancelledRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No cancelled tasks.", "Nothing has been cancelled in this product.", "", "", nil)
	} else {
		<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Task</th>
						<th>Milestone</th>
						<th>Lane</th>
						<th>Cancelled by</th>
						<th>On behalf of</th>
						<th>Cancelled at</th>
						<th>Reason</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover" data-krill="needs-attention-cancelled-row">
							<td class="text-sm">
								if row.TaskHref != "" {
									<a href={ templ.URL(row.TaskHref) } class="link font-medium" data-krill="needs-attention-task-link">{ row.Title }</a>
								} else {
									{ row.Title }
								}
							</td>
							<td class="text-sm">{ row.Delivery }</td>
							<td class="text-sm">@TaskLaneBadge(row.Lane)</td>
							<td class="text-sm">{ row.By }</td>
							<td class="text-sm">{ row.OnBehalfOf }</td>
							<td class="text-sm">{ row.At }</td>
							<td class="text-sm">{ row.Reason }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ---------------------------------------------------------------------------
// Open notes tab
// ---------------------------------------------------------------------------

// NeedsAttentionNotesResults renders the Open notes rows inside the shared
// results block.
templ NeedsAttentionNotesResults(d NotesData) {
	@opsResults(OpsResultsData{
		Table:      needsAttentionNotesTable(d.Rows),
		NextHref:   d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

// needsAttentionNotesTable renders open notes. Only task targets link; spec-axis
// entities have no task page.
templ needsAttentionNotesTable(rows []NoteRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No open notes.", "No note in this product is still awaiting a decision.", "", "", nil)
	} else {
		<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Target</th>
						<th>Kind</th>
						<th>Status</th>
						<th>Created</th>
						<th>Body</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover" data-krill="needs-attention-note-row">
							<td class="text-sm">
								if row.TaskHref != "" {
									<a href={ templ.URL(row.TaskHref) } class="link font-medium" data-krill="needs-attention-task-link">{ row.Target }</a>
								} else {
									{ row.Target }
								}
							</td>
							<td class="text-sm">
								@htmxui.Badge(row.Kind, htmxui.BadgeInfo, htmxui.BadgeSizeSM, true, templ.Attributes{"data-krill": "needs-attention-note-kind"})
							</td>
							<td class="text-sm">
								@htmxui.Badge(row.Status, htmxui.BadgeGhost, htmxui.BadgeSizeSM, true, templ.Attributes{"data-krill": "needs-attention-note-status"})
							</td>
							<td class="text-sm">{ row.CreatedAt }</td>
							<td class="text-sm krill-md">@templ.Raw(renderMarkdown(row.Body))</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}