package pages

import "github.com/whale-net/everything/libs/go/htmxui"

// The product-wide Tasks/Board region's view model and rendering. Rows render
// in the store read's order, the one order pagination tokens can resume from.

// ProductTasksAnchor is the region's id: the scope control's and Refresh's
// hx-target and the fragment root, which must carry it or the target is lost.
const ProductTasksAnchor = "krill-product-tasks"

// ProductTaskScopeLabel is one scope mode's name as the control offers it.
type ProductTaskScopeLabel struct {
	// Mode is the store scope kind's wire value, as carried in the query.
	Mode string
	// Label is what the operator reads, e.g. "All incomplete milestones".
	Label string
	// Active marks the mode this request resolved to.
	Active bool
}

// ProductTaskContainerOption is one selectable milestone or milepebble.
type ProductTaskContainerOption struct {
	ID       string
	Name     string
	Selected bool

	// OutOfScopeSuffix marks a shipped or abandoned container the all-incomplete
	// scope would exclude; it stays pickable, and the suffix explains why.
	OutOfScopeSuffix string
}

// ProductTaskRow is one task in the Tasks table. ClaimID and LeaseExpiresAt
// are the claim the read observed, set together, for later claim-guarded writes.
type ProductTaskRow struct {
	// ID is the task's own id, the row's data-krill-task-id.
	ID string

	// Title links to DetailPath, the product-scoped detail URL, since rows here
	// may belong to any container.
	Title      string
	DetailPath string

	// Milestone is the row's milestone; a milepebble's task carries its parent's,
	// the container the scope was chosen by.
	Milestone string

	// Milepebble is empty for a task scoped directly to a milestone.
	Milepebble string

	// Lane and Badges render through the shared badge components, so colours
	// match the board and detail.
	Lane   string
	Badges []TaskBadge

	// Attempts is the count against the cap, e.g. "2 of 3".
	Attempts string

	// ClaimID and LeaseExpiresAt are what the read observed; empty means no claim.
	ClaimID        string
	LeaseExpiresAt string
}

// ProductTaskRegion is the Tasks/Board region's view model.
type ProductTaskRegion struct {
	// Product is the banner for the product the URL named.
	Product ProductHeader

	// View is "Tasks" or "Board", so the region can mark itself.
	View string

	// Path is this region's own URL, so the swap control can re-request it.
	Path string

	// RefreshPath is Path plus this request's query, so Refresh keeps the
	// current scope and filters.
	RefreshPath string

	// MilestonesPath leads back to the roadmap at this scope: the selected
	// container's detail, or the Milestones table. Built from the resolved scope.
	MilestonesPath string

	// Scope is the control both views share, built from the same resolved scope.
	Scope ProductTaskScopeControl

	// ScopeLabel is the resolved scope in prose.
	ScopeLabel string

	// Lane is the selected lane filter's name, empty for "Any lane".
	Lane string

	// OnlyStuck mirrors the checked filter.
	OnlyStuck bool

	// Total is the count for this scope's filters.
	Total int

	// Rows are the page's tasks in read order; a cut milestone's scope already
	// includes its milepebbles, and each row names its milepebble.
	Rows []ProductTaskRow

	// Empty is set when the scope resolved and holds no tasks.
	Empty bool

	// EmptyDetail names the active scope and lane, so the operator knows which
	// control excluded everything.
	EmptyDetail string

	// UpdatedAt is the read instant (RFC3339); relative text is derived client-side
	// because a server "N ago" in a re-swappable fragment goes stale unnoticed.
	UpdatedAt string

	// Error is a read failure in the operator's words; distinct from Empty.
	Error string

	// PageError is a continuation token the store refused (wrong scope or filters).
	// Kept apart from Error: the read is healthy, only the link is stale.
	PageError string

	// PageRecoveryHref and PageRecoveryText are the same view and filters without
	// the token; empty when there is nothing to recover to.
	PageRecoveryHref  string
	PageRecoveryText string

	// Paging is the table footer, or nil when there is no table (failed read or
	// empty scope). A table never renders without a footer, so none is silently truncated.
	Paging *ProductTaskPaging
}

// ProductTaskPaging is the Tasks footer state. Total is counted with the same
// parameters as the rows; Shown is what this page rendered.
type ProductTaskPaging struct {
	// Shown is how many rows this page rendered.
	Shown int

	// Total is the whole filtered set behind the rows, across all pages.
	Total int

	// Summary is built in Go because templ separates text and expressions with
	// HTML comments, which would split the sentence.
	Summary string

	// NextHref is the following page, empty on the last. The store issues a
	// token exactly when rows remain.
	NextHref string

	// PrevHref is the preceding page; empty in practice (see PrevNote).
	PrevHref string

	// PrevNote and NextNote explain why a disabled control is inert.
	PrevNote string
	NextNote string
}

// ProductTasks renders the region: resolved scope, shared control, total, and
// rows, empty state or failure. The control is inside so one swap updates both.
templ ProductTasks(d ProductTaskRegion) {
	<section id={ ProductTasksAnchor } data-krill="product-tasks" data-krill-view={ d.View }>
		<div class="flex flex-wrap items-start justify-between gap-4">
			<div>
				<h1 class="text-2xl font-semibold" data-krill="page-title">{ d.View }</h1>
				<p class="mt-1 text-sm text-base-content/70">
					Scoped to
					<span data-krill="scope-label">{ d.ScopeLabel }</span>
				</p>
			</div>
			<div class="flex items-center gap-3">
				@ProductTasksFreshness(d.UpdatedAt)
				if d.MilestonesPath != "" {
					<a href={ templ.URL(d.MilestonesPath) } class="link link-primary text-sm" data-krill="product-tasks-milestones-link">Milestones</a>
				}
				<button type="button" class="btn btn-ghost btn-sm shrink-0" data-krill="refresh"
					hx-get={ templ.URL(d.RefreshPath) }
					hx-target={ "#" + ProductTasksAnchor }
					hx-swap="outerHTML">
					Refresh
				</button>
			</div>
		</div>
		@ProductTaskScopeForm(d.Scope)
		<p class="mt-2 text-sm text-base-content/70">
			<span data-krill="task-count">{ itoa(d.Total) }</span>
			tasks in scope
			if d.Lane != "" {
				<span data-krill="lane-filter">in lane { d.Lane }</span>
			}
			if d.OnlyStuck {
				<span data-krill="only-stuck">that are stuck</span>
			}
		</p>
		if d.PageError != "" {
			<div class="mt-3" data-krill="product-tasks-page-error">
				@htmxui.Alert(htmxui.AlertError, d.PageError, templ.Attributes{
					"data-krill": "product-tasks-page-error-alert",
				})
				if d.PageRecoveryHref != "" && d.PageRecoveryText != "" {
					<div class="mt-3">
						<a href={ templ.URL(d.PageRecoveryHref) } class="btn btn-secondary btn-sm"
							data-krill="product-tasks-page-recovery">{ d.PageRecoveryText }</a>
					</div>
				}
			</div>
		} else if d.Error != "" {
			<div class="mt-3" data-krill="product-tasks-error">
				@htmxui.Alert(htmxui.AlertError, d.Error, templ.Attributes{
					"data-krill": "product-tasks-error-alert",
				})
			</div>
		} else if d.Empty {
			<div class="mt-3" data-krill="product-tasks-empty">
				@htmxui.EmptyState(
					"No tasks in this scope",
					d.EmptyDetail,
					"", "", templ.Attributes{},
				)
			</div>
		} else {
			@ProductTaskTable(d.Rows)
			if d.Paging != nil {
				@ProductTaskPagingFooter(*d.Paging)
			}
		}
	</section>
}

// ProductTaskPagingFooter renders "Showing X of Y tasks" and real <a> links, so
// reload, shared links and Back agree. Previous is always shown disabled because
// keyset tokens only go forward.
templ ProductTaskPagingFooter(p ProductTaskPaging) {
	<div class="mt-3 flex flex-wrap items-center justify-between gap-2" data-krill="task-paging">
		<span class="text-sm text-base-content/70" data-krill="paging-summary">{ p.Summary }</span>
		<div class="flex items-center gap-2">
			if p.PrevHref != "" {
				<a href={ templ.URL(p.PrevHref) } class="btn btn-ghost btn-sm" data-krill="paging-previous">Previous</a>
			} else {
				<button type="button" class="btn btn-ghost btn-sm" disabled data-krill="paging-previous"
					title={ p.PrevNote }>Previous</button>
			}
			if p.NextHref != "" {
				<a href={ templ.URL(p.NextHref) } class="btn btn-ghost btn-sm" data-krill="paging-next">Next</a>
			} else {
				<button type="button" class="btn btn-ghost btn-sm" disabled data-krill="paging-next"
					title={ p.NextNote }>Next</button>
			}
		</div>
	</div>
}

// ProductTaskTable renders rows in read order inside one horizontal-scroll
// container, so a narrow viewport scrolls the table, not the page.
templ ProductTaskTable(rows []ProductTaskRow) {
	<div class="mt-3 overflow-x-auto rounded-box border border-base-300 bg-base-100">
		<table class="table table-zebra" data-krill="task-table">
			<thead class="sticky top-0 bg-base-100">
				<tr>
					<th>Task</th>
					<th>Milestone</th>
					<th>Milepebble</th>
					<th>Lane</th>
					<th>State</th>
					<th class="text-right">Attempts</th>
					<th>Lease</th>
				</tr>
			</thead>
			<tbody>
				for _, t := range rows {
					<tr class="hover" data-krill="task-row"
						data-krill-task-id={ t.ID }
						data-krill-claim-id={ t.ClaimID }
						data-krill-lease-expires-at={ t.LeaseExpiresAt }>
						<td>
							<a href={ templ.URL(t.DetailPath) } class="link font-medium" data-krill="task-title">{ t.Title }</a>
						</td>
						<td data-krill="task-milestone">{ t.Milestone }</td>
						<td data-krill="task-milepebble">{ t.Milepebble }</td>
						<td>@TaskLaneBadge(t.Lane)</td>
						<td>@TaskBadges(t.Badges)</td>
						<td class="text-right" data-krill="task-attempts">{ t.Attempts }</td>
						<td data-krill="task-lease">
							if t.LeaseExpiresAt != "" {
								<time data-krill="task-lease" datetime={ t.LeaseExpiresAt } title={ t.LeaseExpiresAt }>
									{ t.LeaseExpiresAt }
								</time>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// ProductTasksFreshness carries only the read instant; the head script derives
// the relative text, since server text would go stale after a swap. The title
// keeps the exact time if the script never runs.
templ ProductTasksFreshness(updatedAt string) {
	<span class="text-sm text-base-content/70" data-krill="updated-at"
		data-krill-updated-at={ updatedAt } title={ updatedAt }>
		Updated { updatedAt }
	</span>
}

// ProductTasksInlineError is a 200 fragment carrying the failure, since htmx
// ignores non-2xx. It keeps the anchor id, and its own marker so a foreign
// scope is never confused with a failed read.
templ ProductTasksInlineError(anchor, message string) {
	<section id={ anchor } data-krill="product-tasks">
		<div data-krill="product-tasks-scope-error">
			@htmxui.Alert(htmxui.AlertError, message, templ.Attributes{
				"data-krill": "product-tasks-scope-error-alert",
			})
		</div>
	</section>
}