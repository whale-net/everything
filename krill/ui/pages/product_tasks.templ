package pages

import "github.com/whale-net/everything/libs/go/htmxui"

// The product-wide Tasks/Board region's view model. The pure builder that
// populates it lives in //krill/ui (product_task_scope.go); this file owns
// only the shape and the rendering, and the shared scope control lives
// beside it in product_task_scope.templ.
//
// It is deliberately the smallest honest region the read layer can serve:
// the scope the URL resolved to, the total behind it, and a sentence when
// there is nothing to list. The rows and the board's columns are the later
// pages' work -- so what renders today says what it read and names what it
// is scoped to, rather than pretending to be a table with no rows.

// ProductTasksAnchor is the DOM id of the region's content: the id the
// scope control's and Refresh's hx-target points at, and the root id of the
// fragment an htmx request gets back. A fragment without it would delete
// its own swap target on the next request (see SpecInlineError).
const ProductTasksAnchor = "krill-product-tasks"

// ProductTaskScopeLabel is one scope mode's name as the control offers it.
type ProductTaskScopeLabel struct {
	// Mode is the store scope kind's wire value -- the same string the
	// query parameter carries.
	Mode string
	// Label is what the operator reads, e.g. "All incomplete milestones".
	Label string
	// Active marks the mode this request resolved to.
	Active bool
}

// ProductTaskContainerOption is one selectable milestone or milepebble.
type ProductTaskContainerOption struct {
	ID       string
	Name     string
	Selected bool

	// OutOfScopeSuffix marks a container the product-wide all-incomplete
	// scope would NOT have included -- shipped or abandoned. FR 7191dba1
	// still lets the operator pick one explicitly, so it stays in the list
	// rather than disappearing; saying so is what stops it reading as a
	// contradiction. Empty for every container that scope would include.
	OutOfScopeSuffix string
}

// ProductTaskRegion is the Tasks/Board region's view model.
type ProductTaskRegion struct {
	// Product is the banner for the product the URL named.
	Product ProductHeader

	// View is "Tasks" or "Board" -- which of the two views of this one
	// scope is being served, so the region can mark itself.
	View string

	// Path is this region's own URL, so the swap control can re-request it.
	Path string

	// Scope is the control both views share. It is the same value on the
	// Tasks page and the Board page for the same URL, because both build
	// it from the same resolved scope rather than each describing its own.
	Scope ProductTaskScopeControl

	// ScopeLabel is the scope this request resolved to, read back in prose:
	// "All incomplete milestones", or a container's own name.
	ScopeLabel string

	// Lane is the selected lane filter's name, empty for "Any lane".
	Lane string

	// OnlyStuck mirrors the checked filter.
	OnlyStuck bool

	// Total is the count read for this scope's filters -- the "Y" the page
	// footer will read beside the rows it has not rendered yet.
	Total int

	// Empty is set when the scope resolved and holds no tasks, so the region
	// says so instead of reading as a page that failed.
	Empty bool

	// Error is a read failure in the operator's words, empty on success.
	// Distinct from Empty: one is an answer, the other is a failure.
	Error string
}

// ProductTasks renders the product-wide Tasks/Board region: the scope it
// resolved to, the shared scope control, the total behind it, and -- while
// the rows are still to come -- an honest sentence saying so.
//
// The control is inside the region, not beside it, so the hx-get that
// changes the scope swaps both the answer and the control that produced it
// in one move: after the swap the marked mode and the selected option are
// the ones the new URL resolved to, never the ones the old URL did.
templ ProductTasks(d ProductTaskRegion) {
	<section id={ ProductTasksAnchor } data-krill="product-tasks" data-krill-view={ d.View }>
		<h2 class="text-xl font-semibold" data-krill="page-title">{ d.View }</h2>
		<p class="mt-1 text-sm text-base-content/70">
			Scoped to
			<span data-krill="scope-label">{ d.ScopeLabel }</span>
		</p>
		@ProductTaskScopeForm(d.Scope)
		<p class="mt-2 text-sm text-base-content/70">
			<span data-krill="task-count">{ itoa(d.Total) }</span>
			tasks in scope
			if d.Lane != "" {
				<span data-krill="lane-filter">in lane { d.Lane }</span>
			}
			if d.OnlyStuck {
				<span data-krill="only-stuck">that are stuck</span>
			}
		</p>
		if d.Error != "" {
			<div class="mt-3" data-krill="product-tasks-error">
				@htmxui.Alert(htmxui.AlertError, d.Error, templ.Attributes{
					"data-krill": "product-tasks-error-alert",
				})
			</div>
		} else if d.Empty {
			<div class="mt-3" data-krill="product-tasks-empty">
				@htmxui.EmptyState(
					"No tasks in this scope",
					"Nothing matches the active scope and filters.",
					"", "", templ.Attributes{},
				)
			</div>
		} else {
			<p class="mt-3 text-sm text-base-content/70" data-krill="product-tasks-pending">
				The task rows for this scope are not rendered yet.
			</p>
		}
	</section>
}

// ProductTasksInlineError is the fragment an htmx caller gets when the
// scope or the read failed: a 200 carrying the failure inline, because
// htmx does not swap on a non-2xx and the operator would otherwise be left
// clicking Refresh with no feedback at all.
//
// It keeps the region's anchor id for the same reason SpecInlineError does
// -- a fragment without it deletes its own swap target.
templ ProductTasksInlineError(anchor, message string) {
	<section id={ anchor } data-krill="product-tasks">
		<div data-krill="product-tasks-error">
			@htmxui.Alert(htmxui.AlertError, message, templ.Attributes{
				"data-krill": "product-tasks-error-alert",
			})
		</div>
	</section>
}