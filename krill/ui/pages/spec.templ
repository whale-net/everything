package pages

// The spec browser's page bodies. The four per-product bodies are the panels of
// the tabbed Spec page (spec_tabs.templ); each keeps its own root and Refresh so
// it can swap alone. Path is carried so Refresh never guesses the route.

import (
	"strconv"

	"github.com/whale-net/everything/krill/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// DOM ids of each spec page's content region, targeted by its Refresh button.
const (
	ProductsAnchor     = "krill-spec-products"
	CapabilityMapAnchor = "krill-spec-capability-map"
	DecisionsAnchor    = "krill-spec-decisions"
	PersonasAnchor     = "krill-spec-personas"
	NonGoalsAnchor     = "krill-spec-non-goals"
)

// ProductHeader is the per-product banner.
type ProductHeader struct {
	Name   string
	Vision string
	Href   string // the product's capability-map page
}

type ProductListItem struct {
	Name        string
	Vision      string
	CapabilityH string // /spec/products/{id} -- the capability map
}

type ProductsPage struct {
	Path  string
	Items []ProductListItem
}

// CapabilityFeatureSet is one FeatureSet and its Features. Expansion lives in the
// URL, not a browser-owned <details>, so reloads and shared links restore it.
type CapabilityFeatureSet struct {
	ID          string // EntityRef.ID -- the surrogate id, as get_product_slice returns it
	Name        string
	Description string
	Features    []CapabilityFeature

	// FeatureCount is a field so the badge and the table cannot disagree.
	FeatureCount int

	// Expanded is whether this request shows the section; the URL opens at most one.
	Expanded bool

	ExpandHref   string
	CollapseHref string
}

// ToggleHref is the expander's current target, derived from Expanded.
func (fs CapabilityFeatureSet) ToggleHref() string {
	if fs.Expanded {
		return fs.CollapseHref
	}
	return fs.ExpandHref
}

// ToggleLabel says what pressing the expander does.
func (fs CapabilityFeatureSet) ToggleLabel() string {
	if fs.Expanded {
		return "Collapse " + fs.Name
	}
	return "Expand " + fs.Name
}

// ToggleAriaExpanded returns "true"/"false"; aria-expanded needs the literal string.
func (fs CapabilityFeatureSet) ToggleAriaExpanded() string {
	if fs.Expanded {
		return "true"
	}
	return "false"
}

type CapabilityFeature struct {
	ID          string // EntityRef.ID
	Number      int    // Cn -- the stored DisplayNumber, the number a reader cites
	Name        string
	Description string

	// RequirementCount is len(Requirements), so the count matches the nested list.
	RequirementCount int
	Requirements     []CapabilityRequirement

	Milestone CapabilityMilestone

	// QuickLookHref is the feature's blade URL: a real link without JS, an in-place
	// swap with it.
	QuickLookHref string
}

// CapabilityMilestone is one feature row's Milestone cell. "Nothing delivers it"
// (blank) and "listing unreadable" (Message) are distinct states.
type CapabilityMilestone struct {
	// Kind is one of the CapabilityMilestone* constants.
	Kind string

	// Name is set only for CapabilityMilestoneNamed.
	Name string

	// Status is the milestone's wire status; colour comes from the same
	// MilestoneStatusStyle the Milestones table uses.
	Status string

	// Count is the number of delivering milestones (1 for Named).
	Count int

	// Message is set, never empty, for CapabilityMilestoneUnread: a failed read must
	// not render as a blank cell.
	Message string
}

// The states a Milestone cell can be in.
const (
	// CapabilityMilestoneNamed: one milestone delivers the feature (or, failing that,
	// all its requirements).
	CapabilityMilestoneNamed = "named"

	// CapabilityMilestoneSeveral: several milestones deliver its requirements.
	CapabilityMilestoneSeveral = "several"

	// CapabilityMilestoneNone: nothing delivers it; a blank cell, not a failure.
	CapabilityMilestoneNone = "none"

	// CapabilityMilestoneUnread: the delivery listing could not be read.
	CapabilityMilestoneUnread = "unread"
)

type CapabilityRequirement struct {
	ID   string // EntityRef.ID -- the surrogate id, so a reader can cite the exact row
	Kind string // "FR" or "NFR"
	Name string
	Body string
}

type CapabilityPage struct {
	Product     ProductHeader
	Path        string
	FeatureSets []CapabilityFeatureSet
}

type DecisionItem struct {
	ID     string // EntityRef.ID
	Number int    // LBn -- the stored DisplayNumber
	Name   string
	Body   string
}

type DecisionsPage struct {
	Product   ProductHeader
	Path      string
	Decisions []DecisionItem
}

type PersonaItem struct {
	ID          string // the surrogate id, as list_personas returns it
	Name        string
	Description string
}

type PersonasPage struct {
	Product  ProductHeader
	Path     string
	Personas []PersonaItem
}

type NonGoalItem struct {
	ID   string // the surrogate id, as list_non_goals returns it
	Kind string // "permanent" or "deferred"
	Name string
	Body string
}

// NonGoalGroup is one kind's non-goals; the permanent/deferred split is load-bearing.
type NonGoalGroup struct {
	Kind     string // "permanent" or "deferred"
	Heading  string // the human-facing label for that kind
	NonGoals []NonGoalItem
}

type NonGoalsPage struct {
	Product ProductHeader
	Path    string
	Groups  []NonGoalGroup
}

// StatusPage is the spec area's error body; renderShellStatus owns the HTTP status.
type StatusPage struct {
	Title    string
	Detail   string
	BackHref string
	BackText string
}

// specRefresh is a manual refresh rather than a poll, so content never swaps
// mid-read. It replaces the whole content region via outerHTML.
templ specRefresh(anchor, selfPath string) {
	<button type="button" class="btn btn-ghost btn-sm shrink-0" data-krill="refresh"
		hx-get={ templ.URL(selfPath) }
		hx-target={ "#" + anchor }
		hx-swap="outerHTML">
		Refresh
	</button>
}

templ pageHeader(anchor, selfPath, title, vision string) {
	<div class="flex items-start justify-between gap-4 mb-2">
		<div>
			<h2 class="text-xl font-semibold" data-krill="page-title">{ title }</h2>
			if vision != "" {
				<p class="mt-1 text-sm text-base-content/70 max-w-3xl line-clamp-2" title={ vision }>{ vision }</p>
			}
		</div>
		@specRefresh(anchor, selfPath)
	</div>
}

// entityID renders a citable surrogate id. ml-1 provides the gap because templ
// drops whitespace between elements.
templ entityID(id string) {
	<code data-krill="entity-id" class="ml-1 font-mono text-xs opacity-70">{ id }</code>
}

templ Products(page ProductsPage) {
	<section id={ ProductsAnchor } data-krill="products">
		@pageHeader(ProductsAnchor, page.Path, "Products", "")
		if len(page.Items) == 0 {
			@htmxui.EmptyState("No products yet.", "Every product an operator can browse into.", "", "", templ.Attributes{})
		} else {
			<ul class="mt-4 space-y-2">
				for _, it := range page.Items {
					<li class="text-sm">
						<a href={ templ.URL(it.CapabilityH) } class="link link-primary">{ it.Name }</a>
						if it.Vision != "" {
							<span class="text-base-content/70"> — { it.Vision }</span>
						}
					</li>
				}
			</ul>
		}
	</section>
}

// CapabilityMap renders a product's current FeatureSets, Features and
// Requirements, nested by parent; each feature set is collapsible.
templ CapabilityMap(page CapabilityPage) {
	<section id={ CapabilityMapAnchor } data-krill="capability-map">
		@pageHeader(CapabilityMapAnchor, page.Path, page.Product.Name+" — capability map", page.Product.Vision)
		if len(page.FeatureSets) == 0 {
			@htmxui.EmptyState("No feature sets yet.", "The FeatureSets, Features, and Requirements recorded for this product.", "", "", templ.Attributes{})
		} else {
			<div class="mt-4 space-y-3">
				for _, fs := range page.FeatureSets {
					@capabilityFeatureSet(fs)
				}
			</div>
		}
	</section>
}

// capabilityFeatureSet uses daisyUI collapse-open rather than <details> so the
// open state follows the URL; the expander is a real link for the no-JS path.
templ capabilityFeatureSet(fs CapabilityFeatureSet) {
	<div id={ fs.ID } class={ capabilityFeatureSetClasses(fs.Expanded) } data-krill="feature-set" data-krill-feature-set-id={ fs.ID } data-krill-feature-set-open={ fs.ToggleAriaExpanded() }>
		<div class="collapse-title flex flex-wrap items-center gap-2 pr-8">
			<span class="text-lg font-semibold" data-krill="feature-set-name">{ fs.Name }</span>
			<span class="badge badge-ghost badge-sm" data-krill="feature-set-count">{ strconv.Itoa(fs.FeatureCount) } features</span>
			@capabilityFeatureSetExpander(fs)
			if fs.Description != "" {
				<div class="basis-full text-sm font-normal text-base-content/70 krill-md" data-krill="feature-set-description">@templ.Raw(renderMarkdown(fs.Description))</div>
			}
		</div>
		<div class="collapse-content">
			@capabilityFeatureTable(fs)
		</div>
	</div>
}

// capabilityFeatureSetClasses derives the class from Expanded, like aria-expanded.
func capabilityFeatureSetClasses(open bool) string {
	classes := "collapse collapse-arrow bg-base-100 border border-base-300"
	if open {
		classes += " collapse-open"
	}
	return classes
}

// capabilityFeatureSetExpander swaps only the capability panel so the tab strip
// around it survives.
templ capabilityFeatureSetExpander(fs CapabilityFeatureSet) {
	<a href={ templ.URL(fs.ToggleHref()) }
		class="btn btn-ghost btn-xs"
		aria-expanded={ fs.ToggleAriaExpanded() }
		aria-label={ fs.ToggleLabel() }
		title={ fs.ToggleLabel() }
		data-krill="feature-set-expand"
		data-krill-feature-set-id={ fs.ID }
		hx-get={ templ.URL(fs.ToggleHref()) }
		hx-target={ "#" + CapabilityMapAnchor }
		hx-swap="outerHTML"
		hx-push-url="true">
		if fs.Expanded {
			Collapse
		} else {
			Expand
		}
	</a>
}

// capabilityFeatureTable lists an open section's features; the requirement count
// comes from the same slice as the nested list.
templ capabilityFeatureTable(fs CapabilityFeatureSet) {
	if len(fs.Features) == 0 {
		<p class="text-sm text-base-content/70" data-krill="feature-set-empty">No features in this feature set yet.</p>
	} else {
		<div class="overflow-x-auto rounded-lg border border-base-300">
			<table class="table table-zebra" data-krill="feature-table">
				<thead>
					<tr>
						<th>Feature</th>
						<th class="text-right">Requirements</th>
						<th>Milestone</th>
					</tr>
				</thead>
				<tbody>
					for _, f := range fs.Features {
						<tr data-krill="feature-row" data-krill-feature-id={ f.ID }>
							<td>
								<a href={ templ.URL(f.QuickLookHref) }
									data-krill="feature-quick-look"
									hx-get={ templ.URL(f.QuickLookHref) }
									hx-target={ "#" + SpecBladeAnchor }
									hx-swap="outerHTML"
									hx-push-url="true">
									<span class="link link-primary font-medium" data-krill="feature-name">C{ strconv.Itoa(f.Number) } — { f.Name }</span>
								</a>
								@entityID(f.ID)
								if f.Description != "" {
									<div class="text-sm text-base-content/70 krill-md" data-krill="feature-description">@templ.Raw(renderMarkdown(f.Description))</div>
								}
							</td>
							<td class="text-right" data-krill="feature-requirement-count">{ strconv.Itoa(f.RequirementCount) }</td>
							<td>@capabilityMilestoneCell(f.Milestone)</td>
						</tr>
						if len(f.Requirements) > 0 {
							<tr data-krill="feature-requirements">
								<td colspan="3" class="bg-base-200/60">
									<ul class="list-disc pl-5 space-y-2">
										for _, rq := range f.Requirements {
											<li>
												<strong>{ rq.Kind }</strong>: { rq.Name }
												@entityID(rq.ID)
												if rq.Body != "" {
													<div class="text-sm text-base-content/70 krill-md">@templ.Raw(renderMarkdown(rq.Body))</div>
												}
											</li>
										}
									</ul>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	}
}

// capabilityMilestoneCell renders a Milestone cell. A blank cell means nothing
// delivers the feature; an unreadable listing always says so.
templ capabilityMilestoneCell(m CapabilityMilestone) {
	switch m.Kind {
		case CapabilityMilestoneNamed:
			@milestoneNameBadge(m.Name, m.Status)
		case CapabilityMilestoneSeveral:
			@milestoneCountBadge(m.Count)
		case CapabilityMilestoneUnread:
			<span class="text-sm text-base-content/70" data-krill="feature-milestone-unread">{ m.Message }</span>
		default:
			<span data-krill="feature-milestone-none"></span>
	}
}

// milestoneNameBadge shows a milestone's name in its status colour, via the same
// MilestoneStatusStyle as statusBadge.
templ milestoneNameBadge(name, status string) {
	{{ s := components.MilestoneStatusStyle(status) }}
	@htmxui.Badge(name, s.Variant, s.Size, s.Soft, templ.Attributes{"data-krill": "feature-milestone-name"})
}

// milestoneCountBadge is the neutral "N milestones" cell.
templ milestoneCountBadge(count int) {
	{{ s := components.MilestoneCountStyle() }}
	@htmxui.Badge(strconv.Itoa(count)+" milestones", s.Variant, s.Size, s.Soft, templ.Attributes{"data-krill": "feature-milestone-count"})
}

// Decisions lists a product's current load-bearing decisions with full bodies.
templ Decisions(page DecisionsPage) {
	<section id={ DecisionsAnchor } data-krill="decisions">
		@pageHeader(DecisionsAnchor, page.Path, "Load-bearing decisions", "")
		if len(page.Decisions) == 0 {
			@htmxui.EmptyState("No load-bearing decisions yet.", "The decisions later capabilities of this product depend on.", "", "", templ.Attributes{})
		} else {
			<ol class="mt-4 list-decimal pl-5 space-y-4">
				for _, d := range page.Decisions {
					<li id={ d.ID }>
						<strong>LB{ strconv.Itoa(d.Number) } — { d.Name }</strong>
						@entityID(d.ID)
						if d.Body != "" {
							<div class="text-sm text-base-content/70 krill-md">@templ.Raw(renderMarkdown(d.Body))</div>
						}
					</li>
				}
			</ol>
		}
	</section>
}

templ Personas(page PersonasPage) {
	<section id={ PersonasAnchor } data-krill="personas">
		@pageHeader(PersonasAnchor, page.Path, "Personas", "")
		if len(page.Personas) == 0 {
			@htmxui.EmptyState("No personas yet.", "Who this product serves.", "", "", templ.Attributes{})
		} else {
			<ul class="mt-4 list-disc pl-5 space-y-4">
				for _, p := range page.Personas {
					<li id={ p.ID }>
						<strong>{ p.Name }</strong>
						@entityID(p.ID)
						if p.Description != "" {
							<div class="text-sm text-base-content/70 krill-md">@templ.Raw(renderMarkdown(p.Description))</div>
						}
					</li>
				}
			</ul>
		}
	</section>
}

// NonGoals lists a product's current non-goals by kind. Each row carries its own
// kind badge so a row read alone keeps that distinction.
templ NonGoals(page NonGoalsPage) {
	<section id={ NonGoalsAnchor } data-krill="non-goals">
		@pageHeader(NonGoalsAnchor, page.Path, "Non-goals", "")
		if len(page.Groups) == 0 {
			@htmxui.EmptyState("No non-goals yet.", "What this product deliberately will not do.", "", "", templ.Attributes{})
		} else {
			for _, g := range page.Groups {
				if len(g.NonGoals) > 0 {
					<div class="mt-6">
						<h3 class="text-lg font-semibold">{ g.Heading }</h3>
						<ul class="mt-3 list-disc pl-5 space-y-4">
							for _, n := range g.NonGoals {
								<li id={ n.ID }>
									<div class="flex flex-wrap items-center gap-2">
										<strong>{ n.Name }</strong>
										@nonGoalKindBadge(n.Kind)
									</div>
									@entityID(n.ID)
									if n.Body != "" {
										<div class="text-sm text-base-content/70 krill-md">@templ.Raw(renderMarkdown(n.Body))</div>
									}
								</li>
							}
						</ul>
					</div>
				}
			}
		}
	</section>
}

// nonGoalKindBadge styles and labels a kind via //krill/ui/components;
// data-krill-non-goal-kind carries the raw wire value.
templ nonGoalKindBadge(kind string) {
	{{ s := components.NonGoalKindStyle(kind) }}
	@htmxui.Badge(components.NonGoalKindLabel(kind), s.Variant, s.Size, s.Soft, templ.Attributes{
		"data-krill":             "non-goal-kind",
		"data-krill-non-goal-kind": kind,
	})
}

// SpecInlineError is the htmx fragment for a failed spec read (htmx skips non-2xx).
// Its root must carry the requester's anchor, or outerHTML deletes the target and
// later Refreshes silently stop.
templ SpecInlineError(anchor, message string) {
	<section id={ anchor } data-krill="spec-status">
		@htmxui.Alert(htmxui.AlertError, message, templ.Attributes{
			"data-krill": "spec-status-detail",
		})
	</section>
}

templ SpecStatus(page StatusPage) {
	<section data-krill="spec-status">
		<h2 class="text-xl font-semibold" data-krill="page-title">{ page.Title }</h2>
		@htmxui.Alert(htmxui.AlertError, page.Detail, templ.Attributes{
			"data-krill": "spec-status-detail",
		})
		if page.BackHref != "" && page.BackText != "" {
			<div class="mt-4">
				<a href={ templ.URL(page.BackHref) } class="btn btn-secondary btn-sm">{ page.BackText }</a>
			</div>
		}
	</section>
}
