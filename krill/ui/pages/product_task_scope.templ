package pages

// The scope control the Tasks table and the Board share. A plain GET form, so the URL
// is the whole state (reload, shared link, no-JS submit); htmx re-renders the region in place.

// Query parameters the Tasks/Board URLs carry, declared here because this control writes
// them; //krill/ui aliases these so form and parser share one spelling.
const (
	// ProductTaskScopeQueryParam names the mode, by the store's scope-kind wire value.
	ProductTaskScopeQueryParam = "scope"
	// ProductTaskContainerQueryParam names the scope's container (milestone or milepebble);
	// the api's product task read uses the same name.
	ProductTaskContainerQueryParam = "container_id"
	// ProductTaskMilestoneQueryParam names the parent milestone whose milepebbles the
	// milepebble select offers. It only drives that offer and is never sent to the store.
	ProductTaskMilestoneQueryParam = "milestone"
	// ProductTaskLaneQueryParam and ProductTaskOnlyStuckQueryParam are sibling filters
	// the scope control carries through unchanged.
	ProductTaskLaneQueryParam      = "lane"
	ProductTaskOnlyStuckQueryParam = "only_stuck"
)

// The three modes' wire values, in the store's own vocabulary.
const (
	productTaskScopeIncompleteMode = "incomplete"
	productTaskScopeMilestoneMode  = "milestone"
	productTaskScopeMilepebbleMode = "milepebble"
)

// ProductTaskLaneOption is one lane the Tasks view's lane select offers.
type ProductTaskLaneOption struct {
	// Value is the lane's wire value, the key of the store's filter set.
	Value string
	// Label is what the operator reads; equal to Value.
	Label string
	// Selected marks the lane this request resolved to.
	Selected bool
}

// ProductTaskScopeControl is the scope control's view model.
type ProductTaskScopeControl struct {
	// Path is the view's own URL, used as both the form action and hx-get.
	Path string

	// Modes are the three modes in offer order, with the active one marked.
	Modes []ProductTaskScopeLabel

	// MilestoneParam is the milestone select's query parameter: the container param in
	// milestone mode, the parent-milestone param in milepebble mode.
	MilestoneParam string

	// ShowMilestone and ShowMilepebble reveal the selects; off in product-wide mode and when
	// there is nothing to choose.
	ShowMilestone  bool
	ShowMilepebble bool

	// Milestones and Milepebbles are the options. Containers outside the all-incomplete
	// scope are still offered but labelled as such.
	Milestones  []ProductTaskContainerOption
	Milepebbles []ProductTaskContainerOption

	// ShowFilters reveals the lane select and only-stuck checkbox. Off on the Board, which
	// carries them as hidden fields so a scope change does not drop them.
	ShowFilters bool

	// Lanes are the lane select's options, "Any lane" first; empty when ShowFilters is off.
	Lanes []ProductTaskLaneOption

	// Lane and OnlyStuck are the sibling filters this URL carries, as controls or hidden fields.
	Lane      string
	OnlyStuck bool

	// Views is the List/Board toggle. It lives on the control because this is the one
	// component both views render, so neither view can omit it.
	Views ProductTaskViewToggle
}

// ProductTaskViewToggle is the List/Board switch between two views of one scope.
type ProductTaskViewToggle struct {
	// Views are the two destinations in render order. Each keeps the current query, since
	// the switch changes the view, not the scope.
	Views []ProductTaskViewLink
}

// ProductTaskViewLink is one destination of the List/Board toggle.
type ProductTaskViewLink struct {
	// Label is "List" or "Board".
	Label string
	// Href is this view's URL at the current scope and filters.
	Href string
	// Active marks the view this request is serving.
	Active bool
}

// ProductTaskViewToggleForm renders the List/Board switch as plain links, since switching
// view is navigation rather than a scope change; aria-current marks the active one.
templ ProductTaskViewToggleForm(t ProductTaskViewToggle) {
	<div class="join mt-3" role="group" aria-label="View tasks as" data-krill="view-toggle">
		for _, v := range t.Views {
			if v.Active {
				<a href={ templ.URL(v.Href) } class="join-item btn btn-sm btn-active btn-neutral" aria-current="page"
					data-krill="view-toggle-link" data-krill-view={ v.Label }>
					{ v.Label }
				</a>
			} else {
				<a href={ templ.URL(v.Href) } class="join-item btn btn-sm"
					data-krill="view-toggle-link" data-krill-view={ v.Label }>
					{ v.Label }
				</a>
			}
		}
	</div>
}

// ProductTaskScopeForm renders the view toggle, then the mode radios and selects. The toggle
// sits outside the <form> because it is navigation. Named ...Form because templ would
// otherwise collide with the ProductTaskScopeControl type.
templ ProductTaskScopeForm(c ProductTaskScopeControl) {
	@ProductTaskViewToggleForm(c.Views)
	<form method="get" action={ templ.URL(c.Path) } class="mt-3 flex flex-wrap items-end gap-4"
		data-krill="scope-control"
		hx-get={ templ.URL(c.Path) }
		hx-target={ "#" + ProductTasksAnchor }
		hx-swap="outerHTML"
		hx-trigger="change, submit"
		hx-push-url="true">
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Scope</legend>
			<div class="join" role="group" aria-label="Scope">
				for _, mode := range c.Modes {
					<input type="radio" name={ ProductTaskScopeQueryParam } value={ mode.Mode } class="join-item btn btn-sm"
						aria-label={ mode.Label }
						checked?={ mode.Active }
						data-krill="scope-mode" data-krill-mode={ mode.Mode }
						title={ scopeModeHint(mode) } />
				}
			</div>
		</fieldset>
		if c.ShowMilestone {
			<label class="fieldset">
				<span class="fieldset-legend">Milestone</span>
				<select name={ c.MilestoneParam } class="select select-sm" data-krill="scope-milestone-select">
					for _, o := range c.Milestones {
						<option value={ o.ID } selected?={ o.Selected } data-krill-container-id={ o.ID }>
							{ o.Name }{ o.OutOfScopeSuffix }
						</option>
					}
				</select>
			</label>
		}
		if c.ShowMilepebble {
			<label class="fieldset">
				<span class="fieldset-legend">Milepebble</span>
				<select name={ ProductTaskContainerQueryParam } class="select select-sm" data-krill="scope-milepebble-select">
					for _, o := range c.Milepebbles {
						<option value={ o.ID } selected?={ o.Selected } data-krill-container-id={ o.ID }>
							{ o.Name }{ o.OutOfScopeSuffix }
						</option>
					}
				</select>
			</label>
		}
		if c.ShowFilters {
			@ProductTaskFilterControls(c)
		}
		if !c.ShowFilters && c.Lane != "" {
			<input type="hidden" name={ ProductTaskLaneQueryParam } value={ c.Lane } data-krill="scope-carried-lane" />
		}
		if !c.ShowFilters && c.OnlyStuck {
			<input type="hidden" name={ ProductTaskOnlyStuckQueryParam } value="true" data-krill="scope-carried-only-stuck" />
		}
		<button type="submit" class="btn btn-primary btn-sm" data-krill="scope-apply">
			Apply
		</button>
	</form>
}

// ProductTaskFilterControls is the Tasks view's lane select and "Only stuck" checkbox, inside
// the scope form so scope and filters submit as one GET. An unchecked box sends nothing,
// and absent only_stuck means false.
templ ProductTaskFilterControls(c ProductTaskScopeControl) {
	<label class="fieldset">
		<span class="fieldset-legend">Lane</span>
		<select name={ ProductTaskLaneQueryParam } class="select select-sm" data-krill="lane-filter-select">
			for _, o := range c.Lanes {
				<option value={ o.Value } selected?={ o.Selected } data-krill-lane={ o.Value }>
					{ o.Label }
				</option>
			}
		</select>
	</label>
	<label class="label cursor-pointer justify-start gap-2 p-0">
		<input type="checkbox" name={ ProductTaskOnlyStuckQueryParam } value="true" class="checkbox checkbox-sm"
			checked?={ c.OnlyStuck }
			data-krill="only-stuck-filter"
			title="Expired lease, at the attempt cap, escalated, or cancelled." />
		<span class="label-text">Only stuck</span>
	</label>
}

// scopeModeHint says what each mode means, on the radio itself: only the product-wide
// mode filters on status, the rule operators most often get wrong.
func scopeModeHint(mode ProductTaskScopeLabel) string {
	switch mode.Mode {
	case productTaskScopeIncompleteMode:
		return "Every milestone that is neither shipped nor abandoned."
	case productTaskScopeMilestoneMode, productTaskScopeMilepebbleMode:
		return "Shows the selected container's tasks whatever its status, shipped or not."
	}
	return ""
}