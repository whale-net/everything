package pages

// The scope control the Tasks table and the Board share (FR 7191dba1):
// three modes, and in the two single-container modes a select of the
// product's own milestones -- and, in milepebble mode, of that
// milestone's own milepebbles.
//
// It is a plain GET form carrying the mode and the selected ids, so the
// URL is always the whole of the state: a reload, a shared link and a
// no-JavaScript submit all land on the same scope. htmx is layered on
// top of that -- hx-get onto the same path, targeting the region's own
// anchor -- so changing the control re-renders the region in place
// without making the working case depend on JavaScript.

// The query parameters the Tasks/Board URLs carry. They are declared here
// rather than in the parser because this control is what writes them: the
// field names below and the parse in //krill/ui have to be one spelling,
// and //krill/ui aliases these rather than keeping a second copy.
const (
	// ProductTaskScopeQueryParam names the mode: the store's own three
	// scope kinds by wire value.
	ProductTaskScopeQueryParam = "scope"
	// ProductTaskContainerQueryParam names the scope's container -- the
	// milestone in milestone mode, the milepebble in milepebble mode. It
	// is the name the api's product task read reads too.
	ProductTaskContainerQueryParam = "container_id"
	// ProductTaskMilestoneQueryParam names the PARENT milestone whose
	// milepebbles the milepebble select offers. It is not a filter and is
	// never sent to the store: in milepebble mode it answers only "which
	// milepebbles may be chosen", which the selected container alone
	// cannot -- the operator changes this select to change that offer.
	// Deliberately not named container_id, which already means the
	// container, and deliberately shorter than milestone_id: the store
	// read never sees it.
	ProductTaskMilestoneQueryParam = "milestone"
	// ProductTaskLaneQueryParam and ProductTaskOnlyStuckQueryParam are
	// the sibling filters the scope control carries through unchanged.
	ProductTaskLaneQueryParam      = "lane"
	ProductTaskOnlyStuckQueryParam = "only_stuck"
)

// The three modes' wire values. The control spells them through the
// store's own vocabulary, so it compares against these rather than
// inventing a UI-local word the parser would then have to translate.
const (
	productTaskScopeIncompleteMode = "incomplete"
	productTaskScopeMilestoneMode  = "milestone"
	productTaskScopeMilepebbleMode = "milepebble"
)

// ProductTaskLaneOption is one lane the Tasks view's lane select offers.
type ProductTaskLaneOption struct {
	// Value is the lane's wire value -- the same string the store's own
	// filter set is keyed by, so a lane this page offers is a lane the
	// read accepts.
	Value string
	// Label is what the operator reads, e.g. "Testing". Equal to Value:
	// the lane vocabulary has no display variant of its own.
	Label string
	// Selected marks the lane this request resolved to.
	Selected bool
}

// ProductTaskScopeControl is the scope control's view model.
type ProductTaskScopeControl struct {
	// Path is the view's own URL -- the form's GET action and its hx-get,
	// the same string either way, so the in-place swap and the full-page
	// submit ask for exactly the same query.
	Path string

	// Modes are the three modes in the order the control offers them, with
	// the active one marked.
	Modes []ProductTaskScopeLabel

	// MilestoneParam is the query parameter the milestone select submits
	// under. It is the container parameter in milestone mode, where the
	// milestone IS the scope's container, and the parent-milestone
	// parameter in milepebble mode, where it only chooses which
	// milepebbles are on offer.
	MilestoneParam string

	// ShowMilestone and ShowMilepebble reveal the two selects. Each is off
	// both in the product-wide mode, which names no container, and when the
	// product has nothing to put in it -- so the control never renders a
	// select an operator cannot choose from.
	ShowMilestone  bool
	ShowMilepebble bool

	// Milestones and Milepebbles are the options, each marking the one
	// this request resolved to. A container outside the all-incomplete
	// scope is still offered -- picking one explicitly shows its tasks
	// whatever its status -- but says so, so the operator is not left
	// wondering why a shipped milestone is in the list.
	Milestones  []ProductTaskContainerOption
	Milepebbles []ProductTaskContainerOption

	// ShowFilters reveals the lane select and the only-stuck checkbox --
	// the Tasks view's own filters (FR 61d7fb7b). Off on the Board, which
	// reuses the same parsed scope but carries these two as the hidden
	// fields below instead: they are what a scope change must not drop,
	// not controls the Board offers.
	ShowFilters bool

	// Lanes are the lane select's options, "Any lane" first, marking the
	// one this request resolved to. Empty when ShowFilters is off.
	Lanes []ProductTaskLaneOption

	// Lane and OnlyStuck are the sibling filters this URL carries. With
	// ShowFilters on they drive the select and the checkbox; with it off
	// they are re-submitted as hidden fields, so a scope change keeps them
	// rather than silently dropping a filter the operator set.
	Lane      string
	OnlyStuck bool

	// Views is the List/Board toggle: the same scope read the other way,
	// with this request's own view marked (FR ab5f4936).
	//
	// It lives on the control rather than beside it because the scope
	// control is the ONE component both views render -- the Tasks region
	// and the Board region each compose their own body around this same
	// form. A toggle declared next to the region would be rendered by
	// whichever view template declared it and be silently absent from the
	// other, which is the exact failure the shared scope control was built
	// to prevent.
	Views ProductTaskViewToggle
}

// ProductTaskViewToggle is the List/Board switch between the two views of
// one scope (FR ab5f4936).
type ProductTaskViewToggle struct {
	// Views are the two destinations in render order, each carrying the
	// current URL's own query, with the view being served marked Active.
	//
	// The query travels because the switch changes the VIEW, not the
	// scope: the operator asked the same question the other way, and a
	// destination that reset the scope would answer a different one.
	Views []ProductTaskViewLink
}

// ProductTaskViewLink is one destination of the List/Board toggle.
type ProductTaskViewLink struct {
	// Label is what the operator reads: "List" or "Board".
	Label string
	// Href is this view's URL at the current scope and filters.
	Href string
	// Active marks the view this request is serving.
	Active bool
}

// ProductTaskViewToggleForm renders the List/Board switch: two links, the
// current view marked, each addressing the same scope and filters on the
// other view's own path.
//
// It is a pair of links rather than a control inside the scope form,
// because switching view is navigation and not a change to the scope: a
// control that submitted would be a second way to spell "and now show me
// the other view", which is what the plain links are for. aria-current
// marks the active one for a screen reader, and the active button class is
// what marks it visually.
templ ProductTaskViewToggleForm(t ProductTaskViewToggle) {
	<div class="join mt-3" role="group" aria-label="View tasks as" data-krill="view-toggle">
		for _, v := range t.Views {
			if v.Active {
				<a href={ templ.URL(v.Href) } class="join-item btn btn-sm btn-active btn-neutral" aria-current="page"
					data-krill="view-toggle-link" data-krill-view={ v.Label }>
					{ v.Label }
				</a>
			} else {
				<a href={ templ.URL(v.Href) } class="join-item btn btn-sm"
					data-krill="view-toggle-link" data-krill-view={ v.Label }>
					{ v.Label }
				</a>
			}
		}
	</div>
}

// ProductTaskScopeForm renders the shared scope control: the List/Board
// toggle, then the three modes as radios and the selects the active mode
// reveals.
//
// The toggle is rendered HERE, above the form, rather than beside the
// region body each view composes. This component is the one element both
// the Tasks region and the Board region render, so a toggle declared in
// either view's own template would be present on one view and silently
// absent from the other -- which is the whole failure the shared scope
// control exists to prevent (FR ab5f4936).
//
// It sits outside the <form> on purpose: it is navigation between two
// views of one scope, not a value the scope form submits.
//
// Named ...Form rather than ...Control because templ generates a
// function under the component's name, which would collide with the
// view model's type of the same name.
templ ProductTaskScopeForm(c ProductTaskScopeControl) {
	@ProductTaskViewToggleForm(c.Views)
	<form method="get" action={ templ.URL(c.Path) } class="mt-3 flex flex-wrap items-end gap-4"
		data-krill="scope-control"
		hx-get={ templ.URL(c.Path) }
		hx-target={ "#" + ProductTasksAnchor }
		hx-swap="outerHTML"
		hx-trigger="change, submit"
		hx-push-url="true">
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Scope</legend>
			<div class="join" role="group" aria-label="Scope">
				for _, mode := range c.Modes {
					<input type="radio" name={ ProductTaskScopeQueryParam } value={ mode.Mode } class="join-item btn btn-sm"
						aria-label={ mode.Label }
						checked?={ mode.Active }
						data-krill="scope-mode" data-krill-mode={ mode.Mode }
						title={ scopeModeHint(mode) } />
				}
			</div>
		</fieldset>
		if c.ShowMilestone {
			<label class="fieldset">
				<span class="fieldset-legend">Milestone</span>
				<select name={ c.MilestoneParam } class="select select-sm" data-krill="scope-milestone-select">
					for _, o := range c.Milestones {
						<option value={ o.ID } selected?={ o.Selected } data-krill-container-id={ o.ID }>
							{ o.Name }{ o.OutOfScopeSuffix }
						</option>
					}
				</select>
			</label>
		}
		if c.ShowMilepebble {
			<label class="fieldset">
				<span class="fieldset-legend">Milepebble</span>
				<select name={ ProductTaskContainerQueryParam } class="select select-sm" data-krill="scope-milepebble-select">
					for _, o := range c.Milepebbles {
						<option value={ o.ID } selected?={ o.Selected } data-krill-container-id={ o.ID }>
							{ o.Name }{ o.OutOfScopeSuffix }
						</option>
					}
				</select>
			</label>
		}
		if c.ShowFilters {
			@ProductTaskFilterControls(c)
		}
		if !c.ShowFilters && c.Lane != "" {
			<input type="hidden" name={ ProductTaskLaneQueryParam } value={ c.Lane } data-krill="scope-carried-lane" />
		}
		if !c.ShowFilters && c.OnlyStuck {
			<input type="hidden" name={ ProductTaskOnlyStuckQueryParam } value="true" data-krill="scope-carried-only-stuck" />
		}
		<button type="submit" class="btn btn-primary btn-sm" data-krill="scope-apply">
			Apply
		</button>
	</form>
}

// ProductTaskFilterControls is the Tasks view's own two filters: a lane
// select and an "Only stuck" checkbox (FR 61d7fb7b).
//
// They live INSIDE the scope form rather than beside it, which is what
// makes every filter and the scope one GET with one Apply: changing the
// lane keeps the scope, and changing the scope keeps the lane, because
// there is only one form to submit and it carries all of them. Two forms
// would mean each had to re-submit the other's state as hidden fields --
// the drift that a shared link would then reproduce.
//
// The checkbox submits only when checked, and an unchecked box submits
// nothing at all: only_stuck absent IS false, which is why there is no
// companion hidden field here the way the Board carries one.
templ ProductTaskFilterControls(c ProductTaskScopeControl) {
	<label class="fieldset">
		<span class="fieldset-legend">Lane</span>
		<select name={ ProductTaskLaneQueryParam } class="select select-sm" data-krill="lane-filter-select">
			for _, o := range c.Lanes {
				<option value={ o.Value } selected?={ o.Selected } data-krill-lane={ o.Value }>
					{ o.Label }
				</option>
			}
		</select>
	</label>
	<label class="label cursor-pointer justify-start gap-2 p-0">
		<input type="checkbox" name={ ProductTaskOnlyStuckQueryParam } value="true" class="checkbox checkbox-sm"
			checked?={ c.OnlyStuck }
			data-krill="only-stuck-filter"
			title="Expired lease, at the attempt cap, escalated, or cancelled." />
		<span class="label-text">Only stuck</span>
	</label>
}

// scopeModeHint is the one sentence that says what each mode means, on
// the radio rather than in prose beside the control: the product-wide
// mode filters on status and the two single-container modes deliberately
// do not, which is the rule an operator is most likely to get wrong.
func scopeModeHint(mode ProductTaskScopeLabel) string {
	switch mode.Mode {
	case productTaskScopeIncompleteMode:
		return "Every milestone that is neither shipped nor abandoned."
	case productTaskScopeMilestoneMode, productTaskScopeMilepebbleMode:
		return "Shows the selected container's tasks whatever its status, shipped or not."
	}
	return ""
}