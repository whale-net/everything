package pages

import (
	"github.com/whale-net/everything/libs/go/htmxui"
)

// The Milestone status-history view: one container's status transitions,
// oldest first. A separate route from the detail page, which is about what
// the milestone delivers; the rail's Status history link leads here.

// MilestoneStatusHistoryAnchor is the DOM id of this view's region and the
// rail link's target.
const MilestoneStatusHistoryAnchor = "krill-milestone-status-history"

// StatusTransition is one register row. At (exact) and Relative (human age)
// are both kept so the exact time shows on hover without client JS.
type StatusTransition struct {
	ID string

	Status string

	// OnBehalfOf is set only when it differs from Actor.
	Actor      string
	OnBehalfOf string

	// At is RFC3339; Relative is how long ago that was.
	At       string
	Relative string

	// Note is "" when none was recorded.
	Note string
}

type MilestoneStatusHistoryPage struct {
	Product ProductHeader

	// Path is this page's own URL.
	Path string

	// ID and Kind ride on the region as data attributes rather than rendering.
	ID   string
	Kind string

	Crumbs []MilestoneCrumb

	Title         string
	ContainerName string

	// DetailPath is the container's detail page, the "back" target.
	DetailPath string

	// Transitions is kept in the read's order, not re-sorted, so the page and
	// get_milestone_status_history list one order.
	Transitions []StatusTransition

	// Error replaces the list with an alert: an empty table under a failed read
	// would look like a container never touched.
	Error string
}

func (p MilestoneStatusHistoryPage) HasTransitions() bool { return len(p.Transitions) > 0 }

// SummaryLine is the count sentence under the heading; it restates the
// rail's count, read from the same call.
func (p MilestoneStatusHistoryPage) SummaryLine() string {
	if !p.HasTransitions() {
		return "No status changes recorded."
	}
	if len(p.Transitions) == 1 {
		return "1 status change, oldest first."
	}
	return itoa(len(p.Transitions)) + " status changes, oldest first."
}

// statusTransitionActor shows the on-behalf-of subject only when it differs
// from the actor, so agent-for-person actions stay visible.
templ statusTransitionActor(t StatusTransition) {
	<span class="text-sm" data-krill="status-transition-actor">{ t.Actor }</span>
	if t.OnBehalfOf != "" {
		<span class="block text-xs text-base-content/70" data-krill="status-transition-on-behalf-of">
			{ "on behalf of " + t.OnBehalfOf }
		</span>
	}
}

// statusTransitionAt renders the relative age server-side, with the exact
// instant in datetime and title so hover answers "exactly when".
templ statusTransitionAt(t StatusTransition) {
	<time class="text-sm text-base-content/70" data-krill="status-transition-at"
		data-krill-updated-at={ t.At } datetime={ t.At } title={ t.At }>{ t.Relative }</time>
}

// statusTransitionNote renders an em dash for no note so the cell reads as
// "none recorded", not dropped.
templ statusTransitionNote(t StatusTransition) {
	if t.Note != "" {
		<span class="text-sm" data-krill="status-transition-note">{ t.Note }</span>
	} else {
		<span class="text-sm text-base-content/70" data-krill="status-transition-note-empty">—</span>
	}
}

templ statusHistoryTable(page MilestoneStatusHistoryPage) {
	<div class="overflow-x-auto rounded-lg border border-base-300">
		<table class="table table-zebra table-sm" data-krill="status-history-table">
			<thead>
				<tr>
					<th>Status</th>
					<th>Actor</th>
					<th>Changed</th>
					<th>Note</th>
				</tr>
			</thead>
			<tbody>
				for _, t := range page.Transitions {
					<tr data-krill="status-transition-row" data-krill-transition-id={ t.ID }>
						<td data-krill="status-transition-status">@statusBadge(t.Status)</td>
						<td data-krill="status-transition-actor-cell">@statusTransitionActor(t)</td>
						<td>@statusTransitionAt(t)</td>
						<td>@statusTransitionNote(t)</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// MilestoneStatusHistory renders the header, a back link to the detail, and
// the register.
templ MilestoneStatusHistory(page MilestoneStatusHistoryPage) {
	<section id={ MilestoneStatusHistoryAnchor } data-krill="milestone-status-history"
		data-krill-container-id={ page.ID } data-krill-container-kind={ page.Kind } class="space-y-4">
		@milestoneDetailCrumbs(page.Crumbs)
		<div class="flex flex-wrap items-center gap-3" data-krill="status-history-header">
			<h1 class="text-2xl font-bold" data-krill="page-title">{ page.Title }</h1>
			<div class="flex-1"></div>
			<a href={ templ.URL(page.DetailPath) } class="btn btn-ghost btn-sm" data-krill="status-history-back">
				Back to milestone
			</a>
		</div>
		<p class="text-sm text-base-content/70" data-krill="status-history-subtitle">
			{ page.ContainerName } — { page.SummaryLine() }
		</p>
		<div class="card bg-base-100 border border-base-300" data-krill="status-history-card">
			<div class="card-body gap-3">
				if page.Error != "" {
					<div data-krill="status-history-error">
						@htmxui.Alert(htmxui.AlertError, page.Error, nil)
					</div>
				} else if !page.HasTransitions() {
					// No history is a real answer: the status is "not started".
					<div data-krill="status-history-empty">
						@htmxui.EmptyState(
							"No status changes yet.",
							"This milestone has never had its status set, which is why it reads as not started.",
							"Back to milestone",
							page.DetailPath,
							nil,
						)
					</div>
				} else {
					@statusHistoryTable(page)
				}
			</div>
		</div>
	</section>
}