package pages

import (
	"github.com/whale-net/everything/libs/go/htmxui"
)

// The Milestone status-history view (FR 9a6e7924): one container's whole
// status-transition register, oldest first, each transition carrying its own
// badge, actor, instant and note.
//
// It is its own route rather than a tab of the Milestone detail, because the
// detail's own subject is what the milestone DELIVERS and the rail is its
// summary: the register is a long tail, and a detail page that grew a
// per-transition table beside its delivery breakdown would answer a question
// nobody asked it. The rail's Status history link is what reaches here.
//
// Everything on it is somebody else's. The rows are the get_milestone_status_history
// read, the status badge is the shared statusBadge, the relative-time wording is
// the shell's own, and the back link is the detail URL the rail already spells.
// This file adds a layout over them and defines no second copy of any of it.

// MilestoneStatusHistoryAnchor is the DOM id this view's region carries, so
// the tests that assert on it -- and the rail's link target -- name one element.
const MilestoneStatusHistoryAnchor = "krill-milestone-status-history"

// StatusTransition is one row of the register: a status, who moved it there,
// when, and why they said.
//
// The fields are the store's own, pre-rendered: Status is the store's wire
// value the shared statusBadge resolves, At is the exact instant and Relative
// its human age. Keeping both rather than rendering one from the other is what
// lets the exact time survive on hover without the browser's clock, and lets
// the no-JavaScript page show something an operator can read rather than a
// bare instant.
type StatusTransition struct {
	// ID is the transition's own id, carried so a row is addressable and a
	// test can check that what rendered came from the transition it meant.
	ID string

	// Status renders through the shared statusBadge -> components.MilestoneStatusStyle,
	// so a status is one colour on the register, the detail header, the
	// rail and the Milestones table alike.
	Status string

	// Actor is the acting subject who recorded this transition. OnBehalfOf
	// is set only where it differs, because the pair is equal for the
	// ordinary case and a second identical line would say nothing.
	Actor      string
	OnBehalfOf string

	// At is the exact instant, RFC3339; Relative is how long ago that was.
	// At is what the element's datetime and title carry, so hovering
	// answers "exactly when" from text the relative figure cannot.
	At       string
	Relative string

	// Note is the transition's own note, or "" when it recorded none. It
	// renders as its own column rather than being appended to the actor,
	// because a note is the reason for the transition and an operator
	// scanning the register is looking for reasons.
	Note string
}

// MilestoneStatusHistoryPage is the status-history view's view model.
type MilestoneStatusHistoryPage struct {
	// Product is the banner: the product this container belongs to.
	Product ProductHeader

	// Path is this page's own URL, so a refresh and a shared link are the
	// same page.
	Path string

	// ID and Kind describe the container whose register this is. They ride
	// on the region as data attributes rather than being rendered, because
	// the operator arrived here from that container's own detail and the
	// heading above names it.
	ID   string
	Kind string

	// Crumbs walks product -> Milestones -> the container's name -> this
	// page, the last of which carries no href because the operator is
	// already on it.
	Crumbs []MilestoneCrumb

	// Title is this page's own heading; ContainerName is the milestone or
	// milepebble the register belongs to, which is what the rail's link was
	// labelled with.
	Title         string
	ContainerName string

	// DetailPath is the container's detail page -- where the operator came
	// from, and what "back" means here.
	DetailPath string

	// Transitions is the register as read: oldest first, each entry whole.
	// It is held in the read's own order rather than re-sorted, so the page
	// and get_milestone_status_history describe one list in one order.
	Transitions []StatusTransition

	// Error is set when the register could not be read. It renders as its
	// own alert in place of the list: an empty table under a failed read is
	// indistinguishable from a container whose status was never touched.
	Error string
}

// HasTransitions reports whether the register holds any row, so the empty
// state and the table are decided in one place rather than at two.
func (p MilestoneStatusHistoryPage) HasTransitions() bool { return len(p.Transitions) > 0 }

// SummaryLine is the count sentence under the heading: what the operator
// followed, and how much of it there is.
//
// It restates the rail's count on purpose. The two are read from one call, so
// they cannot disagree -- and an operator who walked two pages to compare a
// number and could not would rightly stop trusting both.
func (p MilestoneStatusHistoryPage) SummaryLine() string {
	if !p.HasTransitions() {
		return "No status changes recorded."
	}
	if len(p.Transitions) == 1 {
		return "1 status change, oldest first."
	}
	return itoa(len(p.Transitions)) + " status changes, oldest first."
}

// statusTransitionActor renders one row's attribution.
//
// The acting subject is the actor; the on-behalf-of subject is shown beneath
// it only when it is somebody else, because LB4's distinction exists to say
// "this was done by an agent, for this person" and collapsing the pair would
// make exactly that statement inexpressible.
templ statusTransitionActor(t StatusTransition) {
	<span class="text-sm" data-krill="status-transition-actor">{ t.Actor }</span>
	if t.OnBehalfOf != "" {
		<span class="block text-xs text-base-content/70" data-krill="status-transition-on-behalf-of">
			{ "on behalf of " + t.OnBehalfOf }
		</span>
	}
}

// statusTransitionAt renders one row's instant: the relative age as the
// visible text, with the exact instant carried in the datetime and the title
// so hovering answers "exactly when" -- the same shape the Overview's
// escalation panel gives its timestamps, and the same
// data-krill-updated-at hook the task detail's Escalated row uses for a
// historical event rather than a freshness stamp.
//
// Relative is what the element renders server-side, so the page says
// something readable with the head script absent; the exact instant is in
// the title either way, so the precise answer survives both ways.
templ statusTransitionAt(t StatusTransition) {
	<time class="text-sm text-base-content/70" data-krill="status-transition-at"
		data-krill-updated-at={ t.At } datetime={ t.At } title={ t.At }>{ t.Relative }</time>
}

// statusTransitionNote renders one row's note, or the cell's own emptiness
// when there is none. It is an em dash rather than a blank cell so the column
// reads as "none recorded" instead of "the read dropped it".
templ statusTransitionNote(t StatusTransition) {
	if t.Note != "" {
		<span class="text-sm" data-krill="status-transition-note">{ t.Note }</span>
	} else {
		<span class="text-sm text-base-content/70" data-krill="status-transition-note-empty">—</span>
	}
}

// statusHistoryTable is the register itself: one row per transition, in the
// read's own order.
//
// It is a table rather than a list because the comparison an operator makes
// here is between rows -- which status replaced which, and how long each state
// lasted -- and a stack of sentences would not let them scan it.
templ statusHistoryTable(page MilestoneStatusHistoryPage) {
	<div class="overflow-x-auto rounded-lg border border-base-300">
		<table class="table table-zebra table-sm" data-krill="status-history-table">
			<thead>
				<tr>
					<th>Status</th>
					<th>Actor</th>
					<th>Changed</th>
					<th>Note</th>
				</tr>
			</thead>
			<tbody>
				for _, t := range page.Transitions {
					<tr data-krill="status-transition-row" data-krill-transition-id={ t.ID }>
						<td data-krill="status-transition-status">@statusBadge(t.Status)</td>
						<td data-krill="status-transition-actor-cell">@statusTransitionActor(t)</td>
						<td>@statusTransitionAt(t)</td>
						<td>@statusTransitionNote(t)</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// MilestoneStatusHistory renders the status-history view: the header naming
// the container whose register this is, a link back to its detail, and the
// register itself.
templ MilestoneStatusHistory(page MilestoneStatusHistoryPage) {
	<section id={ MilestoneStatusHistoryAnchor } data-krill="milestone-status-history"
		data-krill-container-id={ page.ID } data-krill-container-kind={ page.Kind } class="space-y-4">
		@milestoneDetailCrumbs(page.Crumbs)
		<div class="flex flex-wrap items-center gap-3" data-krill="status-history-header">
			<h1 class="text-2xl font-bold" data-krill="page-title">{ page.Title }</h1>
			<div class="flex-1"></div>
			<a href={ templ.URL(page.DetailPath) } class="btn btn-ghost btn-sm" data-krill="status-history-back">
				Back to milestone
			</a>
		</div>
		<p class="text-sm text-base-content/70" data-krill="status-history-subtitle">
			{ page.ContainerName } — { page.SummaryLine() }
		</p>
		<div class="card bg-base-100 border border-base-300" data-krill="status-history-card">
			<div class="card-body gap-3">
				if page.Error != "" {
					<div data-krill="status-history-error">
						@htmxui.Alert(htmxui.AlertError, page.Error, nil)
					</div>
				} else if !page.HasTransitions() {
					// Absence of history is a real answer, not a failed read:
					// a container whose status has never been set reads
					// "not started" precisely because no transition exists.
					<div data-krill="status-history-empty">
						@htmxui.EmptyState(
							"No status changes yet.",
							"This milestone has never had its status set, which is why it reads as not started.",
							"Back to milestone",
							page.DetailPath,
							nil,
						)
					</div>
				} else {
					@statusHistoryTable(page)
				}
			</div>
		</div>
	</section>
}