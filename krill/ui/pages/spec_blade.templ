package pages

import "strconv"

// The feature quick-look blade opens over the Spec page without re-rendering it.
// Blades go one level deep: only the close control links anywhere, so "back" has
// one answer.

// SpecBladeAnchor is the blade region's DOM id; the served fragment's root must
// carry it or outerHTML swaps delete the region. Rendered even when closed so
// Feature links' hx-target always resolves.
const SpecBladeAnchor = "krill-spec-blade"

// SpecBladePage is one blade region; a nil Feature is the closed, empty region.
type SpecBladePage struct {
	Product ProductHeader
	Feature *SpecBladeFeature

	// CloseHref is the tab path with the expansion the blade was opened over.
	CloseHref string
}

type SpecBladeFeature struct {
	ID          string // EntityRef.ID -- the surrogate id, shown as the copy chip
	Number      int    // Cn -- the stored DisplayNumber, the number a reader cites
	Name        string
	Description string

	// Milestone uses the Capabilities table's own derivation so the two never disagree.
	Milestone CapabilityMilestone

	// Requirements carry the same FRn/NFRn citations the rendered PRODUCT.md uses.
	Requirements []SpecBladeRequirement
}

// SpecBladeRequirement is plain text: krill stores no requirement display number,
// so a link could not carry a citation matching the document.
type SpecBladeRequirement struct {
	ID       string // EntityRef.ID -- the surrogate id, so the line resolves exactly
	Citation string // "FR7" / "NFR1", from render.RequirementCitations
	Name     string
}

// SpecBladeSlot always carries SpecBladeAnchor so open and closed swap in place.
templ SpecBladeSlot(page SpecBladePage) {
	<div id={ SpecBladeAnchor } data-krill="spec-blade">
		if page.Feature != nil {
			@specBlade(page)
		}
	</div>
}

templ specBlade(page SpecBladePage) {
	<article class="card bg-base-100 border border-base-300 shadow-sm" data-krill="spec-blade-body">
		<div class="card-body p-4 gap-3">
			<div class="flex items-start justify-between gap-4">
				<h3 class="text-lg font-semibold" data-krill="spec-blade-name">C{ strconv.Itoa(page.Feature.Number) } — { page.Feature.Name }</h3>
				@specBladeClose(page.CloseHref)
			</div>
			@specBladeID(page.Feature.ID)
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-sm text-base-content/70">Milestone</span>
				@capabilityMilestoneCell(page.Feature.Milestone)
			</div>
			if page.Feature.Description != "" {
				<div class="text-sm text-base-content/70 krill-md" data-krill="spec-blade-description">@templ.Raw(renderMarkdown(page.Feature.Description))</div>
			}
			if len(page.Feature.Requirements) > 0 {
				<div>
					<h4 class="text-sm font-semibold text-base-content/70">Requirements</h4>
					<ul class="mt-1 list-disc pl-5 space-y-1" data-krill="spec-blade-requirements">
						for _, rq := range page.Feature.Requirements {
							<li data-krill="spec-blade-requirement">
								<strong>{ rq.Citation }</strong>: { rq.Name }
							</li>
						}
					</ul>
				</div>
			}
		</div>
	</article>
}

// specBladeClose swaps only the blade region, leaving the page underneath
// untouched; the plain href makes a no-JS click navigate to the same view.
templ specBladeClose(href string) {
	<a href={ templ.URL(href) }
		class="btn btn-ghost btn-sm"
		data-krill="spec-blade-close"
		hx-get={ templ.URL(href) }
		hx-target={ "#" + SpecBladeAnchor }
		hx-swap="outerHTML"
		hx-push-url="true">
		Close
	</a>
}

// specBladeID reuses the task detail's copy chip, disabled until JS enables it.
// It sits in a <dd> because the shared script scopes its status via closest('dd').
templ specBladeID(id string) {
	<dl class="m-0">
		<dd class="ml-0">
			<button type="button" class="badge badge-ghost badge-sm font-mono disabled:opacity-50"
				aria-label="Copy feature id" data-krill="copy-task-id" data-task-id={ id }
				disabled title="Copying the feature id needs JavaScript">
				{ idChipText(id) }
			</button>
			<span class="ml-2 text-xs" data-krill="copy-task-id-status" role="status" aria-live="polite"></span>
		</dd>
	</dl>
}