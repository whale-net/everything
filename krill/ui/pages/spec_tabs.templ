package pages

// The Spec page's tab strip and shared swap region. Each tab's href is the
// real page address, also used as its hx-get. The strip lives inside the region:
// outerHTML inserts every top-level node, so a separate strip would duplicate.

// SpecPanelAnchor is the swap region's id; the served fragment's root must
// carry it or htmx drops the element and later tab clicks become no-ops.
const SpecPanelAnchor = "krill-spec-panel"

// SpecPanelBodyAnchor is the inner region the active panel renders into,
// and what each tab's aria-controls names.
const SpecPanelBodyAnchor = "krill-spec-panel-body"

// The four tab keys, one per spec URL.
const (
	SpecTabCapabilities = "capabilities"
	SpecTabDecisions    = "decisions"
	SpecTabPersonas     = "personas"
	SpecTabNonGoals     = "non-goals"
)

// SpecTabID is one tab's DOM id in the strip, which is also what its
// panel's aria-labelledby points at.
func SpecTabID(key string) string {
	return "krill-spec-tab-" + key
}

// SpecTab is one tab: the address it navigates to, and the in-place swap
// of that same address.
type SpecTab struct {
	Key    string
	Label  string
	Href   string
	Active bool
}

// SpecTabsPage is the whole Spec page as one swap region. Blade lives inside
// it so a tab click replaces it, and always renders since links target its id.
type SpecTabsPage struct {
	Tabs  []SpecTab
	Tab   string
	Panel templ.Component
	Blade templ.Component
}

// SpecPage is the full-page frame around the tab region; the heading sits
// outside the swap region, so a tab click never re-renders it.
templ SpecPage(productName string, tabs templ.Component) {
	<div class="space-y-4" data-krill="spec-page">
		<div class="flex flex-wrap items-center gap-3">
			<h1 class="text-2xl font-semibold" data-krill="spec-page-title">Spec</h1>
			if productName != "" {
				<span class="text-base-content/70" data-krill="spec-page-product">{ productName }</span>
			}
		</div>
		@tabs
	</div>
}

templ SpecTabs(page SpecTabsPage) {
	<div id={ SpecPanelAnchor } data-krill="spec-panel" data-krill-spec-tab={ page.Tab }>
		@specTabStrip(page.Tabs)
		<div id={ SpecPanelBodyAnchor } role="tabpanel" aria-labelledby={ SpecTabID(page.Tab) } class="mt-4" data-krill="spec-panel-body">
			@page.Panel
		</div>
		<div class="mt-4">
			if page.Blade == nil {
				@SpecBladeSlot(SpecBladePage{})
			} else {
				@page.Blade
			}
		</div>
	</div>
}

// specTabStrip is the tablist: real links that also swap in place and push
// their URL. aria-selected is on every tab, since omitted means undefined.
templ specTabStrip(tabs []SpecTab) {
	<div role="tablist" class="tabs tabs-border" data-krill="spec-tabs">
		for _, t := range tabs {
			<a role="tab" id={ SpecTabID(t.Key) } href={ templ.URL(t.Href) }
				class={ specTabClasses(t.Active) }
				aria-selected={ specTabSelected(t.Active) }
				aria-controls={ SpecPanelBodyAnchor }
				hx-get={ templ.URL(t.Href) }
				hx-target={ "#" + SpecPanelAnchor }
				hx-swap="outerHTML"
				hx-push-url="true"
				data-krill="spec-tab" data-krill-spec-tab={ t.Key }>
				{ t.Label }
			</a>
		}
	</div>
}

// specTabClasses is one tab's daisyUI class, so the strip carries exactly
// one active marking whichever tab the URL resolved to.
func specTabClasses(active bool) string {
	if active {
		return "tab tab-active"
	}
	return "tab"
}

func specTabSelected(active bool) string {
	if active {
		return "true"
	}
	return "false"
}