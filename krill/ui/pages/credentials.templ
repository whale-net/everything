package pages

import "github.com/whale-net/everything/libs/go/htmxui"

// credentialsResultsID is the swap target every credentials mutation replaces.
// Keep it stable: in-flight requests and bookmarks address it.
const credentialsResultsID = "credentials-results"

// CredentialsBladeAnchor is the create blade region's DOM id: the primary
// action's hx-target and the served blade fragment's root id (outerHTML swap).
const CredentialsBladeAnchor = "krill-credentials-blade"

// CredentialRevokeRegionPrefix prefixes one row's revoke region id. Per-row so
// the confirmation is asked and dismissed in the row it concerns.
const CredentialRevokeRegionPrefix = "krill-credential-revoke-"

// CredentialRevokeRegionID is the swap target for one row's revoke step and the
// root id of the served row fragment.
func CredentialRevokeRegionID(id string) string {
	return CredentialRevokeRegionPrefix + id
}

// CredentialRow is one live credential as the table shows it; revoked ones are
// filtered out by credentialsData since the table has no status column.
type CredentialRow struct {
	// ID is the store id the revoke path is built from.
	ID string

	// Name is the operator-chosen label the table leads with.
	Name string

	// Created* are the relative age and the exact RFC3339 instant behind it.
	CreatedRelative string
	CreatedExact    string

	// LastUsed* are empty when never used; the cell then reads "never".
	LastUsedRelative string
	LastUsedExact    string

	RevokeAction string

	// RevokeConfirmHref is the confirmation step's URL, used as both href and
	// hx-get. A GET there asks; a POST answers.
	RevokeConfirmHref string

	// RevokeDismissHref is the row's URL, returning it to its default state.
	RevokeDismissHref string

	// Confirming is true only for the row whose confirm URL was requested.
	Confirming bool
}

type CredentialsData struct {
	// Rows are the caller's live credentials, most recent first.
	Rows []CredentialRow

	// NewToken is the just-minted raw token, present only on the mint response.
	NewToken string
	// NewTokenName names the credential the minted token belongs to.
	NewTokenName string

	Error string

	MintAction string
	// NewHref is the create blade's GET path.
	NewHref string
	// ListHref is where Cancel returns to.
	ListHref string

	// BladeOpen shows the create blade; BladeName keeps the typed name so a
	// refusal re-renders it.
	BladeOpen bool
	BladeName string
}

// CredentialsPage is the credentials page: header, primary action, and the
// region every credential action swaps.
templ CredentialsPage(d CredentialsData) {
	<section data-krill="credentials" class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-semibold" data-krill="page-title">Credentials</h1>
			@credentialsNewBladeAction(d)
		</div>
		<p class="text-sm text-base-content/70">Mint a static bearer token for an MCP client that can't run the OAuth2 sign-in flow.</p>
		@CredentialsResults(d)
	</section>
}

// credentialsNewBladeAction opens the create blade: a real href for no-JS and
// reloads, plus an hx-get of the same URL into the blade region.
templ credentialsNewBladeAction(d CredentialsData) {
	<a href={ templ.URL(d.NewHref) }
		class="btn btn-primary btn-sm"
		data-krill="credentials-create"
		hx-get={ d.NewHref }
		hx-target={ "#" + CredentialsBladeAnchor }
		hx-swap="outerHTML">
		Create credential
	</a>
}

// CredentialsResults is the block every mint/revoke swaps. It owns the blade
// region so a mint closes the blade and shows the token in one swap.
templ CredentialsResults(d CredentialsData) {
	<div id={ credentialsResultsID } data-krill="credentials-results" class="space-y-4">
		if d.Error != "" {
			<div data-krill="credentials-alert">
				@htmxui.Alert(htmxui.AlertError, d.Error, nil)
			</div>
		}
		@CredentialsBladeSlot(d)
		if d.NewToken != "" {
			@credentialsNewToken(d)
		}
		if len(d.Rows) == 0 {
			@htmxui.EmptyState("No credentials yet.",
				"Create one to give an MCP client a static bearer token.",
				"Create credential", d.NewHref,
				templ.Attributes{"data-krill": "credentials-empty"})
		} else {
			@credentialsTable(d)
		}
	</div>
}

// CredentialsBladeSlot is the blade region. It always renders so the primary
// action's hx-target resolves.
templ CredentialsBladeSlot(d CredentialsData) {
	<div id={ CredentialsBladeAnchor } data-krill="credentials-blade">
		if d.BladeOpen {
			@credentialsBlade(d)
		}
	</div>
}

// credentialsBlade is the create form, doubled for no-JS and htmx; both answer
// 200. Name is not required so the page, not the browser, states the refusal.
templ credentialsBlade(d CredentialsData) {
	<article class="card bg-base-100 border border-base-300 shadow-sm" data-krill="credentials-blade-body">
		<div class="card-body p-4 gap-3">
			<div class="flex items-start justify-between gap-4">
				<h2 class="text-lg font-semibold" data-krill="credentials-blade-title">Create credential</h2>
			</div>
			<form
				id="credentials-create-form"
				method="post"
				action={ templ.URL(d.MintAction) }
				hx-post={ d.MintAction }
				hx-target={ "#" + credentialsResultsID }
				hx-swap="outerHTML"
			>
				<p>
					<label class="label" for="credential-name">Name</label>
					<input id="credential-name" name="name" type="text"
						value={ d.BladeName } placeholder="claude-code laptop"
						class="input input-bordered w-full max-w-md"/>
				</p>
				<div class="flex justify-end gap-2">
					<a href={ templ.URL(d.ListHref) } class="btn btn-ghost btn-sm" data-krill="credentials-cancel">Cancel</a>
					<button type="submit" class="btn btn-primary btn-sm">Create credential</button>
				</div>
			</form>
		</div>
	</article>
}

// credentialsNewToken wraps the one-time token. Mint answers 200, not a
// redirect, because the token exists only in this response.
templ credentialsNewToken(d CredentialsData) {
	<div data-krill="credentials-new-token">
		@credentialsTokenAlert(d)
	</div>
}

// credentialsTokenAlert is the success alert carrying the one-time token.
templ credentialsTokenAlert(d CredentialsData) {
	@htmxui.Alert(htmxui.AlertSuccess, "Created "+d.NewTokenName+". Copy this token now -- it will not be shown again.", nil) {
		<dl class="m-0">
			<dd class="ml-0 flex flex-wrap items-center gap-2">
				<input type="text" readonly value={ d.NewToken }
					aria-label="New credential token"
					id="credentials-new-token-value"
					data-krill="credentials-new-token-value"
					class="input input-bordered w-full max-w-md font-mono"/>
				@credentialsCopyTokenControl()
				<span class="ml-2 text-xs" data-krill="copy-task-id-status" role="status" aria-live="polite"></span>
			</dd>
		</dl>
	}
}

// credentialsCopyTokenControl copies the token via the shell's shared copy
// script, which reads the field and looks for status within the enclosing <dd>.
// Ships disabled until JavaScript enables it.
templ credentialsCopyTokenControl() {
	<button type="button" class="btn btn-ghost btn-sm disabled:opacity-50"
		aria-label="Copy the new token"
		data-krill="copy-task-id"
		data-copy-source="credentials-new-token-value"
		data-copy-label="token"
		disabled title="Copying the token needs JavaScript">
		Copy
	</button>
}

// credentialsTable lists one row per live credential.
templ credentialsTable(d CredentialsData) {
	<div class="overflow-x-auto rounded-lg border border-base-300 bg-base-100">
		<table class="table table-zebra" data-krill="credentials-table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Created</th>
					<th>Last used</th>
					<th class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range d.Rows {
					<tr class="hover" data-krill="credential-row" data-krill-credential-id={ row.ID }>
						<td data-krill="credential-name">{ row.Name }</td>
						<td>@credentialInstant(row.CreatedRelative, row.CreatedExact, "credential-created-at")</td>
						<td>@credentialLastUsed(row)</td>
						<td class="text-right">
							@CredentialRevokeRegion(row)
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// CredentialRevokeRegion is one row's revoke step (default or confirming) and
// the root of every revoke-route fragment. Dismiss is a GET of the row URL so it
// works without JavaScript.
templ CredentialRevokeRegion(row CredentialRow) {
	<div id={ CredentialRevokeRegionID(row.ID) } data-krill="credential-revoke-region">
		if row.Confirming {
			@credentialRevokeConfirm(row)
		} else {
			@credentialRevokeControl(row)
		}
	</div>
}

// credentialRevokeControl asks for confirmation and posts nothing: a real href
// plus an hx-get of the same URL into the row's region.
templ credentialRevokeControl(row CredentialRow) {
	<a href={ templ.URL(row.RevokeConfirmHref) }
		class="btn btn-ghost btn-sm text-error"
		data-krill="credential-revoke"
		hx-get={ row.RevokeConfirmHref }
		hx-target={ "#" + CredentialRevokeRegionID(row.ID) }
		hx-swap="outerHTML">
		Revoke
	</a>
}

// credentialRevokeConfirm names the credential and the consequence. The form
// and Cancel are both doubled for htmx and no-JS; the submit button relies on
// the form's hx-* wiring.
templ credentialRevokeConfirm(row CredentialRow) {
	<form
		method="post"
		action={ templ.URL(row.RevokeAction) }
		hx-post={ row.RevokeAction }
		hx-target={ "#" + credentialsResultsID }
		hx-swap="outerHTML"
		data-krill="credential-revoke-form"
	>
		@htmxui.Confirm(htmxui.ConfirmProps{
			Intent:      htmxui.ConfirmDestructive,
			Summary:     "Revoke " + row.Name + "? Clients using it lose access immediately.",
			SubmitLabel: "Revoke",
			CancelHref:  row.RevokeDismissHref,
			CancelLabel: "Dismiss",
			CancelAttrs: templ.Attributes{
				"hx-get":    row.RevokeDismissHref,
				"hx-target": "#" + CredentialRevokeRegionID(row.ID),
				"hx-swap":   "outerHTML",
			},
		}, templ.Attributes{})
	</form>
}

// credentialInstant renders a relative age with the exact instant in datetime
// and title.
templ credentialInstant(relative, exact, hook string) {
	<time class="text-sm text-base-content/70" data-krill={ hook }
		data-krill-updated-at={ exact } datetime={ exact } title={ exact }>{ relative }</time>
}

// credentialLastUsed renders "never" rather than a blank for an unused
// credential, so it does not read as missing data.
templ credentialLastUsed(row CredentialRow) {
	if row.LastUsedExact == "" {
		<span class="text-sm text-base-content/70" data-krill="credential-last-used-never">never</span>
	} else {
		@credentialInstant(row.LastUsedRelative, row.LastUsedExact, "credential-last-used-at")
	}
}