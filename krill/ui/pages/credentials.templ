package pages

// credentialsScript is the credential widget's script body, carried over
// verbatim from the pre-templ widget.
//
// It is NOT htmx and is deliberately so. The widget's data source is
// app.mcpProvider's self-serve JSON API (POST/GET /credentials, DELETE
// /credentials/{id}), whose store lives inside auth.Provider and is not
// exposed to this binary. Serving an HTML fragment for it would mean
// re-implementing the credential store behind krill-ui -- a new
// dependency and a second source of truth for the credential API, which
// would put the OAuth2 front door at risk for a convenience upgrade.
//
// The body is a const rather than inline templ because it contains HTML
// string literals ('<tr><td ...>'), which templ escapes inside a <script>
// element. templ.Raw is the documented way to inject pre-made script
// text unescaped; nav_test.go's TestCredentialsPageTargetsSelfServeAPI
// asserts on the ids and the fetch() target this script uses, so it is
// the regression guard on this deliberate non-conversion.
const credentialsScript = `function escapeHTML(s) {
  const div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
}

async function refreshCredentials() {
  const body = document.getElementById('credentials-body');
  body.innerHTML = '';
  const res = await fetch('/credentials', { method: 'GET' });
  if (!res.ok) {
    body.innerHTML = '<tr><td colspan="4">failed to load credentials</td></tr>';
    return;
  }
  const data = await res.json();
  const creds = data.credentials || [];
  if (creds.length === 0) {
    body.innerHTML = '<tr><td colspan="4">no credentials yet</td></tr>';
    return;
  }
  for (const cred of creds) {
    const row = document.createElement('tr');
    const status = cred.revoked_at ? 'revoked' : 'active';
    row.innerHTML =
      '<td>' + escapeHTML(cred.id) + '</td>' +
      '<td>' + escapeHTML(cred.created_at) + '</td>' +
      '<td>' + escapeHTML(status) + '</td>' +
      '<td></td>';
    if (!cred.revoked_at) {
      const revokeBtn = document.createElement('button');
      revokeBtn.type = 'button';
      revokeBtn.textContent = 'Revoke';
      revokeBtn.addEventListener('click', function () { revokeCredential(cred.id); });
      row.lastElementChild.appendChild(revokeBtn);
    }
    body.appendChild(row);
  }
}

async function revokeCredential(id) {
  await fetch('/credentials/' + encodeURIComponent(id), { method: 'DELETE' });
  refreshCredentials();
}

document.getElementById('generate-btn').addEventListener('click', async function () {
  const res = await fetch('/credentials', { method: 'POST' });
  if (!res.ok) {
    alert('failed to generate token');
    return;
  }
  const data = await res.json();
  document.getElementById('new-token-value').value = data.token;
  document.getElementById('new-token').style.display = 'block';
  refreshCredentials();
});

document.getElementById('refresh-btn').addEventListener('click', refreshCredentials);

refreshCredentials();
`

// Credentials is the credential-widget page. Every id and the whole
// script body are preserved exactly -- see credentialsScript.
templ Credentials() {
	<section data-krill="credentials">
		<h2 class="text-lg font-semibold">Credentials</h2>
		<p class="mt-1 text-sm text-base-content/70">Mint a static bearer token for an MCP client that can't run the OAuth2 sign-in flow.</p>
		<div class="mt-4 flex gap-2">
			<button id="generate-btn" type="button" class="btn btn-primary btn-sm">Generate a token</button>
		</div>
		<div id="new-token" style="display:none;" class="mt-4">
			<p class="text-sm font-semibold">Copy this token now -- it will not be shown again after you leave this page.</p>
			<input id="new-token-value" type="text" readonly class="input input-bordered w-full font-mono"/>
		</div>
		<h3 class="mt-8 text-base font-semibold">Existing credentials</h3>
		<div class="mt-2">
			<button id="refresh-btn" type="button" class="btn btn-ghost btn-xs">Refresh</button>
		</div>
		<table id="credentials-table" class="table table-sm mt-2">
			<thead>
				<tr><th>ID</th><th>Created</th><th>Status</th><th></th></tr>
			</thead>
			<tbody id="credentials-body"></tbody>
		</table>
		@templ.Raw(credentialsScript, nil)
	</section>
}
