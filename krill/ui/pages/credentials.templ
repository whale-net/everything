package pages

import "github.com/whale-net/everything/libs/go/htmxui"

// credentialsResultsID is the swap target for every credentials action: the
// mint and revoke forms both re-render this block in place.
const credentialsResultsID = "credentials-results"

// CredentialRow is one minted credential as the table shows it. The raw
// token is never part of a row -- it exists only in CredentialsData.NewToken,
// on the response to the mint that created it.
type CredentialRow struct {
	ID        string
	CreatedAt string
	Revoked   bool
	// RevokeAction is the POST path that revokes this credential.
	RevokeAction string
}

// CredentialsData is the credentials block's view model.
type CredentialsData struct {
	Rows []CredentialRow
	// NewToken is the just-minted raw token, shown once; empty otherwise.
	NewToken string
	// Error, when set, is rendered inline above the table.
	Error string
	// MintAction is the POST path that mints a credential.
	MintAction string
}

// CredentialsPage is the credentials page: intro copy plus the swappable
// results block.
templ CredentialsPage(d CredentialsData) {
	<section data-krill="credentials">
		<h2 class="text-lg font-semibold">Credentials</h2>
		<p class="mt-1 text-sm text-base-content/70">Mint a static bearer token for an MCP client that can't run the OAuth2 sign-in flow.</p>
		@CredentialsResults(d)
	</section>
}

// CredentialsResults is the block every mint/revoke swaps. It carries its
// own id so an outerHTML swap leaves a target for the next action.
templ CredentialsResults(d CredentialsData) {
	<div id={ credentialsResultsID }>
		<form
			method="post"
			action={ templ.URL(d.MintAction) }
			hx-post={ d.MintAction }
			hx-target={ "#" + credentialsResultsID }
			hx-swap="outerHTML"
			class="mt-4"
		>
			<button type="submit" class="btn btn-primary btn-sm">Generate a token</button>
		</form>
		if d.Error != "" {
			<div class="mt-4">
				@htmxui.Alert(htmxui.AlertError, d.Error, nil)
			</div>
		}
		if d.NewToken != "" {
			<div class="mt-4" data-krill="new-token">
				<p class="text-sm font-semibold">Copy this token now -- it will not be shown again after you leave this page.</p>
				<input type="text" readonly value={ d.NewToken } class="input input-bordered w-full font-mono"/>
			</div>
		}
		<h3 class="mt-8 text-base font-semibold">Existing credentials</h3>
		if len(d.Rows) == 0 {
			<p class="mt-2 text-sm text-base-content/70">No credentials yet.</p>
		} else {
			<table class="table table-sm mt-2">
				<thead>
					<tr><th>ID</th><th>Created</th><th>Status</th><th></th></tr>
				</thead>
				<tbody>
					for _, row := range d.Rows {
						<tr>
							<td>{ row.ID }</td>
							<td>{ row.CreatedAt }</td>
							if row.Revoked {
								<td>revoked</td>
								<td></td>
							} else {
								<td>active</td>
								<td>
									<form
										method="post"
										action={ templ.URL(row.RevokeAction) }
										hx-post={ row.RevokeAction }
										hx-target={ "#" + credentialsResultsID }
										hx-swap="outerHTML"
										class="inline"
									>
										<button type="submit" class="btn btn-ghost btn-xs">Revoke</button>
									</form>
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}
