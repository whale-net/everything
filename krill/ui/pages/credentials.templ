package pages

import "github.com/whale-net/everything/libs/go/htmxui"

// credentialsResultsID is the swap target every credentials mutation
// replaces: the mint and revoke forms both re-render this block in place,
// so neither ever navigates away from a list the operator is reading.
//
// It is the id this page has always carried, so the region an operator's
// bookmarked fragment or an in-flight htmx request addresses does not move
// when this page is rebuilt.
const credentialsResultsID = "credentials-results"

// CredentialsBladeAnchor is the DOM id of the create-credential blade
// region: the hx-target the list's primary action names, and the id the
// served blade fragment's ROOT must carry (see SpecBladeAnchor, whose
// outerHTML-swap reasoning is identical).
//
// It is exported because the handler that serves the blade and the tests
// that drive it both have to name the one id the fragment is rooted at.
const CredentialsBladeAnchor = "krill-credentials-blade"

// CredentialRow is one credential as the table shows it.
//
// Only LIVE credentials reach this struct: the store's List answers live
// and revoked alike, and this table has no status column, so a revoked row
// left in it would read as usable. The filter is the mapper's job
// (credentialsData), not the template's -- a row rendered here is live by
// construction, which is why there is no Revoked field to branch on.
type CredentialRow struct {
	// ID is the store row's id: the revoke path is built from it, and it
	// is the stable handle a row keeps across a re-list.
	ID string

	// Name is the operator-chosen label, and the column the table leads
	// with. The id is the same value in every row and is something no human
	// picked; a list of them would be unreadable.
	Name string

	// Created* are the relative age and the exact RFC3339 instant it is
	// derived from: the cell renders readable with the head script absent
	// and still answers "exactly when" on hover.
	CreatedRelative string
	CreatedExact    string

	// LastUsed* are empty when the credential has never been used, which
	// the cell renders as the literal "never" rather than as a blank.
	LastUsedRelative string
	LastUsedExact    string

	// RevokeAction is the POST path that revokes this credential.
	RevokeAction string
}

// CredentialsData is the credentials page's view model.
type CredentialsData struct {
	// Rows are the caller's LIVE credentials, in the store's own order
	// (most recent first).
	Rows []CredentialRow

	// NewToken is the just-minted raw token, carried on this one response
	// and never on any other; empty otherwise.
	NewToken string
	// NewTokenName is the name the minted token was filed under, so the
	// confirmation names which credential it belongs to.
	NewTokenName string

	// Error, when set, is rendered inline above the table.
	Error string

	// MintAction is the POST path that mints a credential.
	MintAction string
	// NewHref is the GET path of the create blade -- both the list's
	// primary action's href and the action an empty state points at.
	NewHref string
	// ListHref is where Cancel returns to.
	ListHref string

	// BladeOpen is whether the create blade is showing, and BladeName the
	// name typed into it, kept so a refusal re-renders the blade with what
	// the operator actually typed rather than an empty field.
	BladeOpen bool
	BladeName string
}

// CredentialsPage is the credentials page: the header naming it, its one
// primary action, and the region every credential action swaps.
templ CredentialsPage(d CredentialsData) {
	<section data-krill="credentials" class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-semibold" data-krill="page-title">Credentials</h1>
			@credentialsNewBladeAction(d)
		</div>
		<p class="text-sm text-base-content/70">Mint a static bearer token for an MCP client that can't run the OAuth2 sign-in flow.</p>
		@CredentialsResults(d)
	</section>
}

// credentialsNewBladeAction opens the create blade.
//
// It carries both halves of the doubling rule: a real href to the blade's
// own URL (a no-JS click, a reload and a shared link all land on the same
// blade, because the URL renders the whole page with it open) and an
// hx-get of that same URL into the blade region (the path that keeps the
// list underneath untouched).
templ credentialsNewBladeAction(d CredentialsData) {
	<a href={ templ.URL(d.NewHref) }
		class="btn btn-primary btn-sm"
		data-krill="credentials-create"
		hx-get={ d.NewHref }
		hx-target={ "#" + CredentialsBladeAnchor }
		hx-swap="outerHTML">
		Create credential
	</a>
}

// CredentialsResults is the block every mint/revoke swaps. It carries its
// own id so an outerHTML swap leaves a target for the next action, and it
// owns the blade region so a mint can close the blade and re-render the
// list -- including the raw token -- in one swap.
templ CredentialsResults(d CredentialsData) {
	<div id={ credentialsResultsID } data-krill="credentials-results" class="space-y-4">
		if d.Error != "" {
			<div data-krill="credentials-alert">
				@htmxui.Alert(htmxui.AlertError, d.Error, nil)
			</div>
		}
		@CredentialsBladeSlot(d)
		if d.NewToken != "" {
			@credentialsNewToken(d)
		}
		if len(d.Rows) == 0 {
			@htmxui.EmptyState("No credentials yet.",
				"Create one to give an MCP client a static bearer token.",
				"Create credential", d.NewHref,
				templ.Attributes{"data-krill": "credentials-empty"})
		} else {
			@credentialsTable(d)
		}
	</div>
}

// CredentialsBladeSlot is the blade region: the closed placeholder and the
// open blade, so an open and a close are the same swap either way.
//
// The region renders even with no blade open, because the list's primary
// action has an hx-target that must resolve whether or not a blade is
// showing.
templ CredentialsBladeSlot(d CredentialsData) {
	<div id={ CredentialsBladeAnchor } data-krill="credentials-blade">
		if d.BladeOpen {
			@credentialsBlade(d)
		}
	</div>
}

// credentialsBlade is the create form: a Name field and the two controls
// that end it (Cancel, Create credential).
//
// The form is doubled like every other in this shell (htmxui ARCHITECTURE
// §9: the <form> element and its hx-* wiring stay app-owned): method+action
// is the no-JS path, and hx-post+hx-target+hx-swap is the htmx path. Both
// answer 200 -- a success renders the new list and the token, a refusal
// re-renders this same form with the typed name -- so a mint is never a
// data-loss event and never a status code the swap target cannot render.
//
// The Name input is NOT required: an empty name is a refusal this page has
// to be able to state in its own words, and the browser's own validation
// would take that answer away from the operator and from the no-JS path
// alike.
templ credentialsBlade(d CredentialsData) {
	<article class="card bg-base-100 border border-base-300 shadow-sm" data-krill="credentials-blade-body">
		<div class="card-body p-4 gap-3">
			<div class="flex items-start justify-between gap-4">
				<h2 class="text-lg font-semibold" data-krill="credentials-blade-title">Create credential</h2>
			</div>
			<form
				id="credentials-create-form"
				method="post"
				action={ templ.URL(d.MintAction) }
				hx-post={ d.MintAction }
				hx-target={ "#" + credentialsResultsID }
				hx-swap="outerHTML"
			>
				<p>
					<label class="label" for="credential-name">Name</label>
					<input id="credential-name" name="name" type="text"
						value={ d.BladeName } placeholder="claude-code laptop"
						class="input input-bordered w-full max-w-md"/>
				</p>
				<div class="flex justify-end gap-2">
					<a href={ templ.URL(d.ListHref) } class="btn btn-ghost btn-sm" data-krill="credentials-cancel">Cancel</a>
					<button type="submit" class="btn btn-primary btn-sm">Create credential</button>
				</div>
			</form>
		</div>
	</article>
}

// credentialsNewToken is the one response that carries a raw token.
//
// The token is shown EXACTLY ONCE: it exists only in this response, which
// is why a mint answers 200 rather than redirecting (a 303 has no body to
// carry it) and why the copy control reads the value out of the field
// rather than repeating it into a second attribute.
templ credentialsNewToken(d CredentialsData) {
	<div data-krill="credentials-new-token">
		@credentialsTokenAlert(d)
	</div>
}

// credentialsTokenAlert is the success alert carrying the one-time token.
//
// The Alert is htmxui's, so the "shown once" rule is expressed by what this
// page does around it rather than by a bespoke flash of its own.
templ credentialsTokenAlert(d CredentialsData) {
	@htmxui.Alert(htmxui.AlertSuccess, "Created "+d.NewTokenName+". Copy this token now -- it will not be shown again.", nil) {
		<dl class="m-0">
			<dd class="ml-0 flex flex-wrap items-center gap-2">
				<input type="text" readonly value={ d.NewToken }
					aria-label="New credential token"
					id="credentials-new-token-value"
					data-krill="credentials-new-token-value"
					class="input input-bordered w-full max-w-md font-mono"/>
				@credentialsCopyTokenControl()
				<span class="ml-2 text-xs" data-krill="copy-task-id-status" role="status" aria-live="polite"></span>
			</dd>
		</dl>
	}
}

// credentialsCopyTokenControl is the copy button for the one-time token.
//
// It is the shell's existing copy control (templ_render.go's
// copyTaskIdScript) pointed at the field rather than at itself: it names no
// secret of its own, so the raw token appears in this response exactly
// once, and it ships disabled with the reason in its title because the
// clipboard is a client API a control that cannot use must not pretend to.
//
// It sits in a <dd> because that is the scope the shared script looks in
// (btn.closest('dd')) -- a button outside one would copy correctly and then
// confirm nothing at all.
templ credentialsCopyTokenControl() {
	<button type="button" class="btn btn-ghost btn-sm disabled:opacity-50"
		aria-label="Copy the new token"
		data-krill="copy-task-id"
		data-copy-source="credentials-new-token-value"
		data-copy-label="token"
		disabled title="Copying the token needs JavaScript">
		Copy
	</button>
}

// credentialsTable is the register: one row per live credential, in the
// store's own order.
templ credentialsTable(d CredentialsData) {
	<div class="overflow-x-auto rounded-lg border border-base-300 bg-base-100">
		<table class="table table-zebra" data-krill="credentials-table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Created</th>
					<th>Last used</th>
					<th class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range d.Rows {
					<tr class="hover" data-krill="credential-row" data-krill-credential-id={ row.ID }>
						<td data-krill="credential-name">{ row.Name }</td>
						<td>@credentialInstant(row.CreatedRelative, row.CreatedExact, "credential-created-at")</td>
						<td>@credentialLastUsed(row)</td>
						<td class="text-right">
							<form
								method="post"
								action={ templ.URL(row.RevokeAction) }
								hx-post={ row.RevokeAction }
								hx-target={ "#" + credentialsResultsID }
								hx-swap="outerHTML"
								class="inline"
							>
								<button type="submit" class="btn btn-ghost btn-xs" data-krill="credential-revoke">Revoke</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// credentialInstant renders one cell's instant: the relative age as the
// visible text, the exact instant in the datetime and the title so hovering
// answers "exactly when", and the data-krill-updated-at hook the status
// register and the design-session list share.
templ credentialInstant(relative, exact, hook string) {
	<time class="text-sm text-base-content/70" data-krill={ hook }
		data-krill-updated-at={ exact } datetime={ exact } title={ exact }>{ relative }</time>
}

// credentialLastUsed is one row's last-used cell: the same instant shape
// when the credential has been used, and the literal "never" when it has
// not -- a blank cell would read as a read that dropped the value rather
// than a credential nobody has presented.
templ credentialLastUsed(row CredentialRow) {
	if row.LastUsedExact == "" {
		<span class="text-sm text-base-content/70" data-krill="credential-last-used-never">never</span>
	} else {
		@credentialInstant(row.LastUsedRelative, row.LastUsedExact, "credential-last-used-at")
	}
}