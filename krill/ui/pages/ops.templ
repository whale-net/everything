// ---------------------------------------------------------------------------
// task interventions
// ---------------------------------------------------------------------------

// TaskActions renders the intervention controls for one console row. A
// non-destructive verb is an inline form carrying its own reason prompt; a
// destructive verb is a plain link to its confirmation page, so nothing
// posts until the operator confirms on the next page.
//
// Every form is doubled -- method="post" + action= AND hx-post +
// hx-target + hx-swap (htmxui ARCHITECTURE §9: the <form> element and its
// hx-* attributes stay app-owned). A no-JS browser takes exactly the
// branch it took before, so the 303 it gets back is unchanged; an htmx
// browser gets the view's results block re-derived in place at 200.
templ TaskActions(controls []TaskActionControl) {
	for _, c := range controls {
		if c.Kind == "form" {
			<form
				method="post"
				action={ templ.URL(c.Action) }
				hx-post={ c.Action }
				hx-target={ "#" + opsResultsID }
				hx-swap="outerHTML"
				class="inline"
			>
				<input type="hidden" name="return_to" value={ c.ReturnTo } />
				<input type="text" name="reason" placeholder={ c.ReasonHint } size="18" aria-label={ c.ReasonHint } />
				<button type="submit" class="btn btn-ghost btn-xs">{ c.Label }</button>
			</form>
		} else {
			<a href={ templ.URL(c.Action) } class="btn btn-error btn-xs">{ c.Label }…</a>
		}
	}
}

// OpsInlineError is the whole fragment an htmx caller gets when a console
// query fails before a view could even be built -- a scope lookup or a
// store read that errored out. It is view-agnostic on purpose: the failure
// happened before the handler knew which view it was assembling, and
// rendering a plausible-looking empty table would be worse than saying so.
// The message is generic by design; the detail is logged, not shown.
//
// It carries the results id, and that is not decoration. It is swapped
// into the results block, and htmx's outerHTML inserts the response in
// place of the target and then REMOVES the target -- so a fragment without
// the id would delete the swap target itself. The next Refresh would then
// find no target, and htmx returns before issuing the request, so the
// console freezes with no network evidence that anything was attempted.
// Carrying the id keeps the block refreshable after an error.
templ OpsInlineError(message string) {
	<div id={ opsResultsID } data-krill="ops-inline-error">
		@htmxui.Alert(htmxui.AlertError, message, nil)
	</div>
}

// InterventionError is the in-shell page a refused intervention renders
// for a no-JS browser. The htmx path never reaches it: a refusal rides
// inside the re-derived results block as an inline Alert instead, because
// an htmx swap target's HTTP status is not surfaced to the operator.
templ InterventionError(d InterventionErrorData) {
	<h2>{ d.Heading }</h2>
	@htmxui.Alert(htmxui.AlertError, d.Detail, nil)
	<p class="mt-4">
		<a href={ templ.URL(d.ReturnTo) } class="link">Back to the console</a>
	</p>
}

// CancelConfirmCard is the confirmation step for the destructive cancel
// verb: a GET page, and the hx-target of its own doubled form.
//
// The card carries cancelConfirmID so the form can swap it in place, and
// a refusal re-renders this same card at 200 with the reason inline --
// the operator's typed rationale stays on screen instead of vanishing
// behind a status code.
templ CancelConfirmCard(d CancelConfirmData) {
	<div id={ cancelConfirmID } class="card bg-base-100 border-2 border-error/40 shadow-md">
		<div class="card-body">
			<h2 class="card-title">Cancel task { d.TaskID }?</h2>
			<p class="text-sm">
				Canceling dead-letters this task. It is never claimable again and a later requeue cannot reopen it. This cannot be undone.
			</p>
			if d.Error != "" {
				@htmxui.Alert(htmxui.AlertError, d.Error, nil)
			}
			<form
				method="post"
				action={ templ.URL(d.Action) }
				hx-post={ d.Action }
				hx-target={ "#" + cancelConfirmID }
				hx-swap="outerHTML"
				class="mt-4"
			>
				<input type="hidden" name="return_to" value={ d.ReturnTo } />
				<label class="form-control" for="reason">
					<span class="label-text">Reason (required):</span>
					<textarea id="reason" name="reason" rows="3" cols="48" required class="textarea textarea-bordered"></textarea>
				</label>
				<button type="submit" class="btn btn-error mt-4">Confirm cancel</button>
			</form>
			<p class="mt-4">
				<a href={ templ.URL(d.ReturnTo) } class="link">Back to the console</a>
			</p>
		</div>
	</div>
}

// ---------------------------------------------------------------------------
// domain vocabulary -> badge colour
// ---------------------------------------------------------------------------

// laneVariant maps krill's task lane onto a badge colour, in the spirit
// of htmxui ARCHITECTURE §13's domain-owned status mapper: the vocabulary
// is krill's, expressed in terms of htmxui.Badge rather than folded into
// it. Work still in flight is warning-coloured, a finished lane is
// success, and an unrecognised lane falls through to neutral rather than
// failing to compile when a sixth lane is added.
func laneVariant(lane string) htmxui.BadgeVariant {
	switch lane {
	case "Implementation", "Scaffold", "Testing", "Validation":
		return htmxui.BadgeWarning
	case "Done":
		return htmxui.BadgeSuccess
	default:
		return htmxui.BadgeNeutral
	}
}

// verdictVariant maps a task's most recent verdict onto a badge colour.
func verdictVariant(verdict string) htmxui.BadgeVariant {
	switch verdict {
	case "pass":
		return htmxui.BadgeSuccess
	case "fail":
		return htmxui.BadgeError
	default:
		// "-" (no verdict recorded yet) and any future value.
		return htmxui.BadgeNeutral
	}
}
