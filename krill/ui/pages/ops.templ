templ escalatedTable(rows []EscalatedRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No escalated tasks.", "No task in this scope carries an active escalation.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Task</th>
						<th>Delivery</th>
						<th>Reason</th>
						<th>Counter/cap</th>
						<th>Lane</th>
						<th>Escalated</th>
						<th>By</th>
						<th>On behalf of</th>
						<th>Summary</th>
						<th>Last verdict</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover">
							<td class="text-sm">
								{ row.TaskID }
								<br />
								{ row.Title }
							</td>
							<td class="text-sm">{ row.Delivery }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Reason, htmxui.BadgeWarning, htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.Counter }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Lane, laneVariant(row.Lane), htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.At }</td>
							<td class="text-sm">{ row.Actor }</td>
							<td class="text-sm">{ row.OnBehalfOf }</td>
							<td class="text-sm">{ row.Summary }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Verdict, verdictVariant(row.Verdict), htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">
								<div class="flex flex-wrap items-center gap-1">
									if row.Actions != nil {
										@row.Actions
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

