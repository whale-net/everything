package pages

import (
	"github.com/whale-net/everything/libs/go/htmxui"
)

// This file holds the ops console's page bodies: three of its four read
// views (escalated / cancelled / notes) and the four task interventions'
// affordances (the row controls, the rejection page, the cancel-confirm
// card).
//
// The claimed view's rows are not here. The Claimed tab of the Needs
// attention page is that view's one rendering (FR a149d28f), so its row
// view-model and its table live beside that page in
// krill/ui/pages/needs_attention.templ; this file keeps the shared results
// furniture and the page chrome the claimed view composes with.
//
// Each read view is one route in two modes. The results *fragment* is
// what a polled/swapped response carries -- no chrome, always HTTP 200 --
// and the *page* component is that same fragment under the view's
// heading, description and Refresh button, composed into the shell by
// krill/ui/templ_render.go's renderShell. A view therefore derives its
// data exactly once per request and both modes render the same view-model,
// so a fragment can never drift from the page it was swapped out of.
//
// The pure builders and mappers that populate these view-models stay in
// package main (krill/ui/ops.go, krill/ui/interventions.go): the paths,
// the identity resolution, the store paging rule, and the open-redirect
// guard are krill's rules, not presentation.

// OpsResultsAnchor is the stable id every read view's results block carries.
// It is the swap target for the row interventions' hx-post and for the
// manual Refresh button, and the poll's own "this" target resolves to it.
// One constant rather than a per-view generated id, so it is also
// byte-stable across a polled fragment's renders.
//
// Exported because a handler outside this package has to recognize the
// region in HX-Target: a row's Cancel swaps the results block while the
// confirm card's own form swaps the card, and that is the only thing that
// tells the two refusal origins apart (interventions.go).
const OpsResultsAnchor = "ops-results"

// CancelConfirmAnchor is the stable id of the cancel-confirm card, and the
// hx-target of that card's own doubled form. Exported for the same reason
// OpsResultsAnchor is: the card is the other region a refused cancel can be
// answered into, named by HX-Target rather than by the path.
const CancelConfirmAnchor = "cancel-confirm"

// ---------------------------------------------------------------------------
// view models
// ---------------------------------------------------------------------------

// EscalatedRow is one row of the escalated-task view (newEscalatedRow).
type EscalatedRow struct {
	TaskID     string
	Title      string
	Delivery   string
	Reason     string
	Counter    string
	Lane       string
	At         string
	Actor      string
	OnBehalfOf string
	Summary    string
	Verdict    string
	Actions    templ.Component
}

// CancelledRow is one row of the cancelled-task view (newCancelledRow).
//
// TaskHref is the product-scoped detail link, built by the loader from
// the read's own ConsoleFilter (empty on the scope-wide ops view, which
// names no product). Lane and Reason are the lane the task was cancelled
// out of and the optional intervention rationale; both come straight off
// store.CancelledTaskRow.
type CancelledRow struct {
	TaskID     string
	Title      string
	TaskHref   string
	Delivery   string
	Lane       string
	By         string
	OnBehalfOf string
	At         string
	Reason     string
}

// NoteRow is one row of the open-notes view (newNoteRow). Target names
// the note's target entity by id as well as title; TaskHref is its
// product-scoped detail link when the target IS a task, and empty when
// the target is a spec-axis entity (which has no task page to link to).
// Status is the note's lifecycle status, from the store's own
// enumeration.
type NoteRow struct {
	NoteID    string
	Kind      string
	Status    string
	Target    string
	TaskHref  string
	CreatedAt string
	Body      string
}

// OpsResultsData is the shared furniture of a read view's results block:
// its table, its "next page" link, an optional inline refusal, and the
// poll wiring the view's own route should (or should not) carry.
//
// Poll is a templ.Attributes rather than a bool so the *condition* for
// polling stays with the view that owns it (claimedPollAttrs) and this
// shared wrapper just forwards whatever that view decided.
type OpsResultsData struct {
	// Table is the view's rows, or its EmptyState when there are none.
	Table templ.Component
	// NextHref is the "next page" link, empty on the last page.
	NextHref string
	// Error is a refusal to present inline above the table, empty when none.
	Error string
	// ReadFailed marks an Error that came from failing to re-read the view
	// at all, rather than from a refused intervention. The error is then
	// the whole content: rendering the table alongside it would show an
	// EmptyState ("No claimed tasks.") that the operator cannot distinguish
	// from a successful read that genuinely came back empty -- a confident,
	// wrong answer immediately after their write landed.
	ReadFailed bool
	// Poll is the view's self-terminating poll wiring, nil for no timer.
	Poll templ.Attributes
}

// OpsPageData is the page chrome around a results block: the view's
// heading and one-line description, a manual Refresh button, and the
// results themselves.
type OpsPageData struct {
	Heading     string
	Description string
	// RefreshHref is the view's own path -- the manual refresh's hx-get,
	// and the same route the poll uses. Empty omits the button.
	RefreshHref string
	Results     templ.Component
}

// ClaimedData is the claimed-task view's view-model, for both its page
// and its results fragment.
//
// Href is the view's own path; Polling is decided server-side by
// claimedPollingDue over the freshly-read store rows, never by anything
// the browser supplied.
type ClaimedData struct {
	Rows     []ClaimedRow
	NextHref string
	Error    string
	Href     string
	Polling  bool
	ReadFailed bool
}

// EscalatedData is the escalated-task view's view-model.
type EscalatedData struct {
	Rows     []EscalatedRow
	NextHref string
	Error    string
	Href     string
	ReadFailed bool
}

// CancelledData is the cancelled-task view's view-model.
type CancelledData struct {
	Rows     []CancelledRow
	NextHref string
	Error    string
	Href     string
	ReadFailed bool
}

// NotesData is the open-notes view's view-model.
type NotesData struct {
	Rows     []NoteRow
	NextHref string
	Error    string
	Href     string
	ReadFailed bool
}

// TaskActionControl is one control on a console row: an inline form for a
// non-destructive verb (Kind "form") or, for a destructive verb (Kind
// "confirm"), a control whose two halves are two different routes -- the
// htmx half posts the verb after hx-confirm, the no-JS half opens the
// confirmation page that verb is reached through. Populated by
// renderTaskActions in package main, which owns the verb vocabulary; this
// file only renders.
type TaskActionControl struct {
	Kind       string
	Label      string
	Action     string
	ReasonHint string
	ReturnTo   string

	// PostAction is the htmx half's route: the verb's own POST, which the
	// browser issues only after accepting Confirm. It is set for a
	// destructive control, whose no-JS half is a GET to Action (the
	// confirmation page) because nothing may post to the destructive route
	// without an explicit confirmation. A non-destructive control leaves it
	// empty and posts Action on both halves.
	PostAction string

	// Confirm is the hx-confirm copy the destructive control shows before it
	// posts anything. It names the task, so the operator confirms the row
	// they meant rather than the row that happens to be at that position.
	Confirm string

	// ObservedClaimID is the claim the ROW observed, when the row holds one.
	// The control carries it as a hidden expected_claim_id field, on both
	// halves, so the write's guard is checked against the claim the operator
	// actually saw rather than against whatever is current when they act.
	// Empty for a control with no claim to guard against.
	ObservedClaimID string

	// ObservedID is the id of the state this control's row observed, and
	// the guard the write is checked against -- an escalated row's
	// escalation id, a claimed row's claim id. A form control carries it
	// as a hidden ObservedField input, so a state that changed since the
	// page loaded is refused rather than acted on. Empty is unguarded,
	// which is only right where the row observed nothing to guard.
	ObservedID string

	// ObservedField is the form field ObservedID is submitted under. It is
	// the api request field's own name ("expected_escalation_id"), so the
	// console forwards it to krill api unchanged rather than renaming it on
	// the way through.
	ObservedField string
}

// InterventionErrorData is the in-shell rejection page's data.
type InterventionErrorData struct {
	Heading  string
	Detail   string
	ReturnTo string
}

// CancelConfirmData is the cancel-confirm card's data. Error carries a
// refusal to present inline when the card is re-rendered after one.
//
// The observed-state guard fields are the same ones TaskActionControl
// carries, for the same reason: the card's form is the no-JavaScript half of
// a row's Cancel, so it posts the id the row observed and a claim or
// escalation that changed since the row was read is refused. At most one of
// ObservedClaimID and ObservedID is set -- a claimed row observed a claim, an
// escalated row an escalation, a ready task neither.
type CancelConfirmData struct {
	TaskID   string
	Action   string
	ReturnTo string
	Error    string

	// ObservedClaimID is the claim the acting row observed, submitted as the
	// api's own expected_claim_id field.
	ObservedClaimID string

	// ObservedID is the escalation the acting row observed, submitted under
	// ObservedField (the api request field's own name).
	ObservedID    string
	ObservedField string
}

// ---------------------------------------------------------------------------
// shared furniture
// ---------------------------------------------------------------------------

// opsResults renders one read view's results block: the id every swap
// targets, the view's poll wiring when it has any, an inline refusal when
// the block is being re-derived after a refused intervention, the rows
// themselves, and the next-page link.
templ opsResults(d OpsResultsData) {
	<div id={ OpsResultsAnchor } { d.Poll... }>
		if d.Error != "" {
			@htmxui.Alert(htmxui.AlertError, d.Error, nil)
		}
		if !d.ReadFailed {
			@d.Table
		}
		if d.NextHref != "" {
			<p class="mt-2">
				<a href={ templ.URL(d.NextHref) } class="link">Next page →</a>
			</p>
		}
	</div>
}

// opsPageChrome renders a read view's page: its heading with the manual
// Refresh button, its one-line description, and the results block.
//
// The Refresh button sits outside the results block on purpose. It is the
// only affordance the three settled views have, and swapping the block it
// lives in would take the button with it.
templ opsPageChrome(d OpsPageData) {
	<div class="flex flex-wrap items-center justify-between gap-4">
		<h2>{ d.Heading }</h2>
		if d.RefreshHref != "" {
			<button
				type="button"
				class="btn btn-ghost btn-sm"
				hx-get={ d.RefreshHref }
				hx-target={ "#" + OpsResultsAnchor }
				hx-swap="outerHTML"
			>Refresh</button>
		}
	</div>
	<p class="mt-1 text-sm text-base-content/60">{ d.Description }</p>
	<div class="mt-4">
		@d.Results
	</div>
}

// claimedPollAttrs is the claimed view's self-terminating poll, modelled
// on manmanv2's deploymentRowPollAttrs: the poll attributes are emitted
// only while the state they watch is transient, and because this route's
// own HX-Request response IS the same fragment, a settled view comes back
// without them and the loop stops by itself. No client-side timer
// bookkeeping, no separate refresh endpoint -- hx-get is the view's OWN
// request URI (ClaimedData.Href, the path plus query the operator is on)
// and the handler's HX-Request branch answers it.
//
// That it is d.Href and not a route constant is what lets the poll ride
// the Needs attention page's Claimed tab (FR a149d28f): the polled
// fragment carries the tab's own address -- ?tab=claimed, and whatever
// paging the operator is on -- rather than a fixed /ops/claimed, so a poll
// cannot move the operator to another tab or back to page one. On the tab
// the poll names the results block as its target, so it receives that
// block alone; the strip, its counts and the freshness stamp (whose
// instant moves every read) stay out of the polled bytes.
//
// This is the one place krill's console has a genuine transient state: a
// lease near expiry. The operator watches the row leave when the lease
// lapses. The other three views get a manual Refresh instead -- a task is
// escalated or it is not, so a timer would be pure cost, and it would
// swap a table out from under an operator typing a reason into a row.
func claimedPollAttrs(d ClaimedData) templ.Attributes {
	if !d.Polling {
		return templ.Attributes{}
	}
	return templ.Attributes{
		"hx-get":     d.Href,
		"hx-trigger": "every 3s",
		"hx-target":  "this",
		"hx-swap":    "outerHTML",
	}
}

// ---------------------------------------------------------------------------
// claimed view
// ---------------------------------------------------------------------------

templ ClaimedResults(d ClaimedData) {
	@opsResults(OpsResultsData{
		Table:    claimedTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
		Poll:     claimedPollAttrs(d),
	})
}

templ ClaimedPage(d ClaimedData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Claimed tasks",
		Description: "Every task that currently holds a claim, with its claimant, lane, claimed-since, and lease expiry.",
		RefreshHref: d.Href,
		Results:     ClaimedResults(d),
	})
}

// ---------------------------------------------------------------------------
// escalated view
// ---------------------------------------------------------------------------

templ EscalatedResults(d EscalatedData) {
	@opsResults(OpsResultsData{
		Table:    escalatedTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

templ EscalatedPage(d EscalatedData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Escalated tasks",
		Description: "Every task with an active escalation, and why it escalated.",
		RefreshHref: d.Href,
		Results:     EscalatedResults(d),
	})
}

templ escalatedTable(rows []EscalatedRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No escalated tasks.", "No task in this scope carries an active escalation.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Task</th>
						<th>Delivery</th>
						<th>Reason</th>
						<th>Counter/cap</th>
						<th>Lane</th>
						<th>Escalated</th>
						<th>By</th>
						<th>On behalf of</th>
						<th>Summary</th>
						<th>Last verdict</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover">
							<td class="text-sm">
								{ row.TaskID }
								<br />
								{ row.Title }
							</td>
							<td class="text-sm">{ row.Delivery }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Reason, htmxui.BadgeWarning, htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.Counter }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Lane, laneVariant(row.Lane), htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.At }</td>
							<td class="text-sm">{ row.Actor }</td>
							<td class="text-sm">{ row.OnBehalfOf }</td>
							<td class="text-sm">{ row.Summary }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Verdict, verdictVariant(row.Verdict), htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">
								<div class="flex flex-wrap items-center gap-1">
									if row.Actions != nil {
										@row.Actions
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ---------------------------------------------------------------------------
// cancelled view
// ---------------------------------------------------------------------------

templ CancelledResults(d CancelledData) {
	@opsResults(OpsResultsData{
		Table:    cancelledTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

templ CancelledPage(d CancelledData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Cancelled tasks",
		Description: "Every cancelled (dead-lettered) task, and who cancelled it.",
		RefreshHref: d.Href,
		Results:     CancelledResults(d),
	})
}

templ cancelledTable(rows []CancelledRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No cancelled tasks.", "Nothing has been dead-lettered in this scope.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Task</th>
						<th>Delivery</th>
						<th>Cancelled by</th>
						<th>On behalf of</th>
						<th>Cancelled at</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover">
							<td class="text-sm">
								{ row.TaskID }
								<br />
								{ row.Title }
							</td>
							<td class="text-sm">{ row.Delivery }</td>
							<td class="text-sm">{ row.By }</td>
							<td class="text-sm">{ row.OnBehalfOf }</td>
							<td class="text-sm">{ row.At }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ---------------------------------------------------------------------------
// open-notes view
// ---------------------------------------------------------------------------

templ NotesResults(d NotesData) {
	@opsResults(OpsResultsData{
		Table:    notesTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

templ NotesPage(d NotesData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Open notes",
		Description: "Every note still at 'noted', and the task or spec entity it targets.",
		RefreshHref: d.Href,
		Results:     NotesResults(d),
	})
}

templ notesTable(rows []NoteRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No open notes.", "No note in this scope is still awaiting a decision.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Note</th>
						<th>Kind</th>
						<th>Target</th>
						<th>Created</th>
						<th>Body</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover">
							<td class="text-sm">{ row.NoteID }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Kind, htmxui.BadgeInfo, htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.Target }</td>
							<td class="text-sm">{ row.CreatedAt }</td>
							<td class="text-sm krill-md">@templ.Raw(renderMarkdown(row.Body))</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ---------------------------------------------------------------------------
// task interventions
// ---------------------------------------------------------------------------

// TaskActions renders the intervention controls for one console row. A
// non-destructive verb is an inline doubled form carrying its own reason
// prompt; a destructive verb is a doubled control whose two halves are two
// routes -- htmx confirms (hx-confirm) and posts the verb in place, while a
// no-JS browser submits the same form as a GET to the verb's confirmation
// page. Nothing posts to the destructive route without an explicit
// confirmation either way; the difference is only which confirmation the
// browser gets.
//
// Both halves are doubled in the same sense as the non-destructive form
// (htmxui ARCHITECTURE §9: the <form> element and its hx-* attributes stay
// app-owned): the no-JS half is method="get" + action= the confirmation
// page, the htmx half is hx-post the verb + hx-target + hx-swap. The
// observed-state ids ride hidden inputs, so both halves carry the id the row
// observed -- to the confirmation page as query parameters, to the verb as
// body fields.
templ TaskActions(controls []TaskActionControl) {
	for _, c := range controls {
		if c.Kind == "form" {
			<form
				method="post"
				action={ templ.URL(c.Action) }
				hx-post={ c.Action }
				hx-target={ "#" + OpsResultsAnchor }
				hx-swap="outerHTML"
				class="inline"
			>
				<input type="hidden" name="return_to" value={ c.ReturnTo } />
				if c.ObservedClaimID != "" {
					<input type="hidden" name="expected_claim_id" value={ c.ObservedClaimID } />
				}
				if c.ObservedID != "" {
					<input type="hidden" name={ c.ObservedField } value={ c.ObservedID } />
				}
				<input type="text" name="reason" placeholder={ c.ReasonHint } size="18" aria-label={ c.ReasonHint } />
				<button type="submit" class="btn btn-ghost btn-xs">{ c.Label }</button>
			</form>
		} else {
			<form
				method="get"
				action={ templ.URL(c.Action) }
				hx-post={ c.PostAction }
				hx-target={ "#" + OpsResultsAnchor }
				hx-swap="outerHTML"
				hx-confirm={ c.Confirm }
				class="inline"
			>
				<input type="hidden" name="return_to" value={ c.ReturnTo } />
				if c.ObservedClaimID != "" {
					<input type="hidden" name="expected_claim_id" value={ c.ObservedClaimID } />
				}
				if c.ObservedID != "" {
					<input type="hidden" name={ c.ObservedField } value={ c.ObservedID } />
				}
				<button type="submit" class="btn btn-error btn-xs">{ c.Label }</button>
			</form>
		}
	}
}

// OpsInlineError is the whole fragment an htmx caller gets when a console
// query fails before a view could even be built -- a scope lookup or a
// store read that errored out. It is view-agnostic on purpose: the failure
// happened before the handler knew which view it was assembling, and
// rendering a plausible-looking empty table would be worse than saying so.
// The message is generic by design; the detail is logged, not shown.
//
// It carries the results id, and that is not decoration. It is swapped
// into the results block, and htmx's outerHTML inserts the response in
// place of the target and then REMOVES the target -- so a fragment without
// the id would delete the swap target itself. The next Refresh would then
// find no target, and htmx returns before issuing the request, so the
// console freezes with no network evidence that anything was attempted.
// Carrying the id keeps the block refreshable after an error.
templ OpsInlineError(message string) {
	<div id={ OpsResultsAnchor } data-krill="ops-inline-error">
		@htmxui.Alert(htmxui.AlertError, message, nil)
	</div>
}

// OpsQueryError is the in-shell page a console query failure renders for a
// no-JS browser: the same operator-facing message OpsInlineError carries,
// plus a way back to a working page. It is the reason the failure is not a
// bare text/plain body -- an operator who lands on a view that cannot load
// has to be able to navigate away from it, and a bare http.Error takes the
// nav with it.
//
// backHref is the view's own URI with the rejected continuation token
// dropped, so following it is itself the recovery.
templ OpsQueryError(message, backHref string) {
	<section data-krill="ops-query-error">
		<h2 class="text-xl font-semibold" data-krill="page-title">Could not load this view</h2>
		@htmxui.Alert(htmxui.AlertError, message, nil)
		<p class="mt-4">
			<a href={ templ.URL(backHref) } class="btn btn-secondary btn-sm">Reload the view</a>
		</p>
	</section>
}

// InterventionError is the in-shell page a refused intervention renders
// for a no-JS browser. The htmx path never reaches it: a refusal rides
// inside the re-derived results block as an inline Alert instead, because
// an htmx swap target's HTTP status is not surfaced to the operator.
templ InterventionError(d InterventionErrorData) {
	<h2>{ d.Heading }</h2>
	@htmxui.Alert(htmxui.AlertError, d.Detail, nil)
	<p class="mt-4">
		<a href={ templ.URL(d.ReturnTo) } class="link">Back to the console</a>
	</p>
}

// CancelConfirmCard is the confirmation step for the destructive cancel
// verb: a GET page, and the hx-target of its own doubled form.
//
// The card carries CancelConfirmAnchor so the form can swap it in place, and
// a refusal re-renders this same card at 200 with the reason inline --
// the operator's typed rationale stays on screen instead of vanishing
// behind a status code.
//
// It also carries the observed-state guard the acting row handed it, as
// hidden inputs on its form: this card IS the no-JavaScript half of a row's
// Cancel, so the id the row observed has to survive the round trip through
// this page for the eventual POST to be guarded against the state the
// operator saw.
templ CancelConfirmCard(d CancelConfirmData) {
	<div id={ CancelConfirmAnchor } class="card bg-base-100 border-2 border-error/40 shadow-md">
		<div class="card-body">
			<h2 class="card-title">Cancel task { d.TaskID }?</h2>
			<p class="text-sm">
				Canceling dead-letters this task. It is never claimable again and a later requeue cannot reopen it. This cannot be undone.
			</p>
			if d.Error != "" {
				@htmxui.Alert(htmxui.AlertError, d.Error, nil)
			}
			<form
				method="post"
				action={ templ.URL(d.Action) }
				hx-post={ d.Action }
				hx-target={ "#" + CancelConfirmAnchor }
				hx-swap="outerHTML"
				class="mt-4"
			>
				<input type="hidden" name="return_to" value={ d.ReturnTo } />
				if d.ObservedClaimID != "" {
					<input type="hidden" name="expected_claim_id" value={ d.ObservedClaimID } />
				}
				if d.ObservedID != "" {
					<input type="hidden" name={ d.ObservedField } value={ d.ObservedID } />
				}
				<label class="form-control" for="reason">
					<span class="label-text">Reason (required):</span>
					<textarea id="reason" name="reason" rows="3" cols="48" required class="textarea textarea-bordered"></textarea>
				</label>
				<button type="submit" class="btn btn-error mt-4">Confirm cancel</button>
			</form>
			<p class="mt-4">
				<a href={ templ.URL(d.ReturnTo) } class="link">Back to the console</a>
			</p>
		</div>
	</div>
}

// ---------------------------------------------------------------------------
// domain vocabulary -> badge colour
// ---------------------------------------------------------------------------

// laneVariant maps krill's task lane onto a badge colour, in the spirit
// of htmxui ARCHITECTURE §13's domain-owned status mapper: the vocabulary
// is krill's, expressed in terms of htmxui.Badge rather than folded into
// it. Work still in flight is warning-coloured, a finished lane is
// success, and an unrecognised lane falls through to neutral rather than
// failing to compile when a sixth lane is added.
func laneVariant(lane string) htmxui.BadgeVariant {
	switch lane {
	case "Implementation", "Scaffold", "Testing", "Validation":
		return htmxui.BadgeWarning
	case "Done":
		return htmxui.BadgeSuccess
	default:
		return htmxui.BadgeNeutral
	}
}

// verdictVariant maps a task's most recent verdict onto a badge colour.
func verdictVariant(verdict string) htmxui.BadgeVariant {
	switch verdict {
	case "pass":
		return htmxui.BadgeSuccess
	case "fail":
		return htmxui.BadgeError
	default:
		// "-" (no verdict recorded yet) and any future value.
		return htmxui.BadgeNeutral
	}
}
