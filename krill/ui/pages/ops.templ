package pages

import (
	"github.com/whale-net/everything/libs/go/htmxui"
)

// The ops console's page bodies: the escalated, cancelled and notes views and
// the intervention affordances. Each view renders one view-model as both a
// 200 results fragment and a full page, so the two cannot drift.

// OpsResultsAnchor is the results block's stable id: the target of row actions,
// Refresh and the poll. Exported so interventions.go can tell a row's Cancel
// from the confirm card's by HX-Target.
const OpsResultsAnchor = "ops-results"

// CancelConfirmAnchor is the cancel-confirm card's id and its form's hx-target,
// the other region a refused cancel can answer into.
const CancelConfirmAnchor = "cancel-confirm"

// view models

// EscalatedRow is one row of the escalated-task view (newEscalatedRow).
type EscalatedRow struct {
	TaskID     string
	Title      string
	Delivery   string
	Reason     string
	Counter    string
	Lane       string
	At         string
	Actor      string
	OnBehalfOf string
	Summary    string
	Verdict    string
	Actions    templ.Component
	// Popovers render after the table so no row contains a text input; each
	// submits the row's Actions form.
	Popovers templ.Component
}

// CancelledRow is one row of the cancelled-task view. TaskHref is empty on
// the scope-wide ops view, which names no product.
type CancelledRow struct {
	TaskID     string
	Title      string
	TaskHref   string
	Delivery   string
	Lane       string
	By         string
	OnBehalfOf string
	At         string
	Reason     string
}

// NoteRow is one row of the open-notes view. TaskHref is empty when the
// target is a spec entity rather than a task.
type NoteRow struct {
	NoteID    string
	Kind      string
	Status    string
	Target    string
	TaskHref  string
	CreatedAt string
	Body      string
}

// OpsResultsData is a results block's shared furniture. Poll is attributes, not
// a bool, so the polling condition stays with the owning view.
type OpsResultsData struct {
	// Table is the view's rows, or its EmptyState when there are none.
	Table templ.Component
	// NextHref is the "next page" link, empty on the last page.
	NextHref string
	// Error is a refusal to present inline above the table, empty when none.
	Error string
	// ReadFailed marks an Error from failing to re-read the view; the error then
	// replaces the table so an empty state is never mistaken for a real result.
	ReadFailed bool
	// Poll is the view's self-terminating poll wiring, nil for no timer.
	Poll templ.Attributes
}

// OpsPageData is the page chrome around a results block: heading, description,
// Refresh button and results.
type OpsPageData struct {
	Heading     string
	Description string
	// RefreshHref is the view's own path, as used by the poll; empty omits the button.
	RefreshHref string
	Results     templ.Component
}

// ClaimedData is the claimed view's view-model. Polling is decided server-side
// from fresh store rows, never from browser input.
type ClaimedData struct {
	Rows     []ClaimedRow
	NextHref string
	Error    string
	Href     string
	Polling  bool
	ReadFailed bool
}

// EscalatedData is the escalated-task view's view-model.
type EscalatedData struct {
	Rows     []EscalatedRow
	NextHref string
	Error    string
	Href     string
	ReadFailed bool
}

// CancelledData is the cancelled-task view's view-model.
type CancelledData struct {
	Rows     []CancelledRow
	NextHref string
	Error    string
	Href     string
	ReadFailed bool
}

// NotesData is the open-notes view's view-model.
type NotesData struct {
	Rows     []NoteRow
	NextHref string
	Error    string
	Href     string
	ReadFailed bool
}

// TaskActionControl is one row control: an inline form (Kind "form") or a
// destructive control (Kind "confirm") whose htmx half posts after hx-confirm
// and whose no-JS half opens a confirmation page. The reason input is in a popover.
type TaskActionControl struct {
	Kind       string
	Label      string
	Action     string
	ReasonHint string
	ReturnTo   string

	// FormID is the row form's id, named by the popover's form= attributes so the
	// popover outside the table still submits it.
	FormID string

	// PopoverID is the reason popover's id and its trigger's popovertarget.
	PopoverID string

	// ReasonID is the popover's reason input's id, for the label's for=.
	ReasonID string

	// SubmitLabel is the popover's submit text.
	SubmitLabel string

	// PostAction is a destructive control's htmx POST route; its no-JS half GETs
	// Action, the confirmation page. Empty for non-destructive controls.
	PostAction string

	// Confirm is the hx-confirm copy; it names the task so the operator confirms
	// the intended row.
	Confirm string

	// ObservedClaimID is the claim the row observed, sent as expected_claim_id so
	// the write is guarded against what the operator saw.
	ObservedClaimID string

	// ObservedID is the state id the row observed (escalation or claim), sent as
	// ObservedField so a changed state is refused. Empty is unguarded.
	ObservedID string

	// ObservedField is the api's own field name, forwarded unchanged.
	ObservedField string

	// Target is the DOM id the htmx half swaps; empty means the results block.
	// The task detail sets its own section.
	Target string

	// Primary renders the verb as a filled button instead of ghost; set only
	// by the task detail.
	Primary bool
}

// InterventionErrorData is the in-shell rejection page's data.
type InterventionErrorData struct {
	Heading  string
	Detail   string
	ReturnTo string
	// BackLabel is the link text; empty falls back to the console's label.
	BackLabel string
}

// interventionBackLabel is the caller's label, or the console's.
func interventionBackLabel(label string) string {
	if label == "" {
		return "Back to the console"
	}
	return label
}

// CancelConfirmData is the cancel-confirm card's data. It carries the row's
// observed-state guard, since the card is a row Cancel's no-JS half; at most
// one of ObservedClaimID and ObservedID is set.
type CancelConfirmData struct {
	TaskID   string
	Action   string
	ReturnTo string
	Error    string

	// ObservedClaimID is submitted as the api's expected_claim_id.
	ObservedClaimID string

	// ObservedID is the observed escalation, submitted under ObservedField.
	ObservedID    string
	ObservedField string

	// Reason pre-fills the card from the row popover, so a typed reason survives
	// the no-JS path. The field stays editable and required.
	Reason string
}

// shared furniture

// opsResults renders a results block: anchor id, poll wiring, inline refusal,
// rows and the next-page link.
templ opsResults(d OpsResultsData) {
	<div id={ OpsResultsAnchor } { d.Poll... }>
		if d.Error != "" {
			@htmxui.Alert(htmxui.AlertError, d.Error, nil)
		}
		if !d.ReadFailed {
			@d.Table
		}
		if d.NextHref != "" {
			<p class="mt-2">
				<a href={ templ.URL(d.NextHref) } class="link">Next page →</a>
			</p>
		}
	</div>
}

// opsPageChrome renders a view's page. Refresh sits outside the results block
// so swapping the block never removes it.
templ opsPageChrome(d OpsPageData) {
	<div class="flex flex-wrap items-center justify-between gap-4">
		<h2>{ d.Heading }</h2>
		if d.RefreshHref != "" {
			<button
				type="button"
				class="btn btn-ghost btn-sm"
				hx-get={ d.RefreshHref }
				hx-target={ "#" + OpsResultsAnchor }
				hx-swap="outerHTML"
			>Refresh</button>
		}
	</div>
	<p class="mt-1 text-sm text-base-content/60">{ d.Description }</p>
	<div class="mt-4">
		@d.Results
	</div>
}

// claimedPollAttrs emits poll attributes only while a lease is near expiry, so a
// settled response omits them and the poll stops itself. hx-get is d.Href, the
// operator's own URI, so polling never changes their tab or page.
func claimedPollAttrs(d ClaimedData) templ.Attributes {
	if !d.Polling {
		return templ.Attributes{}
	}
	return templ.Attributes{
		"hx-get":     d.Href,
		"hx-trigger": "every 3s",
		"hx-target":  "this",
		"hx-swap":    "outerHTML",
	}
}

// claimed view

templ ClaimedResults(d ClaimedData) {
	@opsResults(OpsResultsData{
		Table:    claimedTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
		Poll:     claimedPollAttrs(d),
	})
}

templ ClaimedPage(d ClaimedData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Claimed tasks",
		Description: "Every task that currently holds a claim, with its claimant, lane, claimed-since, and lease expiry.",
		RefreshHref: d.Href,
		Results:     ClaimedResults(d),
	})
}

// escalated view

templ EscalatedResults(d EscalatedData) {
	@opsResults(OpsResultsData{
		Table:    escalatedTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

templ EscalatedPage(d EscalatedData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Escalated tasks",
		Description: "Every task with an active escalation, and why it escalated.",
		RefreshHref: d.Href,
		Results:     EscalatedResults(d),
	})
}

templ escalatedTable(rows []EscalatedRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No escalated tasks.", "No task in this scope carries an active escalation.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Task</th>
						<th>Delivery</th>
						<th>Reason</th>
						<th>Counter/cap</th>
						<th>Lane</th>
						<th>Escalated</th>
						<th>By</th>
						<th>On behalf of</th>
						<th>Summary</th>
						<th>Last verdict</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover">
							<td class="text-sm">
								{ row.TaskID }
								<br />
								{ row.Title }
							</td>
							<td class="text-sm">{ row.Delivery }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Reason, htmxui.BadgeWarning, htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.Counter }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Lane, laneVariant(row.Lane), htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.At }</td>
							<td class="text-sm">{ row.Actor }</td>
							<td class="text-sm">{ row.OnBehalfOf }</td>
							<td class="text-sm">{ row.Summary }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Verdict, verdictVariant(row.Verdict), htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">
								<div class="flex flex-wrap items-center gap-1">
									if row.Actions != nil {
										@row.Actions
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		for _, row := range rows {
			if row.Popovers != nil {
				@row.Popovers
			}
		}
	}
}

// cancelled view

templ CancelledResults(d CancelledData) {
	@opsResults(OpsResultsData{
		Table:    cancelledTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

templ CancelledPage(d CancelledData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Cancelled tasks",
		Description: "Every cancelled (dead-lettered) task, and who cancelled it.",
		RefreshHref: d.Href,
		Results:     CancelledResults(d),
	})
}

templ cancelledTable(rows []CancelledRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No cancelled tasks.", "Nothing has been dead-lettered in this scope.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Task</th>
						<th>Delivery</th>
						<th>Cancelled by</th>
						<th>On behalf of</th>
						<th>Cancelled at</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover">
							<td class="text-sm">
								{ row.TaskID }
								<br />
								{ row.Title }
							</td>
							<td class="text-sm">{ row.Delivery }</td>
							<td class="text-sm">{ row.By }</td>
							<td class="text-sm">{ row.OnBehalfOf }</td>
							<td class="text-sm">{ row.At }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// open-notes view

templ NotesResults(d NotesData) {
	@opsResults(OpsResultsData{
		Table:    notesTable(d.Rows),
		NextHref: d.NextHref,
		Error:      d.Error,
		ReadFailed: d.ReadFailed,
	})
}

templ NotesPage(d NotesData) {
	@opsPageChrome(OpsPageData{
		Heading:     "Open notes",
		Description: "Every note still at 'noted', and the task or spec entity it targets.",
		RefreshHref: d.Href,
		Results:     NotesResults(d),
	})
}

templ notesTable(rows []NoteRow) {
	if len(rows) == 0 {
		@htmxui.EmptyState("No open notes.", "No note in this scope is still awaiting a decision.", "", "", nil)
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Note</th>
						<th>Kind</th>
						<th>Target</th>
						<th>Created</th>
						<th>Body</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="hover">
							<td class="text-sm">{ row.NoteID }</td>
							<td class="text-sm">
								@htmxui.Badge(row.Kind, htmxui.BadgeInfo, htmxui.BadgeSizeSM, true, nil)
							</td>
							<td class="text-sm">{ row.Target }</td>
							<td class="text-sm">{ row.CreatedAt }</td>
							<td class="text-sm krill-md">@templ.Raw(renderMarkdown(row.Body))</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// task interventions

// TaskActions renders a row's intervention controls. Each trigger is
// type="button" opening a native popover (a submit button would post before the
// popover opens); the popover's submit posts this form via form=, with or without JS.
templ TaskActions(controls []TaskActionControl) {
	for _, c := range controls {
		if c.Kind == "form" {
			<form
				method="post"
				action={ templ.URL(c.Action) }
				id={ c.FormID }
				hx-post={ c.Action }
				hx-target={ taskControlTarget(c.Target) }
				hx-swap="outerHTML"
				class="inline"
			>
				<input type="hidden" name="return_to" value={ c.ReturnTo } />
				if c.ObservedClaimID != "" {
					<input type="hidden" name="expected_claim_id" value={ c.ObservedClaimID } />
				}
				if c.ObservedID != "" {
					<input type="hidden" name={ c.ObservedField } value={ c.ObservedID } />
				}
				<button type="button" popovertarget={ c.PopoverID } class={ taskControlButtonClass(c.Primary) }>{ c.Label }</button>
			</form>
		} else {
			<form
				method="get"
				action={ templ.URL(c.Action) }
				id={ c.FormID }
				hx-post={ c.PostAction }
				hx-target={ taskControlTarget(c.Target) }
				hx-swap="outerHTML"
				hx-confirm={ c.Confirm }
				class="inline"
			>
				<input type="hidden" name="return_to" value={ c.ReturnTo } />
				if c.ObservedClaimID != "" {
					<input type="hidden" name="expected_claim_id" value={ c.ObservedClaimID } />
				}
				if c.ObservedID != "" {
					<input type="hidden" name={ c.ObservedField } value={ c.ObservedID } />
				}
				<button type="button" popovertarget={ c.PopoverID } class="btn btn-ghost btn-sm text-error">{ c.Label }</button>
			</form>
		}
	}
}

// TaskActionsMenu is the detail header's form of TaskActions: two controls
// inline; beyond that, the rest move into a "More" dropdown.
templ TaskActionsMenu(controls []TaskActionControl) {
	if len(controls) <= 2 {
		@TaskActions(controls)
	} else {
		@TaskActions(controls[:1])
		<details class="dropdown dropdown-end" data-krill="task-actions-more">
			<summary class="btn btn-ghost btn-sm" aria-label="More actions">More</summary>
			<div class="dropdown-content z-10 mt-1 flex w-44 flex-col gap-1 rounded-box border border-base-300 bg-base-100 p-2 shadow [&_button]:w-full [&_button]:justify-start [&_form]:block">
				@TaskActions(controls[1:])
			</div>
		</details>
	}
}

// taskControlTarget is the caller's target, or the results block.
func taskControlTarget(target string) string {
	if target == "" {
		return "#" + OpsResultsAnchor
	}
	return "#" + target
}

// taskControlButtonClass is filled for a primary verb, ghost otherwise.
func taskControlButtonClass(primary bool) string {
	if primary {
		return "btn btn-primary btn-sm"
	}
	return "btn btn-ghost btn-sm"
}

// TaskActionPopovers renders a reason popover per control outside the table;
// its inputs name the row's form via form=. The popover has no display class,
// since daisyUI's card display:flex would override the closed popover's none.
templ TaskActionPopovers(controls []TaskActionControl) {
	for _, c := range controls {
		<div
			id={ c.PopoverID }
			popover
			data-krill="reason-popover"
			class="m-auto w-72 overflow-visible bg-transparent p-0"
		>
			<div class="card bg-base-100 border border-base-300 shadow-lg"><div class="card-body p-4 gap-2">
				<label class="form-control w-full" for={ c.ReasonID }>
					<span class="label-text text-sm">{ c.ReasonHint }</span>
					<input
						id={ c.ReasonID }
						type="text"
						name="reason"
						form={ c.FormID }
						placeholder={ c.ReasonHint }
						aria-label={ c.ReasonHint }
						class="input input-bordered input-sm w-full"
					/>
				</label>
				<div class="card-actions justify-end">
					<button type="button" class="btn btn-ghost btn-sm" popovertarget={ c.PopoverID } popovertargetaction="hide">Close</button>
					<button type="submit" form={ c.FormID } class={ "btn btn-sm", templ.KV("btn-error", c.Kind == "confirm"), templ.KV("btn-primary", c.Kind != "confirm") }>{ c.SubmitLabel }</button>
				</div>
			</div></div>
		</div>
	}
}

// OpsInlineError is the htmx fragment for a query that failed before a view was
// built. It carries the results id because outerHTML removes the target, and
// without it the next Refresh would silently find nothing to swap.
templ OpsInlineError(message string) {
	<div id={ OpsResultsAnchor } data-krill="ops-inline-error">
		@htmxui.Alert(htmxui.AlertError, message, nil)
	</div>
}

// OpsQueryError is the no-JS in-shell page for a query failure. backHref is the
// view's URI without the rejected token, so following it recovers.
templ OpsQueryError(message, backHref string) {
	<section data-krill="ops-query-error">
		<h2 class="text-xl font-semibold" data-krill="page-title">Could not load this view</h2>
		@htmxui.Alert(htmxui.AlertError, message, nil)
		<p class="mt-4">
			<a href={ templ.URL(backHref) } class="btn btn-secondary btn-sm">Reload the view</a>
		</p>
	</section>
}

// InterventionError is the no-JS in-shell page for a refused intervention; htmx
// gets an inline Alert instead, since its swap hides the HTTP status.
templ InterventionError(d InterventionErrorData) {
	<h2>{ d.Heading }</h2>
	@htmxui.Alert(htmxui.AlertError, d.Detail, nil)
	<p class="mt-4">
		<a href={ templ.URL(d.ReturnTo) } class="link">{ interventionBackLabel(d.BackLabel) }</a>
	</p>
}

// CancelConfirmCard is the cancel confirmation page and its form's hx-target. A
// refusal re-renders it at 200 with the reason inline. It carries the row's
// observed-state guard and pre-fills the reason from the row popover.
templ CancelConfirmCard(d CancelConfirmData) {
	<div id={ CancelConfirmAnchor } class="card bg-base-100 border-2 border-error/40 shadow-md">
		<div class="card-body">
			<h2 class="card-title">Cancel task { d.TaskID }?</h2>
			<p class="text-sm">
				Canceling dead-letters this task. It is never claimable again and a later requeue cannot reopen it. This cannot be undone.
			</p>
			if d.Error != "" {
				@htmxui.Alert(htmxui.AlertError, d.Error, nil)
			}
			<form
				method="post"
				action={ templ.URL(d.Action) }
				hx-post={ d.Action }
				hx-target={ "#" + CancelConfirmAnchor }
				hx-swap="outerHTML"
				class="mt-4"
			>
				<input type="hidden" name="return_to" value={ d.ReturnTo } />
				if d.ObservedClaimID != "" {
					<input type="hidden" name="expected_claim_id" value={ d.ObservedClaimID } />
				}
				if d.ObservedID != "" {
					<input type="hidden" name={ d.ObservedField } value={ d.ObservedID } />
				}
				<label class="form-control" for="reason">
					<span class="label-text">Reason (required):</span>
					<textarea id="reason" name="reason" rows="3" cols="48" required class="textarea textarea-bordered">{ d.Reason }</textarea>
				</label>
				<button type="submit" class="btn btn-error mt-4">Confirm cancel</button>
			</form>
			<p class="mt-4">
				<a href={ templ.URL(d.ReturnTo) } class="link">Back to the console</a>
			</p>
		</div>
	</div>
}

// domain vocabulary -> badge colour

// laneVariant maps a lane to a badge colour: in flight is warning, finished is
// success, and an unknown lane is neutral.
func laneVariant(lane string) htmxui.BadgeVariant {
	switch lane {
	case "Implementation", "Scaffold", "Testing", "Validation":
		return htmxui.BadgeWarning
	case "Done":
		return htmxui.BadgeSuccess
	default:
		return htmxui.BadgeNeutral
	}
}

// verdictVariant maps a task's most recent verdict onto a badge colour.
func verdictVariant(verdict string) htmxui.BadgeVariant {
	switch verdict {
	case "pass":
		return htmxui.BadgeSuccess
	case "fail":
		return htmxui.BadgeError
	default:
		// "-" (no verdict yet) and any future value.
		return htmxui.BadgeNeutral
	}
}
