package pages

// The Overview page body: the shell's home, answering "is anything stuck,
// which milestone is in flight" (FR c3e1c276).
//
// It is the page frame plus the Needs-attention panel. The four stat tiles
// and the in-flight milestones panel render their own slots below; the
// header here has to stand on its own, because it is the part that must
// answer both questions in the first glance.

import (
	"strconv"

	"github.com/whale-net/everything/krill/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// OverviewAnchor is the DOM id this page's content region carries, so a
// swap can replace the region rather than the document around it.
const OverviewAnchor = "krill-overview"

// OverviewMilestone is one container currently in flight: its name and the
// status that put it there, rendered as a badge so "in design" and "in
// progress" are distinguishable at a glance.
type OverviewMilestone struct {
	Name   string
	Status string
}

// OverviewPage is one product's Overview.
type OverviewPage struct {
	Product ProductHeader

	// InFlight is every container in this product whose status means work
	// is happening now. Empty is a real answer -- it renders as a sentence
	// saying so, not as a blank panel an operator has to interpret.
	InFlight []OverviewMilestone

	// InFlightError is set when the delivery read failed, in place of the
	// list. It is never both: claiming no milestone is in flight because
	// the read failed would answer the page's central question wrongly.
	InFlightError string

	// Escalated is the count the primary action is built from.
	Escalated int

	// EscalatedReadable is false when the count could not be read. The
	// action is then absent and the header says nothing about escalation
	// at all -- "nothing is escalated" would be a second unverified claim.
	EscalatedReadable bool

	// EscalatedError is set in place of the count whenever it is not
	// readable, and renders where the action would have been. Silence is
	// not the alternative: an absent action beside an absent sentence
	// reads as "nothing needs you", which is the one answer this count
	// was unable to give (FR ede7cee6).
	EscalatedError string

	// EscalatedHref is the Escalated tab of Needs attention.
	EscalatedHref string

	// StatTiles are the four headline figures, each linking to whatever
	// it counts. Every tile's data is carried on its own, so one region's
	// read failing never costs the others their figures.
	StatTiles []OverviewStatTile

	// InFlightPanel is the "Milestones in flight" card: the same
	// containers the header names, each carrying the task progress the
	// one product-wide read returned for it (FR 8ef82053).
	InFlightPanel OverviewInFlightPanel

	// NeedsAttention is this product's most recently escalated tasks, at
	// most NeedsAttentionMax of them. Empty is a real answer -- it renders
	// as a designed empty state, not as a blank card.
	NeedsAttention []OverviewEscalation

	// NeedsAttentionError is set when the escalated read failed, in place
	// of the list. It is never both: an empty list beside a failed read
	// would claim nothing is escalated when nothing was checked.
	NeedsAttentionError string
}

// OverviewStatTile is one headline figure and the link behind it.
//
// Count and Sub are separate fields, and Sub is derived from the very rows
// its own Count was counted over, so a sub-line can never describe a
// different set than the number above it. Sub is "" when the data does not
// support one: a tile that can show its count still shows its count rather
// than a misleading zero.
type OverviewStatTile struct {
	Label string
	Href  string

	// Count is the rendered figure, "" when the read failed.
	Count string

	// Sub is the one-line qualifier beneath it -- the timeframe or the
	// narrower slice the figure is drawn from.
	Sub string

	// ValueClass colours the figure: text-error for a figure that means
	// something is stuck, text-warning for one that means something is
	// waiting on an answer.
	ValueClass string

	// Err is set when this tile's own read failed. It renders in place of
	// the figure: a queue that could not be counted must not render as an
	// empty one, which is indistinguishable from a genuinely idle queue.
	Err string
}

// overviewStatTile renders one figure as a link to what it counts. The
// whole stat is the anchor, so the click target is the figure the operator
// is reading rather than a word under it.
templ overviewStatTile(tile OverviewStatTile) {
	<a href={ templ.URL(tile.Href) } class="stat" data-krill="overview-stat">
		<div class="stat-title">{ tile.Label }</div>
		if tile.Err != "" {
			// An htmxui.Alert rather than a styled figure: a queue that
			// could not be counted must not occupy the same slot, with the
			// same weight, as one that was counted and came back empty.
			<div data-krill="overview-stat-error">
				@htmxui.Alert(htmxui.AlertError, tile.Err, nil)
			</div>
		} else {
			<div class={ "stat-value", tile.ValueClass } data-krill="overview-stat-count">{ tile.Count }</div>
			if tile.Sub != "" {
				<div class="stat-desc" data-krill="overview-stat-sub">{ tile.Sub }</div>
			}
		}
	</a>
}

// overviewStatTiles is the four-figure block. Vertical on a narrow screen,
// horizontal once there is room for four across.
templ overviewStatTiles(tiles []OverviewStatTile) {
	<div class="stats stats-vertical sm:stats-horizontal" data-krill="overview-stats">
		for _, tile := range tiles {
			@overviewStatTile(tile)
		}
	</div>
}

// OverviewInFlightRow is one container's row in the in-flight panel: the
// name linking to its detail page, the status that put it in flight, and
// the two figures its progress bar is built from.
//
// Done and Total are handed over whole rather than re-derived here. The
// read owns how a cancelled task counts (store.CancelledTaskCounting),
// and a view that summed the lanes again could disagree with the
// breakdown rendered elsewhere on the same figures.
type OverviewInFlightRow struct {
	Name   string
	Href   string
	Status string
	Done   int
	Total  int
}

// AwaitingSignoff reports whether this row is a container whose spec is
// still being written. It renders as a sentence rather than a progress
// bar: there are no tasks to count yet, and "0 of 0 tasks done" beside
// an empty bar reads as a stalled container rather than a new one.
func (r OverviewInFlightRow) AwaitingSignoff() bool {
	return r.Status == statusInDesign
}

// HasTasks reports whether the container holds any task at all. A
// container that does not says so rather than rendering "0 of 0".
func (r OverviewInFlightRow) HasTasks() bool { return r.Total > 0 }

// OverviewInFlightPanel is the whole card. Error and empty are separate
// states rather than one, because only one of them is an answer.
type OverviewInFlightPanel struct {
	// Rows are the in-flight containers, in the roadmap order the read
	// returned them.
	Rows []OverviewInFlightRow

	// Error is set when the progress read failed, in place of the rows.
	// An unreadable read must not render as an empty list: "nothing is in
	// flight" and "we could not check" are different answers and only one
	// of them is true.
	Error string
}

// statusInDesign is the wire spelling of the one in-flight status whose
// rows carry no task counts yet. It matches store.MilestoneStatusInDesign;
// the view takes it as a string because every status a row carries is one
// (OverviewInFlightRow.Status), so comparing it to the store's typed
// constant here would mean importing the store into a page that has no
// other reason to.
const statusInDesign = "in design"

// inFlightPanelRows renders the rows of the in-flight card, each with the
// milestone or milepebble's name linking to its detail page, the status
// badge that put it in flight, and its progress.
templ inFlightPanelRows(rows []OverviewInFlightRow) {
	<ul class="space-y-3" data-krill="overview-in-flight-panel-rows">
		for _, m := range rows {
			<li data-krill="overview-in-flight-row">
				<div class="flex items-center gap-2">
					<a href={ templ.URL(m.Href) } class="link font-medium">{ m.Name }</a>
					@statusBadge(m.Status)
				</div>
				if m.AwaitingSignoff() {
					<span class="text-sm text-base-content/70" data-krill="overview-in-flight-signoff">
						Spec not yet signed off.
					</span>
				} else if !m.HasTasks() {
					<span class="text-sm text-base-content/70" data-krill="overview-in-flight-no-tasks">
						No tasks yet.
					</span>
				} else {
					<progress class="progress progress-warning w-full" data-krill="overview-in-flight-progress"
						value={ strconv.Itoa(m.Done) } max={ strconv.Itoa(m.Total) }></progress>
					<span class="text-sm text-base-content/70" data-krill="overview-in-flight-progress-label">
						{ strconv.Itoa(m.Done) } of { strconv.Itoa(m.Total) } tasks done
					</span>
				}
			</li>
		}
	</ul>

	// NeedsAttention is this product's most recently escalated tasks, at
	// most NeedsAttentionMax of them. Empty is a real answer -- it renders
	// as a designed empty state, not as a blank card.
	NeedsAttention []OverviewEscalation

	// NeedsAttentionError is set when the escalated read failed, in place
	// of the list. It is never both: an empty list beside a failed read
	// would claim nothing is escalated when nothing was checked.
	NeedsAttentionError string
}

// NeedsAttentionMax is how many escalated tasks the panel lists. The FR's
// "at most the 5 most recently escalated" bounds what an operator skims
// before following See all, so the read asks the store for exactly this
// many rather than fetching a default page and truncating it.
const NeedsAttentionMax = 5

// OverviewEscalation is one escalated task in the Needs-attention panel:
// why it escalated, what it is, and when. EscalatedAtExact carries the
// same instant as the relative EscalatedAt so hovering can surface the
// precise time, which the relative figure alone cannot answer.
type OverviewEscalation struct {
	TaskID string
	Title  string
	Href   string

	// Reason is the store's wire value; the badge renders its human
	// wording through components.EscalationReasonLabel.
	Reason string

	EscalatedAt      string
	EscalatedAtExact string
}

// inFlightBadges renders one badge per in-flight container, through the
// same statusBadge the delivery page uses so the colours match every
// other status badge in the shell.
templ inFlightBadges(milestones []OverviewMilestone) {
	<ul class="mt-2 flex flex-wrap gap-2" data-krill="overview-in-flight">
		for _, m := range milestones {
			<li class="flex items-center gap-2">
				<span class="font-medium">{ m.Name }</span>
				@statusBadge(m.Status)
			</li>
		}
	</ul>
}

// overviewTaskWord is the plural the primary action needs. "1 escalated
// task" read beside "2 escalated task" is the kind of small wrongness
// that makes an operator doubt the number next to it.
func overviewTaskWord(n int) string {
	if n == 1 {
		return "task"
	}
	return "tasks"
}

// escalationReasonBadge renders one escalation reason through the shared
// reason vocabulary, so a reason added to the store later cannot render
// as a blank badge.
templ escalationReasonBadge(e OverviewEscalation) {
	{{ s := components.EscalationReasonStyle(e.Reason) }}
	@htmxui.Badge(components.EscalationReasonLabel(e.Reason), s.Variant, s.Size, s.Soft,
		templ.Attributes{"data-krill": "needs-attention-reason"})
}

// NeedsAttentionPanel lists this product's most recently escalated tasks,
// the answer to "is anything stuck" on the page whose first job is that.
//
// The empty state is a designed one rather than an absent list: an
// operator opening the panel to confirm nothing is wrong should be told
// so, not left reading a blank card and wondering whether the read
// happened.
templ NeedsAttentionPanel(page OverviewPage) {
	<div class="card bg-base-100 border border-base-300" data-krill="needs-attention-panel">
		<div class="card-body">
			<h2 class="card-title text-base">Needs attention</h2>
			if page.NeedsAttentionError != "" {
				<div data-krill="needs-attention-error">
					@htmxui.Alert(htmxui.AlertError, page.NeedsAttentionError, nil)
				</div>
			} else if len(page.NeedsAttention) == 0 {
				<div data-krill="needs-attention-empty">
					@htmxui.EmptyState("Nothing needs attention.", "No task in this product carries an active escalation.", "", "", nil)
				</div>
			} else {
				<ul class="divide-y divide-base-300" data-krill="needs-attention-list">
					for _, e := range page.NeedsAttention {
						<li class="py-2 flex items-center gap-2">
							@escalationReasonBadge(e)
							<a class="link flex-1" href={ templ.URL(e.Href) } data-krill="needs-attention-task">{ e.Title }</a>
							<span class="text-sm text-base-content/70" title={ e.EscalatedAtExact }>{ e.EscalatedAt }</span>
						</li>
					}
				</ul>
			}
			<div class="card-actions justify-end">
				<a href={ templ.URL(page.EscalatedHref) } class="btn btn-ghost btn-sm" data-krill="needs-attention-see-all">
					See all
				</a>
			</div>
		</div>
	</div>
}

// Overview renders the product's Overview: the product as its heading, a
// badge naming each container in flight, and one primary action when
// there is something escalated to act on.
templ Overview(page OverviewPage) {
	<section id={ OverviewAnchor } data-krill="overview" class="space-y-6">
		<header class="flex flex-wrap items-start justify-between gap-4">
			<div class="min-w-0">
				<h1 class="text-2xl font-bold" data-krill="page-title">{ page.Product.Name }</h1>
				if page.Product.Vision != "" {
					<p class="mt-1 text-sm text-base-content/70 max-w-3xl">{ page.Product.Vision }</p>
				}
				<div class="mt-3">
					if page.InFlightError != "" {
						<div data-krill="overview-in-flight-error">
							@htmxui.Alert(htmxui.AlertError, page.InFlightError, nil)
						</div>
					} else if len(page.InFlight) == 0 {
						<p class="text-sm text-base-content/70" data-krill="overview-no-in-flight">
							Nothing is in flight. No milestone is in design or in progress.
						</p>
					} else {
						@inFlightBadges(page.InFlight)
					}
				</div>
			</div>
			if page.EscalatedError != "" {
				<div data-krill="overview-escalated-error">
					@htmxui.Alert(htmxui.AlertError, page.EscalatedError, nil)
				</div>
			} else if page.EscalatedReadable && page.Escalated > 0 {
				<a href={ templ.URL(page.EscalatedHref) } class="btn btn-primary btn-sm"
				   data-krill="overview-primary-action">
					Review { page.Escalated } escalated { overviewTaskWord(page.Escalated) }
				</a>
			} else if page.EscalatedReadable {
				<p class="text-sm text-base-content/70" data-krill="overview-nothing-escalated">
					Nothing is escalated.
				</p>
			}
		</header>
		if len(page.StatTiles) > 0 {
			@overviewStatTiles(page.StatTiles)
		}
		<div class="grid gap-6 lg:grid-cols-2">
			<div class="card bg-base-100 border border-base-300" data-krill="overview-in-flight-panel">
				<div class="card-body">
					<h2 class="card-title">Milestones in flight</h2>
					if page.InFlightPanel.Error != "" {
						<div data-krill="overview-in-flight-panel-error">
							@htmxui.Alert(htmxui.AlertError, page.InFlightPanel.Error, nil)
						</div>
					} else if len(page.InFlightPanel.Rows) == 0 {
						@htmxui.EmptyState("Nothing is in flight",
							"No milestone is in design or in progress.",
							"", "", templ.Attributes{"data-krill": "overview-in-flight-panel-empty"})
					} else {
						@inFlightPanelRows(page.InFlightPanel.Rows)
					}
				</div>
			</div>
			@NeedsAttentionPanel(page)
		</div>
	</section>
}
