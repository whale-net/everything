package pages

// The Overview page body: answers "is anything stuck, which milestone is in
// flight" at first glance, with stat tiles and panels below.

import (
	"strconv"

	"github.com/whale-net/everything/krill/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// OverviewAnchor is the content region's id, so a swap replaces the region
// rather than the document around it.
const OverviewAnchor = "krill-overview"

// OverviewMilestone is one in-flight container: its name and its status badge.
type OverviewMilestone struct {
	Name   string
	Status string
}

// OverviewPage is one product's Overview.
type OverviewPage struct {
	Product ProductHeader

	// InFlight is every container with work happening now. Empty renders as a
	// sentence, not a blank panel.
	InFlight []OverviewMilestone

	// InFlightError replaces InFlight when the delivery read failed, so a failure
	// never reads as "nothing in flight".
	InFlightError string

	// Escalated is the count the primary action is built from.
	Escalated int

	// EscalatedReadable is false when the count could not be read; the action is
	// then absent rather than claiming nothing is escalated.
	EscalatedReadable bool

	// EscalatedError renders where the action would be when the count is unreadable,
	// since silence would read as "nothing needs you".
	EscalatedError string

	// EscalatedHref is the Escalated tab of Needs attention.
	EscalatedHref string

	// StatTiles are the four headline figures, each linking to what it counts.
	// Each tile carries its own data, so one failed read never costs the others.
	StatTiles []OverviewStatTile

	// InFlightPanel is the "Milestones in flight" card with each container's
	// task progress.
	InFlightPanel OverviewInFlightPanel

	// NeedsAttention is the most recently escalated tasks, at most
	// NeedsAttentionMax. Empty renders as a designed empty state.
	NeedsAttention []OverviewEscalation

	// NeedsAttentionError replaces the list when the escalated read failed, so
	// nothing unchecked is claimed clear.
	NeedsAttentionError string
}

// OverviewStatTile is one headline figure and its link. Sub is derived from
// the same rows as Count, and is "" when the data does not support one.
type OverviewStatTile struct {
	Label string
	Href  string

	// Count is the rendered figure, "" when the read failed.
	Count string

	// Sub is the one-line qualifier: the timeframe or narrower slice.
	Sub string

	// ValueClass colours the figure: text-error for stuck, text-warning for waiting.
	ValueClass string

	// Err replaces the figure when this tile's read failed, so an uncounted queue
	// never looks idle.
	Err string
}

// overviewStatTile renders one figure as a link; the whole stat is the anchor.
templ overviewStatTile(tile OverviewStatTile) {
	<a href={ templ.URL(tile.Href) } class="stat" data-krill="overview-stat">
		<div class="stat-title">{ tile.Label }</div>
		if tile.Err != "" {
			// An Alert rather than a figure, so an uncounted queue does not look like an
			// empty one.
			<div data-krill="overview-stat-error">
				@htmxui.Alert(htmxui.AlertError, tile.Err, nil)
			</div>
		} else {
			<div class={ "stat-value", tile.ValueClass } data-krill="overview-stat-count">{ tile.Count }</div>
			if tile.Sub != "" {
				<div class="stat-desc" data-krill="overview-stat-sub">{ tile.Sub }</div>
			}
		}
	</a>
}

// overviewStatTiles stacks vertically on narrow screens, horizontal when four fit.
templ overviewStatTiles(tiles []OverviewStatTile) {
	<div class="stats stats-vertical sm:stats-horizontal w-full border border-base-300 bg-base-100 shadow" data-krill="overview-stats">
		for _, tile := range tiles {
			@overviewStatTile(tile)
		}
	</div>
}

// OverviewInFlightRow is one in-flight container's row. Done and Total come
// whole from the read, which owns how cancelled tasks count.
type OverviewInFlightRow struct {
	Name   string
	Href   string
	Status string
	Done   int
	Total  int
}

// AwaitingSignoff reports a container whose spec is still being written; it
// renders a sentence rather than an empty "0 of 0" bar that looks stalled.
func (r OverviewInFlightRow) AwaitingSignoff() bool {
	return r.Status == statusInDesign
}

// HasTasks reports whether the container holds any task at all. A
// container that does not says so rather than rendering "0 of 0".
func (r OverviewInFlightRow) HasTasks() bool { return r.Total > 0 }

// OverviewInFlightPanel is the whole card; error and empty are distinct states.
type OverviewInFlightPanel struct {
	// Rows are the in-flight containers, in roadmap order.
	Rows []OverviewInFlightRow

	// Error replaces Rows when the progress read failed: "nothing in flight" and
	// "could not check" are different answers.
	Error string
}

// statusInDesign matches store.MilestoneStatusInDesign as a string, avoiding a
// store import in this page.
const statusInDesign = "in design"

// inFlightPanelRows renders each in-flight row: linked name, status badge,
// and progress.
templ inFlightPanelRows(rows []OverviewInFlightRow) {
	<ul class="space-y-3" data-krill="overview-in-flight-panel-rows">
		for _, m := range rows {
			<li data-krill="overview-in-flight-row">
				<div class="flex items-center gap-2">
					<a href={ templ.URL(m.Href) } class="link font-medium">{ m.Name }</a>
					@statusBadge(m.Status)
				</div>
				if m.AwaitingSignoff() {
					<span class="text-sm text-base-content/70" data-krill="overview-in-flight-signoff">
						Spec not yet signed off.
					</span>
				} else if !m.HasTasks() {
					<span class="text-sm text-base-content/70" data-krill="overview-in-flight-no-tasks">
						No tasks yet.
					</span>
				} else {
					<progress class={ "progress w-full", templ.KV("progress-success", m.Done == m.Total), templ.KV("progress-warning", m.Done != m.Total) } data-krill="overview-in-flight-progress"
						value={ strconv.Itoa(m.Done) } max={ strconv.Itoa(m.Total) }></progress>
					<span class="text-sm text-base-content/70" data-krill="overview-in-flight-progress-label">
						{ strconv.Itoa(m.Done) } of { strconv.Itoa(m.Total) } tasks done
					</span>
				}
			</li>
		}
	</ul>
}

// NeedsAttentionMax is how many escalated tasks the panel lists; the store is
// asked for exactly this many rather than truncating a default page.
const NeedsAttentionMax = 5

// OverviewEscalation is one escalated task in the Needs-attention panel.
// EscalatedAtExact backs the relative EscalatedAt for a precise hover time.
type OverviewEscalation struct {
	TaskID string
	Title  string
	Href   string

	// Reason is the store's wire value, rendered via EscalationReasonLabel.
	Reason string

	EscalatedAt      string
	EscalatedAtExact string
}

// inFlightBadges renders one badge per in-flight container via statusBadge, so
// colours match the rest of the shell.
templ inFlightBadges(milestones []OverviewMilestone) {
	<ul class="flex flex-wrap gap-2" data-krill="overview-in-flight">
		for _, m := range milestones {
			<li class="flex items-center gap-2 whitespace-nowrap">
				<span class="font-medium">{ m.Name }</span>
				@statusBadge(m.Status)
			</li>
		}
	</ul>
}

// overviewTaskWord is the plural the primary action needs.
func overviewTaskWord(n int) string {
	if n == 1 {
		return "task"
	}
	return "tasks"
}

// escalationReasonBadge renders a reason through the shared vocabulary, so a
// new store reason never renders blank.
templ escalationReasonBadge(e OverviewEscalation) {
	{{ s := components.EscalationReasonStyle(e.Reason) }}
	@htmxui.Badge(components.EscalationReasonLabel(e.Reason), s.Variant, s.Size, s.Soft,
		templ.Attributes{"data-krill": "needs-attention-reason"})
}

// NeedsAttentionPanel lists the most recently escalated tasks, with a designed
// empty state so a clear queue is stated rather than left blank.
templ NeedsAttentionPanel(page OverviewPage) {
	<div class="card bg-base-100 border border-base-300" data-krill="needs-attention-panel">
		<div class="card-body">
			<h2 class="card-title">Needs attention</h2>
			if page.NeedsAttentionError != "" {
				<div data-krill="needs-attention-error">
					@htmxui.Alert(htmxui.AlertError, page.NeedsAttentionError, nil)
				</div>
			} else if len(page.NeedsAttention) == 0 {
				<div data-krill="needs-attention-empty">
					@htmxui.EmptyState("Nothing needs attention.", "No task in this product carries an active escalation.", "", "", nil)
				</div>
			} else {
				<ul data-krill="needs-attention-list">
					for _, e := range page.NeedsAttention {
						<li class="py-2 flex items-center gap-2 border-b border-base-300 last:border-b-0">
							@escalationReasonBadge(e)
							<a class="link flex-1" href={ templ.URL(e.Href) } data-krill="needs-attention-task">{ e.Title }</a>
							<span class="text-sm text-base-content/70" title={ e.EscalatedAtExact }>{ e.EscalatedAt }</span>
						</li>
					}
				</ul>
			}
			<div class="card-actions justify-end">
				<a href={ templ.URL(page.EscalatedHref) } class="btn btn-ghost btn-sm" data-krill="needs-attention-see-all">
					See all
				</a>
			</div>
		</div>
	</div>
}

// Overview renders the product heading, a badge per in-flight container, and
// one primary action when something is escalated.
templ Overview(page OverviewPage) {
	<section id={ OverviewAnchor } data-krill="overview" class="space-y-6">
		<header class="flex flex-wrap items-start justify-between gap-4">
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-center gap-3">
					<h1 class="text-2xl font-semibold" data-krill="page-title">{ page.Product.Name }</h1>
					if page.InFlightError != "" {
						<div data-krill="overview-in-flight-error">
							@htmxui.Alert(htmxui.AlertError, page.InFlightError, nil)
						</div>
					} else if len(page.InFlight) == 0 {
						<p class="text-sm text-base-content/70" data-krill="overview-no-in-flight">
							Nothing is in flight. No milestone is in design or in progress.
						</p>
					} else {
						@inFlightBadges(page.InFlight)
					}
				</div>
				if page.Product.Vision != "" {
					<p class="mt-2 text-sm text-base-content/70 max-w-3xl line-clamp-2" title={ page.Product.Vision }>{ page.Product.Vision }</p>
				}
			</div>
			if page.EscalatedError != "" {
				<div data-krill="overview-escalated-error">
					@htmxui.Alert(htmxui.AlertError, page.EscalatedError, nil)
				</div>
			} else if page.EscalatedReadable && page.Escalated > 0 {
				<a href={ templ.URL(page.EscalatedHref) } class="btn btn-primary"
				   data-krill="overview-primary-action">
					Review { page.Escalated } escalated { overviewTaskWord(page.Escalated) }
				</a>
			} else if page.EscalatedReadable {
				<p class="text-sm text-base-content/70" data-krill="overview-nothing-escalated">
					Nothing is escalated.
				</p>
			}
		</header>
		if len(page.StatTiles) > 0 {
			@overviewStatTiles(page.StatTiles)
		}
		<div class="grid gap-6 lg:grid-cols-2">
			@NeedsAttentionPanel(page)
			<div class="card bg-base-100 border border-base-300" data-krill="overview-in-flight-panel">
				<div class="card-body">
					<h2 class="card-title">Milestones in flight</h2>
					if page.InFlightPanel.Error != "" {
						<div data-krill="overview-in-flight-panel-error">
							@htmxui.Alert(htmxui.AlertError, page.InFlightPanel.Error, nil)
						</div>
					} else if len(page.InFlightPanel.Rows) == 0 {
						@htmxui.EmptyState("Nothing is in flight",
							"No milestone is in design or in progress.",
							"", "", templ.Attributes{"data-krill": "overview-in-flight-panel-empty"})
					} else {
						@inFlightPanelRows(page.InFlightPanel.Rows)
					}
				</div>
			</div>
		</div>
	</section>
}
