package pages

// The read-only task detail body. The pure builder that populates
// TaskDetailPage lives in //krill/ui (task_detail_page.go).

import (
	"strconv"

	"github.com/whale-net/everything/krill/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// TaskDetailAnchor is the DOM id of the detail's content region; the
// Refresh button's hx-target and the served fragment's root id.
const TaskDetailAnchor = "krill-task-detail"

// TaskPanelAnchor is the DOM id of the tab panel region: the hx-target
// every tab names, and the id the served panel fragment's ROOT carries.
// The fragment has to carry it or htmx deletes the element it was asked
// to replace and every later tab click is a no-op that never reaches the
// server (README's swap-target rule).
const TaskPanelAnchor = "krill-task-panel"

// The tab keys -- the four ?tab= values. Overview is the default and is
// therefore ABSENT from the URL, so its href is the page's own address.
const (
	TaskTabOverview     = "overview"
	TaskTabNotes        = "notes"
	TaskTabDependencies = "dependencies"
	TaskTabSlice        = "slice"
)

// TaskTabID is the DOM id of one tab in the strip, which is also what its
// panel's aria-labelledby points at.
func TaskTabID(key string) string {
	return "krill-task-tab-" + key
}

// TaskTabQueryParam is the query parameter the tab travels in, and the
// name the region's carried input uses to hand it to the Refresh button.
const TaskTabQueryParam = "tab"

// TaskTabStateID is the DOM id of the hidden input inside the panel region
// that carries the selected tab.
//
// It exists because the Refresh button is OUTSIDE the swap region: a tab
// click re-renders this region and nothing else, so a tab fixed into the
// button's own markup at page-load time is the tab the page was LOADED
// with, not the one the operator is on. The button includes this input
// instead, so it reads the tab from the live region at press time -- the
// same carried-state pattern the Tasks scope form uses for the filters it
// re-reads.
const TaskTabStateID = "krill-task-tab-state"

// TaskCrumb is one breadcrumb entry: where the operator has been on the
// way to this task. Href is empty for the task's own title, which is the
// page they are already on and so is the one crumb that is not a link.
type TaskCrumb struct {
	Label string
	Href  string
}

// TaskLaneStep is one lane of the step strip, over the task's OWN
// lane_sequence (store/task.go NFR5: a task may skip or reorder lanes, so
// the sequence it was created with is the only authority on what comes
// next). Current marks the lane the task is in; Passed marks every lane
// before it, which is what "already through this" looks like.
type TaskLaneStep struct {
	Label   string
	Passed  bool
	Current bool
}

// TaskTab is one tab of the detail's facet strip. Href is a REAL href on
// the tab's own tab-qualified URL, so the no-JS path, a reload, a shared
// link and the browser's Back button all agree with what htmx swaps --
// the same rule README states for paging.
//
// Count is carried only when HasCount is true, which is only when the read
// behind the count succeeded. A count of zero is a claim the read backed;
// the absence of a badge is what a failed read renders, because "0" would
// be a second unverified claim about a list we could not read.
type TaskTab struct {
	Key      string
	Label    string
	Href     string
	Active   bool
	Count    int
	HasCount bool
}

// TaskDepLink is one dependency, linked to its own detail page.
type TaskDepLink struct {
	Title      string
	Lane       string
	DetailPath string
}

// TaskNoteRow is one note on the task.
//
// Rows arrive in the store's own order (ListNotesForTask's ascending
// created_at, id) and are rendered in it: a note list an operator reads as
// a log is only a log if the page does not reshuffle it, and the store's
// order is the one the MCP read and every other view agree on.
type TaskNoteRow struct {
	Kind   string
	Status string
	Body   string
}

// LatestNotesLimit is how many of a task's most recent notes the Overview
// panel shows. The Overview answers "what has been said about this lately",
// not "everything ever said about it" -- the Notes tab owns the whole list,
// and the FR is explicit that the Overview's list is a subset of it.
const LatestNotesLimit = 3

// The three callout keys -- the states the Overview panel explains. They
// are also what the markup carries as data-krill-callout, so a callout that
// quietly stopped explaining one of those states fails a test rather than
// passing as "some alert is present".
const (
	TaskCalloutEscalated    = "escalated"
	TaskCalloutCapped       = "capped"
	TaskCalloutLeaseExpired = "lease-expired"
)

// TaskCallout is one explanation the Overview panel gives about a task
// that is not simply in flight: why it was escalated, that it is at its
// attempt cap, or that its lease has lapsed.
//
// Key is one of the three constants above and is the hook the markup
// carries, so each state is individually assertable. Variant is carried
// rather than chosen in the component because severity is a property of
// the STATE, not of the box: it follows the same mapping the task's state
// badge uses (components.TaskStateStyle), so an escalated task's banner
// and its badge are the same colour instead of two independent decisions
// about how alarmed to look.
type TaskCallout struct {
	Key     string
	Message string
	Variant htmxui.AlertVariant
}

// TaskNoteBadges renders one note's two badges -- what it IS (kind) and
// where it sits in its lifecycle (status).
//
// It is the ONE rendering of a note's badges on this page, shared by the
// Notes panel and the Overview panel's latest notes, so the two facets
// cannot disagree about what a note is. The colours come from
// components.NoteKindStyle and components.NoteLifecycleStyle, which is
// where the vocabulary's presentation belongs.
//
// It takes the row rather than the two strings so the Overview panel, whose
// rows it also renders, calls the same component with the same argument
// shape the Notes panel does.
templ TaskNoteBadges(n TaskNoteRow) {
	<div class="flex flex-wrap items-center gap-2" data-krill="note-badges">
		{{ k := components.NoteKindStyle(n.Kind) }}
		@htmxui.Badge(n.Kind, k.Variant, k.Size, k.Soft, templ.Attributes{"data-krill": "note-kind"})
		{{ s := components.NoteLifecycleStyle(n.Status) }}
		@htmxui.Badge(n.Status, s.Variant, s.Size, s.Soft, templ.Attributes{"data-krill": "note-status"})
	</div>
}

// taskDepList is the ONE rendering of a task's dependencies: each as a
// link to its own product-scoped detail plus its lane as a badge, in the
// order the read returned them.
//
// Both callers -- the rail's Depends-on card and the Dependencies tab --
// render through it, because the card is a shortcut to the same list and
// two spellings of it are two lists that can drift. Each item's address
// is the product-scoped /products/{pid}/tasks/{tid}, so a dependency on
// another milestone needs no container in the link.
templ taskDepList(deps []TaskDepLink) {
	<ul class="space-y-2" data-krill="task-dep-list">
		for _, d := range deps {
			<li class="flex flex-wrap items-center gap-2" data-krill="task-dep">
				<a href={ templ.URL(d.DetailPath) } class="link link-primary" data-krill="task-dep-link">{ d.Title }</a>
				// The lane is a badge rather than a word, through the shared
				// TaskLaneBadge, so a dependency reads the same as a row in
				// the Tasks table and a card on the Board. A dependency
				// whose own task could not be read carries no lane, and an
				// empty badge would claim a lane the page never learned.
				if d.Lane != "" {
					@TaskLaneBadge(d.Lane)
				}
			</li>
		}
	</ul>
}

// TaskDetailPage is the task detail view model. ClaimID and
// LeaseExpiresAt are the observed claim identity, kept so a later write
// can be claim-guarded. DepsError/NotesError are per-section read
// failures.
type TaskDetailPage struct {
	Path  string
	ID    string
	Title string
	Body  string
	Lane  string

	// Crumbs is product -> milestone -> milepebble -> this task's title.
	// The milepebble crumb is present only for a task that sits on a cut
	// milepebble; a task on an uncut milestone has no such level, and
	// inventing one would put a crumb in the path that cannot be walked
	// back down.
	Crumbs []TaskCrumb

	// Steps is the lane step strip, one entry per lane of the task's own
	// lane_sequence. It replaces the "Lane sequence" row this page used to
	// spell the same sequence out as prose: one rendering, not two.
	Steps           []TaskLaneStep
	Attempts        string // e.g. "2 of 3"
	ClaimID         string
	LeaseExpiresAt  string // RFC3339, empty when unclaimed
	LoadedAt        string // RFC3339
	Badges          []TaskBadge
	Deps            []TaskDepLink
	DepsError       string
	Notes           []TaskNoteRow
	NotesError      string
	SliceJSON       string
	SliceError      string

	// The rail's Claim row, split rather than pre-joined into one string:
	// the live claimant, whether that claim's lease has lapsed, and -- for
	// a task nobody holds -- the session that held it last. Exactly one of
	// ClaimHolder and LastClaimHolder is ever set, which is what makes
	// "None. Last held by X" and "claimed by X" mutually exclusive rather
	// than two facts about one task that could both be rendered.
	ClaimHolder     string
	ClaimExpired    bool
	LastClaimHolder string

	// MilepebbleName/Path are the task's own container, carried only when
	// that container IS a milepebble. A task on an uncut milestone has no
	// milepebble, and a row naming its milestone again would say what the
	// breadcrumb already says.
	MilepebbleName string
	MilepebblePath string

	// Escalation names the task's current escalation event, and
	// EscalatedAt says when. EscalationReason is the store's own reason
	// vocabulary ("thrash-cap", "attempt-cap", "manual"), carried for the
	// properties rail and the Overview callout to present -- and
	// deliberately not rendered as a bare word here, because every enum an
	// operator reads is a badge through a variant mapper, and the reason's
	// presentation belongs with the panel that explains it.
	//
	// All three are empty when the task carries no escalation: a task that
	// was never escalated has no reason to show, and a blank row would read
	// as one whose reason could not be read.
	Escalation       string
	EscalationReason string
	EscalatedAt      string // RFC3339

	// EscalationCounter/EscalationCap are the event's own counter and cap
	// at the moment it fired, present only when HasEscalationCounter is
	// true. They are the two automatic reasons' triggering numbers; a
	// manual escalation has neither, and the store's CHECK refuses a
	// mismatched pair, so one flag covers both or neither.
	EscalationCounter     int
	EscalationCap         int
	HasEscalationCounter  bool

	// AttemptCount/AttemptCap are the task's attempt bookkeeping, carried
	// unformatted beside the rail's "n of m" label so the Overview callout
	// can judge the cap against the same numbers the rail prints.
	AttemptCount int
	AttemptCap   int

	// LatestNotes is the TAIL of Notes -- the most recent
	// LatestNotesLimit of them -- and NotesTotal is how many the read
	// returned in all. The Overview shows the tail; the Notes tab shows
	// every note. The two counts are carried so the Overview can say which
	// it is showing rather than presenting a truncated list as the whole
	// one.
	LatestNotes []TaskNoteRow
	NotesTotal  int

	// Callouts are the explanations of why this task is not simply in
	// flight, in a fixed order: escalation first, then the attempt cap,
	// then a lapsed lease. It is EMPTY for a healthy task, which renders
	// no banner at all -- a neutral "nothing is wrong" box beside a real
	// one is how an operator learns to ignore the box.
	Callouts []TaskCallout

	TasksPath     string
	BoardPath     string
	ContainerName string

	// Actions is the task's intervention controls, built in package main
	// from the ONE shared legality predicate (krill/ui/intervention_legality.go):
	// the detail offers exactly the verbs the Needs attention rows offer for
	// the same state and lane, and no verb a state forbids. It is nil when no
	// verb is legal -- a cancelled task, or a ready one in the Done lane --
	// and a nil component renders no callout at all rather than an empty
	// Actions box claiming there is nothing to do.
	Actions templ.Component

	// Tab is the resolved tab key -- one of the four constants above, and
	// never a raw ?tab= value: the handler resolves an unknown one to
	// overview before the view model sees it, so a component never has to
	// decide what an unrecognised tab means.
	Tab string

	// Tabs is the strip's four entries in order. It is on the view model
	// rather than derived in the component because each entry's href is
	// the page's own path with the tab applied, and only the request
	// knows that path (both detail routes reach this render).
	Tabs []TaskTab
}

// TaskDetailPanelAnchor is the DOM id of the panel body inside the swap
// region -- what each tab's aria-controls points at. It is deliberately
// NOT the swap target: the swap region wraps the strip and this, so a
// swap brings the operator's controls back with the answer.
const TaskDetailPanelAnchor = "krill-task-panel-body"

// TaskDetail renders the task detail region: the breadcrumb, the title
// with the task's state badges, and the two-column frame the properties
// rail and the tab panels slot into.
templ TaskDetail(page TaskDetailPage) {
	<section id={ TaskDetailAnchor } data-krill="task-detail" data-krill-task-id={ page.ID } data-krill-claim-id={ page.ClaimID } data-krill-lease-expires-at={ page.LeaseExpiresAt }>
		@taskDetailCrumbs(page.Crumbs)
		<div class="flex flex-wrap items-center gap-3" data-krill="task-detail-header">
			<h1 class="text-2xl font-semibold" data-krill="page-title">{ page.Title }</h1>
			<div class="flex flex-wrap items-center gap-2" data-krill="task-state">
				@TaskBadges(page.Badges)
			</div>
			<div class="flex-1"></div>
			<button type="button" class="btn btn-ghost btn-sm shrink-0" data-krill="refresh"
				hx-get={ templ.URL(page.Path) }
				hx-include={ "#" + TaskTabStateID }
				hx-target={ "#" + TaskDetailAnchor }
				hx-swap="outerHTML">
				Refresh
			</button>
		</div>
		<p class="mt-1 text-sm text-base-content/70">
			Loaded at <span data-krill="loaded-at">{ page.LoadedAt }</span>
		</p>
		<p class="mt-2 text-sm">
			<a href={ templ.URL(page.TasksPath) } class="link link-primary" data-krill="tasks-link">Back to { page.ContainerName } tasks</a>
			<a href={ templ.URL(page.BoardPath) } class="link link-primary ml-2" data-krill="board-link">Board</a>
		</p>
		@taskActionsCallout(page)
		<div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]" data-krill="task-detail-frame">
			<section class="min-w-0 space-y-4" data-krill="task-detail-main">
				@taskLaneSteps(page.Steps)
				@TaskDetailTabs(page)
			</section>
			<aside data-krill="task-properties-rail">
				@taskPropertiesCard(page)
				@taskDependsOnCard(page)
			</aside>
		</div>
	</section>
}

// taskActionsCallout is the detail's actions region: the intervention
// controls legal for the task's state, inside the section a post-action
// re-render swaps so the header, the rail and this callout move together
// (FR af61631d).
//
// It renders NOTHING when no verb is legal. A cancelled task offers no
// action, and an empty "Actions" box beside it would read as a control that
// failed to render rather than as the terminal state the task is in.
templ taskActionsCallout(page TaskDetailPage) {
	if page.Actions != nil {
		<div class="mt-4 card bg-base-100 border border-base-300" data-krill="task-actions">
			<div class="card-body gap-2 p-4">
				<h2 class="card-title text-sm font-semibold">Actions</h2>
				<div class="flex flex-wrap items-center gap-2">
					@page.Actions
				</div>
			</div>
		</div>
	}
}

// taskPropertiesCard is the rail's properties card: one label/value row per
// property the task actually has.
//
// A row with nothing behind it is omitted rather than rendered empty. A
// blank "Escalated" or "Milepebble" row would read as a value the page
// could not read, which is a different and untrue claim from "this task has
// neither".
templ taskPropertiesCard(page TaskDetailPage) {
	<div class="card bg-base-100 border border-base-300" data-krill="task-properties">
		<div class="card-body gap-3 p-4 text-sm">
			<h2 class="card-title text-sm font-semibold">Properties</h2>
			<dl class="space-y-2">
				<div>
					<dt class="text-base-content/70">Lane</dt>
					<dd data-krill="task-properties-lane">
						@TaskLaneBadge(page.Lane)
					</dd>
				</div>
				<div>
					<dt class="text-base-content/70">Attempts</dt>
					<dd data-krill="task-properties-attempts">
						{ page.Attempts }
						<span class="text-base-content/70">(lease-lapse and abandon attempts count toward the cap)</span>
					</dd>
				</div>
				<div>
					<dt class="text-base-content/70">Claim</dt>
					<dd data-krill="task-properties-claim">
						if page.ClaimID != "" {
							// The task row says a claim is held and the read
							// that names its holder failed, so the row has a
							// claim it cannot attribute. It says so, rather
							// than printing "Claimed by" over an empty span --
							// which would read as claimed-by-nobody, a value
							// the page never learned. The same rule the
							// Escalated row's unreadable-instant branch
							// follows, and for the same reason.
							if page.ClaimHolder != "" {
								Claimed by <span class="font-mono text-xs">{ page.ClaimHolder }</span>
							} else {
								<span class="text-base-content/70">Claimed by a session whose id could not be read.</span>
							}
							if page.ClaimExpired {
								<span class="text-base-content/70"> (lease expired, not live)</span>
							}
							if page.LeaseExpiresAt != "" {
								<span class="block text-base-content/70">
									Lease until <time data-krill="task-lease" datetime={ page.LeaseExpiresAt } title={ page.LeaseExpiresAt }>{ page.LeaseExpiresAt }</time>
								</span>
							}
						} else if page.LastClaimHolder != "" {
							None. Last held by <span class="font-mono text-xs">{ page.LastClaimHolder }</span>
						} else {
							None. This task has never been claimed.
						}
					</dd>
				</div>
				if page.Escalation != "" {
					<div>
						<dt class="text-base-content/70">Escalated</dt>
						<dd data-krill="task-properties-escalated">
							if page.EscalatedAt != "" {
								// The visible text is relative, derived by the
								// head's relativeAgeScript from the absolute
								// instant in the attribute -- a fragment that
								// carried its own relative string would be as
								// old as the response, and nothing inside the
								// swap could age it.
								<time data-krill="task-escalated-at" data-krill-updated-at={ page.EscalatedAt }
									datetime={ page.EscalatedAt } title={ page.EscalatedAt }>{ page.EscalatedAt }</time>
							} else {
								// The task row says it is escalated but the
								// event behind it could not be read, so there
								// is no instant to state. The row stays: the
								// Escalated badge beside the title comes from
								// the task row and is still true.
								<span class="text-base-content/70">When it was escalated could not be read.</span>
							}
						</dd>
					</div>
				}
				if page.MilepebbleName != "" {
					<div>
						<dt class="text-base-content/70">Milepebble</dt>
						<dd data-krill="task-properties-milepebble">
							<a href={ templ.URL(page.MilepebblePath) } class="link link-primary">{ page.MilepebbleName }</a>
						</dd>
					</div>
				}
				<div>
					<dt class="text-base-content/70">Task id</dt>
					<dd data-krill="task-properties-id">
						// Ships disabled: the clipboard is a client API, so
						// without the head's copyTaskIdScript this button is
						// guaranteed to do nothing, and a control that
						// cannot work must not look live. The script removes
						// disabled and swaps the title for what it does once
						// it has. With scripting off the id is still the
						// chip's own text -- readable and selectable.
						<button type="button" class="badge badge-ghost font-mono disabled:opacity-50"
							aria-label="Copy task id" data-krill="copy-task-id" data-task-id={ page.ID }
							disabled title="Copying the task id needs JavaScript">
							{ page.ID }
						</button>
						// The confirmation lands here, beside the chip and
						// never over it, so the id is still on screen while
						// the operator reads the result. It is a polite live
						// region, so it announces without stealing focus and
						// without interrupting. Empty on arrival and empty
						// again after the confirmation clears: a live region
						// must exist before its content changes to be
						// announced, so this is the one span here that is
						// legitimately blank -- it is not a property row and
						// says nothing about the task.
						<span class="ml-2 text-xs" data-krill="copy-task-id-status" role="status" aria-live="polite"></span>
					</dd>
				</div>
			</dl>
		</div>
	</div>
}

// taskDependsOnCard is the rail's dependency card: a shortcut to the same
// list the Dependencies tab renders, through taskDepList, so the two
// cannot drift.
//
// A task that waits on nothing renders no card at all rather than an empty
// one -- an empty box beside the content says something is missing where
// the answer is "nothing". A read failure does render the card, because
// there the difference between "no dependencies" and "could not tell" is
// exactly what the operator is being asked to act on.
templ taskDependsOnCard(page TaskDetailPage) {
	if len(page.Deps) > 0 || page.DepsError != "" {
		<div class="card bg-base-100 border border-base-300" data-krill="task-depends-on">
			<div class="card-body gap-2 p-4 text-sm">
				<h2 class="card-title text-sm font-semibold">Depends on</h2>
				if page.DepsError != "" {
					@htmxui.Alert(htmxui.AlertError, page.DepsError, nil)
				} else {
					@taskDepList(page.Deps)
				}
			</div>
		</div>
	}
}

// taskDetailCrumbs is the path from the product down to this task:
// product -> milestone -> milepebble (only when the task sits on one) ->
// the task's own title, which is the page they are already on and so is
// plain text rather than a link.
//
// The product leads even though the milestone is the nearer ancestor: it
// is the context the whole product area hangs off, and an operator
// reaching a task through a copied link needs the first crumb to be the
// one that says whose work this is.
//
// It renders inside the region rather than in the shell's top bar because
// the region is what a Refresh swaps: the breadcrumb names this task's own
// container, so it has to travel with the content it describes.
templ taskDetailCrumbs(crumbs []TaskCrumb) {
	if len(crumbs) > 0 {
		<nav class="breadcrumbs text-sm" aria-label="Breadcrumb" data-krill="task-breadcrumb">
			<ul>
				for _, c := range crumbs {
					<li data-krill="breadcrumb-crumb">
						if c.Href == "" {
							<span>{ c.Label }</span>
						} else {
							<a href={ templ.URL(c.Href) }>{ c.Label }</a>
						}
					</li>
				}
			</ul>
		</nav>
	}
}

// taskLaneSteps is the lane step strip: the task's own sequence, with
// every lane before the current one marked as passed and the current one
// marked as current.
//
// The strip reads over LaneSequence rather than over the store's
// canonical lane order, because a task's lane_sequence is what it was
// created with and is the authority on its own path (store/task.go
// NFR5). A task created as Scaffold -> Validation -> Done shows those
// three, and a strip that invented Implementation between them would be
// describing a workflow this task is not on.
templ taskLaneSteps(steps []TaskLaneStep) {
	if len(steps) > 0 {
		<ul class="steps w-full" data-krill="task-lane-steps">
			for _, s := range steps {
				<li class={ taskLaneStepClasses(s) } data-krill={ taskLaneStepHook(s) }
					if s.Current {
						aria-current="step"
					}>
					{ s.Label }
				</li>
			}
		</ul>
	}
}

// taskLaneStepClasses is one step's daisyUI class. Both a passed and the
// current step are step-primary -- daisyUI's own vocabulary for a step
// the task has reached -- and they are told apart by the hook and by
// aria-current rather than by colour alone.
func taskLaneStepClasses(s TaskLaneStep) string {
	if s.Passed || s.Current {
		return "step step-primary"
	}
	return "step"
}

// taskLaneStepHook is the step's data-krill hook: which of the three
// states it is in, so a test can say which lanes are marked passed and
// which is current rather than inferring it from a colour.
func taskLaneStepHook(s TaskLaneStep) string {
	switch {
	case s.Current:
		return "task-step-current"
	case s.Passed:
		return "task-step-passed"
	}
	return "task-step-upcoming"
}

// TaskDetailTabs is the detail's tabbed facet region: the strip and the
// panel below it, together.
//
// The strip is INSIDE the swap region rather than outside it, which is the
// second of the two ways the active tab can be re-marked (the first is an
// out-of-band swap of the active class). It is chosen here because a
// tab strip that is its own swap target needs the fragment to carry two
// top-level nodes -- the panel and the re-marked strip -- and htmx's
// outerHTML inserts EVERY top-level node of the response into the target.
// Keeping both in one region keeps the served fragment to exactly one
// root, which is what makes a tab click repeatable (README's swap-target
// rule). The cost is that the operator's own controls are re-rendered
// rather than left in the DOM, which is invisible because the response
// carries a fresh, identically-marked strip.
//
// The whole rest of the page -- header, breadcrumbs, lane steps,
// properties rail -- sits OUTSIDE this region, so a tab click swaps this
// facet region alone and never re-derives the rest of the page.
templ TaskDetailTabs(page TaskDetailPage) {
	<div id={ TaskPanelAnchor } data-krill="task-panel" data-krill-task-tab={ page.Tab }>
		@taskDetailTabStrip(page.Tabs)
		@taskDetailTabState(page.Tab)
		<div id={ TaskDetailPanelAnchor } role="tabpanel" aria-labelledby={ TaskTabID(page.Tab) } class="mt-4 space-y-4" data-krill="task-panel-body">
			if page.Tab == TaskTabOverview {
				@taskOverviewPanel(page)
			} else if page.Tab == TaskTabNotes {
				@taskNotesPanel(page)
			} else if page.Tab == TaskTabDependencies {
				@taskDependenciesPanel(page)
			} else {
				@taskSlicePanel(page)
			}
		</div>
	</div>
}

// taskDetailTabState is the region's carried tab: a hidden input naming
// the tab this fragment rendered.
//
// It is rendered INSIDE the swap region, which is the whole point. The
// Refresh button lives outside that region, so nothing a tab click swaps
// re-renders the button -- a tab written into the button's own hx-get at
// page-load time describes the page as LOADED, and a tab click changes
// the address bar and the panel without touching it. An input the region
// re-renders on every click is the one place the current tab is
// readable from the button at press time.
//
// Overview renders NO input: the default state is the bare address, so a
// Refresh taken there re-requests the bare path rather than a URL
// spelling out the absence of a choice.
templ taskDetailTabState(tab string) {
	if tab != TaskTabOverview {
		<input type="hidden" id={ TaskTabStateID } name={ TaskTabQueryParam } value={ tab } data-krill="task-tab-state" />
	}
}

// taskDetailTabStrip is the tablist: four real links, each carrying the
// htmx attributes that swap the panel region in place and push the tab's
// own URL.
//
// The href is the whole mechanism. htmx's hx-get takes the address, but
// the href is what a reload, a shared link, a no-JS click and the
// browser's Back button follow -- the same rule README states for paging.
// Because the pushed URL is the tab's own href, the address bar, the
// served page and the strip's active marking can never disagree.
templ taskDetailTabStrip(tabs []TaskTab) {
	<div role="tablist" class="tabs tabs-border" data-krill="task-tabs">
		for _, t := range tabs {
			<a role="tab" id={ TaskTabID(t.Key) } href={ templ.URL(t.Href) }
				class={ taskTabClasses(t.Active) }
				aria-selected={ taskTabSelected(t.Active) }
				aria-controls={ TaskDetailPanelAnchor }
				hx-get={ templ.URL(t.Href) }
				hx-target={ "#" + TaskPanelAnchor }
				hx-swap="outerHTML"
				hx-push-url="true"
				data-krill="task-tab" data-krill-task-tab={ t.Key }>
				{ t.Label }
				if t.HasCount {
					@htmxui.Badge(strconv.Itoa(t.Count), htmxui.BadgeGhost, htmxui.BadgeSizeSM, false, templ.Attributes{"data-krill": "task-tab-count"})
				}
			</a>
		}
	</div>
}

// taskTabClasses is one tab's daisyUI class. The active tab is
// tab-active; every other is not, so the strip has exactly one active
// marking whichever tab the URL resolved to.
func taskTabClasses(active bool) string {
	if active {
		return "tab tab-active"
	}
	return "tab"
}

// taskTabSelected is the tab's aria-selected, as the string the attribute
// takes. It is emitted on both active and inactive tabs rather than
// omitted when false: an omitted aria-selected on a role="tab" element
// leaves its state undefined rather than false.
func taskTabSelected(active bool) string {
	if active {
		return "true"
	}
	return "false"
}

// taskOverviewPanel is the Overview facet, in the order an operator reads
// it: why this task is stuck (if it is), what it asks for, and what has
// been said about it lately.
//
// The strip, the swap mechanics and the URL state belong to FR 7e463e31
// and are untouched here -- this panel is one region a fill-in owns.
templ taskOverviewPanel(page TaskDetailPage) {
	<div class="space-y-4" data-krill="task-panel-overview" data-krill-panel-host="overview">
		@taskOverviewCallouts(page.Callouts)
		@taskDescriptionCard(page.Body)
		@taskLatestNotesCard(page)
	</div>
}

// taskOverviewCallouts is the explanation banner for a task that is not
// simply in flight -- one Alert per state, in the order the builder fixed
// (escalation, attempt cap, lapsed lease).
//
// It renders NOTHING for a healthy task. A task with nothing wrong gets no
// banner at all rather than a neutral one: an operator who sees the box
// appear for every task learns to read past it, and the one escalation it
// does carry would be read past too.
templ taskOverviewCallouts(callouts []TaskCallout) {
	for _, c := range callouts {
		@htmxui.Alert(c.Variant, c.Message, templ.Attributes{"data-krill": "task-callout", "data-krill-callout": c.Key})
	}
}

// taskDescriptionCard is the task's own body, whitespace preserved.
//
// The card is omitted entirely for a task with no body. An empty card
// titled "Description" is a claim that there is a description and it is
// blank -- a different and untrue statement from "this task has none".
templ taskDescriptionCard(body string) {
	if body != "" {
		<div class="card bg-base-100 border border-base-300" data-krill="task-description">
			<div class="card-body gap-2 p-4">
				<h2 class="card-title text-sm font-semibold">Description</h2>
				<pre class="whitespace-pre-wrap text-sm" data-krill="task-body">{ body }</pre>
			</div>
		</div>
	}
}

// taskLatestNotesCard is the tail of the task's notes: the most recent
// few, with each one's kind and status badges.
//
// The card names its own count, because it is a SUBSET. When notes were
// dropped to fit, it says so; a truncated list presented as "Latest notes"
// with no visible boundary is how an operator concludes there are three
// notes when there are thirty.
//
// A failed notes read renders no card rather than an empty one. The Notes
// tab owns that alert -- the same rule the tab's own panel follows, and
// for the same reason: an unreadable list must never render as a read one.
templ taskLatestNotesCard(page TaskDetailPage) {
	if page.NotesError == "" && len(page.LatestNotes) > 0 {
		<div class="card bg-base-100 border border-base-300" data-krill="task-latest-notes">
			<div class="card-body gap-2 p-4">
				<div class="flex flex-wrap items-baseline justify-between gap-2">
					<h2 class="card-title text-sm font-semibold">Latest notes</h2>
					@taskLatestNotesCount(page)
				</div>
				<ul class="space-y-3">
					for _, n := range page.LatestNotes {
						<li data-krill="task-latest-note">
							@TaskNoteBadges(n)
							<pre class="whitespace-pre-wrap text-sm" data-krill="note-body">{ n.Body }</pre>
						</li>
					}
				</ul>
			</div>
		</div>
	}
}

// taskLatestNotesCount is the card's honest count: "All n notes" when the
// tail is the whole list, and "Showing the k most recent of n" when it is
// not.
//
// Without this line the card's title ("Latest notes") is the only signal
// that it is a subset, and it is the kind of signal nobody reads twice.
templ taskLatestNotesCount(page TaskDetailPage) {
	<span class="text-xs text-base-content/70" data-krill="task-latest-notes-count">{ taskLatestNotesCountText(page) }</span>
}

// taskLatestNotesCountText is the card's count, stated so it cannot be
// misread: "All 4 notes." when the tail IS the whole list, and "Showing
// the 3 most recent of 12. The Notes tab has all of them." when it is not.
//
// The two arms differ in more than wording. "All" is a claim that the read
// returned everything; the other arm is a claim that it did not, with the
// number that says so. A single phrasing for both would be a lie in one of
// them.
func taskLatestNotesCountText(page TaskDetailPage) string {
	shown := len(page.LatestNotes)
	if shown < page.NotesTotal {
		return "Showing the " + strconv.Itoa(shown) + " most recent of " +
			strconv.Itoa(page.NotesTotal) + ". The Notes tab has all of them."
	}
	return "All " + strconv.Itoa(page.NotesTotal) + " " + taskNotesNoun(page.NotesTotal) + "."
}

// taskNotesNoun is the count's noun, so a single note does not render "All
// 1 notes".
func taskNotesNoun(n int) string {
	if n == 1 {
		return "note"
	}
	return "notes"
}

// taskNotesPanel lists EVERY note on the task, each with its kind badge
// and its lifecycle-status badge through the shared TaskNoteBadges, in the
// store's own order (see TaskNoteRow).
//
// A failed notes read alerts INSIDE this panel only: the header, the lane
// steps and the properties rail are outside the swap region, and the
// other panels are not rendered while this one is. An unreadable list
// never renders as an empty one -- NotesError is what this panel reads,
// and the empty state is what a READ THAT SUCCEEDED with nothing says.
templ taskNotesPanel(page TaskDetailPage) {
	<div data-krill="task-panel-notes" data-krill-panel-host="notes">
		<h2 class="text-lg font-semibold">Notes</h2>
		if page.NotesError != "" {
			@htmxui.Alert(htmxui.AlertError, page.NotesError, nil)
		} else if len(page.Notes) == 0 {
			@htmxui.EmptyState(
				"No notes",
				"Nothing has been recorded against this task yet.",
				"", "", templ.Attributes{"data-krill": "task-notes-empty"},
			)
		} else {
			<ul class="space-y-3 text-sm" data-krill="task-note-list">
				for _, n := range page.Notes {
					<li data-krill="task-note">
						@TaskNoteBadges(n)
						<pre class="mt-1 whitespace-pre-wrap" data-krill="note-body">{ n.Body }</pre>
					</li>
				}
			</ul>
		}
	</div>
}

// taskDependenciesPanel lists EVERY dependency through the same
// taskDepList the rail's Depends-on card renders, so the two facets are
// one list rather than two that can drift.
//
// DepsError is read here and nowhere else: a failed dependencies read
// must cost this panel alone.
templ taskDependenciesPanel(page TaskDetailPage) {
	<div data-krill="task-panel-dependencies" data-krill-panel-host="dependencies">
		<h2 class="text-lg font-semibold">Dependencies</h2>
		if page.DepsError != "" {
			@htmxui.Alert(htmxui.AlertError, page.DepsError, nil)
		} else if len(page.Deps) == 0 {
			@htmxui.EmptyState(
				"No dependencies",
				"Nothing has to finish before this task can be claimed.",
				"", "", templ.Attributes{"data-krill": "task-deps-empty"},
			)
		} else {
			@taskDepList(page.Deps)
		}
	</div>
}

// taskSlicePanel is the Spec slice host (task b70e8d21 owns its contents,
// including the closed disclosure the raw JSON sits behind).
//
// The document is the raw wire get_task returns -- machine-readable, and
// far too long to be the page's first impression. So it sits behind a
// disclosure that is CLOSED on arrival: an operator reading the task wants
// the description, the notes and the claim, and wants the JSON only when
// they are checking what an agent was actually handed. The disclosure's
// own label is the panel's label, which is why this host carries no
// heading of its own -- a "Spec slice" <h2> directly above a "Spec slice
// (raw JSON)" summary would name one thing twice.
//
// It is the ONLY place on the page the document renders. A read failure
// alerts here instead of an empty disclosure, because a closed disclosure
// with nothing in it reads as "this task has no slice" -- a claim about
// the task that a failed read is not entitled to make.
templ taskSlicePanel(page TaskDetailPage) {
	<div data-krill="task-panel-slice" data-krill-panel-host="slice">
		if page.SliceError != "" {
			@htmxui.Alert(htmxui.AlertError, page.SliceError, nil)
		} else {
			<details class="collapse collapse-arrow bg-base-100 border border-base-300" data-krill="task-slice-disclosure">
				<summary class="collapse-title font-semibold">Spec slice (raw JSON)</summary>
				<div class="collapse-content">
					<pre class="overflow-x-auto text-xs" data-krill="task-slice-json">{ page.SliceJSON }</pre>
				</div>
			</details>
		}
	</div>
}
