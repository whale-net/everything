package pages

import (
	"github.com/whale-net/everything/krill/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// The design-session read surface, as page bodies; the builders stay in //krill/ui.
// Regions carry stable ids (design-sessions, revision-events, open-questions, session-nav)
// so tests assert on regions, not heading markup.

// DesignSessionRow is one row of a product's session list. Stage is the store's derived
// stage, never re-derived here. Times arrive pre-rendered because relative text needs a clock.
type DesignSessionRow struct {
	// ID is the session's own id.
	ID string

	// OpeningRequest is the opening submission's first line; the full text is on the detail page.
	OpeningRequest string

	// DetailPath is the canonical, product-scoped detail URL.
	DetailPath string

	// Stage is the derived stage's wire value.
	Stage string

	// OpenBlockingQuestions is the open blocking question count; non-blocking ones live on the
	// detail rail, where their text is.
	OpenBlockingQuestions int

	OpenedRelative string
	OpenedExact    string
}

// DesignSessionNewBlade is the "new design session" blade. ProductName is read-only context;
// there is no product, session or identity input. Error and OpeningSubmission are set when a
// refused submission re-renders, preserving the operator's text.
type DesignSessionNewBlade struct {
	ProductID         string
	ProductName       string
	OpeningSubmission string
	Error             string

	// FormAction is the blade's POST target and ListPath where Cancel returns; both caller-supplied.
	FormAction string
	ListPath   string
}

// DesignSessionNewBladeAnchor is the blade region's id: the list action's hx-target and the
// fragment root (outerHTML would otherwise delete the region). Rendered empty when closed.
const DesignSessionNewBladeAnchor = "design-session-new-blade"

// DesignSessionListPage is the product-scoped session list. NewBlade nil means the blade is
// closed; NewBladePath is a real href so no-JS clicks and shared links reach the blade.
type DesignSessionListPage struct {
	ProductID    string
	ProductName  string
	Path         string
	Sessions     []DesignSessionRow
	NewBlade     *DesignSessionNewBlade
	NewBladePath string
	FormAction   string
}

// EntityDeltaRow is one spec entity a revision event touched.
type EntityDeltaRow struct {
	EntityID    string
	Change      string
	SummaryLine string
}

// OpenQuestionDeltaRow is one question a revision event opened.
type OpenQuestionDeltaRow struct {
	QuestionID string
	Text       string
	Blocking   string // "blocking" or "non-blocking"
}

// RevisionEventRow is one round of a session's log. AtRelative/AtExact arrive pre-rendered.
// Summary is derived in package main (revisionEventSummary) because revision_event has no prose column.
type RevisionEventRow struct {
	ID string
	// SeqNo is the round's position in the log, exposed in a hook for order assertions.
	SeqNo     int
	EventType string
	// Acting is the recorded acting subject in composite "kind sub@iss" form.
	Acting string
	// OnBehalfOf is the on-behalf-of subject, shown only when it differs from Acting.
	OnBehalfOf string
	// OnBehalfOfDiffers reports whether OnBehalfOf is worth a second line.
	OnBehalfOfDiffers bool
	VerifiedAgainst   string
	SignoffStatus     string
	CreatedAt         string
	AtRelative        string
	AtExact           string
	Summary           string
	EntityDeltas      []EntityDeltaRow
	OpenedQuestions   []OpenQuestionDeltaRow
	ResolvedQuestions []string
}

// OpenQuestionRow is one currently-open question, tagged blocking or
// non-blocking exactly as list_open_questions tags it.
type OpenQuestionRow struct {
	QuestionID    string
	Text          string
	Blocking      string // "blocking" or "non-blocking"
	OpenedAtSeqNo int
}

// DesignSessionDetailPage is one session: row, ordered log, and open questions. Error, FollowUp
// and CheckedResolve preserve a rejected follow-up's input. OpenedBy is the server-read subject,
// empty when unreadable; OpenedByKrillSessionID is provenance, not what the copy chip carries.
type DesignSessionDetailPage struct {
	ID                     string
	ProductID              string
	ProductName            string
	ProductOverviewPath    string
	OpeningRequest         string
	OpeningSubmission      string
	Stage                  string
	OpenedBy               string
	OpenedByTitle          string
	OpenedByKrillSessionID string
	CreatedAt              string
	ProductSessionsPath    string
	Events                 []RevisionEventRow
	OpenQuestions          []OpenQuestionRow
	// LogError and QuestionsError degrade one region to an inline alert instead of failing the
	// page. They hold operator-facing text, never store errors, and a failed read is never shown
	// as an empty list.
	LogError              string
	QuestionsError        string
	Error                  string
	FollowUp               string
	CheckedResolve         map[string]bool
	AnswersPath            string
	// SignedOff hides the follow-up form; it is the same derived stage (store.StageApproved)
	// the badge shows.
	SignedOff bool
}

// IsChecked reports whether the resolve box for id was ticked, so a rejected round keeps
// the operator's ticks. A nil CheckedResolve reads every id as unticked.
func (p DesignSessionDetailPage) IsChecked(id string) bool { return p.CheckedResolve[id] }

// FollowUpFormAnchor is the follow-up form's id, which the rail's resolve checkboxes name
// in their `form` attribute so they submit with it from outside the form, without JavaScript.
const FollowUpFormAnchor = "follow-up-form"

// designSessionListAnchor is the DOM id of this page's region.
const designSessionListAnchor = "design-sessions"

// designSessionStageBadge renders a row's stage via components.DesignSessionStageStyle/Label,
// so the stage vocabulary has one owner.
templ designSessionStageBadge(stage string) {
	{{ s := components.DesignSessionStageStyle(stage) }}
	@htmxui.Badge(components.DesignSessionStageLabel(stage), s.Variant, s.Size, s.Soft, templ.Attributes{
		"data-krill": "design-session-stage",
	})
}

// designSessionBlockingCell renders an error "N blocking" badge when answers are owed, and a
// plain 0 otherwise, so nothing-to-do never looks urgent.
templ designSessionBlockingCell(s DesignSessionRow) {
	if s.OpenBlockingQuestions > 0 {
		{{ style := components.DesignSessionBlockingCountStyle() }}
		@htmxui.Badge(itoa(s.OpenBlockingQuestions)+" blocking", style.Variant, style.Size, style.Soft, templ.Attributes{
			"data-krill": "design-session-blocking",
		})
	} else {
		<span class="text-sm text-base-content/70" data-krill="design-session-blocking-none">0</span>
	}
}

// designSessionOpenedAt renders the relative age as text, with the exact instant in datetime,
// title and data-krill-updated-at; it reads fine without the head script.
templ designSessionOpenedAt(s DesignSessionRow) {
	<time class="text-sm text-base-content/70" data-krill="design-session-opened-at"
		data-krill-updated-at={ s.OpenedExact } datetime={ s.OpenedExact } title={ s.OpenedExact }>{ s.OpenedRelative }</time>
}

// DesignSessionList is the product's session table, newest first. The primary action is a real
// link to the blade URL (htmx swaps it in place); the blade region lives inside this section.
templ DesignSessionList(page DesignSessionListPage) {
	<section id={ designSessionListAnchor } class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-semibold" data-krill="page-title">Design sessions</h1>
			@newDesignSessionAction(page.NewBladePath)
		</div>
		<p class="text-sm text-base-content/70">
			{ page.ProductName } — every design session, most recently opened first.
		</p>
		@NewDesignSessionBlade(page.NewBlade)
		if len(page.Sessions) > 0 {
			<div class="overflow-x-auto rounded-lg border border-base-300 bg-base-100">
				<table class="table table-zebra" data-krill="design-session-table">
					<thead>
						<tr>
							<th>Opening request</th>
							<th>Stage</th>
							<th class="text-right">Open questions</th>
							<th>Opened</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range page.Sessions {
							<tr class="hover" data-krill="design-session-row" data-krill-design-session-id={ s.ID }>
								<td>
									<a href={ templ.URL(s.DetailPath) } class="link font-medium" data-krill="design-session-opening-request">{ s.OpeningRequest }</a>
								</td>
								<td>@designSessionStageBadge(s.Stage)</td>
								<td class="text-right">@designSessionBlockingCell(s)</td>
								<td>@designSessionOpenedAt(s)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@htmxui.EmptyState("No design sessions for this product yet.", "Open one above to start a design conversation.",
				"New design session", page.NewBladePath, templ.Attributes{"data-krill": "design-sessions-empty"})
		}
	</section>
}

// newDesignSessionAction links to the blade URL; href is the no-JS half and hx-get with
// hx-push-url the htmx half. An <a>, since a <button> has no no-JS destination.
templ newDesignSessionAction(bladePath string) {
	<a href={ templ.URL(bladePath) }
		class="btn btn-primary btn-sm"
		data-krill="design-sessions-new"
		hx-get={ templ.URL(bladePath) }
		hx-target={ "#" + DesignSessionNewBladeAnchor }
		hx-swap="outerHTML"
		hx-push-url="true">
		New design session
	</a>
}

// NewDesignSessionBlade is the blade region: empty or open, always carrying
// DesignSessionNewBladeAnchor so the list action's hx-target resolves either way.
templ NewDesignSessionBlade(blade *DesignSessionNewBlade) {
	<div id={ DesignSessionNewBladeAnchor } data-krill="design-session-new-blade">
		if blade != nil {
			@newDesignSessionBladeBody(*blade)
		}
	</div>
}

// newDesignSessionBladeBody is the open blade. method+action is the no-JS path (303 to the
// session), hx-post the htmx path (HX-Redirect); both target the blade region so a refusal
// re-renders it. One input only: product comes from the URL, identity from the sign-in.
templ newDesignSessionBladeBody(blade DesignSessionNewBlade) {
	<article class="card bg-base-100 border border-base-300 shadow-sm" data-krill="design-session-new-blade-body">
		<div class="card-body gap-3">
			<h2 class="card-title text-lg" data-krill="design-session-new-title">New design session</h2>
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-sm text-base-content/70">Product</span>
				if blade.ProductName != "" {
					@htmxui.Badge(blade.ProductName, htmxui.BadgeNeutral, htmxui.BadgeSizeSM, false, templ.Attributes{
						"data-krill": "design-session-new-product",
					})
				}
			</div>
			<form
				id="design-session-new-form"
				method="post"
				action={ templ.URL(blade.FormAction) }
				hx-post={ blade.FormAction }
				hx-target={ "#" + DesignSessionNewBladeAnchor }
				hx-swap="outerHTML"
			>
				if blade.Error != "" {
					@htmxui.Alert(htmxui.AlertError, "Not saved: "+blade.Error, nil)
				}
				<p>
					<label class="label" for="design-session-new-submission">What should be designed?</label>
					<textarea id="design-session-new-submission" name="opening_submission" rows="5" required
						placeholder="Describe the feature or change in a few sentences"
						class="textarea textarea-bordered w-full">{ blade.OpeningSubmission }</textarea>
				</p>
				<div class="flex flex-wrap justify-end gap-2">
					<a href={ templ.URL(blade.ListPath) } class="btn btn-ghost" data-krill="design-session-new-cancel">Cancel</a>
					@htmxui.Button(htmxui.ButtonPrimary, htmxui.ButtonSizeMD, false, templ.Attributes{
						"type": "submit",
						"data-krill": "design-session-new-submit",
					}) {
						Open session
					}
				</div>
			</form>
		</div>
	</article>
}

// designSessionDetailRegions are the stable ids the two columns carry, for tests.
const (
	designSessionDetailAnchor    = "design-session-detail"
	designSessionEventsAnchor     = "revision-events"
	designSessionQuestionsAnchor  = "open-questions"
	designSessionPropertiesAnchor = "session-properties"
)

// DesignSessionRoundAnchor is the one region a follow-up re-derives and swaps: timeline, open
// questions and form, since an answer changes all three. Swapping the form alone would leave
// stale state and drop ticked questions on refusal.
const DesignSessionRoundAnchor = "design-session-round"

// DesignSessionCrumb is one breadcrumb entry; Href is empty for the current page.
type DesignSessionCrumb struct {
	Label string
	Href  string
}

// DesignSessionDetail is one session in two columns: opening statement and log in main, questions
// and properties in the rail. No input anywhere lets an operator claim another identity.
templ DesignSessionDetail(page DesignSessionDetailPage) {
	<section id={ designSessionDetailAnchor } class="space-y-4">
		@designSessionDetailCrumbs(page)
		<div class="flex flex-wrap items-center gap-3">
			<h1 class="text-2xl font-semibold" data-krill="design-session-title">{ page.OpeningRequest }</h1>
			@designSessionStageBadge(page.Stage)
		</div>
		@DesignSessionRound(page)
		<p id="session-nav" class="text-sm">
			<a href={ templ.URL(page.ProductSessionsPath) } class="link">Back to this product's sessions</a>
		</p>
	</section>
}

// DesignSessionRound is everything one follow-up round changes: log, open questions, and form.
// The header stays outside it. A signed-off session renders no form, but the region id stays.
templ DesignSessionRound(page DesignSessionDetailPage) {
	<section id={ DesignSessionRoundAnchor } class="space-y-4">
		<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
			<div class="min-w-0 space-y-4">
				<section id="session-opening" class="card bg-base-100 border border-base-300">
					<div class="card-body gap-2">
						<h2 class="card-title">Opening request</h2>
						<div class="krill-md">
							@templ.Raw(renderMarkdown(page.OpeningSubmission))
						</div>
					</div>
				</section>
				@designSessionEventsRegion(page)
				if !page.SignedOff {
					<div class="card bg-base-100 border border-base-300">
						<div class="card-body gap-3">
							<h2 class="card-title">Follow up</h2>
							<p class="text-sm text-base-content/70">Answer in plain language. krill records this as an <code>answer</code> round on this session; it does not create or change any spec entity here. Tick any open question your answer closes.</p>
							@FollowUpForm(page)
						</div>
					</div>
				} else {
					<p class="alert alert-success" data-krill="design-session-signed-off">
						This session is signed off. Its latest signoff is approved, so it takes no further rounds -- open a new session if the design needs to move again.
					</p>
				}
			</div>
			<aside class="space-y-4">
				@designSessionQuestionsRegion(page)
				@designSessionPropertiesCard(page)
			</aside>
		</div>
	</section>
}

// designSessionDetailCrumbs is product, Design sessions list, then this session by its
// opening request (the same string the list links by).
templ designSessionDetailCrumbs(page DesignSessionDetailPage) {
	<nav class="breadcrumbs text-sm" aria-label="Breadcrumb" data-krill="design-session-breadcrumb">
		<ul>
			for _, c := range designSessionCrumbs(page) {
				<li data-krill="breadcrumb-crumb">
					if c.Href == "" {
						<span>{ c.Label }</span>
					} else {
						<a href={ templ.URL(c.Href) }>{ c.Label }</a>
					}
				</li>
			}
		</ul>
	</nav>
}

// designSessionCrumbs assembles the trail; only the current session is unlinked. An unreadable
// product name contributes no crumb rather than a blank link.
func designSessionCrumbs(page DesignSessionDetailPage) []DesignSessionCrumb {
	var crumbs []DesignSessionCrumb
	if page.ProductName != "" {
		crumbs = append(crumbs, DesignSessionCrumb{Label: page.ProductName, Href: page.ProductOverviewPath})
	}
	return append(crumbs,
		DesignSessionCrumb{Label: "Design sessions", Href: page.ProductSessionsPath},
		DesignSessionCrumb{Label: page.OpeningRequest},
	)
}

// designSessionEventsRegion is the session's log. A failed read and an empty log must render
// differently.
templ designSessionEventsRegion(page DesignSessionDetailPage) {
	<section id={ designSessionEventsAnchor } class="card bg-base-100 border border-base-300">
		<div class="card-body gap-3">
		<h2 class="card-title">Revision events</h2>
		if page.LogError != "" {
			@htmxui.Alert(htmxui.AlertError, page.LogError, templ.Attributes{
				"data-krill": "revision-events-error",
			})
		} else if len(page.Events) > 0 {
			@revisionEventTimeline(page.Events)
		} else {
			<p class="text-sm text-base-content/70" data-krill="revision-events-empty">No revision events yet.</p>
		}
		</div>
	</section>
}

// revisionEventTimeline is the log as a daisyUI timeline in ascending seq_no, the same order
// get_design_session returns. An <ol> because order is content.
templ revisionEventTimeline(events []RevisionEventRow) {
	<ol class="timeline timeline-vertical timeline-compact timeline-snap-icon" data-krill="revision-event-timeline">
		for i, ev := range events {
			@revisionEvent(ev, i > 0)
		}
	</ol>
}

// designSessionQuestionsRegion is the rail's open-questions card; a failed read is an alert,
// never an empty card.
templ designSessionQuestionsRegion(page DesignSessionDetailPage) {
	<section id={ designSessionQuestionsAnchor } class="card bg-base-100 border border-base-300">
		<div class="card-body gap-3 p-4 text-sm">
		<h2 class="font-semibold">Open questions</h2>
		if page.QuestionsError != "" {
			@htmxui.Alert(htmxui.AlertError, page.QuestionsError, templ.Attributes{
				"data-krill": "open-questions-error",
			})
		} else {
			@designSessionQuestionList(page)
		}
		</div>
	</section>
}

// designSessionQuestionList is one entry per currently-open question, or an empty state. The list
// is the store's last-event-wins ListOpenQuestions, so resolved questions are already absent.
templ designSessionQuestionList(page DesignSessionDetailPage) {
	if len(page.OpenQuestions) > 0 {
		<ul class="space-y-3">
			for _, q := range page.OpenQuestions {
				@openQuestionEntry(q, page.IsChecked(q.QuestionID))
			}
		</ul>
	} else {
		@htmxui.EmptyState("No open questions.", "Nothing is waiting on an answer.", "", "",
			templ.Attributes{"data-krill": "open-questions-empty"})
	}
}

// openQuestionEntry is one open question with a resolve box. checked comes from the page so a
// refused round keeps ticks. The box joins the follow-up form via the `form` attribute.
templ openQuestionEntry(q OpenQuestionRow, checked bool) {
	<label class="flex gap-2" data-krill="open-question-row" data-krill-question-id={ q.QuestionID }>
		<input
			type="checkbox"
			name="resolve"
			value={ q.QuestionID }
			form={ FollowUpFormAnchor }
			checked?={ checked }
			class="checkbox checkbox-sm mt-0.5"
			data-krill="open-question-resolve"
		/>
		<span class="space-y-1">
			@questionBlockingBadge(q.Blocking)
			<span class="block text-sm">{ q.Text }</span>
		</span>
	</label>
}

// questionBlockingBadge is a question's severity, via the same mapper as the sessions table's
// blocking count.
templ questionBlockingBadge(blocking string) {
	{{ s := components.QuestionBlockingStyle(blocking) }}
	@htmxui.Badge(components.QuestionBlockingLabel(blocking), s.Variant, s.Size, s.Soft, templ.Attributes{
		"data-krill": "question-blocking",
	})
}

// designSessionEventTypeBadge is a round's kind, via the round vocabulary's one mapper.
templ designSessionEventTypeBadge(eventType string) {
	{{ s := components.DesignSessionEventTypeStyle(eventType) }}
	@htmxui.Badge(components.DesignSessionEventTypeLabel(eventType), s.Variant, s.Size, s.Soft, templ.Attributes{
		"data-krill": "design-session-event-type",
	})
}

// designSessionPropertiesCard shows who opened the session and its id. The shared copy chip
// carries page.ID (the design session), never the krill session, which gets its own row.
// No "Opened by" input is offered when the subject cannot be read.
templ designSessionPropertiesCard(page DesignSessionDetailPage) {
	<section id={ designSessionPropertiesAnchor } class="card bg-base-100 border border-base-300">
		<div class="card-body gap-3 p-4 text-sm">
		<h2 class="font-semibold">Properties</h2>
		<dl class="grid grid-cols-1 gap-x-6 gap-y-2">
			if page.OpenedBy != "" {
				<div>
					<dt class="text-base-content/70">Opened by</dt>
					<dd data-krill="design-session-opened-by" title={ page.OpenedByTitle }>{ page.OpenedBy }</dd>
				</div>
			}
			<div>
				<dt class="text-base-content/70">Design session</dt>
				<dd data-krill="design-session-id">
					// Disabled until the head script binds it; it sits in a <dd> because that is where the
					// shared script looks. Carries page.ID, the id the URL addresses.
					<button type="button" class="badge badge-ghost font-mono disabled:opacity-50"
						aria-label="Copy design session id" data-krill="copy-task-id"
						data-task-id={ page.ID }
						disabled title="Copying the id needs JavaScript">
						{ idChipText(page.ID) }
					</button>
					<span class="ml-2 text-xs" data-krill="copy-task-id-status" role="status" aria-live="polite"></span>
				</dd>
			</div>
			if page.OpenedByKrillSessionID != "" {
				// The krill session the design session was opened through, as its own row; rendered even
				// when "Opened by" is absent, since the design_session row always holds it.
				<div>
					<dt class="text-base-content/70">Krill session</dt>
					<dd class="font-mono text-xs break-all" data-krill="design-session-opened-by-krill-session">{ page.OpenedByKrillSessionID }</dd>
				</div>
			}
		</dl>
		</div>
	</section>
}

// idChipText is an id chip's text: a UUID's first eight characters (or the whole value if
// shorter); the full value stays in data-task-id, the title and the clipboard.
func idChipText(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}

// revisionEvent is one round as a timeline entry: kind, actor, age, and summary. The first
// round has no connector above it. The detail disclosure keeps event id and verified_against
// rendered, as they are compared against get_design_session's wire.
templ revisionEvent(ev RevisionEventRow, connector bool) {
	<li class="grid-cols-[0_auto_minmax(0,1fr)]" data-krill="revision-event" data-krill-seq-no={ itoa(ev.SeqNo) } data-krill-event-type={ ev.EventType }>
		if connector {
			<hr/>
		}
		<div class="timeline-middle">
			@revisionEventNode(ev.EventType)
		</div>
		<div class="timeline-end timeline-box w-full" data-krill="revision-event-box">
			<div class="flex flex-wrap items-center gap-2">
				@designSessionEventTypeBadge(ev.EventType)
				<span class="font-medium text-sm" data-krill="revision-event-acting">{ ev.Acting }</span>
				if ev.OnBehalfOfDiffers {
					<span class="text-sm text-base-content/70" data-krill="revision-event-on-behalf-of">on behalf of { ev.OnBehalfOf }</span>
				}
				@revisionEventAt(ev)
			</div>
			<p class="mt-1 text-sm" data-krill="revision-event-summary">{ ev.Summary }</p>
			@revisionEventDetail(ev)
		</div>
	</li>
}

// revisionEventNode is the spine node: an unlabelled badge in the round's colour via the same
// mapper as the labelled badge. aria-hidden since it adds nothing for screen readers.
templ revisionEventNode(eventType string) {
	{{ s := components.DesignSessionEventTypeStyle(eventType) }}
	@htmxui.Badge("", s.Variant, htmxui.BadgeSizeXS, s.Soft, templ.Attributes{
		"data-krill": "revision-event-node",
		"aria-hidden": "true",
	})
}

// revisionEventAt renders a round's relative age as text with the exact instant in datetime,
// title and data-krill-updated-at.
templ revisionEventAt(ev RevisionEventRow) {
	<time class="text-sm text-base-content/70" data-krill="revision-event-at"
		data-krill-updated-at={ ev.AtExact } datetime={ ev.AtExact } title={ ev.AtExact }>{ ev.AtRelative }</time>
}

// revisionEventDetail is a disclosure with the round's changes and API identifiers, kept apart
// from the scannable summary.
templ revisionEventDetail(ev RevisionEventRow) {
	<details class="collapse collapse-arrow mt-2" data-krill="revision-event-detail">
		<summary class="collapse-title min-h-0 py-1 text-xs text-base-content/70">Round detail</summary>
		<div class="collapse-content space-y-2 text-xs">
			<dl class="grid grid-cols-1 gap-x-4">
				<div>
					<dt class="text-base-content/70">Event id</dt>
					<dd><code data-krill="revision-event-id">{ ev.ID }</code></dd>
				</div>
				if ev.VerifiedAgainst != "" {
					<div>
						<dt class="text-base-content/70">Verified against</dt>
						<dd data-krill="revision-event-verified-against">{ ev.VerifiedAgainst }</dd>
					</div>
				}
				if ev.SignoffStatus != "" {
					<div>
						<dt class="text-base-content/70">Signoff</dt>
						<dd data-krill="revision-event-signoff">{ ev.SignoffStatus }</dd>
					</div>
				}
				<div>
					<dt class="text-base-content/70">Recorded</dt>
					<dd data-krill="revision-event-recorded-at">{ ev.CreatedAt }</dd>
				</div>
			</dl>
			if len(ev.EntityDeltas) > 0 {
				<div>
					<p class="text-base-content/70">Entity changes</p>
					<ul>
						for _, d := range ev.EntityDeltas {
							<li>{ d.Change } <code>{ d.EntityID }</code> — { d.SummaryLine }</li>
						}
					</ul>
				</div>
			}
			if len(ev.OpenedQuestions) > 0 {
				<div>
					<p class="text-base-content/70">Opened questions</p>
					<ul>
						for _, q := range ev.OpenedQuestions {
							<li><code>{ q.QuestionID }</code> ({ q.Blocking }): { q.Text }</li>
						}
					</ul>
				</div>
			}
			if len(ev.ResolvedQuestions) > 0 {
				<div>
					<p class="text-base-content/70">Resolved questions</p>
					<p>
						for _, qid := range ev.ResolvedQuestions {
							<code>{ qid }</code>
						}
					</p>
				</div>
			}
		</div>
	</details>
}

// FollowUpForm is the "submit follow-up" form: method+action for no-JS (303), hx-post for htmx.
// It swaps DesignSessionRoundAnchor, not itself. Resolve boxes live in the rail via `form`. The
// textarea is optional: an empty round is refused server-side (renderAnswerFormFailure).
templ FollowUpForm(page DesignSessionDetailPage) {
	<form
		id={ FollowUpFormAnchor }
		data-krill="design-session-follow-up-form"
		method="post"
		action={ templ.URL(page.AnswersPath) }
		hx-post={ page.AnswersPath }
		hx-target={ "#" + DesignSessionRoundAnchor }
		hx-swap="outerHTML"
	>
		if page.Error != "" {
			@htmxui.Alert(htmxui.AlertError, "Not saved: "+page.Error, templ.Attributes{
				"data-krill": "design-session-follow-up-error",
			})
		}
		if len(page.OpenQuestions) == 0 && len(page.CheckedResolve) > 0 {
			// Questions could not be re-read, so carry the ticked ids as hidden inputs to preserve them.
			<fieldset class="fieldset" data-krill="degraded-resolve">
				<legend class="fieldset-legend">Still selected (this session's open questions could not be reloaded)</legend>
				for qid := range page.CheckedResolve {
					<input type="hidden" name="resolve" value={ qid }/>
				}
			</fieldset>
		}
		<label class="sr-only" for="follow-up">Your follow-up</label>
		<textarea id="follow-up" name="follow_up" rows="4" placeholder="It should use the postgres flag table." class="textarea w-full">{ page.FollowUp }</textarea>
		<div class="mt-3 flex justify-end"><button type="submit" class="btn btn-primary">Submit follow-up</button></div>
	</form>
}

// itoa keeps the #seq_no / #opened-at rendering free of a strconv import
// in the generated file for one call each.
func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var buf [20]byte
	i := len(buf)
	for n > 0 {
		i--
		buf[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		buf[i] = '-'
	}
	return string(buf[i:])
}
