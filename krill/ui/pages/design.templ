package pages

import (
	"github.com/whale-net/everything/krill/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// The design-session read surface, as page bodies. The pure builders that
// populate the view models below stay in //krill/ui (package main) so the
// package-main tests keep compiling unchanged; only the markup moved here.
//
// Every region that a test needs to isolate carries a stable id
// (design-sessions, revision-events, open-questions, session-nav). A test
// slices on those ids rather than on a heading's literal markup, so
// restyling a heading can never break a section-scoped assertion --
// htmxui ARCHITECTURE §14: assert the claim, not the byte layout.

// DesignSessionRow is one row of a product's session list.
//
// Stage is the store's own derived stage (store.Stage, spelled as a string
// so this package keeps no //krill/store dependency) rather than a
// re-derivation from a signoff flag: the aggregate read owns that
// derivation, and a view computing a second one is how a list and a detail
// come to disagree about what stage a session is in. The badge resolves it
// through components.DesignSessionStageStyle/Label.
//
// OpenedRelative is the age an operator scans for and OpenedExact the
// instant behind it, both handed over pre-rendered for the reason the
// status register's rows are: relative text needs a clock, and a view that
// reads one cannot be asserted on.
type DesignSessionRow struct {
	// ID is the session's own id, carried so the row is addressable and so
	// a detail link can be checked against it.
	ID string

	// OpeningRequest is the opening submission's FIRST LINE, which is what
	// the list shows; the full submission is the detail page's subject.
	OpeningRequest string

	// DetailPath is the canonical, product-scoped detail URL (FR a77852a9).
	DetailPath string

	// Stage is the derived stage's wire value.
	Stage string

	// OpenBlockingQuestions is the session's currently-open BLOCKING
	// question count. The non-blocking count is deliberately not shown
	// here: it is on the detail page's rail, where a question's text is,
	// and a number here would be an action with nowhere to go.
	OpenBlockingQuestions int

	OpenedRelative string
	OpenedExact    string
}

// DesignSessionListPage is the product-scoped session list. Error and
// OpeningSubmission are set only when an "open a session" submission is
// rejected and the form is re-rendered: Error is the readable api status +
// message shown inline, and OpeningSubmission is the operator's typed text,
// preserved so a rejection is not a data-loss event.
//
// FormAction is the open form's own POST target, supplied by the caller so
// the path shape stays owned by package main's designProductSessionsPath
// rather than being rebuilt here. Path is this list's own URL, which the
// empty state's action points at until the new-session blade takes over.
type DesignSessionListPage struct {
	ProductID         string
	ProductName       string
	Path              string
	Sessions          []DesignSessionRow
	Error             string
	OpeningSubmission string
	FormAction        string
}

// EntityDeltaRow is one spec entity a revision event touched.
type EntityDeltaRow struct {
	EntityID    string
	Change      string
	SummaryLine string
}

// OpenQuestionDeltaRow is one question a revision event opened.
type OpenQuestionDeltaRow struct {
	QuestionID string
	Text       string
	Blocking   string // "blocking" or "non-blocking"
}

// RevisionEventRow is one round of a session's ordered log.
type RevisionEventRow struct {
	ID                string
	SeqNo             int
	EventType         string
	Acting            string
	OnBehalfOf        string
	VerifiedAgainst   string
	SignoffStatus     string
	CreatedAt         string
	EntityDeltas      []EntityDeltaRow
	OpenedQuestions   []OpenQuestionDeltaRow
	ResolvedQuestions []string
}

// OpenQuestionRow is one currently-open question, tagged blocking or
// non-blocking exactly as list_open_questions tags it.
type OpenQuestionRow struct {
	QuestionID    string
	Text          string
	Blocking      string // "blocking" or "non-blocking"
	OpenedAtSeqNo int
}

// DesignSessionDetailPage is one session: its row, its full ordered
// revision-event log, and its currently-open questions. Error, FollowUp,
// and CheckedResolve are set only when a "submit follow-up" round is
// rejected and the form is re-rendered: Error is the readable api status +
// message, FollowUp is the operator's typed text, and CheckedResolve holds
// the question ids whose resolve box was ticked, all preserved so a
// rejection is not a data-loss event.
//
// AnswersPath is the follow-up form's own POST target, supplied by the
// caller so the path shape stays owned by package main.
//
// OpeningRequest is the opening submission's FIRST LINE -- the same string
// the sessions list links by, so the two pages agree on what this session
// is called -- while OpeningSubmission is the full prose, rendered as
// markdown in the main column because this page is the only place it is
// readable in full.
//
// Stage is the store's own derived stage, spelled as a string, exactly as
// DesignSessionRow.Stage is: the badge beside the h1 resolves through the
// same components mapper the list's Stage cell uses, so the two cannot
// render one session's stage two different ways.
//
// OpenedBy is the operator's subject -- what the server read, never what a
// reader typed (LB4) -- and OpenedByTitle the full (subject, issuer) pair
// for the title attribute. Both are empty when the krill_session row could
// not be read, which is rendered as an absent "Opened by" line rather than
// a blank or invented one.
type DesignSessionDetailPage struct {
	ID                     string
	ProductID              string
	ProductName            string
	ProductOverviewPath    string
	OpeningRequest         string
	OpeningSubmission      string
	Stage                  string
	OpenedBy               string
	OpenedByTitle          string
	OpenedByKrillSessionID string
	CreatedAt              string
	ProductSessionsPath    string
	Events                 []RevisionEventRow
	OpenQuestions          []OpenQuestionRow
	Error                  string
	FollowUp               string
	CheckedResolve         map[string]bool
	AnswersPath            string
}

// IsChecked reports whether a resolve box for the given question id was
// ticked, so a rejected follow-up round re-renders the form with the
// operator's original ticks intact. A nil CheckedResolve reads every id as
// unticked, which is the GET handler's normal case.
func (p DesignSessionDetailPage) IsChecked(id string) bool { return p.CheckedResolve[id] }

// designSessionListAnchor is the DOM id this page's region carries, so a
// test -- and the empty state's own action -- name one element rather than
// a heading's markup.
const designSessionListAnchor = "design-sessions"

// designSessionStageBadge renders one row's stage. The colour, size and
// soft treatment come from components.DesignSessionStageStyle and the
// wording from components.DesignSessionStageLabel, so this file knows no
// daisyUI class and the stage vocabulary has exactly one owner -- the same
// chain statusBadge runs for the milestone statuses.
templ designSessionStageBadge(stage string) {
	{{ s := components.DesignSessionStageStyle(stage) }}
	@htmxui.Badge(components.DesignSessionStageLabel(stage), s.Variant, s.Size, s.Soft, templ.Attributes{
		"data-krill": "design-session-stage",
	})
}

// designSessionBlockingCell renders the Open questions cell: the error
// "N blocking" badge when the session owes at least one blocking answer,
// and a plain 0 when it owes none.
//
// The two are different answers and never share a branch -- "one blocking
// question is waiting" and "nothing is owed" are different facts, and
// rendering the second with a badge would put a page with nothing to do in
// the same visual register as one an operator is being held up by. The
// badge's colour comes from components.DesignSessionBlockingCountStyle so
// this cell has no daisyUI class of its own.
templ designSessionBlockingCell(s DesignSessionRow) {
	if s.OpenBlockingQuestions > 0 {
		{{ style := components.DesignSessionBlockingCountStyle() }}
		@htmxui.Badge(itoa(s.OpenBlockingQuestions)+" blocking", style.Variant, style.Size, style.Soft, templ.Attributes{
			"data-krill": "design-session-blocking",
		})
	} else {
		<span class="text-sm text-base-content/70" data-krill="design-session-blocking-none">0</span>
	}
}

// designSessionOpenedAt renders one row's opening instant: the relative age
// as the visible text, the exact instant in the datetime and the title so
// hovering answers "exactly when", and the data-krill-updated-at hook the
// status register and the task detail's Escalated row share.
//
// Relative is what renders server-side, so the page says something
// readable with the head script absent; the exact instant is in the title
// either way.
templ designSessionOpenedAt(s DesignSessionRow) {
	<time class="text-sm text-base-content/70" data-krill="design-session-opened-at"
		data-krill-updated-at={ s.OpenedExact } datetime={ s.OpenedExact } title={ s.OpenedExact }>{ s.OpenedRelative }</time>
}

// DesignSessionList is the product's session table: every session of the
// product newest-first, with its derived stage and its open blocking
// question count.
//
// The primary action is still the inline OpenSessionForm below the header,
// not a link to a new-session blade: the blade is the next task's page
// (FR 44d7f1e2), and this page renders before it lands rather than after.
// It is here for the same reason the empty state's action points at it --
// there is exactly one way to open a session today, and this is it.
//
// The empty state points its action at the form's own id rather than at a
// blade URL that does not resolve yet: an action whose destination 404s is
// worse than one that scrolls to the control standing right above it.
templ DesignSessionList(page DesignSessionListPage) {
	<section id={ designSessionListAnchor } class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-semibold" data-krill="page-title">Design sessions</h1>
		</div>
		<p class="text-sm text-base-content/70">
			{ page.ProductName } — every design session, most recently opened first.
		</p>
		@OpenSessionForm(page)
		if len(page.Sessions) > 0 {
			<div class="overflow-x-auto rounded-lg border border-base-300 bg-base-100">
				<table class="table table-zebra" data-krill="design-session-table">
					<thead>
						<tr>
							<th>Opening request</th>
							<th>Stage</th>
							<th class="text-right">Open questions</th>
							<th>Opened</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range page.Sessions {
							<tr class="hover" data-krill="design-session-row" data-krill-design-session-id={ s.ID }>
								<td>
									<a href={ templ.URL(s.DetailPath) } class="link font-medium" data-krill="design-session-opening-request">{ s.OpeningRequest }</a>
								</td>
								<td>@designSessionStageBadge(s.Stage)</td>
								<td class="text-right">@designSessionBlockingCell(s)</td>
								<td>@designSessionOpenedAt(s)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@htmxui.EmptyState("No design sessions for this product yet.", "Open one above to start a design conversation.",
				"New design session", "#open-session-form", templ.Attributes{"data-krill": "design-sessions-empty"})
		}
	</section>
}

// OpenSessionForm is the "open a design session" form, and the hx-post
// swap target for it.
//
// The form is doubled (htmxui ARCHITECTURE §9: the <form> element and its
// hx-* wiring stay app-owned): method+action is the no-JS path, which
// answers 303 to the new session's detail page, and hx-post+hx-target+
// hx-swap is the htmx path, which answers HX-Redirect to that same page.
//
// That doubling is the payoff: the no-HX half is byte-for-byte the form
// this page has always rendered, so the eight 303 + Location assertions in
// design_write_test.go keep passing verbatim while the HX half is new.
// A refusal answers 200 with this same fragment carrying Error inline and
// the operator's typed text preserved, so a rejection is never a
// data-loss event and never a status code the swap target cannot render.
templ OpenSessionForm(page DesignSessionListPage) {
	<form
		id="open-session-form"
		method="post"
		action={ templ.URL(page.FormAction) }
		hx-post={ page.FormAction }
		hx-target="#open-session-form"
		hx-swap="outerHTML"
	>
		if page.Error != "" {
			@htmxui.Alert(htmxui.AlertError, "Not saved: "+page.Error, nil)
		}
		<p>
			<label class="label" for="opening-submission">Your idea or user story</label>
			<textarea id="opening-submission" name="opening_submission" rows="4" required placeholder="Users need to bulk-export their data as CSV" class="textarea textarea-bordered w-full max-w-2xl">{ page.OpeningSubmission }</textarea>
		</p>
		<p><button type="submit" class="btn btn-primary">Open design session</button></p>
	</form>
}

// designSessionDetailRegions are the stable ids the two columns carry.
// Tests slice on these rather than on a heading's markup, so restyling a
// card never breaks a section-scoped assertion (htmxui ARCHITECTURE §14).
const (
	designSessionDetailAnchor     = "design-session-detail"
	designSessionEventsAnchor      = "revision-events"
	designSessionQuestionsAnchor   = "open-questions"
	designSessionPropertiesAnchor  = "session-properties"
)

// DesignSessionCrumb is one breadcrumb entry on the session detail. Href is
// empty for the session's own title -- the page the reader is already on,
// and so the one crumb that is not a link.
type DesignSessionCrumb struct {
	Label string
	Href  string
}

// DesignSessionDetail is one session: its opening statement, its full
// ordered revision-event log, and its currently-open questions.
//
// The shape is the wireframe's two columns -- a main column that reads
// (opening statement, then the log) and a rail that keeps the questions and
// the properties beside it -- and the regions inside them carry the stable
// ids the tests slice on. What goes in each region is deliberately this
// page's existing markup: the log and the question table move wholesale
// into their new homes rather than being rewritten, so this page's
// structure can merge without also renegotiating its contents.
//
// Nothing here asks for an identity. The properties card shows who the
// server read, and there is no input anywhere on the page for an operator
// to say they are someone else (LB4).
templ DesignSessionDetail(page DesignSessionDetailPage) {
	<section id={ designSessionDetailAnchor } class="space-y-4">
		@designSessionDetailCrumbs(page)
		<div class="flex flex-wrap items-center gap-3">
			<h1 class="text-2xl font-semibold" data-krill="design-session-title">{ page.OpeningRequest }</h1>
			@designSessionStageBadge(page.Stage)
		</div>
		<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
			<div class="min-w-0 space-y-4">
				<section id="session-opening" class="krill-md">
					@templ.Raw(renderMarkdown(page.OpeningSubmission))
				</section>
				@designSessionEventsRegion(page)
			</div>
			<aside class="space-y-4">
				@designSessionQuestionsRegion(page)
				@designSessionPropertiesCard(page)
			</aside>
		</div>
		<p id="session-nav">
			<a href={ templ.URL(page.ProductSessionsPath) }>Back to this product's sessions</a>
		</p>
		<h3>Submit follow-up</h3>
		<p>Answer in plain language. krill records this as an <code>answer</code> round on this session; it does not create or change any spec entity here. Tick any open question your answer closes.</p>
		@FollowUpForm(page)
	</section>
}

// designSessionDetailCrumbs is where the operator has been: the product,
// its Design sessions list, and then this session -- named by its own
// opening request, the same string the list links by, so the trail reads
// as the list's own row expanded.
templ designSessionDetailCrumbs(page DesignSessionDetailPage) {
	<nav class="breadcrumbs text-sm" aria-label="Breadcrumb" data-krill="design-session-breadcrumb">
		<ul>
			for _, c := range designSessionCrumbs(page) {
				<li data-krill="breadcrumb-crumb">
					if c.Href == "" {
						<span>{ c.Label }</span>
					} else {
						<a href={ templ.URL(c.Href) }>{ c.Label }</a>
					}
				</li>
			}
		</ul>
	</nav>
}

// designSessionCrumbs assembles the trail. The product crumb and the list
// crumb are links; the session's own title is not, because it is where the
// reader already is.
//
// A product whose name could not be read contributes no crumb rather than
// an empty one: a blank link in a breadcrumb looks like a rendering fault
// and navigates nowhere useful, while its absence leaves the list crumb,
// which is the one that navigates.
func designSessionCrumbs(page DesignSessionDetailPage) []DesignSessionCrumb {
	var crumbs []DesignSessionCrumb
	if page.ProductName != "" {
		crumbs = append(crumbs, DesignSessionCrumb{Label: page.ProductName, Href: page.ProductOverviewPath})
	}
	return append(crumbs,
		DesignSessionCrumb{Label: "Design sessions", Href: page.ProductSessionsPath},
		DesignSessionCrumb{Label: page.OpeningRequest},
	)
}

// designSessionEventsRegion is the session's ordered log, in the main
// column.
templ designSessionEventsRegion(page DesignSessionDetailPage) {
	<section id={ designSessionEventsAnchor }>
		<h3>Revision events</h3>
		if len(page.Events) > 0 {
			<ol class="space-y-3">
				for _, ev := range page.Events {
					@revisionEvent(ev)
				}
			</ol>
		} else {
			<p>No revision events yet.</p>
		}
	</section>
}

// designSessionQuestionsRegion is the rail's open-questions card, holding
// the question table this page has always shown.
templ designSessionQuestionsRegion(page DesignSessionDetailPage) {
	<section id={ designSessionQuestionsAnchor }>
		<h3>Open questions</h3>
		if len(page.OpenQuestions) > 0 {
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Question</th>
						<th>Tag</th>
						<th>Opened at</th>
					</tr>
				</thead>
				<tbody>
					for _, q := range page.OpenQuestions {
						<tr>
							<td><code>{ q.QuestionID }</code> — { q.Text }</td>
							<td>{ q.Blocking }</td>
							<td>#{ itoa(q.OpenedAtSeqNo) }</td>
						</tr>
					}
				</tbody>
			</table>
		} else {
			<p>No open questions.</p>
		}
	</section>
}

// designSessionPropertiesCard is the rail's properties card: who opened the
// session, and the krill session it was opened through.
//
// The id is the copy chip the whole app shares -- same data-krill hook, same
// data attribute, same head script -- so the clipboard behaviour is the one
// already in use on the task detail, the milestone detail and the spec
// blade. The chip shows the first eight characters with the whole value on
// hover and in the clipboard, which is what a UUID read at a glance needs.
//
// A session whose krill_session row could not be read shows the id chip and
// NO "Opened by" line. The card does not offer an input to supply one: the
// page's subject is a recorded conversation, and letting an operator type
// an identity into it would put a name on a session nobody typed it for
// (LB4).
templ designSessionPropertiesCard(page DesignSessionDetailPage) {
	<section id={ designSessionPropertiesAnchor }>
		<h3>Properties</h3>
		<dl class="grid grid-cols-1 gap-x-6 gap-y-2">
			if page.OpenedBy != "" {
				<div>
					<dt class="text-base-content/70">Opened by</dt>
					<dd data-krill="design-session-opened-by" title={ page.OpenedByTitle }>{ page.OpenedBy }</dd>
				</div>
			}
			<div>
				<dt class="text-base-content/70">Krill session</dt>
				<dd data-krill="design-session-id">
					// The app's own id chip: disabled until the head script
					// binds it, so a control that cannot work never looks
					// live. It sits in a <dd> because that is the scope the
					// shared script looks in.
					<button type="button" class="badge badge-ghost font-mono disabled:opacity-50"
						aria-label="Copy design session id" data-krill="copy-task-id"
						data-task-id={ page.OpenedByKrillSessionID }
						disabled title="Copying the id needs JavaScript">
						{ sessionChipText(page.OpenedByKrillSessionID) }
					</button>
					<span class="ml-2 text-xs" data-krill="copy-task-id-status" role="status" aria-live="polite"></span>
				</dd>
			</div>
		</dl>
	</section>
}

// sessionChipText is what the chip shows: the first eight characters of a
// UUID, or the whole value when it is shorter (which only a malformed id
// ever is). Truncated because a full 36-character id is unreadable at chip
// size; the whole value stays in data-task-id, in the title the script sets,
// and in what the clipboard receives.
func sessionChipText(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}

// revisionEvent is one round of the session's ordered log. The #seq type
// header, the acting/on-behalf-of meta, and the delta/opened-question
// list items are the specific claims design_page_test.go parses, so their
// text -- not their classes -- is what is load-bearing here.
templ revisionEvent(ev RevisionEventRow) {
	<li>
		<strong>#{ itoa(ev.SeqNo) } { ev.EventType }</strong>
		if ev.SignoffStatus != "" {
			{ " — signoff: " }
			{ ev.SignoffStatus }
		}
		<br>
		<small>acting: { ev.Acting } · on behalf of: { ev.OnBehalfOf } · { ev.CreatedAt }</small>
		<br>
		<small>event id: <code>{ ev.ID }</code></small>
		if ev.VerifiedAgainst != "" {
			<br>
			<small>verified against: { ev.VerifiedAgainst }</small>
		}
		if len(ev.EntityDeltas) > 0 {
			<ul>
				for _, d := range ev.EntityDeltas {
					<li>{ d.Change } <code>{ d.EntityID }</code> — { d.SummaryLine }</li>
				}
			</ul>
		}
		if len(ev.OpenedQuestions) > 0 {
			<p>Opened questions:</p>
			<ul>
				for _, q := range ev.OpenedQuestions {
					<li><code>{ q.QuestionID }</code> ({ q.Blocking }): { q.Text }</li>
				}
			</ul>
		}
		if len(ev.ResolvedQuestions) > 0 {
			<p>Resolved questions:
				for _, qid := range ev.ResolvedQuestions {
					<code>{ qid }</code>
				}
			</p>
		}
	</li>
}

// FollowUpForm is the "submit follow-up" form, and the hx-post swap target
// for it -- doubled exactly as OpenSessionForm is: method+action is the
// no-JS path (303 back to this session's detail page), hx-post+hx-target+
// hx-swap is the htmx path (HX-Redirect to the same page, because the
// appended round changes the log, the open-question table, and this form's
// own checkbox set -- all outside the swap target).
//
// The textarea is deliberately not required: an answer round is meaningful
// with follow-up text OR at least one ticked resolve box, so the empty
// round is refused server-side (renderAnswerFormFailure) and the error is
// shown inline here. The old inline <script> that blocked it client-side
// was a second, worse copy of that rule.
templ FollowUpForm(page DesignSessionDetailPage) {
	<form
		id="follow-up-form"
		method="post"
		action={ templ.URL(page.AnswersPath) }
		hx-post={ page.AnswersPath }
		hx-target="#follow-up-form"
		hx-swap="outerHTML"
	>
		if page.Error != "" {
			@htmxui.Alert(htmxui.AlertError, "Not saved: "+page.Error, nil)
		}
		if len(page.OpenQuestions) > 0 {
			<fieldset class="fieldset">
				<legend class="fieldset-legend">Open questions this answer closes</legend>
				for _, q := range page.OpenQuestions {
					<p>
						<label class="label cursor-pointer justify-start gap-2">
							<input type="checkbox" name="resolve" value={ q.QuestionID } checked?={ page.IsChecked(q.QuestionID) } class="checkbox checkbox-sm"/>
							<span><code>{ q.QuestionID }</code> ({ q.Blocking }): { q.Text }</span>
						</label>
					</p>
				}
			</fieldset>
		} else if len(page.CheckedResolve) > 0 {
			// The open questions could not be re-read, so there is nothing
			// to show a checkbox against -- but the ids the operator ticked
			// are still known, and a resubmit must not silently drop them.
			// Carried as hidden inputs rather than fake checkboxes: the
			// operator is not being asked to re-approve anything, we are
			// preserving what they already chose.
			<fieldset class="fieldset" data-krill="degraded-resolve">
				<legend class="fieldset-legend">Still selected (this session's open questions could not be reloaded)</legend>
				for qid := range page.CheckedResolve {
					<input type="hidden" name="resolve" value={ qid }/>
				}
			</fieldset>
		}
		<p>
			<label class="label" for="follow-up">Your follow-up</label>
			<textarea id="follow-up" name="follow_up" rows="4" placeholder="It should use the postgres flag table." class="textarea textarea-bordered w-full max-w-2xl">{ page.FollowUp }</textarea>
		</p>
		<p><button type="submit" class="btn btn-primary">Submit follow-up</button></p>
	</form>
}

// itoa keeps the #seq_no / #opened-at rendering free of a strconv import
// in the generated file for one call each.
func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var buf [20]byte
	i := len(buf)
	for n > 0 {
		i--
		buf[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		buf[i] = '-'
	}
	return string(buf[i:])
}
