package pages

// AreaLink is one row on an area's landing page: a link and a one-line
// description of where it leads.
type AreaLink struct {
	Path  string
	Label string
	Blurb string
}

// AreaIndex is the link-and-blurb list shared by the ops root and the spec
// landing.
templ AreaIndex(heading string, links []AreaLink) {
	<section data-krill="area-index">
		<h2 class="text-lg font-semibold">{ heading }</h2>
		if len(links) > 0 {
			<ul class="mt-3 space-y-2">
				for _, l := range links {
					<li>
						<a href={ templ.URL(l.Path) } class="link link-primary font-medium">{ l.Label }</a>
						<span class="text-sm text-base-content/70">{ l.Blurb }</span>
					</li>
				}
			</ul>
		}
	</section>
}
