package pages

// The Milestone detail page: one milestone or milepebble, its status, and links to
// the work it holds. Both kinds answer at the same URL.

// MilestoneDetailAnchor is the DOM id of this page's region.
const MilestoneDetailAnchor = "krill-milestone-detail"

// MilestoneCrumb is one breadcrumb entry; Href is empty for the current page.
// Kept separate from TaskCrumb because each page owns the walk it renders.
type MilestoneCrumb struct {
	Label string
	Href  string
}

// MilestoneDetailPage is the detail's view model; every header fact comes from the
// same resolved container so the badge and links cannot disagree.
type MilestoneDetailPage struct {
	Product ProductHeader

	// Path is this page's own URL.
	Path string

	ID string

	// Kind is "milestone" or "milepebble", exposed as a data attribute only.
	Kind string

	// Crumbs walks product -> Milestones -> the container's name.
	Crumbs []MilestoneCrumb

	// Status renders through the shared statusBadge so a status has one colour everywhere.
	Title  string
	Status string

	// TasksPath and BoardPath are the product-wide views preselected to this container.
	TasksPath string
	BoardPath string

	// Outcome is the container's markdown outcome; empty renders no card.
	Outcome string

	// Milepebbles are the containers cut from this one, in listing order; empty renders
	// no card.
	Milepebbles []MilestoneDetailMilepebble

	// Delivery is the get_delivery_breakdown read of this container, split by shipment
	// record. A failed read renders its own error rather than an empty card.
	Delivery *DeliveryBreakdown

	// Rail is built from the page's own reads so it cannot contradict the header.
	Rail MilestoneRail
}

// milestoneDetailCrumbs renders the breadcrumb with the same daisyUI shape as the
// task detail.
templ milestoneDetailCrumbs(crumbs []MilestoneCrumb) {
	if len(crumbs) > 0 {
		<nav class="breadcrumbs text-sm" aria-label="Breadcrumb" data-krill="milestone-breadcrumb">
			<ul>
				for _, c := range crumbs {
					<li data-krill="breadcrumb-crumb">
						if c.Href == "" {
							<span>{ c.Label }</span>
						} else {
							<a href={ templ.URL(c.Href) }>{ c.Label }</a>
						}
					</li>
				}
			</ul>
		</nav>
	}
}

// milestoneDetailHeader renders the breadcrumb, name, status and work links.
// "Open tasks" is the primary action; "Board" is the same scope viewed differently.
templ milestoneDetailHeader(page MilestoneDetailPage) {
	@milestoneDetailCrumbs(page.Crumbs)
	<div class="flex flex-wrap items-center gap-3" data-krill="milestone-detail-header">
		<h1 class="text-2xl font-bold" data-krill="page-title">{ page.Title }</h1>
		@statusBadge(page.Status)
		<div class="flex-1"></div>
		<div class="flex flex-wrap items-center gap-2" data-krill="milestone-detail-actions">
			<a href={ templ.URL(page.TasksPath) } class="btn btn-primary btn-sm" data-krill="milestone-open-tasks">Open tasks</a>
			<a href={ templ.URL(page.BoardPath) } class="btn btn-ghost btn-sm" data-krill="milestone-board-link">Board</a>
		</div>
	</div>
	<p class="mt-1 text-sm text-base-content/70" data-krill="milestone-detail-subtitle">
		{ page.Product.Name } — one container of this product's delivery.
	</p>
}

// MilestoneDetail renders the header and the grid the cards and rail compose into;
// below lg the rail stacks under the content.
templ MilestoneDetail(page MilestoneDetailPage) {
	<section id={ MilestoneDetailAnchor } data-krill="milestone-detail"
		data-krill-container-id={ page.ID } data-krill-container-kind={ page.Kind } class="space-y-4">
		@milestoneDetailHeader(page)
		<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]" data-krill="milestone-detail-frame">
			<div class="min-w-0 space-y-4" data-krill="milestone-detail-main">
				@milestoneDetailCards(page)
				@MilestoneDelivery(page.Delivery)
			</div>
			<aside data-krill="milestone-detail-rail">
				@milestoneDetailRail(page.Rail)
			</aside>
		</div>
	</section>
}

// MilestoneRail is the detail page's properties rail. Each row is a read's own
// answer, so it cannot disagree with the page beside it.
type MilestoneRail struct {
	// Status repeats the header's badge because below lg the rail stacks under the name.
	Status string

	// FRBudget is empty when undeclared; milepebbles have no budget of their own.
	FRBudget string

	// Tasks uses the read's own Done()/Total() so it matches the Milestones table bar.
	Tasks ProgressCell

	// StatusHistoryPath and StatusChanges come from one read, so the count matches
	// the history page's rows.
	StatusHistoryPath string
	StatusChanges      int

	// HistoryError replaces the count when the history read failed, so a failure never
	// renders as "0 changes".
	HistoryError string

	ID string
}

// TasksLabel is "N of M done", or "No tasks yet" for an empty container so it does
// not read as stalled.
func (r MilestoneRail) TasksLabel() string {
	if !r.Tasks.HasTasks() {
		return "No tasks yet"
	}
	return itoa(r.Tasks.Done) + " of " + itoa(r.Tasks.Total) + " done"
}

// TasksErrored reports whether the Tasks figures could not be read.
func (r MilestoneRail) TasksErrored() bool { return r.Tasks.ProgressError != "" }

// HistoryLabel is the Status history link's text, or the failure sentence when the
// read failed.
func (r MilestoneRail) HistoryLabel() string {
	if r.HistoryError != "" {
		return r.HistoryError
	}
	if r.StatusChanges == 1 {
		return "1 change"
	}
	return itoa(r.StatusChanges) + " changes"
}

// milestoneDetailRail renders the five property rows; an empty value is rendered
// explicitly rather than dropping the row.
templ milestoneDetailRail(rail MilestoneRail) {
	<div class="card bg-base-100 border border-base-300" data-krill="milestone-properties">
		<dl class="card-body gap-3 text-sm">
			<div>
				<dt class="text-base-content/70">Status</dt>
				<dd data-krill="milestone-properties-status">
					@statusBadge(rail.Status)
				</dd>
			</div>
			<div>
				<dt class="text-base-content/70">FR budget</dt>
				<dd data-krill="milestone-properties-fr-budget">
					if rail.FRBudget != "" {
						{ rail.FRBudget }
					} else {
						// Said plainly; an empty cell would read as an unreadable value.
						<span class="text-base-content/70">No FR budget declared</span>
					}
				</dd>
			</div>
			<div>
				<dt class="text-base-content/70">Tasks</dt>
				<dd data-krill="milestone-properties-tasks">
					if rail.TasksErrored() {
						<span class="text-base-content/70">{ rail.Tasks.ProgressError }</span>
					} else {
						{ rail.TasksLabel() }
					}
				</dd>
			</div>
			<div>
				<dt class="text-base-content/70">Status history</dt>
				<dd data-krill="milestone-properties-status-history">
					<a href={ templ.URL(rail.StatusHistoryPath) } class="link link-primary"
						data-krill="milestone-status-history-link"
						data-krill-change-count={ itoa(rail.StatusChanges) }>{ rail.HistoryLabel() }</a>
				</dd>
			</div>
			<div>
				<dt class="text-base-content/70">Id</dt>
				<dd data-krill="milestone-properties-id">
					// Reuses the task detail's copy-chip attributes so the shared head script binds it;
					// ships disabled until that script enables it.
					<button type="button" class="badge badge-ghost font-mono disabled:opacity-50"
						aria-label="Copy milestone id" data-krill="copy-task-id" data-task-id={ rail.ID }
						disabled title="Copying the id needs JavaScript">
						{ idChipText(rail.ID) }
					</button>
					<span class="ml-2 text-xs" data-krill="copy-task-id-status" role="status" aria-live="polite"></span>
				</dd>
			</div>
		</dl>
	</div>
}
