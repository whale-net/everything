package pages

import "github.com/whale-net/everything/libs/go/htmxui"

// NoProductsInScope is what an un-prefixed page renders when the
// deployment's sole scope holds no product at all. It is an empty state
// rather than a 404 -- an empty scope is an ordinary state to be in, not
// a broken link -- and it points at the one page that lists products
// rather than asking the operator for an id.
templ NoProductsInScope() {
	<section data-krill="no-products">
		@htmxui.EmptyState(
			"No products in this scope.",
			"There is nothing to browse yet. Create a product, or ask an operator to add one to this scope.",
			"Browse the product index",
			"/spec/products",
			templ.Attributes{},
		)
	</section>
}

// ProductPlaceholderData is the body a product-scoped prefix serves until
// the area's own page ships: the product's own row, so the page names
// which product a copied link resolved to, and the sub-path that was
// asked for.
type ProductPlaceholderData struct {
	Product ProductHeader
	Area    string
}

// ProductPlaceholder is the standing-in body for a product-scoped sub-path
// whose real page has not shipped yet. It resolves the product (so an
// out-of-scope link is already an in-shell 404 by this point) and says
// so, which is what makes the prefixes safe to register ahead of the
// pages behind them.
templ ProductPlaceholder(d ProductPlaceholderData) {
	<section data-krill="product-placeholder">
		<h2 class="text-xl font-semibold" data-krill="page-title">{ d.Product.Name }</h2>
		if d.Product.Vision != "" {
			<p class="mt-1 text-sm text-base-content/70 max-w-3xl">{ d.Product.Vision }</p>
		}
		<p class="mt-3 text-sm text-base-content/70">
			This area has no redesigned page yet. The product in the URL is
			resolved and checked against your scope; its content arrives in a
			later phase.
		</p>
	</section>
}
