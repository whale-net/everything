package pages

import "github.com/whale-net/everything/libs/go/htmxui"

// NoProductsInScope is the empty state for an un-prefixed page when the scope holds
// no product: an ordinary state, not a 404, pointing at the product index.
templ NoProductsInScope() {
	<section data-krill="no-products">
		@htmxui.EmptyState(
			"No products in this scope.",
			"There is nothing to browse yet. Create a product, or ask an operator to add one to this scope.",
			"Browse the product index",
			"/spec/products",
			templ.Attributes{},
		)
	</section>
}
