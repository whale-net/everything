package pages

// The Milestones table and its status select. The select is a GET form on this page's URL,
// so reload, shared links and no-JS submits work; htmx swaps the region in place on top.

import (
	"github.com/whale-net/everything/libs/go/htmxui"
)

// MilestonesAnchor is the region's DOM id: the select's hx-get target and the fragment root,
// which must carry it or the next swap has no target.
const MilestonesAnchor = "krill-milestones"

// MilestoneStatusOption is one status the filter select offers.
type MilestoneStatusOption struct {
	// Value is the store's wire value, so offered statuses are ones the parser accepts.
	Value string
	// Label is what the operator reads; equal to Value.
	Label string
	// Selected marks the status this request filtered to.
	Selected bool
}

// ProgressCell is one container's "N of M done" figures, shared by milestone and milepebble
// rows so both render through the same methods.
type ProgressCell struct {
	// ProgressError replaces the bar when figures are unreadable, so "not checked" is not shown as "no tasks".
	ProgressError string

	Done  int
	Total int
}

// HasTasks reports whether the container holds any task; an empty one avoids "0 of 0".
func (p ProgressCell) HasTasks() bool { return p.Total > 0 }

// IsComplete reports whether every task is Done; it colours the bar regardless of status.
func (p ProgressCell) IsComplete() bool { return p.HasTasks() && p.Done == p.Total }

// ProgressLabel is the bar's "N/M tasks done" sentence, built in Go because templ inserts HTML
// comments between adjacent text and expressions, splitting the sentence.
func (p ProgressCell) ProgressLabel() string {
	if !p.HasTasks() {
		return "No tasks yet"
	}
	return itoa(p.Done) + "/" + itoa(p.Total) + " tasks done"
}

// MilepebbleRow is one milepebble's row, shown beneath its expanded milestone.
type MilepebbleRow struct {
	// ID is the milepebble's own id.
	ID string

	// TasksPath and BoardPath are scoped to the milepebble, not the whole milestone cut.
	Name      string
	TasksPath string
	BoardPath string

	// Status is the milepebble's own, rendered via statusBadge.
	Status string

	ProgressCell
}

// MilestoneRow is one milestone's row. Done and Total are the progress read's own figures,
// so cancelled-task counting (store.CancelledTaskCounting) has one definition.
type MilestoneRow struct {
	// ID is the milestone's own id.
	ID string

	// Name links to the milestone's detail page.
	Name       string
	DetailPath string

	// TasksPath and BoardPath are the milestone-scoped Tasks and Board views, offered beside the
	// detail link on every row.
	TasksPath string
	BoardPath string

	// Status renders through the shared statusBadge, matching delivery page and Board colours.
	Status string

	ProgressCell

	// FRBudget is the stored budget for display, empty when none is declared.
	FRBudget string

	// Outcome is the milestone's outcome sentence, markdown-rendered.
	Outcome string

	// Milepebbles are the containers cut from this milestone, in listing order; non-empty makes
	// the row expandable.
	Milepebbles []MilepebbleRow

	// Expanded is true when the expand parameter named this milestone.
	Expanded bool

	// ExpandHref and CollapseHref are the expander's two targets; both carry the status filter.
	ExpandHref   string
	CollapseHref string
}

// HasMilepebbles reports whether this row can be expanded.
func (r MilestoneRow) HasMilepebbles() bool { return len(r.Milepebbles) > 0 }

// ExpanderHref is the collapse URL when expanded, else the expand URL, so link and state agree.
func (r MilestoneRow) ExpanderHref() string {
	if r.Expanded {
		return r.CollapseHref
	}
	return r.ExpandHref
}

// ExpanderLabel is the expander's accessible name, saying what pressing it does.
func (r MilestoneRow) ExpanderLabel() string {
	verb := "Show"
	if r.Expanded {
		verb = "Hide"
	}
	noun := "milepebbles"
	if len(r.Milepebbles) == 1 {
		noun = "milepebble"
	}
	return verb + " the " + itoa(len(r.Milepebbles)) + " " + noun + " cut from " + r.Name
}

// ExpanderClass is the expander's button classes, rotating the chevron off the same Expanded
// flag as aria-expanded and the rows below.
func (r MilestoneRow) ExpanderClass() string {
	class := "btn btn-ghost btn-sm btn-square"
	if r.Expanded {
		class += " rotate-90"
	}
	return class
}

// ExpanderAriaExpanded is aria-expanded as "true"/"false" strings rather than relying on
// templ's bool rendering.
func (r MilestoneRow) ExpanderAriaExpanded() string {
	if r.Expanded {
		return "true"
	}
	return "false"
}

// MilestonesPage is the whole region: header, status filter and table. Filter and expansion
// are already in the URL, so each row carries both expander hrefs. Empty and ProgressError
// are distinct answers and never share a branch.
type MilestonesPage struct {
	Product ProductHeader

	// Path is this page's own URL, used as both the form action and hx-get.
	Path string

	// Statuses are the select's options, "All statuses" first.
	Statuses []MilestoneStatusOption

	// Rows are in render order: highest roadmap position first, then id.
	Rows []MilestoneRow

	// Empty is set when the filter matched nothing; EmptyDetail names the filter so this is
	// distinguishable from a product with no milestones.
	Empty       bool
	EmptyDetail string

	// ProgressError is set when the progress read failed; rows still render with the sentence in each cell.
	ProgressError string
}

// containerWorkLinks is the Tasks + Board link pair every container row carries, one component
// so a row cannot offer one without the other. The prefix scopes each caller's data-krill.
templ containerWorkLinks(kind, tasksPath, boardPath string) {
	<a href={ templ.URL(tasksPath) } class="link link-primary ml-2 text-sm" data-krill={ kind + "-tasks-link" }>Tasks</a>
	<a href={ templ.URL(boardPath) } class="link link-primary ml-2 text-sm" data-krill={ kind + "-board-link" }>Board</a>
}

// milestoneProgress renders a progress cell: bar and sentence, sentence alone for no tasks,
// or the failure sentence. "No tasks", "some tasks" and "not checked" never share a branch.
templ milestoneProgress(cell ProgressCell) {
	if cell.ProgressError != "" {
		<span class="text-sm text-base-content/70" data-krill="milestone-progress-error">{ cell.ProgressError }</span>
	} else if !cell.HasTasks() {
		<span class="text-sm text-base-content/70" data-krill="milestone-no-tasks">{ cell.ProgressLabel() }</span>
	} else {
		<div class="flex items-center gap-2">
			if cell.IsComplete() {
				<progress class="progress progress-success w-32" data-krill="milestone-progress"
					value={ itoa(cell.Done) } max={ itoa(cell.Total) }></progress>
			} else {
				<progress class="progress progress-warning w-32" data-krill="milestone-progress"
					value={ itoa(cell.Done) } max={ itoa(cell.Total) }></progress>
			}
			<span class="text-sm text-base-content/70" data-krill="milestone-progress-label">{ cell.ProgressLabel() }</span>
		</div>
	}
}

// MilestoneStatusForm renders the status filter: a GET form with htmx on top, so the URL
// holds the state and Back and shared links work.
templ MilestoneStatusForm(page MilestonesPage) {
	<form method="get" action={ templ.URL(page.Path) } class="flex items-end gap-2"
		data-krill="milestone-status-form"
		hx-get={ templ.URL(page.Path) }
		hx-target={ "#" + MilestonesAnchor }
		hx-swap="outerHTML"
		hx-trigger="change, submit"
		hx-push-url="true">
		<label class="fieldset">
			<span class="fieldset-legend">Status</span>
			<select name="status" class="select select-sm" aria-label="Filter by status"
				data-krill="milestone-status-select">
				for _, o := range page.Statuses {
					<option value={ o.Value } selected?={ o.Selected } data-krill-status={ o.Value }>
						{ o.Label }
					</option>
				}
			</select>
		</label>
		<button type="submit" class="btn btn-primary btn-sm" data-krill="milestone-status-apply">
			Apply
		</button>
	</form>
}

// milestoneExpander toggles a milestone's milepebbles; nothing renders for an uncut milestone.
// It is a real link carrying the filter, so no-JS is a plain GET and htmx swaps in place.
templ milestoneExpander(m MilestoneRow) {
	<a href={ templ.URL(m.ExpanderHref()) }
		class={ m.ExpanderClass() }
		aria-expanded={ m.ExpanderAriaExpanded() }
		aria-label={ m.ExpanderLabel() }
		title={ m.ExpanderLabel() }
		data-krill="milestone-expand"
		data-krill-milestone-id={ m.ID }
		hx-get={ templ.URL(m.ExpanderHref()) }
		hx-target={ "#" + MilestonesAnchor }
		hx-swap="outerHTML"
		hx-push-url="true">
		<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="m9 18 6-6-6-6"></path>
		</svg>
	</a>
}

// MilepebbleTable is an expanded milestone's milepebbles as a nested table; milepebbles have
// no FR budget or outcome here, so they do not get parent-table columns.
templ MilepebbleTable(milepebbles []MilepebbleRow) {
	<table class="table table-sm" data-krill="milepebble-table">
		<thead>
			<tr>
				<th>Milepebble</th>
				<th>Status</th>
				<th>Progress</th>
			</tr>
		</thead>
		<tbody>
			for _, mp := range milepebbles {
				<tr data-krill="milepebble-row" data-krill-milepebble-id={ mp.ID }>
					<td>
						<span data-krill="milepebble-name">{ mp.Name }</span>
						@containerWorkLinks("milepebble", mp.TasksPath, mp.BoardPath)
					</td>
					<td>@statusBadge(mp.Status)</td>
					<td>@milestoneProgress(mp.ProgressCell)</td>
				</tr>
			}
		</tbody>
	</table>
}

// MilestoneTable is the table in buildMilestonesPage's order, inside a horizontal scroller so
// narrow viewports scroll the table, not the page.
templ MilestoneTable(rows []MilestoneRow) {
	<div class="overflow-x-auto rounded-lg border border-base-300 bg-base-100">
		<table class="table table-zebra" data-krill="milestone-table">
			<thead>
				<tr>
					<th>Milestone</th>
					<th>Status</th>
					<th>Progress</th>
					<th class="text-right">FR budget</th>
					<th>Outcome</th>
				</tr>
			</thead>
			<tbody>
				for _, m := range rows {
					<tr class="hover" data-krill="milestone-row" data-krill-milestone-id={ m.ID }>
						<td>
							<div class="flex items-center gap-1">
								if m.HasMilepebbles() {
									@milestoneExpander(m)
								}
								<a href={ templ.URL(m.DetailPath) } class="link font-medium" data-krill="milestone-name">{ m.Name }</a>
							@containerWorkLinks("milestone", m.TasksPath, m.BoardPath)
							</div>
						</td>
						<td>@statusBadge(m.Status)</td>
						<td>@milestoneProgress(m.ProgressCell)</td>
						<td class="text-right" data-krill="milestone-fr-budget">{ m.FRBudget }</td>
						<td class="max-w-md" data-krill="milestone-outcome">
							if m.Outcome != "" {
								<div class="text-sm text-base-content/70 krill-md">@templ.Raw(renderMarkdown(m.Outcome))</div>
							}
						</td>
					</tr>
					if m.Expanded && m.HasMilepebbles() {
						<tr data-krill="milepebble-expansion" data-krill-for-milestone-id={ m.ID }>
							<td colspan="5" class="bg-base-200/60">
								@MilepebbleTable(m.Milepebbles)
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// Milestones renders the region. The swap replaces filter and table together, so the select
// never shows a filter the rows no longer answer to.
templ Milestones(page MilestonesPage) {
	<section id={ MilestonesAnchor } data-krill="milestones" class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold" data-krill="page-title">Milestones</h1>
				<p class="mt-1 text-sm text-base-content/70">
					{ page.Product.Name } — every milestone, most recently added first.
				</p>
			</div>
			@MilestoneStatusForm(page)
		</div>
		if page.ProgressError != "" {
			<div data-krill="milestones-progress-error">
				@htmxui.Alert(htmxui.AlertError, page.ProgressError, templ.Attributes{
					"data-krill": "milestones-progress-error-alert",
				})
			</div>
		}
		if page.Empty {
			<div data-krill="milestones-empty">
				@htmxui.EmptyState(
					"No milestones here",
					page.EmptyDetail,
					"", "", templ.Attributes{},
				)
			</div>
		} else {
			@MilestoneTable(page.Rows)
		}
	</section>
}

// MilestonesRows is the whole region without the shell, for the select's swap. It keeps the
// anchor id because outerHTML removes the swap target.
templ MilestonesRows(page MilestonesPage) {
	@Milestones(page)
}