package components

import (
	"strconv"

	"github.com/whale-net/everything/libs/go/htmxui"
)

// The shell's single toast region. It must be in the initial page (aria-live only
// announces nodes inserted after render) and mounted outside any htmx swap target,
// or the mutation it reports would destroy it.

// ToastHostID is the id out-of-band toast swaps address the host by.
const ToastHostID = "krill-toast-host"

// ToastAutoDismissMs is how long a toast stays before removing itself.
const ToastAutoDismissMs = 5000

// toastAutoDismissExpr is the Alpine x-init body that schedules the self-dismiss.
func toastAutoDismissExpr() string {
	return "setTimeout(() => $el.remove(), " + strconv.Itoa(ToastAutoDismissMs) + ")"
}

// ToastHost is the shell's empty aria-live="status" region; toasts arrive by OOB swap.
templ ToastHost() {
	<div id={ ToastHostID } data-krill="toast-host"
		 aria-live="status" aria-atomic="false"
		 class="toast toast-top toast-end z-50"></div>
}

// ToastOOB wraps a toast for out-of-band delivery into ToastHost. beforeend, not
// outerHTML: replacing the host would drop its aria-live wiring for later toasts.
templ ToastOOB(message string) {
	<div id={ ToastHostID } hx-swap-oob="beforeend">
		@Toast(message)
	</div>
}

// Toast is one dismissible confirmation on the htmxui Alert primitive. The timer is
// Alpine because hx-alpine-compat keeps it bound across htmx morph swaps.
templ Toast(message string) {
	@htmxui.Alert(htmxui.AlertSuccess, message, templ.Attributes{
		"data-krill": "toast",
		"x-init":     toastAutoDismissExpr(),
		"x-on:keydown.escape.window": "$el.remove()",
	}) {
		<button type="button" data-krill="toast-dismiss"
				class="btn btn-ghost btn-xs"
				aria-label="Dismiss this message"
				x-on:click="$el.closest('[data-krill=toast]').remove()">Dismiss</button>
	}
}

// ToastFlash is the no-JS rendering of a mutation's success message as an inline alert.
templ ToastFlash(message string) {
	@htmxui.Alert(htmxui.AlertSuccess, message, templ.Attributes{
		"data-krill": "toast-flash",
	})
}
