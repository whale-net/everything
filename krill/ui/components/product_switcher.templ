package components

// ProductOption is one product in the switcher; operators pick it, never type the id.
type ProductOption struct {
	ID       string
	Name     string
	Selected bool
}

// ProductSwitcherData is the sidebar's Product select. Action + From let the switch
// land on the same area's list page under the new product; a single-product
// scope still renders so the operator sees which product they are in.
type ProductSwitcherData struct {
	Action  string
	From    string
	Options []ProductOption
}

// ProductSwitcher is the sidebar's Product select. The noscript submit button keeps
// the switch working with JavaScript disabled; otherwise onchange submits.
templ ProductSwitcher(d ProductSwitcherData) {
	<div class="px-3 pb-2">
		<form method="get" action={ templ.URL(d.Action) } data-krill="product-switcher">
			<input type="hidden" name="from" value={ d.From }/>
			<label class="sr-only" for="krill-product-switcher">Product</label>
			<select
				id="krill-product-switcher"
				name="product"
				class="select select-bordered w-full text-base-content"
				onchange="this.form.submit()"
			>
				for _, o := range d.Options {
					if o.Selected {
						<option value={ o.ID } selected>{ o.Name }</option>
					} else {
						<option value={ o.ID }>{ o.Name }</option>
					}
				}
			</select>
			<noscript>
				<button type="submit" class="btn btn-sm btn-block mt-1">Switch product</button>
			</noscript>
		</form>
	</div>
}