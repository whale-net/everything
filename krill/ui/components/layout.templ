package components

import "github.com/whale-net/everything/libs/go/htmxui"

// NavLink is one entry in a nav list. Active is computed by the caller
// (nav.go's NavIsActive, the segment-boundary rule) rather than here:
// htmxui.Shell hardcodes no nav of its own (ARCHITECTURE §2), and the
// matching rule is krill's, not the shared library's.
type NavLink struct {
	Label  string
	Href   string
	Active bool

	// Count is the item's badge figure, or "" for no badge at all.
	// It is a string so the caller decides what a count means before
	// this type sees it: a zero and a count that could not be read both
	// arrive as "", because a badge reading 0 tells an operator nothing
	// is wrong when in fact nothing was read.
	Count string
}

// LayoutData is krill's app-owned chrome data.
//
// UserLabel is a plain string, never an htmxauth.UserInfo: htmxui §1
// requires components to stay free of a specific auth dependency so an
// AUTH_MODE=none deployment (or a domain with no auth at all) can still
// populate the chrome. The render seam in krill/ui/templ_render.go
// resolves it from the request context, so no auth type ever reaches a
// component.
type LayoutData struct {
	Title          string
	UserLabel      string
	Nav            []NavLink
	ContainerClass string
}

// nav renders the primary nav. It wraps the <ul> in a real <nav>
// landmark so the shell's structure is not purely presentational; the
// data-krill hook is what nav_test.go scopes its active-link scan to, so
// a page's own product sub-nav can never be mistaken for the primary one.
templ nav(links []NavLink) {
	<nav aria-label="Primary" data-krill="primary-nav">
		<ul class="menu menu-horizontal px-1">
			for _, l := range links {
				@navLink(l)
			}
		</ul>
	</nav>
}

templ navLink(l NavLink) {
	<li>
		if l.Active {
			<a href={ templ.URL(l.Href) } class="menu-active" aria-current="page">
				{ l.Label }
				@navCount(l.Count)
			</a>
		} else {
			<a href={ templ.URL(l.Href) }>
				{ l.Label }
				@navCount(l.Count)
			</a>
		}
	</li>
}

// navCount renders an item's badge beside its label. An empty count is
// the absence of a badge, not a badge of zero -- the caller has already
// folded "nothing escalated" and "could not read how many are escalated"
// into that one value.
templ navCount(count string) {
	if count != "" {
		<span class="badge badge-error badge-sm" data-krill="nav-count">{ count }</span>
	}
}

// SubNav is the per-product cross-nav the spec and delivery pages share.
// Exactly one of its links is Active -- the page being rendered.
templ SubNav(links []NavLink) {
	<nav aria-label="Product" data-krill="product-nav" class="border-b border-base-300 pb-2 mb-4">
		<ul class="menu menu-horizontal">
			for _, l := range links {
				@navLink(l)
			}
		</ul>
	</nav>
}

// Layout is krill's thin wrapper around htmxui's shared Shell and
// UserMenu, mirroring audience_score_system/web/components/layout.templ's
// adoption. Children render inside Shell's main content region.
templ Layout(data LayoutData) {
	@htmxui.Shell(htmxui.ShellData{
		Title:      data.Title,
		BrandLabel: "krill",
		BrandHref:  "/",
		Nav:        nav(data.Nav),
		HeaderRight: htmxui.UserMenu(htmxui.UserMenuData{
			IdentityLabel: data.UserLabel,
			LogoutHref:    "/logout",
		}),
		Themes:         htmxui.Themes,
		ContainerClass: data.ContainerClass,
	}) {
		{ children... }
	}
}

// NavGroup is one headed section of the workspace sidebar: a title and its
// items. An empty Title renders its items unheaded, which is how Overview
// sits above the groups rather than inside one.
type NavGroup struct {
	Title string
	Items []NavLink
}

// ShellData is the workspace shell's chrome data.
//
// It is LayoutData plus the grouped sidebar the shell replaces the flat
// top-bar nav with, kept as its own type so a page can be migrated to the
// shell without the two shapes having to be reconciled in one struct.
type ShellData struct {
	LayoutData

	// NavGroups is the sidebar, in render order.
	NavGroups []NavGroup
}

// Shell is the workspace chrome: a daisyUI drawer whose sidebar is
// persistent at lg and an overlay below it, a sticky top bar, and the
// grouped nav.
//
// The drawer is a checkbox and a pair of <label for>, so it opens and
// closes with no JavaScript at all; there is no htmx or Alpine behaviour
// behind it, and therefore nothing to re-test when either moves.
templ Shell(data ShellData) {
	<div class="drawer lg:drawer-open min-h-screen bg-base-200" data-krill="workspace-shell">
		<input id="krill-drawer" type="checkbox" class="drawer-toggle" />
		<div class="drawer-content flex flex-col min-w-0">
			<header class="navbar sticky top-0 z-30 gap-2 bg-base-100 border-b border-base-300 px-4">
				<label for="krill-drawer" class="btn btn-ghost btn-square lg:hidden" aria-label="Open navigation">
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
				</label>
				<span class="flex-1 min-w-0 truncate font-semibold">{ data.Title }</span>
				<span class="flex-none flex items-center gap-2">
					@htmxui.ThemeSwitcher(htmxui.Themes)
					@htmxui.UserMenu(htmxui.UserMenuData{
						IdentityLabel: data.UserLabel,
						LogoutHref:    "/logout",
					})
				</span>
			</header>
			<main id="main" class="flex-1 p-4 lg:p-6">
				{ children... }
			</main>
		</div>
		<div class="drawer-side z-40">
			<label for="krill-drawer" class="drawer-overlay" aria-label="Close navigation"></label>
			<aside class="flex min-h-full w-56 flex-col bg-neutral text-neutral-content">
				<a href="/" class="btn btn-ghost m-2 justify-start text-lg text-neutral-content">krill</a>
				@sidebar(data.NavGroups)
			</aside>
		</div>
	</div>
}

// sidebar renders the grouped nav. The data-krill hook is the same one
// nav_test.go scopes its active-link scan to, so a page's own product
// sub-nav can never be counted as a primary one; the menu-title headings
// are daisyUI's, which is what keeps a group heading visually distinct
// from the items under it.
templ sidebar(groups []NavGroup) {
	<nav aria-label="Primary" data-krill="primary-nav" class="px-2 pb-2">
		<ul class="menu menu-sm w-full gap-0.5">
			for _, g := range groups {
				if g.Title == "" {
					for _, l := range g.Items {
						@navLink(l)
					}
				} else {
					<li>
						<h2 class="menu-title text-sm font-bold text-neutral-content">{ g.Title }</h2>
						<ul>
							for _, l := range g.Items {
								@navLink(l)
							}
						</ul>
					</li>
				}
			}
		</ul>
	</nav>
}
