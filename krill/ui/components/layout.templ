package components

import "github.com/whale-net/everything/libs/go/htmxui"

// NavLink is one entry in a nav list. Active is computed by the caller
// because the matching rule is krill's, not the shared shell's.
type NavLink struct {
	Label  string
	Href   string
	Active bool

	// Count is the badge figure, or "" for no badge. Zero and an unreadable
	// count both arrive as "": a badge reading 0 would falsely signal all clear.
	Count string
}

// LayoutData is krill's app-owned chrome data. UserLabel is a plain string
// so components stay free of any auth dependency (AUTH_MODE=none still works).
type LayoutData struct {
	Title     string
	UserLabel string
}

templ navLink(l NavLink) {
	<li>
		if l.Active {
			<a href={ templ.URL(l.Href) } class="menu-active" aria-current="page">
				{ l.Label }
				@navCount(l.Count)
			</a>
		} else {
			<a href={ templ.URL(l.Href) }>
				{ l.Label }
				@navCount(l.Count)
			</a>
		}
	</li>
}

// navCount renders an item's badge beside its label; an empty count
// renders no badge at all.
templ navCount(count string) {
	if count != "" {
		<span class="badge badge-error badge-sm" data-krill="nav-count">{ count }</span>
	}
}

// SubNav is the per-product cross-nav the spec and delivery pages share.
// Exactly one of its links is Active -- the page being rendered.
templ SubNav(links []NavLink) {
	<nav aria-label="Product" data-krill="product-nav" class="border-b border-base-300 pb-2 mb-4">
		<ul class="menu menu-horizontal">
			for _, l := range links {
				@navLink(l)
			}
		</ul>
	</nav>
}

// NavGroup is one headed sidebar section. An empty Title renders its items
// unheaded, which is how Overview sits above the groups.
type NavGroup struct {
	Title string
	Items []NavLink
}

// ShellData is the workspace shell's chrome data.
type ShellData struct {
	LayoutData

	// NavGroups is the sidebar, in render order.
	NavGroups []NavGroup

	// Switcher is the sidebar's Product select; nil when no product is in scope.
	Switcher *ProductSwitcherData
}

// Shell is the workspace chrome: a daisyUI drawer (checkbox + label, no JS),
// a sticky top bar, the grouped nav, and the shared toast host. ToastHost sits
// outside <main> so a swap never destroys the live region announcing it.
templ Shell(data ShellData) {
	<div class="drawer lg:drawer-open min-h-screen bg-base-200" data-krill="workspace-shell">
		<input id="krill-drawer" type="checkbox" class="drawer-toggle" />
		<div class="drawer-content flex flex-col min-w-0">
			<header class="navbar sticky top-0 z-30 gap-2 bg-base-100 border-b border-base-300 px-4">
				<label for="krill-drawer" class="btn btn-ghost btn-square lg:hidden" aria-label="Open navigation">
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
				</label>
				<span class="flex-1 min-w-0 truncate font-semibold">{ data.Title }</span>
				<span class="flex-none flex items-center gap-2">
					@htmxui.ThemeSwitcher(htmxui.Themes)
					@htmxui.UserMenu(htmxui.UserMenuData{
						IdentityLabel: data.UserLabel,
						LogoutHref:    "/logout",
					})
				</span>
			</header>
			<main id="main" class="flex-1 p-4 lg:p-6">
				{ children... }
			</main>
		</div>
		<div class="drawer-side z-40">
			<label for="krill-drawer" class="drawer-overlay" aria-label="Close navigation"></label>
			<aside class="flex min-h-full w-56 flex-col bg-neutral text-neutral-content">
				<a href="/" class="btn btn-ghost m-2 justify-start text-lg text-neutral-content">krill</a>
				if data.Switcher != nil {
					@ProductSwitcher(*data.Switcher)
				}
				@sidebar(data.NavGroups)
			</aside>
		</div>
		@ToastHost()
	</div>
}

// sidebar renders the grouped nav. The data-krill hook keeps a page's own
// product sub-nav from being counted as primary nav.
templ sidebar(groups []NavGroup) {
	<nav aria-label="Primary" data-krill="primary-nav" class="px-2 pb-2">
		<ul class="menu menu-sm w-full gap-0.5">
			for _, g := range groups {
				if g.Title == "" {
					for _, l := range g.Items {
						@navLink(l)
					}
				} else {
					<li>
						<h2 class="menu-title text-sm font-bold text-neutral-content">{ g.Title }</h2>
						<ul>
							for _, l := range g.Items {
								@navLink(l)
							}
						</ul>
					</li>
				}
			}
		</ul>
	</nav>
}
