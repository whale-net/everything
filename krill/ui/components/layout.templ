package components

import "github.com/whale-net/everything/libs/go/htmxui"

// NavLink is one entry in a nav list. Active is computed by the caller
// (nav.go's NavIsActive, the segment-boundary rule) rather than here:
// htmxui.Shell hardcodes no nav of its own (ARCHITECTURE §2), and the
// matching rule is krill's, not the shared library's.
type NavLink struct {
	Label  string
	Href   string
	Active bool
}

// LayoutData is krill's app-owned chrome data.
//
// UserLabel is a plain string, never an htmxauth.UserInfo: htmxui §1
// requires components to stay free of a specific auth dependency so an
// AUTH_MODE=none deployment (or a domain with no auth at all) can still
// populate the chrome. The render seam in krill/ui/templ_render.go
// resolves it from the request context, so no auth type ever reaches a
// component.
type LayoutData struct {
	Title          string
	UserLabel      string
	Nav            []NavLink
	ContainerClass string
}

// nav renders the primary nav. It wraps the <ul> in a real <nav>
// landmark so the shell's structure is not purely presentational; the
// data-krill hook is what nav_test.go scopes its active-link scan to, so
// a page's own product sub-nav can never be mistaken for the primary one.
templ nav(links []NavLink) {
	<nav aria-label="Primary" data-krill="primary-nav">
		<ul class="menu menu-horizontal px-1">
			for _, l := range links {
				@navLink(l)
			}
		</ul>
	</nav>
}

templ navLink(l NavLink) {
	<li>
		if l.Active {
			<a href={ templ.URL(l.Href) } class="menu-active" aria-current="page">{ l.Label }</a>
		} else {
			<a href={ templ.URL(l.Href) }>{ l.Label }</a>
		}
	</li>
}

// SubNav is the per-product cross-nav the spec and delivery pages share.
// Exactly one of its links is Active -- the page being rendered.
templ SubNav(links []NavLink) {
	<nav aria-label="Product" data-krill="product-nav" class="border-b border-base-300 pb-2 mb-4">
		<ul class="menu menu-horizontal">
			for _, l := range links {
				@navLink(l)
			}
		</ul>
	</nav>
}

// Layout is krill's thin wrapper around htmxui's shared Shell and
// UserMenu, mirroring audience_score_system/web/components/layout.templ's
// adoption. Children render inside Shell's main content region.
templ Layout(data LayoutData) {
	@htmxui.Shell(htmxui.ShellData{
		Title:      data.Title,
		BrandLabel: "krill",
		BrandHref:  "/",
		Nav:        nav(data.Nav),
		HeaderRight: htmxui.UserMenu(htmxui.UserMenuData{
			IdentityLabel: data.UserLabel,
			LogoutHref:    "/logout",
		}),
		Themes:         htmxui.Themes,
		ContainerClass: data.ContainerClass,
	}) {
		{ children... }
	}
}
