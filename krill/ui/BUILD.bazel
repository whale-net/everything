"""krill's operator web UI: the Keycloak sign-in shell that gives auth's
`/authorize` endpoint a SignInURL to redirect a not-yet-signed-in caller
to, the persistent nav shell behind it (ops console, design-session
browser, spec+delivery browser, and the credential widget), and the
mutating actions this binary issues against krill api -- each attributed to
the signed-in operator's real (iss, sub) (writes.go, identity.go). See
main.go's package doc."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "ui_lib",
    srcs = [
        "main.go",
        "auth.go",
        "nav.go",
        "ops.go",
        "routes.go",
        "credentials_page.go",
        "design_page.go",
        "identity.go",
        "writeclient.go",
        "writes.go",
    ],
    importpath = "github.com/whale-net/everything/krill/ui",
    visibility = ["//visibility:private"],
    deps = [
        "//krill/identity",
        "//krill/store",
        "//libs/go/db",
        "//libs/go/htmxauth",
        "//libs/go/logging",
        "//libs/go/auth",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
    ],
)

go_binary(
    name = "ui",
    embed = [":ui_lib"],
    visibility = ["//visibility:public"],
)

# Attribution coverage for the write path: a UI write is rejected when no
# real (iss, sub) resolves (dev mode, no session, forged session), and is
# minted under + carried by the signed-in operator's real pair when one
# does. The present-identity cases run the real htmxauth sign-in callback
# against a fake Keycloak and the real write client against a fake api --
# no database, so this runs as part of `bazel test //krill/...`.
go_test(
    name = "ui_test",
    srcs = ["writes_test.go"],
    embed = [":ui_lib"],
    deps = [
        "//krill/store",
        "//libs/go/htmxauth",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# domain "krill" + name "ui" produces the "krill-ui" image/app identity.
# external-api: this is the browser-facing sign-in shell an operator's
# MCP client redirects them to during `/authorize`.
release_app(
    name = "ui",
    binary_name = ":ui",
    language = "go",
    domain = "krill",
    description = "krill's operator web UI: Keycloak sign-in shell backing the auth OAuth2 authorization-server front door, plus the operator nav shell",
    app_type = "external-api",
    port = 8080,
    replicas = 1,
)

go_test(
    name = "ui_lib_test",
    srcs = ["nav_test.go"],
    embed = [":ui_lib"],
    deps = ["//libs/go/htmxauth"],
)

# Field-parity coverage for the ops console's read views: each row mapper
# presents the store row's subject pairs and target identity the same way
# the GET /console/* wire does; the handler-level cases drive each view
# against a narrow fake store to prove data parity, paging pass-through, and
# cross-scope-token rejection.
go_test(
    name = "ui_ops_test",
    srcs = [
        "ops_test.go",
        "ops_handlers_test.go",
    ],
    embed = [":ui_lib"],
    deps = [
        "//krill/store",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
    ],
)

# The design-session read surface, against in-memory fakes of the two store
# accessors it reads: the session list (open + signed-off, each a working
# link), one session's full ordered revision-event log matching
# get_design_session's, and its currently-open questions matching
# list_open_questions -- plus the 400/404/500 error paths.
go_test(
    name = "design_test",
    srcs = ["design_page_test.go"],
    embed = [":ui_lib"],
    deps = [
        "//krill/store",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
