"""krill's operator web UI: Keycloak sign-in (which gives auth's
`/authorize` endpoint its SignInURL) plus the persistent nav shell behind
it -- ops console, design-session browser, spec+delivery browser, and the
credential widget. See main.go's package doc."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "ui_lib",
    srcs = [
        "main.go",
        "auth.go",
        "nav.go",
        "routes.go",
        "credentials_page.go",
        "identity.go",
        "writeclient.go",
        "writes.go",
    ],
    importpath = "github.com/whale-net/everything/krill/ui",
    visibility = ["//visibility:private"],
    deps = [
        "//krill/identity",
        "//krill/store",
        "//libs/go/db",
        "//libs/go/htmxauth",
        "//libs/go/logging",
        "//libs/go/auth",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
    ],
)

go_binary(
    name = "ui",
    embed = [":ui_lib"],
    visibility = ["//visibility:public"],
)

# domain "krill" + name "ui" produces the "krill-ui" image/app identity.
# external-api: this is the browser-facing sign-in shell an operator's
# MCP client redirects them to during `/authorize`.
release_app(
    name = "ui",
    binary_name = ":ui",
    language = "go",
    domain = "krill",
    description = "krill's operator web UI: Keycloak sign-in shell backing the auth OAuth2 authorization-server front door, plus the operator nav shell",
    app_type = "external-api",
    port = 8080,
    replicas = 1,
)

go_test(
    name = "ui_lib_test",
    srcs = ["nav_test.go"],
    embed = [":ui_lib"],
    deps = ["//libs/go/htmxauth"],
)
