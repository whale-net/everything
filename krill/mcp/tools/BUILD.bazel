"""krill's MCP tool groups. slice.go (issue #2494) is the one group M1
ships: four thin wrappers over //krill/slice's scoped-slice query
(FR5-FR8). design.go (issue #2547) is M2's design-session group: six thin
wrappers -- three write, three read -- over the design-session store
layer, mirroring krill/api/handlers' own HTTP surface for the same
FR1-FR10 capability."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tools",
    srcs = [
        "abandon.go",
        "delivery_shipment.go",
        "design.go",
        "milestone.go",
        "milestone_status.go",
        "recut.go",
        "slice.go",
        "task.go",
        "task_abandon.go",
        "task_claim.go",
        "task_complete.go",
        "task_dependency.go",
        "task_lease.go",
        "task_note.go",
        "task_payload.go",
    ],
    importpath = "github.com/whale-net/everything/krill/mcp/tools",
    visibility = ["//visibility:public"],
    deps = [
        "//krill/api/handlers",
        "//krill/mcp/server",
        "//krill/slice",
        "//krill/store",
        "//krill/work",
        "@com_github_google_jsonschema_go//jsonschema",
        "@com_github_google_uuid//:uuid",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

# No-database unit test (issue #2685's Testing item 5's MCP-layer half of
# NFR2): RegisterMilestoneStatusAll registers exactly
# {set_milestone_status, get_milestone_status, get_milestone_status_history}
# over a real in-memory MCP client/server connection -- no
# update_milestone_status/delete_milestone_status tool exists. Mirrors
# krill/mcp/server/registry_tools_test.go's own store.New(nil)/in-memory
# transport technique, so it needs no Docker and is part of
# `bazel test //...`.
go_test(
    name = "milestone_status_registration_test",
    srcs = ["milestone_status_registration_test.go"],
    deps = [
        ":tools",
        "//krill/mcp/server",
        "//krill/store",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

