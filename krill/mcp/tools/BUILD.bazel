"""krill's MCP tool groups. slice.go (issue #2494) is the one group M1
ships: four thin wrappers over //krill/slice's scoped-slice query
(FR5-FR8). design.go (issue #2547) is M2's design-session group: six thin
wrappers -- three write, three read -- over the design-session store
layer, mirroring krill/api/handlers' own HTTP surface for the same
FR1-FR10 capability. session.go (issue #2827) is init_session: the one MCP
entry point that mints the krill_session_id every write tool above
requires as input."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tools",
    srcs = [
        "abandon.go",
        "amend.go",
        "console.go",
        "delivery_shipment.go",
        "design.go",
        "entity.go",
        "entity_note.go",
        "milestone.go",
        "milestone_status.go",
        "persona_nongoal.go",
        "product.go",
        "recut.go",
        "resolve.go",
        "session.go",
        "slice.go",
        "task.go",
        "task_abandon.go",
        "task_cancel.go",
        "task_claim.go",
        "task_complete.go",
        "task_dependency.go",
        "task_escalate.go",
        "task_lease.go",
        "task_list.go",
        "task_note.go",
        "task_payload.go",
        "task_release.go",
        "task_requeue.go",
        "void.go",
        "work_mount.go",
    ],
    importpath = "github.com/whale-net/everything/krill/mcp/tools",
    visibility = ["//visibility:public"],
    deps = [
        "//krill/api/handlers",
        "//krill/mcp/server",
        "//krill/slice",
        "//krill/store",
        "//krill/work",
        "@com_github_google_jsonschema_go//jsonschema",
        "@com_github_google_uuid//:uuid",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

