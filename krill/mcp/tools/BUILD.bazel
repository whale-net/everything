"""krill's MCP tool groups. slice.go (issue #2494) is the one group M1
ships: four thin wrappers over //krill/slice's scoped-slice query
(FR5-FR8). design.go (issue #2547) is M2's design-session group: six thin
wrappers -- three write, three read -- over the design-session store
layer, mirroring krill/api/handlers' own HTTP surface for the same
FR1-FR10 capability."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tools",
    srcs = [
        "design.go",
        "slice.go",
    ],
    importpath = "github.com/whale-net/everything/krill/mcp/tools",
    visibility = ["//visibility:public"],
    deps = [
        "//krill/api/handlers",
        "//krill/mcp/server",
        "//krill/slice",
        "//krill/store",
        "@com_github_google_jsonschema_go//jsonschema",
        "@com_github_google_uuid//:uuid",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

# Real Postgres + real HTTP-transport MCP client integration test for the
# design-session surface (issue #2547's Testing section, criteria 2-8;
# criterion 1 -- exactly six tools on /mcp/design, none on /mcp/spec -- is
# covered by //krill/mcp/server:registry_tools_test, which needs no
# database). Deliberately NOT part of `bazel test //...` -- see
# //libs/go/dbtest's README, mirrored by
# //krill/mcp/server:server_integration_test.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //krill/mcp/tools:design_test --test_output=all
go_test(
    name = "design_test",
    size = "large",
    timeout = "long",
    srcs = ["design_test.go"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":tools",
        "//krill/api/handlers",
        "//krill/mcp/server",
        "//krill/migrate/schema",
        "//krill/slice",
        "//krill/store",
        "//libs/go/dbtest",
        "//libs/go/mcpauth",
        "//libs/go/migrate",
        "//libs/go/whagent",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
