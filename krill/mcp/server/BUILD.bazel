"""krill/mcp's bootstrap: *mcp.Server construction, the two-front-door
persona auth (mcpauth + whagent-net), and the streamable-HTTP transport
mounted at /mcp/spec."""

load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "server",
    srcs = [
        "auth.go",
        "registry.go",
        "server.go",
        "transport.go",
        "whagent_auth.go",
    ],
    importpath = "github.com/whale-net/everything/krill/mcp/server",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/logging",
        "//libs/go/mcpauth",
        "//libs/go/whagent",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)
