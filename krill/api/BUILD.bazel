"""krill HTTP server: /healthz + DB connectivity check (issue #2487), the
`init` session endpoint (issue #2489, FR3), the M1 entity write API
(issue #2490, FR1/FR2/FR4 -- create/attach only), the scoped-slice query
surface (FR5-FR9, issue #2491), and the pointer-artifact create endpoint
(issue #2496, FR20)."""

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "api_lib",
    srcs = [
        "main.go",
        "routes.go",
    ],
    importpath = "github.com/whale-net/everything/krill/api",
    visibility = ["//visibility:private"],
    deps = [
        "//krill/api/handlers",
        "//krill/forge",
        "//krill/slice",
        "//krill/store",
        "//libs/go/db",
        "//libs/go/logging",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
    ],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

# Release metadata. domain "krill" + name "api" matches the binary table in
# krill/README.md.
release_app(
    name = "api",
    binary_name = ":api",
    language = "go",
    domain = "krill",
    description = "krill HTTP server (/healthz, session init, the M1 entity write API, and the FR5-FR9 scoped-slice query surface)",
    app_type = "external-api",
    port = 8080,
)
