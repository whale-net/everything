"""krill api's HTTP handler layer. session.go (issue #2489, FR3) is the
`init` endpoint; gate.go is the write-only gate every mutating endpoint in
this milestone passes through. product.go/featureset.go/feature.go/
requirement.go/decision.go (issue #2490, FR1/FR2/FR4) are the entity
create/attach endpoints; types.go is their shared request-decoding and
error-mapping surface."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "handlers",
    srcs = [
        "decision.go",
        "feature.go",
        "featureset.go",
        "gate.go",
        "product.go",
        "requirement.go",
        "session.go",
        "types.go",
    ],
    importpath = "github.com/whale-net/everything/krill/api/handlers",
    visibility = ["//visibility:public"],
    deps = [
        "//krill/store",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)

# Unit tests for InitSessionHandler (session.go), RequireSession (gate.go),
# and the entity create/attach handlers (issue #2489's and #2490's Testing
# sections). fakeSessionStore/fake entity stores stand in for krill/store's
# interfaces, so none of this needs Postgres/network and it runs as part of
# `bazel test //...`.
go_test(
    name = "handlers_test",
    srcs = [
        "decision_test.go",
        "entity_test_helpers_test.go",
        "fake_entity_store_test.go",
        "fake_session_store_test.go",
        "feature_test.go",
        "featureset_test.go",
        "gate_test.go",
        "product_test.go",
        "requirement_test.go",
        "session_test.go",
    ],
    embed = [":handlers"],
    deps = [
        "//krill/store",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
