"""krill api's HTTP handler layer. session.go (issue #2489, FR3) is the
`init` endpoint; gate.go is the write-only gate every mutating endpoint in
this milestone passes through. product.go/featureset.go/feature.go/
requirement.go/decision.go (issue #2490, FR1/FR2/FR4) are the entity
create/attach endpoints; types.go is their shared request-decoding and
error-mapping surface. slice.go (issue #2491, FR5-FR9) is the read-only
HTTP surface over //krill/slice's four scoped-slice granularities -- thin
adapters only, no business logic; see slice.go's package doc comment.
amend.go (issue #2493, FR12) is the SCD2 supersession write endpoints for
Requirement and LoadBearingDecision, gated like every other write endpoint;
history.go (issue #2493, FR11) is the as-of/version-list read endpoints
over the same two entity kinds. Neither slice.go's nor history.go's routes
carry the write-only session gate. pointer.go (issue #2496, FR20) is the
pointer-artifact create endpoint -- the one handler in this package that
calls out to //krill/forge before it ever touches //krill/store.
design_session.go/revision_event.go (issue #2543, FR1-FR4/FR8) are the
DesignSession/RevisionEvent HTTP surface: both POST endpoints are gated,
GET /design-sessions/{id} is not; revision_event.go also owns the
Subject/EntityDelta/OpenQuestionsDelta wire types design_session.go's
GetDesignSessionHandler reuses. session_slice.go (issue #2544, krill M2,
FR5) is the HTTP surface over //krill/slice's fifth granularity,
GetEntitySetSlice -- also ungated. mediated.go (issue #2546, FR9/FR10/NFR2)
is the mediated-intake write endpoint, POST /design-sessions/{id}/propose --
gated like every other write endpoint. milestone_status.go (issue #2685,
FR8/FR9/FR12) is the milestone/milepebble status HTTP surface: POST
/milestones/{id}/status is gated, GET /milestones/{id}/status and GET
/milestones/{id}/status/history are not. delivery_shipment.go (issue
#2686, FR10) is the per-delivered-item shipment surface: POST
/milestones/{id}/shipped is gated, GET /milestones/{id}/delivery is
not. recut.go (issue #2687, FR5) is the delivery-axis re-cut surface:
POST /delivery/move is gated, GET /products/{id}/backlog is not.
task.go (issue #2719, FR1) is the work-axis task-create surface: POST
/tasks is gated behind RequireSession, mirroring every other write
endpoint above. task_dependency.go (issue #2720, FR2) is the work-axis
dependency-declaration surface: POST /tasks/{id}/dependencies is gated,
GET /tasks/{id}/dependencies is not. task_payload.go (issue #2721,
FR4/FR10) is the work-axis by-task-id fetch surface: GET /tasks/{id} is
ungated, over //krill/work's Assembler. task_claim.go (issue #2722,
FR3/FR5) is the work-axis claim surface: POST /tasks/{id}/claim is gated,
returning the same //krill/work Assembler payload task_payload.go's GET
/tasks/{id} does, enriched with the fresh lease."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

# The work-axis HTTP handler source files (issue #2719-#2727) this package
# added, exposed as source data so
# //krill/conformance:roundtrip_integration_test's NFR5 grep assertion
# (issue #2728) can read their real, committed content through Bazel
# runfiles -- mirrors store/BUILD.bazel's own identical filegroup for the
# store-layer half of the same audit.
filegroup(
    name = "work_axis_srcs",
    srcs = glob(["task*.go"], exclude = ["*_test.go"]),
    visibility = ["//krill/conformance:__pkg__"],
)

go_library(
    name = "handlers",
    srcs = [
        "abandon.go",
        "amend.go",
        "decision.go",
        "delivery_shipment.go",
        "design_session.go",
        "feature.go",
        "featureset.go",
        "gate.go",
        "history.go",
        "mediated.go",
        "milestone.go",
        "milestone_status.go",
        "open_questions.go",
        "pointer.go",
        "product.go",
        "recut.go",
        "requirement.go",
        "revision_event.go",
        "session.go",
        "session_slice.go",
        "slice.go",
        "task.go",
        "task_abandon.go",
        "task_claim.go",
        "task_complete.go",
        "task_dependency.go",
        "task_lease.go",
        "task_note.go",
        "task_payload.go",
        "task_reclaim.go",
        "types.go",
    ],
    importpath = "github.com/whale-net/everything/krill/api/handlers",
    visibility = ["//visibility:public"],
    deps = [
        "//krill/forge",
        "//krill/slice",
        "//krill/store",
        "//krill/work",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)

# Unit tests for InitSessionHandler (session.go), RequireSession (gate.go),
# the entity create/attach handlers (issue #2489's and #2490's Testing
# sections), the four slice query endpoints (slice.go, issue #2491's
# Testing section), the two amend endpoints (amend_test.go, issue #2493's
# Testing section: gated like every other write path, calls AmendStore with
# the path's {id} and the body's name/body unchanged), the DesignSession/
# RevisionEvent HTTP surface (design_session_test.go/revision_event_test.go,
# issue #2543's Testing section: both POST endpoints gated, GET
# /design-sessions/{id} not, FR3/FR4's conditional-presence rules mapped to
# 400), SessionSlice's union-and-dedupe logic (session_slice_test.go,
# issue #2544's Testing section), and the work-axis task-create endpoint
# (task_test.go, issue #2719's Testing section: session-derived scope_id/
# subject-pair pass-through, field validation, CreateTask's named FR1
# rejections mapped to 400, and the NFR6 no-session-header 401), and the
# work-axis dependency-declaration surface (task_dependency_test.go, issue
# #2720's Testing section: the same session-derived pass-through/
# validation/named-rejection/NFR6 shape as task_test.go, plus the ungated
# GET /tasks/{id}/dependencies read).
# fakeSessionStore/fake entity stores/fakeAmendStore/fakeDesignSessionStore/
# fakeRevisionEventStore/fakeEntitySetQuerier/fakeTaskStore stand in for
# krill/store's (and krill/slice's) interfaces, so none of this needs
# Postgres/network and it runs as part of `bazel test //...`.
# slice_internal_test.go is package handlers (white-box, needs the
# unexported sliceQueryFunc/handle); everything else here is package
# handlers_test (black-box).
go_test(
    name = "handlers_test",
    srcs = [
        "abandon_test.go",
        "amend_test.go",
        "decision_test.go",
        "delivery_shipment_test.go",
        "design_session_test.go",
        "entity_test_helpers_test.go",
        "fake_abandon_store_test.go",
        "fake_delivery_shipment_store_test.go",
        "fake_design_session_store_test.go",
        "fake_entity_store_test.go",
        "fake_mediated_store_test.go",
        "fake_milestone_status_store_test.go",
        "fake_recut_store_test.go",
        "fake_session_slice_stores_test.go",
        "fake_session_store_test.go",
        "fake_task_store_test.go",
        "feature_test.go",
        "featureset_test.go",
        "gate_test.go",
        "mediated_test.go",
        "milestone_delivery_test.go",
        "milestone_status_test.go",
        "open_questions_test.go",
        "pointer_test.go",
        "product_test.go",
        "recut_test.go",
        "requirement_test.go",
        "revision_event_test.go",
        "session_slice_test.go",
        "session_test.go",
        "slice_internal_test.go",
        "slice_test.go",
        "task_abandon_test.go",
        "task_claim_test.go",
        "task_complete_test.go",
        "task_dependency_test.go",
        "task_lease_test.go",
        "task_note_test.go",
        "task_payload_test.go",
        "task_reclaim_test.go",
        "task_test.go",
    ],
    embed = [":handlers"],
    deps = [
        "//krill/slice",
        "//krill/store",
        "//krill/work",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Real-Postgres coverage for GetTaskPayloadHandler's full success path
# (task_payload_integration_test.go, issue #2721's Testing section) -- the
# one branch task_payload_test.go's fakes cannot reach, since
# work.Assembler wraps a concrete *slice.Querier over a real *store.Store.
# Deliberately NOT part of `bazel test //...` -- see //libs/go/dbtest's
# README, mirrored by //krill/slice:query_integration_test.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //krill/api/handlers:task_payload_integration_test --test_output=all
go_test(
    name = "task_payload_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["task_payload_integration_test.go"],
    embed = [":handlers"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//krill/migrate/schema",
        "//krill/slice",
        "//krill/store",
        "//krill/work",
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

