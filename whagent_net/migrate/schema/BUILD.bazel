load("@rules_go//go:def.bzl", "go_library", "go_test")

# Embeds the real golang-migrate SQL so both the migration binary
# (//whagent_net/migrate) and Postgres integration tests (e.g.
# //whagent_net/session) apply the exact same schema instead of
# maintaining separate copies. See schema.go for why the embed directive
# uses "all:migrations" instead of a "*.sql" glob (audience_score_system's
# migrate/schema/schema.go explains: go:embed errors at compile time on a
# glob matching nothing, so "all:" is used defensively here too).
go_library(
    name = "schema",
    srcs = ["schema.go"],
    embedsrcs = glob(
        ["migrations/*"],
        allow_empty = True,
    ),
    importpath = "github.com/whale-net/everything/whagent_net/migrate/schema",
    visibility = ["//visibility:public"],
)

# Trivial test asserting the embed FS resolves Dir without error and
# contains migration 001's files.
go_test(
    name = "schema_test",
    srcs = ["schema_test.go"],
    embed = [":schema"],
)

# Real Postgres integration test proving migration 001 (issue #2109's whole
# schema) applies cleanly, reverses to a clean database, and is re-runnable
# -- plus the specific column-shape assertions the issue's Validation
# section calls out by name (NFR3, NFR6, LB6, LB1). Deliberately NOT part
# of `bazel test //...` -- see //libs/go/dbtest's README for the full
# rationale behind each tag and how to run tests like this one.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //whagent_net/migrate/schema:schema_integration_test --test_output=all
go_test(
    name = "schema_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "delegatedgrant_integration_test.go",
        "mcpauth_cutover_integration_test.go",
        "schema_integration_test.go",
    ],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":schema",
        "//libs/go/dbtest",
        "//libs/go/grpcauth",
        "//libs/go/grpcauth/grantindex",
        "//libs/go/grpcauth/pgstore",
        "//libs/go/mcpauth",
        "//libs/go/migrate",
        "//whagent_net/mcp/server",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
