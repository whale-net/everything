load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "migrate_lib",
    srcs = ["main.go"],
    embedsrcs = [
        "migrations/001_initial_schema.down.sql",
        "migrations/001_initial_schema.up.sql",
    ],
    importpath = "github.com/whale-net/everything/whagent_net/migrate",
    visibility = ["//visibility:private"],
    deps = ["//libs/go/migrate"],
)

go_binary(
    name = "migrate",
    embed = [":migrate_lib"],
    visibility = ["//visibility:public"],
)

# Release metadata for the migration job (issue #2109). domain
# "whagent-net" + name "migrate" matches the binary table in
# whagent_net/README.md.
release_app(
    name = "migrate",
    binary_name = ":migrate",
    language = "go",
    domain = "whagent-net",
    description = "whagent-net session store database migration runner",
    app_type = "job",
)
