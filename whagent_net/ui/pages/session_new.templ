package pages

import (
	"github.com/whale-net/everything/whagent_net/ui/components"
)

// AgentOption is one entry in the new-session agent dropdown.
type AgentOption struct {
	AgentID string
	Model   string
}

// SessionNewData carries SessionNew's page-level parameterisation.
// AgentID/ModelOverride echo the submitted values on a rejection;
// AgentsError is set when ListAgents failed.
type SessionNewData struct {
	Layout        components.LayoutData
	Agents        []AgentOption
	AgentsError   string
	AgentID       string
	ModelOverride string
	Error         string
}

// SessionNew is the start-session form (GET /sessions/new): a plain POST
// to /sessions with the agent chosen from the current ListAgents result.
templ SessionNew(data SessionNewData) {
	@components.Layout(data.Layout) {
		<h1 class="text-2xl font-bold text-base-content mb-4">Start a session</h1>
		if data.Error != "" {
			<div role="alert" class="alert alert-error mb-4">{ data.Error }</div>
		}
		if data.AgentsError != "" {
			<div role="alert" class="alert alert-error mb-4">{ data.AgentsError }</div>
		}
		<form method="POST" action="/sessions" class="flex flex-col gap-3 max-w-md">
			<label class="form-control">
				<span class="label-text">Agent</span>
				<select name="agent_id" required disabled?={ len(data.Agents) == 0 } class="select select-bordered w-full">
					for _, a := range data.Agents {
						<option value={ a.AgentID } selected?={ a.AgentID == data.AgentID }>{ a.AgentID } ({ a.Model })</option>
					}
				</select>
			</label>
			if len(data.Agents) == 0 && data.AgentsError == "" {
				<p class="text-sm text-base-content/70">No agents are defined. <a href="/agents" class="link">Create one on the Agents page.</a></p>
			}
			<label class="form-control">
				<span class="label-text">Model override (optional)</span>
				<input type="text" name="model_override" value={ data.ModelOverride } class="input input-bordered w-full"/>
			</label>
			<button type="submit" class="btn btn-primary" disabled?={ len(data.Agents) == 0 }>Start session</button>
		</form>
	}
}
