package pages

import (
	"github.com/whale-net/everything/whagent_net/ui/components"
)

// MCPConsentData carries MCPConsent's page-level parameterisation (FR2/FR3/
// FR6, issue #2428): Domain names the AgentDefinition.Domain (issue #2424's
// FR1) this consent step is for -- resolved and validated by the caller
// (handlers_consent.go's grantkey.ForDomain check), never inferred by this
// page itself, matching FR2's "names that domain (via AgentDefinition.Domain
// ... never inferred from agent_id, required_role, or server_url)"
// requirement. ReturnTo is echoed back as a hidden form field so
// handleMCPConsentConfirm can carry it through DelegatedGrantSource.
// BeginAuthorization's Keycloak redirect and back to
// handleMCPConsentCallback. Failure, when set, replaces the confirm form
// with a plain failure message and a retry link -- FR2's "If consent is
// declined or CompleteAuthorization fails ... the operator sees a clear
// failure page" requirement.
type MCPConsentData struct {
	Layout   components.LayoutData
	Domain   string
	ReturnTo string
	Failure  string
}

// MCPConsent is FR2/FR6's explicit per-domain consent step. It always names
// Domain and always renders this confirm step -- there is no session-age,
// "already signed in", or "already consented for a different domain"
// shortcut here or in its handler (handlers_consent.go's
// authorizeConsentGate/handleMCPConsent): every domain access requires its
// own consent (FR3/FR5/FR6).
templ MCPConsent(data MCPConsentData) {
	@components.Layout(data.Layout) {
		<h1 class="text-2xl font-bold text-base-content mb-4">Grant access</h1>
		if data.Failure != "" {
			<div role="alert" class="alert alert-error mb-4">{ data.Failure }</div>
			<a href={ templ.URL("/mcp/consent?domain=" + data.Domain) } class="btn btn-secondary">Try again</a>
		} else {
			<p class="mb-4">
				An MCP client is requesting standing access to act on your behalf
				against <strong>{ data.Domain }</strong>'s agent. Granting access
				applies to <strong>{ data.Domain }</strong> only -- it does not grant
				access to any other domain, and no credential is issued until you
				confirm.
			</p>
			<form method="POST" action="/mcp/consent" class="flex gap-2">
				<input type="hidden" name="domain" value={ data.Domain }/>
				<input type="hidden" name="return_to" value={ data.ReturnTo }/>
				<button type="submit" class="btn btn-primary">Grant access to { data.Domain }</button>
			</form>
		}
	}
}
