package pages

import (
	"github.com/whale-net/everything/whagent_net/ui/components"
)

// Index is a placeholder authenticated page (issue #2236's scope): it
// renders the shared shell and the signed-in operator's identity. No
// session pages exist yet -- those land in later tasks under plan #2233
// (FR1-FR4).
templ Index(data components.LayoutData) {
	@components.Layout(data) {
		<h1 class="text-3xl font-bold text-base-content mb-4">whagent-net</h1>
		if data.User != nil {
			<p class="text-base-content/80">
				Signed in as
				<span class="font-semibold">{ identityLabel(data.User.Name, data.User.PreferredUsername) }</span>.
			</p>
		} else {
			<p class="text-base-content/80">Not signed in.</p>
		}
		<p class="text-base-content/60 mt-4">Session pages are not built yet -- this is the M2 scaffold's placeholder index (issue #2236).</p>
	}
}

// identityLabel prefers Name, falling back to PreferredUsername when Name
// is empty (a token missing the optional "name" claim still has
// "preferred_username").
func identityLabel(name, preferredUsername string) string {
	if name != "" {
		return name
	}
	return preferredUsername
}
