package pages

import (
	"github.com/whale-net/everything/whagent_net/ui/components"
)

// LinkASSResultData carries LinkASSResult's page-level parameterisation
// (FR10, issue #2596). Heading/Message/Success are resolved by
// ../handlers_link.go's linkASSResultMessage from the raw "outcome" query
// parameter ASS `web`'s redirect back to GET /link/ass/result carries --
// this page never parses that value itself. Success is false for every
// outcome except the two the Operator should read as good news ("linked",
// "already_linked") -- an unrecognized or absent outcome always resolves
// to Success == false (see linkASSResultMessage's default branch).
type LinkASSResultData struct {
	Layout  components.LayoutData
	Heading string
	Message string
	Success bool
}

// LinkASSResult is FR10's outcome page (issue #2596): the page ASS `web`
// redirects the Operator's browser back to once handleLinkASSStart's
// assertion has been consumed. Renders one of four distinct messages
// (linked / already linked / conflict / rejected) plus a generic failure
// for anything else -- Success controls only the visual styling
// (alert-success vs alert-error), never which message is shown.
templ LinkASSResult(data LinkASSResultData) {
	@components.Layout(data.Layout) {
		<h1 class="text-2xl font-bold text-base-content mb-4">Link ASS identity</h1>
		if data.Success {
			<div role="status" class="alert alert-success">
				<div>
					<h2 class="font-bold">{ data.Heading }</h2>
					<p>{ data.Message }</p>
				</div>
			</div>
		} else {
			<div role="alert" class="alert alert-error">
				<div>
					<h2 class="font-bold">{ data.Heading }</h2>
					<p>{ data.Message }</p>
				</div>
			</div>
		}
		<a class="btn btn-sm btn-primary mt-4" href="/grants">Back to grants</a>
	}
}
