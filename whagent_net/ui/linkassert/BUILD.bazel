"""`ui`'s link-assertion signing key, JWKS endpoint, and minting helper
(FR2, NFR1, NFR6, issue #2595) -- a purpose-built asymmetric key distinct
from `api`/`worker`'s persona-credential key (WHAGENT_SIGNING_KEY), see
linkassert.go's package doc comment."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "linkassert",
    srcs = ["linkassert.go"],
    importpath = "github.com/whale-net/everything/whagent_net/ui/linkassert",
    visibility = ["//whagent_net/ui:__subpackages__"],
    deps = [
        "//libs/go/whagent",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "linkassert_test",
    srcs = ["linkassert_test.go"],
    embed = [":linkassert"],
    deps = [
        "//libs/go/whagent",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
    ],
)
