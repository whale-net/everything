package components

import (
	"bytes"
	"encoding/json"
	"fmt"
	"html"
	"strings"
	"time"

	"github.com/whale-net/everything/libs/go/htmxui"
	"github.com/yuin/goldmark"
	"github.com/yuin/goldmark/extension"
)

// chatMarkdown enables GFM (tables, strikethrough, autolinks) on top of
// goldmark's CommonMark-only default -- without it, pipe-table syntax in
// chat messages falls through as a plain paragraph instead of a table.
var chatMarkdown = goldmark.New(goldmark.WithExtensions(extension.GFM))

// SubjectView is a plain (iss, sub, kind) identity triple for rendering --
// mirrors whagentpb.Subject's three fields without this rendering layer
// importing the proto package directly (LayoutData follows the same
// plain-struct convention; ../convert.go does the pb -> view conversion).
type SubjectView struct {
	Iss  string
	Sub  string
	Kind string // "human" | "service" | "unspecified"
}

// SessionView is a plain rendering-ready projection of whagentpb.Session
// (FR2/FR3/NFR3). CapKind/ErrorCategory/ErrorDetail are empty (never a
// zero-value placeholder) unless State is the matching terminal value --
// mirrors whagentpb.Session's has_cap_kind/has_error_category optionality.
type SessionView struct {
	SessionID     string
	State         string // sessionStateString's lowercase convention (../convert.go)
	AgentID       string
	Model         string
	Subject       SubjectView
	OnBehalfOf    SubjectView
	CapKind       string
	ErrorCategory string
	ErrorDetail   string
	CreatedAt     time.Time
	UpdatedAt     time.Time
}

// TranscriptEventView is a plain rendering-ready projection of one
// TranscriptEvent -- whagentpb.TranscriptEvent (ReadTranscript) or
// whagent_net/events.Event (the SSE bus, ../handlers_session_live.go) --
// event_id, seq, turn, type, payload, committed_at, exactly session.proto's
// TranscriptEvent field set (FR2).
type TranscriptEventView struct {
	EventID     string
	Seq         int64
	Turn        int32
	Type        string
	Payload     []byte
	CommittedAt time.Time
}

// SessionDetailData carries SessionDetail's page-level parameterisation
// (FR2/NFR2/NFR3/NFR4).
type SessionDetailData struct {
	Layout  LayoutData
	Session SessionView
	Events  []TranscriptEventView
	// Usage is FR4's initial-render usage figures (../handlers_session.go's
	// readUsage) -- the same GetSessionUsage-backed value
	// ../handlers_session_usage_live.go's sessionUsageFragment re-reads on
	// every live update, so the two can never disagree about how a
	// SessionUsage is projected for rendering.
	Usage UsageView

	// IsOwner gates the composer/stop-control slot (LB2's (iss,sub) match
	// against Session.OnBehalfOf, computed by the handler -- never here).
	// A non-owner's rendered response must contain no composer/stop
	// markup at all, not merely disabled CSS (issue #2242's Implementation
	// section) -- so this templ's owner branch is the only place that
	// markup is ever emitted, never conditionally hidden with CSS.
	IsOwner bool

	// Topics is this session's htmxsse topic set (../handlers_session_live.go's
	// sessionEventTopics), computed once by the handler and threaded
	// through here so the sse-swap attribute below can never drift from
	// what handleSessionEvents actually subscribes to.
	Topics []string

	// UsageTopics is the usage panel's own, narrower htmxsse topic set
	// (../handlers_session_usage_live.go's sessionUsageTopics) -- see that
	// function's doc comment for why it is not simply Topics reused.
	UsageTopics []string
}

// stateBadgeVariant maps a SessionView.State string onto htmxui's generic
// Badge colour vocabulary -- domain semantics stay here, not in htmxui
// (badge.templ's doc comment, "repo-generic only, no proto/domain deps").
func stateBadgeVariant(state string) htmxui.BadgeVariant {
	switch state {
	case "running", "awaiting_input":
		return htmxui.BadgeInfo
	case "done":
		return htmxui.BadgeSuccess
	case "stopped":
		return htmxui.BadgeNeutral
	case "capped":
		return htmxui.BadgeWarning
	case "failed":
		return htmxui.BadgeError
	default:
		return htmxui.BadgeGhost
	}
}

// stateBadge renders SessionView.State as an htmxui.Badge, with an
// `id="session-state-badge"` for readability/testability. It is rendered
// inside SessionLive, the same element the SSE stream swaps as a whole
// (../handlers_session_live.go's sessionTranscriptFragment re-reads the
// session on every delivery and renders this alongside the transcript), so
// it is never stale relative to the transcript it sits beside. While
// running, an adjacent spinner signals live activity to any viewer (FR4/
// FR5 -- not gated behind IsOwner); every other state is unchanged. htmxui.
// Badge has no children/slot support and is reused repo-wide, so the
// spinner sits beside it rather than inside (manmanv2/ui/pages/
// game_detail.templ's overviewStatusBadge is the same pattern).
templ stateBadge(state string) {
	<span class="inline-flex items-center gap-2">
		if state == "running" {
			<span class="loading loading-spinner loading-xs" aria-hidden="true"></span>
		}
		@htmxui.Badge(state, stateBadgeVariant(state), htmxui.BadgeSizeMD, true, templ.Attributes{"id": "session-state-badge"})
	</span>
}

// startedByLine renders NFR3's "started by" line directly from
// Session.Subject/OnBehalfOf and their Kind -- no display-name table, no
// UI-local identity model. Shows both identities only when they differ
// (on_behalf_of != subject, a delegated-caller session -- ARCHITECTURE.md
// "Identity and auth chaining"); M1 has no such path yet, so this is
// forward-compatible dead code today, not exercised markup.
templ startedByLine(sess SessionView) {
	<p class="text-base-content/70 text-sm mb-2">
		Started by
		<span class="font-mono">{ sess.OnBehalfOf.Sub }</span>
		<span class="badge badge-ghost badge-xs align-middle">{ sess.OnBehalfOf.Kind }</span>
		if sess.OnBehalfOf.Sub != sess.Subject.Sub || sess.OnBehalfOf.Iss != sess.Subject.Iss {
			<span class="text-base-content/50">
				(on behalf of by
				<span class="font-mono">{ sess.Subject.Sub }</span>)
			</span>
		}
	</p>
}

// sessionTopicsAttr joins topics into htmx-ext-sse's comma-separated
// sse-swap value.
func sessionTopicsAttr(topics []string) string {
	return strings.Join(topics, ",")
}

// SessionDetail is the session detail page (FR2, NFR2, NFR3): initial
// render from data.Session/data.Events, then live via hx-ext="sse" bound to
// /sessions/{id}/events (../handlers_session_live.go). The composer/stop
// slot (FR1, issue #2246) is filled with OwnerControls only inside the
// data.IsOwner branch -- a non-owner's response contains this branch, and
// therefore any composer/stop markup, nowhere at all. The state badge and
// any terminal-state banner are *inside* the swapped div (SessionLive), not
// here, so they swap live alongside the transcript rather than only
// reflecting this initial render.
//
// The usage panel (FR4, issue #2248) is its own SSE-connected region,
// separate from #transcript's, deliberately: htmx's SSE extension swaps an
// element with the literal data payload of the named event it is listening
// for, so two differently-rendered regions cannot share one topic's
// delivery without an out-of-band swap this codebase does not otherwise use
// (see ../handlers_session_usage_live.go's doc comment) -- a second,
// narrower-topic SSE connection is the simpler, more explicit alternative.
templ SessionDetail(data SessionDetailData) {
	@Layout(data.Layout) {
		<h1 class="text-2xl font-bold text-base-content mb-2">Session { data.Session.SessionID }</h1>
		@startedByLine(data.Session)
		<div
			id="usage-slot"
			class="mb-4"
			hx-ext="sse"
			sse-connect={ fmt.Sprintf("/sessions/%s/usage-events", data.Session.SessionID) }
			sse-swap={ sessionTopicsAttr(data.UsageTopics) }
		>
			@SessionUsage(data.Session, data.Usage)
		</div>
		<div
			id="transcript"
			hx-ext="sse"
			sse-connect={ fmt.Sprintf("/sessions/%s/events", data.Session.SessionID) }
			sse-swap={ sessionTopicsAttr(data.Topics) }
		>
			@SessionLive(data.Session, data.Events)
		</div>
		if data.IsOwner {
			<!-- FR1 (session lifecycle controls, issue #2246): the turn
			     composer and stop control, docked directly under the chat
			     window and stuck to the bottom of the viewport on scroll,
			     matching the input bar under the message list convention
			     every mainstream AI chat UI uses; see OwnerControls' doc
			     comment for why the composer's own id/hx-target wiring is
			     unaffected by moving this slot down the page. A non-owner
			     never reaches this branch, so no composer/stop markup
			     exists in their response at all. -->
			<div id="composer-slot" class="sticky bottom-4 z-10 pt-2">
				@OwnerControls(data.Session.SessionID, data.Session.State)
			</div>
		}
	}
}

// reconcileTerminalState overrides session's DB-read state with the
// state implied by evs's last event, when that event is a capped/
// failure/status_change event and session.State does not already report
// it -- closes the race where a live SSE delivery triggered by that
// event's own publish renders before the session's separate
// terminal-status DB write has landed (issue #2776, extended to FR1's
// status_change:<status> events by issue #2796). evs is always
// Seq-ordered and a capped/failure/status_change event is always a
// session's last transcript event (nothing commits after a session goes
// terminal, and status_change:running/awaiting_input precede whatever
// comes next in the same turn), so the event's mere presence is
// authoritative regardless of what the DB read currently says.
func reconcileTerminalState(session SessionView, evs []TranscriptEventView) SessionView {
	if len(evs) == 0 {
		return session
	}
	last := evs[len(evs)-1]
	switch eventTypePrefix(last.Type) {
	case "capped":
		if session.State == "capped" {
			return session
		}
		payload, err := decodeCappedPayload(last.Payload)
		if err != nil {
			return session
		}
		session.State = "capped"
		session.CapKind = payload.CapKind
	case "failure":
		if session.State == "failed" {
			return session
		}
		payload, err := decodeFailurePayload(last.Payload)
		if err != nil {
			return session
		}
		session.State = "failed"
		session.ErrorCategory = payload.ErrorCategory
		session.ErrorDetail = payload.ErrorDetail
	case "status_change":
		status, ok := strings.CutPrefix(last.Type, "status_change:")
		if !ok || status == "" || status == session.State {
			return session
		}
		session.State = status
	}
	return session
}

// SessionLive renders the portion of the session detail page that swaps
// live on every SSE delivery (FR2, Implementation: "swaps transcript
// fragments and the state badge on each SSE event"): the state badge, an
// optional terminal-state banner, and the transcript, in that order. Used
// both for SessionDetail's initial render and, verbatim, by
// ../handlers_session_live.go's sessionTranscriptFragment.Render for every
// later delivery -- the two can never disagree about what a given
// (session, events) pair renders as.
templ SessionLive(session SessionView, evs []TranscriptEventView) {
	{{ session = reconcileTerminalState(session, evs) }}
	<div class="flex items-center gap-3 mb-2">
		@stateBadge(session.State)
	</div>
	if session.State == "capped" && session.CapKind != "" {
		<p class="text-sm text-warning mb-2">Capped: { session.CapKind }</p>
	}
	if session.State == "failed" {
		<p class="text-sm text-error mb-2">
			Failed
			if session.ErrorCategory != "" {
				({ session.ErrorCategory })
			}
			if session.ErrorDetail != "" {
				: { session.ErrorDetail }
			}
		</p>
	}
	@TranscriptList(evs)
}

// isTerminalSessionState reports whether state is one of the four
// terminal SessionState values (sessionStateString's lowercase
// convention, ../convert.go) -- a session in any of these has no running
// SessionWorkflow left to signal (whagent_net/api/handlers/stop.go's
// StopSession doc comment), so FR1's stop control has nothing left to do
// for the owner and is omitted entirely rather than rendered disabled.
func isTerminalSessionState(state string) bool {
	switch state {
	case "done", "stopped", "failed", "capped":
		return true
	default:
		return false
	}
}

// composerFormID/stopControlID are the fixed element ids Composer's and
// StopControl's own hx-target self-swap depend on --
// ../handlers_session_lifecycle.go's handleSendTurn/handleStopSession
// render these same templs (or StopControlAbsent) back as the swap
// payload, so the id here and the id in the response fragment can never
// drift apart.
const (
	composerFormID = "turn-composer"
	stopControlID  = "stop-control"
)

// OwnerControls is FR1's composer/stop-control slot content (issue
// #2246), mounted into SessionDetail's owner-only composer-slot div,
// itself now docked to the bottom of the page (SessionDetail's doc
// comment). Stop is a small, secondary control tucked above the primary
// input bar -- mainstream chat UIs keep exactly one prominent control in
// the input row (send) and push anything destructive/occasional out of
// it -- and is omitted for an already-terminal session
// (isTerminalSessionState); the composer is always rendered so a race
// (the session turns terminal between page load and submit) still gets a
// real inline error from handleSendTurn rather than a control that
// silently vanished mid-typing.
templ OwnerControls(sessionID string, state string) {
	<div class="flex flex-col gap-1">
		if !isTerminalSessionState(state) {
			<div class="flex justify-end">
				@StopControl(sessionID, "")
			</div>
		}
		@Composer(sessionID, "")
	</div>
}

// sendIcon is the composer's submit button glyph -- a plain up-arrow, the
// send-button convention shared by every mainstream AI chat UI today.
// Hand-written inline (mirrors manmanv2/ui/components/layout.templ's own
// inline-SVG buttons) rather than routed through htmxui.Button, which has
// no icon-only/circular variant to hang this on.
templ sendIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
		<path d="M12 19V5"></path>
		<path d="M5 12l7-7 7 7"></path>
	</svg>
}

// Composer is FR1's turn-composer form (issue #2246): POSTs to
// /sessions/{id}/turns and swaps itself (hx-target="this",
// hx-swap="outerHTML") with whatever handleSendTurn renders back -- an
// empty, enabled Composer on success. SendTurn is asynchronous by
// contract (session.proto's SendTurn doc comment: the call returns once
// the turn is accepted, not once it completes), so there is nothing more
// to show here on success -- the turn's actual output surfaces through
// the live transcript (SessionLive), never through this form. A failed
// submission (e.g. FailedPrecondition for a terminal session) re-renders
// this same form with errMsg inline instead (FR1's "Error surfacing").
//
// Styled as a single rounded pill (the ChatGPT/Claude.ai/Gemini input-bar
// convention) with a circular icon-only send button -- no "Send" label,
// matching that same minimalist convention -- plus an inline script for
// auto-growing the textarea as its content wraps and Enter-to-send
// (Shift+Enter for a literal newline). The script re-attaches on every
// render of this fragment, not just the page's first load: htmx
// evaluates <script> tags it encounters in swapped content (documented
// htmx behaviour), and this form is itself an hx-swap="outerHTML" target,
// so a failed-submission round trip needs the same behaviour rewired
// into the fresh textarea it just rendered, not only the original one.
templ Composer(sessionID string, errMsg string) {
	<form
		id={ composerFormID }
		hx-post={ fmt.Sprintf("/sessions/%s/turns", sessionID) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		if errMsg != "" {
			<div role="alert" class="alert alert-error mb-2">{ errMsg }</div>
		}
		<div class="flex items-end gap-2 rounded-3xl border border-base-300 bg-base-100 shadow-sm p-2 pl-4">
			<textarea
				name="input"
				rows="1"
				autofocus
				class="textarea textarea-ghost w-full resize-none focus:outline-none min-h-10 max-h-52 py-2 px-0 leading-6"
				placeholder="Send a message..."
				required
			></textarea>
			<button type="submit" class="btn btn-circle btn-primary btn-sm shrink-0" aria-label="Send message">
				@sendIcon()
			</button>
		</div>
	</form>
	<script>
		(function() {
			var form = document.getElementById("turn-composer");
			if (!form) { return; }
			var ta = form.querySelector('textarea[name="input"]');
			if (!ta) { return; }
			var autosize = function() {
				ta.style.height = "auto";
				ta.style.height = Math.min(ta.scrollHeight, 208) + "px";
			};
			ta.addEventListener("input", autosize);
			autosize();
			ta.addEventListener("keydown", function(e) {
				if (e.key === "Enter" && !e.shiftKey) {
					e.preventDefault();
					if (ta.value.trim() !== "") {
						form.requestSubmit();
					}
				}
			});
			ta.focus();
		})();
	</script>
}

// StopControl is FR1's stop control (issue #2246): POSTs to
// /sessions/{id}/stop and swaps its own `#stop-control` wrapper with
// whatever handleStopSession renders back -- StopControlAbsent on success
// (the control has nothing left to do once the session is stopped, so it
// disappears entirely rather than rendering disabled -- mirrors
// isTerminalSessionState's "omitted, not disabled" stance), or itself
// again carrying errMsg inline on failure. Rendered small/ghost (not a
// solid error-coloured button) since OwnerControls now places it as a
// secondary control above the primary composer, not beside it.
templ StopControl(sessionID string, errMsg string) {
	<div id={ stopControlID }>
		if errMsg != "" {
			<div role="alert" class="alert alert-error mb-2">{ errMsg }</div>
		}
		<form
			hx-post={ fmt.Sprintf("/sessions/%s/stop", sessionID) }
			hx-target={ "#" + stopControlID }
			hx-swap="outerHTML"
		>
			<button type="submit" class="btn btn-ghost btn-xs text-error">Stop session</button>
		</form>
	</div>
}

// StopControlAbsent is handleStopSession's success-swap payload: the same
// `#stop-control` id with no button inside, so a second click has nothing
// left to act on (StopControl's doc comment).
templ StopControlAbsent() {
	<div id={ stopControlID }></div>
}

// chatWindowID is the scrollable transcript pane's fixed id -- the
// auto-scroll script at the end of TranscriptList looks it up by this id
// on every render (initial page load and every SSE-delivered swap alike,
// since TranscriptList is re-emitted wholesale each time -- see this
// templ's own doc comment), so a newly delivered message is always
// scrolled into view without depending on any particular htmx event name.
const chatWindowID = "chat-window"

// TranscriptList renders evs (already in seq order, LB1) as the
// transcript's full current state -- this is the swap target every SSE
// delivery replaces wholesale (../handlers_session_live.go's
// sessionTranscriptFragment, ARCHITECTURE.md "full-state, not deltas --
// matching htmxsse's fragment-swap model"). A status_change:<status>
// event is skipped entirely rather than routed into EventRow -- it exists
// only to drive reconcileTerminalState's badge reconciliation (FR3), never
// to populate a transcript content row (issue #2796).
//
// Rendered as a bounded, scrollable chat pane (the "chat window" look) --
// message bubbles for user/assistant turns, collapsed-by-default rows for
// tool calls/results (see toolCallRow/toolResultRow), and plain banners
// for capped/failure events. The trailing inline script re-runs on every
// swap (htmx evaluates <script> tags it encounters in swapped content) and
// simply scrolls #chat-window to its own bottom -- no MutationObserver or
// htmx-event wiring needed, since a full re-render already happens on
// every delivery.
templ TranscriptList(evs []TranscriptEventView) {
	<div id={ chatWindowID } class="flex flex-col gap-3 max-h-[65vh] overflow-y-auto rounded-box border border-base-300 bg-base-100 p-4">
		for _, ev := range evs {
			if eventTypePrefix(ev.Type) != "status_change" {
				@EventRow(ev)
			}
		}
	</div>
	<script>
		(function() {
			var el = document.getElementById("chat-window");
			if (el) { el.scrollTop = el.scrollHeight; }
		})();
	</script>
}

// eventTypePrefix reports the FR2 category a transcript event's Type
// belongs to: the four session-lifecycle types are matched verbatim,
// tool_call/tool_result/status_change by prefix (events.go's
// EventTypeToolCall/EventTypeToolResult/EventTypeStatusChange doc
// comments: the committed type is "tool_call:<call_index>"/
// "tool_result:<call_index>"/"status_change:<status>", never the bare
// constant, so a consumer must match by prefix, not equality).
func eventTypePrefix(eventType string) string {
	switch {
	case eventType == "user_message":
		return "user_message"
	case eventType == "assistant_message":
		return "assistant_message"
	case eventType == "capped":
		return "capped"
	case eventType == "failure":
		return "failure"
	case strings.HasPrefix(eventType, "tool_call:"):
		return "tool_call"
	case strings.HasPrefix(eventType, "tool_result:"):
		return "tool_result"
	case strings.HasPrefix(eventType, "status_change:"):
		return "status_change"
	default:
		return "unknown"
	}
}

// messageEventPayload mirrors worker/context.go's unexported
// transcriptMessagePayload wire shape -- a second, independent copy of
// the JSON contract for the same reason mcp/tools/convert.go keeps its
// own enum-string tables (worker's type is unexported, and this consumer
// must not take a dependency on the worker binary's internals).
type messageEventPayload struct {
	Role    string `json:"role"`
	Content string `json:"content,omitempty"`
}

// toolCallEventPayload mirrors worker/context.go's unexported
// toolCallEventPayload wire shape (see messageEventPayload's doc comment).
type toolCallEventPayload struct {
	Name      string `json:"name"`
	Arguments string `json:"arguments"`
}

// toolResultEventPayload mirrors worker/context.go's unexported
// toolResultEventPayload wire shape (see messageEventPayload's doc
// comment). IsError is the domain server's own flag -- rendered as an
// ordinary tool result, never as the session's own failure (FR2's
// boundary, worker/tools/dispatch.go's "isError is not a whagent-net
// failure").
type toolResultEventPayload struct {
	Name    string `json:"name"`
	Content string `json:"content"`
	IsError bool   `json:"is_error"`
}

// cappedEventPayload mirrors worker/caps.go's unexported
// cappedEventPayload wire shape (see messageEventPayload's doc comment).
type cappedEventPayload struct {
	CapKind string `json:"cap_kind"`
}

// failureEventPayload mirrors worker/workflow.go's unexported
// failureEventPayload wire shape (see messageEventPayload's doc comment).
type failureEventPayload struct {
	ErrorCategory string `json:"error_category"`
	ErrorDetail   string `json:"error_detail"`
}

// EventRow renders one transcript event per its FR2 type category. An
// unparseable payload renders the row with a decode-error note rather
// than failing the whole fragment -- one malformed event must never blank
// the rest of the transcript. data-event-id/data-seq stay on every row
// (message bubble, collapsed tool row, or banner alike) so the transcript
// remains inspectable/testable by event regardless of which visual shape
// a given type renders as.
templ EventRow(ev TranscriptEventView) {
	<div data-event-id={ ev.EventID } data-seq={ fmt.Sprintf("%d", ev.Seq) }>
		switch eventTypePrefix(ev.Type) {
			case "user_message":
				@messageRow("user", "You", ev)
			case "assistant_message":
				@messageRow("assistant", "Assistant", ev)
			case "tool_call":
				@toolCallRow(ev)
			case "tool_result":
				@toolResultRow(ev)
			case "capped":
				@cappedRow(ev)
			case "failure":
				@failureRow(ev)
			default:
				<p class="text-base-content/60 text-sm">Unrecognized event type: { ev.Type }</p>
		}
	</div>
}

// renderMarkdown converts a transcript message's raw text into sanitized
// HTML for chat-bubble rendering, backed by goldmark exactly the way
// audience_score_system/web/schedule/markdown.go's renderScriptMarkdown
// is (see that doc comment for why goldmark's default Unsafe:false
// renderer already satisfies "must not execute" for a message body
// containing raw HTML like "<script>" -- goldmark replaces it with a
// comment placeholder rather than passing it through). Unlike that
// caller, this one has no error to propagate up through a templ node, so
// a conversion failure (goldmark's Convert essentially never errors on
// valid UTF-8 input) falls back to the HTML-escaped source rather than
// dropping the message.
func renderMarkdown(source string) string {
	var buf bytes.Buffer
	if err := chatMarkdown.Convert([]byte(source), &buf); err != nil {
		return html.EscapeString(source)
	}
	return buf.String()
}

// messageRow renders a user_message/assistant_message event as a daisyUI
// chat bubble (FR2's "bubbly" chat-window look) -- user turns on the
// right (chat-end, primary-coloured bubble), assistant turns on the left
// (chat-start, neutral bubble), matching the now-conventional AI chatbot
// layout. Content renders through renderMarkdown so fenced code, lists,
// links, etc. in either a user's or the assistant's turn render as actual
// markup rather than a literal wall of text. The assistant bubble gets a
// wider max-width and roomier padding/line-height than daisyUI's default
// -- assistant turns tend to run long and prose-heavy (multi-paragraph
// explanations, code blocks), so the tight, texting-sized default bubble
// reads as cramped; a short user turn keeps the default sizing.
templ messageRow(role string, label string, ev TranscriptEventView) {
	{{ payload, err := decodeMessagePayload(ev.Payload) }}
	<div class={ "chat", templ.KV("chat-end", role == "user"), templ.KV("chat-start", role != "user") }>
		<div class="chat-image avatar avatar-placeholder">
			<div class={ "w-8 rounded-full text-neutral-content", templ.KV("bg-primary", role == "user"), templ.KV("bg-neutral", role != "user") }>
				<span class="text-xs">{ strings.ToUpper(label[:1]) }</span>
			</div>
		</div>
		<div class="chat-header text-xs text-base-content/50">
			{ label } <time class="opacity-50">turn { fmt.Sprintf("%d", ev.Turn) }</time>
		</div>
		if err != nil {
			<div class="chat-bubble chat-bubble-error text-sm">failed to decode event payload</div>
		} else {
			<div class={ "chat-bubble chat-markdown", templ.KV("chat-bubble-primary", role == "user"), templ.KV("max-w-xl md:max-w-2xl px-5 py-3 text-[15px] leading-relaxed", role != "user") }>
				@templ.Raw(renderMarkdown(payload.Content))
			</div>
		}
	</div>
}

// toolCallRow/toolResultRow render tool events as a single tiny line --
// icon, name, and (truncated) args/content at text-xs, no card chrome --
// matching a CLI's own tool-call line size rather than a bordered/
// badged daisyUI collapse card, which reads as a "full bar" once a
// transcript has more than a couple of tool calls in it. <details>/
// <summary> keeps the same click-to-expand affordance the old collapse
// card had, for the rare long argument/result payload, without the
// border/background/badge chrome inflating the collapsed line.
templ toolCallRow(ev TranscriptEventView) {
	{{ payload, err := decodeToolCallPayload(ev.Payload) }}
	if err != nil {
		<p class="text-error text-sm">failed to decode event payload</p>
	} else {
		<details>
			<summary class="flex items-center gap-1.5 py-0.5 font-mono text-xs text-base-content/50 cursor-pointer marker:hidden">
				<span class="text-base-content/30">&#9679;</span>
				<span class="truncate">{ payload.Name }({ payload.Arguments })</span>
			</summary>
			<pre class="whitespace-pre-wrap font-mono text-xs text-base-content/60 pl-4">{ payload.Arguments }</pre>
		</details>
	}
}

templ toolResultRow(ev TranscriptEventView) {
	{{ payload, err := decodeToolResultPayload(ev.Payload) }}
	if err != nil {
		<p class="text-error text-sm">failed to decode event payload</p>
	} else {
		<details>
			<summary class={ "flex items-center gap-1.5 py-0.5 font-mono text-xs cursor-pointer marker:hidden", templ.KV("text-warning", payload.IsError), templ.KV("text-base-content/50", !payload.IsError) }>
				<span class="text-base-content/30">&#8618;</span>
				<span class="truncate">{ payload.Name }: { payload.Content }</span>
			</summary>
			<pre class={ "whitespace-pre-wrap font-mono text-xs pl-4", templ.KV("text-warning", payload.IsError), templ.KV("text-base-content/60", !payload.IsError) }>{ payload.Content }</pre>
		</details>
	}
}

templ cappedRow(ev TranscriptEventView) {
	{{ payload, err := decodeCappedPayload(ev.Payload) }}
	if err != nil {
		<p class="text-error text-sm">failed to decode event payload</p>
	} else {
		<div role="alert" class="alert alert-warning text-sm py-2">Session capped: { payload.CapKind }</div>
	}
}

templ failureRow(ev TranscriptEventView) {
	{{ payload, err := decodeFailurePayload(ev.Payload) }}
	if err != nil {
		<p class="text-error text-sm">failed to decode event payload</p>
	} else {
		<div role="alert" class="alert alert-error text-sm py-2">
			Session failed
			if payload.ErrorCategory != "" {
				({ payload.ErrorCategory })
			}
			if payload.ErrorDetail != "" {
				: { payload.ErrorDetail }
			}
		</div>
	}
}

func decodeMessagePayload(raw []byte) (messageEventPayload, error) {
	var p messageEventPayload
	err := json.Unmarshal(raw, &p)
	return p, err
}

func decodeToolCallPayload(raw []byte) (toolCallEventPayload, error) {
	var p toolCallEventPayload
	err := json.Unmarshal(raw, &p)
	return p, err
}

func decodeToolResultPayload(raw []byte) (toolResultEventPayload, error) {
	var p toolResultEventPayload
	err := json.Unmarshal(raw, &p)
	return p, err
}

func decodeCappedPayload(raw []byte) (cappedEventPayload, error) {
	var p cappedEventPayload
	err := json.Unmarshal(raw, &p)
	return p, err
}

func decodeFailurePayload(raw []byte) (failureEventPayload, error) {
	var p failureEventPayload
	err := json.Unmarshal(raw, &p)
	return p, err
}
