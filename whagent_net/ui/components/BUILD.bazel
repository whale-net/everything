load("@rules_go//go:def.bzl", "go_test")
load("//tools:templ.bzl", "templ_library")

templ_library(
    name = "components",
    srcs = glob(["*.templ"]),
    visibility = ["//whagent_net/ui:__subpackages__"],
    deps = [
        "//libs/go/htmxauth",
        "//libs/go/htmxui",
    ],
)

# Testing phase (issue #2236's Testing section): the shared shell actually
# surfaces the signed-in Keycloak operator's identity, not merely that it
# accepts a *htmxauth.UserInfo field without using it. Mirrors
# manmanv2/ui/components/BUILD.bazel's components_test shape.
#
# session_usage_test.go (issue #2248's Testing section) added: FR4/LB6
# coverage for SessionUsage -- used/cap rendered verbatim, the estimated-
# cost flag appears iff CostEstimated is true, and a capped session names
# the tripped cap.
go_test(
    name = "components_test",
    size = "small",
    srcs = [
        "layout_test.go",
        "session_usage_test.go",
    ],
    embed = [":components"],
    deps = [
        "//libs/go/htmxauth",
    ],
)
