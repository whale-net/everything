"""whagent-net standalone agent web UI (M2, issue #2236): binary entrypoint,
Keycloak sign-in, and the authenticated api client. The session detail page
and its live transcript (FR2, NFR2, NFR3, NFR4, issue #2242) are this
package's other consumer; remaining FR1-FR4 pieces land in later tasks
under the same plan (#2233)."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "ui_lib",
    srcs = [
        "convert.go",
        "grpc_client.go",
        "handlers.go",
        "handlers_session.go",
        "handlers_session_live.go",
        "main.go",
        "mcpauth.go",
        "templ_render.go",
    ],
    importpath = "github.com/whale-net/everything/whagent_net/ui",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/grpcclient",
        "//libs/go/htmxauth",
        "//libs/go/htmxbase",
        "//libs/go/htmxsse",
        "//libs/go/htmxsse/templadapter",
        "//libs/go/htmxui",
        "//libs/go/logging",
        "//libs/go/mcpauth",
        "//libs/go/rmq",
        "//whagent_net/events",
        "//whagent_net/protos:whagentpb",
        "//whagent_net/ui/components",
        "//whagent_net/ui/pages",
        "@com_github_a_h_templ//:templ",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "whagent-net-ui",
    embed = [":ui_lib"],
    visibility = ["//visibility:public"],
)

# Testing phase (issue #2236's Testing section): unauthenticated app-route
# redirect, /healthz reachable without a session, and the api client
# forwarding the caller's own access token -- mirrors
# manmanv2/ui/BUILD.bazel's ui_test target shape.
go_test(
    name = "ui_test",
    size = "small",
    srcs = [
        "grpc_client_test.go",
        "main_test.go",
    ],
    embed = [":ui_lib"],
    deps = [
        "//libs/go/grpcauth",
        "//libs/go/htmxauth",
        "//libs/go/mcpauth",
        "//whagent_net/protos:whagentpb",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//test/bufconn",
    ],
)

# Release metadata for whagent-net's standalone agent web UI (issue #2236).
# domain "whagent-net" + name "whagent-net-ui" mirrors //whagent_net/api:api's
# release_app and manmanv2/ui's own release_app (app_type "external-api");
# ingress fields left unset for now, per this task's Scaffold section.
release_app(
    name = "whagent-net-ui",
    binary_name = ":whagent-net-ui",
    language = "go",
    domain = "whagent-net",
    app_type = "external-api",
    port = 8080,
    replicas = 1,
    description = "whagent-net standalone agent web UI",
)
