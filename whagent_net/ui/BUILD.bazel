"""whagent-net standalone agent web UI (M2, issue #2236): binary entrypoint,
Keycloak sign-in, and the authenticated api client. Real session pages
(FR1-FR4) land in later tasks under the same plan (#2233)."""

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "ui_lib",
    srcs = [
        "grpc_client.go",
        "handlers.go",
        "main.go",
        "templ_render.go",
    ],
    importpath = "github.com/whale-net/everything/whagent_net/ui",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/grpcclient",
        "//libs/go/htmxauth",
        "//libs/go/htmxbase",
        "//libs/go/htmxui",
        "//libs/go/logging",
        "//whagent_net/protos:whagentpb",
        "//whagent_net/ui/components",
        "//whagent_net/ui/pages",
        "@com_github_a_h_templ//:templ",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "whagent-net-ui",
    embed = [":ui_lib"],
    visibility = ["//visibility:public"],
)

# Release metadata for whagent-net's standalone agent web UI (issue #2236).
# domain "whagent-net" + name "whagent-net-ui" mirrors //whagent_net/api:api's
# release_app and manmanv2/ui's own release_app (app_type "external-api");
# ingress fields left unset for now, per this task's Scaffold section.
release_app(
    name = "whagent-net-ui",
    binary_name = ":whagent-net-ui",
    language = "go",
    domain = "whagent-net",
    app_type = "external-api",
    port = 8080,
    replicas = 1,
    description = "whagent-net standalone agent web UI",
)
