"""whagent-net SessionService proto -- the gRPC service boundary (issue
#2113, ARCHITECTURE.md "Service boundary vs. package boundary")."""

load("//tools/bazel:grpc.bzl", "go_grpc_library")

go_grpc_library(
    name = "whagentpb",
    srcs = ["session.proto"],
    importpath = "github.com/whale-net/everything/whagent_net/protos",
    proto_deps = [
        "@protobuf//:timestamp_proto",
    ],
    go_deps = [
        "@rules_go//proto/wkt:timestamp_go_proto",
    ],
    visibility = ["//visibility:public"],
)
