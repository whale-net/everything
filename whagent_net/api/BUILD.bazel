"""whagent-net SessionService gRPC server (issue #2113)."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "api_lib",
    srcs = ["main.go"],
    importpath = "github.com/whale-net/everything/whagent_net/api",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//libs/go/temporal",
        "//whagent_net/api/handlers",
        "//whagent_net/api/persona",
        "//whagent_net/config",
        "//whagent_net/llm",
        "//whagent_net/protos:whagentpb",
        "//whagent_net/session",
        "@io_opentelemetry_go_contrib_instrumentation_google_golang_org_grpc_otelgrpc//:otelgrpc",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//reflection",
    ],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

# DevRoles wiring test (issue #2154, FR9): proves GRPC_AUTH_MODE=none's dev
# Claims carry every seeded agent's required_role via the same
# config.Load()/config.RequiredRoles() -> grpcauth.ServerConfig.DevRoles
# path run() builds above, instead of grpcauth's ["admin"] default.
go_test(
    name = "api_test",
    srcs = ["main_test.go"],
    embed = [":api_lib"],
    deps = [
        "//libs/go/grpcauth",
        "//whagent_net/config",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
    ],
)

# Release metadata for the SessionService gRPC server (issue #2113). domain
# "whagent-net" + name "api" matches the binary table in
# whagent_net/README.md.
release_app(
    name = "api",
    binary_name = ":api",
    language = "go",
    domain = "whagent-net",
    description = "whagent-net SessionService gRPC server",
    app_type = "external-api",
    port = 50051,
    replicas = 1,
)
