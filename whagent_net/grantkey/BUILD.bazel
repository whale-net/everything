"""whagent-net scope-derived delegated-grant key (issue #2424, FR1/FR4):
a pure, dependency-free helper so both whagent_net/mcp (server/tools,
deps_test.go-protected) and whagent_net/ui can depend on it without
pulling in Postgres/Temporal/config."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "grantkey",
    srcs = ["grantkey.go"],
    importpath = "github.com/whale-net/everything/whagent_net/grantkey",
    visibility = ["//visibility:public"],
)

# Pure-Go suite (issue #2424's Testing section): ForScope's determinism,
# no-collision-across-scopes, and empty/whitespace/malformed-scope error
# cases. No Postgres/network dependency.
go_test(
    name = "grantkey_test",
    srcs = ["grantkey_test.go"],
    embed = [":grantkey"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
