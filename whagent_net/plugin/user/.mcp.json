{
  "mcpServers": {
    "whagent-net-mcp-tilt": {
      "type": "http",
      "url": "http://localhost:8082/",
      "headers": {
        "Authorization": "Bearer dev-local"
      }
    },
    "whagent-net-mcp-dev": {
      "type": "http",
      "url": "https://dev-mcp.whagent-net.whalenet.dev",
      "headers": {
        "Authorization": "Bearer ${WHAGENT_DEV_ACCESS_TOKEN}"
      }
    },
    "whagent-net-mcp-prod": {
      "type": "http",
      "url": "https://mcp.whagent-net.whalenet.dev",
      "headers": {
        "Authorization": "Bearer ${WHAGENT_PROD_ACCESS_TOKEN}"
      }
    }
  }
}
