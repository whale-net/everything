load("@rules_go//go:def.bzl", "go_library")

# Encode/Decode for the (iss, sub) identity pair mcpauth's Provider
# resolves a signed-in whagent-net operator to (NFR7, issue #2245) --
# importable by both `ui` (encodes) and `mcp` (decodes, a dependent task)
# so the two sides cannot drift on the packed string's format. See
# identity.go's package doc.
go_library(
    name = "mcpidentity",
    srcs = ["identity.go"],
    importpath = "github.com/whale-net/everything/whagent_net/mcpidentity",
    visibility = ["//visibility:public"],
)
