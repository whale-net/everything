load("@rules_go//go:def.bzl", "go_library", "go_test")

# whagent-net's MCP tool group, one file per tool (issue #2120): the five
# gRPC RPCs FR1/FR2/FR3 require from this surface -- start_session,
# send_turn, stop_session, get_session, read_transcript -- and no others
# (no agent-discovery tool, no wait-for-completion tool; see the issue
# body's Implementation section).
go_library(
    name = "tools",
    srcs = [
        "convert.go",
        "domain.go",
        "errors.go",
        "get_session.go",
        "read_transcript.go",
        "send_turn.go",
        "start_session.go",
        "stop_session.go",
    ],
    importpath = "github.com/whale-net/everything/whagent_net/mcp/tools",
    visibility = ["//visibility:public"],
    deps = [
        "//whagent_net/protos:whagentpb",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "tools_test",
    srcs = [
        "deps_test.go",
        "errors_test.go",
        "fake_client_test.go",
        "fake_domain_resolver_test.go",
        "get_session_test.go",
        "read_transcript_test.go",
        "registration_test.go",
        "send_turn_test.go",
        "start_session_test.go",
        "stop_session_test.go",
    ],
    embed = [":tools"],
    embedsrcs = ["BUILD.bazel"],
    deps = [
        "//whagent_net/protos:whagentpb",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
