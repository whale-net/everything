load("@rules_go//go:def.bzl", "go_library")

# `mcp`'s server bootstrap (server.go), caller-identity pass-through
# middleware (auth.go), and streamable HTTP transport (transport.go). See
# ../../ARCHITECTURE.md "Open items" and issue #2120's Scaffold phase.
go_library(
    name = "server",
    srcs = [
        "auth.go",
        "server.go",
        "transport.go",
    ],
    importpath = "github.com/whale-net/everything/whagent_net/mcp/server",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/grpcauth",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)
