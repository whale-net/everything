load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "session",
    srcs = [
        "agentdef.go",
        "archive.go",
        "idempotency.go",
        "session.go",
        "sessions.go",
        "transcript.go",
        "turn_commit.go",
        "usage.go",
    ],
    importpath = "github.com/whale-net/everything/whagent_net/session",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/s3",
        "//whagent_net/events",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

# Real Postgres integration test for the whole session store package
# (issue #2109's Testing section): migration 001 up/down/re-up reversibility
# is covered separately (//whagent_net/migrate/schema:schema_integration_test);
# this target exercises SessionStore's Create/GetByID/UpdateStatus CAS,
# TranscriptStore's seq allocation (including concurrent-append
# uniqueness) and ordered Read, AgentDefinitionStore's SCD2 close-and-open
# plus its partial unique index, UsageStore.SumCost and cost_usd's NOT
# NULL constraint, and IdempotencyLedger.Reserve's duplicate-reservation
# behavior -- all against migration 001's real embedded SQL
# (//whagent_net/migrate/schema), not a hand-copied schema. Deliberately
# NOT part of `bazel test //...` -- see //libs/go/dbtest's README for the
# full rationale behind each tag and how to run tests like this one.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //whagent_net/session:session_integration_test --test_output=all
go_test(
    name = "session_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "agentdef_integration_test.go",
        "idempotency_integration_test.go",
        "sessions_integration_test.go",
        "store_integration_test.go",
        "transcript_archive_integration_test.go",
        "transcript_integration_test.go",
        "transcript_publish_integration_test.go",
        "turn_commit_integration_test.go",
        "usage_integration_test.go",
    ],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":session",
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "//libs/go/s3",
        "//whagent_net/events",
        "//whagent_net/migrate/schema",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//stdlib",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//wait",
    ],
)
