"""whagent-net agent-definition seed config: agents.yaml + its Go decode/
validate shape (issue #2121). Also exports prices.json (issue #2221), a
plain (non-embedded) data file worker's BUILD.bazel bakes into the worker
image via pkg_tar/additional_tars -- unlike agents.yaml, prices.json must
stay a real on-disk file (LB6: "contents and source stay cheap to
change"), not go:embed, so llm.LoadPriceTable's every-call re-read still
picks up an edit without a Go rebuild if the path is ever pointed at a
mounted file instead."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = ["config.go"],
    embedsrcs = ["agents.yaml"],
    importpath = "github.com/whale-net/everything/whagent_net/config",
    visibility = ["//visibility:public"],
    deps = [
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

# Pure-Go suite (issue #2121's Testing section): Validate's shape-only
# rules (missing agent_id, duplicate agent_id, missing model, empty/
# malformed tool_set) and a sanity check that the real checked-in
# agents.yaml this package embeds parses and validates.
go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":config"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Default per-model price table (issue #2221): baked into the worker image
# at a fixed path by //whagent_net/worker's pkg_tar/additional_tars, so
# WHAGENT_PRICE_TABLE_PATH has a real default (worker/main.go) instead of
# nothing for argok8s's chart to point at. See prices.json's sibling doc
# comment above and whagent_net/ENV.md.
filegroup(
    name = "prices_json",
    srcs = ["prices.json"],
    visibility = ["//whagent_net/worker:__pkg__"],
)
