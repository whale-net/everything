"""whagent-net Temporal worker: SessionWorkflow + per-turn activities (issue #2114)."""

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "worker_lib",
    srcs = [
        "activities.go",
        "context.go",
        "main.go",
        "workflow.go",
    ],
    importpath = "github.com/whale-net/everything/whagent_net/worker",
    visibility = ["//visibility:private"],
    deps = [
        "//libs/go/db",
        "//libs/go/logging",
        "//libs/go/rmq",
        "//libs/go/temporal",
        "//whagent_net/events",
        "//whagent_net/llm",
        "//whagent_net/session",
        "@com_github_google_uuid//:uuid",
        "@io_temporal_go_sdk//activity",
        "@io_temporal_go_sdk//log",
        "@io_temporal_go_sdk//temporal",
        "@io_temporal_go_sdk//worker",
        "@io_temporal_go_sdk//workflow",
    ],
)

go_binary(
    name = "worker",
    embed = [":worker_lib"],
    visibility = ["//visibility:public"],
)

# Release metadata. domain "whagent-net" + name "worker" matches the binary
# table in whagent_net/README.md. app_type "worker": a long-running
# background process hosting SessionWorkflow, not an API (no port) and not
# a run-to-completion job like migrate.
release_app(
    name = "worker",
    binary_name = ":worker",
    language = "go",
    domain = "whagent-net",
    description = "whagent-net Temporal worker (SessionWorkflow)",
    app_type = "worker",
)
