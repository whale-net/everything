"""whagent-net domain root."""

load("//tools/bazel:release.bzl", "release_helm_chart")

filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "tiltfile",
    srcs = ["Tiltfile"],
    visibility = ["//whagent_net/conformance:__pkg__"],
)

# This BUILD.bazel itself, as text data for //whagent_net/conformance's
# Tiltfile conformance test (issue #2341) -- used only to locate this
# directory as a data-staging root, not asserted on directly.
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//whagent_net/conformance:__pkg__"],
)

# Composes the M1 binaries (migrate, api, worker, mcp), M2's ui, and now
# archiver (FR7, C18, issue #2244) into one deployable chart, mirroring
# audience_score_system/BUILD.bazel's ass_backend_chart's migration-job +
# gRPC/MCP external-apis + Temporal-worker shape. domain "whagent-net" +
# chart_name "whagent-net" produces the "helm-whagent-net-whagent-net"
# chart identity.
release_helm_chart(
    name = "whagent_net_chart",
    chart_name = "whagent-net",
    domain = "whagent-net",
    namespace = "whagent-net",
    environment = "dev",
    apps = [
        "//whagent_net/migrate:migrate_metadata",
        "//whagent_net/api:api_metadata",
        "//whagent_net/worker:worker_metadata",
        "//whagent_net/mcp:mcp_metadata",
        "//whagent_net/ui:whagent-net-ui_metadata",
        "//whagent_net/archiver:whagent-net-archiver_metadata",
    ],
    visibility = ["//visibility:public"],
)
