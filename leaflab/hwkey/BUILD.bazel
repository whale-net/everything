"""LeafLab hardware key -- one canonical encoding for (i2c_address, mux_path, sensor_type) (FR18)."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "hwkey",
    srcs = [
        "address.go",
        "doc.go",
        "key.go",
        "muxpath.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/hwkey",
    visibility = ["//visibility:public"],
)

# Pure unit tests -- no Docker, no network, run everywhere `bazel test //...`
# runs. Covers address/mux-path canonicalisation and Key comparison/SQL
# predicate text (FR18). See sqlpredicate_integration_test.go (below) for
# the real-database corroboration.
#
# `data` lists this package's own non-test sources so
# TestPackage_NoFunctionAcceptsDisplayString (in key_test.go) can locate and
# parse them via the Bazel runfiles manifest at test runtime -- `bazel
# test`'s sandbox working directory does not contain the source tree, so a
# plain relative path doesn't work.
go_test(
    name = "hwkey_test",
    srcs = [
        "address_test.go",
        "key_test.go",
        "muxpath_test.go",
    ],
    data = [
        "address.go",
        "doc.go",
        "key.go",
        "muxpath.go",
    ],
    embed = [":hwkey"],
    deps = [
        "@rules_go//go/runfiles",
    ],
)

# Real-Postgres integration coverage: proves Key.SQLPredicate matches
# exactly the rows idx_sensor_hw_address would, and that SQLText's format
# matches Postgres's own jsonb::text rendering -- see
# sqlpredicate_integration_test.go's doc comment and
# //libs/go/dbtest/README.md. Hand-written (not gazelle-generated): the test
# file is gated behind `//go:build integration`, which gazelle skips when
# scanning for go_test srcs. Tag set mirrors
# //leaflab/api:response_contract_integration_test and
# //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required). `# keep` markers tell
# a later `bazel run //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/hwkey:sqlpredicate_integration_test --test_output=all
go_test(
    # keep
    name = "sqlpredicate_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["sqlpredicate_integration_test.go"],
    embed = [":hwkey"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
    ],
)
