"""LeafLab gRPC API — device config push and board management."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "api_lib",
    srcs = [
        "auth.go",
        "main.go",
        "repository.go",
        "server.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/api",
    visibility = ["//visibility:private"],
    deps = [
        "//firmware/proto:configpb",
        "//leaflab/api/proto:leaflabapipb",
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//libs/go/rmq",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_contrib_instrumentation_google_golang_org_grpc_otelgrpc//:otelgrpc",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//reflection",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "api_test",
    srcs = [
        "auth_test.go",
        "history_test.go",
        "server_m2_contract_test.go",
        "server_test.go",
    ],
    embed = [":api_lib"],
    deps = [
        "//firmware/proto:configpb",
        "//leaflab/api/proto:leaflabapipb",
        "//libs/go/grpcauth",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_grpc//test/bufconn",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

# FR9/FR10 tests that need a real Postgres (SQL-applied point cap, invalid-
# reading accounting). Gated behind `//go:build integration`, gazelle skips
# it when scanning for go_test srcs; this go_test is hand-written with
# EXACTLY the tag set from //libs/go/dbtest:postgres_constraints_test (see
# that package's BUILD.bazel/README.md for why each tag is required).
# `# keep` tells a later `bazel run //:gazelle` not to touch or remove this
# rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/api:history_integration_test --test_output=all
go_test(
    # keep
    name = "history_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["history_integration_test.go"],
    embed = [":api_lib"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "//libs/go/dbtest",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

release_app(
    name = "leaflab-api",
    app_type = "internal-api",
    binary_name = ":api",
    description = "LeafLab gRPC API — device config push and board management",
    domain = "leaflab",
    language = "go",
    port = 50051,
    replicas = 1,
)

# Real-Postgres integration coverage for ListBoardsWithState (#1497),
# ListSensorDetailsForBoard/GetBoardIdentity (#1498), and migration 016's
# board.name / leaflab_user_role / sensor corrective-push schema (#1759) --
# see repository_integration_test.go's and migration_016_integration_test.go's
# doc comments plus //libs/go/dbtest's README for how to run it.
#
# Gazelle does not generate this target: both source files are gated behind
# `//go:build integration`, which gazelle skips when scanning for go_test
# srcs. This go_test is hand-written, with EXACTLY the tag set from
# //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required). `# keep` markers tell
# a later `bazel run //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/api:api_integration_test --test_output=all
go_test(
    # keep
    name = "api_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "migration_016_integration_test.go",
        "repository_integration_test.go",
    ],
    embed = [":api_lib"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "//libs/go/dbtest",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
