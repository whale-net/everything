"""LeafLab gRPC API — device config push and board management."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "api_lib",
    srcs = [
        "ack_listener.go",
        "ack_waiter.go",
        "main.go",
        "materialiser.go",
        "repository.go",
        "server.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/api",
    visibility = ["//visibility:private"],
    deps = [
        "//firmware/proto:configpb",
        "//leaflab/api/apierrors",
        "//leaflab/api/pagetoken",
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/api/ratelimit",
        "//leaflab/broadcast",
        "//leaflab/canonkey",
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//libs/go/rmq",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//reflection",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# Container-backed test target: dbtest (Postgres) for every test, rmqtest
# (RabbitMQ) for ack_fanout_integration_test.go's real-broker fanout proof.
# Requires Docker; see libs/go/dbtest/README.md and libs/go/rmqtest/README.md
# for the exact bazel invocation.
go_test(
    name = "api_test",
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    srcs = [
        "ack_fanout_integration_test.go",
        "api_integration_test.go",
        "materialiser_test.go",
        "server_test.go",
    ],
    embed = [":api_lib"],
    deps = [
        "//firmware/proto:configpb",
        "//leaflab/api/apierrors",
        "//leaflab/api/pagetoken",
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/api/ratelimit",
        "//leaflab/broadcast",
        "//libs/go/dbtest",
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//libs/go/rmq",
        "//libs/go/rmqtest",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_grpc//test/bufconn",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

release_app(
    name = "leaflab-api",
    app_type = "internal-api",
    binary_name = ":api",
    description = "LeafLab gRPC API — device config push and board management",
    domain = "leaflab",
    language = "go",
    port = 50051,
    replicas = 1,
)
