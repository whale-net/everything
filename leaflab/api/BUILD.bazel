"""LeafLab gRPC API — device config push and board management."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "api_lib",
    srcs = [
        "audit_registry.go",
        "auth.go",
        "claim.go",
        "households.go",
        "logging_interceptor.go",
        "main.go",
        "ratelimit_interceptor.go",
        "repository.go",
        "server.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/api",
    visibility = ["//visibility:private"],
    deps = [
        "//firmware/proto:configpb",
        "//leaflab/api/audit",
        "//leaflab/api/authz",
        "//leaflab/api/claim",
        "//leaflab/api/contract",
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/api/ratelimit",
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/logging",
        "//libs/go/rmq",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//reflection",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

release_app(
    name = "leaflab-api",
    binary_name = ":api",
    language = "go",
    domain = "leaflab",
    description = "LeafLab gRPC API — device config push and board management",
    app_type = "internal-api",
    port = 50051,
    replicas = 1,
)

# FR11/FR12/FR63/NFR10 auth-health-rate-limit-and-config test suite: auth.go's
# enforcement interceptor and allowlist in isolation (auth_test.go),
# GetHealth's DEGRADED/UP probe logic against an in-memory fake repository
# (server_test.go), the full production interceptor chain -- built via
# buildServer, the exact function run() calls -- behind a bufconn listener
# with a stub RPC handler standing in for Postgres/RabbitMQ (main_test.go),
# FR8's startup audit-registration check against both the real production
# registry and a deliberately unregistered write method
# (audit_registry_test.go), NFR10's rate-limit interceptor: principalKey
# derivation, oracle-safety, principal/session independence and
# window-rollover recovery, both directly (checkRateLimitBuckets) and over
# the wire (ratelimit_interceptor_test.go), and FR1.2/FR1.3's push-time
# live-reference invariant at the Go-dispatch level
# (server_push_device_config_test.go). No Docker/network required; safe to
# run in `bazel test //leaflab/...`.
# Hand-written (not gazelle-generated) per this package's gazelle gotcha --
# see the response_contract_integration_test.go rule below. `# keep` tells a
# later `bazel run //:gazelle` not to touch or remove this rule.
go_test(
    # keep
    name = "api_lib_test",
    size = "small",
    srcs = [
        "audit_registry_test.go",
        "auth_test.go",
        "main_test.go",
        "ratelimit_interceptor_test.go",
        "server_push_device_config_test.go",
        "server_test.go",
    ],
    embed = [":api_lib"],
    deps = [
        "//firmware/proto:configpb",
        "//leaflab/api/audit",
        "//leaflab/api/authz",
        "//leaflab/api/claim",
        "//leaflab/api/contract",
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/api/ratelimit",
        "//libs/go/grpcauth",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//status",
        "@org_golang_google_grpc//test/bufconn",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

# Real-Postgres integration coverage for the response contract (FR59, FR61,
# FR64) -- see response_contract_integration_test.go's doc comment and
# //libs/go/dbtest/README.md. Hand-written (not gazelle-generated): the test
# file is gated behind `//go:build integration`, which gazelle skips when
# scanning for go_test srcs. EXACTLY the tag set from
# //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required). `# keep` markers tell
# a later `bazel run //:gazelle` not to touch or remove this rule.
#
# dbtest_helpers_integration_test.go carries the shared testSchema/helpers
# both this target and repository_board_lifecycle_integration_test below
# depend on -- it must be listed in both targets' srcs since Bazel doesn't
# share compiled test sources across go_test targets.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/api:response_contract_integration_test --test_output=all
go_test(
    # keep
    name = "response_contract_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "dbtest_helpers_integration_test.go",
        "response_contract_integration_test.go",
    ],
    embed = [":api_lib"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//leaflab/api/audit",
        "//leaflab/api/authz",
        "//leaflab/api/claim",
        "//leaflab/api/contract",
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/api/ratelimit",
        "//libs/go/dbtest",
        "//libs/go/grpcauth",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

