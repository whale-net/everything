"""LeafLab API response contract — structured failure classes (FR59), keyset pagination (FR61), and absolute-instant time fields (FR64)."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "contract",
    srcs = [
        "failure.go",
        "instant.go",
        "paging.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/api/contract",
    visibility = ["//visibility:public"],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)

go_test(
    name = "contract_test",
    srcs = [
        "failure_test.go",
        "paging_test.go",
    ],
    embed = [":contract"],
    deps = [
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
