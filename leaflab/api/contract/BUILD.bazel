"""LeafLab API response contract — structured failure classes (FR59), keyset pagination (FR61), and absolute-instant time fields (FR64)."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "contract",
    srcs = [
        "failure.go",
        "granularity.go",
        "instant.go",
        "paging.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/api/contract",
    visibility = ["//visibility:public"],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/api/tiers",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "contract_test",
    srcs = [
        "failure_test.go",
        "paging_test.go",
    ],
    embed = [":contract"],
    deps = [
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

# Source exposed to //leaflab/conformance (#1334, NFR1.a's extensibility
# for Phase 2's NFR1.b and Phase 3's NFR1.c, both of which build on the
# FailureClass vocabulary defined here). Scoped, not public.
filegroup(
    name = "conformance_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//leaflab/conformance:__pkg__"],
)
