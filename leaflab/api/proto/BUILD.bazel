"""LeafLab API proto — gRPC service definition."""

load("//tools/bazel:grpc.bzl", "go_grpc_library")

go_grpc_library(
    name = "leaflabapipb",
    srcs = ["api.proto"],
    importpath = "github.com/whale-net/everything/leaflab/api/proto",
    proto_deps = ["//firmware/proto:config_proto"],
    go_deps = ["//firmware/proto:configpb"],
    visibility = ["//visibility:public"],
)

# Source exposed to //leaflab/conformance's NFR1.a RPC-coverage check
# (#1334): it parses this file for every `rpc` in LeafLabAPI and asserts
# each is either the sole anonymous-allowlist entry (GetHealth) or reached
# through the authenticating interceptor.
filegroup(
    name = "proto_file",
    srcs = ["api.proto"],
    visibility = ["//leaflab/conformance:__pkg__"],
)
