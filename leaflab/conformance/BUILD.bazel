load("@rules_go//go:def.bzl", "go_test")

# NFR1 authentication and authorization conformance tests for the LeafLab API and UI.
# Ensures no household data is served without authentication (NFR1.a),
# that every RPC has authorization tests (NFR1.b), and that the BFF holds
# no presentation-shaping rules (NFR18.1).
# See paths_test.go's package doc comment.

go_test(
    name = "conformance_test",
    srcs = [
        "auth_coverage_test.go",
        "bff_policy_test.go",
        "nfr1b_test.go",
        "paths_test.go",
    ],
    data = [
        "//leaflab:build_file",
        "//leaflab/api:conformance_srcs",
        "//leaflab/api/proto:proto_file",
        "//leaflab/ui:conformance_srcs",
    ],
)
