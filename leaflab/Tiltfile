# LeafLab Tiltfile
# Local development environment for LeafLab data pipeline.
#
# Starts RabbitMQ (with MQTT plugin), TimescaleDB, the Go processor,
# and the gRPC API for pushing device configs.
#
# Usage:
#   cd leaflab && tilt up
#
# Then provision your device:
#   bazel run //leaflab/sensorboard:provision -- /dev/ttyUSB0 \
#     wifi_ssid=MySSID wifi_pass=MyPass mqtt_host=<HOST_IP> mqtt_port=1883 \
#     mqtt_user=rabbit mqtt_pass=password
#
# Subscribe to raw sensor data:
#   mosquitto_sub -h localhost -p 1883 -u rabbit -P password -t 'leaflab/#' -v

load('ext://namespace', 'namespace_create')
load('../tools/tilt/common.tilt',
     'setup_dev_util', 'setup_rabbitmq', 'setup_rabbitmq_mqtt_plugin',
     'setup_postgres', 'build_images_from_apps', 'detect_platform',
     'get_watch_paths', 'print_startup_banner', 'print_footer_info')

# ===========================
# Configuration
# ===========================

namespace = 'leaflab-local-dev'
namespace_create(namespace)

platform = detect_platform()

print_startup_banner("LeafLab", namespace, platform)

# ===========================
# Infrastructure
# ===========================

setup_dev_util(namespace)

rmq_info = setup_rabbitmq(namespace, mqtt=True)
setup_rabbitmq_mqtt_plugin(namespace, labels=['leaflab-infrastructure'])

# RabbitMQ AMQP URL — processor uses the default '/' vhost
rabbitmq_url = 'amqp://{}:{}@{}:{}/'.format(
    rmq_info['user'],
    rmq_info['password'],
    rmq_info['host'],
    rmq_info['port'],
)

# The shared dev-util rabbitmq-dev chart's K8s Service only exposes ports
# 5672/15672 (see tools/tilt/common.tilt's setup_rabbitmq() docstring) — it
# has never needed to expose 1883 because MQTT was previously only reached
# via Tilt's host port-forward (mosquitto_sub, hardware boards), never
# pod-to-pod in-cluster. leaflab-emulator (FR19) is the first in-cluster
# MQTT consumer, so it needs its own reachable Service. Rather than modify
# the shared chart/common.tilt wiring (would affect every other consumer),
# declare a small leaflab-local Service here that exposes port 1883 on the
# existing rabbitmq-dev pod (selector matches the `app: rabbitmq-dev` label
# set by the dev-util chart / used by setup_rabbitmq_mqtt_plugin's
# `kubectl wait -l app=rabbitmq-dev`). The broker itself already listens on
# 1883 once the MQTT plugin is enabled above — this only adds the missing
# Service port.
k8s_yaml(blob("""
apiVersion: v1
kind: Service
metadata:
  name: rabbitmq-dev-mqtt
  namespace: {namespace}
spec:
  selector:
    app: rabbitmq-dev
  ports:
  - port: 1883
    targetPort: 1883
""".format(namespace=namespace)))

# RabbitMQ MQTT plugin URL — the emulator (FR19) publishes over MQTT
# (port 1883), not the AMQP vhost above (port 5672). Credentials are
# passed separately via MQTT_USERNAME/MQTT_PASSWORD, matching
# leaflab/emulator/config.go's Config shape. Points at the leaflab-local
# rabbitmq-dev-mqtt Service above, not rmq_info['host'] — the shared
# rabbitmq-dev Service does not expose 1883 (see comment above).
mqtt_url = 'tcp://rabbitmq-dev-mqtt.{}.svc.cluster.local:{}'.format(
    namespace,
    rmq_info['mqtt_port'],
)

# PostgreSQL with TimescaleDB extension available
db_info = setup_postgres(namespace, resource_name='postgres-dev',
                         image='timescale/timescaledb:latest-pg16')

local_resource(
    'leaflab-db-create',
    cmd='''
        kubectl exec -n {namespace} postgres-dev-0 -- \
            psql -U postgres -tc "SELECT 1 FROM pg_database WHERE datname = 'leaflab'" \
            | grep -q 1 \
            || kubectl exec -n {namespace} postgres-dev-0 -- \
               psql -U postgres -c "CREATE DATABASE leaflab"
    '''.format(namespace=namespace),
    resource_deps=['postgres-dev'],
    labels=['leaflab-infrastructure'],
)

pg_url = 'postgres://{}:{}@{}:{}/leaflab?sslmode=disable'.format(
    db_info['user'], db_info['password'],
    db_info['host'], db_info['port'],
)

# ===========================
# Application Images
# ===========================

watch_paths = get_watch_paths('leaflab')

APPS = {
    'migrate': {
        'bazel_target': '//leaflab/migrate:migrate_image_load',
        'image_name': 'leaflab-migrate',
    },
    'processor': {
        'bazel_target': '//leaflab/processor:processor_image_load',
        'image_name': 'leaflab-processor',
    },
    'api': {
        'bazel_target': '//leaflab/api:leaflab-api_image_load',
        'image_name': 'leaflab-leaflab-api',
    },
    'ui': {
        'bazel_target': '//leaflab/ui:leaflab-ui_image_load',
        'image_name': 'leaflab-leaflab-ui',
    },
    'emulator': {
        'bazel_target': '//leaflab/emulator:leaflab-emulator_image_load',
        'image_name': 'leaflab-leaflab-emulator',
    },
}

build_images_from_apps(APPS, watch_paths, platform)

# ===========================
# Kubernetes Deployments
# ===========================

# Migration Job — runs on startup, re-runs on image change
k8s_yaml(blob("""
apiVersion: batch/v1
kind: Job
metadata:
  name: leaflab-migrate
  namespace: {namespace}
spec:
  ttlSecondsAfterFinished: 30
  template:
    metadata:
      labels:
        app: leaflab-migrate
    spec:
      restartPolicy: OnFailure
      containers:
      - name: migrate
        image: leaflab-migrate
        env:
        - name: PG_DATABASE_URL
          value: "{pg_url}"
""".format(namespace=namespace, pg_url=pg_url)))

k8s_resource(
    'leaflab-migrate',
    resource_deps=['leaflab-db-create'],
    labels=['leaflab-infrastructure'],
)

# Processor — consumes MQTT messages from RabbitMQ AMQP
k8s_yaml(blob("""
apiVersion: apps/v1
kind: Deployment
metadata:
  name: leaflab-processor
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: leaflab-processor
  template:
    metadata:
      labels:
        app: leaflab-processor
    spec:
      containers:
      - name: processor
        image: leaflab-processor
        env:
        - name: RABBITMQ_URL
          value: "{rabbitmq_url}"
        - name: QUEUE_NAME
          value: "leaflab-processor"
        - name: PG_DATABASE_URL
          value: "{pg_url}"
""".format(namespace=namespace, rabbitmq_url=rabbitmq_url, pg_url=pg_url)))

k8s_resource(
    'leaflab-processor',
    resource_deps=['rabbitmq-dev-mqtt-plugin', 'leaflab-migrate'],
    labels=['leaflab'],
)

# gRPC API — device config push
k8s_yaml(blob("""
apiVersion: apps/v1
kind: Deployment
metadata:
  name: leaflab-api
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: leaflab-api
  template:
    metadata:
      labels:
        app: leaflab-api
    spec:
      containers:
      - name: api
        image: leaflab-leaflab-api
        ports:
        - containerPort: 50051
        env:
        - name: PORT
          value: "50051"
        - name: RABBITMQ_URL
          value: "{rabbitmq_url}"
        - name: PG_DATABASE_URL
          value: "{pg_url}"
---
apiVersion: v1
kind: Service
metadata:
  name: leaflab-api
  namespace: {namespace}
spec:
  type: NodePort
  selector:
    app: leaflab-api
  ports:
  - port: 50051
    targetPort: 50051
    nodePort: 30051
""".format(namespace=namespace, rabbitmq_url=rabbitmq_url, pg_url=pg_url)))

k8s_resource(
    'leaflab-api',
    resource_deps=['rabbitmq-dev-mqtt-plugin', 'leaflab-migrate'],
    labels=['leaflab'],
    port_forwards=['50051:50051'],
)

# UI — HTMX/templ web app (leaflab/ui). AUTH_MODE=none and GRPC_AUTH_MODE=none
# for local dev: no OIDC config is set here, matching leaflab-api's own
# unauthenticated local-dev default above.
k8s_yaml(blob("""
apiVersion: apps/v1
kind: Deployment
metadata:
  name: leaflab-ui
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: leaflab-ui
  template:
    metadata:
      labels:
        app: leaflab-ui
    spec:
      containers:
      - name: ui
        image: leaflab-leaflab-ui
        ports:
        - containerPort: 8000
          name: http
        env:
        - name: HOST
          value: "0.0.0.0"
        - name: PORT
          value: "8000"
        - name: AUTH_MODE
          value: "none"
        - name: GRPC_AUTH_MODE
          value: "none"
        - name: SECRET_KEY
          value: "dev-secret-key"
        - name: PG_DATABASE_URL
          value: "{pg_url}"
        - name: LEAFLAB_API_URL
          value: "leaflab-api.{namespace}.svc.cluster.local:50051"
---
apiVersion: v1
kind: Service
metadata:
  name: leaflab-ui
  namespace: {namespace}
spec:
  selector:
    app: leaflab-ui
  ports:
    - name: http
      port: 8000
      targetPort: 8000
""".format(namespace=namespace, pg_url=pg_url)))

k8s_resource(
    'leaflab-ui',
    resource_deps=['leaflab-api', 'leaflab-migrate'],
    labels=['leaflab'],
    port_forwards=['8080:8000'],
)

# Emulator — dev/Tilt-only (FR19, NFR7). Publishes simulated board MQTT
# traffic so `tilt up` brings up sensor data with no manual step; never
# added to leaflab_chart (see //leaflab:BUILD.bazel and
# //leaflab/emulator:BUILD.bazel's release_app deploy_unit = "none").
# SCENARIO_DIR points at the scenario fixtures baked into the image by
# //leaflab/emulator:scenarios_tar. EMULATOR_BOARDS is left unset so the
# default (one board per scenario file) applies.
k8s_yaml(blob("""
apiVersion: apps/v1
kind: Deployment
metadata:
  name: leaflab-emulator
  namespace: {namespace}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: leaflab-emulator
  template:
    metadata:
      labels:
        app: leaflab-emulator
    spec:
      containers:
      - name: emulator
        image: leaflab-leaflab-emulator
        env:
        - name: MQTT_BROKER_URL
          value: "{mqtt_url}"
        - name: MQTT_USERNAME
          value: "{mqtt_user}"
        - name: MQTT_PASSWORD
          value: "{mqtt_password}"
        - name: SCENARIO_DIR
          value: "/etc/leaflab/scenarios"
        - name: PUBLISH_INTERVAL
          value: "5s"
""".format(
    namespace=namespace,
    mqtt_url=mqtt_url,
    mqtt_user=rmq_info['user'],
    mqtt_password=rmq_info['password'],
)))

k8s_resource(
    'leaflab-emulator',
    resource_deps=['rabbitmq-dev-mqtt-plugin', 'leaflab-migrate'],
    labels=['leaflab'],
)

# ===========================
# Access Information
# ===========================

print("\n" + "="*60)
print("LeafLab Access Information")
print("="*60)
print("  RabbitMQ AMQP:   localhost:5672 (user: rabbit, pass: password)")
print("  RabbitMQ MQTT:   localhost:1883")
print("  RabbitMQ Mgmt:   http://localhost:15672")
print("  PostgreSQL:      localhost:5432 (user: postgres, pass: password, db: leaflab)")
print("  LeafLab gRPC:   localhost:50051 (grpcurl -plaintext)")
print("  LeafLab UI:      http://localhost:8080")
print("="*60)
print("")
print("Push a device config:")
print("  grpcurl -plaintext -d '{\"device_id\":\"<id>\",\"sensors\":[{\"i2c_address\":35,\"name\":\"my_light\"}]}' \\")
print("    localhost:50051 leaflab.api.v1.LeafLabAPI/PushDeviceConfig")
print("")
print("Provision device (use your host IP, not localhost):")
print("  bazel run //leaflab/sensorboard:provision -- /dev/ttyUSB0 \\")
print("    wifi_ssid=SSID wifi_pass=PASS mqtt_host=<HOST_IP> mqtt_port=1883 \\")
print("    mqtt_user=rabbit mqtt_pass=password")
print("")
print("Subscribe to all sensor data:")
print("  mosquitto_sub -h localhost -p 1883 -u rabbit -P password -t 'leaflab/#' -v")
print("")
print("Simulated boards (leaflab-emulator, dev-only, FR19):")
print("  kubectl logs -n {} deploy/leaflab-emulator | grep -i 'device'".format(namespace))
print("="*60)

print_footer_info('leaflab')
