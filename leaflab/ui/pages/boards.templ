package pages

import (
	"fmt"

	leaflabapipb "github.com/whale-net/everything/leaflab/api/proto"
	"github.com/whale-net/everything/leaflab/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// Boards is the boards list screen (#1502: FR4, FR5, NFR1; #1765 added the
// Owner column) -- every board leaflab-api returns from
// ListBoardsWithState, with no client-side filtering by owner or ownership
// status (FR4: an unowned board is shown the same as an owned one, just
// with an Unowned label and a Claim button -- never hidden or flagged as an
// error). boards and loadErr are mutually exclusive: handlers_boards.go
// passes a nil boards slice on a load failure and a nil loadErr on
// success, mirroring tools/app_registry/ui/pages/environments.templ's
// Environments(..., loadErr error) shape.
//
// NFR1: this page has no hx-trigger polling interval, no sse-connect, and
// no WebSocket -- data reflects the last page load or navigation only. Do
// not add any of those here; see the task issue's NFR1 section and the
// render test guarding it.
templ Boards(data components.LayoutData, boards []*leaflabapipb.BoardWithState, loadErr error) {
	@components.Layout(data) {
		<h1 class="text-2xl font-bold mb-4">Boards</h1>
		if loadErr != nil {
			<div role="alert" class="alert alert-error shadow-md">
				<span>Failed to load boards from leaflab-api: { loadErr.Error() }</span>
			</div>
		} else if len(boards) == 0 {
			<div class="card bg-base-100 border border-base-300 shadow-sm">
				<div class="card-body items-center text-center py-12">
					<p class="text-base-content/60">No boards yet.</p>
				</div>
			</div>
		} else {
			@htmxui.Card(nil, boardsTable(boards), nil, nil)
		}
	}
}

// boardsTable renders one row per board (FR4: every board the API
// returned, unfiltered). The board's name (falling back to device_id when
// unnamed, per #1765's boardDisplayName) is the primary label; device_id
// stays visible underneath, monospaced, so it can still be matched against
// the eFuse-derived identifier printed on the hardware. Each row links to
// the board's detail page (#1503).
templ boardsTable(boards []*leaflabapipb.BoardWithState) {
	<div class="overflow-x-auto">
		<table class="table">
			<thead>
				<tr>
					<th>Board</th>
					<th>Owner</th>
					<th>Status</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, board := range boards {
					<tr class="hover">
						<td>@boardNameCell(board.GetBoardName(), board.GetDeviceId())</td>
						<td>@boardOwnerCell(board.GetBoardId(), board.GetOwnedByCaller(), board.GetOwner())</td>
						<td>@boardStateCell(board)</td>
						<td class="text-right">
							<a href={ templ.URL(fmt.Sprintf("/boards/%d", board.GetBoardId())) } class="btn btn-primary btn-sm">View</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// boardNameCell renders a board's primary label (name, falling back to
// device_id when unnamed) plus device_id as monospaced secondary text.
// When the board has a name, device_id is still shown underneath -- never
// hidden -- since it remains the identifier printed on the hardware.
templ boardNameCell(boardName, deviceID string) {
	<div class="flex flex-col">
		<span class="font-medium">{ boardDisplayName(boardName, deviceID) }</span>
		if boardName != "" {
			<span class="font-mono text-xs text-base-content/60">{ deviceID }</span>
		}
	</div>
}

// boardOwnerCell renders FR1/FR2's three owner states: "You" when the
// calling user owns the board, the owner's display name for anyone else's
// board, or "Unowned" plus a Claim button (#1765) when no one owns it yet.
// ownedByCaller is trusted as the sole signal for the "You" case -- never
// re-derived by comparing owner IDs client-side, since the caller's own
// leaflab_user_id is not exposed to this page.
templ boardOwnerCell(boardID int64, ownedByCaller bool, owner *leaflabapipb.LeafLabUser) {
	if ownedByCaller {
		@htmxui.Badge("You", htmxui.BadgeSuccess, htmxui.BadgeSizeSM, true, nil)
	} else if owner != nil {
		<span>{ ownerDisplayName(owner) }</span>
	} else {
		<div class="flex items-center gap-2">
			<span class="text-base-content/60">Unowned</span>
			@claimForm(boardID)
		</div>
	}
}

// boardDisplayName is the shared board-name fallback rule (api.proto:
// "board_name is empty when the board has no name -- the UI falls back to
// device_id"), used by both boards.templ and board_detail.templ.
func boardDisplayName(boardName, deviceID string) string {
	if boardName == "" {
		return deviceID
	}
	return boardName
}

// ownerDisplayName picks the best available label for a non-caller owner:
// display_name first (what a user set for themselves at sign-in), falling
// back to preferred_username, and finally a fixed placeholder -- never a
// blank cell -- for the unlikely case leaflab_user has neither (both
// columns are nullable, see 013_ownership.up.sql).
func ownerDisplayName(owner *leaflabapipb.LeafLabUser) string {
	if owner.GetDisplayName() != "" {
		return owner.GetDisplayName()
	}
	if owner.GetPreferredUsername() != "" {
		return owner.GetPreferredUsername()
	}
	return "Unknown user"
}

// claimForm is the Claim button (FR1) rendered wherever a board is unowned
// -- the boards list (boardOwnerCell) and the board detail header
// (board_detail.templ). A plain HTML form POST, not an hx-post fragment
// swap: leaflab's UI has no existing fragment-render endpoint to target
// (see handlers_boards.go's handleClaimBoard doc comment for the
// redirect-based flow this posts into), and NFR1 already rules out any
// live-update mechanism this button could piggyback on. This is a
// convenience only (NFR1's server-side note) -- ClaimBoard itself is the
// actual enforcement point.
templ claimForm(boardID int64) {
	<form method="POST" action={ templ.URL(fmt.Sprintf("/boards/%d/claim", boardID)) }>
		@htmxui.Button(htmxui.ButtonPrimary, htmxui.ButtonSizeSM, false, templ.Attributes{"type": "submit"}) {
			Claim
		}
	</form>
}

// boardStateCell renders exactly one of FR5's three states (reporting,
// stale, never reported) as an htmxui.Badge, sourced entirely from the
// ReportingState the API returned -- no timestamp is read here to decide
// which case this is. The stale case additionally shows the relative age
// of the most recent reading, straight off last_reading_at; the other two
// cases show no timestamp at all (a "never reported" board has none to
// show, and a "reporting" board's exact recency isn't the point of this
// screen).
templ boardStateCell(board *leaflabapipb.BoardWithState) {
	<div class="flex flex-col gap-1">
		@htmxui.Badge(boardStateLabel(board.GetReportingState()), boardStateVariant(board.GetReportingState()), htmxui.BadgeSizeSM, true, nil)
		if board.GetReportingState() == leaflabapipb.ReportingState_REPORTING_STATE_STALE && board.GetLastReadingAt() != nil {
			<span class="text-xs text-base-content/60">{ lastReadingAge(board.GetLastReadingAt().AsTime()) }</span>
		}
	</div>
}
