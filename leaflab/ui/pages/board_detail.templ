package pages

import (
	"fmt"
	"net/url"

	leaflabapipb "github.com/whale-net/everything/leaflab/api/proto"
	"github.com/whale-net/everything/leaflab/ui/components"
	"github.com/whale-net/everything/libs/go/htmxui"
)

// BoardDetail is the board detail screen (#1503: FR6, FR7, NFR1; #1765
// added the name/owner header and Claim button; #1767 added the
// owner-only inline rename control, factored into BoardHeader below) --
// every sensor on one board, each with its own reporting state and, when
// present, its most recent reading. resp and loadErr are mutually
// exclusive, mirroring boards.templ's Boards(..., loadErr error) shape:
// handlers_boards.go passes a nil resp on a load failure and a nil
// loadErr on success. Unlike Boards, a codes.NotFound board_id never
// reaches this template at all -- handleBoardDetail short-circuits to a
// real HTTP 404 before rendering, so loadErr here is only ever a
// transport/server failure, distinct from "board has no sensors" (an
// empty sensors slice with loadErr == nil, handled below).
//
// resp.GetDeviceId() is shown verbatim, monospaced, never truncated -- the
// same rule boards.templ's device_id column follows -- underneath the
// board's name (falling back to device_id when unnamed, via
// boardDisplayName, inside BoardHeader).
//
// claimErr carries a claim attempt's failure message (set by
// handleClaimBoard's redirect, e.g. "board is already owned") back onto
// this page -- independent of loadErr, since the board detail load itself
// succeeded; only the claim attempt failed. Empty when the page was
// reached by a normal navigation, not a post-claim redirect.
//
// NFR1: this page has no hx-trigger polling interval, no sse-connect, and
// no WebSocket -- data reflects the last page load or navigation only. Do
// not add any of those here; see the task issue's NFR1 section and the
// render test guarding it.
templ BoardDetail(data components.LayoutData, resp *leaflabapipb.GetBoardDetailResponse, loadErr error, claimErr string) {
	@components.Layout(data) {
		@BoardHeader(resp.GetBoardId(), resp.GetDeviceId(), resp.GetBoardName(), resp.GetOwnedByCaller(), "")
		<div class="mb-4">@boardOwnerCell(resp.GetBoardId(), resp.GetOwnedByCaller(), resp.GetOwner())</div>
		if claimErr != "" {
			<div role="alert" class="alert alert-warning shadow-md mb-4">
				<span>{ claimErr }</span>
			</div>
		}
		if loadErr != nil {
			<div role="alert" class="alert alert-error shadow-md">
				<span>Failed to load board detail from leaflab-api: { loadErr.Error() }</span>
			</div>
		} else if len(resp.GetSensors()) == 0 {
			<div class="card bg-base-100 border border-base-300 shadow-sm">
				<div class="card-body items-center text-center py-12">
					<p class="text-base-content/60">This board has no sensors yet.</p>
				</div>
			</div>
		} else {
			@htmxui.Card(nil, sensorsTable(resp.GetBoardId(), resp.GetDeviceId(), resp.GetOwnedByCaller(), resp.GetSensors()), nil, nil)
		}
	}
}

// BoardHeader is the board detail screen's header fragment: the page
// title, device_id, and (owner only) the inline rename control (#1767,
// FR3). Factored out of BoardDetail so handleRenameBoard can re-render
// exactly this fragment via HTMX after a rename attempt, wrapped in the
// "board-header" id every renameBoardForm submission targets with
// hx-target="#board-header" hx-swap="outerHTML" -- swapping only the
// header, never the sensors table below it.
//
// renameErr, when non-empty, always renders inline (FR3's Testing
// criterion 9) -- handleRenameBoard passes the humanized message for
// InvalidArgument (empty name) or PermissionDenied (non-owner/unowned),
// never a raw 500; see handlers_boards.go's handleRenameBoard. This must
// not be gated on ownedByCaller: a PermissionDenied rejection's
// post-rejection GetBoardDetail refetch reports ownedByCaller == false
// (the caller was never the owner, or the board is unowned), which would
// hide renameBoardForm -- and renameErr along with it -- right when the
// error most needs to be shown. So renameErr renders outside/alongside
// the owner-gated form, not only inside it.
//
// The title uses boardDisplayName (boards.templ), the same board-name
// fallback rule used everywhere else in the app (falls back to deviceID
// when the board has no name yet), rather than a static "Board" label --
// so a non-owner, who never sees renameBoardForm's input value, still has
// somewhere on the page the actual current name is shown.
//
// Hiding the rename control for a non-owner (ownedByCaller == false) is
// presentation only -- the enforcement point is authorizeBoardWrite inside
// the RenameBoard RPC itself (NFR1's server-side-is-the-only-real-fence
// rule), not this check.
templ BoardHeader(boardID int64, deviceID, boardName string, ownedByCaller bool, renameErr string) {
	<div id="board-header">
		<h1 class="text-2xl font-bold mb-1">{ boardDisplayName(boardName, deviceID) }</h1>
		<p class="font-mono text-sm text-base-content/70 mb-4">{ deviceID }</p>
		if ownedByCaller {
			@renameBoardForm(boardID, boardName, deviceID, renameErr)
		} else if renameErr != "" {
			<span class="text-sm text-error">{ renameErr }</span>
		}
	</div>
}

// renameBoardForm is the owner-only inline rename control (FR3). Prefilled
// with the board's current name; an unnamed board (boardName == "") shows
// an empty field with device_id as the placeholder, per the task issue's
// UI section. Posts to "/boards/{board_id}/rename" (main.go's setupRoutes)
// and swaps the whole "#board-header" fragment on response.
templ renameBoardForm(boardID int64, boardName, deviceID, renameErr string) {
	<form
		hx-post={ fmt.Sprintf("/boards/%d/rename", boardID) }
		hx-target="#board-header"
		hx-swap="outerHTML"
		class="flex flex-col gap-1 mb-4"
	>
		<div class="flex items-center gap-2">
			<input
				type="text"
				name="name"
				value={ boardName }
				placeholder={ deviceID }
				class="input input-bordered input-sm"
			/>
			<button type="submit" class="btn btn-sm btn-primary">Rename</button>
		</div>
		if renameErr != "" {
			<span class="text-sm text-error">{ renameErr }</span>
		}
	</form>
}

// sensorsTable renders one row per sensor (FR6: every sensor the API
// returned, unfiltered -- no hide/retire/disable affordance exists here or
// anywhere else on this page). Each row links to the sensor's
// reading-history chart (#1504), carrying board_id/device_id/sensor_name/
// unit as query parameters -- the reading-history page's route
// ("/sensors/{sensor_id}/history") has no board_id path segment, and no
// RPC maps a sensor_id back to its board or name (see #1504's
// sensor_history.templ doc comment), so this link is that page's only
// source for its board/name/unit chrome.
//
// ownedByCaller gates the FR4 inline rename control (#1770) -- forwarded
// straight through from GetBoardDetailResponse.owned_by_caller, the same
// signal boardOwnerCell already renders the Claim button from.
templ sensorsTable(boardID int64, deviceID string, ownedByCaller bool, sensors []*leaflabapipb.SensorDetail) {
	<div class="overflow-x-auto">
		<table class="table">
			<thead>
				<tr>
					<th>Sensor</th>
					<th>Type</th>
					<th>State</th>
					<th>Latest Reading</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, sensor := range sensors {
					@SensorRow(boardID, deviceID, ownedByCaller, sensor, "")
				}
			</tbody>
		</table>
	</div>
}

// SensorRow renders one sensor's table row, including the FR4 inline
// rename control when ownedByCaller. Exported (unlike sensorsTable) so
// handlers_rename.go's handleRenameSensor can re-render a single row after
// a rename attempt -- success or failure -- mirroring manmanv2/ui's
// renderDeploymentRow/DeploymentRow fragment pattern: hx-target="this
// row's id"/hx-swap="outerHTML" on renameSensorForm below lets htmx swap
// the row in place with no full-page reload.
//
// renameErr is empty on a normal table render (sensorsTable's call site
// above) and carries a human-readable message inline, next to the sensor
// name, when the most recent rename attempt against this row failed
// (InvalidArgument/PermissionDenied/FailedPrecondition/NotFound -- never a
// bare 500).
templ SensorRow(boardID int64, deviceID string, ownedByCaller bool, sensor *leaflabapipb.SensorDetail, renameErr string) {
	<tr id={ fmt.Sprintf("sensor-row-%d", sensor.GetSensorId()) } class="hover">
		<td>
			<div class="flex flex-col gap-1">
				<span>{ sensor.GetSensorName() }</span>
				if ownedByCaller {
					@renameSensorForm(boardID, deviceID, sensor)
				}
				if renameErr != "" {
					<span class="text-xs text-error">{ renameErr }</span>
				}
			</div>
		</td>
		<td>{ sensor.GetSensorTypeName() }</td>
		<td>@htmxui.Badge(boardStateLabel(sensor.GetReportingState()), boardStateVariant(sensor.GetReportingState()), htmxui.BadgeSizeSM, true, nil)</td>
		<td>@sensorReadingCell(sensor)</td>
		<td class="text-right">
			<a href={ templ.URL(sensorHistoryHref(boardID, deviceID, sensor)) } class="btn btn-ghost btn-sm">History</a>
		</td>
	</tr>
}

// renameSensorForm is the FR4 inline rename control (#1770), rendered only
// when the caller owns the sensor's board (SensorRow's ownedByCaller
// gate). board_id/device_id ride along as hidden fields -- the RPC itself
// only needs sensor_id (resolving board_id server-side via
// GetBoardIDForSensor), but handleRenameSensor's HTMX row re-render needs
// board_id to call GetBoardDetail again, and there is no other way for a
// per-row POST to hand that back to the handler.
templ renameSensorForm(boardID int64, deviceID string, sensor *leaflabapipb.SensorDetail) {
	<form
		hx-post={ fmt.Sprintf("/sensors/%d/rename", sensor.GetSensorId()) }
		hx-target={ fmt.Sprintf("#sensor-row-%d", sensor.GetSensorId()) }
		hx-swap="outerHTML"
		class="flex items-center gap-1"
	>
		<input type="hidden" name="board_id" value={ fmt.Sprintf("%d", boardID) }/>
		<input type="hidden" name="device_id" value={ deviceID }/>
		<input
			type="text"
			name="name"
			value={ sensor.GetSensorName() }
			required
			class="input input-bordered input-xs w-32"
		/>
		<button type="submit" class="btn btn-xs">Rename</button>
	</form>
}

// sensorHistoryHref builds the reading-history link's target URL,
// including the board/name/unit context query parameters sensorsTable's
// doc comment describes.
func sensorHistoryHref(boardID int64, deviceID string, sensor *leaflabapipb.SensorDetail) string {
	q := url.Values{}
	q.Set("board_id", fmt.Sprintf("%d", boardID))
	q.Set("device_id", deviceID)
	q.Set("sensor_name", sensor.GetSensorName())
	q.Set("unit", sensor.GetUnit())
	return fmt.Sprintf("/sensors/%d/history?%s", sensor.GetSensorId(), q.Encode())
}

// sensorReadingCell renders FR6's "most recent value with unit, and the
// timestamp of that reading" plus FR7's invalid-reading treatment.
//
// A nil LatestReading (REPORTING_STATE_NEVER_REPORTED) renders no value
// and no timestamp -- there is nothing to show, and that absence is itself
// the "never reported" signal, not an error. A present LatestReading with
// valid == false is still shown -- FR7 forbids blanking it or falling back
// to the previous valid reading -- with an added "Invalid" badge; this is
// orthogonal to reporting_state, so a one-minute-old invalid reading still
// shows the "Reporting" badge in the State column next to it.
templ sensorReadingCell(sensor *leaflabapipb.SensorDetail) {
	if sensor.GetLatestReading() == nil {
		<span class="text-base-content/40">—</span>
	} else {
		<div class="flex flex-col gap-1">
			<div class="flex items-center gap-2">
				<span
					if !sensor.GetLatestReading().GetValid() {
						class="text-error"
					}
				>
					{ fmt.Sprintf("%g", sensor.GetLatestReading().GetValue()) } { sensor.GetUnit() }
				</span>
				if !sensor.GetLatestReading().GetValid() {
					@htmxui.Badge("Invalid", htmxui.BadgeError, htmxui.BadgeSizeSM, true, nil)
				}
			</div>
			<span class="text-xs text-base-content/60">{ formatReadingTime(sensor.GetLatestReading().GetRecordedAt().AsTime()) }</span>
		</div>
	}
}
