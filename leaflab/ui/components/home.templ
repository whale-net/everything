package components

import "github.com/whale-net/everything/libs/go/htmxauth"

// HomePage is a Phase 1 placeholder for the authenticated landing page
// (FR13): it proves the login -> session -> protected-route path renders
// real content through the shared Shell chrome, rather than a blank body.
// The device/region/reading dashboard itself is later scaffolding on this
// plan (screens 01/02/08 in ../design/wireframes), not this issue's scope.
// Called directly from handlers_auth.go's handleHome (plain Go, not
// .templ) — composing Shell + page content happens here, in a .templ file,
// since templ's children... syntax isn't available from Go call sites.
templ HomePage(user *htmxauth.UserInfo) {
	@Shell("LeafLab", user) {
		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<h1 class="card-title">Welcome to LeafLab</h1>
				if user != nil {
					<p>Signed in as { user.PreferredUsername }.</p>
				}
				<p class="opacity-70">The device dashboard is coming in a later phase of this plan.</p>
			</div>
		</div>
	}
}
