package components

import (
	"fmt"
	"net/url"
	"strconv"

	pb "github.com/whale-net/everything/leaflab/api/proto"
	"github.com/whale-net/everything/libs/go/htmxauth"
)

// BoardsPage is the Phase 1 read-only boards screen (NFR18.2, NFR19, FR64
// rendering): one row per BoardInfo returned by leaflab-api's ListBoards,
// for whichever boards this signed-in user's own forwarded token
// authorizes (handlers_boards.go never queries a database directly --
// this screen's only source of data is the gRPC response). The device
// identifier renders as a copyable support detail (monospace, with a
// title tooltip), never as a page title or a link -- no field on this
// screen is marked, named, or documented as safe to expose beyond this
// signed-in session (NFR19: private by default).
//
// serverNow is the same response's own Instant (never this BFF's local
// clock), so last-seen renders as elapsed text against the same freshness
// bound a programmatic gRPC caller reading the same response gets
// (NFR18.2) -- see elapsed.go's formatElapsed.
templ BoardsPage(user *htmxauth.UserInfo, boards []*pb.BoardInfo, serverNow *pb.Instant, nextPageToken string) {
	@Shell("Boards", user) {
		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<h1 class="card-title">Boards</h1>
				<table class="table">
					<thead>
						<tr>
							<th>Device</th>
							<th>Board</th>
							<th class="text-right">Last seen</th>
						</tr>
					</thead>
					<tbody id="boards-tbody">
						if len(boards) == 0 && nextPageToken == "" {
							<tr>
								<td colspan="3" class="text-sm opacity-60 p-4">No boards yet.</td>
							</tr>
						}
						@BoardsRows(boards, serverNow, nextPageToken)
					</tbody>
				</table>
			</div>
		</div>
	}
}

// BoardsRows renders one <tr> per board plus, when nextPageToken is
// non-empty, a trailing "Load more" row (FR61's keyset "load more"
// continuation). The button's hx-get re-requests this same fragment for
// the next page and replaces its own row's outerHTML with the response --
// htmx's standard click-to-load shape, so paging in another screenful
// never accumulates an unbounded list client- or server-side: each click
// fetches exactly one more server-capped page, and the only place the
// accumulated rows live is the browser's own DOM.
//
// BoardsPage's tbody renders this directly for page one; handlers_boards.go's
// handleBoardsRows renders it standalone (no page shell) for every
// subsequent "Load more" click.
templ BoardsRows(boards []*pb.BoardInfo, serverNow *pb.Instant, nextPageToken string) {
	for _, b := range boards {
		<tr class="hover">
			<td class="font-mono text-xs" title="Device identifier — support use only">{ b.GetDeviceId() }</td>
			<td class="font-mono text-sm">{ strconv.FormatInt(b.GetBoardId(), 10) }</td>
			<td class="text-right opacity-60" title={ absoluteInstantTitle(b.GetLastSeenAt()) }>
				{ formatElapsed(instantToTime(serverNow), instantToTime(b.GetLastSeenAt())) }
			</td>
		</tr>
	}
	if nextPageToken != "" {
		<tr id="boards-load-more">
			<td colspan="3" class="text-center p-2">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					hx-get={ fmt.Sprintf("/boards/rows?page_token=%s", url.QueryEscape(nextPageToken)) }
					hx-target="#boards-load-more"
					hx-swap="outerHTML"
				>
					Load more
				</button>
			</td>
		</tr>
	}
}
