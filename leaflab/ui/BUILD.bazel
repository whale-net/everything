load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "ui_lib",
    srcs = [
        "grpc_client.go",
        "handlers_auth.go",
        "handlers_home.go",
        "main.go",
        "templ_render.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/ui",
    visibility = ["//visibility:private"],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/ui/components",
        "//leaflab/ui/pages",
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/grpcclient",
        "//libs/go/htmxauth",
        "//libs/go/htmxbase",
        "//libs/go/htmxui",
        "//libs/go/logging",
        "@com_github_a_h_templ//:templ",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "leaflab-ui",
    embed = [":ui_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "ui_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":ui_lib"],
)

# Release metadata. domain "leaflab" + name "leaflab-ui" produces the
# "leaflab-ui" image/app identity, matching api/BUILD.bazel's
# "leaflab-api" and migrate/BUILD.bazel's "migrate" naming.
release_app(
    name = "leaflab-ui",
    app_type = "external-api",
    binary_name = ":leaflab-ui",
    description = "HTMX-based web UI for LeafLab: OIDC sign-in, session-backed identity, and read-only board/sensor views over gRPC",
    domain = "leaflab",
    ingress_host = "leaflab.whalenet.dev",
    ingress_tls_secret = "leaflab-ui-tls",
    language = "go",
    port = 8000,
)
