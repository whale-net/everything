load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "ui_lib",
    srcs = [
        "boards_data.go",
        "grpc_client.go",
        "handlers_auth.go",
        "handlers_boards.go",
        "main.go",
        "templ_render.go",
    ],
    embedsrcs = [
        "favicon.ico",
    ],
    importpath = "github.com/whale-net/everything/leaflab/ui",
    visibility = ["//visibility:private"],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "//leaflab/ui/components",
        "//libs/go/db",
        "//libs/go/grpcauth",
        "//libs/go/grpcclient",
        "//libs/go/htmxauth",
        "//libs/go/htmxbase",
        "//libs/go/htmxui",
        "//libs/go/logging",
        "@com_github_a_h_templ//:templ",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "ui",
    embed = [":ui_lib"],
    visibility = ["//visibility:public"],
)

# LeafLab's second deployable (A8): gRPC (leaflab-api) stays the
# programmatic surface, this is the browser surface. domain "leaflab" +
# name "ui" produces the "leaflab-ui" image/app identity, matching
# api/BUILD.bazel's "leaflab-api" and migrate/BUILD.bazel's "migrate"
# naming. Not yet wired into any Helm chart/ingress — deployment
# integration is a later issue on this plan.
release_app(
    name = "ui",
    app_type = "external-api",
    binary_name = ":ui",
    description = "LeafLab HTMX browser UI — interactive login, durable session, sign-out (FR13)",
    domain = "leaflab",
    language = "go",
    port = 8000,
)

# Fast, Docker-free handler tests (#1329's Testing section, extended by
# #1330): unauthenticated redirect, authenticated render, the degraded page
# (NFR14), the NFR18.1 grep-style placeholder conformance check, plus
# #1330's boards-screen coverage -- rendering from the gRPC response (not a
# DB), FR61 pagination (two pages, no duplicates, cap respected), NFR18.2
# screen-vs-plain-gRPC-client parity, and the NFR19 grep-style check (no
# publishable/shareable/public_ strings under leaflab/ui/). data exposes
# this package's own checked-in source (nfr18/nfr19_conformance_test.go
# grep it) and BUILD.bazel (used as its own marker file).
go_test(
    name = "ui_test",
    srcs = [
        "fakes_test.go",
        "handlers_auth_test.go",
        "handlers_boards_test.go",
        "nfr18_conformance_test.go",
        "nfr19_conformance_test.go",
    ],
    data = glob(["*.go"]) + [
        "BUILD.bazel",
        "//leaflab/ui/components:conformance_srcs",
    ],
    embed = [":ui_lib"],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "//libs/go/htmxauth",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

# Session persistence (survives a store reopen -- i.e. a BFF pod restart)
# and sign-out (deletes the ui_sessions DB row) against a real Postgres.
# Gated behind `//go:build integration`, gazelle skips it when scanning for
# go_test srcs; this go_test is hand-written with EXACTLY the tag set from
# //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required). `# keep` markers
# tell a later `bazel run //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/ui:ui_integration_test --test_output=all
go_test(
    # keep
    name = "ui_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "fakes_test.go",
        "session_integration_test.go",
    ],
    embed = [":ui_lib"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//leaflab/api/proto:leaflabapipb",
        "//libs/go/dbtest",
        "//libs/go/htmxauth",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
