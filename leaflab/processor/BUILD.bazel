load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "processor_lib",
    srcs = [
        "cache.go",
        "config.go",
        "handler.go",
        "main.go",
        "repository.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/processor",
    visibility = ["//visibility:private"],
    deps = [
        "//firmware/proto:configpb",
        "//firmware/proto:firmwarepb",
        "//leaflab/api/audit",
        "//libs/go/db",
        "//libs/go/logging",
        "//libs/go/rmq",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_binary(
    name = "processor",
    embed = [":processor_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "processor_test",
    srcs = ["handler_test.go"],
    embed = [":processor_lib"],
    deps = [
        "//firmware/proto:firmwarepb",
        "@org_golang_google_protobuf//proto",
    ],
)

# Real-Postgres integration coverage for FR1.2/FR1.3's apply-time
# re-validation in ApplyConfigRegions (household ownership, staleness,
# skip-and-audit) -- see apply_config_regions_integration_test.go's doc
# comment. Hand-written (not gazelle-generated), same rationale as
# leaflab/api's *_integration_test targets: the file is gated behind
# `//go:build integration`, which gazelle skips when scanning for go_test
# srcs. `# keep` tells a later `bazel run //:gazelle` not to touch or
# remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/processor:apply_config_regions_integration_test --test_output=all
go_test(
    # keep
    name = "apply_config_regions_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["apply_config_regions_integration_test.go"],
    embed = [":processor_lib"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//firmware/proto:configpb",
        "//leaflab/api/audit",
        "//libs/go/dbtest",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

release_app(
    name = "processor",
    binary_name = ":processor",
    language = "go",
    domain = "leaflab",
    description = "LeafLab sensor data processor (RabbitMQ MQTT consumer, DB writer)",
    app_type = "worker",
    replicas = 1,
)
