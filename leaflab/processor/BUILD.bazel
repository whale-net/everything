release_app(
    name = "processor",
    app_type = "worker",
    binary_name = ":processor",
    description = "LeafLab sensor data processor (RabbitMQ MQTT consumer, DB writer)",
    domain = "leaflab",
    language = "go",
    replicas = 1,
)
