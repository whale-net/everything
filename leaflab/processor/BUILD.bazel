load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "processor_lib",
    srcs = [
        "ack_signal.go",
        "cache.go",
        "cache_invalidation.go",
        "config.go",
        "handler.go",
        "handler_swap_detection.go",
        "main.go",
        "repository.go",
        "repository_swap_detection.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/processor",
    visibility = ["//visibility:private"],
    deps = [
        "//firmware/proto:configpb",
        "//firmware/proto:firmwarepb",
        "//leaflab/broadcast",
        "//leaflab/canonkey",
        "//libs/go/db",
        "//libs/go/logging",
        "//libs/go/rmq",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_binary(
    name = "processor",
    embed = [":processor_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "processor_test",
    srcs = ["handler_test.go"],
    embed = [":processor_lib"],
    tags = ["manual", "integration"],
    deps = [
        "//firmware/proto:configpb",
        "//firmware/proto:firmwarepb",
        "//leaflab/broadcast",
        "//libs/go/dbtest",
        "//libs/go/rmq",
        "@org_golang_google_protobuf//proto",
    ],
)

# Real-broker proof that RabbitMQAckPublisher (#1216) and RabbitMQInvalidator
# (#1203) publish onto the same fanout exchange. Requires Docker; see
# libs/go/rmqtest/README.md for the exact bazel invocation.
go_test(
    name = "processor_broadcast_integration_test",
    srcs = ["ack_signal_integration_test.go"],
    embed = [":processor_lib"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//leaflab/broadcast",
        "//libs/go/rmq",
        "//libs/go/rmqtest",
    ],
)

go_test(
    name = "processor_integration_test",
    srcs = ["repository_household_test.go"],
    embed = [":processor_lib"],
    tags = ["integration", "manual"],
    deps = [
        "//libs/go/dbtest",
    ],
)

release_app(
    name = "processor",
    binary_name = ":processor",
    language = "go",
    domain = "leaflab",
    description = "LeafLab sensor data processor (RabbitMQ MQTT consumer, DB writer)",
    app_type = "worker",
    replicas = 1,
)
