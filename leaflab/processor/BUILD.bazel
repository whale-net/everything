load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_library(
    name = "processor_lib",
    srcs = [
        "cache.go",
        "config.go",
        "convergence.go",
        "handler.go",
        "main.go",
        "repository.go",
    ],
    importpath = "github.com/whale-net/everything/leaflab/processor",
    visibility = ["//visibility:private"],
    deps = [
        "//firmware/proto:configpb",
        "//firmware/proto:firmwarepb",
        "//leaflab/configcompose",
        "//libs/go/db",
        "//libs/go/logging",
        "//libs/go/rmq",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_binary(
    name = "processor",
    embed = [":processor_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "processor_test",
    srcs = ["handler_test.go"],
    embed = [":processor_lib"],
    deps = [
        "//firmware/proto:configpb",
        "//firmware/proto:firmwarepb",
        "//leaflab/configcompose",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# FR9/NFR4 version-collision coverage (#1772 Testing criterion 10) that
# needs a real Postgres. Gated behind `//go:build integration`, gazelle
# skips it when scanning for go_test srcs; this go_test is hand-written
# with EXACTLY the tag set from //leaflab/api:api_integration_test /
# //libs/go/dbtest:postgres_constraints_test (see those BUILD.bazel files
# for why each tag is required). `# keep` tells a later `bazel run
# //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/processor:processor_integration_test --test_output=all
go_test(
    # keep
    name = "processor_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["convergence_integration_test.go"],
    embed = [":processor_lib"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

release_app(
    name = "processor",
    binary_name = ":processor",
    language = "go",
    domain = "leaflab",
    description = "LeafLab sensor data processor (RabbitMQ MQTT consumer, DB writer)",
    app_type = "worker",
    replicas = 1,
)
