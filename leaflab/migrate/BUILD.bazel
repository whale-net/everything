load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:release.bzl", "release_app")

# main.go is its own go_library (rather than inlined directly on go_binary)
# so i2c_address_migration_integration_test.go can `embed` it and reuse its
# unexported `migrations` embed.FS -- same pattern as //leaflab/api:api_lib
# and //leaflab/hwkey.
go_library(
    name = "migrate_lib",
    srcs = ["main.go"],
    embedsrcs = glob(["migrations/*.sql"]),
    importpath = "github.com/whale-net/everything/leaflab/migrate",
    visibility = ["//visibility:private"],
    deps = [
        "//firmware/sensor/catalog",
        "//libs/go/migrate",
    ],
)

go_binary(
    name = "migrate",
    embed = [":migrate_lib"],
    visibility = ["//visibility:public"],
)

release_app(
    name = "migrate",
    app_type = "job",
    binary_name = ":migrate",
    description = "LeafLab database migration runner",
    domain = "leaflab",
    language = "go",
)

# Real-Postgres integration coverage for migration 013 (FR16.1, FR16.2,
# NFR8) -- see i2c_address_migration_integration_test.go's doc comment and
# //libs/go/dbtest/README.md. Hand-written (not gazelle-generated): the test
# file is gated behind `//go:build integration`, which gazelle skips when
# scanning for go_test srcs. EXACTLY the tag set from
# //libs/go/dbtest:postgres_constraints_test (see that package's
# BUILD.bazel/README.md for why each tag is required). `# keep` markers tell
# a later `bazel run //:gazelle` not to touch or remove this rule.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/migrate:i2c_address_migration_integration_test --test_output=all
go_test(
    # keep
    name = "i2c_address_migration_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["i2c_address_migration_integration_test.go"],
    embed = [":migrate_lib"],
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)

# Real-Postgres integration coverage for migration 015_ownership's backfill
# DML (FR70.1, FR1.1, NFR8, A9, NFR6.1, NFR6.3) and migration 016_audit_log's
# append-only enforcement (FR8, NFR6.2, NFR6.3) -- see
# ownership_migration_integration_test.go's and
# audit_log_migration_integration_test.go's doc comments and
# //libs/go/dbtest/README.md. Both files share this one target because
# audit_log_migration_integration_test.go reuses ownership's
# migrations/timescaleImage package-level fixtures rather than redeclaring
# them. Hand-written (not gazelle-generated), same rationale and EXACT tag
# set as leaflab/api's *_integration_test targets. `# keep` tells a later
# `bazel run //:gazelle` not to touch or remove this rule. Uses its own
# embed of migrations/*.sql (independent of the :migrate go_binary above)
# since this is a standalone test binary, not an embed of :migrate.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/migrate:ownership_migration_integration_test --test_output=all
go_test(
    # keep
    name = "ownership_migration_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "audit_log_migration_integration_test.go",
        "ownership_migration_integration_test.go",
    ],
    embedsrcs = glob(["migrations/*.sql"]),
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)

