load("@rules_go//go:def.bzl", "go_binary", "go_test")
load("//tools/bazel:release.bzl", "release_app")

# Migration SQL files as text data for //leaflab/conformance's Phase 2
# table-coverage check (NFR17 Phase-2 set, task #1352): every CREATE TABLE
# in a Phase 2 migration must appear in leaflab/DATA.md.
filegroup(
    name = "migration_srcs",
    srcs = glob(["migrations/*.sql"]),
    visibility = ["//leaflab:__subpackages__"],
)

go_binary(
    name = "migrate",
    srcs = ["main.go"],
    embedsrcs = glob(["migrations/*.sql"]),
    deps = [
        "//firmware/sensor/catalog",
        "//libs/go/migrate",
    ],
    visibility = ["//visibility:public"],
)

release_app(
    name = "migrate",
    binary_name = ":migrate",
    language = "go",
    domain = "leaflab",
    description = "LeafLab database migration runner",
    app_type = "job",
)

# Real-Postgres integration coverage for migration 015_ownership's backfill
# DML (FR70.1, FR1.1, NFR8, A9, NFR6.1, NFR6.3), migration 016_audit_log's
# append-only enforcement (FR8, NFR6.2, NFR6.3), and migration
# 018_household_grant's schema (FR7, NFR6.3) -- see
# ownership_migration_integration_test.go's, audit_log_migration_
# integration_test.go's and household_grant_migration_integration_test.go's
# doc comments and //libs/go/dbtest/README.md. All three files share this
# one target because the latter two reuse ownership's migrations/
# timescaleImage package-level fixtures rather than redeclaring them.
# Hand-written (not gazelle-generated), same rationale and EXACT tag set as
# leaflab/api's *_integration_test targets. `# keep` tells a later
# `bazel run //:gazelle` not to touch or remove this rule. Uses its own
# embed of migrations/*.sql (independent of the :migrate go_binary above)
# since this is a standalone test binary, not an embed of :migrate.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/migrate:ownership_migration_integration_test --test_output=all
go_test(
    # keep
    name = "ownership_migration_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "audit_log_migration_integration_test.go",
        "household_grant_migration_integration_test.go",
        "ownership_migration_integration_test.go",
    ],
    embedsrcs = glob(["migrations/*.sql"]),
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)
