load("@rules_go//go:def.bzl", "go_binary", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_binary(
    name = "migrate",
    srcs = ["main.go"],
    embedsrcs = glob(["migrations/*.sql"]),
    deps = [
        "//firmware/sensor/catalog",
        "//libs/go/migrate",
    ],
    visibility = ["//visibility:public"],
)

release_app(
    name = "migrate",
    binary_name = ":migrate",
    language = "go",
    domain = "leaflab",
    description = "LeafLab database migration runner",
    app_type = "job",
)

# NFR17 Phase-3 doc-coverage conformance check (#1367's Testing section):
# every table/continuous-aggregate created by the Phase-3 migrations named
# in phase3Entities (doc_coverage_test.go) is documented in leaflab/DATA.md
# and classified SCD2/not-SCD2 consistently with its own migration-declared
# shape. See doc_coverage_test.go's doc comment for why this lives here
# rather than in the (not-yet-merged) leaflab/conformance/ package. No
# database, no build tag -- runs in every plain `bazel test //leaflab/...`.
go_test(
    name = "doc_coverage_test",
    size = "small",
    srcs = ["doc_coverage_test.go"],
    data = ["//leaflab:DATA.md"],
    embedsrcs = glob(["migrations/*.sql"]),
)

# Real-Postgres integration coverage for migration 015_ownership's backfill
# DML (FR70.1, FR1.1, NFR8, A9, NFR6.1, NFR6.3) -- see
# ownership_migration_integration_test.go's doc comment and
# //libs/go/dbtest/README.md. Hand-written (not gazelle-generated), same
# rationale and EXACT tag set as leaflab/api's *_integration_test targets.
# `# keep` tells a later `bazel run //:gazelle` not to touch or remove this
# rule. Uses its own embed of migrations/*.sql (independent of the :migrate
# go_binary above) since this is a standalone test binary, not an embed of
# :migrate.
#
# Run it explicitly (requires a working Docker daemon):
#   bazel test //leaflab/migrate:ownership_migration_integration_test --test_output=all
go_test(
    # keep
    name = "ownership_migration_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["ownership_migration_integration_test.go"],
    embedsrcs = glob(["migrations/*.sql"]),
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)

