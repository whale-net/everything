load("@rules_go//go:def.bzl", "go_binary", "go_test")
load("//tools/bazel:release.bzl", "release_app")

go_binary(
    name = "migrate",
    srcs = ["main.go"],
    embedsrcs = glob(["migrations/*.sql"]),
    deps = [
        "//firmware/sensor/catalog",
        "//libs/go/migrate",
    ],
    visibility = ["//visibility:public"],
)

release_app(
    name = "migrate",
    binary_name = ":migrate",
    language = "go",
    domain = "leaflab",
    description = "LeafLab database migration runner",
    app_type = "job",
)

# Integration tests for migrations (requires Docker)
go_test(
    name = "migrations_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "migrations_test.go",
        "tier_policy_test.go",
    ],
    embedsrcs = glob(["migrations/*.sql"]),
    gotags = ["integration"],
    tags = [
        "external",
        "integration",
        "manual",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//libs/go/dbtest",
        "//libs/go/migrate",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)
