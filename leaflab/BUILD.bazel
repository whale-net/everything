load("//tools/bazel:release.bzl", "release_helm_chart")

release_helm_chart(
    name = "leaflab_chart",
    chart_name = "leaflab",
    domain = "leaflab",
    namespace = "leaflab",
    environment = "production",
    apps = [
        "//leaflab/api:leaflab-api_metadata",
        "//leaflab/migrate:migrate_metadata",
        "//leaflab/processor:processor_metadata",
        "//leaflab/ui:leaflab-ui_metadata",
    ],
)

# Conformance test data — BUILD.bazel marker file
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//leaflab/conformance:__pkg__"],
)
