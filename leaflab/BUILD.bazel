load("//tools/bazel:release.bzl", "release_helm_chart")

# TOC.md as text data for //leaflab/conformance's TOC-links-both-ENV-docs
# check (NFR17 Phase-1 docs).
filegroup(
    name = "toc",
    srcs = ["TOC.md"],
    visibility = ["//leaflab:__subpackages__"],
)

# This BUILD.bazel itself, staged as a data dependency so
# //leaflab/conformance can use it as a marker file to locate the leaflab/
# domain root at test runtime (mirrors tools/app_registry:build_file).
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//leaflab:__subpackages__"],
)

release_helm_chart(
    name = "leaflab_chart",
    chart_name = "leaflab",
    domain = "leaflab",
    namespace = "leaflab",
    environment = "production",
    apps = [
        "//leaflab/api:leaflab-api_metadata",
        "//leaflab/migrate:migrate_metadata",
        "//leaflab/processor:processor_metadata",
    ],
)
