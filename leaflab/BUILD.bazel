load("//tools/bazel:release.bzl", "release_helm_chart")

release_helm_chart(
    name = "leaflab_chart",
    chart_name = "leaflab",
    domain = "leaflab",
    namespace = "leaflab",
    environment = "production",
    apps = [
        "//leaflab/api:leaflab-api_metadata",
        "//leaflab/migrate:migrate_metadata",
        "//leaflab/processor:processor_metadata",
    ],
)

# Marker file for //leaflab/conformance's leaflabDir helper (NFR1.a, #1334):
# located via os.Stat the same way //tools/app_registry/conformance's
# appRegistryDir locates tools/app_registry/BUILD.bazel.
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//leaflab/conformance:__pkg__"],
)
